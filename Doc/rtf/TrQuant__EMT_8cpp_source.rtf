00048 {\cf20 // ********************************** DCT-II **********************************}\par
00049 \par
00050 {\cf20 //Fast DCT-II transforms}\par
00051 {\cf18 void} fastForwardDCT2_B2({\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2)\par
00052 \{\par
00053   {\cf18 int} j;\par
00054   TCoeff E, O;\par
00055   TCoeff add = (shift > 0) ? (1 << (shift - 1)) : 0;\par
00056 \par
00057   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P2[TRANSFORM_FORWARD][0];\par
00058 \par
00059   TCoeff *pCoef = dst;\par
00060   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00061   {\cf19 for} (j = 0; j<reducedLine; j++)\par
00062   \{\par
00063     {\cf20 /* E and O */}\par
00064     E = src[0] + src[1];\par
00065     O = src[0] - src[1];\par
00066 \par
00067     dst[0] = (iT[0] * E + add) >> shift;\par
00068     dst[line] = (iT[2] * O + add) >> shift;\par
00069 \par
00070 \par
00071     src += 2;\par
00072     dst++;\par
00073   \}\par
00074   {\cf19 if} (iSkipLine)\par
00075   \{\par
00076     dst = pCoef + reducedLine;\par
00077     {\cf19 for} (j = 0; j<2; j++)\par
00078     \{\par
00079       memset(dst, 0, {\cf17 sizeof}(TCoeff)*iSkipLine);\par
00080       dst += line;\par
00081     \}\par
00082   \}\par
00083 \}\par
00084 \par
00085 {\cf18 void} fastInverseDCT2_B2({\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2, {\cf17 const} TCoeff outputMinimum, {\cf17 const} TCoeff outputMaximum)\par
00086 \{\par
00087   {\cf18 int} j;\par
00088   TCoeff E, O;\par
00089   TCoeff add = TCoeff(1) << (shift - 1);\par
00090 \par
00091   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P2[TRANSFORM_INVERSE][0];\par
00092 \par
00093   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00094   {\cf19 for} (j = 0; j<reducedLine; j++)\par
00095   \{\par
00096     {\cf20 /* Utilizing symmetry properties to the maximum to minimize the number of multiplications */}\par
00097     E = iT[0] * (src[0] + src[line]);\par
00098     O = iT[2] * (src[0] - src[line]);\par
00099 \par
00100     {\cf20 /* Combining even and odd terms at each hierarchy levels to calculate the final spatial domain vector */}\par
00101     dst[0] = Clip3<TCoeff>(outputMinimum, outputMaximum, (E + add) >> shift);\par
00102     dst[1] = Clip3<TCoeff>(outputMinimum, outputMaximum, (O + add) >> shift);\par
00103 \par
00104     src++;\par
00105     dst += 2;\par
00106   \}\par
00107   {\cf19 if} (iSkipLine)\par
00108   \{\par
00109     memset(dst, 0, (iSkipLine << 1) * {\cf17 sizeof}(TCoeff));\par
00110   \}\par
00111 \}\par
00112 \par
00119 {\cf18 void} fastForwardDCT2_B4({\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2)\par
00120 \{\par
00121   {\cf18 int} j;\par
00122   TCoeff E[2], O[2];\par
00123   TCoeff add = (shift > 0) ? (1 << (shift - 1)) : 0;\par
00124 \par
00125   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P4[TRANSFORM_FORWARD][0];\par
00126 \par
00127   TCoeff *pCoef = dst;\par
00128   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00129   {\cf19 for} (j = 0; j<reducedLine; j++)\par
00130   \{\par
00131     {\cf20 /* E and O */}\par
00132     E[0] = src[0] + src[3];\par
00133     O[0] = src[0] - src[3];\par
00134     E[1] = src[1] + src[2];\par
00135     O[1] = src[1] - src[2];\par
00136 \par
00137     dst[0] = (iT[0] * E[0] + iT[1] * E[1] + add) >> shift;\par
00138     dst[2 * line] = (iT[8] * E[0] + iT[9] * E[1] + add) >> shift;\par
00139     dst[line] = (iT[4] * O[0] + iT[5] * O[1] + add) >> shift;\par
00140     dst[3 * line] = (iT[12] * O[0] + iT[13] * O[1] + add) >> shift;\par
00141 \par
00142     src += 4;\par
00143     dst++;\par
00144   \}\par
00145   {\cf19 if} (iSkipLine)\par
00146   \{\par
00147     dst = pCoef + reducedLine;\par
00148     {\cf19 for} (j = 0; j<4; j++)\par
00149     \{\par
00150       memset(dst, 0, {\cf17 sizeof}(TCoeff)*iSkipLine);\par
00151       dst += line;\par
00152     \}\par
00153   \}\par
00154 \}\par
00155 \par
00164 {\cf18 void} fastInverseDCT2_B4( {\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2, {\cf17 const} TCoeff outputMinimum, {\cf17 const} TCoeff outputMaximum )\par
00165 \{\par
00166   {\cf18 int} j;\par
00167   TCoeff E[2], O[2];\par
00168   TCoeff add = TCoeff(1) << ( shift - 1 );\par
00169 \par
00170   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P4[TRANSFORM_INVERSE][0];\par
00171 \par
00172   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00173   {\cf19 for}( j = 0; j < reducedLine; j++ )\par
00174   \{\par
00175     {\cf20 /* Utilizing symmetry properties to the maximum to minimize the number of multiplications */}\par
00176     O[0] = iT[1 * 4 + 0] * src[line] + iT[3 * 4 + 0] * src[3 * line];\par
00177     O[1] = iT[1 * 4 + 1] * src[line] + iT[3 * 4 + 1] * src[3 * line];\par
00178     E[0] = iT[0 * 4 + 0] * src[   0] + iT[2 * 4 + 0] * src[2 * line];\par
00179     E[1] = iT[0 * 4 + 1] * src[   0] + iT[2 * 4 + 1] * src[2 * line];\par
00180 \par
00181     {\cf20 /* Combining even and odd terms at each hierarchy levels to calculate the final spatial domain vector */}\par
00182     dst[0] = Clip3<TCoeff>( outputMinimum, outputMaximum, ( E[0] + O[0] + add ) >> shift );\par
00183     dst[1] = Clip3<TCoeff>( outputMinimum, outputMaximum, ( E[1] + O[1] + add ) >> shift );\par
00184     dst[2] = Clip3<TCoeff>( outputMinimum, outputMaximum, ( E[1] - O[1] + add ) >> shift );\par
00185     dst[3] = Clip3<TCoeff>( outputMinimum, outputMaximum, ( E[0] - O[0] + add ) >> shift );\par
00186 \par
00187     src++;\par
00188     dst += 4;\par
00189   \}\par
00190   {\cf19 if}( iSkipLine )\par
00191   \{\par
00192     memset( dst, 0, ( iSkipLine << 2 ) * {\cf17 sizeof}( TCoeff ) );\par
00193   \}\par
00194 \}\par
