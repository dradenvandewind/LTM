00513 {\cf18 void} fastForwardDCT2_B32( {\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2 )\par
00514 \{\par
00515   {\cf18 int} j, k;\par
00516   TCoeff E   [16], O   [16];\par
00517   TCoeff EE  [ 8], EO  [ 8];\par
00518   TCoeff EEE [ 4], EEO [ 4];\par
00519   TCoeff EEEE[ 2], EEEO[ 2];\par
00520   TCoeff add = ( shift > 0 ) ? ( 1 << ( shift - 1 ) ) : 0;\par
00521 \par
00522   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P32[TRANSFORM_FORWARD][0];\par
00523 \par
00524   TCoeff *pCoef = dst;\par
00525   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
