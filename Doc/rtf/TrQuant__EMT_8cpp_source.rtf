00212       \}\par
00213       dst[i*uiTrSize + j] = Clip3<TCoeff>(outputMinimum, outputMaximum, (iSum + rnd_factor) >> shift);\par
00214     \}\par
00215   \}\par
00216 \par
00217   {\cf19 if} (iSkipLine)\par
00218   \{\par
00219     memset(dst + (reducedLine*uiTrSize), 0, (iSkipLine*uiTrSize) * {\cf17 sizeof}(TCoeff));\par
00220   \}\par
00221 \}\par
