00422     \}\par
00423 \par
00424     {\cf19 for}( k = 1; k < 16; k += 2 )\par
00425     \{\par
00426       dst[k*line] = ( iT[k * 16    ] * O[0] + iT[k * 16 + 1] * O[1] + iT[k * 16 + 2] * O[2] + iT[k * 16 + 3] * O[3] +\par
00427                       iT[k * 16 + 4] * O[4] + iT[k * 16 + 5] * O[5] + iT[k * 16 + 6] * O[6] + iT[k * 16 + 7] * O[7] + add ) >> shift;\par
00428     \}\par
00429 \par
