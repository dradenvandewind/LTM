00197 {\cf17 template}< {\cf18 int} uiTrSize >\par
00198 {\cf17 inline} {\cf18 void} _fastInverseMM( {\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2, {\cf17 const} TCoeff outputMinimum, {\cf17 const} TCoeff outputMaximum, {\cf17 const} TMatrixCoeff* iT )\par
00199 \{\par
00200   {\cf17 const} TCoeff rnd_factor = TCoeff(1) << (shift - 1);\par
00201   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00202   {\cf17 const} {\cf18 int}  cutoff      = uiTrSize - iSkipLine2;\par
00203 \par
00204   {\cf19 for}( {\cf18 int} i = 0; i<reducedLine; i++ )\par
00205   \{\par
00206     {\cf19 for}( {\cf18 int} j = 0; j<uiTrSize; j++ )\par
00207     \{\par
00208       TCoeff iSum = 0;\par
00209       {\cf19 for}( {\cf18 int} k = 0; k<cutoff; k++)\par
00210       \{\par
