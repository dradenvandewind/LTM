00236     {\cf19 for}( {\cf18 int} j = 0; j<cutoff; j++ )\par
00237     \{\par
00238       TCoeff iSum = 0;\par
00239       {\cf19 for}( {\cf18 int} k = 0; k<uiTrSize; k++ )\par
00240       \{\par
00241         iSum += src[k] * iT[k];\par
00242       \}\par
