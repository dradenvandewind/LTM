00457   TCoeff EE [4], EO [4];\par
00458   TCoeff EEE[2], EEO[2];\par
00459   TCoeff add = TCoeff(1) << ( shift - 1 );\par
00460 \par
00461   {\cf17 const} TMatrixCoeff *iT = g_trCoreDCT2P16[TRANSFORM_INVERSE][0];\par
00462 \par
00463   {\cf17 const} {\cf18 int}  reducedLine = line - iSkipLine;\par
00464 \par
00465   {\cf19 for}( j = 0; j < reducedLine; j++ )\par
00466   \{\par
00467     {\cf20 /* Utilizing symmetry properties to the maximum to minimize the number of multiplications */}\par
00468     {\cf19 for}( k = 0; k < 8; k++ )\par
00469     \{\par
00470       O[k] = iT[1 * 16 + k] * src[    line] + iT[ 3 * 16 + k] * src[ 3 * line] + iT[ 5 * 16 + k] * src[ 5 * line] + iT[ 7 * 16 + k] * src[ 7 * line] +\par
