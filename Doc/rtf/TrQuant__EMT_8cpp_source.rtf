00382 {\cf18 void} fastForwardDCT2_B16({\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2)\par
00383 \{\par
00384   {\cf18 int} j, k;\par
00385   TCoeff E  [8], O  [8];\par
00386   TCoeff EE [4], EO [4];\par
