00659 {\cf18 void} fastForwardDCT2_B64({\cf17 const} TCoeff *src, TCoeff *dst, {\cf18 int} shift, {\cf18 int} line, {\cf18 int} iSkipLine, {\cf18 int} iSkipLine2)\par
00660 \{\par
