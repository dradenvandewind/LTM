00081 {\cf17 inline} {\cf18 void} dtraceCoeffBuf( DTRACE_CHANNEL channnel, {\cf17 const} CCoeffBuf& coefBuf, {\cf17 const} UnitArea& ua, PredMode predMode, {\cf17 const} ComponentID compId, uint32_t zIdx = 0 )\par
00082 \{\par
00083   {\cf18 int} x0 = ua.blocks[compId].x;\par
00084   {\cf18 int} y0 = ua.blocks[compId].y;\par
00085   {\cf17 const} uint32_t    uiStride = coefBuf.stride;\par
00086   {\cf17 const} TCoeff* piReco   = coefBuf.buf;\par
00087   {\cf17 const} uint32_t    uiWidth  = ua.blocks[compId].width;\par
00088   {\cf17 const} uint32_t    uiHeight = ua.blocks[compId].height;\par
00089   DTRACE(g_trace_ctx, channnel, {\cf22 "@(%4d,%4d) [%2dx%2d] comp=%d predmode=%d \\n"}, x0, y0, uiWidth, uiHeight, compId, predMode);\par
00090   DTRACE_BLOCK(g_trace_ctx, channnel, piReco, uiStride, uiWidth, uiHeight);\par
00091 \}\par
