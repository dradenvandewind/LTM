00148 {\cf17 inline} {\cf18 void} dtraceCRC( CDTrace *trace_ctx, DTRACE_CHANNEL channel, {\cf17 const} CodingStructure& cs, {\cf17 const} CPelUnitBuf& pelUnitBuf, {\cf17 const} Area* parea = NULL )\par
00149 \{\par
00150   {\cf17 const} Area& area = parea ? *parea : cs.area.Y();\par
00151   DTRACE( trace_ctx, channel, {\cf22 " CRC: %6lld %3d @(%4d,%4d) [%2dx%2d] ,Checksum(%x %x %x)\\n"},\par
00152       DTRACE_GET_COUNTER( g_trace_ctx, channel ),\par
00153       cs.slice->getPOC(),\par
00154       area.x, area.y, area.width, area.height,\par
00155       calcCheckSum( pelUnitBuf.bufs[COMPONENT_Y], cs.sps->getBitDepth (CHANNEL_TYPE_LUMA)),\par
00156       calcCheckSum( pelUnitBuf.bufs[COMPONENT_Cb], cs.sps->getBitDepth (CHANNEL_TYPE_CHROMA)),\par
00157       calcCheckSum( pelUnitBuf.bufs[COMPONENT_Cr], cs.sps->getBitDepth (CHANNEL_TYPE_CHROMA)));\par
00158 \}\par
