00093 {\cf17 inline} {\cf18 void} dtracePelBuf( DTRACE_CHANNEL channnel, {\cf17 const} CPelBuf& pelBuf, {\cf17 const} UnitArea& ua, PredMode predMode, {\cf17 const} ComponentID compId )\par
00094 \{\par
00095   {\cf18 int} x0 = ua.block(compId).x;\par
00096   {\cf18 int} y0 = ua.block(compId).y;\par
00097   {\cf17 const} uint32_t    uiStride     = pelBuf.stride;\par
00098   {\cf17 const} Pel*    piReco       = pelBuf.buf;\par
00099   {\cf17 const} uint32_t    uiWidth      = ua.block(compId).width;\par
00100   {\cf17 const} uint32_t    uiHeight     = ua.block(compId).height;\par
00101   DTRACE      ( g_trace_ctx, channnel,   {\cf22 "@(%4d,%4d) [%2dx%2d] comp=%d predmode=%d \\n"}, x0, y0, uiWidth, uiHeight, compId, predMode );\par
00102   DTRACE_BLOCK( g_trace_ctx, channnel,   piReco, uiStride, uiWidth, uiHeight );\par
00103 \}\par
