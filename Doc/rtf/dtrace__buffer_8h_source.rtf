00105 {\cf17 inline} {\cf18 void} dtraceBlockRec( {\cf17 const} CPelUnitBuf& pelUnitBuf, {\cf17 const} UnitArea& ua, PredMode predMode, uint32_t zIdx = 0 )\par
00106 \{\par
00107   {\cf19 if}( ua.blocks[COMPONENT_Y].valid() )\par
00108   \{\par
00109     {\cf17 const} {\cf18 int}     x0           = ua.lumaPos().x;\par
00110     {\cf17 const} {\cf18 int}     y0           = ua.lumaPos().y;\par
00111     {\cf17 const} uint32_t    uiStride     = pelUnitBuf.Y().stride;\par
00112     {\cf17 const} Pel*    piReco       = pelUnitBuf.Y().buf;\par
00113     {\cf17 const} uint32_t    uiWidth      = ua.lumaSize().width;\par
00114     {\cf17 const} uint32_t    uiHeight     = ua.lumaSize().height;\par
00115     DTRACE      ( g_trace_ctx, D_REC_CB_LUMA,   {\cf22 "%d, x=%d, y=%d, size=%dx%d, predmode=%d \\n"}, zIdx, x0, y0, uiWidth, uiHeight, predMode );\par
00116     DTRACE_BLOCK( g_trace_ctx, D_REC_CB_LUMA,   piReco, uiStride, uiWidth, uiHeight );\par
00117   \}\par
00118   {\cf19 if}( ua.blocks[COMPONENT_Cb].valid() )\par
00119   \{\par
00120     {\cf17 const} {\cf18 int}     x0           = ua.blocks[1].x;\par
00121     {\cf17 const} {\cf18 int}     y0           = ua.blocks[1].y;\par
00122     {\cf17 const} uint32_t    uiWidth      = ua.blocks[1].width;\par
00123     {\cf17 const} uint32_t    uiHeight     = ua.blocks[1].height;\par
00124     {\cf17 const} uint32_t    uiCStride    = pelUnitBuf.Cb().stride;\par
