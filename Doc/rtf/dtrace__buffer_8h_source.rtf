00170 {\cf17 inline} {\cf18 void} dtraceMotField( CDTrace *trace_ctx, {\cf17 const} PredictionUnit& pu )\par
00171 \{\par
00172   DTRACE( trace_ctx, D_MOT_FIELD, {\cf22 "PU %d,%d @ %d,%d\\n"}, pu.lwidth(), pu.lheight(), pu.lx(), pu.ly() );\par
00173   {\cf17 const} CMotionBuf mb = pu.getMotionBuf();\par
00174   {\cf19 for}( uint32_t listIdx = 0; listIdx < 2; listIdx++ )\par
00175   \{\par
00176     RefPicList eListIdx = RefPicList( listIdx );\par
00177     {\cf19 for}( {\cf18 int} y = 0, i = 0; y < pu.lheight(); y += 4 )\par
00178     \{\par
00179       {\cf19 for}( {\cf18 int} x = 0; x < pu.lwidth(); x += 4, i++ )\par
00180       \{\par
00181         {\cf17 const} MotionInfo &mi = mb.at( x >> 2, y >> 2 );\par
00182         DTRACE( trace_ctx, D_MOT_FIELD, {\cf22 "%d,%d:%d  "}, mi.mv[eListIdx].getHor(), mi.mv[eListIdx].getVer(), mi.refIdx[eListIdx] );\par
00183       \}\par
00184       DTRACE( trace_ctx, D_MOT_FIELD, {\cf22 "\\n"} );\par
00185     \}\par
00186     DTRACE( trace_ctx, D_MOT_FIELD, {\cf22 "\\n"} );\par
00187   \}\par
00188 \}\par
