00050 {\cf17 inline} {\cf18 unsigned} calcCheckSum( {\cf17 const} {\cf18 int} iWidth, {\cf17 const} {\cf18 int} iHeight,  {\cf17 const} Pel* p,  {\cf17 const} uint32_t stride,  {\cf17 const} {\cf18 int} bitdepth )\par
00051 \{\par
00052   {\cf18 unsigned} checksum = 0;\par
00053   {\cf19 for}( {\cf18 unsigned} y = 0; y < iHeight; y++)\par
00054   \{\par
00055     {\cf19 for}( {\cf18 unsigned}  x = 0; x < iWidth; x++)\par
00056     \{\par
00057       uint8_t xor_mask = (x & 0xff) ^ (y & 0xff) ^ (x >> 8) ^ (y >> 8);\par
00058       checksum = (checksum + ((p[y*stride+x] & 0xff) ^ xor_mask)) & 0xffffffff;\par
00059 \par
00060       {\cf19 if}(bitdepth > 8)\par
00061       \{\par
00062         checksum = (checksum + ((p[y*stride+x]>>8) ^ xor_mask)) & 0xffffffff;\par
00063       \}\par
00064     \}\par
00065   \}\par
00066   {\cf19 return} checksum;\par
00067 \}\par
00068 \par
00069 {\cf17 inline} {\cf18 unsigned} calcCheckSum( {\cf17 const} CPelBuf& buf, {\cf18 int} bitdepth )\par
00070 \{\par
00071   {\cf19 return} calcCheckSum( buf.width, buf.height, buf.buf, buf.stride, bitdepth );\par
00072 \}\par
