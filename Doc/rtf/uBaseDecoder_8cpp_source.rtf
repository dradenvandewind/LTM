00098 BaseDecoder::BaseDecoder() : m_currentBits(0), m_remainingBits(8), m_byteOffset(0) \{\}\par
00099 \par
00100 BaseDecoder::~BaseDecoder() \{\}\par
00101 \par
00102 {\cf18 void} BaseDecoder::Unencapsulate({\cf17 const} uint8_t *nalIn, uint32_t nalLength, DataBuffer &out) \{\par
00103     out.resize(nalLength);\par
00104 \par
00105     {\cf17 const} uint8_t *nalEnd = nalIn + nalLength;\par
00106     uint8_t *outPtr = out.data();\par
00107 \par
00108     {\cf19 while} (nalIn < nalEnd - 3) \{\par
00109         {\cf19 if} (memcmp(nalIn, kNalEscape, kNalEscapeLength) == 0) \{\par
00110             nalIn += 3;\par
00111             *outPtr++ = 0;\par
00112             *outPtr++ = 0;\par
00113         \} {\cf19 else} \{\par
00114             *outPtr++ = *nalIn;\par
00115             nalIn++;\par
00116         \}\par
00117     \}\par
00118 \par
00119     {\cf20 // Appending remaining data.}\par
00120     uint32_t remaining = {\cf17 static_cast<}uint32_t{\cf17 >}(nalEnd - nalIn);\par
00121     {\cf19 if} (remaining) \{\par
00122         memcpy(outPtr, nalIn, remaining);\par
00123         outPtr += remaining;\par
00124     \}\par
00125 \par
00126     {\cf20 // Shrink to correct size.}\par
00127     uint32_t newLength = {\cf17 static_cast<}uint32_t{\cf17 >}(outPtr - out.data());\par
00128     out.resize(newLength);\par
00129 \}\par
00130 \par
00131 uint32_t BaseDecoder::ReadBits(uint8_t numBits) \{\par
00132     assert(numBits <= 32);\par
00133 \par
00134     uint32_t res = 0;\par
00135 \par
00136     {\cf19 while} (numBits) \{\par
00137         {\cf19 if} (m_remainingBits < numBits) \{\par
00138             res <<= m_remainingBits;                         {\cf20 // Make room}\par
00139             res |= (m_currentBits >> (8 - m_remainingBits)); {\cf20 // Push in the bits we want}\par
00140             numBits -= m_remainingBits;                      {\cf20 // Reduce number of bits remaining to read}\par
00141             m_byteOffset++;                                  {\cf20 // Move to next byte for next load}\par
00142 \par
00143             {\cf19 if} (m_byteOffset >= m_currentNalPayload.size()) {\cf20 // Safety.}\par
00144             \{\par
00145                 INFO({\cf22 "ERROR -- NalParsing error, out of bytes to read from"});\par
00146                 {\cf19 throw} std::runtime_error({\cf22 "NalParsing error, out of bytes to read from"});\par
00147             \}\par
00148 \par
00149             m_currentBits = *(m_currentNalPayload.data() + m_byteOffset); {\cf20 // Load in new byte}\par
00150             m_remainingBits = 8;                                          {\cf20 // Reset remaining bits}\par
00151         \} {\cf19 else} \{\par
00152             res <<= numBits;                         {\cf20 // Make room}\par
00153             res |= (m_currentBits >> (8 - numBits)); {\cf20 // Push in the bits we want}\par
00154             m_currentBits <<= numBits;               {\cf20 // Update current bits}\par
00155             m_remainingBits -= numBits;              {\cf20 // Reduce number of bits remaining to read}\par
00156             numBits = 0;                             {\cf20 // Done.}\par
00157         \}\par
00158     \}\par
00159 \par
00160     {\cf19 return} res;\par
00161 \}\par
00162 \par
00163 uint32_t BaseDecoder::ReadUE() \{\par
00164     uint32_t digitCount = 0;\par
00165     uint32_t bit = ReadBits(1);\par
00166     uint32_t res = 0;\par
00167 \par
00168     {\cf19 while} (bit == 0) \{\par
00169         digitCount += 1;\par
00170         bit = ReadBits(1);\par
00171     \}\par
00172 \par
00173     res = bit;\par
00174 \par
00175     {\cf19 while} (digitCount > 0) \{\par
00176         digitCount -= 1;\par
00177         res <<= 1;\par
00178         res |= ReadBits(1);\par
00179     \}\par
00180 \par
00181     {\cf19 return} res - 1;\par
00182 \}\par
00183 \par
00184 int32_t BaseDecoder::ReadSE() \{\par
00185     uint32_t ue = ReadUE();\par
00186 \par
00187     {\cf20 // Even UE are negative.}\par
00188     {\cf20 // Odd are positive.}\par
00189 \par
00190     {\cf19 if} (ue & 0x01) \{\par
00191         {\cf19 return} {\cf17 static_cast<}int32_t{\cf17 >}((ue + 1) >> 1);\par
00192     \} {\cf19 else} \{\par
00193         {\cf20 // Negate, and on even boundary so no need for the addition.}\par
00194         {\cf19 return} -{\cf17 static_cast<}int32_t{\cf17 >}(ue >> 1);\par
00195     \}\par
00196 \}\par
00197 \par
00198 {\cf18 bool} BaseDecoder::ReadFlag() \{\par
00199     uint32_t bit = ReadBits(1);\par
00200     {\cf19 return} (bit != 0);\par
00201 \}\par
00202 \par
00203 {\cf18 bool} BaseDecoder::ByteAligned(){\cf17  const }\{\par
00204     {\cf19 return} (m_remainingBits % 8) == 0;\par
00205 \}\par
