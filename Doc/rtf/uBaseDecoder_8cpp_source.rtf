00066 {\cf17 const} uint32_t kNalHeaderLength = 3;\par
00067 {\cf17 const} uint8_t kNalHeader[kNalHeaderLength] = \{0, 0, 1\};\par
00068 {\cf17 const} uint32_t kNalEscapeLength = 3;\par
00069 {\cf17 const} uint8_t kNalEscape[kNalEscapeLength] = \{0, 0, 3\};\par
00070 {\cf17 const} uint8_t kBitCountByteMask[9] = \{0, 128, 192, 224, 240, 248, 252, 254, 255\};\par
00071 {\cf17 const} uint8_t kMaxNumRefFramesAllowed = 16;\par
00072 \par
00073 uint32_t GetBitCountFromMax(uint32_t maxValue) \{\par
00074     {\cf20 // Bit count is determined by ceil(log2(maxRepresentation);}\par
00075     {\cf20 // Because log2 is c99 which is not so widely available we can use standard log with a divide.}\par
00076     {\cf20 // log2(x) = logY(x) / logY(2)}\par
00077     {\cf20 //}\par
00078     {\cf20 // Alternatively we want to find the highest bit set in maxValue.}\par
00079     {\cf17 static} {\cf17 const} {\cf18 float} logBase = log(2.0f);\par
00080     {\cf18 float} log2Value = log({\cf17 static_cast<}{\cf18 float}{\cf17 >}(maxValue)) / logBase;\par
00081     {\cf19 return} {\cf17 static_cast<}uint32_t{\cf17 >}(ceil(log2Value));\par
00082 \}\par
00083 \par
00084 {\cf17 static} uint32_t uOffsetForNalUnitHeader({\cf17 const} uint8_t *nal) \{\par
00085     {\cf19 if} (memcmp(nal, kNalHeader, kNalHeaderLength) == 0)\par
00086         {\cf19 return} kNalHeaderLength;\par
00087     {\cf19 if} (!nal[0] && memcmp(nal + 1, kNalHeader, kNalHeaderLength) == 0)\par
00088         {\cf19 return} kNalHeaderLength + 1;\par
00089     {\cf19 return} 0;\par
00090 \}\par
00091 \par
00092 \} {\cf20 // namespace}\par
