00140 {\cf20 // Return byte offset of pixel row within buffer}\par
00141 {\cf18 unsigned} ImageDescription::row_offset({\cf18 unsigned} {\cf18 int} plane, {\cf18 unsigned} row){\cf17  const }\{\par
