00205 {\cf20 // Make a new image description with different bit depth}\par
00206 ImageDescription ImageDescription::with_depth({\cf18 unsigned} depth){\cf17  const }\{\par
00207     {\cf18 unsigned} fmt = (format_ - IMAGE_FORMAT_YUV420P8) % (IMAGE_FORMAT_YUV420P10 - IMAGE_FORMAT_YUV420P8);\par
00208     fmt += IMAGE_FORMAT_YUV420P8;\par
00209 \par
00210     {\cf19 switch} (depth) \{\par
00211     {\cf19 case} 8:\par
00212         {\cf19 break};\par
00213     {\cf19 case} 10:\par
00214         fmt += IMAGE_FORMAT_YUV420P10 - IMAGE_FORMAT_YUV420P8;\par
00215         {\cf19 break};\par
00216     {\cf19 case} 12:\par
00217         fmt += IMAGE_FORMAT_YUV420P12 - IMAGE_FORMAT_YUV420P8;\par
00218         {\cf19 break};\par
00219     {\cf19 case} 14:\par
00220         fmt += IMAGE_FORMAT_YUV420P14 - IMAGE_FORMAT_YUV420P8;\par
00221         {\cf19 break};\par
00222     {\cf19 case} 16:\par
00223         fmt += IMAGE_FORMAT_YUV420P16 - IMAGE_FORMAT_YUV420P8;\par
00224         {\cf19 break};\par
00225     {\cf19 default}:\par
00226         CHECK(0);\par
00227     \}\par
00228 \par
00229     {\cf19 return} ImageDescription({\cf17 static_cast<}ImageFormat{\cf17 >}(fmt), width(), height());\par
00230 \}\par
00231 \par
00232 {\cf20 // Make a new image description with different size}\par
00233 ImageDescription ImageDescription::with_size({\cf18 unsigned} width, {\cf18 unsigned} height){\cf17  const }\{\par
00234     {\cf19 return} ImageDescription(format_, width, height);\par
00235 \}\par
