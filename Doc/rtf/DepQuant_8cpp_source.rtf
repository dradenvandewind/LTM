01574 {\cf18 void} DepQuant::quant( TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &pSrc, TCoeff &uiAbsSum, {\cf17 const} QpParam &cQP, {\cf17 const} Ctx& ctx )\par
01575 \{\par
01576   {\cf17 const} {\cf18 bool} useRegularResidualCoding = tu.cu->slice->getTSResidualCodingDisabledFlag() || tu.mtsIdx[compID] != MTS_SKIP;\par
01577   {\cf19 if}( tu.cs->slice->getDepQuantEnabledFlag() && useRegularResidualCoding )\par
01578   \{\par
01579     {\cf20 //===== scaling matrix ====}\par
01580     {\cf17 const} {\cf18 int}         qpDQ            = cQP.Qp(tu.mtsIdx[compID] == MTS_SKIP) + 1;\par
01581     {\cf17 const} {\cf18 int}         qpPer           = qpDQ / 6;\par
01582     {\cf17 const} {\cf18 int}         qpRem           = qpDQ - 6 * qpPer;\par
01583     {\cf17 const} CompArea    &rect           = tu.blocks[compID];\par
01584     {\cf17 const} {\cf18 int}         width           = rect.width;\par
01585     {\cf17 const} {\cf18 int}         height          = rect.height;\par
01586     uint32_t          scalingListType = getScalingListType(tu.cu->predMode, compID);\par
01587     CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
01588     {\cf17 const} uint32_t    log2TrWidth     = floorLog2(width);\par
01589     {\cf17 const} uint32_t    log2TrHeight    = floorLog2(height);\par
01590 \par
01591     {\cf17 const} {\cf18 bool}        disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
01592     {\cf17 const} {\cf18 bool}        isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
01593     {\cf17 const} {\cf18 bool}        disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
01594     {\cf17 const} {\cf18 bool}        enableScalingLists = getUseScalingList(width, height, (tu.mtsIdx[compID] == MTS_SKIP), isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
01595     {\cf17 static_cast<}DQIntern::DepQuant*{\cf17 >}(p)->quant( tu, pSrc, compID, cQP, Quant::m_dLambda, ctx, uiAbsSum, enableScalingLists, Quant::getQuantCoeff(scalingListType, qpRem, log2TrWidth, log2TrHeight) );\par
01596   \}\par
01597   {\cf19 else}\par
01598   \{\par
01599     QuantRDOQ::quant( tu, compID, pSrc, uiAbsSum, cQP, ctx );\par
01600   \}\par
01601 \}\par
