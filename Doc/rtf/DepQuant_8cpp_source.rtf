00340   TUParameters::TUParameters( {\cf17 const} Rom& rom, {\cf17 const} {\cf18 unsigned} width, {\cf17 const} {\cf18 unsigned} height, {\cf17 const} ChannelType chType )\par
00341   \{\par
00342     m_chType              = chType;\par
00343     m_width               = width;\par
00344     m_height              = height;\par
00345     {\cf17 const} uint32_t nonzeroWidth  = std::min<uint32_t>(JVET_C0024_ZERO_OUT_TH, m_width);\par
00346     {\cf17 const} uint32_t nonzeroHeight = std::min<uint32_t>(JVET_C0024_ZERO_OUT_TH, m_height);\par
00347     m_numCoeff                   = nonzeroWidth * nonzeroHeight;\par
00348     {\cf17 const} {\cf18 int} log2W       = floorLog2( m_width  );\par
00349     {\cf17 const} {\cf18 int} log2H       = floorLog2( m_height );\par
00350     m_log2SbbWidth        = g_log2SbbSize[ log2W ][ log2H ][0];\par
00351     m_log2SbbHeight       = g_log2SbbSize[ log2W ][ log2H ][1];\par
00352     m_log2SbbSize         = m_log2SbbWidth + m_log2SbbHeight;\par
00353     m_sbbSize             = ( 1 << m_log2SbbSize );\par
00354     m_sbbMask             = m_sbbSize - 1;\par
00355     m_widthInSbb  = nonzeroWidth >> m_log2SbbWidth;\par
00356     m_heightInSbb = nonzeroHeight >> m_log2SbbHeight;\par
00357     m_numSbb              = m_widthInSbb * m_heightInSbb;\par
00358     m_scanType            = SCAN_DIAG;\par
00359     SizeType        hsbb  = gp_sizeIdxInfo->idxFrom( m_widthInSbb  );\par
00360     SizeType        vsbb  = gp_sizeIdxInfo->idxFrom( m_heightInSbb );\par
00361     SizeType        hsId  = gp_sizeIdxInfo->idxFrom( m_width  );\par
00362     SizeType        vsId  = gp_sizeIdxInfo->idxFrom( m_height );\par
00363     m_scanSbbId2SbbPos    = g_scanOrder     [ SCAN_UNGROUPED   ][ m_scanType ][ hsbb ][ vsbb ];\par
00364     m_scanId2BlkPos       = g_scanOrder     [ SCAN_GROUPED_4x4 ][ m_scanType ][ hsId ][ vsId ];\par
00365     m_scanId2NbInfoSbb    = rom.getNbInfoSbb( log2W, log2H );\par
00366     m_scanId2NbInfoOut    = rom.getNbInfoOut( log2W, log2H );\par
00367     m_scanInfo            = {\cf17 new} ScanInfo[ m_numCoeff ];\par
00368     {\cf19 for}( {\cf18 int} scanIdx = 0; scanIdx < m_numCoeff; scanIdx++ )\par
00369     \{\par
00370       xSetScanInfo( m_scanInfo[scanIdx], scanIdx );\par
00371     \}\par
00372   \}\par
