01435 \par
01436   {\cf18 void} DepQuant::quant( TransformUnit& tu, {\cf17 const} CCoeffBuf& srcCoeff, {\cf17 const} ComponentID compID, {\cf17 const} QpParam& cQP, {\cf17 const} {\cf18 double} lambda, {\cf17 const} Ctx& ctx, TCoeff& absSum, {\cf18 bool} enableScalingLists, {\cf18 int}* quantCoeff )\par
01437   \{\par
01438     CHECKD( tu.cs->sps->getSpsRangeExtension().getExtendedPrecisionProcessingFlag(), {\cf22 "ext precision is not supported"} );\par
01439 \par
01440     {\cf20 //===== reset / pre-init =====}\par
01441     {\cf17 const} TUParameters& tuPars  = *g_Rom.getTUPars( tu.blocks[compID], compID );\par
01442     m_quant.initQuantBlock    ( tu, compID, cQP, lambda );\par
01443     TCoeff*       qCoeff      = tu.getCoeffs( compID ).buf;\par
01444     {\cf17 const} TCoeff* tCoeff      = srcCoeff.buf;\par
01445     {\cf17 const} {\cf18 int}     numCoeff    = tu.blocks[compID].area();\par
01446     ::memset( tu.getCoeffs( compID ).buf, 0x00, numCoeff*{\cf17 sizeof}(TCoeff) );\par
01447     absSum          = 0;\par
01448 \par
01449     {\cf17 const} CompArea& area     = tu.blocks[ compID ];\par
01450     {\cf17 const} uint32_t  width    = area.width;\par
01451     {\cf17 const} uint32_t  height   = area.height;\par
01452     {\cf17 const} uint32_t  lfnstIdx = tu.cu->lfnstIdx;\par
01453     {\cf20 //===== scaling matrix ====}\par
01454     {\cf20 //const int         qpDQ = cQP.Qp + 1;}\par
01455     {\cf20 //const int         qpPer = qpDQ / 6;}\par
01456     {\cf20 //const int         qpRem = qpDQ - 6 * qpPer;}\par
01457 \par
01458     {\cf20 //TCoeff thresTmp = thres;}\par
01459     {\cf18 bool} zeroOut = {\cf17 false};\par
01460     {\cf18 bool} zeroOutforThres = {\cf17 false};\par
01461     {\cf18 int} effWidth = tuPars.m_width, effHeight = tuPars.m_height;\par
01462     {\cf19 if}( ( tu.mtsIdx[compID] > MTS_SKIP || (tu.cs->sps->getUseMTS() && tu.cu->sbtInfo != 0 && tuPars.m_height <= 32 && tuPars.m_width <= 32)) && compID == COMPONENT_Y)\par
01463     \{\par
01464       effHeight = (tuPars.m_height == 32) ? 16 : tuPars.m_height;\par
01465       effWidth = (tuPars.m_width == 32) ? 16 : tuPars.m_width;\par
01466       zeroOut = (effHeight < tuPars.m_height || effWidth < tuPars.m_width);\par
01467     \}\par
01468     zeroOutforThres = zeroOut || (32 < tuPars.m_height || 32 < tuPars.m_width);\par
01469     {\cf20 //===== find first test position =====}\par
01470     {\cf18 int} firstTestPos = numCoeff - 1;\par
01471     {\cf19 if} (lfnstIdx > 0 && tu.mtsIdx[compID] != MTS_SKIP && width >= 4 && height >= 4)\par
01472     \{\par
01473       firstTestPos = ( ( width == 4 && height == 4 ) || ( width == 8 && height == 8 ) )  ? 7 : 15 ;\par
01474     \}\par
01475     {\cf17 const} TCoeff defaultQuantisationCoefficient = (TCoeff)m_quant.getQScale();\par
01476     {\cf17 const} TCoeff thres = m_quant.getLastThreshold();\par
01477     {\cf19 for}( ; firstTestPos >= 0; firstTestPos-- )\par
01478     \{\par
01479       {\cf19 if} (zeroOutforThres && (tuPars.m_scanId2BlkPos[firstTestPos].x >= ((tuPars.m_width == 32 && zeroOut) ? 16 : 32)\par
01480                            || tuPars.m_scanId2BlkPos[firstTestPos].y >= ((tuPars.m_height == 32 && zeroOut) ? 16 : 32)))\par
01481         {\cf19 continue};\par
01482       TCoeff thresTmp = (enableScalingLists) ? TCoeff(thres / (4 * quantCoeff[tuPars.m_scanId2BlkPos[firstTestPos].idx]))\par
01483                                              : TCoeff(thres / (4 * defaultQuantisationCoefficient));\par
01484 \par
01485       {\cf19 if} (abs(tCoeff[tuPars.m_scanId2BlkPos[firstTestPos].idx]) > thresTmp)\par
01486       \{\par
01487         {\cf19 break};\par
01488       \}\par
01489     \}\par
01490     {\cf19 if}( firstTestPos < 0 )\par
01491     \{\par
01492       {\cf19 return};\par
01493     \}\par
01494 \par
01495     {\cf20 //===== real init =====}\par
01496     RateEstimator::initCtx( tuPars, tu, compID, ctx.getFracBitsAcess() );\par
01497     m_commonCtx.reset( tuPars, *{\cf17 this} );\par
01498     {\cf19 for}( {\cf18 int} k = 0; k < 12; k++ )\par
01499     \{\par
01500       m_allStates[k].init();\par
01501     \}\par
01502     m_startState.init();\par
01503 \par
01504 \par
01505     {\cf18 int} effectWidth = std::min(32, effWidth);\par
01506     {\cf18 int} effectHeight = std::min(32, effHeight);\par
01507     {\cf19 for} ({\cf18 int} k = 0; k < 12; k++)\par
01508     \{\par
01509       m_allStates[k].effWidth = effectWidth;\par
01510       m_allStates[k].effHeight = effectHeight;\par
01511     \}\par
01512     m_startState.effWidth = effectWidth;\par
01513     m_startState.effHeight = effectHeight;\par
01514 \par
01515     {\cf20 //===== populate trellis =====}\par
01516     {\cf19 for}( {\cf18 int} scanIdx = firstTestPos; scanIdx >= 0; scanIdx-- )\par
01517     \{\par
01518       {\cf17 const} ScanInfo& scanInfo = tuPars.m_scanInfo[ scanIdx ];\par
01519       {\cf19 if} (enableScalingLists)\par
01520       \{\par
01521         m_quant.initQuantBlock(tu, compID, cQP, lambda, quantCoeff[scanInfo.rasterPos]);\par
01522         xDecideAndUpdate( abs( tCoeff[scanInfo.rasterPos]), scanInfo, (zeroOut && (scanInfo.posX >= effWidth || scanInfo.posY >= effHeight)), quantCoeff[scanInfo.rasterPos] );\par
01523       \}\par
01524       {\cf19 else}\par
01525         xDecideAndUpdate( abs( tCoeff[scanInfo.rasterPos]), scanInfo, (zeroOut && (scanInfo.posX >= effWidth || scanInfo.posY >= effHeight)), defaultQuantisationCoefficient );\par
01526     \}\par
01527 \par
01528     {\cf20 //===== find best path =====}\par
01529     Decision  decision    = \{ std::numeric_limits<int64_t>::max(), -1, -2 \};\par
01530     int64_t   minPathCost =  0;\par
01531     {\cf19 for}( int8_t stateId = 0; stateId < 4; stateId++ )\par
01532     \{\par
01533       int64_t pathCost = m_trellis[0][stateId].rdCost;\par
01534       {\cf19 if}( pathCost < minPathCost )\par
01535       \{\par
01536         decision.prevId = stateId;\par
01537         minPathCost     = pathCost;\par
01538       \}\par
01539     \}\par
01540 \par
01541     {\cf20 //===== backward scanning =====}\par
01542     {\cf18 int} scanIdx = 0;\par
01543     {\cf19 for}( ; decision.prevId >= 0; scanIdx++ )\par
01544     \{\par
01545       decision          = m_trellis[ scanIdx ][ decision.prevId ];\par
01546       int32_t blkpos    = tuPars.m_scanId2BlkPos[scanIdx].idx;\par
01547       qCoeff[ blkpos ]  = ( tCoeff[ blkpos ] < 0 ? -decision.absLevel : decision.absLevel );\par
01548       absSum           += decision.absLevel;\par
01549     \}\par
01550   \}\par
01551 \par
01552 \}; {\cf20 // namespace DQIntern}\par
