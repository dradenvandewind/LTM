00154     \{\par
00155       {\cf19 return};\par
00156     \}\par
00157     ::memset( m_scanId2NbInfoSbbArray, 0, {\cf17 sizeof}(m_scanId2NbInfoSbbArray) );\par
00158     ::memset( m_scanId2NbInfoOutArray, 0, {\cf17 sizeof}(m_scanId2NbInfoOutArray) );\par
00159     ::memset( m_tuParameters,          0, {\cf17 sizeof}(m_tuParameters) );\par
00160 \par
00161     uint32_t raster2id[ MAX_CU_SIZE * MAX_CU_SIZE ];\par
00162     ::memset(raster2id, 0, {\cf17 sizeof}(raster2id));\par
00163 \par
00164     {\cf19 for}( {\cf18 int} hd = 0; hd <= MAX_CU_DEPTH; hd++ )\par
00165     \{\par
00166       {\cf19 for}( {\cf18 int} vd = 0; vd <= MAX_CU_DEPTH; vd++ )\par
00167       \{\par
00168         {\cf19 if}( (hd == 0 && vd <= 1) || (hd <= 1 && vd == 0) )\par
00169         \{\par
00170           {\cf19 continue};\par
00171         \}\par
00172         {\cf17 const} uint32_t      blockWidth    = (1 << hd);\par
00173         {\cf17 const} uint32_t      blockHeight   = (1 << vd);\par
00174         {\cf17 const} uint32_t      log2CGWidth   = g_log2SbbSize[hd][vd][0];\par
00175         {\cf17 const} uint32_t      log2CGHeight  = g_log2SbbSize[hd][vd][1];\par
00176         {\cf17 const} uint32_t      groupWidth    = 1 << log2CGWidth;\par
00177         {\cf17 const} uint32_t      groupHeight   = 1 << log2CGHeight;\par
00178         {\cf17 const} uint32_t      groupSize     = groupWidth * groupHeight;\par
00179         {\cf17 const} CoeffScanType scanType      = SCAN_DIAG;\par
00180         {\cf17 const} SizeType      blkWidthIdx   = gp_sizeIdxInfo->idxFrom( blockWidth  );\par
00181         {\cf17 const} SizeType      blkHeightIdx  = gp_sizeIdxInfo->idxFrom( blockHeight );\par
00182         {\cf17 const} ScanElement * scanId2RP     = g_scanOrder[SCAN_GROUPED_4x4][scanType][blkWidthIdx][blkHeightIdx];\par
00183         NbInfoSbb*&         sId2NbSbb     = m_scanId2NbInfoSbbArray[hd][vd];\par
00184         NbInfoOut*&         sId2NbOut     = m_scanId2NbInfoOutArray[hd][vd];\par
00185         {\cf20 // consider only non-zero-out region}\par
00186         {\cf17 const} uint32_t      blkWidthNZOut = std::min<unsigned>( JVET_C0024_ZERO_OUT_TH, blockWidth  );\par
00187         {\cf17 const} uint32_t      blkHeightNZOut= std::min<unsigned>( JVET_C0024_ZERO_OUT_TH, blockHeight );\par
00188         {\cf17 const} uint32_t      totalValues   = blkWidthNZOut * blkHeightNZOut;\par
00189 \par
00190         sId2NbSbb = {\cf17 new} NbInfoSbb[ totalValues ];\par
00191         sId2NbOut = {\cf17 new} NbInfoOut[ totalValues ];\par
00192 \par
00193         {\cf19 for}( uint32_t scanId = 0; scanId < totalValues; scanId++ )\par
00194         \{\par
00195           raster2id[scanId2RP[scanId].idx] = scanId;\par
00196         \}\par
00197 \par
00198         {\cf19 for}( {\cf18 unsigned} scanId = 0; scanId < totalValues; scanId++ )\par
00199         \{\par
00200           {\cf17 const} {\cf18 int} posX = scanId2RP[scanId].x;\par
00201           {\cf17 const} {\cf18 int} posY = scanId2RP[scanId].y;\par
00202           {\cf17 const} {\cf18 int} rpos = scanId2RP[scanId].idx;\par
00203           \{\par
00204             {\cf20 //===== inside subband neighbours =====}\par
00205             NbInfoSbb&     nbSbb  = sId2NbSbb[ scanId ];\par
00206             {\cf17 const} {\cf18 int}      begSbb = scanId - ( scanId & (groupSize-1) ); {\cf20 // first pos in current subblock}\par
00207             {\cf18 int}            cpos[5];\par
00208 \par
00209             cpos[0] = ( posX + 1 < blkWidthNZOut                              ? ( raster2id[rpos+1           ] < groupSize + begSbb ? raster2id[rpos+1           ] - begSbb : 0 ) : 0 );\par
00210             cpos[1] = ( posX + 2 < blkWidthNZOut                              ? ( raster2id[rpos+2           ] < groupSize + begSbb ? raster2id[rpos+2           ] - begSbb : 0 ) : 0 );\par
00211             cpos[2] = ( posX + 1 < blkWidthNZOut && posY + 1 < blkHeightNZOut ? ( raster2id[rpos+1+blockWidth] < groupSize + begSbb ? raster2id[rpos+1+blockWidth] - begSbb : 0 ) : 0 );\par
00212             cpos[3] = ( posY + 1 < blkHeightNZOut                             ? ( raster2id[rpos+  blockWidth] < groupSize + begSbb ? raster2id[rpos+  blockWidth] - begSbb : 0 ) : 0 );\par
00213             cpos[4] = ( posY + 2 < blkHeightNZOut                             ? ( raster2id[rpos+2*blockWidth] < groupSize + begSbb ? raster2id[rpos+2*blockWidth] - begSbb : 0 ) : 0 );\par
00214 \par
00215             {\cf19 for}( nbSbb.num = 0; {\cf17 true}; )\par
00216             \{\par
00217               {\cf18 int} nk = -1;\par
00218               {\cf19 for}( {\cf18 int} k = 0; k < 5; k++ )\par
00219               \{\par
00220                 {\cf19 if}( cpos[k] != 0 && ( nk < 0 || cpos[k] < cpos[nk] ) )\par
00221                 \{\par
00222                   nk = k;\par
00223                 \}\par
00224               \}\par
00225               {\cf19 if}( nk < 0 )\par
00226               \{\par
00227                 {\cf19 break};\par
00228               \}\par
00229               nbSbb.inPos[ nbSbb.num++ ] = uint8_t( cpos[nk] );\par
00230               cpos[nk] = 0;\par
00231             \}\par
00232             {\cf19 for}( {\cf18 int} k = nbSbb.num; k < 5; k++ )\par
00233             \{\par
00234               nbSbb.inPos[k] = 0;\par
00235             \}\par
00236           \}\par
00237           \{\par
00238             {\cf20 //===== outside subband neighbours =====}\par
00239             NbInfoOut&     nbOut  = sId2NbOut[ scanId ];\par
00240             {\cf17 const} {\cf18 int}      begSbb = scanId - ( scanId & (groupSize-1) ); {\cf20 // first pos in current subblock}\par
00241             {\cf18 int}            cpos[5];\par
00242 \par
00243             cpos[0] = ( posX + 1 < blkWidthNZOut                              ? ( raster2id[rpos+1           ] >= groupSize + begSbb ? raster2id[rpos+1           ] : 0 ) : 0 );\par
00244             cpos[1] = ( posX + 2 < blkWidthNZOut                              ? ( raster2id[rpos+2           ] >= groupSize + begSbb ? raster2id[rpos+2           ] : 0 ) : 0 );\par
00245             cpos[2] = ( posX + 1 < blkWidthNZOut && posY + 1 < blkHeightNZOut ? ( raster2id[rpos+1+blockWidth] >= groupSize + begSbb ? raster2id[rpos+1+blockWidth] : 0 ) : 0 );\par
00246             cpos[3] = ( posY + 1 < blkHeightNZOut                             ? ( raster2id[rpos+  blockWidth] >= groupSize + begSbb ? raster2id[rpos+  blockWidth] : 0 ) : 0 );\par
00247             cpos[4] = ( posY + 2 < blkHeightNZOut                             ? ( raster2id[rpos+2*blockWidth] >= groupSize + begSbb ? raster2id[rpos+2*blockWidth] : 0 ) : 0 );\par
00248 \par
00249             {\cf19 for}( nbOut.num = 0; {\cf17 true}; )\par
00250             \{\par
00251               {\cf18 int} nk = -1;\par
00252               {\cf19 for}( {\cf18 int} k = 0; k < 5; k++ )\par
00253               \{\par
00254                 {\cf19 if}( cpos[k] != 0 && ( nk < 0 || cpos[k] < cpos[nk] ) )\par
00255                 \{\par
00256                   nk = k;\par
00257                 \}\par
00258               \}\par
00259               {\cf19 if}( nk < 0 )\par
00260               \{\par
00261                 {\cf19 break};\par
00262               \}\par
00263               nbOut.outPos[ nbOut.num++ ] = uint16_t( cpos[nk] );\par
00264               cpos[nk] = 0;\par
00265             \}\par
00266             {\cf19 for}( {\cf18 int} k = nbOut.num; k < 5; k++ )\par
00267             \{\par
00268               nbOut.outPos[k] = 0;\par
00269             \}\par
00270             nbOut.maxDist = ( scanId == 0 ? 0 : sId2NbOut[scanId-1].maxDist );\par
00271             {\cf19 for}( {\cf18 int} k = 0; k < nbOut.num; k++ )\par
00272             \{\par
00273               {\cf19 if}( nbOut.outPos[k] > nbOut.maxDist )\par
00274               \{\par
00275                 nbOut.maxDist = nbOut.outPos[k];\par
00276               \}\par
00277             \}\par
00278           \}\par
00279         \}\par
00280 \par
00281         {\cf20 // make it relative}\par
00282         {\cf19 for}( {\cf18 unsigned} scanId = 0; scanId < totalValues; scanId++ )\par
00283         \{\par
00284           NbInfoOut& nbOut  = sId2NbOut[scanId];\par
00285           {\cf17 const} {\cf18 int}  begSbb = scanId - ( scanId & (groupSize-1) ); {\cf20 // first pos in current subblock}\par
00286           {\cf19 for}( {\cf18 int} k = 0; k < nbOut.num; k++ )\par
00287           \{\par
00288             CHECK(begSbb > nbOut.outPos[k], {\cf22 "Position must be past sub block begin"});\par
00289             nbOut.outPos[k] -= begSbb;\par
00290           \}\par
00291           nbOut.maxDist -= scanId;\par
00292         \}\par
00293 \par
00294         {\cf19 for}( {\cf18 int} chId = 0; chId < MAX_NUM_CHANNEL_TYPE; chId++ )\par
00295         \{\par
00296           m_tuParameters[hd][vd][chId] = {\cf17 new} TUParameters( *{\cf17 this}, blockWidth, blockHeight, ChannelType(chId) );\par
00297         \}\par
00298       \}\par
00299     \}\par
00300     m_scansInitialized = {\cf17 true};\par
00301   \}\par
