01333   {\cf18 void} DepQuant::xDecide( {\cf17 const} ScanPosType spt, {\cf17 const} TCoeff absCoeff, {\cf17 const} {\cf18 int} lastOffset, Decision* decisions, {\cf18 bool} zeroOut, TCoeff quanCoeff)\par
01334   \{\par
01335     ::memcpy( decisions, startDec, 8*{\cf17 sizeof}(Decision) );\par
01336 \par
01337     {\cf19 if}( zeroOut )\par
01338     \{\par
01339       {\cf19 if}( spt==SCAN_EOCSBB )\par
01340       \{\par
01341         m_skipStates[0].checkRdCostSkipSbbZeroOut( decisions[0] );\par
01342         m_skipStates[1].checkRdCostSkipSbbZeroOut( decisions[1] );\par
01343         m_skipStates[2].checkRdCostSkipSbbZeroOut( decisions[2] );\par
01344         m_skipStates[3].checkRdCostSkipSbbZeroOut( decisions[3] );\par
01345       \}\par
01346       {\cf19 return};\par
01347     \}\par
01348 \par
01349     PQData  pqData[4];\par
01350     m_quant.preQuantCoeff( absCoeff, pqData, quanCoeff );\par
01351     m_prevStates[0].checkRdCosts( spt, pqData[0], pqData[2], decisions[0], decisions[2]);\par
01352     m_prevStates[1].checkRdCosts( spt, pqData[0], pqData[2], decisions[2], decisions[0]);\par
01353     m_prevStates[2].checkRdCosts( spt, pqData[3], pqData[1], decisions[1], decisions[3]);\par
01354     m_prevStates[3].checkRdCosts( spt, pqData[3], pqData[1], decisions[3], decisions[1]);\par
01355     {\cf19 if}( spt==SCAN_EOCSBB )\par
01356     \{\par
01357         m_skipStates[0].checkRdCostSkipSbb( decisions[0] );\par
01358         m_skipStates[1].checkRdCostSkipSbb( decisions[1] );\par
01359         m_skipStates[2].checkRdCostSkipSbb( decisions[2] );\par
01360         m_skipStates[3].checkRdCostSkipSbb( decisions[3] );\par
01361     \}\par
01362 \par
01363     m_startState.checkRdCostStart( lastOffset, pqData[0], decisions[0] );\par
01364     m_startState.checkRdCostStart( lastOffset, pqData[2], decisions[2] );\par
01365   \}\par
01366 \par
01367   {\cf18 void} DepQuant::xDecideAndUpdate( {\cf17 const} TCoeff absCoeff, {\cf17 const} ScanInfo& scanInfo, {\cf18 bool} zeroOut, TCoeff quantCoeff )\par
01368   \{\par
01369     Decision* decisions = m_trellis[ scanInfo.scanIdx ];\par
01370 \par
01371     std::swap( m_prevStates, m_currStates );\par
01372 \par
01373     xDecide( scanInfo.spt, absCoeff, lastOffset(scanInfo.scanIdx), decisions, zeroOut, quantCoeff );\par
01374 \par
01375     {\cf19 if}( scanInfo.scanIdx )\par
01376     \{\par
01377       {\cf19 if}( scanInfo.eosbb )\par
01378       \{\par
01379         m_commonCtx.swap();\par
01380         m_currStates[0].updateStateEOS( scanInfo, m_prevStates, m_skipStates, decisions[0] );\par
01381         m_currStates[1].updateStateEOS( scanInfo, m_prevStates, m_skipStates, decisions[1] );\par
01382         m_currStates[2].updateStateEOS( scanInfo, m_prevStates, m_skipStates, decisions[2] );\par
01383         m_currStates[3].updateStateEOS( scanInfo, m_prevStates, m_skipStates, decisions[3] );\par
01384         ::memcpy( decisions+4, decisions, 4*{\cf17 sizeof}(Decision) );\par
01385       \}\par
01386       {\cf19 else} {\cf19 if}( !zeroOut )\par
01387       \{\par
01388         {\cf19 switch}( scanInfo.nextNbInfoSbb.num )\par
01389         \{\par
01390         {\cf19 case} 0:\par
01391           m_currStates[0].updateState<0>( scanInfo, m_prevStates, decisions[0] );\par
01392           m_currStates[1].updateState<0>( scanInfo, m_prevStates, decisions[1] );\par
01393           m_currStates[2].updateState<0>( scanInfo, m_prevStates, decisions[2] );\par
01394           m_currStates[3].updateState<0>( scanInfo, m_prevStates, decisions[3] );\par
01395           {\cf19 break};\par
01396         {\cf19 case} 1:\par
01397           m_currStates[0].updateState<1>( scanInfo, m_prevStates, decisions[0] );\par
01398           m_currStates[1].updateState<1>( scanInfo, m_prevStates, decisions[1] );\par
01399           m_currStates[2].updateState<1>( scanInfo, m_prevStates, decisions[2] );\par
01400           m_currStates[3].updateState<1>( scanInfo, m_prevStates, decisions[3] );\par
01401           {\cf19 break};\par
01402         {\cf19 case} 2:\par
01403           m_currStates[0].updateState<2>( scanInfo, m_prevStates, decisions[0] );\par
01404           m_currStates[1].updateState<2>( scanInfo, m_prevStates, decisions[1] );\par
01405           m_currStates[2].updateState<2>( scanInfo, m_prevStates, decisions[2] );\par
01406           m_currStates[3].updateState<2>( scanInfo, m_prevStates, decisions[3] );\par
01407           {\cf19 break};\par
01408         {\cf19 case} 3:\par
01409           m_currStates[0].updateState<3>( scanInfo, m_prevStates, decisions[0] );\par
01410           m_currStates[1].updateState<3>( scanInfo, m_prevStates, decisions[1] );\par
01411           m_currStates[2].updateState<3>( scanInfo, m_prevStates, decisions[2] );\par
01412           m_currStates[3].updateState<3>( scanInfo, m_prevStates, decisions[3] );\par
01413           {\cf19 break};\par
01414         {\cf19 case} 4:\par
01415           m_currStates[0].updateState<4>( scanInfo, m_prevStates, decisions[0] );\par
01416           m_currStates[1].updateState<4>( scanInfo, m_prevStates, decisions[1] );\par
01417           m_currStates[2].updateState<4>( scanInfo, m_prevStates, decisions[2] );\par
01418           m_currStates[3].updateState<4>( scanInfo, m_prevStates, decisions[3] );\par
01419           {\cf19 break};\par
01420         {\cf19 default}:\par
01421           m_currStates[0].updateState<5>( scanInfo, m_prevStates, decisions[0] );\par
01422           m_currStates[1].updateState<5>( scanInfo, m_prevStates, decisions[1] );\par
01423           m_currStates[2].updateState<5>( scanInfo, m_prevStates, decisions[2] );\par
01424           m_currStates[3].updateState<5>( scanInfo, m_prevStates, decisions[3] );\par
01425         \}\par
01426       \}\par
01427 \par
01428       {\cf19 if}( scanInfo.spt == SCAN_SOCSBB )\par
01429       \{\par
01430         std::swap( m_prevStates, m_skipStates );\par
01431       \}\par
01432     \}\par
01433   \}\par
