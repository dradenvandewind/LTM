00580       CoeffFracBits&  cb    = m_gtxFracBits[ ctxId ];\par
00581       int32_t         par0  = (1<<SCALE_BITS) + int32_t(fbPar.intBits[0]);\par
00582       int32_t         par1  = (1<<SCALE_BITS) + int32_t(fbPar.intBits[1]);\par
00583       cb.bits[0] = 0;\par
00584       cb.bits[1] = fbGt1.intBits[0] + (1 << SCALE_BITS);\par
00585       cb.bits[2] = fbGt1.intBits[1] + par0 + fbGt2.intBits[0];\par
00586       cb.bits[3] = fbGt1.intBits[1] + par1 + fbGt2.intBits[0];\par
00587       cb.bits[4] = fbGt1.intBits[1] + par0 + fbGt2.intBits[1];\par
00588       cb.bits[5] = fbGt1.intBits[1] + par1 + fbGt2.intBits[1];\par
00589     \}\par
