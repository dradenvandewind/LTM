01603 {\cf18 void} DepQuant::dequant( {\cf17 const} TransformUnit &tu, CoeffBuf &dstCoeff, {\cf17 const} ComponentID &compID, {\cf17 const} QpParam &cQP )\par
01604 \{\par
01605   {\cf17 const} {\cf18 bool} useRegularResidualCoding = tu.cu->slice->getTSResidualCodingDisabledFlag() || tu.mtsIdx[compID] != MTS_SKIP;\par
01606   {\cf19 if}( tu.cs->slice->getDepQuantEnabledFlag() && useRegularResidualCoding )\par
01607   \{\par
01608     {\cf17 const} {\cf18 int}         qpDQ            = cQP.Qp(tu.mtsIdx[compID] == MTS_SKIP) + 1;\par
01609     {\cf17 const} {\cf18 int}         qpPer           = qpDQ / 6;\par
01610     {\cf17 const} {\cf18 int}         qpRem           = qpDQ - 6 * qpPer;\par
01611     {\cf17 const} CompArea    &rect           = tu.blocks[compID];\par
01612     {\cf17 const} {\cf18 int}         width           = rect.width;\par
01613     {\cf17 const} {\cf18 int}         height          = rect.height;\par
01614     uint32_t          scalingListType = getScalingListType(tu.cu->predMode, compID);\par
01615     CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
01616     {\cf17 const} uint32_t    log2TrWidth  = floorLog2(width);\par
01617     {\cf17 const} uint32_t    log2TrHeight = floorLog2(height);\par
01618 \par
01619     {\cf17 const} {\cf18 bool} disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
01620     {\cf17 const} {\cf18 bool} isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
01621     {\cf17 const} {\cf18 bool} disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
01622     {\cf17 const} {\cf18 bool} enableScalingLists = getUseScalingList(width, height, (tu.mtsIdx[compID] == MTS_SKIP), isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
01623     {\cf17 static_cast<}DQIntern::DepQuant*{\cf17 >}(p)->dequant( tu, dstCoeff, compID, cQP, enableScalingLists, Quant::getDequantCoeff(scalingListType, qpRem, log2TrWidth, log2TrHeight) );\par
01624   \}\par
01625   {\cf19 else}\par
01626   \{\par
01627     QuantRDOQ::dequant( tu, dstCoeff, compID, cQP );\par
01628   \}\par
01629 \}\par
