00375   {\cf18 void} TUParameters::xSetScanInfo( ScanInfo& scanInfo, {\cf18 int} scanIdx )\par
00376   \{\par
00377     scanInfo.chType     = m_chType;\par
00378     scanInfo.tuWidth    = m_width;\par
00379     scanInfo.tuHeight   = m_height;\par
00380     scanInfo.sbbSize    = m_sbbSize;\par
00381     scanInfo.numSbb     = m_numSbb;\par
00382     scanInfo.scanIdx    = scanIdx;\par
00383     scanInfo.rasterPos  = m_scanId2BlkPos[scanIdx].idx;\par
00384     scanInfo.sbbPos     = m_scanSbbId2SbbPos[scanIdx >> m_log2SbbSize].idx;\par
00385     scanInfo.insidePos  = scanIdx & m_sbbMask;\par
00386     scanInfo.eosbb      = ( scanInfo.insidePos == 0 );\par
00387     scanInfo.spt        = SCAN_ISCSBB;\par
00388     {\cf19 if}(  scanInfo.insidePos == m_sbbMask && scanIdx > scanInfo.sbbSize && scanIdx < m_numCoeff - 1 )\par
00389       scanInfo.spt      = SCAN_SOCSBB;\par
00390     {\cf19 else} {\cf19 if}( scanInfo.eosbb && scanIdx > 0 && scanIdx < m_numCoeff - m_sbbSize )\par
00391       scanInfo.spt      = SCAN_EOCSBB;\par
00392     scanInfo.posX = m_scanId2BlkPos[scanIdx].x;\par
00393     scanInfo.posY = m_scanId2BlkPos[scanIdx].y;\par
00394     {\cf19 if}( scanIdx )\par
00395     \{\par
00396       {\cf17 const} {\cf18 int} nextScanIdx = scanIdx - 1;\par
00397       {\cf17 const} {\cf18 int} diag        = m_scanId2BlkPos[nextScanIdx].x + m_scanId2BlkPos[nextScanIdx].y;\par
00398       {\cf19 if}( m_chType == CHANNEL_TYPE_LUMA )\par
00399       \{\par
00400         scanInfo.sigCtxOffsetNext = ( diag < 2 ? 8 : diag < 5 ?  4 : 0 );\par
00401         scanInfo.gtxCtxOffsetNext = ( diag < 1 ? 16 : diag < 3 ? 11 : diag < 10 ? 6 : 1 );\par
00402       \}\par
00403       {\cf19 else}\par
00404       \{\par
00405         scanInfo.sigCtxOffsetNext = ( diag < 2 ? 4 : 0 );\par
00406         scanInfo.gtxCtxOffsetNext = ( diag < 1 ? 6 : 1 );\par
00407       \}\par
00408       scanInfo.nextInsidePos      = nextScanIdx & m_sbbMask;\par
00409       scanInfo.nextNbInfoSbb      = m_scanId2NbInfoSbb[ nextScanIdx ];\par
00410       {\cf19 if}( scanInfo.eosbb )\par
00411       \{\par
00412         {\cf17 const} {\cf18 int} nextSbbPos  = m_scanSbbId2SbbPos[nextScanIdx >> m_log2SbbSize].idx;\par
00413         {\cf17 const} {\cf18 int} nextSbbPosY = nextSbbPos               / m_widthInSbb;\par
00414         {\cf17 const} {\cf18 int} nextSbbPosX = nextSbbPos - nextSbbPosY * m_widthInSbb;\par
00415         scanInfo.nextSbbRight = ( nextSbbPosX < m_widthInSbb  - 1 ? nextSbbPos + 1            : 0 );\par
00416         scanInfo.nextSbbBelow = ( nextSbbPosY < m_heightInSbb - 1 ? nextSbbPos + m_widthInSbb : 0 );\par
00417       \}\par
00418     \}\par
00419   \}\par
