00303   {\cf18 void} Rom::xUninitScanArrays()\par
00304   \{\par
00305     {\cf19 if}( !m_scansInitialized )\par
00306     \{\par
00307       {\cf19 return};\par
00308     \}\par
00309     {\cf19 for}( {\cf18 int} hd = 0; hd <= MAX_CU_DEPTH; hd++ )\par
00310     \{\par
00311       {\cf19 for}( {\cf18 int} vd = 0; vd <= MAX_CU_DEPTH; vd++ )\par
00312       \{\par
00313         NbInfoSbb*& sId2NbSbb = m_scanId2NbInfoSbbArray[hd][vd];\par
00314         NbInfoOut*& sId2NbOut = m_scanId2NbInfoOutArray[hd][vd];\par
00315         {\cf19 if}( sId2NbSbb )\par
00316         \{\par
00317           {\cf17 delete} [] sId2NbSbb;\par
00318         \}\par
00319         {\cf19 if}( sId2NbOut )\par
00320         \{\par
00321           {\cf17 delete} [] sId2NbOut;\par
00322         \}\par
00323         {\cf19 for}( {\cf18 int} chId = 0; chId < MAX_NUM_CHANNEL_TYPE; chId++ )\par
00324         \{\par
00325           TUParameters*& tuPars = m_tuParameters[hd][vd][chId];\par
00326           {\cf19 if}( tuPars )\par
00327           \{\par
00328             {\cf17 delete} tuPars;\par
00329           \}\par
00330         \}\par
00331       \}\par
00332     \}\par
00333     m_scansInitialized = {\cf17 false};\par
00334   \}\par
