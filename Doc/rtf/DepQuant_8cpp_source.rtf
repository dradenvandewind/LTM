00472   {\cf18 void} RateEstimator::xSetLastCoeffOffset( {\cf17 const} FracBitsAccess& fracBitsAccess, {\cf17 const} TUParameters& tuPars, {\cf17 const} TransformUnit& tu, {\cf17 const} ComponentID compID )\par
00473   \{\par
00474     {\cf17 const} ChannelType chType = ( compID == COMPONENT_Y ? CHANNEL_TYPE_LUMA : CHANNEL_TYPE_CHROMA );\par
00475     int32_t cbfDeltaBits = 0;\par
00476     {\cf19 if}( compID == COMPONENT_Y && !CU::isIntra(*tu.cu) && !tu.depth )\par
00477     \{\par
00478       {\cf17 const} BinFracBits bits  = fracBitsAccess.getFracBitsArray( Ctx::QtRootCbf() );\par
00479       cbfDeltaBits            = int32_t( bits.intBits[1] ) - int32_t( bits.intBits[0] );\par
00480     \}\par
00481     {\cf19 else}\par
00482     \{\par
00483       BinFracBits bits;\par
00484       {\cf18 bool} prevLumaCbf           = {\cf17 false};\par
00485       {\cf18 bool} lastCbfIsInferred     = {\cf17 false};\par
00486       {\cf18 bool} useIntraSubPartitions = tu.cu->ispMode && isLuma(chType);\par
00487       {\cf19 if}( useIntraSubPartitions )\par
00488       \{\par
00489         {\cf18 bool} rootCbfSoFar = {\cf17 false};\par
00490         {\cf18 bool} isLastSubPartition = CU::isISPLast(*tu.cu, tu.Y(), compID);\par
00491         uint32_t nTus = tu.cu->ispMode == HOR_INTRA_SUBPARTITIONS ? tu.cu->lheight() >> floorLog2(tu.lheight()) : tu.cu->lwidth() >> floorLog2(tu.lwidth());\par
00492         {\cf19 if}( isLastSubPartition )\par
00493         \{\par
00494           TransformUnit* tuPointer = tu.cu->firstTU;\par
00495           {\cf19 for}( {\cf18 int} tuIdx = 0; tuIdx < nTus - 1; tuIdx++ )\par
00496           \{\par
00497             rootCbfSoFar |= TU::getCbfAtDepth(*tuPointer, COMPONENT_Y, tu.depth);\par
00498             tuPointer     = tuPointer->next;\par
00499           \}\par
00500           {\cf19 if}( !rootCbfSoFar )\par
00501           \{\par
00502             lastCbfIsInferred = {\cf17 true};\par
00503           \}\par
00504         \}\par
00505         {\cf19 if}( !lastCbfIsInferred )\par
00506         \{\par
00507           prevLumaCbf = TU::getPrevTuCbfAtDepth(tu, compID, tu.depth);\par
00508         \}\par
00509         bits = fracBitsAccess.getFracBitsArray(Ctx::QtCbf[compID](DeriveCtx::CtxQtCbf(compID, prevLumaCbf, {\cf17 true})));\par
00510       \}\par
00511       {\cf19 else}\par
00512       \{\par
00513         bits = fracBitsAccess.getFracBitsArray(Ctx::QtCbf[compID](DeriveCtx::CtxQtCbf(compID, tu.cbf[COMPONENT_Cb])));\par
00514       \}\par
00515       cbfDeltaBits = lastCbfIsInferred ? 0 : int32_t(bits.intBits[1]) - int32_t(bits.intBits[0]);\par
00516     \}\par
00517 \par
00518     {\cf17 static} {\cf17 const} {\cf18 unsigned} prefixCtx[] = \{ 0, 0, 0, 3, 6, 10, 15, 21 \};\par
00519     uint32_t              ctxBits  [ LAST_SIGNIFICANT_GROUPS ];\par
00520     {\cf19 for}( {\cf18 unsigned} xy = 0; xy < 2; xy++ )\par
00521     \{\par
00522       int32_t             bitOffset   = ( xy ? cbfDeltaBits : 0 );\par
00523       int32_t*            lastBits    = ( xy ? m_lastBitsY : m_lastBitsX );\par
00524       {\cf17 const} {\cf18 unsigned}      size        = ( xy ? tuPars.m_height : tuPars.m_width );\par
00525       {\cf17 const} {\cf18 unsigned}      log2Size    = ceilLog2( size );\par
00526       {\cf17 const} {\cf18 bool}          useYCtx     = ( xy != 0 );\par
00527       {\cf17 const} CtxSet&       ctxSetLast  = ( useYCtx ? Ctx::LastY : Ctx::LastX )[ chType ];\par
00528       {\cf17 const} {\cf18 unsigned}      lastShift   = ( compID == COMPONENT_Y ? (log2Size+1)>>2 : Clip3<unsigned>(0,2,size>>3) );\par
00529       {\cf17 const} {\cf18 unsigned}      lastOffset  = ( compID == COMPONENT_Y ? ( prefixCtx[log2Size] ) : 0 );\par
00530       uint32_t            sumFBits    = 0;\par
00531       {\cf18 unsigned}            maxCtxId    = g_uiGroupIdx[std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, size) - 1];\par
00532       {\cf19 for}( {\cf18 unsigned} ctxId = 0; ctxId < maxCtxId; ctxId++ )\par
00533       \{\par
00534         {\cf17 const} BinFracBits bits  = fracBitsAccess.getFracBitsArray( ctxSetLast( lastOffset + ( ctxId >> lastShift ) ) );\par
00535         ctxBits[ ctxId ]        = sumFBits + bits.intBits[0] + ( ctxId>3 ? ((ctxId-2)>>1)<<SCALE_BITS : 0 ) + bitOffset;\par
00536         sumFBits               +=            bits.intBits[1];\par
00537       \}\par
00538       ctxBits  [ maxCtxId ]     = sumFBits + ( maxCtxId>3 ? ((maxCtxId-2)>>1)<<SCALE_BITS : 0 ) + bitOffset;\par
00539       {\cf19 for} ({\cf18 unsigned} pos = 0; pos < std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, size); pos++)\par
00540       \{\par
00541         lastBits[ pos ]         = ctxBits[ g_uiGroupIdx[ pos ] ];\par
00542       \}\par
00543     \}\par
00544   \}\par
