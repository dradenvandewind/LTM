01329   {\cf17 static} {\cf17 const} Decision startDec[8] = \{DINIT(-1,-2),DINIT(-1,-2),DINIT(-1,-2),DINIT(-1,-2),DINIT(0,4),DINIT(0,5),DINIT(0,6),DINIT(0,7)\};\par
