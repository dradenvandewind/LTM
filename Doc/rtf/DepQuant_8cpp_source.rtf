01018   {\cf17 inline} {\cf18 void} State::updateState({\cf17 const} ScanInfo &scanInfo, {\cf17 const} State *prevStates, {\cf17 const} Decision &decision)\par
01019   \{\par
01020     m_rdCost = decision.rdCost;\par
01021     {\cf19 if}( decision.prevId > -2 )\par
01022     \{\par
01023       {\cf19 if}( decision.prevId >= 0 )\par
01024       \{\par
01025         {\cf17 const} State*  prvState  = prevStates            +   decision.prevId;\par
01026         m_numSigSbb             = prvState->m_numSigSbb + !!decision.absLevel;\par
01027         m_refSbbCtxId           = prvState->m_refSbbCtxId;\par
01028         m_sbbFracBits           = prvState->m_sbbFracBits;\par
01029         m_remRegBins            = prvState->m_remRegBins - 1;\par
01030         m_goRicePar             = prvState->m_goRicePar;\par
01031         {\cf19 if}( m_remRegBins >= 4 )\par
01032         \{\par
01033           m_remRegBins -= (decision.absLevel < 2 ? (unsigned)decision.absLevel : 3);\par
01034         \}\par
01035         ::memcpy( m_absLevelsAndCtxInit, prvState->m_absLevelsAndCtxInit, 48*{\cf17 sizeof}(uint8_t) );\par
01036       \}\par
01037       {\cf19 else}\par
01038       \{\par
01039         m_numSigSbb     =  1;\par
01040         m_refSbbCtxId   = -1;\par
01041         {\cf18 int} ctxBinSampleRatio = (scanInfo.chType == CHANNEL_TYPE_LUMA) ? MAX_TU_LEVEL_CTX_CODED_BIN_CONSTRAINT_LUMA : MAX_TU_LEVEL_CTX_CODED_BIN_CONSTRAINT_CHROMA;\par
01042         m_remRegBins = (effWidth * effHeight *ctxBinSampleRatio) / 16 - (decision.absLevel < 2 ? ({\cf18 unsigned})decision.absLevel : 3);\par
01043         ::memset( m_absLevelsAndCtxInit, 0, 48*{\cf17 sizeof}(uint8_t) );\par
01044       \}\par
01045 \par
01046       uint8_t* levels               = {\cf17 reinterpret_cast<}uint8_t*{\cf17 >}(m_absLevelsAndCtxInit);\par
01047       levels[ scanInfo.insidePos ]  = (uint8_t)std::min<TCoeff>( 255, decision.absLevel );\par
01048 \par
01049       {\cf19 if} (m_remRegBins >= 4)\par
01050       \{\par
01051         TCoeff  tinit = m_absLevelsAndCtxInit[8 + scanInfo.nextInsidePos];\par
01052         TCoeff  sumAbs1 = (tinit >> 3) & 31;\par
01053         TCoeff  sumNum = tinit & 7;\par
01054 {\cf21 #define UPDATE(k) \{TCoeff t=levels[scanInfo.nextNbInfoSbb.inPos[k]]; sumAbs1+=std::min<TCoeff>(4+(t&1),t); sumNum+=!!t; \}}\par
01055         {\cf19 if} (numIPos == 1)\par
01056         \{\par
01057           UPDATE(0);\par
01058         \}\par
01059         {\cf19 else} {\cf19 if} (numIPos == 2)\par
01060         \{\par
01061           UPDATE(0);\par
01062           UPDATE(1);\par
01063         \}\par
01064         {\cf19 else} {\cf19 if} (numIPos == 3)\par
01065         \{\par
01066           UPDATE(0);\par
01067           UPDATE(1);\par
01068           UPDATE(2);\par
01069         \}\par
01070         {\cf19 else} {\cf19 if} (numIPos == 4)\par
01071         \{\par
01072           UPDATE(0);\par
01073           UPDATE(1);\par
01074           UPDATE(2);\par
01075           UPDATE(3);\par
01076         \}\par
01077         {\cf19 else} {\cf19 if} (numIPos == 5)\par
01078         \{\par
01079           UPDATE(0);\par
01080           UPDATE(1);\par
01081           UPDATE(2);\par
01082           UPDATE(3);\par
01083           UPDATE(4);\par
01084         \}\par
01085 {\cf21 #undef UPDATE}\par
01086         TCoeff sumGt1 = sumAbs1 - sumNum;\par
01087         m_sigFracBits = m_sigFracBitsArray[scanInfo.sigCtxOffsetNext + std::min<TCoeff>( (sumAbs1+1)>>1, 3 )];\par
01088         m_coeffFracBits = m_gtxFracBitsArray[scanInfo.gtxCtxOffsetNext + (sumGt1 < 4 ? sumGt1 : 4)];\par
01089 \par
01090         TCoeff  sumAbs = m_absLevelsAndCtxInit[8 + scanInfo.nextInsidePos] >> 8;\par
01091 {\cf21 #define UPDATE(k) \{TCoeff t=levels[scanInfo.nextNbInfoSbb.inPos[k]]; sumAbs+=t; \}}\par
01092         {\cf19 if} (numIPos == 1)\par
01093         \{\par
01094           UPDATE(0);\par
01095         \}\par
01096         {\cf19 else} {\cf19 if} (numIPos == 2)\par
01097         \{\par
01098           UPDATE(0);\par
01099           UPDATE(1);\par
01100         \}\par
01101         {\cf19 else} {\cf19 if} (numIPos == 3)\par
01102         \{\par
01103           UPDATE(0);\par
01104           UPDATE(1);\par
01105           UPDATE(2);\par
01106         \}\par
01107         {\cf19 else} {\cf19 if} (numIPos == 4)\par
01108         \{\par
01109           UPDATE(0);\par
01110           UPDATE(1);\par
01111           UPDATE(2);\par
01112           UPDATE(3);\par
01113         \}\par
01114         {\cf19 else} {\cf19 if} (numIPos == 5)\par
01115         \{\par
01116           UPDATE(0);\par
01117           UPDATE(1);\par
01118           UPDATE(2);\par
01119           UPDATE(3);\par
01120           UPDATE(4);\par
01121         \}\par
01122 {\cf21 #undef UPDATE}\par
01123         {\cf18 int} sumAll = std::max(std::min(31, ({\cf18 int})sumAbs - 4 * 5), 0);\par
01124         m_goRicePar = g_auiGoRiceParsCoeff[sumAll];\par
01125       \}\par
01126       {\cf19 else}\par
01127       \{\par
01128         TCoeff  sumAbs = m_absLevelsAndCtxInit[8 + scanInfo.nextInsidePos] >> 8;\par
01129 {\cf21 #define UPDATE(k) \{TCoeff t=levels[scanInfo.nextNbInfoSbb.inPos[k]]; sumAbs+=t; \}}\par
01130         {\cf19 if} (numIPos == 1)\par
01131         \{\par
01132           UPDATE(0);\par
01133         \}\par
01134         {\cf19 else} {\cf19 if} (numIPos == 2)\par
01135         \{\par
01136           UPDATE(0);\par
01137           UPDATE(1);\par
01138         \}\par
01139         {\cf19 else} {\cf19 if} (numIPos == 3)\par
01140         \{\par
01141           UPDATE(0);\par
01142           UPDATE(1);\par
01143           UPDATE(2);\par
01144         \}\par
01145         {\cf19 else} {\cf19 if} (numIPos == 4)\par
01146         \{\par
01147           UPDATE(0);\par
01148           UPDATE(1);\par
01149           UPDATE(2);\par
01150           UPDATE(3);\par
01151         \}\par
01152         {\cf19 else} {\cf19 if} (numIPos == 5)\par
01153         \{\par
01154           UPDATE(0);\par
01155           UPDATE(1);\par
01156           UPDATE(2);\par
01157           UPDATE(3);\par
01158           UPDATE(4);\par
01159         \}\par
01160 {\cf21 #undef UPDATE}\par
01161         sumAbs = std::min<TCoeff>(31, sumAbs);\par
01162         m_goRicePar = g_auiGoRiceParsCoeff[sumAbs];\par
01163         m_goRiceZero = g_auiGoRicePosCoeff0(m_stateId, m_goRicePar);\par
01164       \}\par
01165     \}\par
01166   \}\par
