00652   {\cf17 inline} {\cf18 int} ceil_log2(uint64_t x)\par
00653   \{\par
00654     {\cf17 static} {\cf17 const} uint64_t t[6] = \{ 0xFFFFFFFF00000000ull, 0x00000000FFFF0000ull, 0x000000000000FF00ull, 0x00000000000000F0ull, 0x000000000000000Cull, 0x0000000000000002ull \};\par
00655     {\cf18 int} y = (((x & (x - 1)) == 0) ? 0 : 1);\par
00656     {\cf18 int} j = 32;\par
00657     {\cf19 for}( {\cf18 int} i = 0; i < 6; i++)\par
00658     \{\par
00659       {\cf18 int} k = (((x & t[i]) == 0) ? 0 : j);\par
00660       y += k;\par
00661       x >>= k;\par
00662       j >>= 1;\par
00663     \}\par
00664     {\cf19 return} y;\par
00665   \}\par
00666   {\cf18 void} Quantizer::initQuantBlock({\cf17 const} TransformUnit& tu, {\cf17 const} ComponentID compID, {\cf17 const} QpParam& cQP, {\cf17 const} {\cf18 double} lambda, {\cf18 int} gValue = -1)\par
00667   \{\par
00668     CHECKD( lambda <= 0.0, {\cf22 "Lambda must be greater than 0"} );\par
00669 \par
00670     {\cf17 const} {\cf18 int}         qpDQ                  = cQP.Qp(tu.mtsIdx[compID] == MTS_SKIP) + 1;\par
00671     {\cf17 const} {\cf18 int}         qpPer                 = qpDQ / 6;\par
00672     {\cf17 const} {\cf18 int}         qpRem                 = qpDQ - 6 * qpPer;\par
00673     {\cf17 const} SPS&        sps                   = *tu.cs->sps;\par
00674     {\cf17 const} CompArea&   area                  = tu.blocks[ compID ];\par
00675     {\cf17 const} ChannelType chType                = toChannelType( compID );\par
00676     {\cf17 const} {\cf18 int}         channelBitDepth       = sps.getBitDepth( chType );\par
00677     {\cf17 const} {\cf18 int}         maxLog2TrDynamicRange = sps.getMaxLog2TrDynamicRange( chType );\par
00678     {\cf17 const} {\cf18 int}         nomTransformShift     = getTransformShift( channelBitDepth, area.size(), maxLog2TrDynamicRange );\par
00679     {\cf17 const} {\cf18 bool}        clipTransformShift    = ( tu.mtsIdx[compID] == MTS_SKIP && sps.getSpsRangeExtension().getExtendedPrecisionProcessingFlag());\par
00680     {\cf17 const} {\cf18 bool}    needsSqrt2ScaleAdjustment = TU::needsSqrt2Scale(tu, compID);\par
00681     {\cf17 const} {\cf18 int}         transformShift        = ( clipTransformShift ? std::max<int>( 0, nomTransformShift ) : nomTransformShift ) + (needsSqrt2ScaleAdjustment?-1:0);\par
00682     {\cf20 // quant parameters}\par
00683     m_QShift                    = QUANT_SHIFT  - 1 + qpPer + transformShift;\par
00684     m_QAdd                      = -( ( 3 << m_QShift ) >> 1 );\par
00685     {\cf18 int}               invShift  = IQUANT_SHIFT + 1 - qpPer - transformShift;\par
00686     m_QScale                    = g_quantScales[needsSqrt2ScaleAdjustment?1:0][ qpRem ];\par
00687     {\cf17 const} {\cf18 unsigned}    qIdxBD    = std::min<unsigned>( maxLog2TrDynamicRange + 1, 8*{\cf17 sizeof}(Intermediate_Int) + invShift - IQUANT_SHIFT - 1 );\par
00688     m_maxQIdx                   = ( 1 << (qIdxBD-1) ) - 4;\par
00689     m_thresLast                 = TCoeff((int64_t(4) << m_QShift));\par
00690     m_thresSSbb                 = TCoeff((int64_t(3) << m_QShift));\par
00691     {\cf20 // distortion calculation parameters}\par
00692     {\cf17 const} int64_t qScale        = (gValue==-1) ? m_QScale : gValue;\par
00693     {\cf17 const} {\cf18 int} nomDShift =\par
00694       SCALE_BITS - 2 * (nomTransformShift + DISTORTION_PRECISION_ADJUSTMENT(channelBitDepth)) + m_QShift + (needsSqrt2ScaleAdjustment ? 1 : 0);\par
00695     {\cf17 const} {\cf18 double}  qScale2       = double( qScale * qScale );\par
00696     {\cf17 const} {\cf18 double}  nomDistFactor = ( nomDShift < 0 ? 1.0/(double(int64_t(1)<<(-nomDShift))*qScale2*lambda) : double(int64_t(1)<<nomDShift)/(qScale2*lambda) );\par
00697     {\cf17 const} int64_t pow2dfShift   = (int64_t)( nomDistFactor * qScale2 ) + 1;\par
00698     {\cf17 const} {\cf18 int}     dfShift       = ceil_log2( pow2dfShift );\par
00699     m_DistShift                 = 62 + m_QShift - 2*maxLog2TrDynamicRange - dfShift;\par
00700     m_DistAdd                   = (int64_t(1) << m_DistShift) >> 1;\par
00701     m_DistStepAdd               = (int64_t)( nomDistFactor * {\cf18 double}(int64_t(1)<<(m_DistShift+m_QShift)) + .5 );\par
00702     m_DistOrgFact               = (int64_t)( nomDistFactor * {\cf18 double}(int64_t(1)<<(m_DistShift+1       )) + .5 );\par
00703   \}\par
