00705   {\cf18 void} Quantizer::dequantBlock( {\cf17 const} TransformUnit& tu, {\cf17 const} ComponentID compID, {\cf17 const} QpParam& cQP, CoeffBuf& recCoeff, {\cf18 bool} enableScalingLists, {\cf18 int}* piDequantCoef){\cf17  const}\par
00706 {\cf17   }\{\par
00707 \par
00708     {\cf20 //----- set basic parameters -----}\par
00709     {\cf17 const} CompArea&     area      = tu.blocks[ compID ];\par
00710     {\cf17 const} {\cf18 int}           numCoeff  = area.area();\par
00711     {\cf17 const} SizeType      hsId      = gp_sizeIdxInfo->idxFrom( area.width  );\par
00712     {\cf17 const} SizeType      vsId      = gp_sizeIdxInfo->idxFrom( area.height );\par
00713     {\cf17 const} CoeffScanType scanType  = SCAN_DIAG;\par
00714     {\cf17 const} ScanElement *scan       = g_scanOrder[SCAN_GROUPED_4x4][scanType][hsId][vsId];\par
00715     {\cf17 const} TCoeff*       qCoeff    = tu.getCoeffs( compID ).buf;\par
00716           TCoeff*       tCoeff    = recCoeff.buf;\par
00717 \par
00718     {\cf20 //----- reset coefficients and get last scan index -----}\par
00719     ::memset( tCoeff, 0, numCoeff * {\cf17 sizeof}(TCoeff) );\par
00720     {\cf18 int} lastScanIdx = -1;\par
00721     {\cf19 for}( {\cf18 int} scanIdx = numCoeff - 1; scanIdx >= 0; scanIdx-- )\par
00722     \{\par
00723       {\cf19 if} (qCoeff[scan[scanIdx].idx])\par
00724       \{\par
00725         lastScanIdx = scanIdx;\par
00726         {\cf19 break};\par
00727       \}\par
00728     \}\par
00729     {\cf19 if}( lastScanIdx < 0 )\par
00730     \{\par
00731       {\cf19 return};\par
00732     \}\par
00733 \par
00734     {\cf20 //----- set dequant parameters -----}\par
00735     {\cf17 const} {\cf18 int}         qpDQ                  = cQP.Qp(tu.mtsIdx[compID] == MTS_SKIP) + 1;\par
00736     {\cf17 const} {\cf18 int}         qpPer                 = qpDQ / 6;\par
00737     {\cf17 const} {\cf18 int}         qpRem                 = qpDQ - 6 * qpPer;\par
00738     {\cf17 const} SPS&        sps                   = *tu.cs->sps;\par
00739     {\cf17 const} ChannelType chType                = toChannelType( compID );\par
00740     {\cf17 const} {\cf18 int}         channelBitDepth       = sps.getBitDepth( chType );\par
00741     {\cf17 const} {\cf18 int}         maxLog2TrDynamicRange = sps.getMaxLog2TrDynamicRange( chType );\par
00742     {\cf17 const} TCoeff      minTCoeff             = -( 1 << maxLog2TrDynamicRange );\par
00743     {\cf17 const} TCoeff      maxTCoeff             =  ( 1 << maxLog2TrDynamicRange ) - 1;\par
00744     {\cf17 const} {\cf18 int}         nomTransformShift     = getTransformShift( channelBitDepth, area.size(), maxLog2TrDynamicRange );\par
00745     {\cf17 const} {\cf18 bool}        clipTransformShift    = ( tu.mtsIdx[compID] == MTS_SKIP && sps.getSpsRangeExtension().getExtendedPrecisionProcessingFlag());\par
00746     {\cf17 const} {\cf18 bool}    needsSqrt2ScaleAdjustment = TU::needsSqrt2Scale(tu, compID);\par
00747     {\cf17 const} {\cf18 int}         transformShift        = ( clipTransformShift ? std::max<int>( 0, nomTransformShift ) : nomTransformShift ) + (needsSqrt2ScaleAdjustment?-1:0);\par
00748     Intermediate_Int  shift                 = IQUANT_SHIFT + 1 - qpPer - transformShift + (enableScalingLists ? LOG2_SCALING_LIST_NEUTRAL_VALUE : 0);\par
00749     Intermediate_Int  invQScale             = g_invQuantScales[needsSqrt2ScaleAdjustment?1:0][ qpRem ];\par
00750     Intermediate_Int  add = (shift < 0) ? 0 : ((1 << shift) >> 1);\par
00751     {\cf20 //----- dequant coefficients -----}\par
00752     {\cf19 for}( {\cf18 int} state = 0, scanIdx = lastScanIdx; scanIdx >= 0; scanIdx-- )\par
00753     \{\par
00754       {\cf17 const} {\cf18 unsigned}  rasterPos = scan[scanIdx].idx;\par
00755       {\cf17 const} TCoeff&   level     = qCoeff[ rasterPos ];\par
00756       {\cf19 if}( level )\par
00757       \{\par
00758         {\cf19 if} (enableScalingLists)\par
00759           invQScale = piDequantCoef[rasterPos];{\cf20 //scalingfactor*levelScale}\par
00760         {\cf19 if} (shift < 0 && (enableScalingLists || scanIdx == lastScanIdx))\par
00761         \{\par
00762           invQScale <<= -shift;\par
00763         \}\par
00764         Intermediate_Int  qIdx      = ( level << 1 ) + ( level > 0 ? -(state>>1) : (state>>1) );\par
00765         int64_t  nomTCoeff          = ((int64_t)qIdx * (int64_t)invQScale + add) >> ((shift < 0) ? 0 : shift);\par
00766         tCoeff[rasterPos]           = (TCoeff)Clip3<int64_t>(minTCoeff, maxTCoeff, nomTCoeff);\par
00767       \}\par
00768       state = ( 32040 >> ((state<<2)+((level&1)<<1)) ) & 3;   {\cf20 // the 16-bit value "32040" represent the state transition table}\par
00769     \}\par
00770   \}\par
00771 \par
00772   {\cf17 inline} {\cf18 void} Quantizer::preQuantCoeff({\cf17 const} TCoeff absCoeff, PQData *pqData, TCoeff quanCoeff){\cf17  const}\par
00773 {\cf17   }\{\par
00774     int64_t scaledOrg = int64_t( absCoeff ) * quanCoeff;\par
00775     TCoeff  qIdx      = std::max<TCoeff>( 1, std::min<TCoeff>( m_maxQIdx, TCoeff( ( scaledOrg + m_QAdd ) >> m_QShift ) ) );\par
00776     int64_t scaledAdd = qIdx * m_DistStepAdd - scaledOrg * m_DistOrgFact;\par
00777     PQData& pq_a      = pqData[ qIdx & 3 ];\par
00778     pq_a.deltaDist    = ( scaledAdd * qIdx + m_DistAdd ) >> m_DistShift;\par
00779     pq_a.absLevel     = ( ++qIdx ) >> 1;\par
00780     scaledAdd        += m_DistStepAdd;\par
00781     PQData& pq_b      = pqData[ qIdx & 3 ];\par
00782     pq_b.deltaDist    = ( scaledAdd * qIdx + m_DistAdd ) >> m_DistShift;\par
00783     pq_b.absLevel     = ( ++qIdx ) >> 1;\par
00784     scaledAdd        += m_DistStepAdd;\par
00785     PQData& pq_c      = pqData[ qIdx & 3 ];\par
00786     pq_c.deltaDist    = ( scaledAdd * qIdx + m_DistAdd ) >> m_DistShift;\par
00787     pq_c.absLevel     = ( ++qIdx ) >> 1;\par
00788     scaledAdd        += m_DistStepAdd;\par
00789     PQData& pq_d      = pqData[ qIdx & 3 ];\par
00790     pq_d.deltaDist    = ( scaledAdd * qIdx + m_DistAdd ) >> m_DistShift;\par
00791     pq_d.absLevel     = ( ++qIdx ) >> 1;\par
00792   \}\par
