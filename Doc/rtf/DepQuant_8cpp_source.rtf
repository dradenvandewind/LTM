00853   \};\par
00854 \par
00855   {\cf17 class }State\par
00856   \{\par
00857     {\cf17 friend} {\cf17 class }CommonCtx;\par
00858   {\cf17 public}:\par
00859     State( {\cf17 const} RateEstimator& rateEst, CommonCtx& commonCtx, {\cf17 const} {\cf18 int} stateId );\par
00860 \par
00861     {\cf17 template}<u{\cf18 int}8_t numIPos>\par
00862     {\cf17 inline} {\cf18 void} updateState({\cf17 const} ScanInfo &scanInfo, {\cf17 const} State *prevStates, {\cf17 const} Decision &decision);\par
00863     {\cf17 inline} {\cf18 void} updateStateEOS({\cf17 const} ScanInfo &scanInfo, {\cf17 const} State *prevStates, {\cf17 const} State *skipStates,\par
00864                                {\cf17 const} Decision &decision);\par
00865 \par
00866     {\cf17 inline} {\cf18 void} init()\par
00867     \{\par
00868       m_rdCost        = std::numeric_limits<int64_t>::max()>>1;\par
00869       m_numSigSbb     = 0;\par
00870       m_remRegBins    = 4;  {\cf20 // just large enough for last scan pos}\par
00871       m_refSbbCtxId   = -1;\par
00872       m_sigFracBits   = m_sigFracBitsArray[ 0 ];\par
00873       m_coeffFracBits = m_gtxFracBitsArray[ 0 ];\par
00874       m_goRicePar     = 0;\par
00875       m_goRiceZero    = 0;\par
00876     \}\par
00877     {\cf18 void} checkRdCosts( {\cf17 const} ScanPosType spt, {\cf17 const} PQData& pqDataA, {\cf17 const} PQData& pqDataB, Decision& decisionA, Decision& decisionB ){\cf17  const}\par
00878 {\cf17     }\{\par
00879       {\cf17 const} int32_t*  goRiceTab = g_goRiceBits[m_goRicePar];\par
00880       int64_t         rdCostA   = m_rdCost + pqDataA.deltaDist;\par
00881       int64_t         rdCostB   = m_rdCost + pqDataB.deltaDist;\par
00882       int64_t         rdCostZ   = m_rdCost;\par
00883         {\cf19 if}( m_remRegBins >= 4 )\par
00884         \{\par
00885           {\cf19 if}( pqDataA.absLevel < 4 )\par
00886             rdCostA += m_coeffFracBits.bits[ pqDataA.absLevel ];\par
00887           {\cf19 else}\par
00888           \{\par
00889             {\cf17 const} TCoeff value = ( pqDataA.absLevel - 4 ) >> 1;\par
00890             rdCostA += m_coeffFracBits.bits[ pqDataA.absLevel - ( value << 1 ) ] + goRiceTab[ value < RICEMAX ? value : RICEMAX - 1 ];\par
00891           \}\par
00892           {\cf19 if}( pqDataB.absLevel < 4 )\par
00893             rdCostB += m_coeffFracBits.bits[ pqDataB.absLevel ];\par
00894           {\cf19 else}\par
00895           \{\par
00896             {\cf17 const} TCoeff value = ( pqDataB.absLevel - 4 ) >> 1;\par
00897             rdCostB += m_coeffFracBits.bits[ pqDataB.absLevel - ( value << 1 ) ] + goRiceTab[ value < RICEMAX ? value : RICEMAX - 1 ];\par
00898           \}\par
00899           {\cf19 if}( spt == SCAN_ISCSBB )\par
00900           \{\par
00901             rdCostA += m_sigFracBits.intBits[ 1 ];\par
00902             rdCostB += m_sigFracBits.intBits[ 1 ];\par
00903             rdCostZ += m_sigFracBits.intBits[ 0 ];\par
00904           \}\par
00905           {\cf19 else} {\cf19 if}( spt == SCAN_SOCSBB )\par
00906           \{\par
00907             rdCostA += m_sbbFracBits.intBits[ 1 ] + m_sigFracBits.intBits[ 1 ];\par
00908             rdCostB += m_sbbFracBits.intBits[ 1 ] + m_sigFracBits.intBits[ 1 ];\par
00909             rdCostZ += m_sbbFracBits.intBits[ 1 ] + m_sigFracBits.intBits[ 0 ];\par
00910           \}\par
00911           {\cf19 else} {\cf19 if}( m_numSigSbb )\par
00912           \{\par
00913             rdCostA += m_sigFracBits.intBits[ 1 ];\par
00914             rdCostB += m_sigFracBits.intBits[ 1 ];\par
00915             rdCostZ += m_sigFracBits.intBits[ 0 ];\par
00916           \}\par
00917           {\cf19 else}\par
00918           \{\par
00919             rdCostZ = decisionA.rdCost;\par
00920           \}\par
00921         \}\par
00922         {\cf19 else}\par
00923         \{\par
00924           rdCostA += ( 1 << SCALE_BITS ) + goRiceTab[ pqDataA.absLevel <= m_goRiceZero ? pqDataA.absLevel - 1 : ( pqDataA.absLevel < RICEMAX ? pqDataA.absLevel : RICEMAX - 1 ) ];\par
00925           rdCostB += ( 1 << SCALE_BITS ) + goRiceTab[ pqDataB.absLevel <= m_goRiceZero ? pqDataB.absLevel - 1 : ( pqDataB.absLevel < RICEMAX ? pqDataB.absLevel : RICEMAX - 1 ) ];\par
00926           rdCostZ += goRiceTab[ m_goRiceZero ];\par
00927         \}\par
00928         {\cf19 if}( rdCostA < decisionA.rdCost )\par
00929         \{\par
00930           decisionA.rdCost = rdCostA;\par
00931           decisionA.absLevel = pqDataA.absLevel;\par
00932           decisionA.prevId = m_stateId;\par
00933         \}\par
00934         {\cf19 if}( rdCostZ < decisionA.rdCost )\par
00935         \{\par
00936           decisionA.rdCost = rdCostZ;\par
00937           decisionA.absLevel = 0;\par
00938           decisionA.prevId = m_stateId;\par
00939         \}\par
00940         {\cf19 if}( rdCostB < decisionB.rdCost )\par
00941         \{\par
00942           decisionB.rdCost = rdCostB;\par
00943           decisionB.absLevel = pqDataB.absLevel;\par
00944           decisionB.prevId = m_stateId;\par
00945         \}\par
00946       \}\par
00947 \par
00948     {\cf17 inline} {\cf18 void} checkRdCostStart(int32_t lastOffset, {\cf17 const} PQData &pqData, Decision &decision){\cf17  const}\par
00949 {\cf17     }\{\par
00950       int64_t rdCost = pqData.deltaDist + lastOffset;\par
00951       {\cf19 if} (pqData.absLevel < 4)\par
00952       \{\par
00953         rdCost += m_coeffFracBits.bits[pqData.absLevel];\par
00954       \}\par
00955       {\cf19 else}\par
00956       \{\par
00957         {\cf17 const} TCoeff value = (pqData.absLevel - 4) >> 1;\par
00958         rdCost += m_coeffFracBits.bits[pqData.absLevel - (value << 1)] + g_goRiceBits[m_goRicePar][value < RICEMAX ? value : RICEMAX-1];\par
00959       \}\par
00960       {\cf19 if}( rdCost < decision.rdCost )\par
00961       \{\par
00962         decision.rdCost   = rdCost;\par
00963         decision.absLevel = pqData.absLevel;\par
00964         decision.prevId   = -1;\par
00965       \}\par
00966     \}\par
00967 \par
00968     {\cf17 inline} {\cf18 void} checkRdCostSkipSbb(Decision &decision){\cf17  const}\par
00969 {\cf17     }\{\par
00970       int64_t rdCost = m_rdCost + m_sbbFracBits.intBits[0];\par
00971       {\cf19 if}( rdCost < decision.rdCost )\par
00972       \{\par
00973         decision.rdCost   = rdCost;\par
00974         decision.absLevel = 0;\par
00975         decision.prevId   = 4+m_stateId;\par
00976       \}\par
00977     \}\par
00978 \par
00979     {\cf17 inline} {\cf18 void} checkRdCostSkipSbbZeroOut(Decision &decision){\cf17  const}\par
00980 {\cf17     }\{\par
00981       int64_t rdCost = m_rdCost + m_sbbFracBits.intBits[0];\par
00982       decision.rdCost = rdCost;\par
00983       decision.absLevel = 0;\par
00984       decision.prevId = 4 + m_stateId;\par
00985     \}\par
