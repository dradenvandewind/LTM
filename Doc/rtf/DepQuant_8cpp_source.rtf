01168   {\cf17 inline} {\cf18 void} State::updateStateEOS({\cf17 const} ScanInfo &scanInfo, {\cf17 const} State *prevStates, {\cf17 const} State *skipStates,\par
01169                                     {\cf17 const} Decision &decision)\par
01170   \{\par
01171     m_rdCost = decision.rdCost;\par
01172     {\cf19 if}( decision.prevId > -2 )\par
01173     \{\par
01174       {\cf17 const} State* prvState = 0;\par
01175       {\cf19 if}( decision.prevId  >= 4 )\par
01176       \{\par
01177         CHECK( decision.absLevel != 0, {\cf22 "cannot happen"} );\par
01178         prvState    = skipStates + ( decision.prevId - 4 );\par
01179         m_numSigSbb = 0;\par
01180         ::memset( m_absLevelsAndCtxInit, 0, 16*{\cf17 sizeof}(uint8_t) );\par
01181       \}\par
01182       {\cf19 else} {\cf19 if}( decision.prevId  >= 0 )\par
01183       \{\par
01184         prvState    = prevStates            +   decision.prevId;\par
01185         m_numSigSbb = prvState->m_numSigSbb + !!decision.absLevel;\par
01186         ::memcpy( m_absLevelsAndCtxInit, prvState->m_absLevelsAndCtxInit, 16*{\cf17 sizeof}(uint8_t) );\par
01187       \}\par
01188       {\cf19 else}\par
01189       \{\par
01190         m_numSigSbb = 1;\par
01191         ::memset( m_absLevelsAndCtxInit, 0, 16*{\cf17 sizeof}(uint8_t) );\par
01192       \}\par
01193       {\cf17 reinterpret_cast<}uint8_t*{\cf17 >}(m_absLevelsAndCtxInit)[ scanInfo.insidePos ] = (uint8_t)std::min<TCoeff>( 255, decision.absLevel );\par
01194 \par
01195       m_commonCtx.update( scanInfo, prvState, *{\cf17 this} );\par
01196 \par
01197       TCoeff  tinit   = m_absLevelsAndCtxInit[ 8 + scanInfo.nextInsidePos ];\par
01198       TCoeff  sumNum  =   tinit        & 7;\par
01199       TCoeff  sumAbs1 = ( tinit >> 3 ) & 31;\par
01200       TCoeff  sumGt1  = sumAbs1        - sumNum;\par
01201       m_sigFracBits   = m_sigFracBitsArray[ scanInfo.sigCtxOffsetNext + std::min<TCoeff>( (sumAbs1+1)>>1, 3 ) ];\par
01202       m_coeffFracBits = m_gtxFracBitsArray[ scanInfo.gtxCtxOffsetNext + ( sumGt1  < 4 ? sumGt1  : 4 ) ];\par
01203     \}\par
01204   \}\par
01205 \par
01206   {\cf17 inline} {\cf18 void} CommonCtx::update({\cf17 const} ScanInfo &scanInfo, {\cf17 const} State *prevState, State &currState)\par
01207   \{\par
01208     uint8_t*    sbbFlags  = m_currSbbCtx[ currState.m_stateId ].sbbFlags;\par
01209     uint8_t*    levels    = m_currSbbCtx[ currState.m_stateId ].levels;\par
01210     std::size_t setCpSize = m_nbInfo[ scanInfo.scanIdx - 1 ].maxDist * {\cf17 sizeof}(uint8_t);\par
01211     {\cf19 if}( prevState && prevState->m_refSbbCtxId >= 0 )\par
01212     \{\par
01213       ::memcpy( sbbFlags,                  m_prevSbbCtx[prevState->m_refSbbCtxId].sbbFlags,                  scanInfo.numSbb*{\cf17 sizeof}(uint8_t) );\par
01214       ::memcpy( levels + scanInfo.scanIdx, m_prevSbbCtx[prevState->m_refSbbCtxId].levels + scanInfo.scanIdx, setCpSize );\par
01215     \}\par
01216     {\cf19 else}\par
01217     \{\par
01218       ::memset( sbbFlags,                  0, scanInfo.numSbb*{\cf17 sizeof}(uint8_t) );\par
01219       ::memset( levels + scanInfo.scanIdx, 0, setCpSize );\par
01220     \}\par
01221     sbbFlags[ scanInfo.sbbPos ] = !!currState.m_numSigSbb;\par
01222     ::memcpy( levels + scanInfo.scanIdx, currState.m_absLevelsAndCtxInit, scanInfo.sbbSize*{\cf17 sizeof}(uint8_t) );\par
01223 \par
01224     {\cf17 const} {\cf18 int}       sigNSbb   = ( ( scanInfo.nextSbbRight ? sbbFlags[ scanInfo.nextSbbRight ] : false ) || ( scanInfo.nextSbbBelow ? sbbFlags[ scanInfo.nextSbbBelow ] : false ) ? 1 : 0 );\par
01225     currState.m_numSigSbb     = 0;\par
01226     {\cf19 if} (prevState)\par
01227     \{\par
01228       currState.m_remRegBins = prevState->m_remRegBins;\par
01229     \}\par
01230     {\cf19 else}\par
01231     \{\par
01232       {\cf18 int} ctxBinSampleRatio = (scanInfo.chType == CHANNEL_TYPE_LUMA) ? MAX_TU_LEVEL_CTX_CODED_BIN_CONSTRAINT_LUMA : MAX_TU_LEVEL_CTX_CODED_BIN_CONSTRAINT_CHROMA;\par
01233       currState.m_remRegBins = (currState.effWidth * currState.effHeight *ctxBinSampleRatio) / 16;\par
01234     \}\par
01235     currState.m_goRicePar     = 0;\par
01236     currState.m_refSbbCtxId   = currState.m_stateId;\par
01237     currState.m_sbbFracBits   = m_sbbFlagBits[ sigNSbb ];\par
01238 \par
01239     uint16_t          templateCtxInit[16];\par
01240     {\cf17 const} {\cf18 int}         scanBeg   = scanInfo.scanIdx - scanInfo.sbbSize;\par
01241     {\cf17 const} NbInfoOut*  nbOut     = m_nbInfo + scanBeg;\par
01242     {\cf17 const} uint8_t*    absLevels = levels   + scanBeg;\par
01243     {\cf19 for}( {\cf18 int} {\cf18 id} = 0; {\cf18 id} < scanInfo.sbbSize; {\cf18 id}++, nbOut++ )\par
01244     \{\par
01245       {\cf19 if}( nbOut->num )\par
01246       \{\par
01247         TCoeff sumAbs = 0, sumAbs1 = 0, sumNum = 0;\par
01248 {\cf21 #define UPDATE(k) \{TCoeff t=absLevels[nbOut->outPos[k]]; sumAbs+=t; sumAbs1+=std::min<TCoeff>(4+(t&1),t); sumNum+=!!t; \}}\par
01249         UPDATE(0);\par
01250         {\cf19 if}( nbOut->num > 1 )\par
01251         \{\par
01252           UPDATE(1);\par
01253           {\cf19 if}( nbOut->num > 2 )\par
01254           \{\par
01255             UPDATE(2);\par
01256             {\cf19 if}( nbOut->num > 3 )\par
01257             \{\par
01258               UPDATE(3);\par
01259               {\cf19 if}( nbOut->num > 4 )\par
01260               \{\par
01261                 UPDATE(4);\par
01262               \}\par
01263             \}\par
01264           \}\par
01265         \}\par
01266 {\cf21 #undef UPDATE}\par
01267         templateCtxInit[id] = uint16_t(sumNum) + ( uint16_t(sumAbs1) << 3 ) + ( (uint16_t)std::min<TCoeff>( 127, sumAbs ) << 8 );\par
01268       \}\par
01269       {\cf19 else}\par
01270       \{\par
01271         templateCtxInit[id] = 0;\par
01272       \}\par
01273     \}\par
01274     ::memset( currState.m_absLevelsAndCtxInit,     0,               16*{\cf17 sizeof}(uint8_t) );\par
01275     ::memcpy( currState.m_absLevelsAndCtxInit + 8, templateCtxInit, 16*{\cf17 sizeof}(uint16_t) );\par
01276   \}\par
01277 \par
