01732 {\cf17 inline} int32_t div_for_maxq7(int64_t N, int64_t D)\par
01733 \{\par
01734   int32_t sign, q;\par
01735   sign = 0;\par
01736   {\cf19 if} (N < 0)\par
01737   \{\par
01738     sign = 1;\par
01739     N = -N;\par
01740   \}\par
01741 \par
01742   q = 0;\par
01743   D = (D << 3);\par
01744   {\cf19 if} (N >= D)\par
01745   \{\par
01746     N -= D;\par
01747     q++;\par
01748   \}\par
01749   q = (q << 1);\par
01750 \par
01751   D = (D >> 1);\par
01752   {\cf19 if} (N >= D)\par
01753   \{\par
01754     N -= D;\par
01755     q++;\par
01756   \}\par
01757   q = (q << 1);\par
01758 \par
01759   {\cf19 if} (N >= (D >> 1))\par
01760   \{\par
01761     q++;\par
01762   \}\par
01763   {\cf19 if} (sign)\par
01764   \{\par
01765     {\cf19 return} (-q);\par
01766   \}\par
01767   {\cf19 return}(q);\par
01768 \}\par
01769 \par
01770 {\cf18 void} xSubPelErrorSrfc(uint64_t *sadBuffer, int32_t *deltaMv)\par
01771 \{\par
01772   int64_t numerator, denominator;\par
01773   int32_t mvDeltaSubPel;\par
01774   int32_t mvSubPelLvl = 4;{\cf20 /*1: half pel, 2: Qpel, 3:1/8, 4: 1/16*/}\par
01775                                                         {\cf20 /*horizontal*/}\par
01776   numerator   = (int64_t)((sadBuffer[1] - sadBuffer[3]) << mvSubPelLvl);\par
01777   denominator = (int64_t)((sadBuffer[1] + sadBuffer[3] - (sadBuffer[0] << 1)));\par
01778 \par
01779   {\cf19 if} (0 != denominator)\par
01780   \{\par
01781     {\cf19 if} ((sadBuffer[1] != sadBuffer[0]) && (sadBuffer[3] != sadBuffer[0]))\par
01782     \{\par
01783       mvDeltaSubPel = div_for_maxq7(numerator, denominator);\par
01784       deltaMv[0]    = (mvDeltaSubPel);\par
01785     \}\par
01786     {\cf19 else}\par
01787     \{\par
01788       {\cf19 if} (sadBuffer[1] == sadBuffer[0])\par
01789       \{\par
01790         deltaMv[0] = -8;   {\cf20 // half pel}\par
01791       \}\par
01792       {\cf19 else}\par
01793       \{\par
01794         deltaMv[0] = 8;   {\cf20 // half pel}\par
01795       \}\par
01796     \}\par
01797   \}\par
01798 \par
01799   {\cf20 /*vertical*/}\par
01800   numerator   = (int64_t)((sadBuffer[2] - sadBuffer[4]) << mvSubPelLvl);\par
01801   denominator = (int64_t)((sadBuffer[2] + sadBuffer[4] - (sadBuffer[0] << 1)));\par
01802   {\cf19 if} (0 != denominator)\par
01803   \{\par
01804     {\cf19 if} ((sadBuffer[2] != sadBuffer[0]) && (sadBuffer[4] != sadBuffer[0]))\par
01805     \{\par
01806       mvDeltaSubPel = div_for_maxq7(numerator, denominator);\par
01807       deltaMv[1]    = (mvDeltaSubPel);\par
01808     \}\par
01809     {\cf19 else}\par
01810     \{\par
01811       {\cf19 if} (sadBuffer[2] == sadBuffer[0])\par
01812       \{\par
01813         deltaMv[1] = -8;   {\cf20 // half pel}\par
01814       \}\par
01815       {\cf19 else}\par
01816       \{\par
01817         deltaMv[1] = 8;   {\cf20 // half pel}\par
01818       \}\par
01819     \}\par
01820   \}\par
01821   {\cf19 return};\par
01822 \}\par
