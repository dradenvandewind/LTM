01824 {\cf18 void} InterPrediction::xBIPMVRefine({\cf18 int} bd, Pel *pRefL0, Pel *pRefL1, uint64_t& minCost, int16_t *deltaMV, uint64_t *pSADsArray, {\cf18 int} width, {\cf18 int} height)\par
01825 \{\par
01826   {\cf17 const} int32_t refStrideL0 = m_biLinearBufStride;\par
01827   {\cf17 const} int32_t refStrideL1 = m_biLinearBufStride;\par
01828   Pel *pRefL0Orig = pRefL0;\par
01829   Pel *pRefL1Orig = pRefL1;\par
01830   {\cf19 for} ({\cf18 int} nIdx = 0; (nIdx < 25); ++nIdx)\par
01831   \{\par
01832     int32_t sadOffset = ((m_pSearchOffset[nIdx].getVer() * ((2 * DMVR_NUM_ITERATION) + 1)) + m_pSearchOffset[nIdx].getHor());\par
01833     pRefL0 = pRefL0Orig + m_pSearchOffset[nIdx].hor + (m_pSearchOffset[nIdx].ver * refStrideL0);\par
01834     pRefL1 = pRefL1Orig - m_pSearchOffset[nIdx].hor - (m_pSearchOffset[nIdx].ver * refStrideL1);\par
01835     {\cf19 if} (*(pSADsArray + sadOffset) == MAX_UINT64)\par
01836     \{\par
01837       {\cf17 const} uint64_t cost = xDMVRCost(bd, pRefL0, refStrideL0, pRefL1, refStrideL1, width, height);\par
01838       *(pSADsArray + sadOffset) = cost;\par
01839     \}\par
01840     {\cf19 if} (*(pSADsArray + sadOffset) < minCost)\par
01841     \{\par
01842       minCost = *(pSADsArray + sadOffset);\par
01843       deltaMV[0] = m_pSearchOffset[nIdx].getHor();\par
01844       deltaMV[1] = m_pSearchOffset[nIdx].getVer();\par
01845     \}\par
01846   \}\par
01847 \}\par
