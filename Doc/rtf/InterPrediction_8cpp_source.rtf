01453 {\cf18 void} InterPrediction::motionCompensation( PredictionUnit &pu, PelUnitBuf &predBuf, {\cf17 const} RefPicList &eRefPicList\par
01454   , {\cf17 const} {\cf18 bool} luma, {\cf17 const} {\cf18 bool} chroma\par
01455   , PelUnitBuf* predBufWOBIO {\cf20 /*= NULL*/}\par
01456 )\par
01457 \{\par
01458   {\cf20 // Note: there appears to be an interaction with weighted prediction that}\par
01459   {\cf20 // makes the code follow different paths if chroma is on or off (in the encoder).}\par
01460   {\cf20 // Therefore for 4:0:0, "chroma" is not changed to false.}\par
01461   CHECK(predBufWOBIO && pu.ciipFlag, {\cf22 "the case should not happen!"});\par
01462 \par
01463   {\cf19 if} (!pu.cs->pcv->isEncoder)\par
01464   \{\par
01465     {\cf19 if} (CU::isIBC(*pu.cu))\par
01466     \{\par
01467       CHECK(!luma, {\cf22 "IBC only for Chroma is not allowed."});\par
01468       xIntraBlockCopy(pu, predBuf, COMPONENT_Y);\par
01469       {\cf19 if} (chroma && isChromaEnabled(pu.chromaFormat))\par
01470       \{\par
01471         xIntraBlockCopy(pu, predBuf, COMPONENT_Cb);\par
01472         xIntraBlockCopy(pu, predBuf, COMPONENT_Cr);\par
01473       \}\par
01474       {\cf19 return};\par
01475     \}\par
01476   \}\par
01477   {\cf20 // dual tree handling for IBC as the only ref}\par
01478   {\cf19 if} ((!luma || !chroma) && eRefPicList == REF_PIC_LIST_0)\par
01479   \{\par
01480     xPredInterUni(pu, eRefPicList, predBuf, {\cf17 false}, {\cf17 false}, luma, chroma);\par
01481     {\cf19 return};\par
01482   \}\par
01483   {\cf20 // else, go with regular MC below}\par
01484         CodingStructure &cs = *pu.cs;\par
01485   {\cf17 const} PPS &pps            = *cs.pps;\par
01486   {\cf17 const} SliceType sliceType =  cs.slice->getSliceType();\par
01487 \par
01488   {\cf19 if}( eRefPicList != REF_PIC_LIST_X )\par
01489   \{\par
01490     CHECK(predBufWOBIO != NULL, {\cf22 "the case should not happen!"});\par
01491     {\cf19 if} ((CU::isIBC(*pu.cu) == {\cf17 false}) && ((sliceType == P_SLICE && pps.getUseWP()) || (sliceType == B_SLICE && pps.getWPBiPred())))\par
01492     \{\par
01493       xPredInterUni(pu, eRefPicList, predBuf, {\cf17 true}, {\cf17 false}, luma, chroma);\par
01494       xWeightedPredictionUni(pu, predBuf, eRefPicList, predBuf, -1, m_maxCompIDToPred, (luma && !chroma),\par
01495                              (!luma && chroma));\par
01496     \}\par
01497     {\cf19 else}\par
01498     \{\par
01499       xPredInterUni(pu, eRefPicList, predBuf, {\cf17 false}, {\cf17 false}, luma, chroma);\par
01500     \}\par
01501   \}\par
01502   {\cf19 else}\par
01503   \{\par
01504     CHECK( !pu.cu->affine && pu.refIdx[0] >= 0 && pu.refIdx[1] >= 0 && ( pu.lwidth() + pu.lheight() == 12 ), {\cf22 "invalid 4x8/8x4 bi-predicted blocks"} );\par
01505     {\cf18 int} refIdx0 = pu.refIdx[REF_PIC_LIST_0];\par
01506     {\cf18 int} refIdx1 = pu.refIdx[REF_PIC_LIST_1];\par
01507 \par
01508     {\cf17 const} WPScalingParam *wp0 = pu.cs->slice->getWpScaling(REF_PIC_LIST_0, refIdx0);\par
01509     {\cf17 const} WPScalingParam *wp1 = pu.cs->slice->getWpScaling(REF_PIC_LIST_1, refIdx1);\par
01510 \par
01511     {\cf18 bool} bioApplied = {\cf17 false};\par
01512     {\cf17 const} Slice &slice = *pu.cs->slice;\par
01513     {\cf19 if} (pu.cs->sps->getBDOFEnabledFlag() && (!pu.cs->picHeader->getBdofDisabledFlag()))\par
01514     \{\par
01515       {\cf19 if} (pu.cu->affine || m_subPuMC)\par
01516       \{\par
01517         bioApplied = {\cf17 false};\par
01518       \}\par
01519       {\cf19 else}\par
01520       \{\par
01521         {\cf17 const} {\cf18 bool} biocheck0 =\par
01522           !((WPScalingParam::isWeighted(wp0) || WPScalingParam::isWeighted(wp1)) && slice.getSliceType() == B_SLICE);\par
01523         {\cf17 const} {\cf18 bool} biocheck1 = !(pps.getUseWP() && slice.getSliceType() == P_SLICE);\par
01524         {\cf19 if} (biocheck0\par
01525           && biocheck1\par
01526           && PU::isBiPredFromDifferentDirEqDistPoc(pu)\par
01527           && (pu.Y().height >= 8)\par
01528           && (pu.Y().width >= 8)\par
01529           && ((pu.Y().height * pu.Y().width) >= 128)\par
01530           )\par
01531         \{\par
01532           bioApplied = {\cf17 true};\par
01533         \}\par
01534       \}\par
01535 \par
01536       {\cf19 if} (bioApplied && pu.ciipFlag)\par
01537       \{\par
01538         bioApplied = {\cf17 false};\par
01539       \}\par
01540 \par
01541       {\cf19 if} (bioApplied && pu.cu->smvdMode)\par
01542       \{\par
01543         bioApplied = {\cf17 false};\par
01544       \}\par
01545       {\cf19 if} (pu.cu->cs->sps->getUseBcw() && bioApplied && pu.cu->BcwIdx != BCW_DEFAULT)\par
01546       \{\par
01547         bioApplied = {\cf17 false};\par
01548       \}\par
01549       {\cf19 if} (pu.mmvdEncOptMode == 2 && pu.mmvdMergeFlag)\par
01550       \{\par
01551         bioApplied = {\cf17 false};\par
01552       \}\par
01553     \}\par
01554 \par
01555     {\cf18 bool} refIsScaled = ( refIdx0 < 0 ? false : pu.cu->slice->getRefPic( REF_PIC_LIST_0, refIdx0 )->isRefScaled( pu.cs->pps ) ) ||\par
01556                        ( refIdx1 < 0 ? false : pu.cu->slice->getRefPic( REF_PIC_LIST_1, refIdx1 )->isRefScaled( pu.cs->pps ) );\par
01557     bioApplied = refIsScaled ? false : bioApplied;\par
01558     {\cf18 bool} dmvrApplied = {\cf17 false};\par
01559     dmvrApplied = (pu.mvRefine) && PU::checkDMVRCondition(pu);\par
01560     {\cf19 if} ((pu.lumaSize().width > MAX_BDOF_APPLICATION_REGION || pu.lumaSize().height > MAX_BDOF_APPLICATION_REGION) && pu.mergeType != MRG_TYPE_SUBPU_ATMVP && (bioApplied && !dmvrApplied))\par
01561     \{\par
01562       xSubPuBio(pu, predBuf, eRefPicList, predBufWOBIO);\par
01563     \}\par
01564     {\cf19 else}\par
01565     \{\par
01566       {\cf19 if} (pu.mergeType != MRG_TYPE_DEFAULT_N && pu.mergeType != MRG_TYPE_IBC)\par
01567       \{\par
01568         CHECK(predBufWOBIO != NULL, {\cf22 "the case should not happen!"});\par
01569         xSubPuMC(pu, predBuf, eRefPicList, luma, chroma);\par
01570       \}\par
01571       {\cf19 else} {\cf19 if} (xCheckIdenticalMotion(pu))\par
01572       \{\par
01573         xPredInterUni(pu, REF_PIC_LIST_0, predBuf, {\cf17 false}, {\cf17 false}, luma, chroma);\par
01574         {\cf19 if} (predBufWOBIO)\par
01575           predBufWOBIO->copyFrom(predBuf, (luma && !chroma), (chroma && !luma));\par
01576       \}\par
01577       {\cf19 else}\par
01578       \{\par
01579         xPredInterBi(pu, predBuf, luma, chroma, predBufWOBIO);\par
01580       \}\par
01581     \}\par
01582   \}\par
01583   {\cf19 return};\par
01584 \}\par
