00526   {\cf17 const} Slice &slice = *pu.cs->slice;\par
00527   CHECK( !pu.cu->affine && pu.refIdx[0] >= 0 && pu.refIdx[1] >= 0 && ( pu.lwidth() + pu.lheight() == 12 ), {\cf22 "invalid 4x8/8x4 bi-predicted blocks"} );\par
