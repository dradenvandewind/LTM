01999 {\cf18 void} InterPrediction::xProcessDMVR(PredictionUnit& pu, PelUnitBuf &pcYuvDst, {\cf17 const} ClpRngs &clpRngs, {\cf17 const} {\cf18 bool} bioApplied)\par
02000 \{\par
02001   {\cf18 int} iterationCount = 1;\par
02002   {\cf20 /*Always High Precision*/}\par
02003   {\cf18 int} mvShift = MV_FRACTIONAL_BITS_INTERNAL;\par
02004 \par
02005   {\cf20 /*use merge MV as starting MV*/}\par
02006   Mv mergeMv[] = \{ pu.mv[REF_PIC_LIST_0] , pu.mv[REF_PIC_LIST_1] \};\par
02007 \par
02008   m_biLinearBufStride = (MAX_CU_SIZE + (2 * DMVR_NUM_ITERATION));\par
02009 \par
02010   {\cf18 int} dy = std::min<int>(pu.lumaSize().height, DMVR_SUBCU_HEIGHT);\par
02011   {\cf18 int} dx = std::min<int>(pu.lumaSize().width,  DMVR_SUBCU_WIDTH);\par
02012   Position puPos = pu.lumaPos();\par
02013 \par
02014   {\cf18 int} bd = pu.cs->slice->getClpRngs().comp[COMPONENT_Y].bd;\par
02015 \par
02016   {\cf18 int}            bioEnabledThres = 2 * dy * dx;\par
02017   {\cf18 bool}           bioAppliedType[MAX_NUM_SUBCU_DMVR];\par
02018 \par
02019 {\cf21 #if JVET_J0090_MEMORY_BANDWITH_MEASURE}\par
02020   JVET_J0090_SET_CACHE_ENABLE({\cf17 true});\par
02021   {\cf19 for} ({\cf18 int} k = 0; k < NUM_REF_PIC_LIST_01; k++)\par
02022   \{\par
02023     RefPicList refId = (RefPicList)k;\par
02024     {\cf17 const} Picture* refPic = pu.cu->slice->getRefPic(refId, pu.refIdx[refId]);\par
02025     {\cf19 for} ({\cf18 int} compID = 0; compID < MAX_NUM_COMPONENT; compID++)\par
02026     \{\par
02027       Mv cMv = pu.mv[refId];\par
02028       {\cf18 int} mvshiftTemp = mvShift + getComponentScaleX((ComponentID)compID, pu.chromaFormat);\par
02029       {\cf18 int} filtersize = (compID == (COMPONENT_Y)) ? NTAPS_LUMA : NTAPS_CHROMA;\par
02030       cMv += Mv(-(((filtersize >> 1) - 1) << mvshiftTemp), -(((filtersize >> 1) - 1) << mvshiftTemp));\par
02031       {\cf18 bool} wrapRef = {\cf17 false};\par
02032       {\cf19 if} ( pu.cs->pps->getWrapAroundEnabledFlag() )\par
02033       \{\par
02034         wrapRef = wrapClipMv(cMv, pu.blocks[0].pos(), pu.blocks[0].size(), pu.cs->sps, pu.cs->pps);\par
02035       \}\par
02036       {\cf19 else}\par
02037       \{\par
02038         clipMv(cMv, pu.lumaPos(), pu.lumaSize(), *pu.cs->sps, *pu.cs->pps);\par
02039       \}\par
02040 \par
02041       {\cf18 int} width = pcYuvDst.bufs[compID].width + (filtersize - 1);\par
02042       {\cf18 int} height = pcYuvDst.bufs[compID].height + (filtersize - 1);\par
02043 \par
02044       CPelBuf refBuf;\par
02045       Position recOffset = pu.blocks[compID].pos().offset(cMv.getHor() >> mvshiftTemp, cMv.getVer() >> mvshiftTemp);\par
02046       refBuf = refPic->getRecoBuf(CompArea((ComponentID)compID, pu.chromaFormat, recOffset, pu.blocks[compID].size()), wrapRef);\par
02047 \par
02048       JVET_J0090_SET_REF_PICTURE(refPic, (ComponentID)compID);\par
02049       {\cf19 for} ({\cf18 int} row = 0; row < height; row++)\par
02050       \{\par
02051         {\cf19 for} ({\cf18 int} col = 0; col < width; col++)\par
02052         \{\par
02053           JVET_J0090_CACHE_ACCESS(((Pel *)refBuf.buf) + row * refBuf.stride + col, __FILE__, __LINE__);\par
