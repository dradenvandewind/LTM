00834 {\cf18 bool} InterPrediction::isSubblockVectorSpreadOverLimit( {\cf18 int} a, {\cf18 int} b, {\cf18 int} c, {\cf18 int} d, {\cf18 int} predType )\par
00835 \{\par
00836   {\cf18 int} s4 = ( 4 << 11 );\par
00837   {\cf18 int} filterTap = 6;\par
00838 \par
00839   {\cf19 if} ( predType == 3 )\par
00840   \{\par
00841     {\cf18 int} refBlkWidth  = std::max( std::max( 0, 4 * a + s4 ), std::max( 4 * c, 4 * a + 4 * c + s4 ) ) - std::min( std::min( 0, 4 * a + s4 ), std::min( 4 * c, 4 * a + 4 * c + s4 ) );\par
00842     {\cf18 int} refBlkHeight = std::max( std::max( 0, 4 * b ), std::max( 4 * d + s4, 4 * b + 4 * d + s4 ) ) - std::min( std::min( 0, 4 * b ), std::min( 4 * d + s4, 4 * b + 4 * d + s4 ) );\par
00843     refBlkWidth  = ( refBlkWidth >> 11 ) + filterTap + 3;\par
00844     refBlkHeight = ( refBlkHeight >> 11 ) + filterTap + 3;\par
00845 \par
00846     {\cf19 if} ( refBlkWidth * refBlkHeight > ( filterTap + 9 ) * ( filterTap + 9 ) )\par
00847     \{\par
00848       {\cf19 return} {\cf17 true};\par
00849     \}\par
00850   \}\par
00851   {\cf19 else}\par
00852   \{\par
00853     {\cf18 int} refBlkWidth  = std::max( 0, 4 * a + s4 ) - std::min( 0, 4 * a + s4 );\par
00854     {\cf18 int} refBlkHeight = std::max( 0, 4 * b ) - std::min( 0, 4 * b );\par
00855     refBlkWidth  = ( refBlkWidth >> 11 ) + filterTap + 3;\par
00856     refBlkHeight = ( refBlkHeight >> 11 ) + filterTap + 3;\par
00857     {\cf19 if} ( refBlkWidth * refBlkHeight > ( filterTap + 9 ) * ( filterTap + 5 ) )\par
00858     \{\par
00859       {\cf19 return} {\cf17 true};\par
00860     \}\par
00861 \par
00862     refBlkWidth  = std::max( 0, 4 * c ) - std::min( 0, 4 * c );\par
00863     refBlkHeight = std::max( 0, 4 * d + s4 ) - std::min( 0, 4 * d + s4 );\par
00864     refBlkWidth  = ( refBlkWidth >> 11 ) + filterTap + 3;\par
00865     refBlkHeight = ( refBlkHeight >> 11 ) + filterTap + 3;\par
00866     {\cf19 if} ( refBlkWidth * refBlkHeight > ( filterTap + 5 ) * ( filterTap + 9 ) )\par
00867     \{\par
00868       {\cf19 return} {\cf17 true};\par
00869     \}\par
00870   \}\par
00871   {\cf19 return} {\cf17 false};\par
00872 \}\par
