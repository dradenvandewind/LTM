02223       {\cf17 const} {\cf18 int} ctuSizeLog2Ver = floorLog2(lcuWidth) - shiftSampleVer;\par
02224       {\cf17 const} {\cf18 int} pux = area.x & ((m_IBCBufferWidth >> shiftSampleHor) - 1);\par
02225       {\cf17 const} {\cf18 int} puy = area.y & (( 1 << ctuSizeLog2Ver ) - 1);\par
02226       {\cf17 const} CompArea dstArea = CompArea(area.compID, cu.chromaFormat, Position(pux, puy), Size(area.width, area.height));\par
