01358 {\cf18 void} InterPrediction::xWeightedAverage({\cf17 const} PredictionUnit& pu, {\cf17 const} CPelUnitBuf& pcYuvSrc0, {\cf17 const} CPelUnitBuf& pcYuvSrc1, PelUnitBuf& pcYuvDst, {\cf17 const} BitDepths& clipBitDepths, {\cf17 const} ClpRngs& clpRngs, {\cf17 const} {\cf18 bool}& bioApplied, {\cf18 bool} lumaOnly, {\cf18 bool} chromaOnly, PelUnitBuf* yuvDstTmp {\cf20 /*= NULL*/})\par
01359 \{\par
01360   CHECK( (chromaOnly && lumaOnly), {\cf22 "should not happen"} );\par
01361 \par
01362   {\cf17 const} {\cf18 int} iRefIdx0 = pu.refIdx[0];\par
01363   {\cf17 const} {\cf18 int} iRefIdx1 = pu.refIdx[1];\par
01364 \par
01365   {\cf19 if}( iRefIdx0 >= 0 && iRefIdx1 >= 0 )\par
01366   \{\par
01367     {\cf19 if}( pu.cu->BcwIdx != BCW_DEFAULT && (yuvDstTmp || !pu.ciipFlag) )\par
01368     \{\par
01369       CHECK(bioApplied, {\cf22 "Bcw is disallowed with BIO"});\par
01370       pcYuvDst.addWeightedAvg(pcYuvSrc0, pcYuvSrc1, clpRngs, pu.cu->BcwIdx, chromaOnly, lumaOnly);\par
01371       {\cf19 if} (yuvDstTmp)\par
01372         yuvDstTmp->addAvg(pcYuvSrc0, pcYuvSrc1, clpRngs, chromaOnly, lumaOnly);\par
01373       {\cf19 return};\par
01374     \}\par
01375     {\cf19 if} (bioApplied)\par
01376     \{\par
01377       {\cf17 const} {\cf18 int}  src0Stride = pu.lwidth() + 2 * BIO_EXTEND_SIZE + 2;\par
01378       {\cf17 const} {\cf18 int}  src1Stride = pu.lwidth() + 2 * BIO_EXTEND_SIZE + 2;\par
01379       {\cf17 const} Pel* pSrcY0 = m_filteredBlockTmp[2][COMPONENT_Y] + 2 * src0Stride + 2;\par
01380       {\cf17 const} Pel* pSrcY1 = m_filteredBlockTmp[3][COMPONENT_Y] + 2 * src1Stride + 2;\par
01381 \par
01382       {\cf18 bool} bioEnabled = {\cf17 true};\par
01383       {\cf19 if} (bioEnabled)\par
01384       \{\par
01385         applyBiOptFlow(pu, pcYuvSrc0, pcYuvSrc1, iRefIdx0, iRefIdx1, pcYuvDst, clipBitDepths);\par
01386         {\cf19 if} (yuvDstTmp)\par
01387           yuvDstTmp->bufs[0].addAvg(CPelBuf(pSrcY0, src0Stride, pu.lumaSize()), CPelBuf(pSrcY1, src1Stride, pu.lumaSize()), clpRngs.comp[0]);\par
01388       \}\par
01389       {\cf19 else}\par
01390       \{\par
01391         pcYuvDst.bufs[0].addAvg(CPelBuf(pSrcY0, src0Stride, pu.lumaSize()), CPelBuf(pSrcY1, src1Stride, pu.lumaSize()), clpRngs.comp[0]);\par
01392         {\cf19 if} (yuvDstTmp)\par
01393           yuvDstTmp->bufs[0].copyFrom(pcYuvDst.bufs[0]);\par
01394       \}\par
01395     \}\par
01396     {\cf19 if} (!bioApplied && (lumaOnly || chromaOnly))\par
01397     \{\par
01398       pcYuvDst.addAvg(pcYuvSrc0, pcYuvSrc1, clpRngs, chromaOnly, lumaOnly);\par
01399     \}\par
01400     {\cf19 else}\par
01401     \{\par
01402       pcYuvDst.addAvg(pcYuvSrc0, pcYuvSrc1, clpRngs, bioApplied);\par
01403     \}\par
01404     {\cf19 if} (yuvDstTmp)\par
01405     \{\par
01406       {\cf19 if} (bioApplied)\par
01407       \{\par
01408         {\cf19 if} (isChromaEnabled(yuvDstTmp->chromaFormat))\par
01409         \{\par
01410           yuvDstTmp->bufs[1].copyFrom(pcYuvDst.bufs[1]);\par
01411           yuvDstTmp->bufs[2].copyFrom(pcYuvDst.bufs[2]);\par
01412         \}\par
01413       \}\par
01414       {\cf19 else}\par
01415       \{\par
01416         yuvDstTmp->copyFrom(pcYuvDst, lumaOnly, chromaOnly);\par
01417       \}\par
01418     \}\par
01419   \}\par
01420   {\cf19 else} {\cf19 if}( iRefIdx0 >= 0 && iRefIdx1 < 0 )\par
01421   \{\par
01422     {\cf19 if}( pu.cu->geoFlag )\par
01423     \{\par
01424       pcYuvDst.copyFrom( pcYuvSrc0 );\par
01425     \}\par
01426     {\cf19 else}\par
01427     \{\par
01428       pcYuvDst.copyClip( pcYuvSrc0, clpRngs, lumaOnly, chromaOnly );\par
01429     \}\par
01430     {\cf19 if} (yuvDstTmp)\par
01431     \{\par
01432       yuvDstTmp->copyFrom( pcYuvDst, lumaOnly, chromaOnly );\par
01433     \}\par
01434   \}\par
01435   {\cf19 else} {\cf19 if}( iRefIdx0 < 0 && iRefIdx1 >= 0 )\par
01436   \{\par
01437     {\cf19 if}( pu.cu->geoFlag )\par
01438     \{\par
01439       pcYuvDst.copyFrom( pcYuvSrc1 );\par
01440     \}\par
01441     {\cf19 else}\par
01442     \{\par
01443       pcYuvDst.copyClip( pcYuvSrc1, clpRngs, lumaOnly, chromaOnly );\par
01444     \}\par
01445     {\cf19 if} (yuvDstTmp)\par
01446     \{\par
01447       yuvDstTmp->copyFrom(pcYuvDst, lumaOnly, chromaOnly);\par
01448     \}\par
01449   \}\par
01450 \}\par
