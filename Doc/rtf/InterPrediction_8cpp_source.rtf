01849 {\cf18 void} InterPrediction::xFinalPaddedMCForDMVR(PredictionUnit &pu, PelUnitBuf &pcYuvSrc0, PelUnitBuf &pcYuvSrc1,\par
01850                                             PelUnitBuf &pcPad0, PelUnitBuf &pcPad1, {\cf17 const} {\cf18 bool} bioApplied,\par
01851                                             {\cf17 const} Mv mergeMV[NUM_REF_PIC_LIST_01], {\cf18 bool} blockMoved)\par
01852 \{\par
01853   {\cf18 int} offset, deltaIntMvX, deltaIntMvY;\par
01854 \par
01855   PelUnitBuf pcYUVTemp = pcYuvSrc0;\par
01856   PelUnitBuf pcPadTemp = pcPad0;\par
01857   {\cf20 /*always high precision MVs are used*/}\par
01858   {\cf18 int} mvShift = MV_FRACTIONAL_BITS_INTERNAL;\par
01859 \par
01860   {\cf19 for} ({\cf18 int} k = 0; k < NUM_REF_PIC_LIST_01; k++)\par
01861   \{\par
01862     RefPicList refId = (RefPicList)k;\par
01863     Mv cMv = pu.mv[refId];\par
01864     m_iRefListIdx = refId;\par
01865     {\cf17 const} Picture* refPic = pu.cu->slice->getRefPic( refId, pu.refIdx[refId] )->unscaledPic;\par
01866     Mv cMvClipped = cMv;\par
01867     {\cf19 if}( !pu.cs->pps->getWrapAroundEnabledFlag() )\par
01868     \{\par
01869       clipMv( cMvClipped, pu.lumaPos(), pu.lumaSize(), *pu.cs->sps, *pu.cs->pps );\par
01870     \}\par
01871 \par
01872     Mv startMv = mergeMV[refId];\par
01873 \par
01874     {\cf19 if}( g_mctsDecCheckEnabled && !MCTSHelper::checkMvForMCTSConstraint( pu, startMv, MV_PRECISION_INTERNAL ) )\par
01875     \{\par
01876       {\cf17 const} Area& tileArea = pu.cs->picture->mctsInfo.getTileArea();\par
01877       printf( {\cf22 "Attempt an access over tile boundary at block %d,%d %d,%d with MV %d,%d (in Tile TL: %d,%d BR: %d,%d)\\n"},\par
01878         pu.lx(), pu.ly(), pu.lwidth(), pu.lheight(), startMv.getHor(), startMv.getVer(), tileArea.topLeft().x, tileArea.topLeft().y, tileArea.bottomRight().x, tileArea.bottomRight().y );\par
01879       THROW( {\cf22 "MCTS constraint failed!"} );\par
01880     \}\par
01881     {\cf19 for} ({\cf18 int} compID = 0; compID < getNumberValidComponents(pu.chromaFormat); compID++)\par
01882     \{\par
01883       Pel *srcBufPelPtr = NULL;\par
01884       {\cf18 int} pcPadstride = 0;\par
01885       {\cf19 if} (blockMoved || (compID == 0))\par
01886       \{\par
01887         pcPadstride = pcPadTemp.bufs[compID].stride;\par
01888         {\cf18 int} mvshiftTempHor = mvShift + getComponentScaleX((ComponentID)compID, pu.chromaFormat);\par
01889         {\cf18 int} mvshiftTempVer = mvShift + getComponentScaleY((ComponentID)compID, pu.chromaFormat);\par
01890         {\cf18 int} leftPixelExtra;\par
01891         {\cf19 if} (compID == COMPONENT_Y)\par
01892         \{\par
01893           leftPixelExtra = (NTAPS_LUMA >> 1) - 1;\par
01894         \}\par
01895         {\cf19 else}\par
01896         \{\par
01897           leftPixelExtra = (NTAPS_CHROMA >> 1) - 1;\par
01898         \}\par
01899         PelBuf &srcBuf = pcPadTemp.bufs[compID];\par
01900         deltaIntMvX    = (cMv.getHor() >> mvshiftTempHor) - (startMv.getHor() >> mvshiftTempHor);\par
01901         deltaIntMvY    = (cMv.getVer() >> mvshiftTempVer) - (startMv.getVer() >> mvshiftTempVer);\par
01902 \par
01903         CHECK((abs(deltaIntMvX) > DMVR_NUM_ITERATION) || (abs(deltaIntMvY) > DMVR_NUM_ITERATION), {\cf22 "not expected DMVR movement"});\par
01904 \par
01905         offset = (DMVR_NUM_ITERATION + leftPixelExtra) * (pcPadTemp.bufs[compID].stride + 1);\par
01906         offset += (deltaIntMvY)* pcPadTemp.bufs[compID].stride;\par
01907         offset += (deltaIntMvX);\par
01908         srcBufPelPtr = (srcBuf.buf + offset);\par
01909       \}\par
01910       JVET_J0090_SET_CACHE_ENABLE({\cf17 false});\par
01911       xPredInterBlk((ComponentID) compID, pu, refPic, cMvClipped, pcYUVTemp, {\cf17 true},\par
01912                     pu.cs->slice->getClpRngs().comp[compID], bioApplied, {\cf17 false},\par
01913                     pu.cu->slice->getScalingRatio(refId, pu.refIdx[refId]), 0, 0, 0, srcBufPelPtr, pcPadstride);\par
01914       JVET_J0090_SET_CACHE_ENABLE({\cf17 false});\par
01915     \}\par
01916     pcYUVTemp = pcYuvSrc1;\par
01917     pcPadTemp = pcPad1;\par
01918   \}\par
01919 \}\par
