01667 {\cf18 void} InterPrediction::xPrefetch(PredictionUnit& pu, PelUnitBuf &pcPad, RefPicList refId, {\cf18 bool} forLuma)\par
01668 \{\par
01669   {\cf18 int} offset, width, height;\par
01670   Mv cMv;\par
01671   {\cf17 const} Picture* refPic = pu.cu->slice->getRefPic( refId, pu.refIdx[refId] )->unscaledPic;\par
01672   {\cf18 int} mvShift = (MV_FRACTIONAL_BITS_INTERNAL);\par
01673 \par
01674   {\cf18 int} start = 0;\par
01675   {\cf18 int} end = MAX_NUM_COMPONENT;\par
01676 \par
01677   start = forLuma ? 0 : 1;\par
01678   end = forLuma ? 1 : MAX_NUM_COMPONENT;\par
01679 \par
01680   {\cf19 for} ({\cf18 int} compID = start; compID < end; compID++)\par
01681   \{\par
01682     cMv = Mv(pu.mv[refId].getHor(), pu.mv[refId].getVer());\par
01683     pcPad.bufs[compID].stride = (pcPad.bufs[compID].width + (2 * DMVR_NUM_ITERATION) + NTAPS_LUMA);\par
01684     {\cf18 int} filtersize = (compID == (COMPONENT_Y)) ? NTAPS_LUMA : NTAPS_CHROMA;\par
01685     width = pcPad.bufs[compID].width;\par
01686     height = pcPad.bufs[compID].height;\par
01687     offset = (DMVR_NUM_ITERATION) * (pcPad.bufs[compID].stride + 1);\par
01688     {\cf18 int} mvshiftTempHor = mvShift + getComponentScaleX((ComponentID)compID, pu.chromaFormat);\par
01689     {\cf18 int} mvshiftTempVer = mvShift + getComponentScaleY((ComponentID)compID, pu.chromaFormat);\par
01690     width += (filtersize - 1);\par
01691     height += (filtersize - 1);\par
01692     cMv += Mv(-(((filtersize >> 1) - 1) << mvshiftTempHor),\par
01693       -(((filtersize >> 1) - 1) << mvshiftTempVer));\par
01694     {\cf18 bool} wrapRef = {\cf17 false};\par
01695     {\cf19 if}( refPic->isWrapAroundEnabled( pu.cs->pps ) )\par
01696     \{\par
01697       wrapRef = wrapClipMv( cMv, pu.blocks[0].pos(), pu.blocks[0].size(), pu.cs->sps, pu.cs->pps );\par
01698     \}\par
01699     {\cf19 else}\par
01700     \{\par
01701       clipMv( cMv, pu.lumaPos(), pu.lumaSize(), *pu.cs->sps, *pu.cs->pps );\par
01702     \}\par
01703     {\cf20 /* Pre-fetch similar to HEVC*/}\par
01704     \{\par
01705       CPelBuf refBuf;\par
01706       Position Rec_offset = pu.blocks[compID].pos().offset(cMv.getHor() >> mvshiftTempHor, cMv.getVer() >> mvshiftTempVer);\par
01707       refBuf = refPic->getRecoBuf(CompArea((ComponentID)compID, pu.chromaFormat, Rec_offset, pu.blocks[compID].size()), wrapRef);\par
01708       PelBuf &dstBuf = pcPad.bufs[compID];\par
01709       g_pelBufOP.copyBuffer((Pel *)refBuf.buf, refBuf.stride, ((Pel *)dstBuf.buf) + offset, dstBuf.stride, width, height);\par
01710     \}\par
01711   \}\par
01712 \}\par
01713 {\cf18 void} InterPrediction::xPad(PredictionUnit& pu, PelUnitBuf &pcPad, RefPicList refId)\par
01714 \{\par
01715   {\cf18 int} offset = 0, width, height;\par
01716   {\cf18 int} padsize;\par
01717   Mv cMv;\par
01718   {\cf19 for} ({\cf18 int} compID = 0; compID < getNumberValidComponents(pu.chromaFormat); compID++)\par
01719   \{\par
01720     {\cf18 int} filtersize = (compID == (COMPONENT_Y)) ? NTAPS_LUMA : NTAPS_CHROMA;\par
01721     width = pcPad.bufs[compID].width;\par
01722     height = pcPad.bufs[compID].height;\par
01723     offset = (DMVR_NUM_ITERATION) * (pcPad.bufs[compID].stride + 1);\par
01724     {\cf20 /*using the larger padsize for 422*/}\par
01725     padsize = (DMVR_NUM_ITERATION) >> getComponentScaleY((ComponentID)compID, pu.chromaFormat);\par
01726     width += (filtersize - 1);\par
01727     height += (filtersize - 1);\par
01728     {\cf20 /*padding on all side of size DMVR_PAD_LENGTH*/}\par
01729     g_pelBufOP.padding(pcPad.bufs[compID].buf + offset, pcPad.bufs[compID].stride, width, height, padsize);\par
01730   \}\par
