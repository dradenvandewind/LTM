00423   {\cf18 int}  secEnd = puPos.x + puSize.width;\par
00424   {\cf18 int}  fstStep = std::min(({\cf18 int})MAX_BDOF_APPLICATION_REGION, ({\cf18 int})puSize.height);\par
00425   {\cf18 int}  secStep = std::min(({\cf18 int})MAX_BDOF_APPLICATION_REGION, ({\cf18 int})puSize.width);\par
00426   {\cf19 for} ({\cf18 int} fstDim = fstStart; fstDim < fstEnd; fstDim += fstStep)\par
