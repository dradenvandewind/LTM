00523 {\cf18 void} InterPrediction::xPredInterBi(PredictionUnit &pu, PelUnitBuf &pcYuvPred, {\cf17 const} {\cf18 bool} luma, {\cf17 const} {\cf18 bool} chroma, PelUnitBuf *yuvPredTmp {\cf20 /*= NULL*/})\par
00524 \{\par
