00669 {\cf18 void} InterPrediction::xPredInterBlk ( {\cf17 const} ComponentID& compID, {\cf17 const} PredictionUnit& pu, {\cf17 const} Picture* refPic, {\cf17 const} Mv& _mv, PelUnitBuf& dstPic, {\cf17 const} {\cf18 bool}& bi, {\cf17 const} ClpRng& clpRng\par
00670                                      , {\cf17 const} {\cf18 bool}& bioApplied\par
00671                                      , {\cf18 bool} isIBC\par
00672                                      , {\cf17 const} std::pair<int, int> scalingRatio\par
00673                                      , SizeType dmvrWidth\par
00674                                      , SizeType dmvrHeight\par
00675                                      , {\cf18 bool} bilinearMC\par
00676                                      , Pel *srcPadBuf\par
00677                                      , int32_t srcPadStride\par
00678                                     )\par
00679 \{\par
00680   JVET_J0090_SET_REF_PICTURE( refPic, compID );\par
00681   {\cf17 const} ChromaFormat  chFmt = pu.chromaFormat;\par
00682   {\cf17 const} {\cf18 bool}          rndRes = !bi;\par
00683 \par
00684   {\cf18 int} shiftHor = MV_FRACTIONAL_BITS_INTERNAL + vtm::getComponentScaleX(compID, chFmt);\par
00685   {\cf18 int} shiftVer = MV_FRACTIONAL_BITS_INTERNAL + vtm::getComponentScaleY(compID, chFmt);\par
00686 \par
00687   {\cf18 bool}  wrapRef = {\cf17 false};\par
00688   Mv    mv(_mv);\par
00689   {\cf19 if}( !isIBC && refPic->isWrapAroundEnabled( pu.cs->pps ) )\par
00690   \{\par
00691     wrapRef = wrapClipMv( mv, pu.blocks[0].pos(), pu.blocks[0].size(), pu.cs->sps, pu.cs->pps );\par
00692   \}\par
00693 \par
00694   {\cf18 bool} useAltHpelIf = pu.cu->imv == IMV_HPEL;\par
00695 \par
00696   {\cf19 if}( !isIBC && xPredInterBlkRPR( scalingRatio, *pu.cs->pps, CompArea( compID, chFmt, pu.blocks[compID], Size( dstPic.bufs[compID].width, dstPic.bufs[compID].height ) ), refPic, mv, dstPic.bufs[compID].buf, dstPic.bufs[compID].stride, bi, wrapRef, clpRng, 0, useAltHpelIf ) )\par
00697   \{\par
00698     CHECK( bilinearMC, {\cf22 "DMVR should be disabled with RPR"} );\par
00699     CHECK( bioApplied, {\cf22 "BDOF should be disabled with RPR"} );\par
00700   \}\par
00701   {\cf19 else}\par
00702   \{\par
00703     {\cf18 int} xFrac = mv.hor & ((1 << shiftHor) - 1);\par
00704     {\cf18 int} yFrac = mv.ver & ((1 << shiftVer) - 1);\par
00705     {\cf19 if} (isIBC)\par
00706     \{\par
00707       xFrac = yFrac = 0;\par
00708       JVET_J0090_SET_CACHE_ENABLE({\cf17 false});\par
00709     \}\par
00710 \par
00711     PelBuf & dstBuf = dstPic.bufs[compID];\par
00712     {\cf18 unsigned} width  = dstBuf.width;\par
00713     {\cf18 unsigned} height = dstBuf.height;\par
00714 \par
00715     CPelBuf refBuf;\par
00716     \{\par
00717       Position offset = pu.blocks[compID].pos().offset(mv.getHor() >> shiftHor, mv.getVer() >> shiftVer);\par
00718       {\cf19 if} (dmvrWidth)\par
00719       \{\par
00720         refBuf = refPic->getRecoBuf(CompArea(compID, chFmt, offset, Size(dmvrWidth, dmvrHeight)), wrapRef);\par
00721       \}\par
00722       {\cf19 else}\par
00723       \{\par
00724         refBuf = refPic->getRecoBuf(CompArea(compID, chFmt, offset, pu.blocks[compID].size()), wrapRef);\par
00725       \}\par
00726     \}\par
00727 \par
00728     {\cf19 if} (NULL != srcPadBuf)\par
00729     \{\par
00730       refBuf.buf    = srcPadBuf;\par
00731       refBuf.stride = srcPadStride;\par
00732     \}\par
00733     {\cf19 if} (dmvrWidth)\par
00734     \{\par
00735       width  = dmvrWidth;\par
00736       height = dmvrHeight;\par
00737     \}\par
00738     {\cf20 // backup data}\par
00739     {\cf18 int}  backupWidth        = width;\par
00740     {\cf18 int}  backupHeight       = height;\par
00741     Pel *backupDstBufPtr    = dstBuf.buf;\par
00742     {\cf18 int}  backupDstBufStride = dstBuf.stride;\par
00743 \par
00744     {\cf19 if} (bioApplied && compID == COMPONENT_Y)\par
00745     \{\par
00746       width  = width + 2 * BIO_EXTEND_SIZE + 2;\par
00747       height = height + 2 * BIO_EXTEND_SIZE + 2;\par
00748 \par
00749       {\cf20 // change MC output}\par
00750       dstBuf.stride = width;\par
00751       dstBuf.buf    = m_filteredBlockTmp[2 + m_iRefListIdx][compID] + 2 * dstBuf.stride + 2;\par
00752     \}\par
00753 \par
00754     {\cf19 if} (yFrac == 0)\par
00755     \{\par
00756       m_if.filterHor(compID, (Pel *) refBuf.buf, refBuf.stride, dstBuf.buf, dstBuf.stride, backupWidth, backupHeight,\par
00757                      xFrac, rndRes, chFmt, clpRng, bilinearMC, bilinearMC, useAltHpelIf);\par
00758     \}\par
00759     {\cf19 else} {\cf19 if} (xFrac == 0)\par
00760     \{\par
00761       m_if.filterVer(compID, (Pel *) refBuf.buf, refBuf.stride, dstBuf.buf, dstBuf.stride, backupWidth, backupHeight,\par
00762                      yFrac, {\cf17 true}, rndRes, chFmt, clpRng, bilinearMC, bilinearMC, useAltHpelIf);\par
00763     \}\par
00764     {\cf19 else}\par
00765     \{\par
00766       PelBuf tmpBuf = dmvrWidth ? PelBuf(m_filteredBlockTmp[0][compID], Size(dmvrWidth, dmvrHeight))\par
00767                                 : PelBuf(m_filteredBlockTmp[0][compID], pu.blocks[compID]);\par
00768       {\cf19 if} (dmvrWidth == 0)\par
00769       \{\par
00770         tmpBuf.stride = dstBuf.stride;\par
00771       \}\par
00772 \par
00773       {\cf18 int} vFilterSize = isLuma(compID) ? NTAPS_LUMA : NTAPS_CHROMA;\par
00774       {\cf19 if} (bilinearMC)\par
00775       \{\par
00776         vFilterSize = NTAPS_BILINEAR;\par
00777       \}\par
00778       m_if.filterHor(compID, (Pel *) refBuf.buf - ((vFilterSize >> 1) - 1) * refBuf.stride, refBuf.stride, tmpBuf.buf,\par
00779                      tmpBuf.stride, backupWidth, backupHeight + vFilterSize - 1, xFrac, {\cf17 false}, chFmt, clpRng,\par
00780                      bilinearMC, bilinearMC, useAltHpelIf);\par
00781       JVET_J0090_SET_CACHE_ENABLE({\cf17 false});\par
00782       m_if.filterVer(compID, (Pel *) tmpBuf.buf + ((vFilterSize >> 1) - 1) * tmpBuf.stride, tmpBuf.stride, dstBuf.buf,\par
00783                      dstBuf.stride, backupWidth, backupHeight, yFrac, {\cf17 false}, rndRes, chFmt, clpRng, bilinearMC,\par
00784                      bilinearMC, useAltHpelIf);\par
00785     \}\par
00786     JVET_J0090_SET_CACHE_ENABLE(\par
00787       (srcPadStride == 0)\par
00788       && (bioApplied\par
00789           == {\cf17 false}));   {\cf20 // Enabled only in non-DMVR-non-BDOF process, In DMVR process, srcPadStride is always non-zero}\par
00790     {\cf19 if} (bioApplied && compID == COMPONENT_Y)\par
00791     \{\par
00792       {\cf17 const} {\cf18 int} shift = IF_INTERNAL_FRAC_BITS(clpRng.bd);\par
00793       {\cf18 int}        xOffset = (xFrac < 8) ? 1 : 0;\par
00794       {\cf18 int}        yOffset = (yFrac < 8) ? 1 : 0;\par
00795       {\cf17 const} Pel *refPel  = refBuf.buf - yOffset * refBuf.stride - xOffset;\par
00796       Pel *      dstPel  = m_filteredBlockTmp[2 + m_iRefListIdx][compID] + dstBuf.stride + 1;\par
00797       {\cf19 for} ({\cf18 int} w = 0; w < (width - 2 * BIO_EXTEND_SIZE); w++)\par
00798       \{\par
00799         Pel val   = leftShift_round(refPel[w], shift);\par
00800         dstPel[w] = val - (Pel) IF_INTERNAL_OFFS;\par
00801       \}\par
00802 \par
00803       refPel = refBuf.buf + (1 - yOffset) * refBuf.stride - xOffset;\par
00804       dstPel = m_filteredBlockTmp[2 + m_iRefListIdx][compID] + 2 * dstBuf.stride + 1;\par
00805       {\cf19 for} ({\cf18 int} h = 0; h < (height - 2 * BIO_EXTEND_SIZE - 2); h++)\par
00806       \{\par
00807         Pel val   = leftShift_round(refPel[0], shift);\par
00808         dstPel[0] = val - (Pel) IF_INTERNAL_OFFS;\par
00809 \par
00810         val               = leftShift_round(refPel[width - 3], shift);\par
00811         dstPel[width - 3] = val - (Pel) IF_INTERNAL_OFFS;\par
00812 \par
00813         refPel += refBuf.stride;\par
00814         dstPel += dstBuf.stride;\par
00815       \}\par
00816 \par
00817       refPel = refBuf.buf + (height - 2 * BIO_EXTEND_SIZE - 2 + 1 - yOffset) * refBuf.stride - xOffset;\par
00818       dstPel = m_filteredBlockTmp[2 + m_iRefListIdx][compID] + (height - 2 * BIO_EXTEND_SIZE) * dstBuf.stride + 1;\par
00819       {\cf19 for} ({\cf18 int} w = 0; w < (width - 2 * BIO_EXTEND_SIZE); w++)\par
00820       \{\par
00821         Pel val   = leftShift_round(refPel[w], shift);\par
00822         dstPel[w] = val - (Pel) IF_INTERNAL_OFFS;\par
00823       \}\par
00824 \par
00825       {\cf20 // restore data}\par
00826       width         = backupWidth;\par
00827       height        = backupHeight;\par
00828       dstBuf.buf    = backupDstBufPtr;\par
00829       dstBuf.stride = backupDstBufStride;\par
00830     \}\par
00831   \}\par
00832 \}\par
