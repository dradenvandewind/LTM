01931 {\cf18 void} xDMVRSubPixelErrorSurface({\cf18 bool} notZeroCost, int16_t *totalDeltaMV, int16_t *deltaMV, uint64_t *pSADsArray)\par
01932 \{\par
01933 \par
01934   {\cf18 int} sadStride = (((2 * DMVR_NUM_ITERATION) + 1));\par
01935   uint64_t sadbuffer[5];\par
01936   {\cf19 if} (notZeroCost && (abs(totalDeltaMV[0]) != (2 << MV_FRACTIONAL_BITS_INTERNAL))\par
01937     && (abs(totalDeltaMV[1]) != (2 << MV_FRACTIONAL_BITS_INTERNAL)))\par
01938   \{\par
01939     int32_t tempDeltaMv[2] = \{ 0,0 \};\par
01940     sadbuffer[0] = pSADsArray[0];\par
01941     sadbuffer[1] = pSADsArray[-1];\par
01942     sadbuffer[2] = pSADsArray[-sadStride];\par
01943     sadbuffer[3] = pSADsArray[1];\par
01944     sadbuffer[4] = pSADsArray[sadStride];\par
01945     xSubPelErrorSrfc(sadbuffer, tempDeltaMv);\par
01946     totalDeltaMV[0] += tempDeltaMv[0];\par
01947     totalDeltaMV[1] += tempDeltaMv[1];\par
01948   \}\par
01949 \}\par
