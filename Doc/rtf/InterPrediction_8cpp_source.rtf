00874 {\cf18 void} InterPrediction::xPredAffineBlk({\cf17 const} ComponentID &compID, {\cf17 const} PredictionUnit &pu, {\cf17 const} Picture *refPic, {\cf17 const} Mv *_mv, PelUnitBuf &dstPic, {\cf17 const} {\cf18 bool} &bi, {\cf17 const} ClpRng &clpRng, {\cf18 bool} genChromaMv, {\cf17 const} std::pair<int, int> scalingRatio)\par
00875 \{\par
00876 \par
00877   JVET_J0090_SET_REF_PICTURE( refPic, compID );\par
00878   {\cf17 const} ChromaFormat chFmt = pu.chromaFormat;\par
00879   {\cf18 int} iScaleX = vtm::getComponentScaleX( compID, chFmt );\par
00880   {\cf18 int} iScaleY = vtm::getComponentScaleY( compID, chFmt );\par
00881 \par
00882   Mv mvLT =_mv[0];\par
00883   Mv mvRT =_mv[1];\par
00884   Mv mvLB =_mv[2];\par
00885 \par
00886   {\cf20 // get affine sub-block width and height}\par
00887   {\cf17 const} {\cf18 int} width  = pu.Y().width;\par
00888   {\cf17 const} {\cf18 int} height = pu.Y().height;\par
00889   {\cf18 int} blockWidth = AFFINE_MIN_BLOCK_SIZE;\par
00890   {\cf18 int} blockHeight = AFFINE_MIN_BLOCK_SIZE;\par
00891 \par
00892   CHECK(blockWidth  > (width >> iScaleX ), {\cf22 "Sub Block width  > Block width"});\par
00893   CHECK(blockHeight > (height >> iScaleY), {\cf22 "Sub Block height > Block height"});\par
00894   {\cf17 const} {\cf18 int} MVBUFFER_SIZE = MAX_CU_SIZE / MIN_PU_SIZE;\par
00895 \par
00896   {\cf17 const} {\cf18 int} cxWidth  = width  >> iScaleX;\par
00897   {\cf17 const} {\cf18 int} cxHeight = height >> iScaleY;\par
00898   {\cf17 const} {\cf18 int} iHalfBW  = blockWidth  >> 1;\par
00899   {\cf17 const} {\cf18 int} iHalfBH  = blockHeight >> 1;\par
00900 \par
00901   {\cf17 const} {\cf18 int} iBit = MAX_CU_DEPTH;\par
00902   {\cf18 int} iDMvHorX, iDMvHorY, iDMvVerX, iDMvVerY;\par
00903   iDMvHorX = (mvRT - mvLT).getHor() << (iBit - floorLog2(cxWidth));\par
00904   iDMvHorY = (mvRT - mvLT).getVer() << (iBit - floorLog2(cxWidth));\par
00905   {\cf19 if} ( pu.cu->affineType == AFFINEMODEL_6PARAM )\par
00906   \{\par
00907     iDMvVerX = (mvLB - mvLT).getHor() << (iBit - floorLog2(cxHeight));\par
00908     iDMvVerY = (mvLB - mvLT).getVer() << (iBit - floorLog2(cxHeight));\par
00909   \}\par
00910   {\cf19 else}\par
00911   \{\par
00912     iDMvVerX = -iDMvHorY;\par
00913     iDMvVerY = iDMvHorX;\par
00914   \}\par
00915 \par
00916   {\cf18 int} iMvScaleHor = mvLT.getHor() << iBit;\par
00917   {\cf18 int} iMvScaleVer = mvLT.getVer() << iBit;\par
00918   {\cf17 const} SPS &sps    = *pu.cs->sps;\par
00919 \par
00920   {\cf17 const} {\cf18 int} vFilterSize = isLuma(compID) ? NTAPS_LUMA : NTAPS_CHROMA;\par
00921 \par
00922   {\cf17 const} {\cf18 int} shift = iBit - 4 + MV_FRACTIONAL_BITS_INTERNAL;\par
00923   {\cf18 bool}      wrapRef = {\cf17 false};\par
00924   {\cf17 const} {\cf18 bool} subblkMVSpreadOverLimit = isSubblockVectorSpreadOverLimit( iDMvHorX, iDMvHorY, iDMvVerX, iDMvVerY, pu.interDir );\par
00925 \par
00926   {\cf18 bool} enablePROF = (sps.getUsePROF()) && (!m_skipPROF) && (compID == COMPONENT_Y);\par
00927   enablePROF &= (!pu.cs->picHeader->getProfDisabledFlag());\par
00928   enablePROF &= !((pu.cu->affineType == AFFINEMODEL_6PARAM && _mv[0] == _mv[1] && _mv[0] == _mv[2]) || (pu.cu->affineType == AFFINEMODEL_4PARAM && _mv[0] == _mv[1]));\par
00929   enablePROF &= !subblkMVSpreadOverLimit;\par
00930   {\cf17 const} {\cf18 int} profThres = 1 << (iBit + (m_isBi ? 1 : 0));\par
00931   enablePROF &= !m_encOnly || pu.cu->slice->getCheckLDC() || iDMvHorX > profThres || iDMvHorY > profThres || iDMvVerX > profThres || iDMvVerY > profThres || iDMvHorX < -profThres || iDMvHorY < -profThres || iDMvVerX < -profThres || iDMvVerY < -profThres;\par
00932   enablePROF &= (refPic->isRefScaled( pu.cs->pps ) == {\cf17 false});\par
00933 \par
00934   {\cf18 bool} isLast = enablePROF ? false : !bi;\par
00935 \par
00936   {\cf17 const} {\cf18 int} cuExtW = AFFINE_MIN_BLOCK_SIZE + PROF_BORDER_EXT_W * 2;\par
