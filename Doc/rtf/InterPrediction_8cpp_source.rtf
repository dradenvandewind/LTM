00622       {\cf19 else}\par
00623       \{\par
00624         xPredInterUni(pu, eRefPicList, pcMbBuf, pu.cu->geoFlag, bioApplied, luma, chroma);\par
00625       \}\par
00626     \}\par
00627   \}\par
00628   CPelUnitBuf srcPred0 = ( pu.chromaFormat == CHROMA_400 ?\par
00629                            CPelUnitBuf(pu.chromaFormat, PelBuf(m_acYuvPred[0][0], pcYuvPred.Y())) :\par
