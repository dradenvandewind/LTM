01311       {\cf17 const} Pel* SrcY0Tmp = srcY0 + (xu << 2) + (yu << 2) * src0Stride;\par
01312 \par
01313       g_pelBufOP.calcBIOSums(SrcY0Tmp, SrcY1Tmp, pGradX0Tmp, pGradX1Tmp, pGradY0Tmp, pGradY1Tmp, xu, yu, src0Stride, src1Stride, widthG, bitDepth, &sumAbsGX, &sumAbsGY, &sumDIX, &sumDIY, &sumSignGY_GX);\par
01314       tmpx = (sumAbsGX == 0 ? 0 : rightShiftMSB(sumDIX << 2, sumAbsGX));\par
01315       tmpx = Clip3(-limit, limit, tmpx);\par
01316 \par
01317       {\cf18 int}     mainsGxGy = sumSignGY_GX >> 12;\par
01318       {\cf18 int}     secsGxGy = sumSignGY_GX & ((1 << 12) - 1);\par
01319       {\cf18 int}     tmpData = tmpx * mainsGxGy;\par
01320       tmpData = ((tmpData << 12) + tmpx*secsGxGy) >> 1;\par
01321       tmpy = (sumAbsGY == 0 ? 0 : rightShiftMSB(((sumDIY << 2) - tmpData), sumAbsGY));\par
01322       tmpy = Clip3(-limit, limit, tmpy);\par
01323       srcY0Temp = srcY0 + (stridePredMC + 1) + ((yu*src0Stride + xu) << 2);\par
01324       srcY1Temp = srcY1 + (stridePredMC + 1) + ((yu*src0Stride + xu) << 2);\par
01325       gradX0 = m_gradX0 + offsetPos + ((yu*widthG + xu) << 2);\par
01326       gradX1 = m_gradX1 + offsetPos + ((yu*widthG + xu) << 2);\par
01327       gradY0 = m_gradY0 + offsetPos + ((yu*widthG + xu) << 2);\par
01328       gradY1 = m_gradY1 + offsetPos + ((yu*widthG + xu) << 2);\par
01329 \par
01330       dstY0 = dstY + ((yu*dstStride + xu) << 2);\par
01331       xAddBIOAvg4(srcY0Temp, src0Stride, srcY1Temp, src1Stride, dstY0, dstStride, gradX0, gradX1, gradY0, gradY1, widthG, (1 << 2), (1 << 2), ({\cf18 int})tmpx, ({\cf18 int})tmpy, shiftNum, offset, clpRng);\par
01332     \}  {\cf20 // xu}\par
01333   \}  {\cf20 // yu}\par
01334 \}\par
