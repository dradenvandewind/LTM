02235 {\cf18 void} InterPrediction::xIntraBlockCopy(PredictionUnit &pu, PelUnitBuf &predBuf, {\cf17 const} ComponentID compID)\par
02236 \{\par
02237   {\cf17 const} {\cf18 unsigned} {\cf18 int} lcuWidth = pu.cs->slice->getSPS()->getMaxCUWidth();\par
02238   {\cf17 const} {\cf18 int} shiftSampleHor = vtm::getComponentScaleX(compID, pu.chromaFormat);\par
02239   {\cf17 const} {\cf18 int} shiftSampleVer = vtm::getComponentScaleY(compID, pu.chromaFormat);\par
02240   {\cf17 const} {\cf18 int} ctuSizeLog2Ver = floorLog2(lcuWidth) - shiftSampleVer;\par
02241   pu.bv = pu.mv[REF_PIC_LIST_0];\par
02242   pu.bv.changePrecision(MV_PRECISION_INTERNAL, MV_PRECISION_INT);\par
02243   {\cf18 int} refx, refy;\par
02244   {\cf19 if} (compID == COMPONENT_Y)\par
02245   \{\par
02246     refx = pu.Y().x + pu.bv.hor;\par
02247     refy = pu.Y().y + pu.bv.ver;\par
02248   \}\par
02249   {\cf19 else}\par
02250   \{{\cf20 //Cb or Cr}\par
02251     refx = pu.Cb().x + (pu.bv.hor >> shiftSampleHor);\par
02252     refy = pu.Cb().y + (pu.bv.ver >> shiftSampleVer);\par
02253   \}\par
02254   refx &= ((m_IBCBufferWidth >> shiftSampleHor) - 1);\par
02255   refy &= ((1 << ctuSizeLog2Ver) - 1);\par
02256 \par
02257   {\cf19 if} (refx + predBuf.bufs[compID].width <= (m_IBCBufferWidth >> shiftSampleHor))\par
02258   \{\par
02259     {\cf17 const} CompArea srcArea = CompArea(compID, pu.chromaFormat, Position(refx, refy), Size(predBuf.bufs[compID].width, predBuf.bufs[compID].height));\par
02260     {\cf17 const} CPelBuf refBuf = m_IBCBuffer.getBuf(srcArea);\par
02261     predBuf.bufs[compID].copyFrom(refBuf);\par
02262   \}\par
02263   {\cf19 else}\par
02264   \{{\cf20 //wrap around}\par
02265     {\cf18 int} width = (m_IBCBufferWidth >> shiftSampleHor) - refx;\par
02266     CompArea srcArea = CompArea(compID, pu.chromaFormat, Position(refx, refy), Size(width, predBuf.bufs[compID].height));\par
02267     CPelBuf srcBuf = m_IBCBuffer.getBuf(srcArea);\par
02268     PelBuf dstBuf = PelBuf(predBuf.bufs[compID].bufAt(Position(0, 0)), predBuf.bufs[compID].stride, Size(width, predBuf.bufs[compID].height));\par
02269     dstBuf.copyFrom(srcBuf);\par
02270 \par
02271     width = refx + predBuf.bufs[compID].width - (m_IBCBufferWidth >> shiftSampleHor);\par
02272     srcArea = CompArea(compID, pu.chromaFormat, Position(0, refy), Size(width, predBuf.bufs[compID].height));\par
02273     srcBuf = m_IBCBuffer.getBuf(srcArea);\par
02274     dstBuf = PelBuf(predBuf.bufs[compID].bufAt(Position((m_IBCBufferWidth >> shiftSampleHor) - refx, 0)), predBuf.bufs[compID].stride, Size(width, predBuf.bufs[compID].height));\par
02275     dstBuf.copyFrom(srcBuf);\par
02276   \}\par
02277 \}\par
