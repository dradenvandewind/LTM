01995       {\cf17 false}, {\cf17 false}, pu.cu->slice->getScalingRatio( REF_PIC_LIST_1, refIdx1 ), pu.lwidth() + ( 2 * DMVR_NUM_ITERATION ), pu.lheight() + ( 2 * DMVR_NUM_ITERATION ), {\cf17 true}, ( (Pel *)srcBuf.buf ) + offset, srcBuf.stride );\par
