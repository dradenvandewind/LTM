00282 {\cf18 void} InterPrediction::xSubPuMC( PredictionUnit& pu, PelUnitBuf& predBuf, {\cf17 const} RefPicList &eRefPicList {\cf20 /*= REF_PIC_LIST_X*/}, {\cf17 const} {\cf18 bool} luma {\cf20 /*= true*/}, {\cf17 const} {\cf18 bool} chroma {\cf20 /*= true*/})\par
00283 \{\par
00284 \par
00285   {\cf20 // compute the location of the current PU}\par
00286   Position puPos    = pu.lumaPos();\par
00287   Size puSize       = pu.lumaSize();\par
00288 \par
00289   {\cf18 int} numPartLine, numPartCol, puHeight, puWidth;\par
00290   \{\par
00291     numPartLine = std::max(puSize.width >> ATMVP_SUB_BLOCK_SIZE, 1u);\par
00292     numPartCol = std::max(puSize.height >> ATMVP_SUB_BLOCK_SIZE, 1u);\par
00293     puHeight = numPartCol == 1 ? puSize.height : 1 << ATMVP_SUB_BLOCK_SIZE;\par
00294     puWidth = numPartLine == 1 ? puSize.width : 1 << ATMVP_SUB_BLOCK_SIZE;\par
00295   \}\par
00296 \par
00297   PredictionUnit subPu;\par
00298 \par
00299   subPu.cs        = pu.cs;\par
00300   subPu.cu        = pu.cu;\par
00301   subPu.mergeType = MRG_TYPE_DEFAULT_N;\par
00302 \par
00303   {\cf18 bool} isAffine = pu.cu->affine;\par
00304   subPu.cu->affine = {\cf17 false};\par
00305 \par
00306   {\cf20 // join sub-pus containing the same motion}\par
00307   {\cf18 bool} verMC = puSize.height > puSize.width;\par
00308   {\cf18 int}  fstStart = (!verMC ? puPos.y : puPos.x);\par
00309   {\cf18 int}  secStart = (!verMC ? puPos.x : puPos.y);\par
00310   {\cf18 int}  fstEnd = (!verMC ? puPos.y + puSize.height : puPos.x + puSize.width);\par
00311   {\cf18 int}  secEnd = (!verMC ? puPos.x + puSize.width : puPos.y + puSize.height);\par
00312   {\cf18 int}  fstStep = (!verMC ? puHeight : puWidth);\par
00313   {\cf18 int}  secStep = (!verMC ? puWidth : puHeight);\par
00314 \par
00315   {\cf18 bool} scaled = pu.cu->slice->getRefPic( REF_PIC_LIST_0, 0 )->isRefScaled( pu.cs->pps ) || ( pu.cs->slice->getSliceType() == B_SLICE ? pu.cu->slice->getRefPic( REF_PIC_LIST_1, 0 )->isRefScaled( pu.cs->pps ) : false );\par
00316 \par
00317   m_subPuMC = {\cf17 true};\par
00318 \par
00319   {\cf19 for} ({\cf18 int} fstDim = fstStart; fstDim < fstEnd; fstDim += fstStep)\par
00320   \{\par
00321     {\cf19 for} ({\cf18 int} secDim = secStart; secDim < secEnd; secDim += secStep)\par
00322     \{\par
00323       {\cf18 int} x = !verMC ? secDim : fstDim;\par
00324       {\cf18 int} y = !verMC ? fstDim : secDim;\par
00325       {\cf17 const} MotionInfo &curMi = pu.getMotionInfo(Position\{ x, y \});\par
00326 \par
00327       {\cf18 int} length = secStep;\par
00328       {\cf18 int} later  = secDim + secStep;\par
00329 \par
00330       {\cf19 while} (later < secEnd)\par
00331       \{\par
00332         {\cf17 const} MotionInfo &laterMi = !verMC ? pu.getMotionInfo(Position\{ later, fstDim \}) : pu.getMotionInfo(Position\{ fstDim, later \});\par
00333         {\cf19 if} (!scaled && laterMi == curMi)\par
00334         \{\par
00335           length += secStep;\par
00336         \}\par
00337         {\cf19 else}\par
00338         \{\par
00339           {\cf19 break};\par
00340         \}\par
00341         later += secStep;\par
00342       \}\par
00343       {\cf18 int} dx = !verMC ? length : puWidth;\par
00344       {\cf18 int} dy = !verMC ? puHeight : length;\par
00345 \par
00346       subPu.UnitArea::operator=(UnitArea(pu.chromaFormat, Area(x, y, dx, dy)));\par
00347       subPu = curMi;\par
00348       PelUnitBuf subPredBuf = predBuf.subBuf(UnitAreaRelative(pu, subPu));\par
00349       subPu.mmvdEncOptMode = 0;\par
00350       subPu.mvRefine = {\cf17 false};\par
00351       motionCompensation(subPu, subPredBuf, eRefPicList, luma, chroma);\par
00352       secDim = later - secStep;\par
00353     \}\par
00354   \}\par
00355   m_subPuMC = {\cf17 false};\par
00356 \par
00357   pu.cu->affine = isAffine;\par
00358 \}\par
