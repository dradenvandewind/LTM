00610             picture_configuration.step_width_loq[LOQ_LEVEL_1] = b.u(15, {\cf22 "step_width_level1"});\par
00611             CHECK(picture_configuration.step_width_loq[LOQ_LEVEL_1] > 0);\par
00612             picture_configuration.level_1_filtering_enabled = b.u(1, {\cf22 "level_1_filtering_enabled"});\par
00613         \} {\cf19 else}\par
00614             picture_configuration.step_width_loq[LOQ_LEVEL_1] = MAX_STEP_WIDTH;\par
00615 \par
00616         {\cf19 if} (picture_configuration.quant_matrix_mode == QuantMatrix_SameAndCustom ||\par
00617             picture_configuration.quant_matrix_mode == QuantMatrix_Level2CustomLevel1Default ||\par
00618             picture_configuration.quant_matrix_mode == QuantMatrix_DifferentAndCustom) \{\par
00619             {\cf19 for} ({\cf18 unsigned} layerIndex = 0; layerIndex < num_residual_layers; layerIndex++)\par
00620                 picture_configuration.qm_coefficient_2[layerIndex] = b.u(8, {\cf22 "qm_coefficient_0"});\par
00621         \}\par
00622         {\cf19 if} (picture_configuration.quant_matrix_mode == QuantMatrix_Level2DefaultLevel1Custom ||\par
00623             picture_configuration.quant_matrix_mode == QuantMatrix_DifferentAndCustom) \{\par
00624             {\cf19 for} ({\cf18 unsigned} layerIndex = 0; layerIndex < num_residual_layers; layerIndex++)\par
00625                 picture_configuration.qm_coefficient_1[layerIndex] = b.u(8, {\cf22 "qm_coefficient_1"});\par
00626         \}\par
00627 \par
00628         {\cf19 if} (picture_configuration.dequant_offset_signalled) \{\par
00629             {\cf17 const} {\cf18 unsigned} dequant_offset_mode = b.u(1, {\cf22 "dequant_offset_mode"});\par
00630             {\cf19 switch} (dequant_offset_mode) \{\par
00631             {\cf19 case} 0:\par
00632                 picture_configuration.dequant_offset_mode = DequantOffset_Default;\par
00633                 {\cf19 break};\par
00634             {\cf19 case} 1:\par
00635                 picture_configuration.dequant_offset_mode = DequantOffset_ConstOffset;\par
00636                 {\cf19 break};\par
00637             {\cf19 default}:\par
00638                 CHECK(0);\par
00639                 {\cf19 break};\par
00640             \}\par
00641             picture_configuration.dequant_offset = b.u(7, {\cf22 "dequant_offset"});\par
00642         \}\par
00643 \par
00644         {\cf19 if} (picture_configuration.dithering_control) \{\par
00645             {\cf17 const} {\cf18 unsigned} dithering_type = b.u(2, {\cf22 "dithering_type"});\par
00646             {\cf19 switch} (dithering_type) \{\par
00647             {\cf19 case} 0:\par
00648                 picture_configuration.dithering_type = Dithering_None;\par
00649                 {\cf19 break};\par
00650             {\cf19 case} 1:\par
00651                 picture_configuration.dithering_type = Dithering_Uniform;\par
00652                 {\cf19 break};\par
00653             {\cf19 default}:\par
00654                 CHECK(0);\par
00655                 {\cf19 break};\par
00656             \}\par
00657             b.u(1, {\cf22 "reserved"});\par
00658             {\cf19 if} (picture_configuration.dithering_type != Dithering_None)\par
00659                 picture_configuration.dithering_strength = b.u(5, {\cf22 "dithering_strength"});\par
00660             {\cf19 else}\par
00661                 b.u(5, {\cf22 "reserved"});\par
00662         \}\par
00663     \} {\cf19 else} \{\par
00664         b.u(4, {\cf22 "reserved"});\par
00665         picture_type = b.u(1, {\cf22 "picture_type"});\par
00666         picture_configuration.temporal_refresh = b.u(1, {\cf22 "temporal_refresh"});\par
00667         picture_configuration.temporal_signalling_present = b.u(1, {\cf22 "temporal_signalling_present"});\par
00668     \}\par
00669 \par
00670     {\cf19 switch} (picture_type) \{\par
00671     {\cf19 case} 0:\par
00672         picture_configuration.picture_type = PictureType_Frame;\par
00673         {\cf19 break};\par
00674     {\cf19 case} 1:\par
00675         picture_configuration.picture_type = PictureType_Field;\par
00676         {\cf19 break};\par
00677     {\cf19 default}:\par
00678         CHECK(0);\par
00679         {\cf19 break};\par
00680     \}\par
00681 \par
00682 {\cf21 #if BITSTREAM_DEBUG}\par
00683     fprintf(goBits, {\cf22 "@@@@ @@@@ picture_config <<<< \\n"});\par
00684     fflush(goBits);\par
00685 {\cf21 #endif}\par
00686 \}\par
00687 \par
00688 {\cf20 // Number of encoded layers in bitstream - residual + temporal}\par
00689 {\cf17 static} {\cf18 unsigned} total_layers({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq) \{\par
00690     {\cf19 return} configuration.global_configuration.num_residual_layers +\par
00691            ((loq == LOQ_LEVEL_2 && configuration.picture_configuration.temporal_signalling_present) ? 1 : 0);\par
00692 \}\par
00693 \par
00694 {\cf17 static} {\cf18 unsigned} first_layer({\cf17 const} SignaledConfiguration &configuration) \{\par
00695     {\cf19 if} (configuration.picture_configuration.enhancement_enabled)\par
00696         {\cf19 return} 0;\par
00697     {\cf19 else}\par
00698         {\cf20 // First layer is temporal}\par
00699         {\cf19 return} configuration.global_configuration.num_residual_layers;\par
00700 \}\par
00701 \par
00702 {\cf17 static} {\cf18 bool} is_temporal_layer({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq, {\cf18 unsigned} layer) \{\par
00703     {\cf19 return} layer == configuration.global_configuration.num_residual_layers;\par
00704 \}\par
