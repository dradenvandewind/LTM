00053 {\cf20 // Read a multibyte encoded uint64_t}\par
00054 {\cf20 //}\par
00055 uint64_t read_multibyte(BitstreamUnpacker &b, {\cf17 const} std::string &l) \{\par
00056     BitstreamUnpacker::ScopedContextLabel label(b, l);\par
00057 \par
00058     uint64_t result = 0;\par
00059     {\cf18 bool} more = {\cf17 false};\par
00060     {\cf19 do} \{\par
00061         more = b.u(1, {\cf22 "mb-more"}) != 0;\par
00062         uint64_t bits = b.u(7, {\cf22 "mb-bits"});\par
00063 \par
00064         result = (result << 7) | bits;\par
00065     \} {\cf19 while} (more);\par
00066 \par
00067     {\cf19 return} result;\par
00068 \}\par
00069 \par
00070 {\cf20 // Coded resolution}\par
00071 {\cf20 //}\par
00072 {\cf17 const} {\cf18 unsigned} resolution_table[51][2] = \{\par
00073     \{0, 0\},       \{360, 200\},   \{400, 240\},   \{480, 320\},   \{640, 360\},   \{640, 480\},   \{768, 480\},   \{800, 600\},   \{852, 480\},\par
00074     \{854, 480\},   \{856, 480\},   \{960, 540\},   \{960, 640\},   \{1024, 576\},  \{1024, 600\},  \{1024, 768\},  \{1152, 864\},  \{1280, 720\},\par
00075     \{1280, 800\},  \{1280, 1024\}, \{1360, 768\},  \{1366, 768\},  \{1440, 1050\}, \{1440, 900\},  \{1600, 1200\}, \{1680, 1050\}, \{1920, 1080\},\par
00076     \{1920, 1200\}, \{2048, 1080\}, \{2048, 1152\}, \{2048, 1536\}, \{2160, 1440\}, \{2560, 1440\}, \{2560, 1600\}, \{2560, 2048\}, \{3200, 1800\},\par
00077     \{3200, 2048\}, \{3200, 2400\}, \{3440, 1440\}, \{3840, 1600\}, \{3840, 2160\}, \{3840, 3072\}, \{4096, 2160\}, \{4096, 3072\}, \{5120, 2880\},\par
00078     \{5120, 3200\}, \{5120, 4096\}, \{6400, 4096\}, \{6400, 4800\}, \{7680, 4320\}, \{7680, 4800\}\};\par
00079 \par
00080 {\cf17 static_assert}(({\cf17 sizeof}(resolution_table) / {\cf17 sizeof}(resolution_table[0])) == 51, {\cf22 "Resolution table is broken"});\par
00081 \par
