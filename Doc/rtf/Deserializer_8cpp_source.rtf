00083 \par
00084 Deserializer::Deserializer({\cf17 const} Packet &packet, SignaledConfiguration &dst_configuration,\par
00085                            Surface (&symbols)[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS])\par
00086     : Component({\cf22 "Deserializer"}), view_(packet), b_(view_), dst_configuration_(dst_configuration), symbols_(symbols) \{\}\par
00087 \par
00088 {\cf20 // Top level of enhancement layer parsing}\par
00089 {\cf20 //}\par
00090 {\cf18 bool} Deserializer::has_more(){\cf17  const }\{ {\cf19 return} !b_.empty(); \};\par
00091 \par
00092 {\cf20 //}\par
00093 {\cf20 //}\par
00094 {\cf18 unsigned} Deserializer::parse_block() \{\par
00095 \par
00096     {\cf17 const} {\cf18 unsigned} payload_size_type = b_.u(3, {\cf22 "payload_size_type"});\par
00097     {\cf17 const} {\cf18 unsigned} payload_type = b_.u(5, {\cf22 "payload_type"});\par
00098 \par
00099     {\cf18 unsigned} payload_byte_size = 0;\par
00100     {\cf19 switch} (payload_size_type) \{\par
00101     {\cf19 case} 0:\par
00102         payload_byte_size = 0;\par
00103         {\cf19 break};\par
00104     {\cf19 case} 1:\par
00105         payload_byte_size = 1;\par
00106         {\cf19 break};\par
00107     {\cf19 case} 2:\par
00108         payload_byte_size = 2;\par
00109         {\cf19 break};\par
00110     {\cf19 case} 3:\par
00111         payload_byte_size = 3;\par
00112         {\cf19 break};\par
00113     {\cf19 case} 4:\par
00114         payload_byte_size = 4;\par
00115         {\cf19 break};\par
00116     {\cf19 case} 5:\par
00117         payload_byte_size = 5;\par
00118         {\cf19 break};\par
00119     {\cf19 case} 7:\par
00120         payload_byte_size = (unsigned)read_multibyte(b_, {\cf22 "payload_byte_size"});\par
00121         {\cf19 break};\par
00122     {\cf19 default}:\par
00123         CHECK(0);\par
00124         {\cf19 break};\par
00125     \}\par
00126 \par
00127     {\cf20 // Read all payload into packet, then parse from that}\par
00128     {\cf17 const} Packet packet = b_.bytes(payload_byte_size);\par
00129     {\cf17 const} PacketView view(packet);\par
00130     BitstreamUnpacker payload_bitstream(view);\par
00131 \par
00132     {\cf19 switch} (payload_type) \{\par
00133     {\cf19 case} 0:\par
00134         parse_sequence_config(dst_configuration_.sequence_configuration, payload_bitstream);\par
00135         {\cf19 return} SyntaxBlock_Sequence;\par
00136     {\cf19 case} 1:\par
00137         parse_global_config(dst_configuration_.global_configuration, payload_bitstream);\par
00138         {\cf19 return} SyntaxBlock_Global;\par
00139     {\cf19 case} 2:\par
00140         parse_picture_config(dst_configuration_.picture_configuration, payload_bitstream,\par
00141                              dst_configuration_.global_configuration.num_residual_layers,\par
00142                              dst_configuration_.global_configuration.temporal_enabled);\par
00143         {\cf19 return} SyntaxBlock_Picture;\par
00144     {\cf19 case} 3:\par
00145         parse_encoded_data(dst_configuration_, payload_bitstream, dst_configuration_.global_configuration.num_processed_planes,\par
00146                            symbols_);\par
