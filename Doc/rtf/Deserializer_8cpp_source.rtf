00706 {\cf18 void} Deserializer::parse_encoded_data(SignaledConfiguration &dst_configuration, BitstreamUnpacker &b, {\cf18 unsigned} num_planes,\par
00707                                       Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS]) \{\par
00708 {\cf21 #if BITSTREAM_DEBUG}\par
00709     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data >>>> \\n"});\par
00710     fflush(goBits);\par
00711 {\cf21 #endif}\par
00712     {\cf18 bool} entropy_enabled[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS] = \{{\cf17 false}\};\par
00713     {\cf18 bool} rle_only[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS] = \{{\cf17 false}\};\par
00714 \par
00715     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00716         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00717             {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq); ++layer) \{\par
00718                 BitstreamUnpacker::ScopedContextLabel label(b, {\cf22 "encoded_data"});\par
00719                 entropy_enabled[plane][loq][layer] = b.u(1, {\cf22 "entropy_enabled"});\par
00720                 rle_only[plane][loq][layer] = b.u(1, {\cf22 "rle_only"});\par
00721             \}\par
00722         \}\par
00723     \}\par
00724 \par
00725     {\cf20 // Byte alignment}\par
00726 {\cf21 #if defined __OPT_MODULO__}\par
00727     {\cf19 while} ((b.bit_offset() & 0x07))\par
00728 {\cf21 #else}\par
00729     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00730 {\cf21 #endif}\par
00731         CHECK(b.u(1, {\cf22 "alignment"}) == 0);\par
00732 \par
00733     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00734         {\cf19 if} (dst_configuration.picture_configuration.enhancement_enabled ||\par
00735             dst_configuration.picture_configuration.temporal_signalling_present) \{\par
00736             {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00737                 {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq);\par
00738                      ++layer) \{\par
00739                     {\cf17 const} SurfaceConfiguration &surface_configuration = dst_configuration.surface_configuration[plane][loq][layer];\par
00740                     Packet data;\par
00741 \par
00742                     {\cf19 if} (entropy_enabled[plane][loq][layer]) \{\par
00743                         BitstreamUnpacker::ScopedContextLabel label(b, format({\cf22 "surface[%d][%d][%d]"}, plane, loq, layer));\par
00744                         {\cf17 const} uint64_t data_size = read_multibyte(b, {\cf22 "data_size"});\par
00745                         CHECK(data_size < INT_MAX);\par
00746                         data = b.bytes(({\cf18 unsigned})data_size);\par
00747                     \}\par
00748 \par
00749                     PacketView view(data);\par
00750                     BitstreamUnpacker pb(view);\par
00751                     {\cf19 if} (!is_temporal_layer(dst_configuration, plane, loq, layer)) \{\par
00752                         {\cf17 const} {\cf18 bool} use_tiled_encoding_order = dst_configuration.global_configuration.temporal_enabled ||\par
00753                                                               dst_configuration.global_configuration.tile_dimensions_type > 0;\par
00754                         {\cf19 if} (use_tiled_encoding_order) \{\par
00755                             symbols[plane][loq][layer] = EntropyDecoderResidualsTiled().process(\par
00756                                 surface_configuration.width, surface_configuration.height, entropy_enabled[plane][loq][layer],\par
00757                                 rle_only[plane][loq][layer], pb, dst_configuration.global_configuration.transform_block_size);\par
00758                         \} {\cf19 else} \{\par
00759                             symbols[plane][loq][layer] = EntropyDecoderResiduals().process(\par
00760                                 surface_configuration.width, surface_configuration.height, entropy_enabled[plane][loq][layer],\par
00761                                 rle_only[plane][loq][layer], pb);\par
00762                         \}\par
00763                     \} {\cf19 else} \{\par
00764                         symbols[plane][loq][layer] = EntropyDecoderTemporal().process(\par
00765                             surface_configuration.width, surface_configuration.height, entropy_enabled[plane][loq][layer],\par
00766                             rle_only[plane][loq][layer], pb, dst_configuration.global_configuration.transform_block_size,\par
00767                             dst_configuration.global_configuration.temporal_tile_intra_signalling_enabled);\par
00768                     \}\par
00769                 \}\par
00770             \}\par
00771         \}\par
00772     \}\par
00773 \par
00774 {\cf21 #if BITSTREAM_DEBUG}\par
00775     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data <<<< \\n"});\par
00776     fflush(goBits);\par
00777 {\cf21 #endif}\par
00778 \}\par
00779 \par
00780 {\cf17 static} Surface decode_layer({\cf17 const} SignaledConfiguration &dst_configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq, {\cf18 unsigned} layer,\par
00781                             {\cf18 unsigned} width, {\cf18 unsigned} height, {\cf18 bool} entropy_enabled, {\cf18 bool} rle_only, BitstreamUnpacker &b) \{\par
00782 \par
00783     {\cf19 if} (!is_temporal_layer(dst_configuration, plane, loq, layer)) \{\par
00784         {\cf17 const} {\cf18 bool} use_tiled_encoding_order = dst_configuration.global_configuration.temporal_enabled ||\par
00785                                               dst_configuration.global_configuration.tile_dimensions_type > 0;\par
00786         {\cf19 if} (use_tiled_encoding_order) \{\par
00787             {\cf19 return} EntropyDecoderResidualsTiled().process(width, height, entropy_enabled, rle_only, b,\par
00788                                                           dst_configuration.global_configuration.transform_block_size);\par
00789         \} {\cf19 else} \{\par
00790             {\cf19 return} EntropyDecoderResiduals().process(width, height, entropy_enabled, rle_only, b);\par
00791         \}\par
00792 \par
00793     \} {\cf19 else} \{\par
00794         {\cf19 return} EntropyDecoderTemporal().process(width, height, entropy_enabled, rle_only, b,\par
00795                                                 dst_configuration.global_configuration.transform_block_size,\par
00796                                                 dst_configuration.global_configuration.temporal_tile_intra_signalling_enabled);\par
00797     \}\par
00798 \}\par
00799 \par
00800 {\cf17 static} Surface assemble_layer(SignaledConfiguration &dst_configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq, {\cf18 unsigned} layer,\par
00801                               {\cf18 unsigned} width, {\cf18 unsigned} height, {\cf18 unsigned} tiles_x, {\cf18 unsigned} tiles_y, {\cf18 unsigned} tile_width,\par
00802                               {\cf18 unsigned} tile_height, {\cf17 const} std::vector<Surface> &tiles) \{\par
00803 \par
00804     {\cf19 if} (is_temporal_layer(dst_configuration, plane, layer, loq)) \{\par
00805         std::vector<SurfaceView<uint8_t>> src;\par
00806         {\cf19 for} ({\cf17 const} {\cf17 auto} &t : tiles)\par
00807             src.push_back(SurfaceView<uint8_t>(t));\par
00808 \par
00809         {\cf19 return} Surface::build_from<uint8_t>()\par
00810             .generate(width, height,\par
00811                       [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{\par
00812                           {\cf17 const} {\cf18 unsigned} tx = x / tile_width;\par
00813                           {\cf17 const} {\cf18 unsigned} ty = y / tile_height;\par
00814                           CHECK(tx < tiles_x);\par
00815                           CHECK(ty < tiles_y);\par
00816                           {\cf19 return} src[ty * tiles_x + tx].read(x % tile_width, y % tile_height);\par
00817                       \})\par
00818             .finish();\par
00819     \} {\cf19 else} \{\par
00820         std::vector<SurfaceView<int16_t>> src;\par
00821         {\cf19 for} ({\cf17 const} {\cf17 auto} &t : tiles)\par
00822             src.push_back(SurfaceView<int16_t>(t));\par
00823 \par
00824         {\cf19 return} Surface::build_from<int16_t>()\par
00825             .generate(width, height,\par
00826                       [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00827                           {\cf17 const} {\cf18 unsigned} tx = x / tile_width;\par
00828                           {\cf17 const} {\cf18 unsigned} ty = y / tile_height;\par
00829                           CHECK(tx < tiles_x);\par
00830                           CHECK(ty < tiles_y);\par
00831                           {\cf19 return} src[ty * tiles_x + tx].read(x % tile_width, y % tile_height);\par
00832                       \})\par
00833             .finish();\par
00834     \}\par
00835 \}\par
00836 \par
00837 {\cf18 void} Deserializer::parse_encoded_data_tiled(SignaledConfiguration &dst_configuration, BitstreamUnpacker &b, {\cf18 unsigned} num_planes,\par
00838                                             Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS]) \{\par
00839 \par
00840     CHECK(dst_configuration.global_configuration.tile_dimensions_type != TileDimensions_None);\par
00841 \par
00842     {\cf17 const} {\cf18 unsigned} transform_block_size = dst_configuration.global_configuration.transform_block_size;\par
00843     Dimensions dimensions;\par
00844     dimensions.set(dst_configuration, dst_configuration.global_configuration.resolution_width,\par
00845                    dst_configuration.global_configuration.resolution_height);\par
00846 \par
00847     {\cf20 // Per layer sizes}\par
00848     {\cf17 struct }\{\par
00849         {\cf18 unsigned} width;\par
00850         {\cf18 unsigned} height;\par
00851         {\cf18 unsigned} tile_width;\par
00852         {\cf18 unsigned} tile_height;\par
00853         {\cf18 unsigned} tiles_x;\par
00854         {\cf18 unsigned} tiles_y;\par
00855         {\cf18 unsigned} num_tiles;\par
00856     \} sizes[MAX_NUM_PLANES][MAX_NUM_LOQS] = \{0\};\par
00857 \par
00858     {\cf18 unsigned} total_tiles = 0;\par
00859 \par
00860     {\cf20 // Fill in layer sizes}\par
00861     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00862         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00863             {\cf17 const} {\cf18 unsigned} num_layers = total_layers(dst_configuration, plane, loq) - first_layer(dst_configuration);\par
00864 \par
00865             {\cf17 const} {\cf18 unsigned} tile_width = dimensions.tile_width(plane, loq);\par
00866             {\cf17 const} {\cf18 unsigned} tile_height = dimensions.tile_height(plane, loq);\par
00867 \par
00868             {\cf20 // Figure out tile breakdown for this level}\par
00869             sizes[plane][loq].width = dimensions.layer_width(plane, loq);\par
00870             sizes[plane][loq].height = dimensions.layer_height(plane, loq);\par
00871             sizes[plane][loq].tile_width = tile_width;\par
00872             sizes[plane][loq].tile_height = tile_height;\par
00873             sizes[plane][loq].tiles_x = (sizes[plane][loq].width + tile_width - 1) / tile_width;\par
00874             sizes[plane][loq].tiles_y = (sizes[plane][loq].height + tile_height - 1) / tile_height;\par
00875             sizes[plane][loq].num_tiles = sizes[plane][loq].tiles_x * sizes[plane][loq].tiles_y;\par
00876 \par
00877             total_tiles += sizes[plane][loq].num_tiles * num_layers;\par
00878         \}\par
00879     \}\par
00880 \par
00881     {\cf20 // Parse per-layer rle_only flags}\par
00882     {\cf18 bool} rle_only[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS] = \{{\cf17 false}\};\par
00883 \par
00884     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00885         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00886             {\cf19 if} (dst_configuration.picture_configuration.enhancement_enabled) \{\par
00887                 {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq);\par
00888                      ++layer) \{\par
00889                     rle_only[plane][loq][layer] = b.u(1, {\cf22 "rle_only"});\par
00890                 \}\par
00891             \}\par
00892         \}\par
00893     \}\par
00894 \par
00895     {\cf20 // Byte alignment}\par
00896 {\cf21 #if defined __OPT_MODULO__}\par
00897     {\cf19 while} ((b.bit_offset() & 0x07))\par
00898 #{\cf19 else}\par
00899     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00900 #endif\par
00901         CHECK(b.u(1, {\cf22 "alignment"}) == 0);\par
00902 \par
00903     std::vector<bool> entropy_enabled(total_tiles, {\cf17 false});\par
00904 \par
00905     {\cf20 // Parse per tile entropy_enabled}\par
00906     {\cf19 if} (!dst_configuration.global_configuration.compression_type_entropy_enabled_per_tile) \{\par
00907 \par
00908         {\cf18 int} idx = 0;\par
00909         {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00910             {\cf19 if} (dst_configuration.picture_configuration.enhancement_enabled) \{\par
00911                 {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00912                     {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq);\par
00913                          ++layer) \{\par
00914                         {\cf19 for} ({\cf18 unsigned} tile = 0; tile < sizes[plane][loq].num_tiles; ++tile) \{\par
00915                             entropy_enabled[idx] = b.u(1, {\cf22 "entropy_enabled"});\par
00916                             idx++;\par
00917                         \}\par
00918                     \}\par
00919                 \}\par
00920             \}\par
00921         \}\par
00922 \par
00923     \} {\cf19 else} \{\par
00924         {\cf19 if} (dst_configuration.picture_configuration.enhancement_enabled) \{\par
00925             Surface ee = EntropyDecoderFlags().process({\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(entropy_enabled.size()), 1, b);\par
00926 \par
00927             {\cf17 const} {\cf17 auto} eeview = ee.view_as<uint8_t>();\par
00928             {\cf19 for} ({\cf18 unsigned} i = 0; i < entropy_enabled.size(); ++i)\par
00929                 entropy_enabled[i] = eeview.read(i, 0);\par
00930         \}\par
00931     \}\par
00932 \par
00933     {\cf20 // Byte alignment}\par
00934 {\cf21 #if defined __OPT_MODULO__}\par
00935     {\cf19 while} ((b.bit_offset() & 0x07))\par
00936 #{\cf19 else}\par
00937     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00938 #endif\par
00939         CHECK(b.u(1, {\cf22 "alignment"}) == 0);\par
00940 \par
00941     {\cf19 if} (dst_configuration.global_configuration.compression_type_size_per_tile == CompressionType::CompressionType_None) \{\par
00942         {\cf20 // Uncompressed tile sizes and data}\par
00943         {\cf18 int} idx = 0;\par
00944         {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00945             {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00946                 {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq);\par
00947                      ++layer) \{\par
00948                     std::vector<Surface> tiles;\par
00949                     {\cf19 for} ({\cf18 unsigned} ty = 0; ty < sizes[plane][loq].tiles_y; ++ty) \{\par
00950                         {\cf19 for} ({\cf18 unsigned} tx = 0; tx < sizes[plane][loq].tiles_x; ++tx) \{\par
00951                             {\cf20 // Where is tile going to go?}\par
00952                             {\cf17 const} {\cf18 unsigned} tx0 = tx * sizes[plane][loq].tile_width;\par
00953                             {\cf17 const} {\cf18 unsigned} ty0 = ty * sizes[plane][loq].tile_height;\par
00954                             {\cf20 // const unsigned tx1 = std::min((tx + 1) * tile_width, sizes[plane][loq].width);}\par
00955                             {\cf17 const} {\cf18 unsigned} tx1 = LCEVC_MIN((tx + 1) * sizes[plane][loq].tile_width, sizes[plane][loq].width);\par
00956                             {\cf20 // const unsigned ty1 = std::min((ty + 1) * tile_height, sizes[plane][loq].height);}\par
00957                             {\cf17 const} {\cf18 unsigned} ty1 = LCEVC_MIN((ty + 1) * sizes[plane][loq].tile_height, sizes[plane][loq].height);\par
00958 \par
00959                             Packet data;\par
00960                             {\cf19 if} (entropy_enabled[idx]) \{\par
00961                                 {\cf17 const} uint64_t data_size = read_multibyte(b, {\cf22 "data_size"});\par
00962                                 CHECK(data_size < INT_MAX);\par
00963                                 data = b.bytes(({\cf18 unsigned})data_size);\par
00964                             \}\par
00965                             PacketView view(data);\par
00966                             BitstreamUnpacker pb(view);\par
00967                             tiles.push_back(decode_layer(dst_configuration, plane, loq, layer, tx1 - tx0, ty1 - ty0,\par
00968                                                          entropy_enabled[idx], rle_only[plane][loq][layer], pb));\par
00969                             idx++;\par
00970                         \}\par
00971                     \}\par
00972                     symbols[plane][loq][layer] =\par
00973                         assemble_layer(dst_configuration, plane, layer, loq, sizes[plane][loq].width, sizes[plane][loq].height,\par
00974                                        sizes[plane][loq].tiles_x, sizes[plane][loq].tiles_y, dimensions.tile_width(plane, loq),\par
00975                                        dimensions.tile_height(plane, loq), tiles);\par
00976                 \}\par
00977             \}\par
00978         \}\par
00979     \} {\cf19 else} \{\par
00980         {\cf18 int} idx = 0;\par
00981         {\cf19 for} ({\cf18 unsigned} plane = 0; plane < dst_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00982             {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00983                 {\cf19 for} ({\cf18 unsigned} layer = first_layer(dst_configuration); layer < total_layers(dst_configuration, plane, loq);\par
00984                      ++layer) \{\par
00985 \par
00986                     {\cf20 // Does any tile contain data?}\par
00987                     {\cf18 bool} any_tile_enabled = {\cf17 false};\par
00988                     {\cf19 for} ({\cf18 unsigned} x = 0; x < sizes[plane][loq].num_tiles; x++) \{\par
00989                         {\cf19 if} (entropy_enabled[idx + x]) \{\par
00990                             any_tile_enabled = {\cf17 true};\par
00991                             {\cf19 break};\par
00992                         \}\par
00993                     \}\par
00994 \par
00995                     Surface sz;\par
00996                     {\cf19 if} (any_tile_enabled) \{\par
00997                         {\cf20 // Decode sizes for this layer}\par
00998                         sz = EntropyDecoderSizes().process(sizes[plane][loq].num_tiles, 1, b, entropy_enabled, idx,\par
00999                                                            dst_configuration.global_configuration.compression_type_size_per_tile);\par
01000                     \} {\cf19 else} \{\par
01001                         sz = Surface::build_from<uint16_t>().fill(0, sizes[plane][loq].num_tiles, 1).finish();\par
01002                     \}\par
01003                     {\cf20 // Byte alignment}\par
01004 {\cf21 #if defined __OPT_MODULO__}\par
01005                     {\cf19 while} ((b.bit_offset() & 0x07))\par
01006 {\cf21 #else}\par
01007                     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
01008 {\cf21 #endif}\par
01009                         CHECK(b.u(1, {\cf22 "alignment"}) == 0);\par
01010 \par
01011                     {\cf17 const} {\cf17 auto} data_sizes = sz.view_as<uint16_t>();\par
01012 \par
01013                     std::vector<Surface> tiles;\par
01014 \par
01015                     {\cf19 for} ({\cf18 unsigned} ty = 0; ty < sizes[plane][loq].tiles_y; ++ty) \{\par
01016                         {\cf19 for} ({\cf18 unsigned} tx = 0; tx < sizes[plane][loq].tiles_x; ++tx) \{\par
01017                             {\cf20 // Where is tile going to go?}\par
01018                             {\cf17 const} {\cf18 unsigned} tx0 = tx * sizes[plane][loq].tile_width;\par
01019                             {\cf17 const} {\cf18 unsigned} ty0 = ty * sizes[plane][loq].tile_height;\par
01020                             {\cf17 const} {\cf18 unsigned} tx1 = LCEVC_MIN((tx + 1) * sizes[plane][loq].tile_width, sizes[plane][loq].width);\par
01021                             {\cf17 const} {\cf18 unsigned} ty1 = LCEVC_MIN((ty + 1) * sizes[plane][loq].tile_height, sizes[plane][loq].height);\par
01022 \par
01023                             Packet data;\par
01024                             {\cf19 if} (entropy_enabled[idx]) \{\par
01025                                 {\cf17 const} uint64_t data_size = data_sizes.read(ty * sizes[plane][loq].tiles_x + tx, 0);\par
01026                                 CHECK(data_size < INT_MAX && data_size > 0);\par
01027                                 data = b.bytes(({\cf18 unsigned})data_size);\par
01028                             \}\par
01029                             PacketView view(data);\par
01030                             BitstreamUnpacker pb(view);\par
01031                             tiles.push_back(decode_layer(dst_configuration, plane, loq, layer, tx1 - tx0, ty1 - ty0,\par
01032                                                          entropy_enabled[idx], rle_only[plane][loq][layer], pb));\par
01033                             idx++;\par
01034                         \}\par
01035                     \}\par
01036 \par
01037                     symbols[plane][loq][layer] =\par
01038                         assemble_layer(dst_configuration, plane, layer, loq, sizes[plane][loq].width, sizes[plane][loq].height,\par
01039                                        sizes[plane][loq].tiles_x, sizes[plane][loq].tiles_y, dimensions.tile_width(plane, loq),\par
01040                                        dimensions.tile_height(plane, loq), tiles);\par
01041                 \}\par
01042             \}\par
01043         \}\par
01044     \}\par
01045 \}\par
