00217 {\cf20 // Given the new temporal buffer, the previous temporal buffer and the signalling mask - generate the transmitted residuals}\par
00218 {\cf20 //}\par
00219 Surface TemporalSelect::process({\cf17 const} Surface &inter_plane, {\cf17 const} Surface &intra_plane, {\cf17 const} Surface &mask_plane) \{\par
00220 \par
00221     CHECK(inter_plane.width() == intra_plane.width() && inter_plane.height() == intra_plane.height());\par
00222 \par
00223     {\cf20 // Scale the mask to cover source images}\par
00224     {\cf17 const} {\cf18 unsigned} block_w = tile_size(mask_plane.width(), inter_plane.width());\par
00225     {\cf17 const} {\cf18 unsigned} block_h = tile_size(mask_plane.height(), inter_plane.height());\par
00226     {\cf17 const} {\cf18 unsigned} shift_w = log2(block_w);\par
00227     {\cf17 const} {\cf18 unsigned} shift_h = log2(block_h);\par
00228 \par
00229     {\cf17 const} {\cf17 auto} src_inter = inter_plane.view_as<int16_t>();\par
00230     {\cf17 const} {\cf17 auto} src_intra = intra_plane.view_as<int16_t>();\par
00231     {\cf17 const} {\cf17 auto} src_mask = mask_plane.view_as<uint8_t>();\par
00232 \par
00233     {\cf19 return} Surface::build_from<int16_t>()\par
00234         .generate(src_inter.width(), src_inter.height(),\par
00235                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00236                       if (src_mask.read(x >> shift_w, y >> shift_h) == TemporalType::TEMPORAL_PRED) \{\par
00237                           return src_inter.read(x, y);\par
00238                       \} {\cf19 else} \{\par
00239                           return src_intra.read(x, y);\par
00240                       \}\par
00241                   \})\par
00242         .finish();\par
00243 \}\par
00244 \par
00245 {\cf20 // Insert the single-bit-per-transform signalling as a mask}\par
00246 {\cf20 //}\par
00247 Surface TemporalInsertMask::process({\cf17 const} Surface &symbols, {\cf17 const} Surface &mask, {\cf17 const} {\cf18 bool} refresh) \{\par
00248     {\cf17 const} {\cf17 auto} src_symbols = symbols.view_as<int16_t>();\par
00249 \par
00250     {\cf19 if} (!mask.empty() && !refresh) \{\par
00251         CHECK(symbols.width() == mask.width() && symbols.height() == mask.height());\par
00252         {\cf17 const} {\cf17 auto} src_mask = mask.view_as<uint8_t>();\par
00253 \par
00254         {\cf19 return} Surface::build_from<int16_t>()\par
00255             .generate(src_symbols.width(), src_symbols.height(),\par
00256                       [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00257                           return (src_symbols.read(x, y) * 2) | (src_mask.read(x, y) == TemporalType::TEMPORAL_INTR ? 1 : 0);\par
00258                       \})\par
00259             .finish();\par
00260     \} {\cf19 else} \{\par
00261         {\cf19 return} Surface::build_from<int16_t>()\par
00262             .generate(src_symbols.width(), src_symbols.height(),\par
00263                       [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{ return (src_symbols.read(x, y) * 2); \})\par
00264             .finish();\par
00265     \}\par
00266 \}\par
00267 \par
00268 {\cf20 // Insert the user_data}\par
00269 {\cf20 //}\par
00270 Surface UserDataInsert::process({\cf17 const} Surface &symbols, UserDataMethod method, UserDataMode user_data, FILE* file) \{\par
00271     {\cf18 unsigned} size;\par
00272     {\cf19 switch} (user_data) \{\par
00273     {\cf19 case} UserData_2bits:\par
00274         size = 2;\par
00275         {\cf19 break};\par
00276     {\cf19 case} UserData_6bits:\par
00277         size = 6;\par
00278         {\cf19 break};\par
00279     {\cf19 default}:\par
00280         CHECK(0);\par
00281     \}\par
00282 \par
00283     {\cf17 const} {\cf17 auto} src_symbols = symbols.view_as<int16_t>();\par
00284     {\cf19 return} Surface::build_from<int16_t>()\par
00285         .generate(src_symbols.width(), src_symbols.height(),\par
00286                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00287                       int16_t value = src_symbols.read(x, y);\par
00288                       const bool sign = value < 0;\par
00289                       uint16_t value_abs = std::min((uint16_t)abs(value), (uint16_t)(((uint16_t)0x1fff) >> (size + 1)));\par
00290                       unsigned char data;\par
00291                       switch (method) \{\par
00292                       case UserDataMethod_Zeros:\par
00293                           data = 0x00;\par
00294                           break;\par
00295                       case UserDataMethod_Ones:\par
00296                           data = 0xff;\par
00297                           break;\par
00298                       case UserDataMethod_FixedRandom:\par
00299                       case UserDataMethod_Random:\par
00300                           data = Random().rand();\par
00301                           break;\par
00302                       default:\par
00303                           CHECK(0);\par
00304                       \}\par
00305                       data &= (size == 6 ? 0x3f : 0x03);\par
00306 {\cf21 #if USER_DATA_EXTRACTION}\par
00307                       fwrite(&data, 1, 1, file);\par
00308 {\cf21 #endif}\par
00309                       {\cf19 return} (int16_t)(((value_abs << (size + 1)) | data) | (sign << size));\par
00310                   \})\par
00311         .finish();\par
00312 \}\par
00313 \par
