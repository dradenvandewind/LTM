00049 {\cf20 // Generate cost for each block}\par
00050 {\cf20 //}\par
00051 Surface TemporalCost_2x2::process({\cf17 const} Surface &sour_plane, {\cf17 const} Surface &reco_plane, {\cf17 const} Surface *symb_plane,\par
00052                                   {\cf18 unsigned} transform_block_size, {\cf18 unsigned} scale, {\cf18 bool} intra) \{\par
00053 \par
00054     CHECK(sour_plane.width() == reco_plane.width() && sour_plane.height() == reco_plane.height());\par
00055     CHECK(sour_plane.width() == symb_plane[0].width() * transform_block_size &&\par
00056           sour_plane.height() == symb_plane[0].height() * transform_block_size);\par
00057 \par
00058     {\cf17 const} {\cf17 auto} src = sour_plane.view_as<int16_t>();\par
00059     {\cf17 const} {\cf17 auto} recon = reco_plane.view_as<int16_t>();\par
00060     {\cf17 const} {\cf17 auto} symb00 = symb_plane[0].view_as<int16_t>();\par
00061     {\cf17 const} {\cf17 auto} symb01 = symb_plane[1].view_as<int16_t>();\par
00062     {\cf17 const} {\cf17 auto} symb02 = symb_plane[2].view_as<int16_t>();\par
00063     {\cf17 const} {\cf17 auto} symb03 = symb_plane[3].view_as<int16_t>();\par
00064 \par
00065     {\cf17 const} {\cf18 unsigned} dst_width = src.width() / transform_block_size;\par
00066     {\cf17 const} {\cf18 unsigned} dst_height = src.height() / transform_block_size;\par
00067     {\cf17 const} {\cf18 float}    lambda     = ((float)(scale) *0.6f);\par
00068 \par
00069     {\cf19 return} Surface::build_from<int16_t>()\par
00070         .generate(dst_width, dst_height,\par
00071                   [&]({\cf18 unsigned} block_x, {\cf18 unsigned} block_y) -> int16_t \{\par
00072                       {\cf20 // SAD term}\par
00073                       int32_t t0 = 0;\par
00074                       {\cf19 for} ({\cf18 unsigned} {\cf18 int} x = (block_x)*transform_block_size; x < (block_x + 1) * transform_block_size; ++x) \{\par
00075                           {\cf19 for} ({\cf18 unsigned} {\cf18 int} y = (block_y)*transform_block_size; y < (block_y + 1) * transform_block_size; ++y) \{\par
00076                               t0 += abs(src.read(x, y) - recon.read(x, y));\par
00077                           \}\par
00078                       \}\par
00079 \par
00080                       {\cf20 // non zero coefficients term}\par
00081                       int32_t t1 = 0;\par
00082                       t1 = (symb00.read(block_x, block_y) ? 1 : 0) + (intra ? 1 : (symb01.read(block_x, block_y) ? 1 : 0)) +\par
00083                            (symb02.read(block_x, block_y) ? 1 : 0) + (symb03.read(block_x, block_y) ? 1 : 0);\par
00084 \par
00085                       {\cf20 // Intra signalling term}\par
00086                       int32_t t2 = 0;\par
00087 \par
00088                       {\cf18 float} fCost = (float)(t0 + (lambda  * (t1 + t2)));\par
00089                       int32_t iCost = (fCost < ((1 << 15) - 1) ? (int)fCost : ((1 << 15) - 1));\par
00090                       {\cf19 return} (int16_t)(iCost);\par
00091                   \})\par
00092         .finish();\par
00093 \}\par
00094 \par
00095 Surface TemporalCost_4x4::process({\cf17 const} Surface &sour_plane, {\cf17 const} Surface &reco_plane, {\cf17 const} Surface *symb_plane,\par
00096                                   {\cf18 unsigned} transform_block_size, {\cf18 unsigned} scale, {\cf18 bool} intra) \{\par
00097 \par
00098     CHECK(sour_plane.width() == reco_plane.width() && sour_plane.height() == reco_plane.height());\par
00099     CHECK(sour_plane.width() == symb_plane[0].width() * transform_block_size &&\par
00100           sour_plane.height() == symb_plane[0].height() * transform_block_size);\par
00101 \par
00102     {\cf17 const} {\cf17 auto} src = sour_plane.view_as<int16_t>();\par
00103     {\cf17 const} {\cf17 auto} recon = reco_plane.view_as<int16_t>();\par
00104     {\cf17 const} {\cf17 auto} symb00 = symb_plane[0].view_as<int16_t>();\par
00105     {\cf17 const} {\cf17 auto} symb01 = symb_plane[1].view_as<int16_t>();\par
00106     {\cf17 const} {\cf17 auto} symb02 = symb_plane[2].view_as<int16_t>();\par
00107     {\cf17 const} {\cf17 auto} symb03 = symb_plane[3].view_as<int16_t>();\par
00108     {\cf17 const} {\cf17 auto} symb04 = symb_plane[4].view_as<int16_t>();\par
00109     {\cf17 const} {\cf17 auto} symb05 = symb_plane[5].view_as<int16_t>();\par
00110     {\cf17 const} {\cf17 auto} symb06 = symb_plane[6].view_as<int16_t>();\par
00111     {\cf17 const} {\cf17 auto} symb07 = symb_plane[7].view_as<int16_t>();\par
00112     {\cf17 const} {\cf17 auto} symb08 = symb_plane[8].view_as<int16_t>();\par
00113     {\cf17 const} {\cf17 auto} symb09 = symb_plane[9].view_as<int16_t>();\par
00114     {\cf17 const} {\cf17 auto} symb10 = symb_plane[10].view_as<int16_t>();\par
00115     {\cf17 const} {\cf17 auto} symb11 = symb_plane[11].view_as<int16_t>();\par
00116     {\cf17 const} {\cf17 auto} symb12 = symb_plane[12].view_as<int16_t>();\par
00117     {\cf17 const} {\cf17 auto} symb13 = symb_plane[13].view_as<int16_t>();\par
00118     {\cf17 const} {\cf17 auto} symb14 = symb_plane[14].view_as<int16_t>();\par
00119     {\cf17 const} {\cf17 auto} symb15 = symb_plane[15].view_as<int16_t>();\par
00120 \par
00121     {\cf17 const} {\cf18 unsigned} dst_width = src.width() / transform_block_size;\par
00122     {\cf17 const} {\cf18 unsigned} dst_height = src.height() / transform_block_size;\par
00123 \par
00124     {\cf19 return} Surface::build_from<int16_t>()\par
00125         .generate(dst_width, dst_height,\par
00126                   [&]({\cf18 unsigned} block_x, {\cf18 unsigned} block_y) -> int16_t \{\par
00127                       {\cf20 // SAD term}\par
00128                       int32_t t0 = 0;\par
00129                       {\cf19 for} ({\cf18 unsigned} {\cf18 int} x = (block_x)*transform_block_size; x < (block_x + 1) * transform_block_size; ++x) \{\par
00130                           {\cf19 for} ({\cf18 unsigned} {\cf18 int} y = (block_y)*transform_block_size; y < (block_y + 1) * transform_block_size; ++y) \{\par
00131                               t0 += abs(src.read(x, y) - recon.read(x, y));\par
00132                           \}\par
00133                       \}\par
00134 \par
00135                       {\cf20 // non zero residuals term}\par
00136                       int32_t t1 = 0;\par
00137                       t1 = (symb00.read(block_x, block_y) ? 1 : 0) + (symb01.read(block_x, block_y) ? 1 : 0) +\par
00138                            (symb02.read(block_x, block_y) ? 1 : 0) + (symb03.read(block_x, block_y) ? 1 : 0) +\par
00139                            (symb04.read(block_x, block_y) ? 1 : 0) + (intra ? 1 : (symb05.read(block_x, block_y) ? 1 : 0)) +\par
00140                            (symb06.read(block_x, block_y) ? 1 : 0) + (symb07.read(block_x, block_y) ? 1 : 0) +\par
00141                            (symb08.read(block_x, block_y) ? 1 : 0) + (symb09.read(block_x, block_y) ? 1 : 0) +\par
00142                            (symb10.read(block_x, block_y) ? 1 : 0) + (symb11.read(block_x, block_y) ? 1 : 0) +\par
00143                            (symb12.read(block_x, block_y) ? 1 : 0) + (symb13.read(block_x, block_y) ? 1 : 0) +\par
00144                            (symb14.read(block_x, block_y) ? 1 : 0) + (symb15.read(block_x, block_y) ? 1 : 0);\par
00145 \par
00146                       {\cf20 // Intra signalling term}\par
00147                       int32_t t2 = 0;\par
00148 \par
00149                       {\cf18 float} fCost = (float)(t0 + scale * (t1 + t2));\par
00150                       int32_t iCost = (fCost < ((1 << 15) - 1) ? (int)fCost : ((1 << 15) - 1));\par
00151                       {\cf19 return} (int16_t)(iCost);\par
00152                   \})\par
00153         .finish();\par
00154 \}\par
00155 \par
00156 {\cf20 // Calculate temporal cost solely based on SAD, used for no_enhancement part}\par
00157 Surface TemporalCost_SAD::process({\cf17 const} Surface &sour_plane, {\cf17 const} Surface &reco_plane, {\cf18 unsigned} transform_block_size) \{\par
00158     {\cf17 const} {\cf18 unsigned} dst_width = sour_plane.width() / transform_block_size;\par
00159     {\cf17 const} {\cf18 unsigned} dst_height = sour_plane.height() / transform_block_size;\par
00160 \par
00161     {\cf19 if} (!reco_plane.empty()) \{\par
00162         {\cf20 // SAD}\par
00163         CHECK(sour_plane.width() == reco_plane.width() && sour_plane.height() == reco_plane.height());\par
00164         {\cf17 const} {\cf17 auto} src = sour_plane.view_as<int16_t>();\par
00165         {\cf17 const} {\cf17 auto} recon = reco_plane.view_as<int16_t>();\par
00166         {\cf19 return} Surface::build_from<int16_t>()\par
00167             .generate(dst_width, dst_height,\par
00168                       [&]({\cf18 unsigned} block_x, {\cf18 unsigned} block_y) -> int16_t \{\par
00169                           {\cf20 // SAD term}\par
00170                           int32_t t0 = 0;\par
00171                           {\cf19 for} ({\cf18 unsigned} {\cf18 int} x = (block_x)*transform_block_size; x < (block_x + 1) * transform_block_size; ++x) \{\par
00172                               {\cf19 for} ({\cf18 unsigned} {\cf18 int} y = (block_y)*transform_block_size; y < (block_y + 1) * transform_block_size; ++y) \{\par
00173                                   t0 += abs(src.read(x, y) - recon.read(x, y));\par
00174                               \}\par
00175                           \}\par
00176                           int32_t iCost = (t0 < ((1 << 15) - 1) ? (int)t0 : ((1 << 15) - 1));\par
00177                           {\cf19 return} (int16_t)(iCost);\par
00178                       \})\par
00179             .finish();\par
00180     \} {\cf19 else} {\cf19 if} (sour_plane.bpp() == 1) \{\par
00181         {\cf20 // Sum of absolute values (uint8_t)}\par
00182         {\cf17 const} {\cf17 auto} src = sour_plane.view_as<uint8_t>();\par
00183         {\cf19 return} Surface::build_from<int16_t>()\par
00184             .generate(dst_width, dst_height,\par
00185                       [&]({\cf18 unsigned} block_x, {\cf18 unsigned} block_y) -> int16_t \{\par
00186                           {\cf20 // SAD term}\par
00187                           int32_t t0 = 0;\par
00188                           {\cf19 for} ({\cf18 unsigned} {\cf18 int} x = (block_x)*transform_block_size; x < (block_x + 1) * transform_block_size; ++x) \{\par
00189                               {\cf19 for} ({\cf18 unsigned} {\cf18 int} y = (block_y)*transform_block_size; y < (block_y + 1) * transform_block_size; ++y) \{\par
00190                                   t0 += abs(src.read(x, y));\par
00191                               \}\par
00192                           \}\par
00193                           int32_t iCost = (t0 < ((1 << 15) - 1) ? (int)t0 : ((1 << 15) - 1));\par
00194                           {\cf19 return} (int16_t)(iCost);\par
00195                       \})\par
00196             .finish();\par
00197     \} {\cf19 else} \{\par
00198         {\cf20 // Sum of absolute values (uint16_t)}\par
00199         {\cf17 const} {\cf17 auto} src = sour_plane.view_as<uint16_t>();\par
00200         {\cf19 return} Surface::build_from<int16_t>()\par
00201             .generate(dst_width, dst_height,\par
00202                       [&]({\cf18 unsigned} block_x, {\cf18 unsigned} block_y) -> int16_t \{\par
00203                           {\cf20 // SAD term}\par
00204                           int32_t t0 = 0;\par
00205                           {\cf19 for} ({\cf18 unsigned} {\cf18 int} x = (block_x)*transform_block_size; x < (block_x + 1) * transform_block_size; ++x) \{\par
00206                               {\cf19 for} ({\cf18 unsigned} {\cf18 int} y = (block_y)*transform_block_size; y < (block_y + 1) * transform_block_size; ++y) \{\par
00207                                   t0 += abs(src.read(x, y));\par
00208                               \}\par
00209                           \}\par
00210                           int32_t iCost = (t0 < ((1 << 15) - 1) ? (int)t0 : ((1 << 15) - 1));\par
00211                           {\cf19 return} (int16_t)(iCost);\par
00212                       \})\par
00213             .finish();\par
00214     \}\par
00215 \}\par
