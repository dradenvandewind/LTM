00307 {\cf17 static} {\cf18 void} imgb_conv_16b_to_8b(EVC_IMGB * imgb_dst, EVC_IMGB * imgb_src,\par
00308                                 {\cf18 int} shift)\par
00309 \{\par
00310 \par
00311     {\cf18 int} i, j, k, t0, add;\par
00312 \par
00313     {\cf18 short}         * s;\par
00314     {\cf18 unsigned} {\cf18 char} * d;\par
00315 \par
00316     add = 1 << (shift - 1);\par
00317 \par
00318     {\cf19 for}(i = 0; i < 3; i++)\par
00319     \{\par
00320         s = imgb_src->a[i];\par
00321         d = imgb_dst->a[i];\par
00322 \par
00323         {\cf19 for}(j = 0; j < imgb_src->h[i]; j++)\par
00324         \{\par
00325             {\cf19 for}(k = 0; k < imgb_src->w[i]; k++)\par
00326             \{\par
00327                 t0 = ((s[k] + add) >> shift);\par
00328                 d[k] = ({\cf18 unsigned} char)(IFVCA_CLIP(t0, 0, 255));\par
00329 \par
00330             \}\par
00331             s = ({\cf18 short}*)((({\cf18 unsigned} {\cf18 char} *)s) + imgb_src->s[i]);\par
00332             d = d + imgb_dst->s[i];\par
00333         \}\par
00334     \}\par
00335 \}\par
