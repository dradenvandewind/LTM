00282 {\cf17 static} {\cf18 void} imgb_conv_8b_to_16b(EVC_IMGB * imgb_dst, EVC_IMGB * imgb_src,\par
00283                                 {\cf18 int} shift)\par
00284 \{\par
00285     {\cf18 int} i, j, k;\par
00286 \par
00287     {\cf18 unsigned} {\cf18 char} * s;\par
00288     {\cf18 short}         * d;\par
00289 \par
00290     {\cf19 for}(i = 0; i < 3; i++)\par
00291     \{\par
00292         s = imgb_src->a[i];\par
00293         d = imgb_dst->a[i];\par
00294 \par
00295         {\cf19 for}(j = 0; j < imgb_src->h[i]; j++)\par
00296         \{\par
00297             {\cf19 for}(k = 0; k < imgb_src->w[i]; k++)\par
00298             \{\par
00299                 d[k] = (short)(s[k] << shift);\par
00300             \}\par
00301             s = s + imgb_src->s[i];\par
00302             d = ({\cf18 short}*)((({\cf18 unsigned} {\cf18 char} *)d) + imgb_dst->s[i]);\par
00303         \}\par
00304     \}\par
00305 \}\par
