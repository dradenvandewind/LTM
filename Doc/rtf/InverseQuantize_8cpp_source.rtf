00131 int32_t find_dirq_step_width(int32_t orig_step_width, int32_t quant_matrix_coeff) \{\par
00132     int64_t dirq_step_width_64 = quant_matrix_coeff;\par
00133     dirq_step_width_64 = (dirq_step_width_64 * orig_step_width) + (1 << 16);\par
00134     dirq_step_width_64 = clamp(dirq_step_width_64, (int64_t)0, (int64_t)(3 << 16));\par
00135     dirq_step_width_64 = (dirq_step_width_64 * orig_step_width) >> 16;\par
