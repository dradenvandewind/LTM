00083                 d = default_qm_coefficient_4x4[0]; {\cf20 // LOQ2 1D}\par
00084             {\cf19 else}\par
00085                 d = default_qm_coefficient_4x4[1]; {\cf20 // LOQ2 2D}\par
00086         \}\par
00087     \}\par
00088 \par
00089     {\cf19 switch} (picture_configuration.quant_matrix_mode) \{\par
00090     {\cf19 case} QuantMatrix_BothPrevious:\par
00091         {\cf19 if} (is_idr)\par
00092             {\cf19 return} (int32_t)d[layer];\par
00093         {\cf19 else}\par
00094             {\cf19 return} (previous == -1) ? (int32_t)d[layer] : previous;\par
00095 \par
00096     {\cf19 case} QuantMatrix_BothDefault:\par
00097         {\cf19 return} (int32_t)d[layer];\par
00098 \par
00099     {\cf19 case} QuantMatrix_SameAndCustom:\par
00100         {\cf19 return} picture_configuration.qm_coefficient_2[layer];\par
00101 \par
00102     {\cf19 case} QuantMatrix_Level2CustomLevel1Default:\par
00103         {\cf19 if} (loq == LOQ_LEVEL_2)\par
00104             {\cf19 return} picture_configuration.qm_coefficient_2[layer];\par
00105         {\cf19 else}\par
00106             {\cf19 return} d[layer];\par
00107 \par
