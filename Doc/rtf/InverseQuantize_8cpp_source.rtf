00063 int32_t find_quant_matrix_coeff({\cf17 const} PictureConfiguration &picture_configuration, {\cf18 unsigned} num_layers, {\cf18 bool} horizontal_only,\par
00064                                 {\cf18 unsigned} loq, {\cf18 unsigned} layer, {\cf18 bool} is_idr, int32_t previous) \{\par
00065 \par
00066     {\cf17 const} uint8_t *d = {\cf17 nullptr};\par
00067     {\cf19 if} (num_layers == 4) \{\par
00068         {\cf20 // 2x2 case}\par
00069         {\cf19 if} (loq == LOQ_LEVEL_1) \{\par
00070             d = default_qm_coefficient_2x2[2]; {\cf20 // LOQ1}\par
00071         \} {\cf19 else} \{\par
00072             {\cf19 if} (horizontal_only)\par
00073                 d = default_qm_coefficient_2x2[0]; {\cf20 // LOQ2 1D}\par
00074             {\cf19 else}\par
00075                 d = default_qm_coefficient_2x2[1]; {\cf20 // LOQ2 2D}\par
00076         \}\par
00077     \} {\cf19 else} \{\par
00078         {\cf20 // 4x4 case}\par
00079         {\cf19 if} (loq == LOQ_LEVEL_1) \{\par
