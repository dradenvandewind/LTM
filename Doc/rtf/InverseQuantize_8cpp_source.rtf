00176         int64_t modi_step_width = (int64_t)(Dconst - Cconst * log(dirq_step_width));\par
00177         modi_step_width = (modi_step_width * dirq_step_width * dirq_step_width);\par
00178 {\cf21 #if defined __OPT_DIVISION__}\par
