00046 {\cf17 namespace }vtm \{\par
00047 \par
00048 {\cf17 static} {\cf17 constexpr} {\cf18 int}     PROB_BITS   = 15;   {\cf20 // Nominal number of bits to represent probabilities}\par
00049 {\cf17 static} {\cf17 constexpr} {\cf18 int}     PROB_BITS_0 = 10;   {\cf20 // Number of bits to represent 1st estimate}\par
00050 {\cf17 static} {\cf17 constexpr} {\cf18 int}     PROB_BITS_1 = 14;   {\cf20 // Number of bits to represent 2nd estimate}\par
00051 {\cf17 static} {\cf17 constexpr} {\cf18 int}     MASK_0      = ~(~0u << PROB_BITS_0) << (PROB_BITS - PROB_BITS_0);\par
00052 {\cf17 static} {\cf17 constexpr} {\cf18 int}     MASK_1      = ~(~0u << PROB_BITS_1) << (PROB_BITS - PROB_BITS_1);\par
00053 {\cf17 static} {\cf17 constexpr} uint8_t DWS         = 8;   {\cf20 // 0x47 Default window sizes}\par
00054 \par
00055 {\cf17 struct }BinFracBits\par
00056 \{\par
00057   uint32_t intBits[2];\par
00058 \};\par
00059 \par
00060 \par
00061 {\cf17 enum} BPMType\par
00062 \{\par
00063   BPM_Undefined = 0,\par
00064   BPM_Std,\par
00065   BPM_NUM\par
00066 \};\par
00067 \par
00068 {\cf17 class }ProbModelTables\par
00069 \{\par
00070 {\cf17 protected}:\par
00071   {\cf17 static} {\cf17 const} BinFracBits m_binFracBits[256];\par
00072   {\cf17 static} {\cf17 const} uint8_t      m_RenormTable_32  [ 32];          {\cf20 // Std         MP   MPI}\par
00073 \};\par
00074 \par
00075 \par
00076 \par
00077 {\cf17 class }BinProbModelBase : {\cf17 public} ProbModelTables\par
00078 \{\par
00079 {\cf17 public}:\par
00080   BinProbModelBase () \{\}\par
00081   ~BinProbModelBase() \{\}\par
00082   {\cf17 static} uint32_t estFracBitsEP ()                    \{ {\cf19 return}  (       1 << SCALE_BITS ); \}\par
00083   {\cf17 static} uint32_t estFracBitsEP ( {\cf18 unsigned} numBins )  \{ {\cf19 return}  ( numBins << SCALE_BITS ); \}\par
00084 \};\par
00085 \par
00086 \par
00087 \par
00088 \par
00089 {\cf17 class }BinProbModel_Std : {\cf17 public} BinProbModelBase\par
00090 \{\par
00091 {\cf17 public}:\par
00092   BinProbModel_Std()\par
00093   \{\par
00094     uint16_t half = 1 << (PROB_BITS - 1);\par
00095     m_state[0]    = half;\par
00096     m_state[1]    = half;\par
00097     m_rate        = DWS;\par
00098   \}\par
00099   ~BinProbModel_Std ()                \{\}\par
00100 {\cf17 public}:\par
00101   {\cf18 void}            init              ( {\cf18 int} qp, {\cf18 int} initId );\par
00102   {\cf18 void} update({\cf18 unsigned} bin)\par
00103   \{\par
00104     {\cf18 int} rate0 = m_rate >> 4;\par
00105     {\cf18 int} rate1 = m_rate & 15;\par
00106 \par
00107     m_state[0] -= (m_state[0] >> rate0) & MASK_0;\par
00108     m_state[1] -= (m_state[1] >> rate1) & MASK_1;\par
00109     {\cf19 if} (bin)\par
00110     \{\par
00111       m_state[0] += (0x7fffu >> rate0) & MASK_0;\par
00112       m_state[1] += (0x7fffu >> rate1) & MASK_1;\par
00113     \}\par
00114   \}\par
00115   {\cf18 void} setLog2WindowSize(uint8_t log2WindowSize)\par
00116   \{\par
00117     {\cf18 int} rate0 = 2 + ((log2WindowSize >> 2) & 3);\par
00118     {\cf18 int} rate1 = 3 + rate0 + (log2WindowSize & 3);\par
00119     m_rate    = 16 * rate0 + rate1;\par
00120     CHECK(rate1 > 9, {\cf22 "Second window size is too large!"});\par
00121   \}\par
00122   {\cf18 void} estFracBitsUpdate({\cf18 unsigned} bin, uint64_t &b)\par
00123   \{\par
00124     b += estFracBits(bin);\par
00125     update(bin);\par
00126   \}\par
00127   uint32_t        estFracBits({\cf18 unsigned} bin){\cf17  const }\{ {\cf19 return} getFracBitsArray().intBits[bin]; \}\par
00128   {\cf17 static} uint32_t estFracBitsTrm({\cf18 unsigned} bin) \{ {\cf19 return} (bin ? 0x3bfbb : 0x0010c); \}\par
00129   BinFracBits     getFracBitsArray(){\cf17  const }\{ {\cf19 return} m_binFracBits[state()]; \}\par
00130 {\cf17 public}:\par
00131   uint8_t state(){\cf17  const }\{ {\cf19 return} (m_state[0] + m_state[1]) >> 8; \}\par
00132   uint8_t mps(){\cf17  const }\{ {\cf19 return} state() >> 7; \}\par
00133   uint8_t getLPS({\cf18 unsigned} range){\cf17  const}\par
00134 {\cf17   }\{\par
00135     uint16_t q = state();\par
00136     {\cf19 if} (q & 0x80)\par
00137       q = q ^ 0xff;\par
00138     {\cf19 return} ((q >> 2) * (range >> 5) >> 1) + 4;\par
00139   \}\par
00140   {\cf17 static} uint8_t  getRenormBitsLPS  ( {\cf18 unsigned} LPS )                    \{ {\cf19 return}    m_RenormTable_32  [LPS>>3]; \}\par
00141   {\cf17 static} uint8_t  getRenormBitsRange( {\cf18 unsigned} range )                  \{ {\cf19 return}    1; \}\par
00142   uint16_t getState(){\cf17  const }\{ {\cf19 return} m_state[0] + m_state[1]; \}\par
00143   {\cf18 void}     setState(uint16_t pState)\par
00144   \{\par
