00912 {\cf17 template} <{\cf17 class} BinProbModel>\par
00913 {\cf18 void} CtxStore<BinProbModel>::init( {\cf18 int} qp, {\cf18 int} initId )\par
00914 \{\par
00915   {\cf17 const} std::vector<uint8_t>& initTable = ContextSetCfg::getInitTable( initId );\par
00916   CHECK( m_CtxBuffer.size() != initTable.size(),\par
00917         {\cf22 "Size of init table ("} << initTable.size() << {\cf22 ") does not match size of context buffer ("} << m_CtxBuffer.size() << {\cf22 ")."} );\par
00918   {\cf17 const} std::vector<uint8_t> &rateInitTable = ContextSetCfg::getInitTable(NUMBER_OF_SLICE_TYPES);\par
00919   CHECK(m_CtxBuffer.size() != rateInitTable.size(),\par
00920         {\cf22 "Size of rate init table ("} << rateInitTable.size() << {\cf22 ") does not match size of context buffer ("}\par
00921                                     << m_CtxBuffer.size() << {\cf22 ")."});\par
00922   {\cf18 int} clippedQP = Clip3( 0, MAX_QP, qp );\par
00923   {\cf19 for}( std::size_t k = 0; k < m_CtxBuffer.size(); k++ )\par
00924   \{\par
00925     m_CtxBuffer[k].init( clippedQP, initTable[k] );\par
00926     m_CtxBuffer[k].setLog2WindowSize(rateInitTable[k]);\par
00927   \}\par
00928 \}\par
