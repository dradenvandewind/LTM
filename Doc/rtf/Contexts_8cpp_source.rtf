00163 CtxSet ContextSetCfg::addCtxSet( std::initializer_list<std::initializer_list<uint8_t>> initSet2d )\par
00164 \{\par
00165   {\cf17 const} std::size_t startIdx  = sm_InitTables[0].size();\par
00166   {\cf17 const} std::size_t numValues = ( *initSet2d.begin() ).size();\par
00167         std::size_t setId     = 0;\par
00168   {\cf19 for}( {\cf17 auto} setIter = initSet2d.begin(); setIter != initSet2d.end() && setId < sm_InitTables.size(); setIter++, setId++ )\par
00169   \{\par
00170     {\cf17 const} std::initializer_list<uint8_t>& initSet   = *setIter;\par
00171     std::vector<uint8_t>&           initTable = sm_InitTables[setId];\par
00172     CHECK( initSet.size() != numValues,\par
00173            {\cf22 "Number of init values do not match for all sets ("} << initSet.size() << {\cf22 " != "} << numValues << {\cf22 ")."} );\par
00174     initTable.resize( startIdx + numValues );\par
00175     std::size_t elemId = startIdx;\par
00176     {\cf19 for}( {\cf17 auto} elemIter = ( *setIter ).begin(); elemIter != ( *setIter ).end(); elemIter++, elemId++ )\par
00177     \{\par
00178       initTable[elemId] = *elemIter;\par
00179     \}\par
00180   \}\par
00181   {\cf19 return} CtxSet( (uint16_t)startIdx, (uint16_t)numValues );\par
00182 \}\par
