00138 CtxSet::CtxSet( std::initializer_list<CtxSet> ctxSets )\par
00139 \{\par
00140   uint16_t  minOffset = std::numeric_limits<uint16_t>::max();\par
00141   uint16_t  maxOffset = 0;\par
00142   {\cf19 for}( {\cf17 auto} iter = ctxSets.begin(); iter != ctxSets.end(); iter++ )\par
00143   \{\par
00144     minOffset = std::min<uint16_t>( minOffset, (*iter).Offset              );\par
00145     maxOffset = std::max<uint16_t>( maxOffset, (*iter).Offset+(*iter).Size );\par
00146   \}\par
00147   Offset  = minOffset;\par
00148   Size    = maxOffset - minOffset;\par
00149 \}\par
