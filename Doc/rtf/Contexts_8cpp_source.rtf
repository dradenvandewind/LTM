00124 {\cf18 void} BinProbModel_Std::init( {\cf18 int} qp, {\cf18 int} initId )\par
00125 \{\par
00126   {\cf18 int} slope = (initId >> 3) - 4;\par
00127   {\cf18 int} offset = ((initId & 7) * 18) + 1;\par
00128   {\cf18 int} inistate = ((slope   * (qp - 16)) >> 1) + offset;\par
00129   {\cf18 int} state_clip = inistate < 1 ? 1 : inistate > 127 ? 127 : inistate;\par
00130   {\cf17 const} {\cf18 int} p1 = (state_clip << 8);\par
00131   m_state[0]   = p1 & MASK_0;\par
00132   m_state[1]   = p1 & MASK_1;\par
00133 \}\par
