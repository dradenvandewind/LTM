00155 {\cf17 const} std::vector<uint8_t>& ContextSetCfg::getInitTable( {\cf18 unsigned} initId )\par
00156 \{\par
00157   CHECK( initId >= ({\cf18 unsigned})sm_InitTables.size(),\par
00158          {\cf22 "Invalid initId ("} << initId << {\cf22 "), only "} << sm_InitTables.size() << {\cf22 " tables defined."} );\par
00159   {\cf19 return} sm_InitTables[initId];\par
00160 \}\par
