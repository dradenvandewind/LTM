00454 \par
00455       {\cf18 int} y;\par
00456       lfnstTemp = m_tempInMatrix;   {\cf20 // forward low frequency non-separable transform}\par
00457       coeffTemp = tempCoeff;\par
00458 \par
00459       {\cf19 if} (transposeFlag)\par
00460       \{\par
00461         {\cf19 if} (sbSize == 4)\par
00462         \{\par
00463           {\cf19 for} (y = 0; y < 4; y++)\par
00464           \{\par
00465             lfnstTemp[0]  = coeffTemp[0];\par
