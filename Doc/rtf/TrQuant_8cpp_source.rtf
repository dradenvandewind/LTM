00247 {\cf18 void} TrQuant::fwdLfnstNxN( TCoeff* src, TCoeff* dst, {\cf17 const} uint32_t mode, {\cf17 const} uint32_t index, {\cf17 const} uint32_t size, {\cf18 int} zeroOutSize )\par
00248 \{\par
00249   {\cf17 const} int8_t* trMat  = ( size > 4 ) ? g_lfnst8x8[ mode ][ index ][ 0 ] : g_lfnst4x4[ mode ][ index ][ 0 ];\par
00250   {\cf17 const} {\cf18 int}     trSize = ( size > 4 ) ? 48 : 16;\par
00251   TCoeff           coef;\par
00252   TCoeff*          out    = dst;\par
00253   assert( index < 3 );\par
00254 \par
00255   {\cf19 for}( {\cf18 int} j = 0; j < zeroOutSize; j++ )\par
00256   \{\par
00257     TCoeff*          srcPtr   = src;\par
00258     {\cf17 const} int8_t* trMatTmp = trMat;\par
00259     coef = 0;\par
00260     {\cf19 for}( {\cf18 int} i = 0; i < trSize; i++ )\par
00261     \{\par
00262       coef += *srcPtr++ * *trMatTmp++;\par
00263     \}\par
00264     *out++ = ( coef + 64 ) >> 7;\par
00265     trMat += trSize;\par
00266   \}\par
00267 \par
00268   std::fill_n( out, trSize - zeroOutSize, 0 );\par
00269 \}\par
00270 \par
00271 {\cf18 void} TrQuant::invLfnstNxN( TCoeff* src, TCoeff* dst, {\cf17 const} uint32_t mode, {\cf17 const} uint32_t index, {\cf17 const} uint32_t size, {\cf18 int} zeroOutSize, {\cf17 const} {\cf18 int} maxLog2TrDynamicRange )\par
00272 \{\par
00273   {\cf17 const} TCoeff    outputMinimum         = -( 1 << maxLog2TrDynamicRange );\par
00274   {\cf17 const} TCoeff    outputMaximum         =  ( 1 << maxLog2TrDynamicRange ) - 1;\par
00275   {\cf17 const} int8_t*   trMat                 =  ( size > 4 ) ? g_lfnst8x8[ mode ][ index ][ 0 ] : g_lfnst4x4[ mode ][ index ][ 0 ];\par
00276   {\cf17 const} {\cf18 int}       trSize                =  ( size > 4 ) ? 48 : 16;\par
00277   TCoeff          resi;\par
00278   TCoeff*         out                   =  dst;\par
00279   assert( index < 3 );\par
00280 \par
00281   {\cf19 for}( {\cf18 int} j = 0; j < trSize; j++ )\par
00282   \{\par
00283     resi = 0;\par
00284     {\cf17 const} int8_t* trMatTmp = trMat;\par
00285     TCoeff*       srcPtr   = src;\par
00286     {\cf19 for}( {\cf18 int} i = 0; i < zeroOutSize; i++ )\par
00287     \{\par
00288       resi += *srcPtr++ * *trMatTmp;\par
00289       trMatTmp += trSize;\par
00290     \}\par
00291     *out++ = Clip3<TCoeff>( outputMinimum, outputMaximum, ( resi + 64 ) >> 7 );\par
00292     trMat++;\par
00293   \}\par
00294 \}\par
