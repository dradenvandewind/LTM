00470             coeffTemp += width;\par
00471           \}\par
00472         \}\par
00473         {\cf19 else}   {\cf20 // ( sbSize == 8 )}\par
00474         \{\par
00475           {\cf19 for} (y = 0; y < 8; y++)\par
00476           \{\par
00477             lfnstTemp[0]  = coeffTemp[0];\par
00478             lfnstTemp[8]  = coeffTemp[1];\par
00479             lfnstTemp[16] = coeffTemp[2];\par
00480             lfnstTemp[24] = coeffTemp[3];\par
00481             {\cf19 if} (y < 4)\par
00482             \{\par
00483               lfnstTemp[32] = coeffTemp[4];\par
00484               lfnstTemp[36] = coeffTemp[5];\par
00485               lfnstTemp[40] = coeffTemp[6];\par
