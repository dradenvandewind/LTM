00421 {\cf18 void} TrQuant::xFwdLfnst( {\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID compID, {\cf17 const} {\cf18 bool} loadTr )\par
00422 \{\par
00423   {\cf17 const} CompArea& area     = tu.blocks[ compID ];\par
00424   {\cf17 const} uint32_t  width    = area.width;\par
00425   {\cf17 const} uint32_t  height   = area.height;\par
00426   {\cf17 const} uint32_t  lfnstIdx = tu.cu->lfnstIdx;\par
00427   {\cf19 if}( lfnstIdx && tu.mtsIdx[compID] != MTS_SKIP && (tu.cu->isSepTree() ? {\cf17 true} : isLuma(compID)) )\par
00428   \{\par
00429     {\cf17 const} {\cf18 bool} whge3 = width >= 8 && height >= 8;\par
00430     {\cf17 const} ScanElement * scan = whge3 ? g_coefTopLeftDiagScan8x8[ gp_sizeIdxInfo->idxFrom( width ) ] : g_scanOrder[ SCAN_GROUPED_4x4 ][ SCAN_DIAG ][ gp_sizeIdxInfo->idxFrom( width ) ][ gp_sizeIdxInfo->idxFrom( height ) ];\par
