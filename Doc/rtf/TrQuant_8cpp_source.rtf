00904 {\cf18 void} TrQuant::transformNxN( TransformUnit& tu, {\cf17 const} ComponentID& compID, {\cf17 const} QpParam& cQP, std::vector<TrMode>* trModes, {\cf17 const} {\cf18 int} maxCand )\par
00905 \{\par
00906         CodingStructure &cs = *tu.cs;\par
00907   {\cf17 const} CompArea &rect      = tu.blocks[compID];\par
00908   {\cf17 const} uint32_t width      = rect.width;\par
00909   {\cf17 const} uint32_t height     = rect.height;\par
00910 \par
00911   {\cf17 const} CPelBuf  resiBuf    = cs.getResiBuf(rect);\par
00912 \par
00913   CHECK( cs.sps->getMaxTbSize() < width, {\cf22 "Unsupported transformation size"} );\par
00914 \par
00915   {\cf18 int} pos = 0;\par
00916   std::vector<TrCost> trCosts;\par
00917   std::vector<TrMode>::iterator it = trModes->begin();\par
00918   {\cf17 const} {\cf18 double} facBB[] = \{ 1.2, 1.3, 1.3, 1.4, 1.5 \};\par
00919   {\cf19 while}( it != trModes->end() )\par
00920   \{\par
00921     tu.mtsIdx[compID] = it->first;\par
00922     CoeffBuf tempCoeff( m_mtsCoeffs[tu.mtsIdx[compID]], rect);\par
00923     {\cf19 if}( tu.noResidual )\par
00924     \{\par
00925       {\cf18 int} sumAbs = 0;\par
00926       trCosts.push_back( TrCost( sumAbs, pos++ ) );\par
00927       it++;\par
00928       {\cf19 continue};\par
00929     \}\par
00930 \par
00931     {\cf19 if} ( tu.mtsIdx[compID] == MTS_SKIP )\par
00932     \{\par
00933       xTransformSkip( tu, compID, resiBuf, tempCoeff.buf );\par
00934     \}\par
00935     {\cf19 else}\par
00936     \{\par
00937       xT( tu, compID, resiBuf, tempCoeff, width, height );\par
00938     \}\par
00939 \par
00940     TCoeff sumAbs = 0;\par
00941     {\cf19 for}( {\cf18 int} pos = 0; pos < width*height; pos++ )\par
00942     \{\par
00943       sumAbs += abs( tempCoeff.buf[pos] );\par
00944     \}\par
00945 \par
00946     {\cf18 double} scaleSAD=1.0;\par
00947     {\cf19 if} ( tu.mtsIdx[compID] == MTS_SKIP && ((floorLog2(width) + floorLog2(height)) & 1) == 1)\par
00948     \{\par
00949       scaleSAD=1.0/1.414213562; {\cf20 // compensate for not scaling transform skip coefficients by 1/sqrt(2)}\par
00950     \}\par
00951     {\cf19 if} (tu.mtsIdx[compID] == MTS_SKIP)\par
00952     \{\par
00953       {\cf18 int} trShift = getTransformShift(tu.cu->slice->getSPS()->getBitDepth(toChannelType(compID)), rect.size(),\par
00954                                       tu.cu->slice->getSPS()->getMaxLog2TrDynamicRange(toChannelType(compID)));\par
00955       scaleSAD *= pow(2, trShift);\par
00956     \}\par
00957 \par
00958     trCosts.push_back( TrCost( {\cf18 int}(std::min<double>(sumAbs*scaleSAD, std::numeric_limits<int>::max())), pos++ ) );\par
00959     it++;\par
00960   \}\par
00961 \par
00962   {\cf18 int} numTests = 0;\par
00963   std::vector<TrCost>::iterator itC = trCosts.begin();\par
00964   {\cf17 const} {\cf18 double} fac   = facBB[std::max(0, floorLog2(std::max(width, height)) - 2)];\par
00965   {\cf17 const} {\cf18 double} thr   = fac * trCosts.begin()->first;\par
00966   {\cf17 const} {\cf18 double} thrTS = trCosts.begin()->first;\par
00967   {\cf19 while}( itC != trCosts.end() )\par
00968   \{\par
00969     {\cf17 const} {\cf18 bool} testTr = itC->first <= ( itC->second == 1 ? thrTS : thr ) && numTests <= maxCand;\par
00970     trModes->at( itC->second ).second = testTr;\par
00971     numTests += testTr;\par
00972     itC++;\par
00973   \}\par
00974 \}\par
00975 \par
00976 {\cf18 void} TrQuant::transformNxN( TransformUnit& tu, {\cf17 const} ComponentID& compID, {\cf17 const} QpParam& cQP, TCoeff& uiAbsSum, {\cf17 const} Ctx& ctx, {\cf17 const} {\cf18 bool} loadTr )\par
00977 \{\par
00978         CodingStructure &cs = *tu.cs;\par
00979   {\cf17 const} SPS &sps            = *cs.sps;\par
00980   {\cf17 const} CompArea &rect      = tu.blocks[compID];\par
00981   {\cf17 const} uint32_t uiWidth        = rect.width;\par
00982   {\cf17 const} uint32_t uiHeight       = rect.height;\par
00983 \par
00984   {\cf17 const} CPelBuf resiBuf     = cs.getResiBuf(rect);\par
00985 \par
00986   {\cf19 if}( tu.noResidual )\par
00987   \{\par
00988     uiAbsSum = 0;\par
00989     TU::setCbfAtDepth( tu, compID, tu.depth, uiAbsSum > 0 );\par
00990     {\cf19 return};\par
00991   \}\par
00992 \par
00993   {\cf19 if} ((tu.cu->bdpcmMode && isLuma(compID)) || (!isLuma(compID) && tu.cu->bdpcmModeChroma))\par
00994   \{\par
00995     tu.mtsIdx[compID] = MTS_SKIP;\par
00996   \}\par
00997 \par
00998   uiAbsSum = 0;\par
00999 \par
01000   {\cf20 // transform and quantize}\par
01001   CHECK(cs.sps->getMaxTbSize() < uiWidth, {\cf22 "Unsupported transformation size"});\par
01002 \par
01003   CoeffBuf tempCoeff(loadTr ? m_mtsCoeffs[tu.mtsIdx[compID]] : m_tempCoeff, rect);\par
01004 \par
01005   DTRACE_PEL_BUF(D_RESIDUALS, resiBuf, tu, tu.cu->predMode, compID);\par
01006 \par
01007   {\cf19 if} (!loadTr)\par
01008   \{\par
01009     {\cf19 if} (tu.mtsIdx[compID] == MTS_SKIP)\par
01010     \{\par
01011       xTransformSkip(tu, compID, resiBuf, tempCoeff.buf);\par
01012     \}\par
01013     {\cf19 else}\par
01014     \{\par
01015       xT(tu, compID, resiBuf, tempCoeff, uiWidth, uiHeight);\par
01016     \}\par
01017   \}\par
01018 \par
01019   {\cf19 if} (sps.getUseLFNST())\par
01020   \{\par
01021     xFwdLfnst(tu, compID, loadTr);\par
01022   \}\par
01023 \par
01024   DTRACE_COEFF_BUF(D_TCOEFF, tempCoeff, tu, tu.cu->predMode, compID);\par
01025 \par
01026   xQuant(tu, compID, tempCoeff, uiAbsSum, cQP, ctx);\par
01027 \par
01028   DTRACE_COEFF_BUF(D_TCOEFF, tu.getCoeffs(compID), tu, tu.cu->predMode, compID);\par
01029 \par
01030   {\cf20 // set coded block flag (CBF)}\par
01031   TU::setCbfAtDepth (tu, compID, tu.depth, uiAbsSum > 0);\par
01032 \}\par
01033 \par
01034 \par
01035 {\cf18 void} TrQuant::xTransformSkip({\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CPelBuf &resi, TCoeff* psCoeff)\par
01036 \{\par
01037   {\cf17 const} CompArea &rect = tu.blocks[compID];\par
01038   {\cf17 const} uint32_t width = rect.width;\par
01039   {\cf17 const} uint32_t height = rect.height;\par
01040 \par
01041   {\cf19 for} (uint32_t y = 0, coefficientIndex = 0; y < height; y++)\par
01042   \{\par
01043     {\cf19 for} (uint32_t x = 0; x < width; x++, coefficientIndex++)\par
01044     \{\par
01045       psCoeff[coefficientIndex] = TCoeff(resi.at(x, y));\par
01046     \}\par
01047   \}\par
01048 \}\par
01049 \par
}
