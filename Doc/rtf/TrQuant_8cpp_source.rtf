00438     \{\par
00439       intraMode = PLANAR_IDX;\par
00440     \}\par
00441     CHECK( intraMode >= NUM_INTRA_MODE - 1, {\cf22 "Invalid intra mode"} );\par
00442 \par
00443     {\cf19 if}( lfnstIdx < 3 )\par
00444     \{\par
00445       intraMode = getLFNSTIntraMode( PU::getWideAngle( tu, intraMode, compID ) );\par
00446 \par
00447       {\cf18 bool}            transposeFlag   = getTransposeFlag( intraMode );\par
00448       {\cf17 const} {\cf18 int}       sbSize          = whge3 ? 8 : 4;\par
00449       {\cf18 bool}            tu4x4Flag       = ( width == 4 && height == 4 );\par
