00730 {\cf18 void} TrQuant::xT( {\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CPelBuf &resi, CoeffBuf &dstCoeff, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height )\par
00731 \{\par
00732   {\cf17 const} {\cf18 unsigned} maxLog2TrDynamicRange  = tu.cs->sps->getMaxLog2TrDynamicRange( toChannelType( compID ) );\par
00733   {\cf17 const} {\cf18 unsigned} bitDepth               = tu.cs->sps->getBitDepth(              toChannelType( compID ) );\par
00734   {\cf17 const} {\cf18 int}      TRANSFORM_MATRIX_SHIFT = g_transformMatrixShift[TRANSFORM_FORWARD];\par
00735   {\cf17 const} uint32_t transformWidthIndex    = floorLog2(width ) - 1;  {\cf20 // nLog2WidthMinus1, since transform start from 2-point}\par
00736   {\cf17 const} uint32_t transformHeightIndex   = floorLog2(height) - 1;  {\cf20 // nLog2HeightMinus1, since transform start from 2-point}\par
00737 \par
00738   {\cf18 int} trTypeHor = DCT2;\par
00739   {\cf18 int} trTypeVer = DCT2;\par
00740 \par
00741   getTrTypes ( tu, compID, trTypeHor, trTypeVer );\par
00742 \par
00743   {\cf18 int}  skipWidth  = ( trTypeHor != DCT2 && width  == 32 ) ? 16 : width  > JVET_C0024_ZERO_OUT_TH ? width  - JVET_C0024_ZERO_OUT_TH : 0;\par
00744   {\cf18 int}  skipHeight = ( trTypeVer != DCT2 && height == 32 ) ? 16 : height > JVET_C0024_ZERO_OUT_TH ? height - JVET_C0024_ZERO_OUT_TH : 0;\par
00745   {\cf19 if}( tu.cs->sps->getUseLFNST() && tu.cu->lfnstIdx )\par
00746   \{\par
00747     {\cf19 if}( (width == 4 && height > 4) || (width > 4 && height == 4) )\par
00748     \{\par
00749       skipWidth  = width  - 4;\par
00750       skipHeight = height - 4;\par
00751     \}\par
00752     {\cf19 else} {\cf19 if}( (width >= 8 && height >= 8) )\par
00753     \{\par
00754       skipWidth  = width  - 8;\par
00755       skipHeight = height - 8;\par
00756     \}\par
00757   \}\par
00758 \par
00759 {\cf21 #if RExt__DECODER_DEBUG_TOOL_STATISTICS}\par
00760   {\cf19 if} ( trTypeHor != DCT2 )\par
00761   \{\par
00762     CodingStatistics::IncrementStatisticTool( CodingStatisticsClassType\{ STATS__TOOL_EMT, uint32_t( width ), uint32_t( height ), compID \} );\par
00763   \}\par
00764 {\cf21 #endif}\par
00765 \par
00766   ALIGN_DATA( MEMORY_ALIGN_DEF_SIZE, TCoeff block[MAX_TB_SIZEY * MAX_TB_SIZEY] );\par
00767 \par
00768   {\cf17 const} Pel *resiBuf    = resi.buf;\par
00769   {\cf17 const} {\cf18 int}  resiStride = resi.stride;\par
00770 \par
00771   {\cf19 for}( {\cf18 int} y = 0; y < height; y++ )\par
00772   \{\par
00773     {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00774     \{\par
00775       block[( y * width ) + x] = resiBuf[( y * resiStride ) + x];\par
00776     \}\par
00777   \}\par
00778 \par
00779   {\cf19 if}( width > 1 && height > 1 ) {\cf20 // 2-D transform}\par
00780   \{\par
00781     {\cf17 const} {\cf18 int}      shift_1st              = ((floorLog2(width )) + bitDepth + TRANSFORM_MATRIX_SHIFT) - maxLog2TrDynamicRange + COM16_C806_TRANS_PREC;\par
00782     {\cf17 const} {\cf18 int}      shift_2nd              =  (floorLog2(height))            + TRANSFORM_MATRIX_SHIFT                          + COM16_C806_TRANS_PREC;\par
00783     CHECK( shift_1st < 0, {\cf22 "Negative shift"} );\par
00784     CHECK( shift_2nd < 0, {\cf22 "Negative shift"} );\par
00785     TCoeff *tmp = (TCoeff *) alloca(width * height * {\cf17 sizeof}(TCoeff));\par
00786 \par
00787     fastFwdTrans[trTypeHor][transformWidthIndex](block, tmp, shift_1st, height, 0, skipWidth);\par
00788     fastFwdTrans[trTypeVer][transformHeightIndex](tmp, dstCoeff.buf, shift_2nd, width, skipWidth, skipHeight);\par
00789   \}\par
00790   {\cf19 else} {\cf19 if}( height == 1 ) {\cf20 //1-D horizontal transform}\par
00791   \{\par
00792     {\cf17 const} {\cf18 int}      shift              = ((floorLog2(width )) + bitDepth + TRANSFORM_MATRIX_SHIFT) - maxLog2TrDynamicRange + COM16_C806_TRANS_PREC;\par
00793     CHECK( shift < 0, {\cf22 "Negative shift"} );\par
00794     CHECKD( ( transformWidthIndex < 0 ), {\cf22 "There is a problem with the width."} );\par
00795     fastFwdTrans[trTypeHor][transformWidthIndex]( block, dstCoeff.buf, shift, 1, 0, skipWidth );\par
00796   \}\par
00797   {\cf19 else} {\cf20 //if (iWidth == 1) //1-D vertical transform}\par
00798   \{\par
00799     {\cf18 int} shift = ( ( floorLog2(height) ) + bitDepth + TRANSFORM_MATRIX_SHIFT ) - maxLog2TrDynamicRange + COM16_C806_TRANS_PREC;\par
00800     CHECK( shift < 0, {\cf22 "Negative shift"} );\par
00801     CHECKD( ( transformHeightIndex < 0 ), {\cf22 "There is a problem with the height."} );\par
00802     fastFwdTrans[trTypeVer][transformHeightIndex]( block, dstCoeff.buf, shift, 1, 0, skipHeight );\par
00803   \}\par
00804 \}\par
