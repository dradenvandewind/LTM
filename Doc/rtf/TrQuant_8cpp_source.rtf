00322 {\cf18 void} TrQuant::xInvLfnst( {\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID compID )\par
00323 \{\par
00324   {\cf17 const} {\cf18 int} maxLog2TrDynamicRange = tu.cs->sps->getMaxLog2TrDynamicRange(toChannelType(compID));\par
00325   {\cf17 const} CompArea& area     = tu.blocks[ compID ];\par
00326   {\cf17 const} uint32_t  width    = area.width;\par
00327   {\cf17 const} uint32_t  height   = area.height;\par
00328   {\cf17 const} uint32_t  lfnstIdx = tu.cu->lfnstIdx;\par
00329   {\cf19 if}( lfnstIdx && tu.mtsIdx[compID] != MTS_SKIP && (tu.cu->isSepTree() ? {\cf17 true} : isLuma(compID)) )\par
00330   \{\par
00331     {\cf17 const} {\cf18 bool} whge3 = width >= 8 && height >= 8;\par
00332     {\cf17 const} ScanElement * scan = whge3 ? g_coefTopLeftDiagScan8x8[ gp_sizeIdxInfo->idxFrom( width ) ] : g_scanOrder[ SCAN_GROUPED_4x4 ][ SCAN_DIAG ][ gp_sizeIdxInfo->idxFrom( width ) ][ gp_sizeIdxInfo->idxFrom( height ) ];\par
00333     uint32_t intraMode = PU::getFinalIntraMode( *tu.cs->getPU( area.pos(), toChannelType( compID ) ), toChannelType( compID ) );\par
00334 \par
00335     {\cf19 if}( PU::isLMCMode( tu.cs->getPU( area.pos(), toChannelType( compID ) )->intraDir[ toChannelType( compID ) ] ) )\par
00336     \{\par
00337       intraMode = PU::getCoLocatedIntraLumaMode( *tu.cs->getPU( area.pos(), toChannelType( compID ) ) );\par
00338     \}\par
00339     {\cf19 if} (PU::isMIP(*tu.cs->getPU(area.pos(), toChannelType(compID)), toChannelType(compID)))\par
00340     \{\par
00341       intraMode = PLANAR_IDX;\par
00342     \}\par
00343     CHECK( intraMode >= NUM_INTRA_MODE - 1, {\cf22 "Invalid intra mode"} );\par
00344 \par
00345     {\cf19 if}( lfnstIdx < 3 )\par
00346     \{\par
00347       intraMode = getLFNSTIntraMode( PU::getWideAngle( tu, intraMode, compID ) );\par
00348 {\cf21 #if RExt__DECODER_DEBUG_TOOL_STATISTICS}\par
00349       CodingStatistics::IncrementStatisticTool( CodingStatisticsClassType \{ STATS__TOOL_LFNST, width, height, compID \} );\par
00350 {\cf21 #endif}\par
00351       {\cf18 bool}          transposeFlag   = getTransposeFlag( intraMode );\par
00352       {\cf17 const} {\cf18 int}     sbSize          = whge3 ? 8 : 4;\par
00353       {\cf18 bool}          tu4x4Flag       = ( width == 4 && height == 4 );\par
00354       {\cf18 bool}          tu8x8Flag       = ( width == 8 && height == 8 );\par
00355       TCoeff*       lfnstTemp;\par
00356       TCoeff*       coeffTemp;\par
00357       {\cf18 int}           y;\par
00358       lfnstTemp   = m_tempInMatrix;   {\cf20 // inverse spectral rearrangement}\par
00359       coeffTemp   = m_tempCoeff;\par
00360       TCoeff *dst = lfnstTemp;\par
00361 \par
00362       {\cf17 const} ScanElement *scanPtr = scan;\par
00363       {\cf19 for} (y = 0; y < 16; y++)\par
00364       \{\par
00365         *dst++ = coeffTemp[scanPtr->idx];\par
00366         scanPtr++;\par
00367       \}\par
00368 \par
00369       invLfnstNxN(m_tempInMatrix, m_tempOutMatrix, g_lfnstLut[intraMode], lfnstIdx - 1, sbSize,\par
00370                   (tu4x4Flag || tu8x8Flag) ? 8 : 16, maxLog2TrDynamicRange);\par
00371       lfnstTemp = m_tempOutMatrix;   {\cf20 // inverse spectral rearrangement}\par
00372 \par
00373       {\cf19 if} (transposeFlag)\par
00374       \{\par
00375         {\cf19 if} (sbSize == 4)\par
00376         \{\par
00377           {\cf19 for} (y = 0; y < 4; y++)\par
00378           \{\par
00379             coeffTemp[0] = lfnstTemp[0];\par
00380             coeffTemp[1] = lfnstTemp[4];\par
00381             coeffTemp[2] = lfnstTemp[8];\par
00382             coeffTemp[3] = lfnstTemp[12];\par
00383             lfnstTemp++;\par
00384             coeffTemp += width;\par
00385           \}\par
00386         \}\par
00387         {\cf19 else}   {\cf20 // ( sbSize == 8 )}\par
00388         \{\par
00389           {\cf19 for} (y = 0; y < 8; y++)\par
00390           \{\par
00391             coeffTemp[0] = lfnstTemp[0];\par
00392             coeffTemp[1] = lfnstTemp[8];\par
00393             coeffTemp[2] = lfnstTemp[16];\par
00394             coeffTemp[3] = lfnstTemp[24];\par
00395             {\cf19 if} (y < 4)\par
00396             \{\par
00397               coeffTemp[4] = lfnstTemp[32];\par
00398               coeffTemp[5] = lfnstTemp[36];\par
00399               coeffTemp[6] = lfnstTemp[40];\par
00400               coeffTemp[7] = lfnstTemp[44];\par
00401             \}\par
00402             lfnstTemp++;\par
00403             coeffTemp += width;\par
00404           \}\par
00405         \}\par
00406       \}\par
00407       {\cf19 else}\par
00408       \{\par
00409         {\cf19 for} (y = 0; y < sbSize; y++)\par
00410         \{\par
00411           uint32_t uiStride = (y < 4) ? sbSize : 4;\par
00412           ::memcpy(coeffTemp, lfnstTemp, uiStride * {\cf17 sizeof}(TCoeff));\par
00413           lfnstTemp += uiStride;\par
00414           coeffTemp += width;\par
00415         \}\par
00416       \}\par
00417     \}\par
00418   \}\par
00419 \}\par
