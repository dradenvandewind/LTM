00806 {\cf18 void} TrQuant::xIT( {\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &pCoeff, PelBuf &pResidual )\par
00807 \{\par
00808   {\cf17 const} {\cf18 int}      width                  = pCoeff.width;\par
00809   {\cf17 const} {\cf18 int}      height                 = pCoeff.height;\par
00810   {\cf17 const} {\cf18 unsigned} maxLog2TrDynamicRange  = tu.cs->sps->getMaxLog2TrDynamicRange( toChannelType( compID ) );\par
00811   {\cf17 const} {\cf18 unsigned} bitDepth               = tu.cs->sps->getBitDepth(              toChannelType( compID ) );\par
00812   {\cf17 const} {\cf18 int}      TRANSFORM_MATRIX_SHIFT = g_transformMatrixShift[TRANSFORM_INVERSE];\par
00813   {\cf17 const} TCoeff   clipMinimum            = -( 1 << maxLog2TrDynamicRange );\par
00814   {\cf17 const} TCoeff   clipMaximum            =  ( 1 << maxLog2TrDynamicRange ) - 1;\par
00815   {\cf17 const} TCoeff   pelMinimum             = std::numeric_limits<Pel>::min();\par
00816   {\cf17 const} TCoeff   pelMaximum             = std::numeric_limits<Pel>::max();\par
00817   {\cf17 const} uint32_t transformWidthIndex    = floorLog2(width ) - 1;                                {\cf20 // nLog2WidthMinus1, since transform start from 2-point}\par
00818   {\cf17 const} uint32_t transformHeightIndex   = floorLog2(height) - 1;                                {\cf20 // nLog2HeightMinus1, since transform start from 2-point}\par
00819 \par
00820   {\cf18 int} trTypeHor = DCT2;\par
00821   {\cf18 int} trTypeVer = DCT2;\par
00822 \par
00823   getTrTypes ( tu, compID, trTypeHor, trTypeVer );\par
00824   {\cf18 int} skipWidth  = ( trTypeHor != DCT2 && width  == 32 ) ? 16 : width  > JVET_C0024_ZERO_OUT_TH ? width  - JVET_C0024_ZERO_OUT_TH : 0;\par
00825   {\cf18 int} skipHeight = ( trTypeVer != DCT2 && height == 32 ) ? 16 : height > JVET_C0024_ZERO_OUT_TH ? height - JVET_C0024_ZERO_OUT_TH : 0;\par
00826   {\cf19 if}( tu.cs->sps->getUseLFNST() && tu.cu->lfnstIdx )\par
00827   \{\par
00828     {\cf19 if}( (width == 4 && height > 4) || (width > 4 && height == 4) )\par
00829     \{\par
00830       skipWidth  = width  - 4;\par
00831       skipHeight = height - 4;\par
00832     \}\par
00833     {\cf19 else} {\cf19 if}( (width >= 8 && height >= 8) )\par
00834     \{\par
00835       skipWidth  = width  - 8;\par
00836       skipHeight = height - 8;\par
00837     \}\par
00838   \}\par
00839 \par
00840   TCoeff *block = ( TCoeff * ) alloca( width * height * {\cf17 sizeof}( TCoeff ) );\par
00841 \par
00842   {\cf19 if}( width > 1 && height > 1 ) {\cf20 //2-D transform}\par
00843   \{\par
00844     {\cf17 const} {\cf18 int}      shift_1st              =   TRANSFORM_MATRIX_SHIFT + 1 + COM16_C806_TRANS_PREC; {\cf20 // 1 has been added to shift_1st at the expense of shift_2nd}\par
00845     {\cf17 const} {\cf18 int}      shift_2nd              = ( TRANSFORM_MATRIX_SHIFT + maxLog2TrDynamicRange - 1 ) - bitDepth + COM16_C806_TRANS_PREC;\par
00846     CHECK( shift_1st < 0, {\cf22 "Negative shift"} );\par
00847     CHECK( shift_2nd < 0, {\cf22 "Negative shift"} );\par
00848     TCoeff *tmp = ( TCoeff * ) alloca( width * height * {\cf17 sizeof}( TCoeff ) );\par
00849     fastInvTrans[trTypeVer][transformHeightIndex](pCoeff.buf, tmp, shift_1st, width, skipWidth, skipHeight, clipMinimum, clipMaximum);\par
00850     fastInvTrans[trTypeHor][transformWidthIndex] (tmp,      block, shift_2nd, height,        0, skipWidth,  pelMinimum,  pelMaximum);\par
00851   \}\par
00852   {\cf19 else} {\cf19 if}( width == 1 ) {\cf20 //1-D vertical transform}\par
00853   \{\par
00854     {\cf18 int} shift = ( TRANSFORM_MATRIX_SHIFT + maxLog2TrDynamicRange - 1 ) - bitDepth + COM16_C806_TRANS_PREC;\par
00855     CHECK( shift < 0, {\cf22 "Negative shift"} );\par
00856     CHECK( ( transformHeightIndex < 0 ), {\cf22 "There is a problem with the height."} );\par
00857     fastInvTrans[trTypeVer][transformHeightIndex]( pCoeff.buf, block, shift + 1, 1, 0, skipHeight, pelMinimum, pelMaximum );\par
00858   \}\par
00859   {\cf19 else} {\cf20 //if(iHeight == 1) //1-D horizontal transform}\par
00860   \{\par
00861     {\cf17 const} {\cf18 int}      shift              = ( TRANSFORM_MATRIX_SHIFT + maxLog2TrDynamicRange - 1 ) - bitDepth + COM16_C806_TRANS_PREC;\par
00862     CHECK( shift < 0, {\cf22 "Negative shift"} );\par
00863     CHECK( ( transformWidthIndex < 0 ), {\cf22 "There is a problem with the width."} );\par
00864     fastInvTrans[trTypeHor][transformWidthIndex]( pCoeff.buf, block, shift + 1, 1, 0, skipWidth, pelMinimum, pelMaximum );\par
00865   \}\par
00866 \par
00867   Pel *resiBuf    = pResidual.buf;\par
00868   {\cf18 int}  resiStride = pResidual.stride;\par
00869 \par
00870   {\cf19 for}( {\cf18 int} y = 0; y < height; y++ )\par
00871   \{\par
00872     {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00873     \{\par
00874       resiBuf[( y * resiStride ) + x] = Pel( block[( y * width ) + x] );\par
00875     \}\par
00876   \}\par
00877 \}\par
