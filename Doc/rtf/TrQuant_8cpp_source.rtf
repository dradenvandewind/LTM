00084 {\cf17 static} {\cf17 inline} int64_t square( {\cf17 const} {\cf18 int} d ) \{ {\cf19 return} d * (int64_t)d; \}\par
00085 \par
00086 {\cf17 template}<{\cf18 int} {\cf18 signed}Mode> std::pair<int64_t,int64_t> fwdTransformCbCr( {\cf17 const} PelBuf &resCb, {\cf17 const} PelBuf &resCr, PelBuf& resC1, PelBuf& resC2 )\par
00087 \{\par
00088   {\cf17 const} Pel*  cb  = resCb.buf;\par
00089   {\cf17 const} Pel*  cr  = resCr.buf;\par
00090   Pel*        c1  = resC1.buf;\par
00091   Pel*        c2  = resC2.buf;\par
00092   int64_t     d1  = 0;\par
00093   int64_t     d2  = 0;\par
00094   {\cf19 for}( SizeType y = 0; y < resCb.height; y++, cb += resCb.stride, cr += resCr.stride, c1 += resC1.stride, c2 += resC2.stride )\par
00095   \{\par
00096     {\cf19 for}( SizeType x = 0; x < resCb.width; x++ )\par
00097     \{\par
00098       {\cf18 int} cbx = cb[x], crx = cr[x];\par
00099       {\cf19 if}      ( signedMode ==  1 )\par
00100       \{\par
00101         c1[x] = Pel( ( 4*cbx + 2*crx ) / 5 );\par
00102         d1   += square( cbx - c1[x] ) + square( crx - (c1[x]>>1) );\par
00103       \}\par
00104       {\cf19 else} {\cf19 if} ( signedMode == -1 )\par
00105       \{\par
00106         c1[x] = Pel( ( 4*cbx - 2*crx ) / 5 );\par
00107         d1   += square( cbx - c1[x] ) + square( crx - (-c1[x]>>1) );\par
00108       \}\par
00109       {\cf19 else} {\cf19 if} ( signedMode ==  2 )\par
00110       \{\par
00111         c1[x] = Pel( ( cbx + crx ) / 2 );\par
00112         d1   += square( cbx - c1[x] ) + square( crx - c1[x] );\par
00113       \}\par
00114       {\cf19 else} {\cf19 if} ( signedMode == -2 )\par
00115       \{\par
00116         c1[x] = Pel( ( cbx - crx ) / 2 );\par
00117         d1   += square( cbx - c1[x] ) + square( crx + c1[x] );\par
00118       \}\par
00119       {\cf19 else} {\cf19 if} ( signedMode ==  3 )\par
00120       \{\par
00121         c2[x] = Pel( ( 4*crx + 2*cbx ) / 5 );\par
00122         d1   += square( cbx - (c2[x]>>1) ) + square( crx - c2[x] );\par
00123       \}\par
00124       {\cf19 else} {\cf19 if} ( signedMode == -3 )\par
00125       \{\par
00126         c2[x] = Pel( ( 4*crx - 2*cbx ) / 5 );\par
00127         d1   += square( cbx - (-c2[x]>>1) ) + square( crx - c2[x] );\par
00128       \}\par
00129       {\cf19 else}\par
00130       \{\par
00131         d1   += square( cbx );\par
00132         d2   += square( crx );\par
00133       \}\par
00134     \}\par
00135   \}\par
00136   {\cf19 return} std::make_pair(d1,d2);\par
00137 \}\par
00138 \par
00139 {\cf17 template}<{\cf18 int} {\cf18 signed}Mode> {\cf18 void} invTransformCbCr( PelBuf &resCb, PelBuf &resCr )\par
00140 \{\par
00141   Pel*  cb  = resCb.buf;\par
00142   Pel*  cr  = resCr.buf;\par
00143   {\cf19 for}( SizeType y = 0; y < resCb.height; y++, cb += resCb.stride, cr += resCr.stride )\par
00144   \{\par
00145     {\cf19 for}( SizeType x = 0; x < resCb.width; x++ )\par
00146     \{\par
00147       {\cf19 if} (signedMode == 1)\par
00148       \{\par
00149         cr[x] = cb[x] >> 1;\par
00150       \}\par
00151       {\cf19 else} {\cf19 if} (signedMode == -1)\par
00152       \{\par
00153         cr[x] = -cb[x] >> 1;\par
00154       \}\par
00155       {\cf19 else} {\cf19 if} (signedMode == 2)\par
00156       \{\par
00157         cr[x] = cb[x];\par
00158       \}\par
00159       {\cf19 else} {\cf19 if} (signedMode == -2)\par
00160       \{\par
00161         {\cf20 // non-normative clipping to prevent 16-bit overflow}\par
00162         cr[x] = (cb[x] == -32768 && {\cf17 sizeof}(Pel) == 2) ? 32767 : -cb[x];\par
00163       \}\par
00164       {\cf19 else} {\cf19 if} (signedMode == 3)\par
00165       \{\par
00166         cb[x] = cr[x] >> 1;\par
00167       \}\par
00168       {\cf19 else} {\cf19 if} (signedMode == -3)\par
00169       \{\par
00170         cb[x] = -cr[x] >> 1;\par
00171       \}\par
00172     \}\par
00173   \}\par
00174 \}\par
