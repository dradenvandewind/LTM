00500           coeffTemp += width;\par
00501         \}\par
00502       \}\par
00503 \par
00504       fwdLfnstNxN(m_tempInMatrix, m_tempOutMatrix, g_lfnstLut[intraMode], lfnstIdx - 1, sbSize,\par
