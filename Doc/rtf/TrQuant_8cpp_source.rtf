00567 std::vector<int> TrQuant::selectICTCandidates( {\cf17 const} TransformUnit &tu, CompStorage* resCb, CompStorage* resCr )\par
00568 \{\par
00569   CHECK( !resCb[0].valid() || !resCr[0].valid(), {\cf22 "standard components are not valid"} );\par
00570 \par
00571   {\cf19 if}( !CU::isIntra( *tu.cu ) )\par
00572   \{\par
00573     {\cf18 int} cbfMask = 3;\par
00574     resCb[cbfMask].create( tu.blocks[COMPONENT_Cb] );\par
00575     resCr[cbfMask].create( tu.blocks[COMPONENT_Cr] );\par
00576     fwdTransformICT( tu, resCb[0], resCr[0], resCb[cbfMask], resCr[cbfMask], cbfMask );\par
00577     std::vector<int> cbfMasksToTest;\par
00578     cbfMasksToTest.push_back( cbfMask );\par
00579     {\cf19 return} cbfMasksToTest;\par
00580   \}\par
00581 \par
00582   std::pair<int64_t,int64_t> pairDist[4];\par
00583   {\cf19 for}( {\cf18 int} cbfMask = 0; cbfMask < 4; cbfMask++ )\par
00584   \{\par
00585     {\cf19 if}( cbfMask )\par
00586     \{\par
00587       CHECK( resCb[cbfMask].valid() || resCr[cbfMask].valid(), {\cf22 "target components for cbfMask="} << cbfMask << {\cf22 " are already present"} );\par
00588       resCb[cbfMask].create( tu.blocks[COMPONENT_Cb] );\par
00589       resCr[cbfMask].create( tu.blocks[COMPONENT_Cr] );\par
00590     \}\par
00591     pairDist[cbfMask] = fwdTransformICT( tu, resCb[0], resCr[0], resCb[cbfMask], resCr[cbfMask], cbfMask );\par
00592   \}\par
00593 \par
00594   std::vector<int> cbfMasksToTest;\par
00595   int64_t minDist1  = std::min<int64_t>( pairDist[0].first, pairDist[0].second );\par
00596   int64_t minDist2  = std::numeric_limits<int64_t>::max();\par
00597   {\cf18 int}     cbfMask1  = 0;\par
00598   {\cf18 int}     cbfMask2  = 0;\par
00599   {\cf19 for}( {\cf18 int} cbfMask : \{ 1, 2, 3 \} )\par
00600   \{\par
00601     {\cf19 if}( pairDist[cbfMask].first < minDist1 )\par
00602     \{\par
00603       cbfMask2  = cbfMask1; minDist2  = minDist1;\par
00604       cbfMask1  = cbfMask;  minDist1  = pairDist[cbfMask1].first;\par
00605     \}\par
00606     {\cf19 else} {\cf19 if}( pairDist[cbfMask].first < minDist2 )\par
00607     \{\par
00608       cbfMask2  = cbfMask;  minDist2  = pairDist[cbfMask2].first;\par
00609     \}\par
00610   \}\par
00611   {\cf19 if}( cbfMask1 )\par
00612   \{\par
00613     cbfMasksToTest.push_back( cbfMask1 );\par
00614   \}\par
00615   {\cf19 if}( cbfMask2 && ( ( minDist2 < (9*minDist1)/8 ) || ( !cbfMask1 && minDist2 < (3*minDist1)/2 ) ) )\par
00616   \{\par
00617     cbfMasksToTest.push_back( cbfMask2 );\par
00618   \}\par
00619 \par
00620   {\cf19 return} cbfMasksToTest;\par
00621 \}\par
00622 \par
