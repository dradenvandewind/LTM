00629 {\cf18 void} TrQuant::getTrTypes({\cf17 const} TransformUnit tu, {\cf17 const} ComponentID compID, {\cf18 int} &trTypeHor, {\cf18 int} &trTypeVer)\par
00630 \{\par
00631   {\cf17 const} {\cf18 bool} isExplicitMTS = (CU::isIntra(*tu.cu) ? tu.cs->sps->getUseIntraMTS() : tu.cs->sps->getUseInterMTS() && CU::isInter(*tu.cu)) && isLuma(compID);\par
00632   {\cf17 const} {\cf18 bool} isImplicitMTS = CU::isIntra(*tu.cu) && tu.cs->sps->getUseImplicitMTS() && isLuma(compID) && tu.cu->lfnstIdx == 0 && tu.cu->mipFlag == 0;\par
00633   {\cf17 const} {\cf18 bool} isISP = CU::isIntra(*tu.cu) && tu.cu->ispMode && isLuma(compID);\par
00634   {\cf17 const} {\cf18 bool} isSBT = CU::isInter(*tu.cu) && tu.cu->sbtInfo && isLuma(compID);\par
00635 \par
00636   trTypeHor = DCT2;\par
00637   trTypeVer = DCT2;\par
00638 \par
00639   {\cf19 if} (isISP && tu.cu->lfnstIdx)\par
00640   \{\par
00641     {\cf19 return};\par
00642   \}\par
00643 \par
00644   {\cf19 if} (!tu.cs->sps->getUseMTS())\par
00645   \{\par
00646     {\cf19 return};\par
00647   \}\par
00648 \par
00649   {\cf19 if} (isImplicitMTS || isISP)\par
00650   \{\par
00651     {\cf18 int}  width = tu.blocks[compID].width;\par
00652     {\cf18 int}  height = tu.blocks[compID].height;\par
00653     {\cf18 bool} widthDstOk = width >= 4 && width <= 16;\par
00654     {\cf18 bool} heightDstOk = height >= 4 && height <= 16;\par
00655 \par
00656     {\cf19 if} (widthDstOk)\par
00657     \{\par
00658       trTypeHor = DST7;\par
00659     \}\par
00660     {\cf19 if} (heightDstOk)\par
00661     \{\par
00662       trTypeVer = DST7;\par
00663     \}\par
00664     {\cf19 return};\par
00665   \}\par
00666 \par
00667 \par
00668   {\cf19 if} (isSBT)\par
00669   \{\par
00670     uint8_t sbtIdx = tu.cu->getSbtIdx();\par
00671     uint8_t sbtPos = tu.cu->getSbtPos();\par
00672 \par
00673     {\cf19 if}( sbtIdx == SBT_VER_HALF || sbtIdx == SBT_VER_QUAD )\par
00674     \{\par
00675       assert( tu.lwidth() <= MTS_INTER_MAX_CU_SIZE );\par
00676       {\cf19 if}( tu.lheight() > MTS_INTER_MAX_CU_SIZE )\par
00677       \{\par
00678         trTypeHor = trTypeVer = DCT2;\par
00679       \}\par
00680       {\cf19 else}\par
00681       \{\par
00682         {\cf19 if} (sbtPos == SBT_POS0)\par
00683         \{\par
00684           trTypeHor = DCT8;\par
00685           trTypeVer = DST7;\par
00686         \}\par
00687         {\cf19 else}\par
00688         \{\par
00689           trTypeHor = DST7;\par
00690           trTypeVer = DST7;\par
00691         \}\par
00692       \}\par
00693     \}\par
00694     {\cf19 else}\par
00695     \{\par
00696       assert( tu.lheight() <= MTS_INTER_MAX_CU_SIZE );\par
00697       {\cf19 if}( tu.lwidth() > MTS_INTER_MAX_CU_SIZE )\par
00698       \{\par
00699         trTypeHor = trTypeVer = DCT2;\par
00700       \}\par
00701       {\cf19 else}\par
00702       \{\par
00703         {\cf19 if} (sbtPos == SBT_POS0)\par
00704         \{\par
00705           trTypeHor = DST7;\par
00706           trTypeVer = DCT8;\par
00707         \}\par
00708         {\cf19 else}\par
00709         \{\par
00710           trTypeHor = DST7;\par
00711           trTypeVer = DST7;\par
00712         \}\par
00713       \}\par
00714     \}\par
00715     {\cf19 return};\par
00716   \}\par
00717 \par
00718   {\cf19 if} (isExplicitMTS)\par
00719   \{\par
00720     {\cf19 if} (tu.mtsIdx[compID] > MTS_SKIP)\par
00721     \{\par
00722       {\cf18 int} indHor = (tu.mtsIdx[compID] - MTS_DST7_DST7) & 1;\par
00723       {\cf18 int} indVer = (tu.mtsIdx[compID] - MTS_DST7_DST7) >> 1;\par
00724       trTypeHor = indHor ? DCT8 : DST7;\par
00725       trTypeVer = indVer ? DCT8 : DST7;\par
00726     \}\par
00727   \}\par
00728 \}\par
