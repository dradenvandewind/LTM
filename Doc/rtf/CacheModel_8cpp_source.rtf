00338 {\cf20 //-- PLRU}\par
00339 \par
00340 {\cf18 int} CacheModel::xGetWayTreePLRU( {\cf18 int} entry )\par
00341 \{\par
00342   {\cf18 int} shift  = 0;\par
00343   {\cf18 int} way    = 0;\par
00344   {\cf19 for} ( {\cf18 int} i = 0; i < m_treeDepth ; i++ )\par
00345   \{\par
00346     {\cf18 int} flag  = (m_treeStatus[ entry ] >> shift) & 0x1;\par
00347     shift = (shift << 1) + flag + 1;\par
00348     way   = (way << 1) | (flag ^ 0x1);\par
00349   \}\par
00350   xUpdateCacheStatus( entry, way );\par
00351 \par
00352   {\cf19 return} way;\par
00353 \}\par
00354 \par
00355 {\cf18 void} CacheModel::xUpdatePLRUStatus( {\cf18 int} entry, {\cf18 int} way )\par
00356 \{\par
00357   {\cf18 int} val   = m_treeStatus[ entry ];\par
00358   {\cf18 int} shift = 0;\par
00359 \par
00360   {\cf19 for} ( {\cf18 int} i = 0 ; i < m_treeDepth ; i++ )\par
00361   \{\par
00362     {\cf18 int} flag = (way >> (m_treeDepth - i - 1)) & 0x1;\par
00363     val = (val & (~0 ^ (1 << shift))) | (flag << shift); {\cf20 // only set shift-th bit}\par
00364     shift = (shift << 1) + 2 - flag;\par
00365   \}\par
00366 \par
00367   m_treeStatus[ entry ] = val;\par
00368 \}\par
00369 \par
00370 {\cf20 //-- other cache alg. (for future use)}\par
00371 \par
00372 {\cf20 // get update way based on each update algorithm (Now Tree PLRU only)}\par
00373 {\cf18 int} CacheModel::xGetWay( {\cf18 int} entry )\par
00374 \{\par
00375   {\cf20 // single way}\par
00376   {\cf19 if} ( m_numWay == 1 )\par
00377   \{\par
00378     {\cf19 return} 0;\par
00379   \}\par
00380   {\cf20 // multiway}\par
00381   {\cf19 return} xGetWayTreePLRU( entry );\par
00382 \}\par
