00436 {\cf20 // check cache hit/miss}\par
00437 {\cf18 void} CacheModel::cacheAccess( {\cf17 const} Pel *addr, {\cf17 const} std::string& fileName, {\cf17 const} {\cf18 int} lineNum )\par
00438 \{\par
00439   {\cf19 if} ( !m_cacheEnable || !m_cacheEnableFilter )\par
00440   \{\par
00441     {\cf19 return};\par
00442   \}\par
00443   {\cf18 bool} hit = {\cf17 false};\par
00444   {\cf18 size_t} cacheAddr = xMapAddress( ({\cf18 size_t}) (addr - m_base) ) >> m_shift;\par
00445   {\cf18 int}  entry = (int) (cacheAddr % m_numCacheLine);\par
00446   {\cf18 int}  pos   = entry * m_numWay;\par
00447   {\cf18 int}  way;\par
00448 \par
00449   {\cf20 // check cache hit in each way}\par
00450   {\cf19 for} ( way = 0 ; way < m_numWay ; way++ )\par
00451   \{\par
00452       {\cf19 if} ( xIsCacheHit( pos + way, cacheAddr ) ) \{\par
00453         hit = {\cf17 true};\par
00454         {\cf19 break};\par
00455       \}\par
00456   \}\par
00457 {\cf21 #if JVET_J0090_MEMORY_BANDWITH_MEASURE_PRINT_ACCESS_INFO}\par
00458   {\cf19 if} ( m_frameCount == JVET_J0090_MEMORY_BANDWITH_MEASURE_PRINT_FRAME )\par
00459   \{\par
00460     fprintf( stdout, {\cf22 "%s %d:%p\\n"}, fileName.c_str(), lineNum, addr );\par
00461   \}\par
00462 {\cf21 #endif}\par
00463 \par
00464   {\cf19 if} ( !hit )\par
00465   \{\par
00466     {\cf20 // read data from external memory}\par
00467     m_missHitCount++;\par
00468     {\cf20 // update cache entry}\par
00469     xUpdateCache( entry, cacheAddr );\par
00470   \}\par
00471   {\cf19 else}\par
00472   \{\par
00473     {\cf20 // update hit status}\par
00474     m_hitCount[ pos + way ] ++;\par
00475     xUpdateCacheStatus( entry, way );\par
00476   \}\par
00477   m_totalAccess++;\par
00478 \}\par
