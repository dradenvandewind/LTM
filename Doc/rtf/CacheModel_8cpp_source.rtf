00119 {\cf18 int} CacheModel::xCalcPower( {\cf18 int} num )\par
00120 \{\par
00121   {\cf18 int} power = -1;\par
00122 \par
00123   {\cf19 for} ( {\cf18 int} i = 0 ; i < 32 ; i++ )\par
00124   \{\par
00125     {\cf19 if} ( num == (1 << i) )\par
00126     \{\par
00127       power = i;\par
00128       {\cf19 break};\par
00129     \}\par
00130   \}\par
00131   {\cf19 if} (power < 0)\par
00132   \{\par
00133     THROW({\cf22 "non power of 2"});\par
00134   \}\par
00135   {\cf19 return} power;\par
00136 \}\par
