00138 {\cf18 void} CacheModel::xConfigure({\cf17 const} std::string& filename )\par
00139 \{\par
00140   po::Options opts;\par
00141   opts.addOptions()\par
00142   ({\cf22 "CacheEnable"},   m_cacheEnable,   {\cf17 false}, {\cf22 "Cache Enable"} )\par
00143   ({\cf22 "CacheLineSize"}, m_cacheLineSize,   128, {\cf22 "Cache line size"})\par
00144   ({\cf22 "NumCacheLine"},  m_numCacheLine,     32, {\cf22 "Number of cache line"})\par
00145   ({\cf22 "NumWay"},        m_numWay,            4, {\cf22 "Number of way"})\par
00146   ({\cf22 "CacheAddrMode"}, m_cacheAddrMode,     0, {\cf22 "Address mapping mode 0 : linear address 1 : 2D address"})\par
00147   ({\cf22 "BlkWidth"},      m_cacheBlkWidth,    32, {\cf22 "Block width in 2D address mode"})\par
00148   ({\cf22 "BlkHeight"},     m_cacheBlkHeight,   16, {\cf22 "Block height in 2D address mode"})\par
00149   ({\cf22 "FrameReport"},   m_frameReport,   {\cf17 false}, {\cf22 "Report in each frame"} )\par
00150   ;\par
00151 \par
00152   po::setDefaults(opts);\par
00153   po::parseConfigFile( opts, filename );\par
00154 \par
00155   {\cf19 if} ( m_cacheLineSize > CACHE_MEM_ALIGN_SIZE )\par
00156   \{\par
00157     fprintf( stderr, {\cf22 "cache line size is bigger that memory alignment\\n"} );\par
00158     fprintf( stderr, {\cf22 "This may lead mismatch among enviroments\\n"} );\par
00159   \}\par
00160   {\cf19 if} ( m_cacheAddrMode == CACHE_MODE_2D )\par
00161   \{\par
00162     {\cf18 int} blkSize = m_cacheBlkWidth * m_cacheBlkHeight;\par
