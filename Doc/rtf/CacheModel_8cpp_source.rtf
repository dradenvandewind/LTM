00384 {\cf20 // update cache entry}\par
00385 {\cf18 void} CacheModel::xUpdateCache( {\cf18 int} entry, {\cf18 size_t} addr )\par
00386 \{\par
00387   {\cf18 int} way = xGetWay( entry );\par
00388 \par
00389   {\cf19 if} (entry * m_numWay + way >= m_cacheSize || entry * m_numWay + way < 0)\par
00390   \{\par
00391     THROW({\cf22 "incorrect cache info"});\par
00392   \}\par
00393 \par
00394   m_cacheAddr[ entry * m_numWay + way ] = addr;\par
00395   m_cachePoc[ entry * m_numWay + way ]  = m_refPoc;\par
00396   m_cacheComp[ entry * m_numWay + way ] = m_compID;\par
00397   m_available[ entry * m_numWay + way ] = {\cf17 true};\par
00398 \par
00399 \}\par
00400 \par
00401 {\cf18 void} CacheModel::xUpdateCacheStatus( {\cf18 int} entry, {\cf18 int} way )\par
00402 \{\par
00403   {\cf19 if} ( m_numWay == 1 )\par
00404   \{\par
00405     {\cf19 return};\par
00406   \}\par
00407   xUpdatePLRUStatus( entry, way );\par
00408 \}\par
