00067 {\cf18 void}* cache_mem_align_malloc({\cf18 int} size, {\cf18 int} alignSize)\par
00068 \{\par
00069   {\cf18 unsigned} {\cf18 char} *alignBuf;\par
00070   {\cf18 unsigned} {\cf18 char} *buf = ({\cf18 unsigned} {\cf18 char} *)malloc(size + 2 * alignSize + {\cf17 sizeof}({\cf18 void} **));\par
00071   {\cf19 if} (buf)\par
00072   \{\par
00073     alignBuf = buf + alignSize + {\cf17 sizeof}({\cf18 void} **);\par
00074     alignBuf -= (intptr_t)alignBuf & (alignSize - 1);\par
00075     *(({\cf18 void} **)(alignBuf - {\cf17 sizeof}({\cf18 void} **))) = buf;\par
00076     {\cf19 return} alignBuf;\par
00077   \}\par
00078   {\cf19 return} {\cf17 nullptr}; {\cf20 // memory keep fail}\par
00079 \}\par
00080 \par
00081 {\cf18 void} cache_mem_align_free({\cf18 void} *ptr)\par
00082 \{\par
00083   {\cf19 if} ( ptr )\par
00084   \{\par
00085     free(*((({\cf18 void} **)ptr) - 1));\par
00086   \}\par
00087 \}\par
