00410 {\cf18 size_t} CacheModel::xMapAddress( {\cf18 size_t} offset ) \{\par
00411 \par
00412   {\cf18 size_t} ret;\par
00413   {\cf18 size_t} xInPic, yInPic, blkPosX, blkPosY, xInBlk, yInBlk;\par
00414 \par
00415   {\cf19 switch} ( m_cacheAddrMode ) \{\par
00416     {\cf19 case} CACHE_MODE_1D : {\cf20 // diret mapping}\par
00417       {\cf19 return} offset;\par
00418     {\cf19 case} CACHE_MODE_2D : {\cf20 // 2D address mapping}\par
00419       xInPic  = offset % m_picWidth;\par
00420       yInPic  = offset / m_picWidth;\par
00421       blkPosX = xInPic / m_cacheBlkWidth;\par
00422       blkPosY = yInPic / m_cacheBlkHeight;\par
00423       xInBlk  = xInPic % m_cacheBlkWidth;\par
00424       yInBlk  = yInPic % m_cacheBlkHeight;\par
00425       ret  = m_picWidth * blkPosY * m_cacheBlkHeight;\par
00426       ret += blkPosX * m_cacheBlkWidth * m_cacheBlkHeight;\par
00427       ret += yInBlk * m_cacheBlkWidth;\par
00428       ret += xInBlk;\par
00429       {\cf19 return} ret;\par
00430     default :\par
00431       THROW( {\cf22 "Unknown address mode "} << m_cacheAddrMode );\par
00432       {\cf19 return} 0;\par
00433   \}\par
00434 \}\par
