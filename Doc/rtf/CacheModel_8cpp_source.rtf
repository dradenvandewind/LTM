00318 {\cf18 bool} CacheModel::xIsCacheHit( {\cf18 int} pos, {\cf18 size_t} addr )\par
00319 \{\par
00320   {\cf18 bool} ret = {\cf17 false};\par
00321 \par
00322   {\cf19 if} ( m_available[pos] )\par
00323   \{\par
00324     {\cf19 if} ( addr == m_cacheAddr[pos] )\par
00325     \{\par
00326       {\cf19 if} ( m_refPoc == m_cachePoc[pos] )\par
00327       \{\par
00328         {\cf19 if} ( m_compID == m_cacheComp[pos] )\par
00329         \{\par
00330           ret = {\cf17 true};\par
00331         \}\par
00332       \}\par
00333     \}\par
00334   \}\par
00335   {\cf19 return} ret;\par
00336 \}\par
