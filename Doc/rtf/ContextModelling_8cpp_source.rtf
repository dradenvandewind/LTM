00556 {\cf18 unsigned} DeriveCtx::CtxMipFlag( {\cf17 const} CodingUnit& cu )\par
00557 \{\par
00558   {\cf17 const} CodingStructure *cs = cu.cs;\par
00559   {\cf18 unsigned} ctxId = 0;\par
00560 \par
00561   {\cf17 const} CodingUnit *cuLeft = cs->getCURestricted( cu.lumaPos().offset( -1, 0 ), cu, CH_L );\par
00562   ctxId = (cuLeft && cuLeft->mipFlag) ? 1 : 0;\par
00563 \par
00564   {\cf17 const} CodingUnit *cuAbove = cs->getCURestricted( cu.lumaPos().offset( 0, -1 ), cu, CH_L );\par
00565   ctxId += (cuAbove && cuAbove->mipFlag) ? 1 : 0;\par
00566 \par
00567   ctxId  = (cu.lwidth() > 2*cu.lheight() || cu.lheight() > 2*cu.lwidth()) ? 3 : ctxId;\par
00568 \par
00569   {\cf19 return} ctxId;\par
00570 \}\par
