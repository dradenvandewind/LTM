00502   \}\par
00503   {\cf19 else} {\cf19 if} (refList1 != -1)\par
00504   \{\par
00505     {\cf19 if} (fPosPosition == 0)\par
00506     \{\par
00507       tempMv[1] = Mv(offset, 0);\par
00508     \}\par
00509     {\cf19 else} {\cf19 if} (fPosPosition == 1)\par
00510     \{\par
00511       tempMv[1] = Mv(-offset, 0);\par
00512     \}\par
00513     {\cf19 else} {\cf19 if} (fPosPosition == 2)\par
00514     \{\par
00515       tempMv[1] = Mv(0, offset);\par
00516     \}\par
