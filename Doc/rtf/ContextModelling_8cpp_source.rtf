00540   pu.cu->imv = mmvdUseAltHpelIf[fPosBaseIdx] ? IMV_HPEL : 0;\par
00541 \par
00542   pu.cu->BcwIdx = (interDirNeighbours[fPosBaseIdx] == 3) ? BcwIdx[fPosBaseIdx] : BCW_DEFAULT;\par
00543 \par
00544   {\cf19 for} ({\cf18 int} refList = 0; refList < 2; refList++)\par
00545   \{\par
00546     {\cf19 if} (pu.refIdx[refList] >= 0)\par
00547     \{\par
00548       pu.mv[refList].clipToStorageBitDepth();\par
00549     \}\par
00550   \}\par
00551 \par
00552 \par
00553   PU::restrictBiPredMergeCandsOne(pu);\par
00554 \}\par
