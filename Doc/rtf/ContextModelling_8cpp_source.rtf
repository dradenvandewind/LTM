00498     pu.mv[REF_PIC_LIST_0] = mmvdBaseMv[fPosBaseIdx][0].mv + tempMv[0];\par
00499     pu.refIdx[REF_PIC_LIST_0] = refList0;\par
00500     pu.mv[REF_PIC_LIST_1] = Mv(0, 0);\par
