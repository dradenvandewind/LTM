00478   \}\par
00479   {\cf19 else} {\cf19 if} (refList0 != -1)\par
00480   \{\par
00481     {\cf19 if} (fPosPosition == 0)\par
00482     \{\par
00483       tempMv[0] = Mv(offset, 0);\par
00484     \}\par
00485     {\cf19 else} {\cf19 if} (fPosPosition == 1)\par
00486     \{\par
00487       tempMv[0] = Mv(-offset, 0);\par
00488     \}\par
00489     {\cf19 else} {\cf19 if} (fPosPosition == 2)\par
00490     \{\par
