00439       {\cf19 if} (isL0RefLongTerm || isL1RefLongTerm)\par
00440       \{\par
00441         {\cf19 if} ((poc1 - currPoc)*(poc0 - currPoc) > 0)\par
00442         \{\par
00443           tempMv[0] = tempMv[1];\par
00444         \}\par
00445         {\cf19 else}\par
00446         \{\par
00447           tempMv[0].set(-1 * tempMv[1].getHor(), -1 * tempMv[1].getVer());\par
00448         \}\par
00449       \}\par
00450       {\cf19 else}\par
00451       tempMv[0] = tempMv[1].scaleMv(scale);\par
00452     \}\par
00453     {\cf19 else}\par
00454     \{\par
00455       {\cf17 const} {\cf18 int} scale = PU::getDistScaleFactor(currPoc, poc1, currPoc, poc0);\par
00456       {\cf17 const} {\cf18 bool} isL0RefLongTerm = slice.getRefPic(REF_PIC_LIST_0, refList0)->longTerm;\par
00457       {\cf17 const} {\cf18 bool} isL1RefLongTerm = slice.getRefPic(REF_PIC_LIST_1, refList1)->longTerm;\par
00458       {\cf19 if} (isL0RefLongTerm || isL1RefLongTerm)\par
00459       \{\par
00460         {\cf19 if} ((poc1 - currPoc)*(poc0 - currPoc) > 0)\par
00461         \{\par
00462           tempMv[1] = tempMv[0];\par
00463         \}\par
00464         {\cf19 else}\par
00465         \{\par
00466           tempMv[1].set(-1 * tempMv[0].getHor(), -1 * tempMv[0].getVer());\par
00467         \}\par
00468       \}\par
00469       {\cf19 else}\par
00470       tempMv[1] = tempMv[0].scaleMv(scale);\par
00471     \}\par
00472 \par
00473     pu.interDir = 3;\par
00474     pu.mv[REF_PIC_LIST_0] = mmvdBaseMv[fPosBaseIdx][0].mv + tempMv[0];\par
