00045 CoeffCodingContext::CoeffCodingContext( {\cf17 const} TransformUnit& tu, ComponentID component, {\cf18 bool} signHide, {\cf18 bool} bdpcm )\par
00046   : m_compID                    (component)\par
00047   , m_chType                    (toChannelType(m_compID))\par
00048   , m_width                     (tu.block(m_compID).width)\par
00049   , m_height                    (tu.block(m_compID).height)\par
00050   , m_log2CGWidth               ( g_log2SbbSize[ floorLog2(m_width) ][ floorLog2(m_height) ][0] )\par
00051   , m_log2CGHeight              ( g_log2SbbSize[ floorLog2(m_width) ][ floorLog2(m_height) ][1] )\par
00052   , m_log2CGSize                (m_log2CGWidth + m_log2CGHeight)\par
00053   , m_widthInGroups(std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, m_width) >> m_log2CGWidth)\par
00054   , m_heightInGroups(std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, m_height) >> m_log2CGHeight)\par
00055   , m_log2BlockWidth            ((unsigned)floorLog2(m_width))\par
00056   , m_log2BlockHeight           ((unsigned)floorLog2(m_height))\par
00057   , m_maxNumCoeff               (m_width * m_height)\par
00058   , m_signHiding                (signHide)\par
00059   , m_extendedPrecision         (tu.cs->sps->getSpsRangeExtension().getExtendedPrecisionProcessingFlag())\par
00060   , m_maxLog2TrDynamicRange     (tu.cs->sps->getMaxLog2TrDynamicRange(m_chType))\par
00061   , m_scanType                  (SCAN_DIAG)\par
00062   , m_scan                      (g_scanOrder     [SCAN_GROUPED_4x4][m_scanType][gp_sizeIdxInfo->idxFrom(m_width        )][gp_sizeIdxInfo->idxFrom(m_height        )])\par
00063   , m_scanCG                    (g_scanOrder     [SCAN_UNGROUPED  ][m_scanType][gp_sizeIdxInfo->idxFrom(m_widthInGroups)][gp_sizeIdxInfo->idxFrom(m_heightInGroups)])\par
00064   , m_CtxSetLastX               (Ctx::LastX[m_chType])\par
00065   , m_CtxSetLastY               (Ctx::LastY[m_chType])\par
00066   , m_maxLastPosX(g_uiGroupIdx[std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, m_width) - 1])\par
00067   , m_maxLastPosY(g_uiGroupIdx[std::min<unsigned>(JVET_C0024_ZERO_OUT_TH, m_height) - 1])\par
00068   , m_lastOffsetX               (0)\par
00069   , m_lastOffsetY               (0)\par
00070   , m_lastShiftX                (0)\par
00071   , m_lastShiftY                (0)\par
00072   , m_TrafoBypass               (tu.cs->sps->getSpsRangeExtension().getTransformSkipContextEnabledFlag() && (tu.mtsIdx[m_compID] == MTS_SKIP))\par
00073   , m_minCoeff                  (-(1 << tu.cs->sps->getMaxLog2TrDynamicRange(m_chType)))\par
00074   , m_maxCoeff                  ((1 << tu.cs->sps->getMaxLog2TrDynamicRange(m_chType)) - 1)\par
00075   , m_scanPosLast               (-1)\par
00076   , m_subSetId                  (-1)\par
00077   , m_subSetPos                 (-1)\par
00078   , m_subSetPosX                (-1)\par
00079   , m_subSetPosY                (-1)\par
00080   , m_minSubPos                 (-1)\par
00081   , m_maxSubPos                 (-1)\par
00082   , m_sigGroupCtxId             (-1)\par
00083   , m_tmplCpSum1                (-1)\par
00084   , m_tmplCpDiag                (-1)\par
00085   , m_sigFlagCtxSet             \{ Ctx::SigFlag[m_chType], Ctx::SigFlag[m_chType+2], Ctx::SigFlag[m_chType+4] \}\par
00086   , m_parFlagCtxSet             ( Ctx::ParFlag[m_chType] )\par
00087   , m_gtxFlagCtxSet             \{ Ctx::GtxFlag[m_chType], Ctx::GtxFlag[m_chType+2] \}\par
00088   , m_sigGroupCtxIdTS           (-1)\par
00089   , m_tsSigFlagCtxSet           ( Ctx::TsSigFlag )\par
00090   , m_tsParFlagCtxSet           ( Ctx::TsParFlag )\par
00091   , m_tsGtxFlagCtxSet           ( Ctx::TsGtxFlag )\par
00092   , m_tsLrg1FlagCtxSet          (Ctx::TsLrg1Flag)\par
00093   , m_tsSignFlagCtxSet          (Ctx::TsResidualSign)\par
00094   , m_sigCoeffGroupFlag         ()\par
00095   , m_bdpcm                     (bdpcm)\par
00096 \{\par
00097   {\cf20 // LOGTODO}\par
00098   {\cf18 unsigned} log2sizeX = m_log2BlockWidth;\par
00099   {\cf18 unsigned} log2sizeY = m_log2BlockHeight;\par
00100   {\cf19 if} (m_chType == CHANNEL_TYPE_CHROMA)\par
00101   \{\par
00102     {\cf17 const_cast<}{\cf18 int}&{\cf17 >}(m_lastShiftX) = Clip3( 0, 2, {\cf18 int}( m_width  >> 3) );\par
00103     {\cf17 const_cast<}{\cf18 int}&{\cf17 >}(m_lastShiftY) = Clip3( 0, 2, {\cf18 int}( m_height >> 3) );\par
00104   \}\par
00105   {\cf19 else}\par
00106   \{\par
00107     {\cf17 static} {\cf17 const} {\cf18 int} prefix_ctx[8]  = \{ 0, 0, 0, 3, 6, 10, 15, 21 \};\par
00108     {\cf17 const_cast<}{\cf18 int}&{\cf17 >}(m_lastOffsetX) = prefix_ctx[ log2sizeX ];\par
00109     {\cf17 const_cast<}{\cf18 int}&{\cf17 >}(m_lastOffsetY) = prefix_ctx[ log2sizeY ];;\par
00110     {\cf17 const_cast<}{\cf18 int}&{\cf17 >}(m_lastShiftX)  = (log2sizeX + 1) >> 2;\par
