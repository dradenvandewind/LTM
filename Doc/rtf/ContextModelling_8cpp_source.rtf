00381 {\cf18 void} MergeCtx::setMmvdMergeCandiInfo(PredictionUnit& pu, {\cf18 int} candIdx)\par
00382 \{\par
00383   {\cf17 const} Slice &slice = *pu.cs->slice;\par
00384   {\cf17 const} {\cf18 int} mvShift = MV_FRACTIONAL_BITS_DIFF;\par
00385   {\cf17 const} {\cf18 int} refMvdCands[8] = \{ 1 << mvShift , 2 << mvShift , 4 << mvShift , 8 << mvShift , 16 << mvShift , 32 << mvShift,  64 << mvShift , 128 << mvShift \};\par
00386   {\cf18 int} fPosGroup = 0;\par
00387   {\cf18 int} fPosBaseIdx = 0;\par
00388   {\cf18 int} fPosStep = 0;\par
00389   {\cf18 int} tempIdx = 0;\par
00390   {\cf18 int} fPosPosition = 0;\par
00391   Mv tempMv[2];\par
00392 \par
00393   tempIdx = candIdx;\par
00394   fPosGroup = tempIdx / (MMVD_BASE_MV_NUM * MMVD_MAX_REFINE_NUM);\par
00395   tempIdx = tempIdx - fPosGroup * (MMVD_BASE_MV_NUM * MMVD_MAX_REFINE_NUM);\par
00396   fPosBaseIdx = tempIdx / MMVD_MAX_REFINE_NUM;\par
00397   tempIdx = tempIdx - fPosBaseIdx * (MMVD_MAX_REFINE_NUM);\par
00398   fPosStep = tempIdx / 4;\par
00399   fPosPosition = tempIdx - fPosStep * (4);\par
00400   {\cf18 int} offset = refMvdCands[fPosStep];\par
00401   {\cf19 if} ( pu.cu->slice->getPicHeader()->getDisFracMMVD() )\par
00402   \{\par
00403     offset <<= 2;\par
00404   \}\par
00405   {\cf17 const} {\cf18 int} refList0 = mmvdBaseMv[fPosBaseIdx][0].refIdx;\par
00406   {\cf17 const} {\cf18 int} refList1 = mmvdBaseMv[fPosBaseIdx][1].refIdx;\par
00407 \par
00408   {\cf19 if} ((refList0 != -1) && (refList1 != -1))\par
00409   \{\par
00410     {\cf17 const} {\cf18 int} poc0 = slice.getRefPOC(REF_PIC_LIST_0, refList0);\par
00411     {\cf17 const} {\cf18 int} poc1 = slice.getRefPOC(REF_PIC_LIST_1, refList1);\par
00412     {\cf17 const} {\cf18 int} currPoc = slice.getPOC();\par
00413     {\cf19 if} (fPosPosition == 0)\par
00414     \{\par
00415       tempMv[0] = Mv(offset, 0);\par
00416     \}\par
00417     {\cf19 else} {\cf19 if} (fPosPosition == 1)\par
00418     \{\par
00419       tempMv[0] = Mv(-offset, 0);\par
00420     \}\par
00421     {\cf19 else} {\cf19 if} (fPosPosition == 2)\par
00422     \{\par
00423       tempMv[0] = Mv(0, offset);\par
00424     \}\par
00425     {\cf19 else}\par
00426     \{\par
00427       tempMv[0] = Mv(0, -offset);\par
00428     \}\par
00429     {\cf19 if} ((poc0 - currPoc) == (poc1 - currPoc))\par
00430     \{\par
00431       tempMv[1] = tempMv[0];\par
00432     \}\par
00433     {\cf19 else} {\cf19 if} (abs(poc1 - currPoc) > abs(poc0 - currPoc))\par
00434     \{\par
00435       {\cf17 const} {\cf18 int} scale = PU::getDistScaleFactor(currPoc, poc0, currPoc, poc1);\par
00436       tempMv[1] = tempMv[0];\par
