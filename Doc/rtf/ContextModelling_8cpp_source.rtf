00153 {\cf18 void} DeriveCtx::CtxSplit( {\cf17 const} CodingStructure& cs, Partitioner& partitioner, {\cf18 unsigned}& ctxSpl, {\cf18 unsigned}& ctxQt, {\cf18 unsigned}& ctxHv, {\cf18 unsigned}& ctxHorBt, {\cf18 unsigned}& ctxVerBt, {\cf18 bool}* _canSplit {\cf20 /*= nullptr */} )\par
00154 \{\par
00155   {\cf17 const} Position pos         = partitioner.currArea().blocks[partitioner.chType];\par
00156   {\cf17 const} {\cf18 unsigned} curSliceIdx = cs.slice->getIndependentSliceIdx();\par
00157   {\cf17 const} {\cf18 unsigned} curTileIdx  = cs.pps->getTileIdx( partitioner.currArea().lumaPos() );\par
00158 \par
00159   {\cf20 // get left depth}\par
00160   {\cf17 const} CodingUnit* cuLeft = cs.getCURestricted( pos.offset( -1, 0 ), pos, curSliceIdx, curTileIdx, partitioner.chType );\par
00161 \par
00162   {\cf20 // get above depth}\par
00163   {\cf17 const} CodingUnit* cuAbove = cs.getCURestricted( pos.offset( 0, -1 ), pos, curSliceIdx, curTileIdx, partitioner.chType );\par
00164 \par
00165   {\cf18 bool} canSplit[6];\par
00166 \par
00167   {\cf19 if}( _canSplit == {\cf17 nullptr} )\par
00168   \{\par
00169     partitioner.canSplit( cs, canSplit[0], canSplit[1], canSplit[2], canSplit[3], canSplit[4], canSplit[5] );\par
00170   \}\par
00171   {\cf19 else}\par
00172   \{\par
00173     memcpy( canSplit, _canSplit, 6 * {\cf17 sizeof}( {\cf18 bool} ) );\par
00174   \}\par
00175 \par
00177   {\cf20 // CTX do split (0-8)}\par
00179   {\cf17 const} {\cf18 unsigned} widthCurr  = partitioner.currArea().blocks[partitioner.chType].width;\par
00180   {\cf17 const} {\cf18 unsigned} heightCurr = partitioner.currArea().blocks[partitioner.chType].height;\par
00181 \par
00182   ctxSpl = 0;\par
00183 \par
00184   {\cf19 if}( cuLeft )\par
00185   \{\par
00186     {\cf17 const} {\cf18 unsigned} heightLeft = cuLeft->blocks[partitioner.chType].height;\par
00187     ctxSpl += ( heightLeft < heightCurr ? 1 : 0 );\par
00188   \}\par
00189   {\cf19 if}( cuAbove )\par
00190   \{\par
00191     {\cf17 const} {\cf18 unsigned} widthAbove = cuAbove->blocks[partitioner.chType].width;\par
00192     ctxSpl += ( widthAbove < widthCurr ? 1 : 0 );\par
00193   \}\par
00194 \par
00195   {\cf18 unsigned} numSplit = 0;\par
00196   {\cf19 if} (canSplit[1])\par
00197   \{\par
00198     numSplit += 2;\par
00199   \}\par
00200   {\cf19 if} (canSplit[2])\par
00201   \{\par
00202     numSplit += 1;\par
00203   \}\par
00204   {\cf19 if} (canSplit[3])\par
00205   \{\par
00206     numSplit += 1;\par
00207   \}\par
00208   {\cf19 if} (canSplit[4])\par
00209   \{\par
00210     numSplit += 1;\par
00211   \}\par
00212   {\cf19 if} (canSplit[5])\par
00213   \{\par
00214     numSplit += 1;\par
00215   \}\par
00216 \par
00217   {\cf19 if} (numSplit > 0)\par
00218   \{\par
00219     numSplit--;\par
00220   \}\par
00221 \par
00222   ctxSpl += 3 * ( numSplit >> 1 );\par
00223 \par
00225   {\cf20 // CTX is qt split (0-5)}\par
00227   ctxQt =  ( cuLeft  && cuLeft->qtDepth  > partitioner.currQtDepth ) ? 1 : 0;\par
00228   ctxQt += ( cuAbove && cuAbove->qtDepth > partitioner.currQtDepth ) ? 1 : 0;\par
00229   ctxQt += partitioner.currQtDepth < 2 ? 0 : 3;\par
00230 \par
00232   {\cf20 // CTX is ver split (0-4)}\par
00234   ctxHv = 0;\par
00235 \par
00236   {\cf17 const} {\cf18 unsigned} numHor = ( canSplit[2] ? 1 : 0 ) + ( canSplit[4] ? 1 : 0 );\par
00237   {\cf17 const} {\cf18 unsigned} numVer = ( canSplit[3] ? 1 : 0 ) + ( canSplit[5] ? 1 : 0 );\par
00238 \par
00239   {\cf19 if}( numVer == numHor )\par
00240   \{\par
00241     {\cf17 const} Area& area = partitioner.currArea().blocks[partitioner.chType];\par
00242 \par
00243     {\cf17 const} {\cf18 unsigned} wAbove       = cuAbove ? cuAbove->blocks[partitioner.chType].width  : 1;\par
00244     {\cf17 const} {\cf18 unsigned} hLeft        = cuLeft  ? cuLeft ->blocks[partitioner.chType].height : 1;\par
00245 \par
00246     {\cf17 const} {\cf18 unsigned} depAbove     = area.width / wAbove;\par
00247     {\cf17 const} {\cf18 unsigned} depLeft      = area.height / hLeft;\par
00248 \par
00249     {\cf19 if} (depAbove == depLeft || !cuLeft || !cuAbove)\par
00250     \{\par
00251       ctxHv = 0;\par
00252     \}\par
00253     {\cf19 else} {\cf19 if} (depAbove < depLeft)\par
00254     \{\par
00255       ctxHv = 1;\par
00256     \}\par
00257     {\cf19 else}\par
00258     \{\par
00259       ctxHv = 2;\par
00260     \}\par
00261   \}\par
00262   {\cf19 else} {\cf19 if}( numVer < numHor )\par
00263   \{\par
00264     ctxHv = 3;\par
00265   \}\par
00266   {\cf19 else}\par
00267   \{\par
00268     ctxHv = 4;\par
00269   \}\par
00270 \par
00272   {\cf20 // CTX is h/v bt (0-3)}\par
00274   ctxHorBt = ( partitioner.currMtDepth <= 1 ? 1 : 0 );\par
00275   ctxVerBt = ( partitioner.currMtDepth <= 1 ? 3 : 2 );\par
00276 \}\par
