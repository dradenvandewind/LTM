00224 ESFile::Result ESFile::ReadAccessUnitU32Length(AccessUnit &out) \{\par
00225     {\cf19 if} (m_file == {\cf17 nullptr})\par
00226         {\cf19 return} NoFile;\par
00227 \par
00228     utility::DataBuffer buffer;\par
00229     std::vector<NalUnit> nalUnits;\par
00230     int32_t size = 0;\par
00231 \par
00232     {\cf19 while} ({\cf17 true}) \{\par
00233         {\cf20 // Read length prefix}\par
00234         uint32_t nal_length = 0;\par
00235         \{\par
00236             {\cf17 const} {\cf18 size_t} result = fread(&nal_length, 1, {\cf17 sizeof}(nal_length), m_file);\par
00237             {\cf19 if} (result == 0)\par
00238                 {\cf19 return} EndOfFile;\par
00239 \par
00240             {\cf19 if} (result != {\cf17 sizeof}(nal_length))\par
00241                 {\cf19 return} NalParsingError;\par
00242         \}\par
00243 \par
00244         {\cf20 // Read body of NAL unit}\par
00245         buffer.resize(nal_length);\par
00246         {\cf19 if} (fread(buffer.data(), 1, nal_length, m_file) != nal_length)\par
00247             {\cf19 return} NalParsingError;\par
00248 \par
00249         {\cf19 if} (m_decoder->ParseNalUnit(buffer.data(), nal_length)) \{\par
00250             NalUnit unit;\par
00251             unit.m_type = m_decoder->GetNalType();\par
00252             unit.m_data.insert(unit.m_data.end(), (uint8_t *)&nal_length, (uint8_t *)&nal_length + {\cf17 sizeof}(nal_length));\par
00253             unit.m_data.insert(unit.m_data.end(), buffer.begin(), buffer.end());\par
00254             nalUnits.push_back(std::move(unit));\par
00255             size += (int32_t)(nal_length + 4); {\cf20 // length + length prefix}\par
00256 \par
00257             {\cf19 if} (m_decoder->GetBaseNalUnitType() == BaseDecNalUnitType::Slice) \{\par
00258                 out.m_pictureType = m_decoder->GetBasePictureType();\par
00259                 out.m_poc = GenerateIncreasingPOC();\par
00260                 out.m_qp = m_decoder->GetQP();\par
00261                 out.m_nalUnits = std::move(nalUnits);\par
00262 \par
00263                 out.m_size = size;\par
00264 \par
00265                 {\cf19 return} Success;\par
00266             \}\par
00267 \par
00268         \} {\cf19 else} \{\par
00269             {\cf19 return} NalParsingError;\par
00270         \}\par
00271     \}\par
00272 \}\par
