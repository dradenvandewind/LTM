00274 {\cf20 // Create a POC that always increases across IDR}\par
00275 {\cf20 //}\par
00276 uint64_t ESFile::GenerateIncreasingPOC() \{\par
00277     uint64_t decoded_poc = m_decoder->GetPictureOrderCount();\par
00278 \par
00279     {\cf20 // If we see the start of an IDR and the POC goes backwards, then}\par
00280     {\cf20 // offset the generated POC by the highest POC seen so far}\par
00281     {\cf20 //}\par
00282     {\cf19 if}(m_decoder->GetBasePictureType() == BaseDecPictType::IDR && decoded_poc < m_poc_highest) \{\par
00283         m_poc_offset = m_poc_highest;\par
00284     \}\par
00285 \par
00286     {\cf17 const} uint64_t poc = decoded_poc + m_poc_offset;\par
00287 \par
00288     {\cf19 if}(poc > m_poc_highest) \{\par
00289         m_poc_highest = poc + m_decoder->GetPictureOrderCountIncrement();\par
00290     \}\par
00291 \par
00292     {\cf19 return} poc;\par
00293 \}\par
