00137 ESFile::Result ESFile::ReadAccessUnitMarker(AccessUnit &out) \{\par
00138     {\cf19 if} (m_file == {\cf17 nullptr})\par
00139         {\cf19 return} NoFile;\par
00140 \par
00141     utility::DataBuffer buffer;\par
00142     std::vector<NalUnit> nalUnits;\par
00143     int32_t size = 0;\par
00144     uint32_t temporalId = 0;\par
00145 \par
00146     {\cf19 while} ({\cf17 true}) \{\par
00147         {\cf17 const} {\cf18 int} c = fgetc(m_file);\par
00148 \par
00149         {\cf19 if} (c != EOF)\par
00150             buffer.push_back(c);\par
00151 \par
00152         {\cf18 bool} foundNalStart =\par
00153             buffer.size() > kNalUnitMarkerSize && std::equal(buffer.end() - kNalUnitMarkerSize, buffer.end(), kNalUnitMarker);\par
00154 \par
00155         {\cf19 if} (foundNalStart || feof(m_file)) \{\par
00156 \par
00157             uint64_t nalLength = buffer.size();\par
00158             {\cf20 /* uint64_t */} {\cf18 int} markerSize = 0;\par
00159 \par
00160             {\cf19 if} (foundNalStart) \{\par
00161                 markerSize = kNalUnitMarkerSize;\par
00162 \par
00163                 {\cf20 // Handle [0, 0, 0, 1] case}\par
00164                 {\cf19 if} (buffer.size() > kNalUnitMarkerSize && buffer[nalLength - markerSize - 1] == 0x0)\par
00165                     ++markerSize;\par
00166             \}\par
00167 \par
00168             {\cf19 if} (nalLength > markerSize) \{\par
00169                 nalLength -= markerSize;\par
00170 \par
00171                 {\cf18 unsigned} result = m_decoder->ParseNalUnit(buffer.data(), {\cf17 static_cast<}uint32_t{\cf17 >}(nalLength));\par
00172 \par
00173                 {\cf19 if} (result == 1) \{\par
00174                     NalUnit unit;\par
00175 \par
00176                     {\cf17 auto} nalEnd = buffer.end() - markerSize;\par
00177                     unit.m_type = m_decoder->GetNalType();\par
00178                     temporalId = std::max(temporalId, m_decoder->GetTemporalId());\par
00179 \par
00180                     {\cf20 // Move the next nal unit's marker into unit's buffer so we can just swap the two}\par
00181                     unit.m_data.insert(unit.m_data.end(), nalEnd, buffer.end());\par
00182                     buffer.erase(nalEnd, buffer.end());\par
00183                     std::swap(unit.m_data, buffer);\par
00184 \par
00185                     nalUnits.push_back(std::move(unit));\par
00186                     size += (int32_t)(nalLength);\par
00187 \par
00188                     {\cf19 if} (m_decoder->GetBaseNalUnitType() == BaseDecNalUnitType::Slice) \{\par
00189 \par
00190                         out.m_pictureType = m_decoder->GetBasePictureType();\par
00191                         out.m_poc = GenerateIncreasingPOC();\par
00192                         out.m_qp = m_decoder->GetQP();\par
00193                         out.m_temporalId = temporalId;\par
00194                         out.m_nalUnits = std::move(nalUnits);\par
00195 \par
00196                         out.m_size = size;\par
00197 \par
00198                         fseek(m_file, -{\cf17 static_cast<}{\cf18 long}{\cf17 >}(markerSize), SEEK_CUR);\par
00199 \par
00200                         {\cf19 return} Success;\par
00201                     \}\par
00202                 \} {\cf19 else} {\cf19 if} (result == 2) \{\par
00203                     NalUnit unit;\par
00204 \par
00205                     {\cf17 auto} nalEnd = buffer.end() - markerSize;\par
00206 \par
00207                     {\cf20 // Move the next nal unit's marker into unit's buffer so we can just swap the two}\par
00208                     unit.m_data.insert(unit.m_data.end(), nalEnd, buffer.end());\par
00209                     buffer.erase(nalEnd, buffer.end());\par
00210                     std::swap(unit.m_data, buffer);\par
00211                     nalUnits.push_back(std::move(unit));\par
00212                 \} {\cf19 else}\par
00213                     {\cf19 return} NalParsingError;\par
00214             \}\par
00215         \}\par
00216 \par
00217         {\cf19 if} (c == EOF)\par
00218             {\cf19 break};\par
00219     \}\par
00220 \par
00221     {\cf19 return} EndOfFile;\par
00222 \}\par
