00055 SEIMessages getSeisByType({\cf17 const} SEIMessages &seiList, SEI::PayloadType seiType)\par
00056 \{\par
00057   SEIMessages result;\par
00058 \par
00059   {\cf19 for} (SEIMessages::const_iterator it=seiList.begin(); it!=seiList.end(); it++)\par
00060   \{\par
00061     {\cf19 if} ((*it)->payloadType() == seiType)\par
00062     \{\par
00063       result.push_back(*it);\par
00064     \}\par
00065   \}\par
00066   {\cf19 return} result;\par
00067 \}\par
00068 \par
00069 SEIMessages extractSeisByType(SEIMessages &seiList, SEI::PayloadType seiType)\par
00070 \{\par
00071   SEIMessages result;\par
00072 \par
00073   SEIMessages::iterator it=seiList.begin();\par
00074   {\cf19 while} ( it!=seiList.end() )\par
00075   \{\par
00076     {\cf19 if} ((*it)->payloadType() == seiType)\par
00077     \{\par
00078       result.push_back(*it);\par
00079       it = seiList.erase(it);\par
00080     \}\par
00081     {\cf19 else}\par
00082     \{\par
00083       it++;\par
00084     \}\par
00085   \}\par
00086   {\cf19 return} result;\par
00087 \}\par
