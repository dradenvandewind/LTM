00640 {\cf17 static} {\cf17 inline} {\cf18 int} floorLog2(uint32_t x)\par
00641 \{\par
00642   {\cf19 if} (x == 0)\par
00643   \{\par
00644     {\cf20 // note: ceilLog2() expects -1 as return value}\par
00645     {\cf19 return} -1;\par
00646   \}\par
00647 {\cf21 #ifdef __GNUC__}\par
00648   {\cf19 return} 31 - __builtin_clz(x);\par
00649 {\cf21 #else}\par
00650 {\cf21 #ifdef _MSC_VER}\par
00651   {\cf18 unsigned} {\cf18 long} r = 0;\par
00652   _BitScanReverse(&r, x);\par
00653   {\cf19 return} r;\par
00654 {\cf21 #else}\par
00655   {\cf18 int} result = 0;\par
00656   {\cf19 if} (x & 0xffff0000)\par
00657   \{\par
00658     x >>= 16;\par
00659     result += 16;\par
00660   \}\par
00661   {\cf19 if} (x & 0xff00)\par
00662   \{\par
00663     x >>= 8;\par
00664     result += 8;\par
00665   \}\par
00666   {\cf19 if} (x & 0xf0)\par
00667   \{\par
00668     x >>= 4;\par
00669     result += 4;\par
00670   \}\par
00671   {\cf19 if} (x & 0xc)\par
00672   \{\par
00673     x >>= 2;\par
00674     result += 2;\par
00675   \}\par
00676   {\cf19 if} (x & 0x2)\par
00677   \{\par
00678     x >>= 1;\par
00679     result += 1;\par
00680   \}\par
00681   {\cf19 return} result;\par
00682 {\cf21 #endif}\par
00683 {\cf21 #endif}\par
00684 \}\par
00685 \par
00686 {\cf17 static} {\cf17 inline} {\cf18 int} ceilLog2(uint32_t x)\par
00687 \{\par
00688   {\cf19 return} (x==0) ? -1 : floorLog2(x - 1) + 1;\par
00689 \}\par
