\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 {\cf20 // LCEVC replacement implementation to feed bitstresm directly into base layer via an in-memory buffer}\par
00002 {\cf20 //}\par
00003 \par
00017 {\cf21 #include "global.h"}\par
00018 {\cf21 #include "annexb.h"}\par
00019 {\cf21 #include "memalloc.h"}\par
00020 {\cf21 #include "fast_memory.h"}\par
00021 \par
00022 {\cf17 static} {\cf18 byte} *injected_annex_b_data = 0;\par
00023 {\cf17 static} {\cf18 unsigned} injected_annex_b_size = 0;\par
00024 \par
00025 {\cf20 // External hook from LCEVC}\par
00026 {\cf18 void} inject_annex_b_bitstream({\cf18 byte} *data, {\cf18 unsigned} size)\par
00027 \{\par
00028     injected_annex_b_data = data;\par
00029     injected_annex_b_size = size;\par
00030 \}\par
00031 \par
00032 {\cf18 void} malloc_annex_b(VideoParameters *p_Vid, ANNEXB_t **p_annex_b)\par
00033 \{\par
00034   {\cf19 if} ( ((*p_annex_b) = (ANNEXB_t *) calloc(1, {\cf17 sizeof}(ANNEXB_t))) == NULL)\par
00035   \{\par
00036     snprintf(errortext, ET_SIZE, {\cf22 "Memory allocation for Annex_B file failed"});\par
00037     error(errortext,100);\par
00038   \}\par
00039   {\cf19 if} (((*p_annex_b)->Buf = ({\cf18 byte}*) malloc(p_Vid->nalu->max_size)) == NULL)\par
00040   \{\par
00041     error({\cf22 "malloc_annex_b: Buf"}, 101);\par
00042   \}\par
00043 \}\par
00044 \par
00045 \par
00046 {\cf18 void} init_annex_b(ANNEXB_t *annex_b)\par
00047 \{\par
00048   annex_b->iobuffer = NULL;\par
00049   annex_b->iobufferread = NULL;\par
00050   annex_b->bytesinbuffer = 0;\par
00051   annex_b->is_eof = FALSE;\par
00052   annex_b->IsFirstByteStreamNALU = 1;\par
00053   annex_b->nextstartcodebytes = 0;\par
00054 \}\par
00055 \par
00056 {\cf18 void} free_annex_b(ANNEXB_t **p_annex_b)\par
00057 \{\par
00058   free((*p_annex_b)->Buf);\par
00059   (*p_annex_b)->Buf = NULL;\par
00060   free(*p_annex_b);\par
00061   *p_annex_b = NULL;\par
00062 \}\par
00063 \par
00064 \par
00071 {\cf17 static} {\cf17 inline} {\cf18 byte} getfbyte(ANNEXB_t *annex_b) \{\par
00072     {\cf19 if} (annex_b->bytesinbuffer == 0) \{\par
00073         annex_b->is_eof = TRUE;\par
00074         {\cf19 return} 0;\par
00075     \}\par
00076 \par
00077     annex_b->bytesinbuffer--;\par
00078 \par
00079     {\cf19 return} (*annex_b->iobufferread++);\par
00080 \}\par
00081 \par
00098 {\cf17 static} {\cf17 inline} {\cf18 int} FindStartCode ({\cf18 unsigned} {\cf18 char} *Buf, {\cf18 int} zeros_in_startcode)\par
00099 \{\par
00100   {\cf18 int} i;\par
00101 \par
00102   {\cf19 for} (i = 0; i < zeros_in_startcode; i++)\par
00103   \{\par
00104     {\cf19 if}(*(Buf++) != 0)\par
00105     \{\par
00106       {\cf19 return} 0;\par
00107     \}\par
00108   \}\par
00109 \par
00110   {\cf19 if}(*Buf != 1)\par
00111     {\cf19 return} 0;\par
00112 \par
00113   {\cf19 return} 1;\par
00114 \}\par
00115 \par
00116 \par
00136 {\cf18 int} get_annex_b_NALU (VideoParameters *p_Vid, NALU_t *nalu, ANNEXB_t *annex_b)\par
00137 \{\par
00138     {\cf18 int} i;\par
00139     {\cf18 int} info2 = 0, info3 = 0, pos = 0;\par
00140     {\cf18 int} StartCodeFound = 0;\par
00141     {\cf18 int} LeadingZero8BitsCount = 0;\par
00142     {\cf18 byte} *pBuf = annex_b->Buf;\par
00143 \par
00144     {\cf19 if} (annex_b->nextstartcodebytes != 0)\par
00145     \{\par
00146         {\cf19 for} (i=0; i<annex_b->nextstartcodebytes-1; i++)\par
00147         \{\par
00148             (*pBuf++) = 0;\par
00149             pos++;\par
00150         \}\par
00151         (*pBuf++) = 1;\par
00152         pos++;\par
00153     \}\par
00154     {\cf19 else}\par
00155     \{\par
00156         {\cf19 while}(!annex_b->is_eof)\par
00157         \{\par
00158             pos++;\par
00159             {\cf19 if} ((*(pBuf++)= getfbyte(annex_b))!= 0)\par
00160                 {\cf19 break};\par
00161         \}\par
00162     \}\par
00163     {\cf19 if}(annex_b->is_eof == TRUE)\par
00164     \{\par
00165         {\cf19 if}(pos==0)\par
00166         \{\par
00167             {\cf19 return} 0;\par
00168         \}\par
00169         {\cf19 else}\par
00170         \{\par
00171             printf( {\cf22 "get_annex_b_NALU can't read start code\\n"});\par
00172             {\cf19 return} -1;\par
00173         \}\par
00174     \}\par
00175 \par
00176     {\cf19 if}(*(pBuf - 1) != 1 || pos < 3)\par
00177     \{\par
00178         printf ({\cf22 "get_annex_b_NALU: no Start Code at the beginning of the NALU, return -1\\n"});\par
00179         {\cf19 return} -1;\par
00180     \}\par
00181 \par
00182     {\cf19 if} (pos == 3)\par
00183     \{\par
00184         nalu->startcodeprefix_len = 3;\par
00185     \}\par
00186     {\cf19 else}\par
00187     \{\par
00188         LeadingZero8BitsCount = pos - 4;\par
00189         nalu->startcodeprefix_len = 4;\par
00190     \}\par
00191 \par
00192     {\cf20 //the 1st byte stream NAL unit can has leading_zero_8bits, but subsequent ones are not}\par
00193     {\cf20 //allowed to contain it since these zeros(if any) are considered trailing_zero_8bits}\par
00194     {\cf20 //of the previous byte stream NAL unit.}\par
00195     {\cf19 if}(!annex_b->IsFirstByteStreamNALU && LeadingZero8BitsCount > 0)\par
00196     \{\par
00197         printf ({\cf22 "get_annex_b_NALU: The leading_zero_8bits syntax can only be present in the first byte stream NAL unit, return -1\\n"});\par
00198         {\cf19 return} -1;\par
00199     \}\par
00200 \par
00201     LeadingZero8BitsCount = pos;\par
00202     annex_b->IsFirstByteStreamNALU = 0;\par
00203 \par
00204     {\cf19 while} (!StartCodeFound)\par
00205     \{\par
00206         {\cf19 if} (annex_b->is_eof == TRUE)\par
00207         \{\par
00208             pBuf -= 2;\par
00209             {\cf19 while}(*(pBuf--)==0)\par
00210                 pos--;\par
00211 \par
00212             nalu->len = (pos - 1) - LeadingZero8BitsCount;\par
00213             memcpy (nalu->buf, annex_b->Buf + LeadingZero8BitsCount, nalu->len);\par
00214             nalu->forbidden_bit     = (*(nalu->buf) >> 7) & 1;\par
00215             nalu->nal_reference_idc = (NalRefIdc) ((*(nalu->buf) >> 5) & 3);\par
00216             nalu->nal_unit_type     = (NaluType) ((*(nalu->buf)) & 0x1f);\par
00217             annex_b->nextstartcodebytes = 0;\par
00218 \par
00219             {\cf20 // printf ("get_annex_b_NALU, eof case: pos %d nalu->len %d, nalu->reference_idc %d, nal_unit_type %d \\n", pos, nalu->len, nalu->nal_reference_idc, nalu->nal_unit_type);}\par
00220 \par
00221 {\cf21 #if TRACE}\par
00222             fprintf (p_Dec->p_trace, {\cf22 "\\n\\nLast NALU in File\\n\\n"});\par
00223             fprintf (p_Dec->p_trace, {\cf22 "Annex B NALU w/ %s startcode, len %d, forbidden_bit %d, nal_reference_idc %d, nal_unit_type %d\\n\\n"},\par
00224                      nalu->startcodeprefix_len == 4?{\cf22 "long"}:{\cf22 "short"}, nalu->len, nalu->forbidden_bit, nalu->nal_reference_idc, nalu->nal_unit_type);\par
00225             fflush (p_Dec->p_trace);\par
00226 {\cf21 #endif}\par
00227             {\cf19 return} (pos - 1);\par
00228         \}\par
00229 \par
00230         pos++;\par
00231         *(pBuf ++)  = getfbyte(annex_b);    \par
00232         info3 = FindStartCode(pBuf - 4, 3);\par
00233         {\cf19 if}(info3 != 1)\par
00234         \{\par
00235             info2 = FindStartCode(pBuf - 3, 2);\par
00236             StartCodeFound = info2 & 0x01;\par
00237         \}\par
00238         {\cf19 else}\par
00239             StartCodeFound = 1;\par
00240     \}\par
00241 \par
00242     {\cf20 // Here, we have found another start code (and read length of startcode bytes more than we should}\par
00243     {\cf20 // have.  Hence, go back in the file}\par
00244     {\cf19 if}(info3 == 1)  {\cf20 //if the detected start code is 00 00 01, trailing_zero_8bits is sure not to be present}\par
00245     \{\par
00246         pBuf -= 5;\par
00247         {\cf19 while}(*(pBuf--) == 0)\par
00248             pos--;\par
00249         annex_b->nextstartcodebytes = 4;\par
00250     \}\par
00251     {\cf19 else} {\cf19 if} (info2 == 1)\par
00252         annex_b->nextstartcodebytes = 3;\par
00253     {\cf19 else}\par
00254     \{\par
00255         printf({\cf22 " Panic: Error in next start code search \\n"});\par
00256         {\cf19 return} -1;\par
00257     \}\par
00258 \par
00259     pos -= annex_b->nextstartcodebytes;\par
00260 \par
00261     {\cf20 // Here the leading zeros(if any), Start code, the complete NALU, trailing zeros(if any)}\par
00262     {\cf20 // and the next start code is in the Buf.}\par
00263     {\cf20 // The size of Buf is pos - rewind, pos are the number of bytes excluding the next}\par
00264     {\cf20 // start code, and (pos) - LeadingZero8BitsCount}\par
00265     {\cf20 // is the size of the NALU.}\par
00266 \par
00267     nalu->len = pos - LeadingZero8BitsCount;\par
00268     fast_memcpy (nalu->buf, annex_b->Buf + LeadingZero8BitsCount, nalu->len);\par
00269     nalu->forbidden_bit     = (*(nalu->buf) >> 7) & 1;\par
00270     nalu->nal_reference_idc = (NalRefIdc) ((*(nalu->buf) >> 5) & 3);\par
00271     nalu->nal_unit_type     = (NaluType) ((*(nalu->buf)) & 0x1f);\par
00272     nalu->lost_packets = 0;\par
00273 \par
00274     {\cf20 //printf ("get_annex_b_NALU, regular case: pos %d nalu->len %d, nalu->reference_idc %d, nal_unit_type %d \\n", pos, nalu->len, nalu->nal_reference_idc, nalu->nal_unit_type);}\par
00275 {\cf21 #if TRACE}\par
00276     fprintf (p_Dec->p_trace, {\cf22 "\\n\\nAnnex B NALU w/ %s startcode, len %d, forbidden_bit %d, nal_reference_idc %d, nal_unit_type %d\\n\\n"},\par
00277              nalu->startcodeprefix_len == 4?{\cf22 "long"}:{\cf22 "short"}, nalu->len, nalu->forbidden_bit, nalu->nal_reference_idc, nalu->nal_unit_type);\par
00278     fflush (p_Dec->p_trace);\par
00279 {\cf21 #endif}\par
00280 \par
00281     {\cf19 return} (pos);\par
00282 \par
00283 \}\par
