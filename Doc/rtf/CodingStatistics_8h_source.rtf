00965         {\cf19 if}( i != STATS__NAL_UNIT_TOTAL_BODY )\par
00966         \{\par
00967           cabacTotalBits += sCABAC;\par
00968           epTotalBits += sEP;\par
00969 \par
00970          {\cf20 // For TRF}\par
00971          {\cf19 if} ((i == STATS__CABAC_BITS__SIG_COEFF_MAP_FLAG) || (i == STATS__CABAC_BITS__PAR_FLAG)\par
00972              || (i == STATS__CABAC_BITS__GT1_FLAG) || (i == STATS__CABAC_BITS__GT2_FLAG)\par
00973              || (i == STATS__CABAC_BITS__ESCAPE_BITS))\par
00974          \{\par
00975            cabacTrfTotalBits += sCABAC;\par
00976            epTrfTotalBits += sEP;\par
00977          \}\par
00978         \}\par
00979       \}\par
00980     \}\par
00981 \par
00982     SStat delta_CABAC = cabacTotalBits;\par
00983     SStat delta_EP = epTotalBits;\par
00984     SStat delta_trf_CABAC = cabacTrfTotalBits;\par
00985     SStat delta_trf_EP = epTrfTotalBits;\par
00986 \par
00987     delta_CABAC -= max.prev_CABAC_state;\par
00988     delta_EP -= max.prev_EP_state;\par
00989 \par
00990     delta_trf_CABAC -= max.prev_trf_CABAC_state;\par
00991     delta_trf_EP -= max.prev_trf_EP_state;\par
00992     int64_t max_frame_bins = EPBIN_WEIGHT_FACTOR * max.max_CABAC_state.count + max.max_EP_state.count;\par
00993     int64_t cur_frame_bins = EPBIN_WEIGHT_FACTOR * delta_CABAC.count + delta_EP.count;\par
00994 \par
00995     {\cf19 if} (cur_frame_bins > max_frame_bins)\par
