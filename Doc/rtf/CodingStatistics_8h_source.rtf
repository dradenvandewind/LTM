00872   {\cf17 static} {\cf18 void} UpdateCABACStat( {\cf17 const} CodingStatisticsClassType &stat, uint32_t uiRangeBefore, uint32_t uiRangeAfter, {\cf18 int} val )\par
00873   \{\par
00874     CHECK( stat.type == STATS__CABAC_BITS__INVALID, {\cf22 "Should never be used."} );\par
00875     CodingStatistics &inst = GetSingletonInstance();\par
00876     {\cf20 // doing rangeBefore*p(x)=rangeAfter}\par
00877     {\cf20 // p(x)=rangeAfter/rangeBefore}\par
00878     {\cf20 // entropy = -log2(p(x))=-log(p(x))/log(2) = -(log rangeAfter - log rangeBefore) / log(2) = (log rangeBefore / log 2 - log rangeAfter / log 2)}\par
00879     SStat &s = inst.data.statistics[stat.type][stat.subClass];\par
00880     s.bits  += inst.values.values[uiRangeBefore] - inst.values.values[uiRangeAfter];\par
00881     s.count++;\par
00882     s.sum   += val;\par
00883   \}\par
