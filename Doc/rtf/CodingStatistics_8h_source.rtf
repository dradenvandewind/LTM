00886   {\cf17 static} {\cf18 void} UpdateMaxStat(CodingStatisticsData *data)\par
00887   \{\par
00888     SStat_max &   max = GetStatisticMax();\par
00889     {\cf17 const} int64_t es = CODINGSTATISTICS_ENTROPYSCALE;\par
00890 \par
00891     int64_t countTotal = 0;\par
00892     int64_t classCounts[STATS__NUM_STATS];\par
00893     std::fill_n(classCounts, ({\cf18 size_t}) STATS__NUM_STATS, 0);\par
00894 \par
00895     int64_t cr = 0;   {\cf20 // CABAC remainder, which is added to "STATS__CABAC_INITIALISATION"}\par
00896 \par
00897     int64_t totalCABACbits = 0, roundedCABACbits = 0;\par
00898     {\cf19 for} ({\cf18 int} i = STATS__NAL_UNIT_PACKING; i < STATS__NUM_STATS; i++)\par
00899     \{\par
00900       int64_t classCount = 0;\par
00901 \par
00902       {\cf19 for} (uint32_t c = 0; c < CODING_STATS_NUM_SUBCLASSES; c++)\par
00903       \{\par
00904         totalCABACbits += data->statistics[i][c].bits;\par
00905         roundedCABACbits += data->statistics[i][c].bits / es;\par
00906         classCount += data->statistics[i][c].count;\par
00907       \}\par
00908 \par
00909       {\cf19 for} (uint32_t c = 0; c < CODING_STATS_NUM_SUBCLASSES; c++)\par
00910       \{\par
00911         data->statistics[i][c].classCount = classCount;\par
00912       \}\par
00913 \par
00914       classCounts[i] = classCount;\par
00915       countTotal += classCount;\par
00916     \}\par
00917     int64_t remainder = totalCABACbits - roundedCABACbits * es;\par
00918     cr = (remainder + es / 2) / es;\par
00919 \par
00920     classCounts[0] = countTotal;\par
00921 \par
00922     SStat cabacTotalBits, epTotalBits, cabacTrfTotalBits, epTrfTotalBits;\par
00923 \par
00924     cabacTotalBits.classCount = countTotal;\par
00925     epTotalBits.classCount = countTotal;\par
00926     cabacTrfTotalBits.classCount = countTotal;\par
00927     epTrfTotalBits.classCount    = countTotal;\par
00928 \par
00929     {\cf20 // Calculate the actual bin and bit count}\par
00930     {\cf19 for} ({\cf18 int} i = 0; i < STATS__NUM_STATS; i++)\par
00931     \{\par
00932       {\cf19 for} (uint32_t c = 0; c < CODING_STATS_NUM_SUBCLASSES; c++)\par
00933       \{\par
