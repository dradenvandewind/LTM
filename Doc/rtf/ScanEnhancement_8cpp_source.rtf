00389 {\cf20 // EVC NALUs are u32 size prefixed, not marker delimited}\par
00390 {\cf17 template} <{\cf17 typename} SEI>\par
00391 {\cf17 static} {\cf18 size_t} scan_enhancement_sei_evc(uint8_t *data, {\cf18 size_t} data_size, uint64_t pts, {\cf18 bool} is_base_idr,\par
