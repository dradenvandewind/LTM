00411 {\cf20 // Scan for enhancement data in buffer - may remove data and returns new size}\par
00412 {\cf20 //}\par
00413 {\cf18 size_t} scan_enhancement(uint8_t *data, {\cf18 size_t} data_size, Encapsulation encapsulation, BaseCoding base_coding, uint64_t pts,\par
00414                         {\cf18 bool} is_base_idr, std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00415     {\cf19 switch} (encapsulation) \{\par
00416     {\cf19 case} Encapsulation_SEI_Registered:\par
00417         {\cf19 switch} (base_coding) \{\par
00418         {\cf19 case} BaseCoding_AVC:\par
00419             {\cf19 return} scan_enhancement_sei_avc<RegisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00420         {\cf19 case} BaseCoding_HEVC:\par
00421             {\cf19 return} scan_enhancement_sei_hevc<RegisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00422         {\cf19 case} BaseCoding_VVC:\par
00423             {\cf19 return} scan_enhancement_sei_vvc<RegisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00424         {\cf19 case} BaseCoding_EVC:\par
00425             {\cf19 return} scan_enhancement_sei_evc<RegisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00426         {\cf19 default}:\par
00427             CHECK(0);\par
00428         \}\par
00429         {\cf19 break};\par
00430     {\cf19 case} Encapsulation_SEI_Unregistered:\par
00431         {\cf19 switch} (base_coding) \{\par
00432         {\cf19 case} BaseCoding_AVC:\par
00433             {\cf19 return} scan_enhancement_sei_avc<UnregisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00434         {\cf19 case} BaseCoding_HEVC:\par
00435             {\cf19 return} scan_enhancement_sei_hevc<UnregisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00436         {\cf19 case} BaseCoding_VVC:\par
00437             {\cf19 return} scan_enhancement_sei_vvc<UnregisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00438         {\cf19 case} BaseCoding_EVC:\par
00439             {\cf19 return} scan_enhancement_sei_evc<UnregisteredSEI>(data, data_size, pts, is_base_idr, callback);\par
00440         {\cf19 default}:\par
00441             CHECK(0);\par
00442         \}\par
00443         {\cf19 break};\par
00444     {\cf19 case} Encapsulation_NAL:\par
00445         {\cf19 switch} (base_coding) \{\par
00446         {\cf19 case} BaseCoding_AVC:\par
00447             {\cf19 return} scan_enhancement_nal(data, data_size, pts, callback);\par
00448         {\cf19 case} BaseCoding_HEVC:\par
00449             {\cf19 return} scan_enhancement_nal(data, data_size, pts, callback);\par
00450         {\cf19 case} BaseCoding_VVC:\par
00451             {\cf19 return} scan_enhancement_nal(data, data_size, pts, callback);\par
00452         {\cf19 case} BaseCoding_EVC:\par
00453             {\cf19 return} scan_enhancement_nal_evc(data, data_size, pts, callback);\par
00454         {\cf19 case} BaseCoding_YUV:\par
00455             {\cf19 return} scan_enhancement_nal(data, data_size, pts, callback);\par
00456         {\cf19 default}:\par
00457             CHECK(0);\par
00458         \}\par
00459         {\cf19 break};\par
00460     {\cf19 case} Encapsulation_None:\par
00461         {\cf19 return} scan_enhancement_nal(data, data_size, pts, callback);\par
00462 \par
00463     {\cf19 default}:\par
00464         CHECK(0);\par
00465     \}\par
00466 \par
00467     {\cf19 return} 0;\par
00468 \}\par
