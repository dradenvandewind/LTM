00229 {\cf20 // Find any enhancement data in registered SEI NALU and pass to callback}\par
00230 {\cf20 // Used as a template parameter to scan_enhancement_sei_XXX()}\par
00231 {\cf20 //}\par
00232 {\cf18 void} RegisteredSEI::extract_enhancement_sei({\cf17 const} uint8_t *data, {\cf18 size_t} size, {\cf18 bool} emulation_prevention, uint64_t pts,\par
00233                                             {\cf18 bool} is_base_idr,\par
00234                                             std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00235     {\cf17 const} {\cf18 unsigned} USER_DATA_REGISTERED = 4;\par
00236     {\cf17 static} {\cf17 const} uint8_t sei_code[4] = \{0xb4, 0x00, 0x50, 0x00\};\par
00237 \par
00238     rbsp_decoder rbsp(data, size, emulation_prevention);\par
00239 \par
00240     {\cf18 size_t} sei_type = 0;\par
00241     uint8_t byte;\par
00242 \par
00243     {\cf19 do} \{\par
00244         {\cf18 byte} = rbsp.get_byte();\par
00245         sei_type += byte;\par
00246     \} {\cf19 while} ({\cf18 byte} == 0xFF);\par
00247 \par
00248     {\cf19 if} (sei_type == USER_DATA_REGISTERED) \{\par
00249         {\cf18 size_t} sei_length = 0;\par
00250         {\cf19 do} \{\par
00251             {\cf18 byte} = rbsp.get_byte();\par
00252             sei_length += byte;\par
00253         \} {\cf19 while} ({\cf18 byte} == 0xFF);\par
00254 \par
00255         {\cf19 if} (sei_length > size) \{\par
00256             WARN({\cf22 "SEI length overflow"});\par
00257         \} {\cf19 else} \{\par
00258             uint8_t tmp[{\cf17 sizeof}(sei_code)];\par
00259             rbsp.copy_sei(tmp, {\cf17 sizeof}(tmp));\par
00260 \par
00261             {\cf19 if} (memcmp(sei_code, tmp, {\cf17 sizeof}(sei_code)) == 0) \{\par
00262                 int64_t enhancement_len = sei_length - {\cf17 sizeof}(sei_code);\par
00263 \par
00264                 vector<uint8_t> buf(enhancement_len);\par
00265                 rbsp.copy_sei(buf.data(), buf.size());\par
00266 \par
00267                 {\cf20 // Additional NAL Encapsulation (LCEVC NALU Type)}\par
00268                 scan_enhancement_nal_prod(buf.data(), buf.size(), pts, callback);\par
00269             \}\par
00270         \}\par
00271     \}\par
00272 \}\par
00273 \par
00274 {\cf20 // Find any enhancement data in unregistered SEI NALU and pass to callback}\par
00275 {\cf20 // Used as a template parameter to scan_enhancement_sei_XXX()}\par
00276 {\cf20 //}\par
00277 {\cf18 void} UnregisteredSEI::extract_enhancement_sei({\cf17 const} uint8_t *data, {\cf18 size_t} size, {\cf18 bool} emulation_prevention, uint64_t pts,\par
00278                                               {\cf18 bool} is_base_idr,\par
00279                                               std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00280     {\cf17 const} {\cf18 unsigned} USER_DATA_UNREGISTERED = 5;\par
00281     {\cf17 static} {\cf17 const} uint8_t uuid[16] = \{0xa7, 0xc4, 0x6d, 0xed, 0x49, 0xd8, 0x38, 0xeb,\par
00282                                      0x9a, 0xad, 0x6d, 0xa6, 0x84, 0x97, 0xa7, 0x54\};\par
00283 \par
00284     rbsp_decoder rbsp(data, size, emulation_prevention);\par
00285 \par
00286     {\cf18 size_t} sei_type = 0;\par
00287     uint8_t byte;\par
00288 \par
00289     {\cf19 do} \{\par
00290         {\cf18 byte} = rbsp.get_byte();\par
00291         sei_type += byte;\par
00292     \} {\cf19 while} ({\cf18 byte} == 0xFF);\par
00293 \par
00294     {\cf19 if} (sei_type == USER_DATA_UNREGISTERED) \{\par
00295         {\cf18 size_t} sei_length = 0;\par
00296         {\cf19 do} \{\par
00297             {\cf18 byte} = rbsp.get_byte();\par
00298             sei_length += byte;\par
00299         \} {\cf19 while} ({\cf18 byte} == 0xFF);\par
00300 \par
00301         {\cf19 if} (sei_length > size) \{\par
00302             WARN({\cf22 "SEI length overflow"});\par
00303         \} {\cf19 else} \{\par
00304             uint8_t tmp[{\cf17 sizeof}(uuid)];\par
00305             rbsp.copy_sei(tmp, {\cf17 sizeof}(tmp));\par
00306 \par
00307             {\cf19 if} (memcmp(uuid, tmp, {\cf17 sizeof}(uuid)) == 0) \{\par
00308                 int64_t enhancement_len = sei_length - {\cf17 sizeof}(uuid);\par
00309 \par
00310                 {\cf17 auto} pss = Packet::build();\par
00311                 pss.reserve(({\cf18 unsigned})enhancement_len);\par
00312                 pss.timestamp(pts);\par
00313                 rbsp.copy_sei(pss.data(), enhancement_len);\par
00314                 callback(pss.finish(), is_base_idr);\par
00315             \}\par
00316         \}\par
00317     \}\par
00318 \}\par
00319 \par
00320 {\cf20 // AVC NALUs headers have one byte for type}\par
00321 {\cf17 template} <{\cf17 typename} SEI>\par
00322 {\cf17 static} {\cf18 size_t} scan_enhancement_sei_avc(uint8_t *data, {\cf18 size_t} data_size, uint64_t pts, {\cf18 bool} is_base_idr,\par
00323                                        std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00324     {\cf20 // Scan for SEI NALU}\par
00325     {\cf19 for} ({\cf18 unsigned} i = 0; i < data_size - 4; ++i) \{\par
00326         {\cf19 if} (is_nal_marker(data + i) && data[i + 3] == 0x6) \{\par
00327             {\cf20 // Figure size of NALU}\par
00328             {\cf18 unsigned} e = (unsigned)data_size;\par
00329             {\cf19 for} ({\cf18 unsigned} j = i + 4; j < data_size - 3; ++j) \{\par
00330                 {\cf19 if} (is_nal_marker(data + j)) \{\par
00331                     e = j;\par
00332                     {\cf19 break};\par
00333                 \}\par
00334             \}\par
00335             SEI::extract_enhancement_sei(data + (i + 4), e - (i + 4), {\cf17 true}, pts, is_base_idr, callback);\par
00336         \}\par
00337     \}\par
00338 \par
00339     {\cf20 // SEI can survive base decoder - don't remove}\par
00340     {\cf19 return} data_size;\par
00341 \}\par
