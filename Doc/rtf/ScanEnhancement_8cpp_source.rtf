00043 {\cf17 using namespace }std;\par
00044 \par
00045 {\cf17 namespace }lctm \{\par
00046 \par
00047 {\cf17 struct }RegisteredSEI \{\par
00048     {\cf17 static} {\cf18 void} extract_enhancement_sei({\cf17 const} uint8_t *data, {\cf18 size_t} size, {\cf18 bool} emulation_prevention, uint64_t pts, {\cf18 bool} is_base_idr,\par
00049                                         std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback);\par
00050 \};\par
00051 \par
00052 {\cf17 struct }UnregisteredSEI \{\par
00053     {\cf17 static} {\cf18 void} extract_enhancement_sei({\cf17 const} uint8_t *data, {\cf18 size_t} size, {\cf18 bool} emulation_prevention, uint64_t pts, {\cf18 bool} is_base_idr,\par
00054                                         std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback);\par
00055 \};\par
00056 \par
00058 {\cf20 //}\par
00059 {\cf17 class }rbsp_decoder \{\par
00060 {\cf17 public}:\par
00061     rbsp_decoder({\cf17 const} uint8_t *d, {\cf18 size_t} l, {\cf18 bool} e) : data(d), len(l), emulatiom_prevention(e), emitted(0xFFFFFFFF), offs(0)\{\};\par
00062     uint8_t get_byte();\par
00063     uint8_t *copy_sei(uint8_t *dst, {\cf18 size_t} len);\par
00064     {\cf18 void} copy(PacketBuilder *dst);\par
00065 \par
00066 {\cf17 protected}:\par
00067     {\cf17 const} uint8_t *data;\par
00068     {\cf18 size_t} len;\par
00069     {\cf18 bool} emulatiom_prevention;\par
00070     uint32_t emitted;\par
00071     {\cf18 size_t} offs;\par
00072 \};\par
00073 \par
00074 uint8_t rbsp_decoder::get_byte() \{\par
00075     {\cf19 if} (offs >= len)\par
00076         {\cf19 throw} out_of_range({\cf22 "No more RBSP"});\par
00077 \par
00078     emitted <<= 8;\par
00079     emitted |= data[offs++];\par
00080     {\cf19 if} (emulatiom_prevention && (emitted & 0xFFFFFF) == 0x000003) \{\par
00081         emitted <<= 8;\par
00082         {\cf19 if} (offs >= len)\par
00083             {\cf19 throw} out_of_range({\cf22 "No more RBSP"});\par
00084 \par
00085         emitted |= data[offs++];\par
00086     \}\par
00087     {\cf19 return} emitted & 0xFF;\par
00088 \}\par
00089 \par
00090 uint8_t *rbsp_decoder::copy_sei(uint8_t *d, {\cf18 size_t} l) \{\par
00091     {\cf19 for} ({\cf18 size_t} i = 0; i < l; i++)\par
00092         d[i] = get_byte();\par
00093 \par
00094     {\cf19 return} d;\par
00095 \}\par
00096 \par
00097 {\cf18 void} rbsp_decoder::copy(PacketBuilder *dst) \{\par
00098     {\cf18 size_t} i = 0;\par
00099     dst->reserve((uint32_t)len - (uint32_t)offs);\par
00100     {\cf19 while} ({\cf17 true}) \{\par
00101         {\cf19 try} \{\par
00102             dst->data()[i] = get_byte();\par
00103         \} {\cf19 catch} ({\cf17 const} std::out_of_range &) \{\par
00104             dst->resize((uint32_t)i -\par
00105                         1); {\cf20 // 0x80 is added during encapsulation process but does not belong to the actual data - stop bit}\par
00106             {\cf19 return};\par
00107         \}\par
00108         i++;\par
00109     \}\par
00110 \}\par
00111 \par
00112 {\cf20 // Recognize the NALU marker (used by LCEVC,AVC,HEVC,VVC, but not EVC)}\par
00113 {\cf20 //}\par
00114 {\cf17 static} {\cf17 inline} {\cf18 bool} is_nal_marker({\cf17 const} uint8_t *data) \{ {\cf19 return} data[0] == 0 && data[1] == 0 && data[2] == 1; \}\par
00115 \par
00116 {\cf20 // Check for valid LCEVC NAL uint type}\par
00117 {\cf20 //}\par
00118 {\cf17 static} {\cf17 inline} {\cf18 bool} is_lcevc_nal_unit_type({\cf17 const} uint8_t b) \{ {\cf19 return} (b >= LCEVC_NON_IDR) && (b <= LCEVC_RSV); \}\par
00119 \par
00120 {\cf20 // Extract enhancement data and pass to callback}\par
00121 {\cf20 //}\par
00122 {\cf17 static} {\cf18 void} extract_enhancement_nal({\cf17 const} uint8_t *data, {\cf18 size_t} size, {\cf18 bool} emulation_prevention, uint64_t pts, {\cf17 const} {\cf18 bool} is_idr,\par
00123                                     std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00124 \par
00125     {\cf17 auto} pss = Packet::build();\par
00126     pss.timestamp(pts);\par
00127 \par
00128     {\cf19 if} (emulation_prevention) \{\par
00129         rbsp_decoder rbsp(data, size, {\cf17 true});\par
00130         rbsp.copy(&pss);\par
00131     \} {\cf19 else} \{\par
00132         pss.contents(data, ({\cf18 unsigned})size);\par
00133     \}\par
00134     callback(pss.finish(), is_idr);\par
00135 \}\par
00136 \par
00137 {\cf20 // Find any enhancement data in native LCEVC NAL Unit and pass to callback}\par
00138 {\cf20 //}\par
00139 {\cf17 static} {\cf18 size_t} scan_enhancement_nal(uint8_t *data, {\cf18 size_t} data_size, uint64_t pts,\par
00140                                    std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00141     {\cf20 // Scan for Enhancement NALU}\par
00142     {\cf19 for} ({\cf18 unsigned} i = 0; i < data_size - 4; ++i) \{\par
00143         {\cf19 if} (is_nal_marker(data + i) && (data[i + 3] & 0xc0) == 0x40 && data[i + 4] == 0xff) \{\par
00144             {\cf17 const} {\cf18 unsigned} nal_unit_type = (data[i + 3] & 0x3e) >> 1;\par
00145 \par
00146             {\cf19 if} (is_lcevc_nal_unit_type(nal_unit_type)) \{\par
00147                 {\cf17 const} {\cf18 bool} is_idr = (nal_unit_type == NalUnitType::LCEVC_IDR ? true : {\cf17 false});\par
00148 \par
00149                 {\cf20 // Figure size of NALU}\par
00150                 {\cf18 unsigned} e = (unsigned)data_size;\par
00151                 {\cf19 for} ({\cf18 unsigned} j = i + 4; j < data_size - 3; ++j) \{\par
00152                     {\cf19 if} (is_nal_marker(data + j)) \{\par
00153                         {\cf20 // Handle [0, 0, 0, 1] case}\par
00154                         {\cf19 if} (data[j - 1] == 0x00)\par
00155                             j--;\par
00156                         e = j;\par
00157                         {\cf19 break};\par
00158                     \}\par
00159                 \}\par
00160                 extract_enhancement_nal(data + (i + 5), e - (i + 5), {\cf17 true}, pts, is_idr, callback);\par
00161 \par
00162                 {\cf20 // Remove enhancement data from bitstream leaving base codec bitstream}\par
00163                 memmove(data + i, data + e, data_size - e);\par
00164                 data_size = data_size + i - e;\par
00165             \}\par
00166         \}\par
00167     \}\par
00168 \par
00169     {\cf19 return} data_size;\par
00170 \}\par
00171 \par
00172 {\cf20 // Find any enhancement data in native EVC NAL Unit (u32 length-prefix) and pass to callback}\par
00173 {\cf20 //}\par
00174 {\cf17 static} {\cf18 size_t} scan_enhancement_nal_evc(uint8_t *data, {\cf18 size_t} data_size, uint64_t pts,\par
00175                                        std::function<{\cf18 void}({\cf17 const} Packet &pkt, {\cf17 const} {\cf18 bool} is_lcevc_idr)> callback) \{\par
00176     {\cf18 unsigned} offset = 0;\par
00177 \par
00178     {\cf19 while} (offset < data_size - 6) \{\par
00179         uint32_t nal_length = 0;\par
00180         memcpy(&nal_length, data + offset, 4);\par
00181         uint32_t total_length = nal_length + 4;\par
00182 \par
00183         {\cf19 if} ((data[offset + 4] & 0xfe) == 0x3c && (data[offset + 5] & 0x3f) == 0x00) \{\par
00184             {\cf17 const} {\cf18 unsigned} nal_unit_type = (data[offset + 4] & 0xf8) >> 3;\par
00185             {\cf17 const} {\cf18 bool} is_idr = (nal_unit_type == NalUnitType::LCEVC_IDR ? true : {\cf17 false});\par
00186 \par
00187             extract_enhancement_nal(data + offset + 6, nal_length - 2, {\cf17 false}, pts, is_idr, callback);\par
00188 \par
00189             memmove(data + offset, data + offset + total_length, data_size - (offset + total_length));\par
00190             data_size -= total_length;\par
00191         \} {\cf19 else} \{\par
00192             offset += total_length;\par
00193         \}\par
00194     \}\par
00195 \par
00196     {\cf19 return} data_size;\par
00197 \}\par
