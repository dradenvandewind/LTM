00047 {\cf18 void} applyPROFCore(Pel *dst, {\cf18 int} dstStride, {\cf17 const} Pel *src, {\cf18 int} srcStride, {\cf18 int} width, {\cf18 int} height, {\cf17 const} Pel *gradX,\par
00048                    {\cf17 const} Pel *gradY, {\cf18 int} gradStride, {\cf17 const} {\cf18 int} *dMvX, {\cf17 const} {\cf18 int} *dMvY, {\cf18 int} dMvStride, {\cf17 const} {\cf18 bool} &bi, {\cf18 int} shiftNum,\par
00049                    Pel offset, {\cf17 const} ClpRng &clpRng) \{\par
00050   {\cf18 int} idx = 0;\par
00051 \par
00052   {\cf17 const} {\cf18 int} dILimit = 1 << std::max<int>(clpRng.bd + 1, 13);\par
00053   {\cf19 for} ({\cf18 int} h = 0; h < height; h++)\par
00054   \{\par
00055     {\cf19 for} ({\cf18 int} w = 0; w < width; w++)\par
00056     \{\par
00057       int32_t dI = dMvX[idx] * gradX[w] + dMvY[idx] * gradY[w];\par
00058       dI = Clip3(-dILimit, dILimit - 1, dI);\par
00059       dst[w] = src[w] + dI;\par
00060       {\cf19 if} (!bi)\par
00061       \{\par
00062         dst[w] = (dst[w] + offset) >> shiftNum;\par
00063         dst[w] = ClipPel(dst[w], clpRng);\par
00064       \}\par
00065 \par
00066       idx++;\par
00067     \}\par
00068     gradX += gradStride;\par
00069     gradY += gradStride;\par
00070     dst += dstStride;\par
00071     src += srcStride;\par
00072   \}\par
00073 \}\par
00074 \par
