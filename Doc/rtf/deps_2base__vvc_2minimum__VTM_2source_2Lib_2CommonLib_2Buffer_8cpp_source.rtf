00091 {\cf18 void} addBIOAvgCore({\cf17 const} Pel* src0, {\cf18 int} src0Stride, {\cf17 const} Pel* src1, {\cf18 int} src1Stride, Pel *dst, {\cf18 int} dstStride, {\cf17 const} Pel *gradX0, {\cf17 const} Pel *gradX1, {\cf17 const} Pel *gradY0, {\cf17 const} Pel*gradY1, {\cf18 int} gradStride, {\cf18 int} width, {\cf18 int} height, {\cf18 int} tmpx, {\cf18 int} tmpy, {\cf18 int} shift, {\cf18 int} offset, {\cf17 const} ClpRng& clpRng)\par
00092 \{\par
00093   {\cf18 int} b = 0;\par
00094 \par
00095   {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00096   \{\par
00097     {\cf19 for} ({\cf18 int} x = 0; x < width; x += 4)\par
00098     \{\par
00099       b = tmpx * (gradX0[x] - gradX1[x]) + tmpy * (gradY0[x] - gradY1[x]);\par
00100       dst[x] = ClipPel(rightShift((src0[x] + src1[x] + b + offset), shift), clpRng);\par
00101 \par
00102       b = tmpx * (gradX0[x + 1] - gradX1[x + 1]) + tmpy * (gradY0[x + 1] - gradY1[x + 1]);\par
00103       dst[x + 1] = ClipPel(rightShift((src0[x + 1] + src1[x + 1] + b + offset), shift), clpRng);\par
00104 \par
00105       b = tmpx * (gradX0[x + 2] - gradX1[x + 2]) + tmpy * (gradY0[x + 2] - gradY1[x + 2]);\par
00106       dst[x + 2] = ClipPel(rightShift((src0[x + 2] + src1[x + 2] + b + offset), shift), clpRng);\par
00107 \par
00108       b = tmpx * (gradX0[x + 3] - gradX1[x + 3]) + tmpy * (gradY0[x + 3] - gradY1[x + 3]);\par
00109       dst[x + 3] = ClipPel(rightShift((src0[x + 3] + src1[x + 3] + b + offset), shift), clpRng);\par
00110     \}\par
00111     dst += dstStride;       src0 += src0Stride;     src1 += src1Stride;\par
00112     gradX0 += gradStride; gradX1 += gradStride; gradY0 += gradStride; gradY1 += gradStride;\par
00113   \}\par
00114 \}\par
