00399 {\cf18 void} AreaBuf<Pel>::scaleSignal({\cf17 const} {\cf18 int} scale, {\cf17 const} {\cf18 bool} dir, {\cf17 const} ClpRng& clpRng)\par
00400 \{\par
00401   Pel* dst = buf;\par
00402   Pel* src = buf;\par
00403   {\cf18 int} sign, absval;\par
00404   {\cf18 int} maxAbsclipBD = (1<<clpRng.bd) - 1;\par
00405 \par
00406   {\cf19 if} (dir) {\cf20 // forward}\par
00407   \{\par
00408     {\cf19 if} (width == 1)\par
00409     \{\par
00410       THROW({\cf22 "Blocks of width = 1 not supported"});\par
00411     \}\par
00412     {\cf19 else}\par
00413     \{\par
00414       {\cf19 for} ({\cf18 unsigned} y = 0; y < height; y++)\par
00415       \{\par
00416         {\cf19 for} ({\cf18 unsigned} x = 0; x < width; x++)\par
00417         \{\par
00418           sign = src[x] >= 0 ? 1 : -1;\par
00419           absval = sign * src[x];\par
00420           dst[x] = (Pel)Clip3(-maxAbsclipBD, maxAbsclipBD, sign * (((absval << CSCALE_FP_PREC) + (scale >> 1)) / scale));\par
00421         \}\par
00422         dst += stride;\par
00423         src += stride;\par
00424       \}\par
00425     \}\par
00426   \}\par
00427   {\cf19 else} {\cf20 // inverse}\par
00428   \{\par
00429     {\cf19 for} ({\cf18 unsigned} y = 0; y < height; y++)\par
00430     \{\par
00431       {\cf19 for} ({\cf18 unsigned} x = 0; x < width; x++)\par
00432       \{\par
00433         src[x] = (Pel)Clip3((Pel)(-maxAbsclipBD - 1), (Pel)maxAbsclipBD, src[x]);\par
00434         sign = src[x] >= 0 ? 1 : -1;\par
00435         absval = sign * src[x];\par
00436         {\cf18 int} val = sign * ((absval * scale + (1 << (CSCALE_FP_PREC - 1))) >> CSCALE_FP_PREC);\par
00437         {\cf19 if} ({\cf17 sizeof}(Pel) == 2) {\cf20 // avoid overflow when storing data}\par
00438         \{\par
00439            val = Clip3<int>(-32768, 32767, val);\par
00440         \}\par
00441         dst[x] = (Pel)val;\par
00442       \}\par
00443       dst += stride;\par
00444       src += stride;\par
00445     \}\par
00446   \}\par
00447 \}\par
