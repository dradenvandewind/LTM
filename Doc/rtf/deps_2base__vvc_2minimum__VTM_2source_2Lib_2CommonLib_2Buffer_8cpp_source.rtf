00327 {\cf18 void} paddingCore(Pel *ptr, {\cf18 int} stride, {\cf18 int} width, {\cf18 int} height, {\cf18 int} padSize)\par
00328 \{\par
00329   {\cf20 /*left and right padding*/}\par
00330   Pel *ptrTemp1 = ptr;\par
00331   Pel *ptrTemp2 = ptr + (width - 1);\par
00332   {\cf18 int} offset = 0;\par
00333   {\cf19 for} ({\cf18 int} i = 0; i < height; i++)\par
00334   \{\par
00335     offset = stride * i;\par
00336     {\cf19 for} ({\cf18 int} j = 1; j <= padSize; j++)\par
00337     \{\par
00338       *(ptrTemp1 - j + offset) = *(ptrTemp1 + offset);\par
00339       *(ptrTemp2 + j + offset) = *(ptrTemp2 + offset);\par
00340     \}\par
00341   \}\par
00342   {\cf20 /*Top and Bottom padding*/}\par
00343   {\cf18 int} numBytes = (width + padSize + padSize) * {\cf17 sizeof}(Pel);\par
00344   ptrTemp1 = (ptr - padSize);\par
00345   ptrTemp2 = (ptr + (stride * (height - 1)) - padSize);\par
00346   {\cf19 for} ({\cf18 int} i = 1; i <= padSize; i++)\par
00347   \{\par
00348     memcpy(ptrTemp1 - (i * stride), (ptrTemp1), numBytes);\par
00349     memcpy(ptrTemp2 + (i * stride), (ptrTemp2), numBytes);\par
00350   \}\par
00351 \}\par
