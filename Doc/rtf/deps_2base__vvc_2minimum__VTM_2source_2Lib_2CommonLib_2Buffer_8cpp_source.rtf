00548 {\cf21 #define RECO_INC        \\}\par
00549 {\cf21     srcp += srcStride;  \\}\par
00550 {\cf21     dest += destStride; \\}\par
00551 {\cf21 }\par
00552     SIZE_AWARE_PER_EL_OP( RECO_OP, RECO_INC );\par
00553 \par
00554 {\cf21 #undef RECO_OP}\par
00555 {\cf21 #undef RECO_INC}\par
00556   \}\par
00557 \}\par
