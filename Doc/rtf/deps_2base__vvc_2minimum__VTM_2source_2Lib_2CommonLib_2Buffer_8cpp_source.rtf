00076 {\cf17 template}< {\cf17 typename} T >\par
00077 {\cf18 void} addAvgCore( {\cf17 const} T* src1, {\cf18 int} src1Stride, {\cf17 const} T* src2, {\cf18 int} src2Stride, T* dest, {\cf18 int} dstStride, {\cf18 int} width, {\cf18 int} height, {\cf18 int} rshift, {\cf18 int} offset, {\cf17 const} ClpRng& clpRng )\par
00078 \{\par
00079 {\cf21 #define ADD_AVG_CORE_OP( ADDR ) dest[ADDR] = ClipPel( rightShift( ( src1[ADDR] + src2[ADDR] + offset ), rshift ), clpRng )}\par
00080 {\cf21 #define ADD_AVG_CORE_INC    \\}\par
00081 {\cf21   src1 += src1Stride;       \\}\par
00082 {\cf21   src2 += src2Stride;       \\}\par
00083 {\cf21   dest +=  dstStride;       \\}\par
00084 {\cf21 }\par
00085   SIZE_AWARE_PER_EL_OP( ADD_AVG_CORE_OP, ADD_AVG_CORE_INC );\par
00086 \par
00087 {\cf21 #undef ADD_AVG_CORE_OP}\par
00088 {\cf21 #undef ADD_AVG_CORE_INC}\par
00089 \}\par
