00117 {\cf18 void} gradFilterCore(Pel* pSrc, {\cf18 int} srcStride, {\cf18 int} width, {\cf18 int} height, {\cf18 int} gradStride, Pel* gradX, Pel* gradY, {\cf17 const} {\cf18 int} bitDepth)\par
00118 \{\par
00119   Pel* srcTmp = pSrc + srcStride + 1;\par
00120   Pel* gradXTmp = gradX + gradStride + 1;\par
00121   Pel* gradYTmp = gradY + gradStride + 1;\par
00122   {\cf18 int}  shift1 = 6;\par
00123 \par
00124   {\cf19 for} ({\cf18 int} y = 0; y < (height - 2 * BIO_EXTEND_SIZE); y++)\par
00125   \{\par
00126     {\cf19 for} ({\cf18 int} x = 0; x < (width - 2 * BIO_EXTEND_SIZE); x++)\par
00127     \{\par
00128       gradYTmp[x] = ( srcTmp[x + srcStride] >> shift1 ) - ( srcTmp[x - srcStride] >> shift1 );\par
00129       gradXTmp[x] = ( srcTmp[x + 1] >> shift1 ) - ( srcTmp[x - 1] >> shift1 );\par
00130     \}\par
00131     gradXTmp += gradStride;\par
00132     gradYTmp += gradStride;\par
00133     srcTmp += srcStride;\par
00134   \}\par
00135 \par
00136   {\cf19 if} (PAD)\par
00137   \{\par
00138   gradXTmp = gradX + gradStride + 1;\par
00139   gradYTmp = gradY + gradStride + 1;\par
00140   {\cf19 for} ({\cf18 int} y = 0; y < (height - 2 * BIO_EXTEND_SIZE); y++)\par
00141   \{\par
00142     gradXTmp[-1] = gradXTmp[0];\par
00143     gradXTmp[width - 2 * BIO_EXTEND_SIZE] = gradXTmp[width - 2 * BIO_EXTEND_SIZE - 1];\par
00144     gradXTmp += gradStride;\par
00145 \par
00146     gradYTmp[-1] = gradYTmp[0];\par
00147     gradYTmp[width - 2 * BIO_EXTEND_SIZE] = gradYTmp[width - 2 * BIO_EXTEND_SIZE - 1];\par
00148     gradYTmp += gradStride;\par
00149   \}\par
00150 \par
00151   gradXTmp = gradX + gradStride;\par
00152   gradYTmp = gradY + gradStride;\par
00153   ::memcpy(gradXTmp - gradStride, gradXTmp, {\cf17 sizeof}(Pel)*(width));\par
00154   ::memcpy(gradXTmp + (height - 2 * BIO_EXTEND_SIZE)*gradStride, gradXTmp + (height - 2 * BIO_EXTEND_SIZE - 1)*gradStride, {\cf17 sizeof}(Pel)*(width));\par
00155   ::memcpy(gradYTmp - gradStride, gradYTmp, {\cf17 sizeof}(Pel)*(width));\par
00156   ::memcpy(gradYTmp + (height - 2 * BIO_EXTEND_SIZE)*gradStride, gradYTmp + (height - 2 * BIO_EXTEND_SIZE - 1)*gradStride, {\cf17 sizeof}(Pel)*(width));\par
00157   \}\par
00158 \}\par
