00160 {\cf18 void} calcBIOSumsCore({\cf17 const} Pel* srcY0Tmp, {\cf17 const} Pel* srcY1Tmp, Pel* gradX0, Pel* gradX1, Pel* gradY0, Pel* gradY1, {\cf18 int} xu, {\cf18 int} yu, {\cf17 const} {\cf18 int} src0Stride, {\cf17 const} {\cf18 int} src1Stride, {\cf17 const} {\cf18 int} widthG, {\cf17 const} {\cf18 int} bitDepth, {\cf18 int}* sumAbsGX, {\cf18 int}* sumAbsGY, {\cf18 int}* sumDIX, {\cf18 int}* sumDIY, {\cf18 int}* sumSignGY_GX)\par
00161 \{\par
00162   {\cf18 int} shift4 = 4;\par
00163   {\cf18 int} shift5 = 1;\par
00164 \par
00165   {\cf19 for} ({\cf18 int} y = 0; y < 6; y++)\par
00166   \{\par
00167     {\cf19 for} ({\cf18 int} x = 0; x < 6; x++)\par
00168     \{\par
00169       {\cf18 int} tmpGX = (gradX0[x] + gradX1[x]) >> shift5;\par
00170       {\cf18 int} tmpGY = (gradY0[x] + gradY1[x]) >> shift5;\par
00171       {\cf18 int} tmpDI = (int)((srcY1Tmp[x] >> shift4) - (srcY0Tmp[x] >> shift4));\par
00172       *sumAbsGX += (tmpGX < 0 ? -tmpGX : tmpGX);\par
00173       *sumAbsGY += (tmpGY < 0 ? -tmpGY : tmpGY);\par
00174       *sumDIX += (tmpGX < 0 ? -tmpDI : (tmpGX == 0 ? 0 : tmpDI));\par
00175       *sumDIY += (tmpGY < 0 ? -tmpDI : (tmpGY == 0 ? 0 : tmpDI));\par
00176       *sumSignGY_GX += (tmpGY < 0 ? -tmpGX : (tmpGY == 0 ? 0 : tmpGX));\par
00177 \par
00178     \}\par
00179     srcY1Tmp += src1Stride;\par
00180     srcY0Tmp += src0Stride;\par
00181     gradX0 += widthG;\par
00182     gradX1 += widthG;\par
00183     gradY0 += widthG;\par
00184     gradY1 += widthG;\par
00185   \}\par
00186 \}\par
