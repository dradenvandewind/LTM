00559 {\cf17 template}<>\par
00560 {\cf18 void} AreaBuf<Pel>::roundToOutputBitdepth( {\cf17 const} AreaBuf<const Pel> &src, {\cf17 const} ClpRng& clpRng )\par
00561 \{\par
00562   {\cf17 const} Pel* srcp = src.buf;\par
00563         Pel* dest =     buf;\par
00564   {\cf17 const} {\cf18 unsigned} srcStride  = src.stride;\par
00565   {\cf17 const} {\cf18 unsigned} destStride = stride;\par
00566 \par
00567   {\cf17 const} int32_t clipbd            = clpRng.bd;\par
00568   {\cf17 const} int32_t shiftDefault      = IF_INTERNAL_FRAC_BITS(clipbd);\par
00569   {\cf17 const} int32_t offsetDefault     = (1<<(shiftDefault-1)) + IF_INTERNAL_OFFS;\par
00570 \par
00571   {\cf19 if}( width == 1 )\par
00572   \{\par
00573     THROW( {\cf22 "Blocks of width = 1 not supported"} );\par
00574   \}\par
00575   {\cf19 else}\par
00576   \{\par
00577 {\cf21 #define RND_OP( ADDR ) dest[ADDR] = ClipPel( rightShift( srcp[ADDR] + offsetDefault, shiftDefault), clpRng )}\par
00578 {\cf21 #define RND_INC        \\}\par
00579 {\cf21     srcp += srcStride;  \\}\par
00580 {\cf21     dest += destStride; \\}\par
00581 {\cf21 }\par
00582     SIZE_AWARE_PER_EL_OP( RND_OP, RND_INC );\par
00583 \par
00584 {\cf21 #undef RND_OP}\par
00585 {\cf21 #undef RND_INC}\par
00586   \}\par
00587 \}\par
00588 \par
