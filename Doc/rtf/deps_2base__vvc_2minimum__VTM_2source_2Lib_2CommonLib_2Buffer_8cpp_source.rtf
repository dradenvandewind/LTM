00748 {\cf18 void} PelStorage::swap( PelStorage& other )\par
00749 \{\par
00750   {\cf17 const} uint32_t numCh = vtm::getNumberValidComponents( chromaFormat );\par
00751 \par
00752   {\cf19 for}( uint32_t i = 0; i < numCh; i++ )\par
00753   \{\par
00754     {\cf20 // check this otherwise it would turn out to get very weird}\par
00755     CHECK( chromaFormat                   != other.chromaFormat                  , {\cf22 "Incompatible formats"} );\par
00756     CHECK( get( ComponentID( i ) )        != other.get( ComponentID( i ) )       , {\cf22 "Incompatible formats"} );\par
00757     CHECK( get( ComponentID( i ) ).stride != other.get( ComponentID( i ) ).stride, {\cf22 "Incompatible formats"} );\par
00758 \par
00759     std::swap( bufs[i].buf,    other.bufs[i].buf );\par
00760     std::swap( bufs[i].stride, other.bufs[i].stride );\par
00761     std::swap( m_origin[i],    other.m_origin[i] );\par
00762   \}\par
00763 \}\par
