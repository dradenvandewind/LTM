00688 {\cf18 void} PelStorage::create( {\cf17 const} ChromaFormat &_chromaFormat, {\cf17 const} Area& _area, {\cf17 const} {\cf18 unsigned} _maxCUSize, {\cf17 const} {\cf18 unsigned} _margin, {\cf17 const} {\cf18 unsigned} _alignment, {\cf17 const} {\cf18 bool} _scaleChromaMargin )\par
00689 \{\par
00690   CHECK( !bufs.empty(), {\cf22 "Trying to re-create an already initialized buffer"} );\par
00691 \par
00692   chromaFormat = _chromaFormat;\par
00693 \par
00694   {\cf17 const} uint32_t numCh = getNumberValidComponents( _chromaFormat );\par
00695 \par
00696   {\cf18 unsigned} extHeight = _area.height;\par
00697   {\cf18 unsigned} extWidth  = _area.width;\par
00698 \par
00699   {\cf19 if}( _maxCUSize )\par
00700   \{\par
00701     extHeight = ( ( _area.height + _maxCUSize - 1 ) / _maxCUSize ) * _maxCUSize;\par
00702     extWidth  = ( ( _area.width  + _maxCUSize - 1 ) / _maxCUSize ) * _maxCUSize;\par
00703   \}\par
00704 \par
00705   {\cf19 for}( uint32_t i = 0; i < numCh; i++ )\par
00706   \{\par
00707     {\cf17 const} ComponentID compID = ComponentID( i );\par
00708     {\cf17 const} {\cf18 unsigned} scaleX = vtm::getComponentScaleX( compID, _chromaFormat );\par
00709     {\cf17 const} {\cf18 unsigned} scaleY = vtm::getComponentScaleY( compID, _chromaFormat );\par
00710 \par
00711     {\cf18 unsigned} scaledHeight = extHeight >> scaleY;\par
00712     {\cf18 unsigned} scaledWidth  = extWidth  >> scaleX;\par
00713     {\cf18 unsigned} ymargin      = _margin >> (_scaleChromaMargin?scaleY:0);\par
00714     {\cf18 unsigned} xmargin      = _margin >> (_scaleChromaMargin?scaleX:0);\par
00715     {\cf18 unsigned} totalWidth   = scaledWidth + 2*xmargin;\par
00716     {\cf18 unsigned} totalHeight  = scaledHeight +2*ymargin;\par
00717 \par
00718     {\cf19 if}( _alignment )\par
00719     \{\par
00720       {\cf20 // make sure buffer lines are align}\par
00721       CHECK( _alignment != MEMORY_ALIGN_DEF_SIZE, {\cf22 "Unsupported alignment"} );\par
00722       totalWidth = ( ( totalWidth + _alignment - 1 ) / _alignment ) * _alignment;\par
00723     \}\par
00724     uint32_t area = totalWidth * totalHeight;\par
00725     CHECK( !area, {\cf22 "Trying to create a buffer with zero area"} );\par
00726 \par
00727     m_origin[i] = ( Pel* ) xMalloc( Pel, area );\par
00728     Pel* topLeft = m_origin[i] + totalWidth * ymargin + xmargin;\par
00729     bufs.push_back( PelBuf( topLeft, totalWidth, _area.width >> scaleX, _area.height >> scaleY ) );\par
00730   \}\par
00731 \}\par
00732 \par
00733 {\cf18 void} PelStorage::createFromBuf( PelUnitBuf buf )\par
00734 \{\par
00735   chromaFormat = buf.chromaFormat;\par
00736 \par
