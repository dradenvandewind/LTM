00626 {\cf17 template}<>\par
00627 {\cf18 void} AreaBuf<Pel>::linearTransform( {\cf17 const} {\cf18 int} scale, {\cf17 const} {\cf18 int} shift, {\cf17 const} {\cf18 int} offset, {\cf18 bool} bClip, {\cf17 const} ClpRng& clpRng )\par
00628 \{\par
00629   {\cf17 const} Pel* src = buf;\par
00630         Pel* dst = buf;\par
00631 \par
00632   {\cf19 if}( width == 1 )\par
00633   \{\par
00634     THROW( {\cf22 "Blocks of width = 1 not supported"} );\par
00635   \}\par
00636 {\cf21 #if ENABLE_SIMD_OPT_BUFFER && defined(TARGET_SIMD_X86)}\par
00637   {\cf19 else} {\cf19 if}( ( width & 7 ) == 0 )\par
00638   \{\par
00639     g_pelBufOP.linTf8( src, stride, dst, stride, width, height, scale, shift, offset, clpRng, bClip );\par
00640   \}\par
00641   {\cf19 else} {\cf19 if}( ( width & 3 ) == 0 )\par
00642   \{\par
00643     g_pelBufOP.linTf4( src, stride, dst, stride, width, height, scale, shift, offset, clpRng, bClip );\par
00644   \}\par
00645 {\cf21 #endif}\par
00646   {\cf19 else}\par
00647   \{\par
00648 {\cf21 #define LINTF_OP( ADDR ) dst[ADDR] = ( Pel ) bClip ? ClipPel( rightShift( scale * src[ADDR], shift ) + offset, clpRng ) : ( rightShift( scale * src[ADDR], shift ) + offset )}\par
00649 {\cf21 #define LINTF_INC        \\}\par
00650 {\cf21     src += stride;       \\}\par
00651 {\cf21     dst += stride;       \\}\par
00652 {\cf21 }\par
00653     SIZE_AWARE_PER_EL_OP( LINTF_OP, LINTF_INC );\par
00654 \par
00655 {\cf21 #undef RECO_OP}\par
00656 {\cf21 #undef RECO_INC}\par
00657   \}\par
00658 \}\par
