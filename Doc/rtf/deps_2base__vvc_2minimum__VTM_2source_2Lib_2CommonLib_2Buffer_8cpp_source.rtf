00590 {\cf17 template}<>\par
00591 {\cf18 void} AreaBuf<Pel>::reconstruct( {\cf17 const} AreaBuf<const Pel> &pred, {\cf17 const} AreaBuf<const Pel> &resi, {\cf17 const} ClpRng& clpRng )\par
00592 \{\par
00593   {\cf17 const} Pel* src1 = pred.buf;\par
00594   {\cf17 const} Pel* src2 = resi.buf;\par
00595         Pel* dest =      buf;\par
00596 \par
00597   {\cf17 const} {\cf18 unsigned} src1Stride = pred.stride;\par
00598   {\cf17 const} {\cf18 unsigned} src2Stride = resi.stride;\par
00599   {\cf17 const} {\cf18 unsigned} destStride =      stride;\par
00600 \par
00601 {\cf21 #if ENABLE_SIMD_OPT_BUFFER && defined(TARGET_SIMD_X86)}\par
00602   {\cf19 if}( ( width & 7 ) == 0 )\par
00603   \{\par
00604     g_pelBufOP.reco8( src1, src1Stride, src2, src2Stride, dest, destStride, width, height, clpRng );\par
00605   \}\par
00606   {\cf19 else} {\cf19 if}( ( width & 3 ) == 0 )\par
00607   \{\par
00608     g_pelBufOP.reco4( src1, src1Stride, src2, src2Stride, dest, destStride, width, height, clpRng );\par
00609   \}\par
00610   {\cf19 else}\par
00611 {\cf21 #endif}\par
00612   \{\par
00613 {\cf21 #define RECO_OP( ADDR ) dest[ADDR] = ClipPel( src1[ADDR] + src2[ADDR], clpRng )}\par
00614 {\cf21 #define RECO_INC        \\}\par
00615 {\cf21     src1 += src1Stride; \\}\par
00616 {\cf21     src2 += src2Stride; \\}\par
00617 {\cf21     dest += destStride; \\}\par
00618 {\cf21 }\par
00619     SIZE_AWARE_PER_EL_OP( RECO_OP, RECO_INC );\par
00620 \par
00621 {\cf21 #undef RECO_OP}\par
00622 {\cf21 #undef RECO_INC}\par
00623   \}\par
00624 \}\par
