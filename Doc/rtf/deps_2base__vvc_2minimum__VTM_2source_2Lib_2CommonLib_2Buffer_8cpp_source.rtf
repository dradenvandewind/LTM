00814 {\cf17 template}<>\par
00815 {\cf18 void} UnitBuf<Pel>::colorSpaceConvert({\cf17 const} UnitBuf<Pel> &other, {\cf17 const} {\cf18 bool} forward, {\cf17 const} ClpRng& clpRng)\par
00816 \{\par
00817   {\cf17 const} Pel* pOrg0 = bufs[COMPONENT_Y].buf;\par
00818   {\cf17 const} Pel* pOrg1 = bufs[COMPONENT_Cb].buf;\par
00819   {\cf17 const} Pel* pOrg2 = bufs[COMPONENT_Cr].buf;\par
00820   {\cf17 const} {\cf18 int}  strideOrg = bufs[COMPONENT_Y].stride;\par
00821 \par
00822   Pel* pDst0 = other.bufs[COMPONENT_Y].buf;\par
00823   Pel* pDst1 = other.bufs[COMPONENT_Cb].buf;\par
00824   Pel* pDst2 = other.bufs[COMPONENT_Cr].buf;\par
00825   {\cf17 const} {\cf18 int} strideDst = other.bufs[COMPONENT_Y].stride;\par
00826 \par
00827   {\cf18 int} width = bufs[COMPONENT_Y].width;\par
00828   {\cf18 int} height = bufs[COMPONENT_Y].height;\par
00829   {\cf18 int} maxAbsclipBD = (1 << (clpRng.bd + 1)) - 1;\par
00830   {\cf18 int} r, g, b;\par
00831   {\cf18 int} y0, cg, co;\par
00832 \par
00833   CHECK(bufs[COMPONENT_Y].stride != bufs[COMPONENT_Cb].stride || bufs[COMPONENT_Y].stride != bufs[COMPONENT_Cr].stride, {\cf22 "unequal stride for 444 content"});\par
00834   CHECK(other.bufs[COMPONENT_Y].stride != other.bufs[COMPONENT_Cb].stride || other.bufs[COMPONENT_Y].stride != other.bufs[COMPONENT_Cr].stride, {\cf22 "unequal stride for 444 content"});\par
00835   CHECK(bufs[COMPONENT_Y].width != other.bufs[COMPONENT_Y].width || bufs[COMPONENT_Y].height != other.bufs[COMPONENT_Y].height, {\cf22 "unequal block size"})\par
00836 \par
00837     {\cf19 if} (forward)\par
00838     \{\par
00839       {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00840       \{\par
00841         {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00842         \{\par
00843           r = pOrg2[x];\par
00844           g = pOrg0[x];\par
00845           b = pOrg1[x];\par
00846 \par
00847           co = r - b;\par
00848           {\cf18 int} t = b + (co >> 1);\par
00849           cg = g - t;\par
00850           pDst0[x] = t + (cg >> 1);\par
00851           pDst1[x] = cg;\par
00852           pDst2[x] = co;\par
00853         \}\par
00854         pOrg0 += strideOrg;\par
00855         pOrg1 += strideOrg;\par
00856         pOrg2 += strideOrg;\par
00857         pDst0 += strideDst;\par
00858         pDst1 += strideDst;\par
00859         pDst2 += strideDst;\par
00860       \}\par
00861     \}\par
00862     {\cf19 else}\par
00863     \{\par
00864       {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00865       \{\par
00866         {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00867         \{\par
00868           y0 = pOrg0[x];\par
00869           cg = pOrg1[x];\par
00870           co = pOrg2[x];\par
00871 \par
00872           y0 = Clip3((-maxAbsclipBD - 1), maxAbsclipBD, y0);\par
00873           cg = Clip3((-maxAbsclipBD - 1), maxAbsclipBD, cg);\par
00874           co = Clip3((-maxAbsclipBD - 1), maxAbsclipBD, co);\par
00875 \par
00876           {\cf18 int} t = y0 - (cg >> 1);\par
00877           pDst0[x] = cg + t;\par
00878           pDst1[x] = t - (co >> 1);\par
00879           pDst2[x] = co + pDst1[x];\par
00880         \}\par
00881 \par
00882         pOrg0 += strideOrg;\par
00883         pOrg1 += strideOrg;\par
00884         pOrg2 += strideOrg;\par
00885         pDst0 += strideDst;\par
00886         pDst1 += strideDst;\par
00887         pDst2 += strideDst;\par
00888       \}\par
00889     \}\par
00890 \}\par
00891 \par
