00075 uint32_t GetBitCountFromMax(uint32_t maxValue) \{\par
00076     {\cf20 // Bit count is determined by ceil(log2(maxRepresentation);}\par
00077     {\cf20 // Because log2 is c99 which is not so widely available we can use standard log with a divide.}\par
00078     {\cf20 // log2(x) = logY(x) / logY(2)}\par
00079     {\cf20 //}\par
00080     {\cf20 // Alternatively we want to find the highest bit set in maxValue.}\par
00081     {\cf17 static} {\cf17 const} {\cf18 float} logBase = log(2.0f);\par
00082     {\cf18 float} log2Value = log({\cf17 static_cast<}{\cf18 float}{\cf17 >}(maxValue)) / logBase;\par
00083     {\cf19 return} {\cf17 static_cast<}uint32_t{\cf17 >}(ceil(log2Value));\par
00084 \}\par
