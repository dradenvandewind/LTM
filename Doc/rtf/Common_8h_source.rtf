00168 {\cf17 inline} Area clipArea({\cf17 const} Area &_area, {\cf17 const} Area &boundingBox)\par
00169 \{\par
00170   Area area = _area;\par
00171 \par
00172   {\cf19 if} (area.x + area.width > boundingBox.x + boundingBox.width)\par
00173   \{\par
