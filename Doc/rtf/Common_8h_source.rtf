00186 {\cf17 class }SizeIndexInfo\par
00187 \{\par
00188 {\cf17 public}:\par
00189   SizeIndexInfo()\{\}\par
00190   {\cf17 virtual} ~SizeIndexInfo()\{\}\par
00191   SizeType numAllWidths()               \{ {\cf19 return} (SizeType)m_idxToSizeTab.size(); \}\par
00192   SizeType numAllHeights()              \{ {\cf19 return} (SizeType)m_idxToSizeTab.size(); \}\par
00193   SizeType numWidths()                  \{ {\cf19 return} (SizeType)m_numBlkSizes; \}\par
00194   SizeType numHeights()                 \{ {\cf19 return} (SizeType)m_numBlkSizes; \}\par
00195   SizeType sizeFrom( SizeType idx )     \{ {\cf19 return} m_idxToSizeTab[idx]; \}\par
00196   SizeType idxFrom( SizeType size )     \{ CHECKD( m_sizeToIdxTab[size] == std::numeric_limits<SizeType>::max(), {\cf22 "Index of given size does NOT EXIST!"} ); {\cf19 return} m_sizeToIdxTab[size]; \}\par
00197   {\cf18 bool}     isCuSize( SizeType size )    \{ {\cf19 return} m_isCuSize[size]; \}\par
00198   {\cf17 virtual} {\cf18 void} init( SizeType maxSize ) \{\}\par
00199 \par
00200 {\cf17 protected}:\par
00201 \par
00202   {\cf18 void} xInit()\par
00203   \{\par
00204     m_isCuSize.resize( m_sizeToIdxTab.size(), {\cf17 false} );\par
00205 \par
00206     std::vector<SizeType> grpSizes;\par
00207 \par
00208     {\cf19 for}( {\cf18 int} i = 0, n = 0; i < m_sizeToIdxTab.size(); i++ )\par
00209     \{\par
00210       {\cf19 if}( m_sizeToIdxTab[i] != std::numeric_limits<SizeType>::max() )\par
00211       \{\par
00212         m_sizeToIdxTab[i] = n;\par
00213         m_idxToSizeTab.push_back( i );\par
00214         n++;\par
00215       \}\par
00216 \par
00217       {\cf19 if}( m_sizeToIdxTab[i] != std::numeric_limits<SizeType>::max() && m_sizeToIdxTab[i >> 1] != std::numeric_limits<SizeType>::max() && i >= 4 )\par
00218       \{\par
00219         m_isCuSize[i] = {\cf17 true};\par
00220       \}\par
00221 \par
00222       {\cf20 // collect group sizes (for coefficient group coding)}\par
00223       SizeType grpSize = i >> ( ( i & 3 ) != 0 ? 1 : 2 );\par
00224       {\cf19 if}( m_sizeToIdxTab[i] != std::numeric_limits<SizeType>::max() && m_sizeToIdxTab[grpSize] == std::numeric_limits<SizeType>::max() )\par
00225       \{\par
00226         grpSizes.push_back( grpSize );\par
00227       \}\par
00228     \}\par
00229 \par
00230     m_numBlkSizes = (SizeType)m_idxToSizeTab.size();\par
00231 \par
00232     {\cf19 for}( SizeType grpSize : grpSizes )\par
00233     \{\par
00234       {\cf19 if}( grpSize > 0 && m_sizeToIdxTab[grpSize] == std::numeric_limits<SizeType>::max() )\par
00235       \{\par
00236         m_sizeToIdxTab[grpSize] = (SizeType)m_idxToSizeTab.size();\par
00237         m_idxToSizeTab.push_back( grpSize );\par
00238       \}\par
00239     \}\par
00240   \};\par
00241 \par
00242   std::vector<bool    > m_isCuSize;\par
00243   {\cf18 int}                   m_numBlkSizes; {\cf20 // as opposed to number all sizes, which also contains grouped sizes}\par
00244   std::vector<SizeType> m_sizeToIdxTab;\par
00245   std::vector<SizeType> m_idxToSizeTab;\par
00246 \};\par
00247 \par
00248 {\cf17 class }SizeIndexInfoLog2 : {\cf17 public} SizeIndexInfo\par
00249 \{\par
00250 {\cf17 public}:\par
00251   SizeIndexInfoLog2()\{\}\par
00252   ~SizeIndexInfoLog2()\{\};\par
00253 \par
00254   {\cf18 void} init( SizeType maxSize )\par
00255   \{\par
00256     {\cf19 for}( {\cf18 int} i = 0, n = 0; i <= maxSize; i++ )\par
00257     \{\par
00258       SizeType val = std::numeric_limits<SizeType>::max();\par
00259       {\cf19 if}( i == ( 1 << n ) )\par
00260       \{\par
00261         n++;\par
00262         val = i;\par
00263       \}\par
00264       m_sizeToIdxTab.push_back( val );\par
00265     \}\par
00266     SizeIndexInfo::xInit();\par
00267   \}\par
