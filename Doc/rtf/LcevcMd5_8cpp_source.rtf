00201 {\cf18 void} lcevc_md5_update_16(LCEVC_MD5 *md5, {\cf18 void} *buf_t, u32 len) \{\par
00202     u16 *buf;\par
00203     u32 i, idx, part_len, j;\par
00204     u8 t[512];\par
00205 \par
00206     buf = (u16 *)buf_t;\par
00207     idx = (u32)((md5->bits[0] >> 3) & 0x3f);\par
00208 \par
00209     len = len * 2;\par
00210     {\cf19 for} (j = 0; j < len; j += 2) \{\par
00211         t[j] = (u8)(*(buf));\par
00212         t[j + 1] = *(buf) >> 8;\par
00213         buf++;\par
00214     \}\par
00215 \par
00216     md5->bits[0] += (len << 3);\par
00217     {\cf19 if} (md5->bits[0] < (len << 3)) \{\par
00218         (md5->bits[1])++;\par
00219     \}\par
00220 \par
00221     md5->bits[1] += (len >> 29);\par
00222     part_len = 64 - idx;\par
00223 \par
00224     {\cf19 if} (len >= part_len) \{\par
00225         lcevc_mcpy(md5->msg + idx, t, part_len);\par
00226         lcevc_md5_trans(md5->h, (u32 *)md5->msg);\par
00227 \par
00228         {\cf19 for} (i = part_len; i + 63 < len; i += 64) \{\par
00229             lcevc_md5_trans(md5->h, (u32 *)(t + i));\par
00230         \}\par
00231         idx = 0;\par
00232     \} {\cf19 else} \{\par
00233         i = 0;\par
00234     \}\par
00235 \par
00236     {\cf19 if} (len - i > 0) \{\par
00237         lcevc_mcpy(md5->msg + idx, t + i, len - i);\par
00238     \}\par
00239 \}\par
