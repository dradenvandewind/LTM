00291 {\cf18 int} lcevc_md5_imgb(LCEVC_IMGB *imgb, u8 digest[N_C][16]) \{\par
00292     LCEVC_MD5 md5[N_C];\par
00293     {\cf18 int} i, j;\par
00294 \par
