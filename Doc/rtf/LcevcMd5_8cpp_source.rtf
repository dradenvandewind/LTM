00166 {\cf18 void} lcevc_md5_update(LCEVC_MD5 *md5, {\cf18 void} *buf_t, u32 len) \{\par
00167     u8 *buf;\par
00168     u32 i, idx, part_len;\par
00169 \par
00170     buf = (u8 *)buf_t;\par
00171 \par
00172     idx = (u32)((md5->bits[0] >> 3) & 0x3f);\par
00173 \par
00174     md5->bits[0] += (len << 3);\par
00175     {\cf19 if} (md5->bits[0] < (len << 3)) \{\par
00176         (md5->bits[1])++;\par
00177     \}\par
00178 \par
00179     md5->bits[1] += (len >> 29);\par
00180     part_len = 64 - idx;\par
00181 \par
00182     {\cf19 if} (len >= part_len) \{\par
00183         lcevc_mcpy(md5->msg + idx, buf, part_len);\par
00184         lcevc_md5_trans(md5->h, (u32 *)md5->msg);\par
00185 \par
00186         {\cf19 for} (i = part_len; i + 63 < len; i += 64) \{\par
00187             lcevc_md5_trans(md5->h, (u32 *)(buf + i));\par
00188         \}\par
00189         idx = 0;\par
00190     \} {\cf19 else} \{\par
00191         i = 0;\par
00192     \}\par
00193 \par
00194     {\cf19 if} (len - i > 0) \{\par
00195         lcevc_mcpy(md5->msg + idx, buf + i, len - i);\par
00196     \}\par
00197 \}\par
