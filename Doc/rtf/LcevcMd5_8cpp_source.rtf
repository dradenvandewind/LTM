00296         lcevc_md5_init(&md5[i]);\par
00297 \par
00298         {\cf20 // fprintf(stdout, "p %4d - h %4d - w %4d - s %4d \\n", i, imgb->h[i], imgb->w[i], imgb->s[i]); fflush(stdout);}\par
00299 \par
00300         {\cf19 for} (j = imgb->y[i]; j < imgb->h[i]; j++) \{\par
