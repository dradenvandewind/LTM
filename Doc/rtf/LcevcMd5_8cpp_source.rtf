00243 {\cf18 void} lcevc_md5_finish(LCEVC_MD5 *md5, u8 digest[16]) \{\par
00244     u8 *pos;\par
00245     {\cf18 int} cnt;\par
00246 \par
00247     cnt = (md5->bits[0] >> 3) & 0x3F;\par
00248     pos = md5->msg + cnt;\par
00249     *pos++ = 0x80;\par
00250     cnt = 64 - 1 - cnt;\par
00251 \par
00252     {\cf19 if} (cnt < 8) \{\par
00253         lcevc_mset(pos, 0, cnt);\par
00254         lcevc_md5_trans(md5->h, (u32 *)md5->msg);\par
00255         lcevc_mset(md5->msg, 0, 56);\par
00256     \} {\cf19 else} \{\par
00257         lcevc_mset(pos, 0, cnt - 8);\par
00258     \}\par
00259 \par
00260     lcevc_mcpy((md5->msg + 14 * {\cf17 sizeof}(u32)), &md5->bits[0], {\cf17 sizeof}(u32));\par
00261     lcevc_mcpy((md5->msg + 15 * {\cf17 sizeof}(u32)), &md5->bits[1], {\cf17 sizeof}(u32));\par
00262 \par
00263     lcevc_md5_trans(md5->h, (u32 *)md5->msg);\par
00264     lcevc_mcpy(digest, md5->h, 16);\par
00265     lcevc_mset(md5, 0, {\cf17 sizeof}(LCEVC_MD5));\par
00266 \}\par
