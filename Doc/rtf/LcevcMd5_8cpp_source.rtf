00154 {\cf18 void} lcevc_md5_init(LCEVC_MD5 *md5) \{\par
00155     md5->h[0] = 0x67452301;\par
00156     md5->h[1] = 0xefcdab89;\par
00157     md5->h[2] = 0x98badcfe;\par
00158     md5->h[3] = 0x10325476;\par
00159 \par
00160     md5->bits[0] = 0;\par
00161     md5->bits[1] = 0;\par
00162 \}\par
