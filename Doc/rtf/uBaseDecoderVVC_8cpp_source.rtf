00300 {\cf18 bool} BaseDecoderVVC::ParseSliceHeader(InputBitstream &bitstream) \{\par
00301 {\cf21 #if defined __BASE_VVC__}\par
00302     Slice *slice = {\cf17 new} Slice();\par
00303     slice->setPicHeader(&m_picHeader);\par
00304     slice->initSlice();\par
00305 \par
00306     slice->setNalUnitType((NalUnitType)m_nalUnitType);\par
00307     slice->setNalUnitLayerId(m_nuhLayerId);\par
00308     slice->setTLayer(m_temporalId);\par
00309 \par
00310     m_reader.setBitstream(&bitstream);\par
00311     {\cf20 // m_reader.parseSliceHeader(slice, &m_picHeader, &m_parameterSetManager, m_prevTid0POC);}\par
00312     m_reader.parseSliceHeader(slice, &m_picHeader, &m_parameterSetManager, m_prevTid0POC, m_prevPOC);\par
00313 \par
00314     PPS *pps = m_parameterSetManager.getPPS(m_picHeader.getPPSId());\par
00315     CHECK(pps);\par
00316     SPS *sps = m_parameterSetManager.getSPS(pps->getSPSId());\par
00317     CHECK(sps);\par
00318 \par
00319     {\cf20 // Taking in consideration the conformance window}\par
00320     m_width = pps->getPicWidthInLumaSamples() -\par
00321         sps->getWinUnitX(sps->getChromaFormatIdc()) * \par
00322         (pps->getConformanceWindow().getWindowLeftOffset() + pps->getConformanceWindow().getWindowRightOffset());\par
00323     m_height = pps->getPicHeightInLumaSamples() - \par
00324         sps->getWinUnitY(sps->getChromaFormatIdc()) *\par
00325         (pps->getConformanceWindow().getWindowTopOffset() + pps->getConformanceWindow().getWindowBottomOffset());\par
00326 \par
00327     m_bitdepthLuma = sps->getBitDepth(CHANNEL_TYPE_LUMA);\par
00328     m_bitdepthChroma = sps->getBitDepth(CHANNEL_TYPE_CHROMA);\par
00329     m_chromaFormatIDC = sps->getChromaFormatIdc();\par
00330 \par
00331     {\cf19 if} (slice->isIDRorBLA())\par
00332         m_basePictureType = BaseDecPictType::IDR;\par
00333     {\cf19 else} \{\par
00334         {\cf19 switch} (slice->getSliceType()) \{\par
00335         {\cf19 case} B_SLICE:\par
00336             m_basePictureType = BaseDecPictType::B;\par
00337             {\cf19 break};\par
00338         {\cf19 case} P_SLICE:\par
00339             m_basePictureType = BaseDecPictType::P;\par
00340             {\cf19 break};\par
00341         {\cf19 case} I_SLICE:\par
00342             m_basePictureType = BaseDecPictType::I;\par
00343             {\cf19 break};\par
00344         {\cf19 default}:\par
00345             CHECK(0);\par
00346         \}\par
00347     \}\par
00348 \par
00349     m_pictureOrderCount = slice->getPOC();\par
00350 \par
00351     m_QP = slice->getSliceQp();\par
00352 \par
00353     {\cf19 if} (slice->getTLayer() == 0 &&\par
00354         slice->getNalUnitType() != NAL_UNIT_CODED_SLICE_RASL &&\par
00355         slice->getNalUnitType() != NAL_UNIT_CODED_SLICE_RADL) \{\par
00356         m_prevTid0POC = slice->getPOC();\par
00357     \}\par
00358 {\cf21 #endif }{\cf20 // defined __BASE_VVC__}\par
00359     {\cf19 return} {\cf17 true};\par
00360 \}\par
