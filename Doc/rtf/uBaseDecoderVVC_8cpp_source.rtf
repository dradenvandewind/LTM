00132 {\cf18 bool} BaseDecoderVVC::ParseNalUnit({\cf17 const} uint8_t *nal, uint32_t nalLength) \{\par
00133     {\cf18 bool} bSuccess = {\cf17 true};\par
00134 \par
00135 {\cf21 #if defined __BASE_VVC__}\par
00136     {\cf20 // Account for AnnexB nal unit header ([0],0,0,1)}\par
00137     uint32_t offset = uOffsetForNalUnitHeader(nal);\par
00138 \par
00139     m_nuhLayerId = nal[offset+0] & 0x3f;\par
00140     m_nalUnitType = ((nal[offset+1] >> 3) & 0x1F);\par
00141     m_temporalId = (nal[offset + 1] & 0x07) - 1;\par
00142 \par
00143     offset += 2;\par
00144 \par
00145     nal += offset;\par
00146     nalLength -= offset;\par
00147 \par
00148     InputBitstream bitstream;\par
00149     Unencapsulate(nal, nalLength, bitstream.getFifo());\par
00150 \par
00151     {\cf19 switch} (m_nalUnitType) \{\par
00152     {\cf19 case} NAL_UNIT_VPS:\par
00153         bSuccess = ParseVPS(bitstream);\par
00154         {\cf19 break};\par
00155     {\cf19 case} NAL_UNIT_PPS:\par
00156         bSuccess = ParsePPS(bitstream);\par
