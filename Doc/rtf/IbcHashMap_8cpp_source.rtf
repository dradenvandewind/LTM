00171 uint32_t IbcHashMap::xxComputeCrc32c16bit(uint32_t crc, {\cf17 const} Pel pel)\par
00172 \{\par
00173   {\cf17 const} {\cf18 void} *buf = &pel;\par
00174   {\cf17 const} uint8_t *p = ({\cf17 const} uint8_t *)buf;\par
00175   {\cf18 size_t} size = 2;\par
00176 \par
00177   {\cf19 while} (size--)\par
00178   \{\par
00179     crc = crc32Table[(crc ^ *p++) & 0xff] ^ (crc >> 8);\par
00180   \}\par
00181 \par
00182   {\cf19 return} crc;\par
00183 \}\par
00184 {\cf20 // CRC calculation in C code}\par
00186 \par
00187 {\cf18 unsigned} {\cf18 int} IbcHashMap::xxCalcBlockHash({\cf17 const} Pel* pel, {\cf17 const} {\cf18 int} stride, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height, {\cf18 unsigned} {\cf18 int} crc)\par
00188 \{\par
00189   {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00190   \{\par
00191     {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00192     \{\par
00193       crc = m_computeCrc32c(crc, pel[x]);\par
00194     \}\par
00195     pel += stride;\par
00196   \}\par
00197   {\cf19 return} crc;\par
00198 \}\par
