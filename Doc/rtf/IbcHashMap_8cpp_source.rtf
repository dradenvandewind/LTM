00200 {\cf17 template}<ChromaFormat chromaFormat>\par
00201 {\cf18 void} IbcHashMap::xxBuildPicHashMap({\cf17 const} PelUnitBuf& pic)\par
00202 \{\par
00203   {\cf17 const} {\cf18 int} chromaScalingX = getChannelTypeScaleX(CHANNEL_TYPE_CHROMA, chromaFormat);\par
00204   {\cf17 const} {\cf18 int} chromaScalingY = getChannelTypeScaleY(CHANNEL_TYPE_CHROMA, chromaFormat);\par
00205   {\cf17 const} {\cf18 int} chromaMinBlkWidth = MIN_PU_SIZE >> chromaScalingX;\par
00206   {\cf17 const} {\cf18 int} chromaMinBlkHeight = MIN_PU_SIZE >> chromaScalingY;\par
00207   {\cf17 const} Pel* pelY = NULL;\par
00208   {\cf17 const} Pel* pelCb = NULL;\par
00209   {\cf17 const} Pel* pelCr = NULL;\par
00210 \par
00211   Position pos;\par
00212   {\cf19 for} (pos.y = 0; pos.y + MIN_PU_SIZE <= pic.Y().height; pos.y++)\par
00213   \{\par
00214     {\cf20 // row pointer}\par
00215     pelY = pic.Y().bufAt(0, pos.y);\par
00216     {\cf19 if} (chromaFormat != CHROMA_400)\par
00217     \{\par
00218       {\cf18 int} chromaY = pos.y >> chromaScalingY;\par
00219       pelCb = pic.Cb().bufAt(0, chromaY);\par
00220       pelCr = pic.Cr().bufAt(0, chromaY);\par
00221     \}\par
00222 \par
00223     {\cf19 for} (pos.x = 0; pos.x + MIN_PU_SIZE <= pic.Y().width; pos.x++)\par
00224     \{\par
00225       {\cf20 // 0x1FF is just an initial value}\par
00226       {\cf18 unsigned} {\cf18 int} hashValue = 0x1FF;\par
00227 \par
00228       {\cf20 // luma part}\par
00229       hashValue = xxCalcBlockHash(&pelY[pos.x], pic.Y().stride, MIN_PU_SIZE, MIN_PU_SIZE, hashValue);\par
00230 \par
00231       {\cf20 // chroma part}\par
00232       {\cf19 if} (chromaFormat != CHROMA_400)\par
00233       \{\par
00234         {\cf18 int} chromaX = pos.x >> chromaScalingX;\par
00235         hashValue = xxCalcBlockHash(&pelCb[chromaX], pic.Cb().stride, chromaMinBlkWidth, chromaMinBlkHeight, hashValue);\par
00236         hashValue = xxCalcBlockHash(&pelCr[chromaX], pic.Cr().stride, chromaMinBlkWidth, chromaMinBlkHeight, hashValue);\par
00237       \}\par
00238 \par
00239       {\cf20 // hash table}\par
00240       m_hash2Pos[hashValue].push_back(pos);\par
00241       m_pos2Hash[pos.y][pos.x] = hashValue;\par
00242     \}\par
00243   \}\par
00244 \}\par
00245 \par
00246 {\cf18 void} IbcHashMap::rebuildPicHashMap({\cf17 const} PelUnitBuf& pic)\par
00247 \{\par
00248   m_hash2Pos.clear();\par
00249 \par
00250   {\cf19 switch} (pic.chromaFormat)\par
00251   \{\par
00252   {\cf19 case} CHROMA_400:\par
00253     xxBuildPicHashMap<CHROMA_400>(pic);\par
00254     {\cf19 break};\par
00255   {\cf19 case} CHROMA_420:\par
00256     xxBuildPicHashMap<CHROMA_420>(pic);\par
00257     {\cf19 break};\par
00258   {\cf19 case} CHROMA_422:\par
00259     xxBuildPicHashMap<CHROMA_422>(pic);\par
00260     {\cf19 break};\par
00261   {\cf19 case} CHROMA_444:\par
00262     xxBuildPicHashMap<CHROMA_444>(pic);\par
00263     {\cf19 break};\par
00264   {\cf19 default}:\par
00265     THROW({\cf22 "invalid chroma fomat"});\par
00266     {\cf19 break};\par
00267   \}\par
00268 \}\par
00269 \par
00270 {\cf18 bool} IbcHashMap::ibcHashMatch({\cf17 const} Area& lumaArea, std::vector<Position>& cand, {\cf17 const} CodingStructure& cs, {\cf17 const} {\cf18 int} maxCand, {\cf17 const} {\cf18 int} searchRange4SmallBlk)\par
00271 \{\par
00272   cand.clear();\par
00273 \par
00274   {\cf20 // find the block with least candidates}\par
00275   {\cf18 size_t} minSize = MAX_UINT;\par
00276   {\cf18 unsigned} {\cf18 int} targetHashOneBlock = 0;\par
00277   Position targetBlockOffsetInCu(0, 0);\par
00278   {\cf19 for} (SizeType y = 0; y < lumaArea.height && minSize > 1; y += MIN_PU_SIZE)\par
00279   \{\par
00280     {\cf19 for} (SizeType x = 0; x < lumaArea.width && minSize > 1; x += MIN_PU_SIZE)\par
00281     \{\par
00282       {\cf18 unsigned} {\cf18 int} hash = m_pos2Hash[lumaArea.pos().y + y][lumaArea.pos().x + x];\par
00283       {\cf19 if} (m_hash2Pos[hash].size() < minSize)\par
00284       \{\par
00285         minSize = m_hash2Pos[hash].size();\par
00286         targetHashOneBlock = hash;\par
00287         targetBlockOffsetInCu.repositionTo(Position(x, y));\par
00288       \}\par
00289     \}\par
00290   \}\par
00291 \par
00292   {\cf19 if} (m_hash2Pos[targetHashOneBlock].size() > 1)\par
00293   \{\par
00294     std::vector<Position>& candOneBlock = m_hash2Pos[targetHashOneBlock];\par
00295 \par
00296     {\cf20 // check whether whole block match}\par
00297     {\cf19 for} (std::vector<Position>::iterator refBlockPos = candOneBlock.begin(); refBlockPos != candOneBlock.end(); refBlockPos++)\par
00298     \{\par
00299       Position topLeft = refBlockPos->offset(-targetBlockOffsetInCu.x, -targetBlockOffsetInCu.y);\par
00300       Position bottomRight = topLeft.offset(lumaArea.width - 1, lumaArea.height - 1);\par
00301       {\cf18 bool} wholeBlockMatch = {\cf17 true};\par
00302       {\cf19 if} (lumaArea.width > MIN_PU_SIZE || lumaArea.height > MIN_PU_SIZE)\par
00303       \{\par
00304         {\cf19 if} (!cs.isDecomp(bottomRight, CHANNEL_TYPE_LUMA) || bottomRight.x >= m_picWidth || bottomRight.y >= m_picHeight || topLeft.x < 0 || topLeft.y < 0)\par
00305         \{\par
00306           {\cf19 continue};\par
00307         \}\par
00308         {\cf19 for} (SizeType y = 0; y < lumaArea.height && wholeBlockMatch; y += MIN_PU_SIZE)\par
00309         \{\par
00310           {\cf19 for} (SizeType x = 0; x < lumaArea.width && wholeBlockMatch; x += MIN_PU_SIZE)\par
00311           \{\par
00312             {\cf20 // whether the reference block and current block has the same hash}\par
00313             wholeBlockMatch &= (m_pos2Hash[lumaArea.pos().y + y][lumaArea.pos().x + x] == m_pos2Hash[topLeft.y + y][topLeft.x + x]);\par
00314           \}\par
00315         \}\par
00316       \}\par
00317       {\cf19 else}\par
00318       \{\par
00319         CHECK(topLeft != *refBlockPos, {\cf22 "4x4 target block should not have offset!"});\par
00320         {\cf19 if} (abs(topLeft.x - lumaArea.x) > searchRange4SmallBlk || abs(topLeft.y - lumaArea.y) > searchRange4SmallBlk || !cs.isDecomp(bottomRight, CHANNEL_TYPE_LUMA))\par
00321         \{\par
00322           {\cf19 continue};\par
00323         \}\par
00324       \}\par
00325       {\cf19 if} (wholeBlockMatch)\par
00326       \{\par
00327         cand.push_back(topLeft);\par
00328         {\cf19 if} (cand.size() > maxCand)\par
00329         \{\par
00330           {\cf19 break};\par
00331         \}\par
00332       \}\par
00333     \}\par
00334   \}\par
00335 \par
00336   {\cf19 return} cand.size() > 0;\par
00337 \}\par
00338 \par
00339 {\cf18 int} IbcHashMap::getHashHitRatio({\cf17 const} Area& lumaArea)\par
00340 \{\par
00341   {\cf18 int} maxX = std::min(({\cf18 int})(lumaArea.x + lumaArea.width), m_picWidth);\par
00342   {\cf18 int} maxY = std::min(({\cf18 int})(lumaArea.y + lumaArea.height), m_picHeight);\par
00343   {\cf18 int} hit = 0, total = 0;\par
00344   {\cf19 for} ({\cf18 int} y = lumaArea.y; y < maxY; y += MIN_PU_SIZE)\par
00345   \{\par
00346     {\cf19 for} ({\cf18 int} x = lumaArea.x; x < maxX; x += MIN_PU_SIZE)\par
00347     \{\par
00348       {\cf17 const} {\cf18 unsigned} {\cf18 int} hash = m_pos2Hash[y][x];\par
00349       hit += (m_hash2Pos[hash].size() > 1);\par
00350       total++;\par
00351     \}\par
00352   \}\par
00353   {\cf19 return} 100 * hit / total;\par
00354 \}\par
00355 \par
00356 {\cf18 int} IbcHashMap::calHashBlkMatchPerc({\cf17 const} Area& lumaArea)\par
00357 \{\par
00358   {\cf18 int} maxX = std::min(({\cf18 int})(lumaArea.x + lumaArea.width), m_picWidth);\par
00359   {\cf18 int} maxY = std::min(({\cf18 int})(lumaArea.y + lumaArea.height), m_picHeight);\par
00360   {\cf18 int}          maxUsage[100];\par
00361   {\cf18 unsigned} {\cf18 int} mostSelHash[100];\par
00362 \par
00363   {\cf17 static}   {\cf18 int} numExcludedHashValue = 36;\par
00364 \par
00365   {\cf19 for} ({\cf18 int} i = 0; i < numExcludedHashValue; i++)\par
00366   \{\par
00367     maxUsage[i] = 0;\par
00368     mostSelHash[i] = 0;\par
00369   \}\par
00370 \par
00371   {\cf19 for} (std::unordered_map<{\cf18 unsigned} {\cf18 int}, std::vector<Position>>::iterator it = m_hash2Pos.begin(); it != m_hash2Pos.end(); ++it)\par
00372   \{\par
00373     {\cf18 unsigned} {\cf18 int} hash = it->first;\par
00374     {\cf18 int} usage = (int)it->second.size();\par
00375     assert(usage == m_hash2Pos[hash].size());\par
00376 \par
00377     {\cf18 int} insertPos = -1;\par
00378     {\cf19 for} (insertPos = 0; insertPos < numExcludedHashValue; insertPos++)\par
00379     \{\par
00380       {\cf19 if} (usage > maxUsage[insertPos])\par
00381       \{\par
00382         {\cf19 break};\par
00383       \}\par
00384     \}\par
00385     assert(insertPos <= numExcludedHashValue);\par
00386 \par
00387     {\cf19 if} (insertPos < numExcludedHashValue)\par
00388     \{\par
00389       {\cf19 for} ({\cf18 int} i = (numExcludedHashValue - 1); i >= (insertPos + 1); i--)\par
00390       \{\par
00391         maxUsage[i] = maxUsage[i - 1];\par
00392         mostSelHash[i] = mostSelHash[i - 1];\par
00393       \}\par
00394       maxUsage[insertPos] = usage;\par
00395       mostSelHash[insertPos] = hash;\par
00396     \}\par
00397   \}\par
00398 \par
00399   {\cf18 int} hit = 0, total = 0;\par
00400   {\cf19 for} ({\cf18 int} y = lumaArea.y; y < maxY; y += MIN_PU_SIZE)\par
00401   \{\par
00402     {\cf19 for} ({\cf18 int} x = lumaArea.x; x < maxX; x += MIN_PU_SIZE)\par
00403     \{\par
00404       {\cf18 unsigned} {\cf18 int} hash = m_pos2Hash[y][x];\par
00405 \par
00406       {\cf18 bool} excludedHash = {\cf17 false};\par
00407       {\cf19 for} ({\cf18 int} i = 0; i < numExcludedHashValue && !excludedHash; i++)\par
00408       \{\par
00409         {\cf19 if} (hash == mostSelHash[i])\par
00410         \{\par
00411           excludedHash = {\cf17 true};\par
00412         \}\par
00413       \}\par
00414 \par
00415       {\cf19 if} (excludedHash)\par
00416       \{\par
00417         {\cf19 continue};\par
00418       \}\par
00419 \par
00420       hit += (m_hash2Pos[hash].size() > 1);\par
00421       total++;\par
00422     \}\par
00423   \}\par
00424 \par
00425   {\cf19 if} (total == 0)\par
00426   \{\par
00427     {\cf19 return} 0;\par
00428   \}\par
00429   {\cf19 else}\par
00430   \{\par
00431     {\cf19 return} 100 * hit / total;\par
00432   \}\par
00433 \}\par
