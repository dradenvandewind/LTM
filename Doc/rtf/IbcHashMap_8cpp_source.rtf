00082   m_pos2Hash = {\cf17 new} {\cf18 unsigned} {\cf18 int}*[m_picHeight];\par
00083   m_pos2Hash[0] = {\cf17 new} {\cf18 unsigned} {\cf18 int}[m_picWidth * m_picHeight];\par
