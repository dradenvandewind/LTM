00119 {\cf20 // Push encoded data into decoder}\par
00120 {\cf20 //}\par
00121 {\cf17 static} int32_t push_packet(CodecContext c, {\cf17 const} uint8_t *data, {\cf18 size_t} length, CodecMetadata metadata, int8_t eos, CodecError *error) \{\par
00122     Context *context = (Context *)c;\par
00123     {\cf19 if}(error)\par
00124         *error = 0;\par
00125 \par
00126     {\cf19 switch}(context->state_) \{\par
00127     {\cf19 case} StatePushing:\par
00128         {\cf19 if}(!eos) \{\par
00129             CHECK(data);\par
00130             CHECK(length >= 3);\par
00131             {\cf20 // Fixup NALU start code - if first is 3 bytes, make it 4}\par
00132             {\cf19 if} (data[0] == {\cf23 '\\0'} && data[1] == {\cf23 '\\0'} && data[2] == {\cf23 '\\1'}) \{\par
00133                 {\cf18 char} {\cf17 const} zero = {\cf23 '\\0'};\par
00134                 context->base_bitstream_.put(0);\par
00135             \}\par
00136 \par
00137             {\cf20 // Accumulate AUs into a temporary buffer}\par
00138             context->base_bitstream_.write(({\cf17 const} {\cf18 char} *)data, length);\par
00139         \} {\cf19 else} \{\par
00141             context->state_ = StateDecoding;\par
00142         \}\par
00143         {\cf19 return} 0;\par
00144 \par
00145     {\cf19 default}:\par
00146         ERR({\cf22 "Unexpected decoder state"});\par
00147     \}\par
00148     {\cf19 return} 0;\par
00149 \}\par
00150 \par
00151 {\cf17 static} int32_t pull_image(CodecContext c, CodecImage* image, CodecMetadata *metadata, int8_t* eos, CodecError *error)\{\par
00152     Context *context = (Context *)c;\par
00153     {\cf19 if}(error)\par
00154         *error = 0;\par
00155 \par
00156     {\cf19 switch}(context->state_) \{\par
00157     {\cf19 case} StatePushing:\par
00158         {\cf20 // Still accumulating input stream}\par
00159         *eos = 0;\par
00160         {\cf19 return} 0;\par
00161 \par
00162     {\cf19 case} StateDecoding:\par
00163         context->m_cTDecTop.create();\par
00164         context->m_cTDecTop.init();\par
00165 \par
00166         context->decoder_thread_ = std::thread([context] \{\par
00167                 context->flush();\par
00168                 context->decoded_images_.push({\cf17 nullptr});\par
00169             \});\par
00170 \par
00171         context->state_ = StateFlushing;\par
00172         {\cf20 /* Fall through */}\par
00173 \par
00174     {\cf19 case} StateFlushing:\par
00175         context->decoded_images_.pop(context->decoded_image_);\par
00176         {\cf19 if}(context->decoded_image_) \{\par
00177             *image = context->decoded_image_->image_;\par
00178             *eos = 0;\par
00179             {\cf19 return} 1;\par
00180         \} {\cf19 else} \{\par
00181             {\cf19 if}(context->decoder_thread_.joinable())\par
00182                 context->decoder_thread_.join();\par
00183             *eos = 1;\par
00184             {\cf19 return} 0;\par
00185         \}\par
00186     {\cf19 default}:\par
00187         ERR({\cf22 "Unexpected decoder state"});\par
00188     \}\par
00189     {\cf19 return} 0;\par
00190 \}\par
