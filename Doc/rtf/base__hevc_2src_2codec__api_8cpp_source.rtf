00285 {\cf18 void} Context::WriteOutput(TComList<TComPic *> *pcListPic, {\cf18 unsigned} {\cf18 int} tId) \{\par
00286     {\cf19 if} (pcListPic->empty()) \{\par
00287         {\cf19 return};\par
00288     \}\par
00289 \par
00290     TComList<TComPic *>::iterator iterPic = pcListPic->begin();\par
00291     Int numPicsNotYetDisplayed = 0;\par
00292     Int dpbFullness = 0;\par
00293     {\cf17 const} TComSPS *activeSPS = &(pcListPic->front()->getPicSym()->getSPS());\par
00294     UInt numReorderPicsHighestTid;\par
00295     UInt maxDecPicBufferingHighestTid;\par
00296     UInt maxNrSublayers = activeSPS->getMaxTLayers();\par
00297 \par
00298     numReorderPicsHighestTid = activeSPS->getNumReorderPics(maxNrSublayers - 1);\par
00299     maxDecPicBufferingHighestTid = activeSPS->getMaxDecPicBuffering(maxNrSublayers - 1);\par
00300 \par
00301     {\cf19 while} (iterPic != pcListPic->end()) \{\par
00302         TComPic *pcPic = *(iterPic);\par
00303         {\cf19 if} (pcPic->getOutputMark() && pcPic->getPOC() > m_iPOCLastDisplay) \{\par
00304             numPicsNotYetDisplayed++;\par
00305             dpbFullness++;\par
00306         \} {\cf19 else} {\cf19 if} (pcPic->getSlice(0)->isReferenced()) \{\par
00307             dpbFullness++;\par
00308         \}\par
00309         iterPic++;\par
00310     \}\par
00311 \par
00312     iterPic = pcListPic->begin();\par
00313 \par
00314     {\cf19 if} (numPicsNotYetDisplayed > 2) \{\par
00315         iterPic++;\par
00316     \}\par
00317 \par
00318     TComPic *pcPic = *(iterPic);\par
00319     {\cf19 if} (numPicsNotYetDisplayed > 2 && pcPic->isField()) {\cf20 // Field Decoding}\par
00320     \{\par
00321         TComList<TComPic *>::iterator endPic = pcListPic->end();\par
00322         endPic--;\par
00323         iterPic = pcListPic->begin();\par
00324         {\cf19 while} (iterPic != endPic) \{\par
00325             TComPic *pcPicTop = *(iterPic);\par
00326             iterPic++;\par
00327             TComPic *pcPicBottom = *(iterPic);\par
00328 \par
00329             {\cf19 if} (pcPicTop->getOutputMark() && pcPicBottom->getOutputMark() &&\par
00330                 (numPicsNotYetDisplayed > numReorderPicsHighestTid || dpbFullness > maxDecPicBufferingHighestTid) &&\par
00331                 (!(pcPicTop->getPOC() % 2) && pcPicBottom->getPOC() == pcPicTop->getPOC() + 1) &&\par
00332                 (pcPicTop->getPOC() == m_iPOCLastDisplay + 1 || m_iPOCLastDisplay < 0)) \{\par
00333                 {\cf20 // write to file}\par
00334                 numPicsNotYetDisplayed = numPicsNotYetDisplayed - 2;\par
00335                 {\cf17 const} Window &conf = pcPicTop->getConformanceWindow();\par
00336                 {\cf17 const} Window defDisp = pcPicTop->getDefDisplayWindow();\par
00337                 {\cf17 const} Bool isTff = pcPicTop->isTopField();\par
00338 \par
00339                 m_cTVideoIOYuvRecon.write(pcPicTop->getPicYuvRec(), pcPicBottom->getPicYuvRec(),\par
00340                                           IPCOLOURSPACE_UNCHANGED {\cf20 /*m_outputColourSpaceConvert*/},\par
00341                                           conf.getWindowLeftOffset() + defDisp.getWindowLeftOffset(),\par
00342                                           conf.getWindowRightOffset() + defDisp.getWindowRightOffset(),\par
00343                                           conf.getWindowTopOffset() + defDisp.getWindowTopOffset(),\par
00344                                           conf.getWindowBottomOffset() + defDisp.getWindowBottomOffset(), NUM_CHROMA_FORMAT, isTff);\par
00345 \par
00346                 {\cf20 // update POC of display order}\par
00347                 m_iPOCLastDisplay = pcPicBottom->getPOC();\par
00348 \par
00349                 {\cf20 // erase non-referenced picture in the reference picture list after display}\par
00350                 {\cf19 if} (!pcPicTop->getSlice(0)->isReferenced() && pcPicTop->getReconMark() == {\cf17 true}) \{\par
00351                     pcPicTop->setReconMark({\cf17 false});\par
00352 \par
00353                     {\cf20 // mark it should be extended later}\par
00354                     pcPicTop->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00355                 \}\par
00356                 {\cf19 if} (!pcPicBottom->getSlice(0)->isReferenced() && pcPicBottom->getReconMark() == {\cf17 true}) \{\par
00357                     pcPicBottom->setReconMark({\cf17 false});\par
00358 \par
00359                     {\cf20 // mark it should be extended later}\par
00360                     pcPicBottom->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00361                 \}\par
00362                 pcPicTop->setOutputMark({\cf17 false});\par
00363                 pcPicBottom->setOutputMark({\cf17 false});\par
00364             \}\par
00365         \}\par
00366     \} {\cf19 else} {\cf19 if} (!pcPic->isField()) {\cf20 // Frame Decoding}\par
00367     \{\par
00368         iterPic = pcListPic->begin();\par
00369 \par
00370         {\cf19 while} (iterPic != pcListPic->end()) \{\par
00371             pcPic = *(iterPic);\par
00372 \par
00373             {\cf19 if} (pcPic->getOutputMark() && pcPic->getPOC() > m_iPOCLastDisplay &&\par
00374                 (numPicsNotYetDisplayed > numReorderPicsHighestTid || dpbFullness > maxDecPicBufferingHighestTid)) \{\par
00375                 {\cf20 // write to file}\par
00376                 numPicsNotYetDisplayed--;\par
00377                 {\cf19 if} (pcPic->getSlice(0)->isReferenced() == {\cf17 false}) \{\par
00378                     dpbFullness--;\par
00379                 \}\par
00380 \par
00381                 {\cf17 const} Window &conf = pcPic->getConformanceWindow();\par
00382                 {\cf17 const} Window defDisp = {\cf17 true} {\cf20 /*m_respectDefDispWindow*/} ? pcPic->getDefDisplayWindow() : Window();\par
00383 \par
00384                 m_cTVideoIOYuvRecon.write(pcPic->getPicYuvRec(), IPCOLOURSPACE_UNCHANGED {\cf20 /*m_outputColourSpaceConvert*/},\par
00385                                           conf.getWindowLeftOffset() + defDisp.getWindowLeftOffset(),\par
00386                                           conf.getWindowRightOffset() + defDisp.getWindowRightOffset(),\par
00387                                           conf.getWindowTopOffset() + defDisp.getWindowTopOffset(),\par
00388                                           conf.getWindowBottomOffset() + defDisp.getWindowBottomOffset(), NUM_CHROMA_FORMAT,\par
00389                                           {\cf17 false} {\cf20 /*m_bClipOutputVideoToRec709Range */});\par
00390 \par
00391                 {\cf20 // update POC of display order}\par
00392                 m_iPOCLastDisplay = pcPic->getPOC();\par
00393 \par
00394                 {\cf20 // erase non-referenced picture in the reference picture list after display}\par
00395                 {\cf19 if} (!pcPic->getSlice(0)->isReferenced() && pcPic->getReconMark() == {\cf17 true}) \{\par
00396                     pcPic->setReconMark({\cf17 false});\par
00397 \par
00398                     {\cf20 // mark it should be extended later}\par
00399                     pcPic->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00400                 \}\par
00401                 pcPic->setOutputMark({\cf17 false});\par
00402             \}\par
00403 \par
00404             iterPic++;\par
00405         \}\par
00406     \}\par
00407 \}\par
