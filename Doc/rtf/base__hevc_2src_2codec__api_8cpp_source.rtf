00194     Bool openedRecon = {\cf17 false};\par
00195     {\cf18 bool} loopFiltered = {\cf17 false};\par
00196     {\cf18 int} poc = 0;\par
00197     TComList<TComPic *> *pcListPic = NULL;\par
00198     InputByteStream bytestream(base_bitstream_);\par
00199 \par
00200     {\cf19 while} (!!base_bitstream_) \{\par
00201         streampos location = base_bitstream_.tellg();\par
00202 \par
00203         AnnexBStats stats = AnnexBStats();\par
00204         InputNALUnit nalu;\par
00205         byteStreamNALUnit(bytestream, nalu.getBitstream().getFifo(), stats);\par
00206 \par
00207         {\cf20 // call actual decoding function}\par
00208         Bool bNewPicture = {\cf17 false};\par
00209         {\cf19 if} (nalu.getBitstream().getFifo().empty()) \{\par
00210             WARN({\cf22 "Attempt to decode an empty NAL unit"});\par
00211         \} {\cf19 else} \{\par
00212             read(nalu);\par
00213             {\cf18 int} skip = 0;\par
00214             bNewPicture = m_cTDecTop.decode(nalu, skip, m_iPOCLastDisplay);\par
00215 \par
00216             {\cf19 if} (bNewPicture) \{\par
00217                 base_bitstream_.clear();\par
00218                 base_bitstream_.seekg(location - streamoff(3));\par
00219                 bytestream.reset();\par
00220             \}\par
00221         \}\par
00222 \par
00223         {\cf19 if} ((bNewPicture || !base_bitstream_ || nalu.m_nalUnitType == NAL_UNIT_EOS) && !m_cTDecTop.getFirstSliceInSequence()) \{\par
00224             {\cf19 if} (!loopFiltered || base_bitstream_) \{\par
00225                 m_cTDecTop.executeLoopFilters(poc, pcListPic);\par
00226             \}\par
00227             loopFiltered = (nalu.m_nalUnitType == NAL_UNIT_EOS);\par
00228             {\cf19 if} (nalu.m_nalUnitType == NAL_UNIT_EOS) \{\par
00229                 m_cTDecTop.setFirstSliceInSequence({\cf17 true});\par
00230             \}\par
00231         \} {\cf19 else} {\cf19 if} ((bNewPicture || !base_bitstream_ || nalu.m_nalUnitType == NAL_UNIT_EOS) &&\par
00232                    m_cTDecTop.getFirstSliceInSequence()) \{\par
00233             m_cTDecTop.setFirstSliceInPicture({\cf17 true});\par
00234         \}\par
00235 \par
00236         {\cf19 if} (pcListPic) \{\par
00237             {\cf19 if} (!openedRecon) \{\par
00238                 {\cf17 const} BitDepths &bitDepths =\par
00239                     pcListPic->front()->getPicSym()->getSPS().getBitDepths(); {\cf20 // use bit depths of first reconstructed picture.}\par
00240                 {\cf19 for} (UInt channelType = 0; channelType < MAX_NUM_CHANNEL_TYPE; channelType++) \{\par
00241                     {\cf19 if} (m_outputBitDepth[channelType] == 0) \{\par
00242                         m_outputBitDepth[channelType] = bitDepths.recon[channelType];\par
00243                     \}\par
00244                 \}\par
00245 \par
00246                 m_cTVideoIOYuvRecon.open({\cf17 this}, m_outputBitDepth, m_outputBitDepth, bitDepths.recon); {\cf20 // write mode}\par
00247                 openedRecon = {\cf17 true};\par
00248             \}\par
00249 \par
00250             {\cf20 // write reconstruction to file}\par
00251             {\cf19 if} (bNewPicture) \{\par
00252                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00253             \}\par
00254             {\cf19 if} ((bNewPicture || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_CRA) && m_cTDecTop.getNoOutputPriorPicsFlag()) \{\par
00255                 m_cTDecTop.checkNoOutputPriorPics(pcListPic);\par
00256                 m_cTDecTop.setNoOutputPriorPicsFlag({\cf17 false});\par
00257             \}\par
00258             {\cf19 if} (bNewPicture &&\par
00259                 (nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_IDR_W_RADL || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_IDR_N_LP ||\par
00260                  nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_N_LP || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_W_RADL ||\par
00261                  nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_W_LP)) \{\par
00262                 FlushOutput(pcListPic);\par
00263             \}\par
00264             {\cf19 if} (nalu.m_nalUnitType == NAL_UNIT_EOS) \{\par
00265                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00266                 m_cTDecTop.setFirstSliceInPicture({\cf17 false});\par
00267             \}\par
00268             {\cf20 // write reconstruction to file -- for additional bumping as defined in C.5.2.3}\par
00269             {\cf19 if} (!bNewPicture && nalu.m_nalUnitType >= NAL_UNIT_CODED_SLICE_TRAIL_N &&\par
00270                 nalu.m_nalUnitType <= NAL_UNIT_RESERVED_VCL31) \{\par
00271                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00272             \}\par
00273         \}\par
00274     \}\par
00275 \par
00276     FlushOutput(pcListPic);\par
00277 \par
00278     {\cf20 // delete buffers}\par
00279     m_cTDecTop.deletePicBuffer();\par
00280 \}\par
