00543 {\cf18 void} DecAppMem::xWriteOutput( PicList* pcListPic, uint32_t tId )\par
00544 \{\par
00545   {\cf19 if} (pcListPic->empty())\par
00546   \{\par
00547     {\cf19 return};\par
00548   \}\par
00549 \par
00550   PicList::iterator iterPic   = pcListPic->begin();\par
00551   {\cf18 int} numPicsNotYetDisplayed = 0;\par
00552   {\cf18 int} dpbFullness = 0;\par
00553   {\cf17 const} SPS* activeSPS = (pcListPic->front()->cs->sps);\par
00554   uint32_t maxNumReorderPicsHighestTid;\par
00555   uint32_t maxDecPicBufferingHighestTid;\par
00556   uint32_t maxNrSublayers = activeSPS->getMaxTLayers();\par
00557 \par
00558   {\cf17 const} VPS* referredVPS = pcListPic->front()->cs->vps;\par
00559   {\cf17 const} {\cf18 int} temporalId = ( m_iMaxTemporalLayer == -1 || m_iMaxTemporalLayer >= maxNrSublayers ) ? maxNrSublayers - 1 : m_iMaxTemporalLayer;\par
00560 \par
00561   {\cf19 if}( referredVPS == {\cf17 nullptr} || referredVPS->m_numLayersInOls[referredVPS->m_targetOlsIdx] == 1 )\par
00562   \{\par
00563     maxNumReorderPicsHighestTid = activeSPS->getMaxNumReorderPics( temporalId );\par
00564     maxDecPicBufferingHighestTid = activeSPS->getMaxDecPicBuffering( temporalId );\par
00565   \}\par
00566   {\cf19 else}\par
00567   \{\par
00568     maxNumReorderPicsHighestTid = referredVPS->getMaxNumReorderPics( temporalId );\par
00569     maxDecPicBufferingHighestTid = referredVPS->getMaxDecPicBuffering( temporalId );\par
00570   \}\par
00571 \par
00572   {\cf19 while} (iterPic != pcListPic->end())\par
00573   \{\par
00574     Picture* pcPic = *(iterPic);\par
00575     {\cf19 if}(pcPic->neededForOutput && pcPic->getPOC() > m_iPOCLastDisplay)\par
00576     \{\par
00577        numPicsNotYetDisplayed++;\par
00578       dpbFullness++;\par
00579     \}\par
00580     {\cf19 else} {\cf19 if}(pcPic->referenced)\par
