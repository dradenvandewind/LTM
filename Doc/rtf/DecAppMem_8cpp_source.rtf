00466 {\cf18 void} DecAppMem::writeLineToOutputLog(Picture * pcPic)\par
00467 \{\par
00468   {\cf19 if} (m_oplFileStream.is_open() && m_oplFileStream.good())\par
00469   \{\par
00470     {\cf17 const} SPS *   sps             = pcPic->cs->sps;\par
00471     ChromaFormat  chromaFormatIDC = sps->getChromaFormatIdc();\par
00472     {\cf17 const} Window &conf            = pcPic->getConformanceWindow();\par
00473     {\cf17 const} {\cf18 int}     leftOffset      = conf.getWindowLeftOffset() * SPS::getWinUnitX(chromaFormatIDC);\par
00474     {\cf17 const} {\cf18 int}     rightOffset     = conf.getWindowRightOffset() * SPS::getWinUnitX(chromaFormatIDC);\par
00475     {\cf17 const} {\cf18 int}     topOffset       = conf.getWindowTopOffset() * SPS::getWinUnitY(chromaFormatIDC);\par
00476     {\cf17 const} {\cf18 int}     bottomOffset    = conf.getWindowBottomOffset() * SPS::getWinUnitY(chromaFormatIDC);\par
00477     PictureHash   recon_digest;\par
00478     {\cf17 auto} numChar = calcMD5WithCropping((({\cf17 const} Picture *) pcPic)->getRecoBuf(), recon_digest, sps->getBitDepths(),\par
00479                                        leftOffset, rightOffset, topOffset, bottomOffset);\par
00480 \par
00481     {\cf17 const} {\cf18 int} croppedWidth  = pcPic->Y().width - leftOffset - rightOffset;\par
00482     {\cf17 const} {\cf18 int} croppedHeight = pcPic->Y().height - topOffset - bottomOffset;\par
00483 \par
00484     m_oplFileStream << std::setw(3) << pcPic->layerId << {\cf22 ","};\par
00485     m_oplFileStream << std::setw(8) << pcPic->getPOC() << {\cf22 ","} << std::setw(5) << croppedWidth << {\cf22 ","} << std::setw(5)\par
00486                     << croppedHeight << {\cf22 ","} << hashToString(recon_digest, numChar) << {\cf22 "\\n"};\par
00487   \}\par
00488 \}\par
