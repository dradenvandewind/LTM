00290       {\cf19 if}( !m_reconFileName.empty() && !m_cVideoIOYuvReconFile[nalu.m_nuhLayerId].isOpen() )\par
00291       \{\par
00292         {\cf17 const} BitDepths &bitDepths=pcListPic->front()->cs->sps->getBitDepths(); {\cf20 // use bit depths of first reconstructed picture.}\par
