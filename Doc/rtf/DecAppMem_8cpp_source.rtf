00245           \}\par
00246         \}\par
00247         {\cf19 else}\par
00248         \{\par
00249           bPicSkipped = {\cf17 true};\par
00250         \}\par
00251       \}\par
00252       {\cf20 // once an EOS NAL unit appears in the current PU, mark the variable isEosPresentInPu as true}\par
