00389 {\cf21 #endif}\par
00390       \}\par
00391     \}\par
00392 {\cf21 #if JVET_S0078_NOOUTPUTPRIORPICFLAG}\par
00393 {\cf21 #if JVET_S0163_ON_TARGETOLS_SUBLAYERS}\par
00394     {\cf19 if} ((nalu.m_nalUnitType >= NAL_UNIT_CODED_SLICE_TRAIL && nalu.m_nalUnitType <= NAL_UNIT_OPI)\par
