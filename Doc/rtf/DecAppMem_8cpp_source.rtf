00082 uint32_t DecAppMem::decode(std::istream& bitstreamFile)\par
00083 \{\par
00084   {\cf18 int}                 poc;\par
00085   PicList* pcListPic = NULL;\par
00086 \par
00087 \par
00088   InputByteStream bytestream(bitstreamFile);\par
00089 \par
00090   {\cf19 if} (!m_outputDecodedSEIMessagesFilename.empty() && m_outputDecodedSEIMessagesFilename!={\cf22 "-"})\par
00091   \{\par
00092     m_seiMessageFileStream.open(m_outputDecodedSEIMessagesFilename.c_str(), std::ios::out);\par
00093     {\cf19 if} (!m_seiMessageFileStream.is_open() || !m_seiMessageFileStream.good())\par
00094     \{\par
00095       EXIT( {\cf22 "Unable to open file "}<< m_outputDecodedSEIMessagesFilename.c_str() << {\cf22 " for writing decoded SEI messages"});\par
00096     \}\par
00097   \}\par
00098 \par
00099   {\cf19 if} (!m_oplFilename.empty() && m_oplFilename!={\cf22 "-"})\par
00100   \{\par
00101     m_oplFileStream.open(m_oplFilename.c_str(), std::ios::out);\par
00102     {\cf19 if} (!m_oplFileStream.is_open() || !m_oplFileStream.good())\par
00103     \{\par
00104       EXIT( {\cf22 "Unable to open file "}<< m_oplFilename.c_str() << {\cf22 " to write an opl-file for conformance testing (see JVET-P2008 for details)"});\par
00105     \}\par
00106   \}\par
00107 \par
00108   {\cf20 // create & initialize internal classes}\par
00109   xCreateDecLib();\par
00110 \par
00111   m_iPOCLastDisplay += m_iSkipFrame;      {\cf20 // set the last displayed POC correctly for skip forward.}\par
00112 \par
00113   {\cf20 // clear contents of colour-remap-information-SEI output file}\par
00114   {\cf19 if} (!m_colourRemapSEIFileName.empty())\par
00115   \{\par
00116     std::ofstream ofile(m_colourRemapSEIFileName.c_str());\par
00117     {\cf19 if} (!ofile.good() || !ofile.is_open())\par
00118     \{\par
00119       EXIT( {\cf22 "Unable to open file "} << m_colourRemapSEIFileName.c_str() << {\cf22 " for writing colour-remap-information-SEI video"});\par
00120     \}\par
00121   \}\par
00122 \par
00123   {\cf20 // main decoder loop}\par
00124   {\cf18 bool} loopFiltered[MAX_VPS_LAYERS] = \{ {\cf17 false} \};\par
00125 \par
00126   {\cf18 bool} bPicSkipped = {\cf17 false};\par
00127 \par
00128   {\cf18 bool} isEosPresentInPu = {\cf17 false};\par
00129 {\cf21 #if JVET_S0078_NOOUTPUTPRIORPICFLAG}\par
00130   {\cf18 bool} firstSliceInAU = {\cf17 true};\par
00131 {\cf21 #endif}\par
00132 \par
00133   {\cf18 bool} outputPicturePresentInBitstream = {\cf17 false};\par
00134   {\cf17 auto} setOutputPicturePresentInStream = [&]()\par
00135   \{\par
00136     {\cf19 if}( !outputPicturePresentInBitstream )\par
00137     \{\par
00138       PicList::iterator iterPic = pcListPic->begin();\par
00139       {\cf19 while} (!outputPicturePresentInBitstream && iterPic != pcListPic->end())\par
00140       \{\par
00141         Picture *pcPic = *(iterPic++);\par
00142         {\cf19 if} (pcPic->neededForOutput)\par
00143         \{\par
00144           outputPicturePresentInBitstream = {\cf17 true};\par
00145         \}\par
00146       \}\par
00147     \}\par
00148   \};\par
00149 \par
00150 {\cf21 #if JVET_S0163_ON_TARGETOLS_SUBLAYERS}\par
00151     m_cDecLib.setHTidExternalSetFlag(m_mTidExternalSet);\par
00152     m_cDecLib.setTOlsIdxExternalFlag(m_tOlsIdxTidExternalSet);\par
00153 {\cf21 #endif}\par
00154 \par
00155   {\cf19 while} (!!bitstreamFile)\par
00156   \{\par
00157     InputNALUnit nalu;\par
00158     nalu.m_nalUnitType = NAL_UNIT_INVALID;\par
00159 \par
00160     {\cf20 // determine if next NAL unit will be the first one from a new picture}\par
00161     {\cf18 bool} bNewPicture = m_cDecLib.isNewPicture(&bitstreamFile, &bytestream);\par
00162     {\cf18 bool} bNewAccessUnit = bNewPicture && m_cDecLib.isNewAccessUnit( bNewPicture, &bitstreamFile, &bytestream );\par
00163     {\cf19 if}(!bNewPicture)\par
00164     \{\par
00165       AnnexBStats stats = AnnexBStats();\par
00166 \par
00167       {\cf20 // find next NAL unit in stream}\par
00168       byteStreamNALUnit(bytestream, nalu.getBitstream().getFifo(), stats);\par
00169       {\cf19 if} (nalu.getBitstream().getFifo().empty())\par
00170       \{\par
