00054     dest.reserve(surface.width(), surface.height());\par
00055     {\cf19 for} ({\cf18 unsigned} y = 0; y < surface.height(); ++y) \{\par
00056         {\cf17 const} int16_t *__restrict psrc = context.src.data(0, y);\par
00057         uint8_t *__restrict pdst = dest.data(0, y);\par
00058         {\cf19 for} ({\cf18 unsigned} x = 0; x < surface.width(); ++x) \{\par
00059             {\cf20 // dest.write(x, y, clamp(((context.src.read(x, y) + 0x4000 + context.half) >> context.shift), 0, 255));}\par
00060             *pdst++ = clamp(((*psrc++ + 0x4000 + context.half) >> context.shift), 0, 255);\par
00061         \}\par
