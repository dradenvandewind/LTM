00045 Surface ConvertToU8::process({\cf17 const} Surface &surface, {\cf18 unsigned} shift) \{\par
00046     {\cf17 struct }Context \{\par
00047         {\cf17 const} SurfaceView<int16_t> src;\par
00048         {\cf18 unsigned} shift;\par
00049         int16_t half;\par
00050     \} context = \{surface.view_as<int16_t>(), shift, (int16_t)((1 << shift) / 2)\};\par
