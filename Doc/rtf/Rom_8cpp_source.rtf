00718 {\cf18 void} initGeoTemplate()\par
00719 \{\par
00720   g_GeoParams = {\cf17 new} int16_t*[GEO_NUM_PARTITION_MODE];\par
00721   {\cf18 int} modeIdx = 0;\par
00722   {\cf19 for}( {\cf18 int} angleIdx = 0; angleIdx < GEO_NUM_ANGLES; angleIdx++ )\par
00723   \{\par
00724     {\cf19 for}( {\cf18 int} distanceIdx = 0; distanceIdx < GEO_NUM_DISTANCES; distanceIdx++ )\par
00725     \{\par
00726       {\cf19 if}( (distanceIdx == 0 && angleIdx >= 16)\par
00727         || ((distanceIdx == 2 || distanceIdx == 0) && (g_angle2mask[angleIdx] == 0 || g_angle2mask[angleIdx] == 5))\par
00728         || g_angle2mask[angleIdx] == -1 )\par
00729       \{\par
00730         {\cf19 continue};\par
00731       \}\par
00732       g_GeoParams[modeIdx]    = {\cf17 new} int16_t[2];\par
00733       g_GeoParams[modeIdx][0] = (int16_t)angleIdx;\par
00734       g_GeoParams[modeIdx][1] = (int16_t)distanceIdx;\par
00735       modeIdx++;\par
00736     \}\par
00737   \}\par
00738   {\cf19 for} ({\cf18 int} angleIdx = 0; angleIdx < (GEO_NUM_ANGLES >> 2) + 1; angleIdx++)\par
00739   \{\par
00740     {\cf19 if} (g_angle2mask[angleIdx] == -1)\par
00741     \{\par
00742       {\cf19 continue};\par
00743     \}\par
00744     g_globalGeoWeights[g_angle2mask[angleIdx]] = {\cf17 new} int16_t[GEO_WEIGHT_MASK_SIZE * GEO_WEIGHT_MASK_SIZE];\par
00745     g_globalGeoEncSADmask[g_angle2mask[angleIdx]] = {\cf17 new} Pel[GEO_WEIGHT_MASK_SIZE * GEO_WEIGHT_MASK_SIZE];\par
00746 \par
00747     {\cf18 int} distanceX = angleIdx;\par
00748     {\cf18 int} distanceY = (distanceX + (GEO_NUM_ANGLES >> 2)) % GEO_NUM_ANGLES;\par
00749     int16_t rho = (g_Dis[distanceX] << (GEO_MAX_CU_LOG2+1)) + (g_Dis[distanceY] << (GEO_MAX_CU_LOG2 + 1));\par
00750     {\cf17 static} {\cf17 const} int16_t maskOffset = (2*GEO_MAX_CU_SIZE - GEO_WEIGHT_MASK_SIZE) >> 1;\par
00751     {\cf18 int} index = 0;\par
00752     {\cf19 for}( {\cf18 int} y = 0; y < GEO_WEIGHT_MASK_SIZE; y++ )\par
00753     \{\par
00754       int16_t lookUpY = (((y + maskOffset) << 1) + 1) * g_Dis[distanceY];\par
00755       {\cf19 for}( {\cf18 int} x = 0; x < GEO_WEIGHT_MASK_SIZE; x++, index++ )\par
00756       \{\par
00757         int16_t sx_i = ((x + maskOffset) << 1) + 1;\par
00758         int16_t weightIdx = sx_i * g_Dis[distanceX] + lookUpY - rho;\par
00759         {\cf18 int} weightLinearIdx = 32 + weightIdx;\par
00760         g_globalGeoWeights[g_angle2mask[angleIdx]][index] = Clip3(0, 8, (weightLinearIdx + 4) >> 3);\par
00761         g_globalGeoEncSADmask[g_angle2mask[angleIdx]][index] = weightIdx > 0 ? 1 : 0;\par
00762       \}\par
00763     \}\par
00764   \}\par
00765 \par
00766   {\cf19 for}( {\cf18 int} hIdx = 0; hIdx < GEO_NUM_CU_SIZE; hIdx++ )\par
00767   \{\par
00768     int16_t height = 1 << ( hIdx + GEO_MIN_CU_LOG2);\par
00769     {\cf19 for}( {\cf18 int} wIdx = 0; wIdx < GEO_NUM_CU_SIZE; wIdx++ )\par
00770     \{\par
00771       int16_t width = 1 << (wIdx + GEO_MIN_CU_LOG2);\par
00772       {\cf19 for}( {\cf18 int} splitDir = 0; splitDir < GEO_NUM_PARTITION_MODE; splitDir++ )\par
00773       \{\par
00774         int16_t angle         = g_GeoParams[splitDir][0];\par
00775         int16_t distance      = g_GeoParams[splitDir][1];\par
00776         int16_t offsetX       = (GEO_WEIGHT_MASK_SIZE - width) >> 1;\par
00777         int16_t offsetY       = (GEO_WEIGHT_MASK_SIZE - height) >> 1;\par
00778         {\cf19 if}( distance > 0 )\par
00779         \{\par
00780           {\cf19 if}( angle % 16 == 8 || (angle % 16 != 0 && height >= width) )\par
00781           \{\par
00782             offsetY += angle < 16 ? ((distance * (int32_t)height) >> 3) : -((distance * (int32_t)height) >> 3);\par
00783           \}\par
00784           {\cf19 else}\par
00785           \{\par
00786             offsetX += angle < 16 ? ((distance * (int32_t)width) >> 3) : -((distance * (int32_t)width) >> 3);\par
00787           \}\par
00788         \}\par
00789         g_weightOffset[splitDir][hIdx][wIdx][0] = offsetX;\par
00790         g_weightOffset[splitDir][hIdx][wIdx][1] = offsetY;\par
00791       \}\par
00792     \}\par
00793   \}\par
00794 \}\par
00795 \par
00796 int16_t** g_GeoParams;\par
00797 int16_t*  g_globalGeoWeights   [GEO_NUM_PRESTORED_MASK];\par
00798 Pel*      g_globalGeoEncSADmask[GEO_NUM_PRESTORED_MASK];\par
00799 int16_t   g_weightOffset       [GEO_NUM_PARTITION_MODE][GEO_NUM_CU_SIZE][GEO_NUM_CU_SIZE][2];\par
00800 int8_t    g_angle2mask[GEO_NUM_ANGLES] = \{ 0, -1, 1, 2, 3, 4, -1, -1, 5, -1, -1, 4, 3, 2, 1, -1, 0, -1, 1, 2, 3, 4, -1, -1, 5, -1, -1, 4, 3, 2, 1, -1 \};\par
00801 int8_t    g_Dis[GEO_NUM_ANGLES] = \{ 8, 8, 8, 8, 4, 4, 2, 1, 0, -1, -2, -4, -4, -8, -8, -8, -8, -8, -8, -8, -4, -4, -2, -1, 0, 1, 2, 4, 4, 8, 8, 8 \};\par
