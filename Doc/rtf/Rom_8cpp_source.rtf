00239 uint32_t deriveWeightIdxBits(uint8_t bcwIdx) {\cf20 // Note: align this with TEncSbac::codeBcwIdx and TDecSbac::parseBcwIdx}\par
00240 \{\par
00241   uint32_t numBits = 1;\par
