00096 {\cf17 class }ScanGenerator\par
00097 \{\par
00098 {\cf17 private}:\par
00099   uint32_t m_line, m_column;\par
00100   {\cf17 const} uint32_t m_blockWidth, m_blockHeight;\par
00101   {\cf17 const} uint32_t m_stride;\par
00102   {\cf17 const} CoeffScanType m_scanType;\par
00103 \par
00104 {\cf17 public}:\par
00105   ScanGenerator(uint32_t blockWidth, uint32_t blockHeight, uint32_t stride, CoeffScanType scanType)\par
00106     : m_line(0), m_column(0), m_blockWidth(blockWidth), m_blockHeight(blockHeight), m_stride(stride), m_scanType(scanType)\par
00107   \{ \}\par
00108 \par
00109   uint32_t GetCurrentX(){\cf17  const }\{ {\cf19 return} m_column; \}\par
00110   uint32_t GetCurrentY(){\cf17  const }\{ {\cf19 return} m_line; \}\par
00111 \par
00112   uint32_t GetNextIndex(uint32_t blockOffsetX, uint32_t blockOffsetY)\par
00113   \{\par
00114     {\cf17 const} uint32_t rtn = ((m_line + blockOffsetY) * m_stride) + m_column + blockOffsetX;\par
00115 \par
00116     {\cf20 //advance line and column to the next position}\par
00117     {\cf19 switch} (m_scanType)\par
00118     \{\par
00119       {\cf20 //------------------------------------------------}\par
00120 \par
00121       {\cf19 case} SCAN_DIAG:\par
00122 \par
00123         {\cf19 if} ((m_column == m_blockWidth - 1) || (m_line == 0)) {\cf20 //if we reach the end of a rank, go diagonally down to the next one}\par
00124         \{\par
00125           m_line += m_column + 1;\par
00126           m_column = 0;\par
00127 \par
00128           {\cf19 if} (m_line >= m_blockHeight) {\cf20 //if that takes us outside the block, adjust so that we are back on the bottom row}\par
00129           \{\par
00130             m_column += m_line - (m_blockHeight - 1);\par
00131             m_line = m_blockHeight - 1;\par
00132           \}\par
00133         \}\par
00134         {\cf19 else}\par
00135         \{\par
00136           m_column++;\par
00137           m_line--;\par
00138         \}\par
00139         {\cf19 break};\par
00140 \par
00141       {\cf19 case} SCAN_TRAV_HOR:\par
