00243 \par
00244   {\cf19 if} (BCW_NUM > 2 && bcwCodingIdx != 0)\par
00245   \{\par
00246     uint32_t prefixNumBits = BCW_NUM - 2;\par
00247     uint32_t step = 1;\par
00248     uint8_t  prefixSymbol = bcwCodingIdx;\par
00249 \par
00250     {\cf20 // Truncated unary code}\par
00251     uint8_t idx = 1;\par
00252     {\cf19 for} ({\cf18 int} ui = 0; ui < prefixNumBits; ++ui)\par
00253     \{\par
00254       {\cf19 if} (prefixSymbol == idx)\par
00255       \{\par
00256         ++numBits;\par
00257         {\cf19 break};\par
00258       \}\par
00259       {\cf19 else}\par
00260       \{\par
00261         ++numBits;\par
00262         idx += step;\par
00263       \}\par
00264     \}\par
00265   \}\par
00266   {\cf19 return} numBits;\par
00267 \}\par
