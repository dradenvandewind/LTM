00048 {\cf17 using namespace }std;\par
00049 \par
00050 {\cf17 namespace }lctm \{\par
00051 \par
00052 {\cf17 typedef} uint32_t (*codec_api_version_fn_t)();\par
00053 {\cf17 typedef} uint32_t (*codec_api_query_fn_t)({\cf18 int} num, {\cf17 const} {\cf18 char} *buffer, uint32_t buffer_size);\par
00054 {\cf17 typedef} Codec* (*codec_api_create_fn_t)({\cf17 const} {\cf18 char} *name, CodecOperation operation, {\cf17 const} {\cf18 char} *json_configuration);\par
00055 \par
00056 Codec* CodecCreate({\cf17 const} {\cf18 string} &name, CodecOperation operation, {\cf17 const} {\cf18 string} &create_options) \{\par
00057 \par
00058     {\cf20 // Try to load a library of form "<program>/external_codecs/libs/base_<name>.so"}\par
00059 \par
00060     {\cf18 string} library_file = get_program_directory(format({\cf22 "external_codecs/libs/%sbase_%s.%s"}, SHARED_PREFIX, name.c_str(), SHARED_SUFFIX));\par
00061 \par
00062     {\cf19 if}(file_size(library_file) < 0) \{\par
00063         ERR({\cf22 "Cannot find base codec library: \\"%s\\""}, library_file.c_str());\par
00064         {\cf19 return} {\cf17 nullptr};\par
00065     \}\par
00066 \par
00067     codec_api_version_fn_t version_fn;\par
00068     codec_api_query_fn_t query_fn;\par
00069     codec_api_create_fn_t create_fn;\par
00070 \par
00071     shared_handle_t h = CHECK(SHARED_LOAD(library_file.c_str()));\par
00072 \par
00073     {\cf19 if}(!h)\par
00074         {\cf19 return} {\cf17 nullptr};\par
00075 \par
00076     version_fn = (codec_api_version_fn_t)CHECK(SHARED_SYMBOL(h, {\cf22 "CodecAPI_Version"}));\par
00077 \par
00078     {\cf17 const} uint32_t version = version_fn();\par
00079     {\cf19 if}(version != LOADABLE_CODEC_API_VERSION) \{\par
00080         ERR({\cf22 "Base codec library \\"%s\\" has wrong version: %d"}, library_file.c_str(), version);\par
00081         {\cf19 return} {\cf17 nullptr};\par
00082     \}\par
00083 \par
00084     query_fn = (codec_api_query_fn_t)CHECK(SHARED_SYMBOL(h, {\cf22 "CodecAPI_Query"}));\par
00085     create_fn = (codec_api_create_fn_t)CHECK(SHARED_SYMBOL(h, {\cf22 "CodecAPI_Create"}));\par
00086 \par
00087     Codec* codec = create_fn(name.c_str(), operation, create_options.c_str());\par
00088 \par
00089     {\cf19 return} codec;\par
00090 \}\par
00091 \par
00092 {\cf18 void} CodecRelease(Codec* codec) \{\par
00093 \}\par
00094 \par
00095 {\cf20 // Convert a codec error to a user string}\par
00096 {\cf20 //}\par
00097 {\cf18 string} CodecErrorToString(Codec* codec, CodecError error) \{\par
00098     {\cf17 const} {\cf18 size_t} buffer_len = codec->get_error_message(error, 0, 0);\par
00099     {\cf18 char} *buffer = CHECK(({\cf17 static_cast<}{\cf18 char} *{\cf17 >}(alloca(buffer_len))));\par
00100     codec->get_error_message(error, buffer, buffer_len);\par
00101     codec->release_error(error);\par
00102     {\cf19 return} string(buffer, buffer + buffer_len);\par
00103 \}\par
00104 \par
00105 \} {\cf20 // namespace lctm}\par
