00207 {\cf17 template}<{\cf17 typename} T, {\cf18 size_t} N>\par
00208 uint32_t updateCandList(T uiMode, {\cf18 double} uiCost, static_vector<T, N>& candModeList, static_vector<double, N>& candCostList\par
00209   , {\cf18 size_t} uiFastCandNum = N, {\cf18 int}* iserttPos = {\cf17 nullptr})\par
00210 \{\par
00211   CHECK( std::min( uiFastCandNum, candModeList.size() ) != std::min( uiFastCandNum, candCostList.size() ), {\cf22 "Sizes do not match!"} );\par
00212   CHECK( uiFastCandNum > candModeList.capacity(), {\cf22 "The vector is to small to hold all the candidates!"} );\par
00213 \par
00214   {\cf18 size_t} i;\par
00215   {\cf18 size_t} shift = 0;\par
00216   {\cf18 size_t} currSize = std::min( uiFastCandNum, candCostList.size() );\par
00217 \par
00218   {\cf19 while}( shift < uiFastCandNum && shift < currSize && uiCost < candCostList[currSize - 1 - shift] )\par
00219   \{\par
00220     shift++;\par
00221   \}\par
00222 \par
00223   {\cf19 if}( candModeList.size() >= uiFastCandNum && shift != 0 )\par
00224   \{\par
00225     {\cf19 for}( i = 1; i < shift; i++ )\par
00226     \{\par
00227       candModeList[currSize - i] = candModeList[currSize - 1 - i];\par
00228       candCostList[currSize - i] = candCostList[currSize - 1 - i];\par
00229     \}\par
00230     candModeList[currSize - shift] = uiMode;\par
00231     candCostList[currSize - shift] = uiCost;\par
00232     {\cf19 if} (iserttPos != {\cf17 nullptr})\par
00233     \{\par
00234       *iserttPos = int(currSize - shift);\par
00235     \}\par
00236     {\cf19 return} 1;\par
00237   \}\par
00238   {\cf19 else} {\cf19 if}( currSize < uiFastCandNum )\par
00239   \{\par
00240     candModeList.insert( candModeList.end() - shift, uiMode );\par
00241     candCostList.insert( candCostList.end() - shift, uiCost );\par
00242     {\cf19 if} (iserttPos != {\cf17 nullptr})\par
00243     \{\par
00244       *iserttPos = int(candModeList.size() - shift - 1);\par
00245     \}\par
00246     {\cf19 return} 1;\par
00247   \}\par
00248   {\cf19 if} (iserttPos != {\cf17 nullptr})\par
00249   \{\par
00250     *iserttPos = -1;\par
00251   \}\par
00252   {\cf19 return} 0;\par
00253 \}\par
