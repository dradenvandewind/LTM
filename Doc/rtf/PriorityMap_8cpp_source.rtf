00686 {\cf18 void} StaticResiduals::process(Surface src_coeffs[], Surface dst_coeffs[], {\cf17 const} Surface &pixel_sad_plane, {\cf18 unsigned} num_layers,\par
00687                               {\cf18 unsigned} step_width, {\cf18 unsigned} sad_threshold, {\cf18 unsigned} sad_coeff_threshold) \{\par
00688     {\cf17 const} {\cf17 auto} pixel_sad = pixel_sad_plane.view_as<int16_t>();\par
00689 \par
00690     {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_layers; ++layer) \{\par
00691         {\cf17 const} {\cf17 auto} src_view = src_coeffs[layer].view_as<int16_t>();\par
00692         dst_coeffs[layer] = Surface::build_from<int16_t>()\par
00693                                 .generate(src_view.width(), src_view.height(),\par
00694                                           [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00695                                               if ((unsigned)pixel_sad.read(x, y) >= sad_threshold) \{\par
00696                                                   return (unsigned)std::abs(src_view.read(x, y)) > sad_coeff_threshold * step_width\par
00697                                                              ? src_view.read(x, y)\par
00698                                                              : 0;\par
00699                                               \} {\cf19 else} \{\par
00700                                                   return src_view.read(x, y);\par
00701                                               \}\par
00702                                           \})\par
00703                                 .finish();\par
00704     \}\par
00705 \}\par
