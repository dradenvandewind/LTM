00151 Surface PriorityMap::ComputeMeanValue({\cf17 const} Surface &src_surface) \{\par
00152     {\cf17 const} {\cf17 auto} src_view = src_surface.view_as<int16_t>();\par
00153     {\cf17 auto} mean = Surface::build_from<uint8_t>();\par
00154     mean.reserve((src_surface.width() + BLOCK_SIZE - 1) / BLOCK_SIZE, (src_surface.height() + BLOCK_SIZE - 1) / BLOCK_SIZE);\par
00155     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_surface.height(); y += BLOCK_SIZE) \{\par
00156         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_surface.width(); x += BLOCK_SIZE) \{\par
00157             {\cf18 int} acc = 0;\par
00158             {\cf18 unsigned} maxk = LCEVC_MIN(BLOCK_SIZE, src_surface.height() - y);\par
00159             {\cf18 unsigned} maxh = LCEVC_MIN(BLOCK_SIZE, src_surface.width() - x);\par
00160             {\cf19 for} ({\cf18 unsigned} k = 0; k < maxk; k++) \{\par
00161                 {\cf19 for} ({\cf18 unsigned} h = 0; h < maxh; h++) \{\par
00162                     {\cf20 // for both 8 bpp and 10 bpp, work with averages of 8 bpp values}\par
00163                     acc += (src_view.read(x + h, y + k) >> 7);\par
00164                 \}\par
00165             \}\par
00166             acc = acc / (BLOCK_SIZE * BLOCK_SIZE);\par
00167             mean.write(x / BLOCK_SIZE, y / BLOCK_SIZE, clamp(acc, 0, 255));\par
00168         \}\par
00169     \}\par
00170     {\cf19 return} mean.finish();\par
00171 \}\par
