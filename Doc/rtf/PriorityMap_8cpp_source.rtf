00173 Surface PriorityMap::ComputeContrastTexture({\cf17 const} Surface &src_surface, Surface &mean_surface) \{\par
00174     {\cf17 const} {\cf17 auto} src_view = src_surface.view_as<int16_t>();\par
00175     {\cf17 const} {\cf17 auto} mean_view = mean_surface.view_as<uint8_t>();\par
00176     {\cf17 auto} type = Surface::build_from<uint8_t>();\par
00177     type.reserve((src_surface.width() + BLOCK_SIZE - 1) / BLOCK_SIZE, (src_surface.height() + BLOCK_SIZE - 1) / BLOCK_SIZE);\par
00178 \par
00179     {\cf17 const} {\cf18 float} textureThreshold = 0.15f;  {\cf20 // 0.15f}\par
00180     {\cf17 const} {\cf18 float} contrastThreshold = 0.10f; {\cf20 // 0.10f}\par
00181 \par
00182     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_surface.height(); y += BLOCK_SIZE) \{\par
00183         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_surface.width(); x += BLOCK_SIZE) \{\par
00184             {\cf18 int} crossings = 0;\par
00185             {\cf18 int} mean = mean_view.read(x / BLOCK_SIZE, y / BLOCK_SIZE);\par
00186             {\cf18 int} accLo = 0, numLo = 0;\par
00187             {\cf18 int} accHi = 0, numHi = 0;\par
00188             {\cf18 unsigned} maxk = LCEVC_MIN(BLOCK_SIZE, src_surface.height() - y);\par
00189             {\cf18 unsigned} maxh = LCEVC_MIN(BLOCK_SIZE, src_surface.width() - x);\par
00190             {\cf19 for} ({\cf18 unsigned} k = 0; k < maxk; k++) \{\par
00191                 {\cf19 for} ({\cf18 unsigned} h = 0; h < maxh; h++) \{\par
00192                     {\cf20 // X = current; L = left (x-1); U = up (y-1);}\par
00193                     {\cf18 int} pixelX = src_view.read(x + h, y + k) >> 7;\par
00194 \par
00195                     {\cf20 // CONTRAST = difference in high/low mean values}\par
00196                     {\cf19 if} (pixelX <= mean) \{\par
00197                         accLo += pixelX;\par
00198                         numLo++;\par
00199                     \} {\cf19 else} \{\par
00200                         accHi += pixelX;\par
00201                         numHi++;\par
00202                     \}\par
00203 \par
00204                     {\cf19 if} (y > 0) \{\par
00205                         {\cf18 int} pixelU = src_view.read(x + h, y + k - 1) >> 7;\par
00206                         {\cf20 // TEXTURE = number of crossings}\par
00207                         {\cf20 // horizontal egde -- UP delta}\par
00208                         {\cf19 if} ((pixelX > mean && pixelU <= mean) || (pixelX <= mean && pixelU > mean))\par
00209                             crossings += (abs(pixelX - pixelU) > 4);\par
00210                     \}\par
00211                     {\cf19 if} (x > 0) \{\par
00212                         {\cf18 int} pixelL = src_view.read(x + h - 1, y + k) >> 7;\par
00213                         {\cf20 // TEXTURE = number of crossings}\par
00214                         {\cf20 // vertical edge -- LEFT delta}\par
00215                         {\cf19 if} ((pixelX > mean && pixelL <= mean) || (pixelX <= mean && pixelL > mean))\par
00216                             crossings += (abs(pixelX - pixelL) > 4);\par
00217                     \}\par
00218                 \}\par
00219             \}\par
00220             {\cf18 float} meanLo = 0.0f;\par
00221             {\cf18 float} meanHi = 0.0f;\par
00222             {\cf19 if} (numLo > 0 && numHi > 0) \{\par
00223                 meanLo = (float)accLo / numLo;\par
00224                 meanHi = (float)accHi / numHi;\par
00225             \}\par
00226             {\cf18 float} contrast = (meanHi - meanLo) / 255.0f;\par
00227             {\cf18 float} texture = (float)(crossings) / (2 * BLOCK_SIZE * (BLOCK_SIZE - 1));\par
00228 \par
00229             EnumBlockType blockType = EnumBlockType::Plain;\par
00230             {\cf19 if} (texture <= textureThreshold) \{\par
00231                 {\cf20 // if TEXTURE is "small" classify for CONTRAST}\par
00232                 {\cf19 if} (contrast <= contrastThreshold)\par
00233                     blockType = EnumBlockType::Plain;\par
00234                 {\cf19 else}\par
00235                     blockType = EnumBlockType::Edge;\par
00236             \} {\cf19 else} \{\par
00237                 {\cf20 // if TEXTURE is "large" classify for TEXTURE}\par
00238                 {\cf19 if} (contrast <= contrastThreshold)\par
00239                     blockType = EnumBlockType::SmoothTexture;\par
00240                 {\cf19 else}\par
00241                     blockType = EnumBlockType::CoarseTexture;\par
00242 \par
00243                 {\cf19 if} ((blockType == EnumBlockType::SmoothTexture) && (contrast <= 0.02f)) \{\par
00244                     blockType = EnumBlockType::Plain;\par
00245                 \}\par
00246             \}\par
00247             type.write(x / BLOCK_SIZE, y / BLOCK_SIZE, (uint8_t)blockType);\par
00248         \}\par
00249     \}\par
00250     {\cf19 return} type.finish();\par
00251 \}\par
