00054 PriorityMap::TileGrid::TileGrid({\cf17 const} Surface &surface, {\cf18 unsigned} tile_size_x, {\cf18 unsigned} tile_size_y)\par
00055     : tile_size_x_\{tile_size_x\}, tile_size_y_\{tile_size_y\} \{\par
00056 \par
00057     n_tiles_x_ = surface.width() / tile_size_x;\par
00058     {\cf19 if} (n_tiles_x_ * tile_size_x < surface.width()) \{\par
00059         n_tiles_x_++;\par
00060     \}\par
00061 \par
00062     n_tiles_y_ = surface.height() / tile_size_y;\par
00063     {\cf19 if} (n_tiles_y_ * tile_size_y < surface.height()) \{\par
00064         n_tiles_y_++;\par
00065     \}\par
00066 \}\par
00067 \par
00068 PriorityMap::TileGrid::TileGrid({\cf18 unsigned} tile_size_x, {\cf18 unsigned} tile_size_y, {\cf18 unsigned} n_tiles_x, {\cf18 unsigned} n_tiles_y)\par
00069     : tile_size_x_\{tile_size_x\}, tile_size_y_\{tile_size_y\}, n_tiles_x_\{n_tiles_x\}, n_tiles_y_\{n_tiles_y\} \{\}\par
00070 \par
00071 std::array<PriorityMap::pmap_function, 3> PriorityMap::priority_functions_ = \{&kill_all_residuals, &keep_all_residuals,\par
00072                                                                               &threshold_cutoff\};\par
00073 \par
00074 {\cf20 // For each block in map - kill coefficients if corresponding block is set to 0 in map}\par
00075 Surface PriorityMap::process({\cf17 const} Surface &src_plane, {\cf18 unsigned} priority_tile_x, {\cf18 unsigned} priority_tile_y,\par
00076                              KillingFunction killing_function) \{\par
00077     assert(0 <= killing_function);\par
00078     assert(killing_function < priority_functions_.size());\par
00079 \par
00080     {\cf17 const} TileGrid grid\{src_plane, priority_tile_x, priority_tile_y\};\par
00081 \par
00082     {\cf20 // Store priority values in raster order}\par
00083     {\cf20 // This implementation uses a hardcoded 'dummy' value - should}\par
00084     {\cf20 // be replaced by a more sophisticated algorithm}\par
00085     std::vector<double> pvalues(grid.n_tiles_x_ * grid.n_tiles_y_);\par
00086 \par
00087     {\cf19 for} ({\cf18 unsigned} tile_y = 0; tile_y < grid.n_tiles_y_; ++tile_y) \{\par
00088         {\cf19 for} ({\cf18 unsigned} tile_x = 0; tile_x < grid.n_tiles_x_; ++tile_x) \{\par
00089 \par
00090             pvalues[tile_y * grid.n_tiles_x_ + tile_x] = 0.7;\par
00091         \}\par
00092     \}\par
00093 \par
00094     {\cf19 return} priority_functions_[killing_function](src_plane, pvalues, grid);\par
00095 \}\par
00096 \par
00097 Surface PriorityMap::kill_all_residuals({\cf17 const} Surface &src_surface, {\cf17 const} std::vector<double> &priority_values,\par
00098                                         {\cf17 const} TileGrid &tgrid) \{\par
00099     {\cf19 return} Surface::build_from<value_type>()\par
00100         .generate(src_surface.width(), src_surface.height(),\par
00101                   []({\cf18 unsigned} x, {\cf18 unsigned} y) -> value_type \{ return ResidualLabel::RESIDUAL_KILL; \})\par
00102         .finish();\par
00103 \}\par
00104 \par
00105 Surface PriorityMap::keep_all_residuals({\cf17 const} Surface &src_surface, {\cf17 const} std::vector<double> &priority_values,\par
00106                                         {\cf17 const} TileGrid &tgrid) \{\par
00107     {\cf19 return} Surface::build_from<value_type>()\par
00108         .generate(src_surface.width(), src_surface.height(),\par
00109                   []({\cf18 unsigned} x, {\cf18 unsigned} y) -> value_type \{ return ResidualLabel::RESIDUAL_LIVE; \})\par
00110         .finish();\par
00111 \}\par
00112 \par
00113 Surface PriorityMap::threshold_cutoff({\cf17 const} Surface &src_surface, {\cf17 const} std::vector<double> &priority_values,\par
00114                                       {\cf17 const} TileGrid &tgrid) \{\par
00115 \par
00116     {\cf17 const} {\cf18 double} T = 0.5;\par
00117     {\cf17 const} {\cf17 auto} threshold_kill_function = [T]({\cf17 const} {\cf18 double} priority) -> value_type \{\par
00118         {\cf19 return} (priority > T) ? ResidualLabel::RESIDUAL_LIVE : ResidualLabel::RESIDUAL_KILL;\par
00119     \};\par
00120 \par
00121     Surface pixel_priority_map =\par
00122         Surface::build_from<value_type>()\par
00123             .generate(src_surface.width(), src_surface.height(),\par
00124                       [priority_values, tgrid, threshold_kill_function]({\cf18 unsigned} x, {\cf18 unsigned} y) -> value_type \{\par
00125                           const auto tile_x = x / tgrid.tile_size_x_;\par
00126                           const auto tile_y = y / tgrid.tile_size_y_;\par
00127                           const auto priority_value = priority_values[tile_y * tgrid.n_tiles_x_ + tile_x];\par
00128                           const auto priority_label = threshold_kill_function(priority_value);\par
00129                           return priority_label;\par
00130                       \})\par
00131             .finish();\par
00132     {\cf19 return} pixel_priority_map;\par
00133 \}\par
00134 \par
00135 Surface PriorityMapVis::process({\cf17 const} Surface &src_plane) \{\par
00136     {\cf20 // Read-only access to source surface}\par
