00221 {\cf20 // To minimize the distortion only. No rate is considered.}\par
00222 {\cf18 void} Quant::xSignBitHidingHDQ( TCoeff* pQCoef, {\cf17 const} TCoeff* pCoef, TCoeff* deltaU, {\cf17 const} CoeffCodingContext& cctx, {\cf17 const} {\cf18 int} maxLog2TrDynamicRange )\par
00223 \{\par
00224   {\cf17 const} uint32_t width     = cctx.width();\par
00225   {\cf17 const} uint32_t height    = cctx.height();\par
00226   {\cf17 const} uint32_t groupSize = 1 << cctx.log2CGSize();\par
00227 \par
00228   {\cf17 const} TCoeff entropyCodingMinimum = -(1 << maxLog2TrDynamicRange);\par
00229   {\cf17 const} TCoeff entropyCodingMaximum =  (1 << maxLog2TrDynamicRange) - 1;\par
00230 \par
00231   {\cf18 int} lastCG = -1;\par
00232   {\cf18 int} absSum = 0 ;\par
00233   {\cf18 int} n ;\par
00234 \par
00235   {\cf19 for}( {\cf18 int} subSet = (width*height-1) >> cctx.log2CGSize(); subSet >= 0; subSet-- )\par
00236   \{\par
00237     {\cf18 int}  subPos = subSet << cctx.log2CGSize();\par
00238     {\cf18 int}  firstNZPosInCG=groupSize , lastNZPosInCG=-1 ;\par
00239     absSum = 0 ;\par
00240 \par
00241     {\cf19 for}(n = groupSize-1; n >= 0; --n )\par
00242     \{\par
00243       {\cf19 if}( pQCoef[ cctx.blockPos( n + subPos ) ] )\par
00244       \{\par
00245         lastNZPosInCG = n;\par
00246         {\cf19 break};\par
00247       \}\par
00248     \}\par
00249 \par
00250     {\cf19 for}(n = 0; n <groupSize; n++ )\par
00251     \{\par
00252       {\cf19 if}( pQCoef[ cctx.blockPos( n + subPos ) ] )\par
00253       \{\par
00254         firstNZPosInCG = n;\par
00255         {\cf19 break};\par
00256       \}\par
00257     \}\par
00258 \par
00259     {\cf19 for}(n = firstNZPosInCG; n <=lastNZPosInCG; n++ )\par
00260     \{\par
00261       absSum += int(pQCoef[ cctx.blockPos( n + subPos ) ]);\par
00262     \}\par
00263 \par
00264     {\cf19 if}(lastNZPosInCG>=0 && lastCG==-1)\par
00265     \{\par
00266       lastCG = 1 ;\par
00267     \}\par
00268 \par
00269     {\cf19 if}( lastNZPosInCG-firstNZPosInCG>=SBH_THRESHOLD )\par
00270     \{\par
00271       uint32_t signbit = (pQCoef[cctx.blockPos(subPos+firstNZPosInCG)]>0?0:1) ;\par
00272       {\cf19 if}( signbit!=(absSum&0x1) )  {\cf20 //compare signbit with sum_parity}\par
00273       \{\par
00274         TCoeff curCost    = std::numeric_limits<TCoeff>::max();\par
00275         TCoeff minCostInc = std::numeric_limits<TCoeff>::max();\par
00276         {\cf18 int} minPos =-1, finalChange=0, curChange=0;\par
00277 \par
00278         {\cf19 for}( n = (lastCG==1?lastNZPosInCG:groupSize-1) ; n >= 0; --n )\par
00279         \{\par
00280           uint32_t blkPos   = cctx.blockPos( n+subPos );\par
00281           {\cf19 if}(pQCoef[ blkPos ] != 0 )\par
00282           \{\par
00283             {\cf19 if}(deltaU[blkPos]>0)\par
00284             \{\par
00285               curCost = - deltaU[blkPos];\par
00286               curChange=1 ;\par
00287             \}\par
00288             {\cf19 else}\par
00289             \{\par
00290               {\cf20 //curChange =-1;}\par
00291               {\cf19 if}(n==firstNZPosInCG && abs(pQCoef[blkPos])==1)\par
00292               \{\par
00293                 curCost = std::numeric_limits<TCoeff>::max();\par
00294               \}\par
00295               {\cf19 else}\par
00296               \{\par
00297                 curCost = deltaU[blkPos];\par
00298                 curChange =-1;\par
00299               \}\par
00300             \}\par
00301           \}\par
00302           {\cf19 else}\par
00303           \{\par
00304             {\cf19 if}(n<firstNZPosInCG)\par
00305             \{\par
00306               uint32_t thisSignBit = (pCoef[blkPos]>=0?0:1);\par
00307               {\cf19 if}(thisSignBit != signbit )\par
00308               \{\par
00309                 curCost = std::numeric_limits<TCoeff>::max();\par
00310               \}\par
00311               {\cf19 else}\par
00312               \{\par
00313                 curCost = - (deltaU[blkPos])  ;\par
00314                 curChange = 1 ;\par
00315               \}\par
00316             \}\par
00317             {\cf19 else}\par
00318             \{\par
00319               curCost = - (deltaU[blkPos])  ;\par
00320               curChange = 1 ;\par
00321             \}\par
00322           \}\par
00323 \par
00324           {\cf19 if}( curCost<minCostInc)\par
00325           \{\par
00326             minCostInc = curCost ;\par
00327             finalChange = curChange ;\par
00328             minPos = blkPos ;\par
00329           \}\par
00330         \} {\cf20 //CG loop}\par
00331 \par
00332         {\cf19 if}(pQCoef[minPos] == entropyCodingMaximum || pQCoef[minPos] == entropyCodingMinimum)\par
00333         \{\par
00334           finalChange = -1;\par
00335         \}\par
00336 \par
00337         {\cf19 if}(pCoef[minPos]>=0)\par
00338         \{\par
00339           pQCoef[minPos] += finalChange ;\par
00340         \}\par
00341         {\cf19 else}\par
00342         \{\par
00343           pQCoef[minPos] -= finalChange ;\par
00344         \}\par
00345       \} {\cf20 // Hide}\par
00346     \}\par
00347     {\cf19 if}(lastCG==1)\par
00348     \{\par
00349       lastCG=0 ;\par
00350     \}\par
00351   \} {\cf20 // TU loop}\par
00352 \par
00353   {\cf19 return};\par
00354 \}\par
