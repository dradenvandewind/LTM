00779 {\cf18 void} Quant::processScalingListEnc( {\cf18 int} *coeff, {\cf18 int} *quantcoeff, {\cf18 int} quantScales, uint32_t height, uint32_t width, uint32_t ratio, {\cf18 int} sizuNum, uint32_t dc)\par
00780 \{\par
00781   {\cf19 if} (height != width)\par
00782   \{\par
00783     {\cf19 for} (uint32_t j = 0; j<height; j++)\par
00784     \{\par
00785       {\cf19 for} (uint32_t i = 0; i<width; i++)\par
00786       \{\par
00787         {\cf19 if} (j >= JVET_C0024_ZERO_OUT_TH || i >= JVET_C0024_ZERO_OUT_TH)\par
00788         \{\par
00789           quantcoeff[j*width + i] = 0;\par
00790           {\cf19 continue};\par
00791         \}\par
00792         {\cf18 int} ratioWH = (height>width) ? height / width : width / height;\par
00793         {\cf18 int} ratioH = (height / sizuNum) ? (height / sizuNum) : (sizuNum / height); {\cf20 // 32/8 = 4}\par
00794         {\cf18 int} ratioW = (width / sizuNum) ? (width / sizuNum) : (sizuNum / width); {\cf20 //16/8 = 2 //sizeNum = 8/4}\par
00795         {\cf19 if} (height > width)\par
00796         \{\par
00797           quantcoeff[j*width + i] = quantScales / coeff[sizuNum * (j / ratioH) + ((i * ratioWH) / ratioH)];\par
00798         \}\par
00799         {\cf19 else} {\cf20 //ratioH < ratioW}\par
00800         \{\par
00801           quantcoeff[j*width + i] = quantScales / coeff[sizuNum * ((j * ratioWH) / ratioW) + (i / ratioW)];\par
00802         \}\par
00803         {\cf18 int} largeOne = (width > height) ? width : height;\par
00804         {\cf19 if} (largeOne>8)\par
00805         \{\par
00806           quantcoeff[0] = quantScales / dc;\par
00807         \}\par
00808       \}\par
00809     \}\par
00810     {\cf19 return};\par
00811   \}\par
00812   {\cf19 for}(uint32_t j=0;j<height;j++)\par
00813   \{\par
00814     {\cf19 for}(uint32_t i=0;i<width;i++)\par
00815     \{\par
00816       quantcoeff[j*width + i] = quantScales / coeff[sizuNum * (j / ratio) + i / ratio];\par
00817     \}\par
00818   \}\par
00819 \par
00820   {\cf19 if}(ratio > 1)\par
00821   \{\par
00822     quantcoeff[0] = quantScales / dc;\par
00823   \}\par
00824 \}\par
00825 \par
00826 {\cf18 void} Quant::processScalingListDec( {\cf17 const} {\cf18 int} *coeff, {\cf18 int} *dequantcoeff, {\cf18 int} invQuantScales, uint32_t height, uint32_t width, uint32_t ratio, {\cf18 int} sizeNum, uint32_t dc)\par
00827 \{\par
00828   {\cf19 if} (height != width)\par
00829   \{\par
00830     {\cf18 int} ratioWH = (height > width  ) ? (height / width  ) : (width   / height);\par
00831     {\cf18 int} ratioH  = (height / sizeNum) ? (height / sizeNum) : (sizeNum / height);\par
00832     {\cf18 int} ratioW  = (width  / sizeNum) ? (width  / sizeNum) : (sizeNum / width );\par
00833     {\cf19 if} (height > width)\par
00834     \{\par
00835       {\cf19 for} (uint32_t j = 0; j < height; j++)\par
00836       \{\par
00837         {\cf18 int} coeffLineSep        = (j / ratioH) * sizeNum;\par
00838         {\cf18 int} dequantCoeffLineSep = j * width;\par
00839         {\cf19 for} (uint32_t i = 0; i < width; i++)\par
00840         \{\par
00841           {\cf19 if} (i >= JVET_C0024_ZERO_OUT_TH || j >= JVET_C0024_ZERO_OUT_TH)\par
00842           \{\par
00843             dequantcoeff[dequantCoeffLineSep + i] = 0;\par
00844             {\cf19 continue};\par
00845           \}\par
00846           dequantcoeff[dequantCoeffLineSep + i] = invQuantScales * coeff[coeffLineSep + ((i * ratioWH) / ratioH)];\par
00847         \}\par
00848       \}\par
00849     \}\par
00850     {\cf19 else}  {\cf20 //ratioH < ratioW}\par
00851     \{\par
00852       {\cf19 for} (uint32_t j = 0; j < height; j++)\par
00853       \{\par
00854         {\cf18 int} coeffLineSep        = ((j * ratioWH) / ratioW) * sizeNum;\par
00855         {\cf18 int} dequantCoeffLineSep = j * width;\par
00856         {\cf19 for} (uint32_t i = 0; i < width; i++)\par
00857         \{\par
00858           {\cf19 if} (i >= JVET_C0024_ZERO_OUT_TH || j >= JVET_C0024_ZERO_OUT_TH)\par
00859           \{\par
00860             dequantcoeff[dequantCoeffLineSep + i] = 0;\par
00861             {\cf19 continue};\par
00862           \}\par
00863           dequantcoeff[dequantCoeffLineSep + i] = invQuantScales * coeff[coeffLineSep + (i / ratioW)];\par
00864         \}\par
00865       \}\par
00866     \}\par
00867     {\cf18 int} largeOne = (width > height) ? width : height;\par
00868     {\cf19 if} (largeOne > 8)\par
00869       dequantcoeff[0] = invQuantScales * dc;\par
00870     {\cf19 return};\par
00871   \}\par
00872   {\cf19 for} (uint32_t j = 0; j<height; j++)\par
00873   \{\par
00874     {\cf18 int} coeffLineSep        = (j / ratio) * sizeNum;\par
00875     {\cf18 int} dequantCoeffLineSep = j * width;\par
00876     {\cf19 for} (uint32_t i = 0; i<width; i++)\par
00877     \{\par
00878       dequantcoeff[dequantCoeffLineSep + i] = invQuantScales * coeff[coeffLineSep + i / ratio];\par
00879     \}\par
00880   \}\par
00881 \par
00882   {\cf19 if} (ratio > 1)\par
00883   \{\par
00884     dequantcoeff[0] = invQuantScales * dc;\par
00885   \}\par
00886 \}\par
