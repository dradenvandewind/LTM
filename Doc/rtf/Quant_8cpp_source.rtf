00954 {\cf18 void} Quant::quant(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &pSrc, TCoeff &uiAbsSum, {\cf17 const} QpParam &cQP, {\cf17 const} Ctx& ctx)\par
00955 \{\par
00956   {\cf17 const} SPS &sps            = *tu.cs->sps;\par
00957   {\cf17 const} CompArea &rect      = tu.blocks[compID];\par
00958   {\cf17 const} uint32_t uiWidth        = rect.width;\par
00959   {\cf17 const} uint32_t uiHeight       = rect.height;\par
00960   {\cf17 const} {\cf18 int} channelBitDepth = sps.getBitDepth(toChannelType(compID));\par
00961 \par
00962   {\cf17 const} CCoeffBuf &piCoef   = pSrc;\par
00963         CoeffBuf   piQCoef  = tu.getCoeffs(compID);\par
00964 \par
00965   {\cf17 const} {\cf18 bool} useTransformSkip      = (tu.mtsIdx[compID] == MTS_SKIP);\par
00966   {\cf17 const} {\cf18 int}  maxLog2TrDynamicRange = sps.getMaxLog2TrDynamicRange(toChannelType(compID));\par
00967 \par
00968   \{\par
00969     CoeffCodingContext cctx(tu, compID, tu.cs->slice->getSignDataHidingEnabledFlag());\par
00970     {\cf17 const} TCoeff entropyCodingMinimum = -(1 << maxLog2TrDynamicRange);\par
00971     {\cf17 const} TCoeff entropyCodingMaximum =  (1 << maxLog2TrDynamicRange) - 1;\par
00972 \par
00973     TCoeff deltaU[MAX_TB_SIZEY * MAX_TB_SIZEY];\par
00974     {\cf18 int} scalingListType = getScalingListType(tu.cu->predMode, compID);\par
00975     CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
00976     {\cf17 const} uint32_t uiLog2TrWidth = floorLog2(uiWidth);\par
00977     {\cf17 const} uint32_t uiLog2TrHeight = floorLog2(uiHeight);\par
00978     {\cf18 int} *piQuantCoeff = getQuantCoeff(scalingListType, cQP.rem(useTransformSkip), uiLog2TrWidth, uiLog2TrHeight);\par
00979     {\cf17 const} {\cf18 bool} disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
00980     {\cf17 const} {\cf18 bool} isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
00981     {\cf17 const} {\cf18 bool} disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
00982     {\cf17 const} {\cf18 bool} enableScalingLists = getUseScalingList(uiWidth, uiHeight, useTransformSkip, isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
00983 \par
00984     {\cf20 // for blocks that where width*height != 4^N, the effective scaling applied during transformation cannot be}\par
00985     {\cf20 // compensated by a bit-shift (the quantised result will be sqrt(2) * larger than required).}\par
00986     {\cf20 // The quantScale table and shift is used to compensate for this.}\par
00987     {\cf17 const} {\cf18 bool} needSqrtAdjustment= TU::needsBlockSizeTrafoScale( tu, compID );\par
00988     {\cf17 const} {\cf18 int} defaultQuantisationCoefficient    = g_quantScales[needSqrtAdjustment?1:0][cQP.rem(useTransformSkip)];\par
00989     {\cf18 int} iTransformShift = getTransformShift(channelBitDepth, rect.size(), maxLog2TrDynamicRange) + ( needSqrtAdjustment?-1:0);\par
00990 \par
00991     {\cf19 if} (useTransformSkip && sps.getSpsRangeExtension().getExtendedPrecisionProcessingFlag())\par
00992     \{\par
00993       iTransformShift = std::max<int>(0, iTransformShift);\par
00994     \}\par
00995 \par
00996     {\cf17 const} {\cf18 int} iQBits = QUANT_SHIFT + cQP.per(useTransformSkip) + (useTransformSkip ? 0 : iTransformShift);\par
00997     {\cf20 // QBits will be OK for any internal bit depth as the reduction in transform shift is balanced by an increase in Qp_per due to QpBDOffset}\par
00998 \par
00999     {\cf17 const} int64_t iAdd = int64_t(tu.cs->slice->isIRAP() ? 171 : 85) << int64_t(iQBits - 9);\par
01000     {\cf17 const} {\cf18 int} qBits8 = iQBits - 8;\par
01001 \par
01002     {\cf17 const} uint32_t lfnstIdx = tu.cu->lfnstIdx;\par
01003     {\cf17 const} {\cf18 int} maxNumberOfCoeffs = lfnstIdx > 0 ? ((( uiWidth == 4 && uiHeight == 4 ) || ( uiWidth == 8 && uiHeight == 8) ) ? 8 : 16) : piQCoef.area();\par
01004     memset( piQCoef.buf, 0, {\cf17 sizeof}(TCoeff) * piQCoef.area() );\par
01005 \par
01006     {\cf17 const} ScanElement* scan = g_scanOrder[SCAN_GROUPED_4x4][SCAN_DIAG][gp_sizeIdxInfo->idxFrom(uiWidth)][gp_sizeIdxInfo->idxFrom(uiHeight)];\par
01007 \par
01008     {\cf19 for} ({\cf18 int} uiScanPos = 0; uiScanPos < maxNumberOfCoeffs; uiScanPos++)\par
01009     \{\par
01010       {\cf17 const} {\cf18 int} uiBlockPos = scan[uiScanPos].idx;\par
01011       {\cf17 const} TCoeff iLevel   = piCoef.buf[uiBlockPos];\par
01012       {\cf17 const} TCoeff iSign    = (iLevel < 0 ? -1: 1);\par
01013 \par
01014       {\cf17 const} int64_t  tmpLevel = (int64_t)abs(iLevel) * (enableScalingLists ? piQuantCoeff[uiBlockPos] : defaultQuantisationCoefficient);\par
01015 \par
01016       {\cf17 const} TCoeff quantisedMagnitude = TCoeff((tmpLevel + iAdd ) >> iQBits);\par
01017       deltaU[uiBlockPos] = (TCoeff)((tmpLevel - ((int64_t)quantisedMagnitude<<iQBits) )>> qBits8);\par
01018 \par
01019       uiAbsSum += quantisedMagnitude;\par
01020       {\cf17 const} TCoeff quantisedCoefficient = quantisedMagnitude * iSign;\par
01021 \par
01022       piQCoef.buf[uiBlockPos] = Clip3<TCoeff>( entropyCodingMinimum, entropyCodingMaximum, quantisedCoefficient );\par
01023     \} {\cf20 // for n}\par
01024     {\cf19 if} ((tu.cu->bdpcmMode && isLuma(compID)) || (tu.cu->bdpcmModeChroma && isChroma(compID)) )\par
01025     \{\par
01026       fwdResDPCM( tu, compID );\par
01027     \}\par
01028     {\cf19 if}( cctx.signHiding() )\par
01029     \{\par
01030       {\cf19 if}(uiAbsSum >= 2) {\cf20 //this prevents TUs with only one coefficient of value 1 from being tested}\par
01031       \{\par
01032         xSignBitHidingHDQ(piQCoef.buf, piCoef.buf, deltaU, cctx, maxLog2TrDynamicRange);\par
01033       \}\par
01034     \}\par
01035   \} {\cf20 //if RDOQ}\par
01036   {\cf20 //return;}\par
01037 \}\par
01038 \par
01039 {\cf18 bool} Quant::xNeedRDOQ(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &pSrc, {\cf17 const} QpParam &cQP)\par
01040 \{\par
01041   {\cf17 const} SPS &sps            = *tu.cs->sps;\par
01042   {\cf17 const} CompArea &rect      = tu.blocks[compID];\par
01043   {\cf17 const} uint32_t uiWidth        = rect.width;\par
01044   {\cf17 const} uint32_t uiHeight       = rect.height;\par
01045   {\cf17 const} {\cf18 int} channelBitDepth = sps.getBitDepth(toChannelType(compID));\par
01046 \par
01047   {\cf17 const} CCoeffBuf piCoef    = pSrc;\par
01048 \par
01049   {\cf17 const} {\cf18 bool} useTransformSkip      = (tu.mtsIdx[compID] == MTS_SKIP);\par
01050   {\cf17 const} {\cf18 int}  maxLog2TrDynamicRange = sps.getMaxLog2TrDynamicRange(toChannelType(compID));\par
01051 \par
01052   {\cf18 int} scalingListType = getScalingListType(tu.cu->predMode, compID);\par
01053   CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
01054 \par
01055   {\cf17 const} uint32_t uiLog2TrWidth  = floorLog2(uiWidth);\par
01056   {\cf17 const} uint32_t uiLog2TrHeight = floorLog2(uiHeight);\par
01057   {\cf18 int} *piQuantCoeff         = getQuantCoeff(scalingListType, cQP.rem(useTransformSkip), uiLog2TrWidth, uiLog2TrHeight);\par
01058 \par
01059   {\cf17 const} {\cf18 bool} disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
01060   {\cf17 const} {\cf18 bool} isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
01061   {\cf17 const} {\cf18 bool} disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
01062   {\cf17 const} {\cf18 bool} enableScalingLists = getUseScalingList(uiWidth, uiHeight, (useTransformSkip != 0), isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
01063 \par
01064   {\cf20 /* for 422 chroma blocks, the effective scaling applied during transformation is not a power of 2, hence it cannot be}\par
01065 {\cf20     * implemented as a bit-shift (the quantised result will be sqrt(2) * larger than required). Alternatively, adjust the}\par
01066 {\cf20     * uiLog2TrSize applied in iTransformShift, such that the result is 1/sqrt(2) the required result (i.e. smaller)}\par
01067 {\cf20     * Then a QP+3 (sqrt(2)) or QP-3 (1/sqrt(2)) method could be used to get the required result}\par
01068 {\cf20     */}\par
01069   {\cf17 const} {\cf18 bool} needSqrtAdjustment= TU::needsBlockSizeTrafoScale( tu, compID );\par
01070   {\cf17 const} {\cf18 int} defaultQuantisationCoefficient    = g_quantScales[needSqrtAdjustment?1:0][cQP.rem(useTransformSkip)];\par
01071   {\cf18 int} iTransformShift = getTransformShift(channelBitDepth, rect.size(), maxLog2TrDynamicRange) + (needSqrtAdjustment?-1:0);\par
01072 \par
01073   {\cf19 if} (useTransformSkip && sps.getSpsRangeExtension().getExtendedPrecisionProcessingFlag())\par
01074   \{\par
01075     iTransformShift = std::max<int>(0, iTransformShift);\par
01076   \}\par
01077 \par
01078 \par
01079   {\cf17 const} {\cf18 int} iQBits = QUANT_SHIFT + cQP.per(useTransformSkip) + iTransformShift;\par
01080   assert(iQBits>=0);\par
01081   {\cf20 // QBits will be OK for any internal bit depth as the reduction in transform shift is balanced by an increase in Qp_per due to QpBDOffset}\par
01082 \par
01083   {\cf20 // iAdd is different from the iAdd used in normal quantization}\par
01084   {\cf17 const} int64_t iAdd = int64_t(compID == COMPONENT_Y ? 171 : 256) << (iQBits - 9);\par
01085 \par
01086   {\cf19 for} ({\cf18 int} uiBlockPos = 0; uiBlockPos < rect.area(); uiBlockPos++)\par
01087   \{\par
01088     {\cf17 const} TCoeff iLevel   = piCoef.buf[uiBlockPos];\par
01089     {\cf17 const} int64_t  tmpLevel = (int64_t)abs(iLevel) * (enableScalingLists ? piQuantCoeff[uiBlockPos] : defaultQuantisationCoefficient);\par
01090     {\cf17 const} TCoeff quantisedMagnitude = TCoeff((tmpLevel + iAdd ) >> iQBits);\par
01091 \par
01092     {\cf19 if} (quantisedMagnitude != 0)\par
01093     \{\par
01094       {\cf19 return} {\cf17 true};\par
01095     \}\par
01096   \} {\cf20 // for n}\par
01097   {\cf19 return} {\cf17 false};\par
01098 \}\par
01099 \par
01100 \par
01101 {\cf18 void} Quant::transformSkipQuantOneSample(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} TCoeff &resiDiff, TCoeff &coeff, {\cf17 const} uint32_t &uiPos, {\cf17 const} QpParam &cQP, {\cf17 const} {\cf18 bool} bUseHalfRoundingPoint)\par
01102 \{\par
01103   {\cf17 const} SPS           &sps = *tu.cs->sps;\par
01104   {\cf17 const} CompArea      &rect                           = tu.blocks[compID];\par
01105   {\cf17 const} uint32_t           uiWidth                        = rect.width;\par
01106   {\cf17 const} uint32_t           uiHeight                       = rect.height;\par
01107   {\cf17 const} {\cf18 int}            maxLog2TrDynamicRange          = sps.getMaxLog2TrDynamicRange(toChannelType(compID));\par
01108   {\cf17 const} {\cf18 int}            channelBitDepth                = sps.getBitDepth(toChannelType(compID));\par
01109   {\cf17 const} {\cf18 int}            iTransformShift                = getTransformShift(channelBitDepth, rect.size(), maxLog2TrDynamicRange);\par
01110   {\cf17 const} {\cf18 int}            scalingListType                = getScalingListType(tu.cu->predMode, compID);\par
01111 \par
01112   {\cf17 const} {\cf18 bool}           disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
01113   {\cf17 const} {\cf18 bool}           isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
01114   {\cf17 const} {\cf18 bool}           disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
01115   {\cf17 const} {\cf18 bool}           enableScalingLists = getUseScalingList(uiWidth, uiHeight, {\cf17 true}, isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
01116   {\cf17 const} {\cf18 bool}           useTransformSkip = (tu.mtsIdx[compID] == MTS_SKIP);\par
01117   {\cf17 const} {\cf18 int}            defaultQuantisationCoefficient = g_quantScales[0][cQP.rem(useTransformSkip)];\par
01118 \par
01119   CHECK( scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"} );\par
01120 \par
01121   {\cf17 const} uint32_t uiLog2TrWidth      = floorLog2(uiWidth);\par
01122   {\cf17 const} uint32_t uiLog2TrHeight     = floorLog2(uiHeight);\par
01123   {\cf17 const} {\cf18 int} *{\cf17 const} piQuantCoeff = getQuantCoeff(scalingListType, cQP.rem(useTransformSkip), uiLog2TrWidth, uiLog2TrHeight);\par
01124 \par
01125   {\cf20 /* for 422 chroma blocks, the effective scaling applied during transformation is not a power of 2, hence it cannot be}\par
01126 {\cf20   * implemented as a bit-shift (the quantised result will be sqrt(2) * larger than required). Alternatively, adjust the}\par
01127 {\cf20   * uiLog2TrSize applied in iTransformShift, such that the result is 1/sqrt(2) the required result (i.e. smaller)}\par
01128 {\cf20   * Then a QP+3 (sqrt(2)) or QP-3 (1/sqrt(2)) method could be used to get the required result}\par
01129 {\cf20   */}\par
01130   {\cf17 const} {\cf18 int} iQBits = QUANT_SHIFT + cQP.per(useTransformSkip) + (useTransformSkip ? 0 : iTransformShift);\par
01131   {\cf20 // QBits will be OK for any internal bit depth as the reduction in transform shift is balanced by an increase in Qp_per due to QpBDOffset}\par
01132   {\cf17 const} {\cf18 int} iAdd = int64_t(bUseHalfRoundingPoint ? 256 : (tu.cs->slice->isIRAP() ? 171 : 85)) << int64_t(iQBits - 9);\par
01133   TCoeff transformedCoefficient;\par
01134 \par
01135   {\cf20 // transform-skip}\par
01136   {\cf19 if} (iTransformShift >= 0)\par
01137   \{\par
01138     transformedCoefficient = resiDiff << iTransformShift;\par
01139   \}\par
01140   {\cf19 else} {\cf20 // for very high bit depths}\par
01141   \{\par
01142     {\cf17 const} {\cf18 int} iTrShiftNeg  = -iTransformShift;\par
01143     {\cf17 const} {\cf18 int} offset       = 1 << (iTrShiftNeg - 1);\par
01144     transformedCoefficient = ( resiDiff + offset ) >> iTrShiftNeg;\par
01145   \}\par
01146 \par
01147   {\cf20 // quantization}\par
01148   {\cf17 const} TCoeff iSign = (transformedCoefficient < 0 ? -1: 1);\par
01149 \par
01150   {\cf17 const} {\cf18 int} quantisationCoefficient = enableScalingLists ? piQuantCoeff[uiPos] : defaultQuantisationCoefficient;\par
01151 \par
01152   {\cf17 const} int64_t tmpLevel = (int64_t)abs(transformedCoefficient) * quantisationCoefficient;\par
01153 \par
01154   {\cf17 const} TCoeff quantisedCoefficient = (TCoeff((tmpLevel + iAdd ) >> iQBits)) * iSign;\par
01155 \par
01156   {\cf17 const} TCoeff entropyCodingMinimum = -(1 << maxLog2TrDynamicRange);\par
01157   {\cf17 const} TCoeff entropyCodingMaximum =  (1 << maxLog2TrDynamicRange) - 1;\par
01158   coeff = Clip3<TCoeff>( entropyCodingMinimum, entropyCodingMaximum, quantisedCoefficient );\par
01159 \}\par
01160 \par
01161 {\cf18 void} Quant::invTrSkipDeQuantOneSample(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} TCoeff &inSample, Pel &reconSample, {\cf17 const} uint32_t &uiPos, {\cf17 const} QpParam &cQP)\par
01162 \{\par
01163   {\cf17 const} SPS           &sps                    = *tu.cs->sps;\par
01164   {\cf17 const} CompArea      &rect                   = tu.blocks[compID];\par
01165   {\cf17 const} uint32_t           uiWidth                = rect.width;\par
01166   {\cf17 const} uint32_t           uiHeight               = rect.height;\par
01167   {\cf17 const} {\cf18 int}            QP_per                 = cQP.per(tu.mtsIdx[compID] == MTS_SKIP);\par
01168   {\cf17 const} {\cf18 int}            QP_rem                 = cQP.rem(tu.mtsIdx[compID] == MTS_SKIP);\par
01169   {\cf17 const} {\cf18 int}            maxLog2TrDynamicRange  = sps.getMaxLog2TrDynamicRange(toChannelType(compID));\par
01170   {\cf17 const} {\cf18 int}            channelBitDepth        = sps.getBitDepth(toChannelType(compID));\par
01171   {\cf17 const} {\cf18 int}            iTransformShift        = getTransformShift(channelBitDepth, rect.size(), maxLog2TrDynamicRange);\par
01172   {\cf17 const} {\cf18 int}            scalingListType        = getScalingListType(tu.cu->predMode, compID);\par
01173   \par
01174   {\cf17 const} {\cf18 bool}           disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
01175   {\cf17 const} {\cf18 bool}           isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
01176   {\cf17 const} {\cf18 bool}           disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
01177   {\cf17 const} {\cf18 bool}           enableScalingLists = getUseScalingList(uiWidth, uiHeight, {\cf17 true}, isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
01178   CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
01179 \par
01180   {\cf17 const} {\cf18 bool} isTransformSkip = (tu.mtsIdx[compID] == MTS_SKIP);\par
01181   {\cf17 const} {\cf18 int} rightShift = (IQUANT_SHIFT - ((isTransformSkip ? 0 : iTransformShift) + QP_per)) + (enableScalingLists ? LOG2_SCALING_LIST_NEUTRAL_VALUE : 0);\par
01182 \par
01183   {\cf17 const} TCoeff transformMinimum = -(1 << maxLog2TrDynamicRange);\par
01184   {\cf17 const} TCoeff transformMaximum =  (1 << maxLog2TrDynamicRange) - 1;\par
01185 \par
01186   {\cf20 // De-quantisation}\par
01187 \par
01188   TCoeff dequantisedSample;\par
01189 \par
01190   {\cf19 if} (enableScalingLists)\par
01191   \{\par
01192     {\cf17 const} uint32_t             dequantCoefBits = 1 + IQUANT_SHIFT + SCALING_LIST_BITS;\par
01193     {\cf17 const} uint32_t             targetInputBitDepth = std::min<uint32_t>((maxLog2TrDynamicRange + 1), ((({\cf17 sizeof}(Intermediate_Int) * 8) + rightShift) - dequantCoefBits));\par
01194 \par
01195     {\cf17 const} Intermediate_Int inputMinimum = -(1 << (targetInputBitDepth - 1));\par
01196     {\cf17 const} Intermediate_Int inputMaximum =  (1 << (targetInputBitDepth - 1)) - 1;\par
01197 \par
01198     {\cf17 const} uint32_t uiLog2TrWidth  = floorLog2(uiWidth);\par
01199     {\cf17 const} uint32_t uiLog2TrHeight = floorLog2(uiHeight);\par
01200     {\cf18 int} *piDequantCoef        = getDequantCoeff(scalingListType, QP_rem, uiLog2TrWidth, uiLog2TrHeight);\par
01201 \par
01202     {\cf19 if} (rightShift > 0)\par
01203     \{\par
01204       {\cf17 const} Intermediate_Int iAdd = (Intermediate_Int) 1 << (rightShift - 1);\par
01205       {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, inSample));\par
01206       {\cf17 const} Intermediate_Int iCoeffQ = ((Intermediate_Int(clipQCoef) * piDequantCoef[uiPos]) + iAdd) >> rightShift;\par
01207 \par
01208       dequantisedSample = TCoeff(Clip3<Intermediate_Int>(transformMinimum, transformMaximum, iCoeffQ));\par
01209     \}\par
01210     {\cf19 else}\par
01211     \{\par
01212       {\cf17 const} {\cf18 int}              leftShift = -rightShift;\par
01213       {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, inSample));\par
01214       {\cf17 const} Intermediate_Int iCoeffQ = (Intermediate_Int(clipQCoef) * piDequantCoef[uiPos]) << leftShift;\par
01215 \par
01216       dequantisedSample = TCoeff(Clip3<Intermediate_Int>(transformMinimum, transformMaximum, iCoeffQ));\par
01217     \}\par
01218   \}\par
01219   {\cf19 else}\par
01220   \{\par
01221     {\cf17 const} {\cf18 int} scale = g_invQuantScales[0][QP_rem];\par
01222     {\cf17 const} {\cf18 int} scaleBits = (IQUANT_SHIFT + 1);\par
01223 \par
01224     {\cf17 const} uint32_t             targetInputBitDepth = std::min<uint32_t>((maxLog2TrDynamicRange + 1), ((({\cf17 sizeof}(Intermediate_Int) * 8) + rightShift) - scaleBits));\par
01225     {\cf17 const} Intermediate_Int inputMinimum = -(1 << (targetInputBitDepth - 1));\par
01226     {\cf17 const} Intermediate_Int inputMaximum = (1 << (targetInputBitDepth - 1)) - 1;\par
01227 \par
01228     {\cf19 if} (rightShift > 0)\par
01229     \{\par
01230       {\cf17 const} Intermediate_Int iAdd = (Intermediate_Int) 1 << (rightShift - 1);\par
01231       {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, inSample));\par
01232       {\cf17 const} Intermediate_Int iCoeffQ = (Intermediate_Int(clipQCoef) * scale + iAdd) >> rightShift;\par
01233 \par
01234       dequantisedSample = TCoeff(Clip3<Intermediate_Int>(transformMinimum, transformMaximum, iCoeffQ));\par
01235     \}\par
01236     {\cf19 else}\par
01237     \{\par
01238       {\cf17 const} {\cf18 int}              leftShift = -rightShift;\par
01239       {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, inSample));\par
01240       {\cf17 const} Intermediate_Int iCoeffQ = (Intermediate_Int(clipQCoef) * scale) << leftShift;\par
01241 \par
01242       dequantisedSample = TCoeff(Clip3<Intermediate_Int>(transformMinimum, transformMaximum, iCoeffQ));\par
01243     \}\par
01244   \}\par
01245 \par
01246   {\cf20 // Inverse transform-skip}\par
01247   reconSample = Pel(dequantisedSample);\par
01248 \}\par
01249 \par
01250 {\cf18 void} Quant::lambdaAdjustColorTrans({\cf18 bool} forward)\par
01251 \{\par
01252   {\cf19 if} (m_resetStore)\par
01253   \{\par
01254     {\cf19 for} (uint8_t component = 0; component < MAX_NUM_COMPONENT; component++)\par
01255     \{\par
01256       ComponentID compID = (ComponentID)component;\par
01257       {\cf18 int}       delta_QP = DELTA_QP_ACT[compID];\par
01258       {\cf18 double} lamdbaAdjustRate = pow(2.0, delta_QP / 3.0);\par
01259 \par
01260       m_lambdasStore[0][component] = m_lambdas[component];\par
01261       m_lambdasStore[1][component] = m_lambdas[component] * lamdbaAdjustRate;\par
01262     \}\par
01263     m_resetStore = {\cf17 false};\par
01264   \}\par
01265 \par
01266   {\cf19 if} (forward)\par
01267   \{\par
01268     CHECK(m_pairCheck == 1, {\cf22 "lambda has been already adjusted"});\par
01269     m_pairCheck = 1;\par
01270   \}\par
01271   {\cf19 else}\par
01272   \{\par
01273     CHECK(m_pairCheck == 0, {\cf22 "lambda has not been adjusted"});\par
01274     m_pairCheck = 0;\par
01275   \}\par
01276 \par
01277   {\cf19 for} (uint8_t component = 0; component < MAX_NUM_COMPONENT; component++)\par
01278   \{\par
01279     m_lambdas[component] = m_lambdasStore[m_pairCheck][component];\par
01280   \}\par
01281 \}\par
}
