00142 {\cf18 void} invResDPCM( {\cf17 const} TransformUnit &tu, {\cf17 const} ComponentID &compID, CoeffBuf &dstBuf )\par
00143 \{\par
00144   {\cf17 const} CompArea &rect = tu.blocks[compID];\par
00145   {\cf17 const} {\cf18 int}      wdt = rect.width;\par
00146   {\cf17 const} {\cf18 int}      hgt = rect.height;\par
00147   {\cf17 const} CCoeffBuf coeffs = tu.getCoeffs(compID);\par
00148 \par
00149   {\cf17 const} {\cf18 int}      maxLog2TrDynamicRange = tu.cs->sps->getMaxLog2TrDynamicRange(toChannelType(compID));\par
00150   {\cf17 const} TCoeff   inputMinimum   = -(1 << maxLog2TrDynamicRange);\par
00151   {\cf17 const} TCoeff   inputMaximum   =  (1 << maxLog2TrDynamicRange) - 1;\par
00152 \par
00153   {\cf17 const} TCoeff* coef = &coeffs.buf[0];\par
00154   TCoeff* dst = &dstBuf.buf[0];\par
00155 \par
00156   {\cf19 if}( isLuma(compID) ? tu.cu->bdpcmMode == 1 : tu.cu->bdpcmModeChroma == 1)\par
00157   \{\par
00158     {\cf19 for}( {\cf18 int} y = 0; y < hgt; y++ )\par
00159     \{\par
00160       dst[0] = coef[0];\par
00161       {\cf19 for}( {\cf18 int} x = 1; x < wdt; x++ )\par
00162       \{\par
00163         dst[x] = Clip3(inputMinimum, inputMaximum, dst[x - 1] + coef[x]);\par
00164       \}\par
00165       coef += coeffs.stride;\par
00166       dst += dstBuf.stride;\par
00167     \}\par
00168   \}\par
00169   {\cf19 else}\par
00170   \{\par
00171     {\cf19 for}( {\cf18 int} x = 0; x < wdt; x++ )\par
00172     \{\par
00173       dst[x] = coef[x];\par
00174     \}\par
00175     {\cf19 for}( {\cf18 int} y = 0; y < hgt - 1; y++ )\par
00176     \{\par
00177       {\cf19 for}( {\cf18 int} x = 0; x < wdt; x++ )\par
00178       \{\par
00179         dst[dstBuf.stride + x] = Clip3(inputMinimum, inputMaximum, dst[x] + coef[coeffs.stride + x]);\par
00180       \}\par
00181       coef += coeffs.stride;\par
00182       dst += dstBuf.stride;\par
00183     \}\par
00184   \}\par
00185 \}\par
