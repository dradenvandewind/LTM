00187 {\cf18 void} fwdResDPCM( TransformUnit &tu, {\cf17 const} ComponentID &compID )\par
00188 \{\par
00189   {\cf17 const} CompArea &rect = tu.blocks[compID];\par
00190   {\cf17 const} {\cf18 int}      wdt = rect.width;\par
00191   {\cf17 const} {\cf18 int}      hgt = rect.height;\par
00192   CoeffBuf       coeffs = tu.getCoeffs(compID);\par
00193 \par
00194   TCoeff* coef = &coeffs.buf[0];\par
00195 \par
00196   {\cf19 if}( isLuma(compID) ? tu.cu->bdpcmMode == 1 : tu.cu->bdpcmModeChroma == 1)\par
00197   \{\par
00198     {\cf19 for}( {\cf18 int} y = 0; y < hgt; y++ )\par
00199     \{\par
00200       {\cf19 for}( {\cf18 int} x = wdt - 1; x > 0; x-- )\par
00201       \{\par
00202         coef[x] -= coef[x - 1];\par
00203       \}\par
00204       coef += coeffs.stride;\par
00205     \}\par
00206   \}\par
00207   {\cf19 else}\par
00208   \{\par
00209     coef += coeffs.stride * (hgt - 1);\par
00210     {\cf19 for}( {\cf18 int} y = 0; y < hgt - 1; y++ )\par
00211     \{\par
00212       {\cf19 for} ( {\cf18 int} x = 0; x < wdt; x++ )\par
00213       \{\par
00214         coef[x] -= coef[x - coeffs.stride];\par
00215       \}\par
00216       coef -= coeffs.stride;\par
00217     \}\par
00218   \}\par
00219 \}\par
