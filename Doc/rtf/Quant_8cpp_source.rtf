00063 \par
00064 QpParam::QpParam({\cf17 const} {\cf18 int}           qpy,\par
00065                  {\cf17 const} ComponentID   compID,\par
00066                  {\cf17 const} {\cf18 int}           qpBdOffset,\par
00067                  {\cf17 const} {\cf18 int}           internalMinusInputBitDepth,\par
00068                  {\cf17 const} {\cf18 int}           chromaQPOffset,\par
00069                  {\cf17 const} ChromaFormat  chFmt,\par
00070                  {\cf17 const} {\cf18 int}           dqp\par
00071               ,  {\cf17 const} SPS           *sps\par
00072               , {\cf17 const} {\cf18 bool}           applyACTQpoffset\par
00073 )\par
00074 \{\par
00075   {\cf18 int} baseQp;\par
00076   {\cf19 if} (isLuma(compID))\par
00077   \{\par
00078     baseQp = qpy + qpBdOffset;\par
00079   \}\par
00080   {\cf19 else}\par
00081   \{\par
00082     {\cf18 int} qpi = Clip3(-qpBdOffset, MAX_QP, qpy);\par
00083     baseQp = sps->getMappedChromaQpValue(compID, qpi);\par
00084     baseQp = Clip3(-qpBdOffset, MAX_QP, baseQp + chromaQPOffset) + qpBdOffset;\par
00085   \}\par
00086 \par
00087   {\cf19 if} (applyACTQpoffset)\par
00088   \{\par
00089     baseQp += DELTA_QP_ACT[compID];\par
00090   \}\par
00091   baseQp = Clip3( 0, MAX_QP+qpBdOffset, baseQp + dqp );\par
00092 \par
00093   Qps[0] =baseQp;\par
00094   pers[0]=baseQp/6;\par
00095   rems[0]=baseQp%6;\par
00096 \par
00097   {\cf18 int} baseQpTS = baseQp;\par
00098   baseQpTS = std::max(baseQpTS, 4 + 6 * internalMinusInputBitDepth);\par
00099 \par
00100   Qps[1]  = baseQpTS;\par
00101   pers[1] = baseQpTS / 6;\par
00102   rems[1] = baseQpTS % 6;\par
00103 \}\par
00104 \par
00105 QpParam::QpParam({\cf17 const} TransformUnit& tu, {\cf17 const} ComponentID &compIDX, {\cf17 const} {\cf18 int} QP {\cf20 /*= -MAX_INT*/}, {\cf17 const} {\cf18 bool} allowACTQpoffset {\cf20 /*= true*/})\par
00106 \{\par
00107   {\cf18 int} chromaQpOffset = 0;\par
00108   ComponentID compID = MAP_CHROMA(compIDX);\par
00109 \par
00110   {\cf19 if} (isChroma(compID))\par
00111   \{\par
00112     {\cf17 const} {\cf18 bool} useJQP = ( abs(TU::getICTMode(tu)) == 2 );\par
00113 \par
00114     chromaQpOffset += tu.cs->pps->getQpOffset            ( useJQP ? JOINT_CbCr : compID );\par
00115     chromaQpOffset += tu.cu->slice->getSliceChromaQpDelta( useJQP ? JOINT_CbCr : compID );\par
00116 \par
00117     chromaQpOffset += tu.cs->pps->getChromaQpOffsetListEntry( tu.cu->chromaQpAdj ).u.offset[int( useJQP ? JOINT_CbCr : compID ) - 1];\par
00118   \}\par
00119 \par
00120   {\cf18 int} dqp = 0;\par
00121 \par
00122   {\cf17 const} {\cf18 bool} useJQP = isChroma(compID) && (abs(TU::getICTMode(tu)) == 2);\par
00123   {\cf18 bool} applyACTQpoffset = tu.cu->colorTransform && allowACTQpoffset;\par
00124   *{\cf17 this} = QpParam(QP <= -MAX_INT ? tu.cu->qp : QP, useJQP ? JOINT_CbCr : compID, tu.cs->sps->getQpBDOffset(toChannelType(compID)), tu.cs->sps->getInternalMinusInputBitDepth(toChannelType(compID)), chromaQpOffset, tu.chromaFormat, dqp, tu.cs->sps, applyACTQpoffset);\par
00125 \}\par
