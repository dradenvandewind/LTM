00356 {\cf18 void} Quant::dequant({\cf17 const} TransformUnit &tu,\par
00357                              CoeffBuf      &dstCoeff,\par
00358                        {\cf17 const} ComponentID   &compID,\par
00359                        {\cf17 const} QpParam       &cQP)\par
00360 \{\par
00361   {\cf17 const} SPS            *sps                = tu.cs->sps;\par
00362   {\cf17 const} CompArea       &area               = tu.blocks[compID];\par
00363   {\cf17 const} uint32_t            uiWidth            = area.width;\par
00364   {\cf17 const} uint32_t            uiHeight           = area.height;\par
00365         TCoeff   *{\cf17 const} piCoef             = dstCoeff.buf;\par
00366   {\cf17 const} uint32_t            numSamplesInBlock  = uiWidth * uiHeight;\par
00367   {\cf17 const} {\cf18 int}             maxLog2TrDynamicRange = sps->getMaxLog2TrDynamicRange(toChannelType(compID));\par
00368   {\cf17 const} TCoeff          transformMinimum   = -(1 << maxLog2TrDynamicRange);\par
00369   {\cf17 const} TCoeff          transformMaximum   =  (1 << maxLog2TrDynamicRange) - 1;\par
00370   {\cf17 const} {\cf18 bool}            isTransformSkip = (tu.mtsIdx[compID] == MTS_SKIP);\par
00371 \par
00372   {\cf17 const} {\cf18 bool}            disableSMForLFNST = tu.cs->slice->getExplicitScalingListUsed() ? tu.cs->slice->getSPS()->getDisableScalingMatrixForLfnstBlks() : {\cf17 false};\par
00373   {\cf17 const} {\cf18 bool}            isLfnstApplied = tu.cu->lfnstIdx > 0 && (tu.cu->isSepTree() ? true : isLuma(compID));\par
00374   {\cf17 const} {\cf18 bool}            disableSMForACT = tu.cs->slice->getSPS()->getScalingMatrixForAlternativeColourSpaceDisabledFlag() && (tu.cs->slice->getSPS()->getScalingMatrixDesignatedColourSpaceFlag() == tu.cu->colorTransform);\par
00375   {\cf17 const} {\cf18 bool}            enableScalingLists = getUseScalingList(uiWidth, uiHeight, isTransformSkip, isLfnstApplied, disableSMForLFNST, disableSMForACT);\par
00376   {\cf17 const} {\cf18 int}             scalingListType    = getScalingListType(tu.cu->predMode, compID);\par
00377   {\cf17 const} {\cf18 int}             channelBitDepth    = sps->getBitDepth(toChannelType(compID));\par
00378 \par
00379   {\cf17 const} TCoeff          *coef;\par
00380   {\cf19 if} ((tu.cu->bdpcmMode && isLuma(compID)) || ( tu.cu->bdpcmModeChroma && isChroma(compID) ))\par
00381   \{\par
00382     invResDPCM( tu, compID, dstCoeff );\par
00383     coef = piCoef;\par
00384   \}\par
00385   {\cf19 else}\par
00386   \{\par
00387     coef = tu.getCoeffs(compID).buf;\par
00388   \}\par
00389   {\cf17 const} TCoeff          *{\cf17 const} piQCoef = coef;\par
00390   CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
00391   CHECK(uiWidth > m_uiMaxTrSize, {\cf22 "Unsupported transformation size"});\par
00392 \par
00393   {\cf20 // Represents scaling through forward transform}\par
00394   {\cf17 const} {\cf18 bool} bClipTransformShiftTo0 = tu.mtsIdx[compID] != MTS_SKIP && sps->getSpsRangeExtension().getExtendedPrecisionProcessingFlag();\par
00395   {\cf17 const} {\cf18 int}  originalTransformShift = getTransformShift(channelBitDepth, area.size(), maxLog2TrDynamicRange);\par
00396   {\cf17 const} {\cf18 bool} needSqrtAdjustment     = TU::needsBlockSizeTrafoScale( tu, compID );\par
00397   {\cf17 const} {\cf18 int}  iTransformShift        = (bClipTransformShiftTo0 ? std::max<int>(0, originalTransformShift) : originalTransformShift) + (needSqrtAdjustment?-1:0);\par
00398 \par
00399   {\cf17 const} {\cf18 int} QP_per = cQP.per(isTransformSkip);\par
00400   {\cf17 const} {\cf18 int} QP_rem = cQP.rem(isTransformSkip);\par
00401 \par
00402   {\cf17 const} {\cf18 int}  rightShift = (IQUANT_SHIFT - ((isTransformSkip ? 0 : iTransformShift) + QP_per)) + (enableScalingLists ? LOG2_SCALING_LIST_NEUTRAL_VALUE : 0);\par
00403 \par
00404   {\cf19 if}(enableScalingLists)\par
00405   \{\par
00406     {\cf20 //from the dequantization equation:}\par
00407     {\cf20 //iCoeffQ                         = ((Intermediate_Int(clipQCoef) * piDequantCoef[deQuantIdx]) + iAdd ) >> rightShift}\par
00408     {\cf20 //(sizeof(Intermediate_Int) * 8)  =              inputBitDepth    +    dequantCoefBits                   - rightShift}\par
00409     {\cf17 const} uint32_t             dequantCoefBits     = 1 + IQUANT_SHIFT + SCALING_LIST_BITS;\par
00410     {\cf17 const} uint32_t             targetInputBitDepth = std::min<uint32_t>((maxLog2TrDynamicRange + 1), ((({\cf17 sizeof}(Intermediate_Int) * 8) + rightShift) - dequantCoefBits));\par
00411 \par
00412     {\cf17 const} Intermediate_Int inputMinimum        = -(1 << (targetInputBitDepth - 1));\par
00413     {\cf17 const} Intermediate_Int inputMaximum        =  (1 << (targetInputBitDepth - 1)) - 1;\par
00414 \par
00415     {\cf17 const} uint32_t uiLog2TrWidth  = floorLog2(uiWidth);\par
00416     {\cf17 const} uint32_t uiLog2TrHeight = floorLog2(uiHeight);\par
00417     {\cf18 int} *piDequantCoef        = getDequantCoeff(scalingListType, QP_rem, uiLog2TrWidth, uiLog2TrHeight);\par
00418 \par
00419     {\cf19 if}(rightShift > 0)\par
00420     \{\par
00421       {\cf17 const} Intermediate_Int iAdd = (Intermediate_Int) 1 << (rightShift - 1);\par
00422 \par
00423       {\cf19 for}( {\cf18 int} n = 0; n < numSamplesInBlock; n++ )\par
00424       \{\par
00425         {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, piQCoef[n]));\par
00426         {\cf17 const} Intermediate_Int iCoeffQ   = ((Intermediate_Int(clipQCoef) * piDequantCoef[n]) + iAdd ) >> rightShift;\par
00427 \par
00428         piCoef[n] = TCoeff(Clip3<Intermediate_Int>(transformMinimum,transformMaximum,iCoeffQ));\par
00429       \}\par
00430     \}\par
00431     {\cf19 else}\par
00432     \{\par
00433       {\cf17 const} {\cf18 int} leftShift = -rightShift;\par
00434 \par
00435       {\cf19 for}( {\cf18 int} n = 0; n < numSamplesInBlock; n++ )\par
00436       \{\par
00437         {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, piQCoef[n]));\par
00438         {\cf17 const} Intermediate_Int iCoeffQ   = (Intermediate_Int(clipQCoef) * piDequantCoef[n]) << leftShift;\par
00439 \par
00440         piCoef[n] = TCoeff(Clip3<Intermediate_Int>(transformMinimum,transformMaximum,iCoeffQ));\par
00441       \}\par
00442     \}\par
00443   \}\par
00444   {\cf19 else}\par
00445   \{\par
00446     {\cf17 const} {\cf18 int} scale     = g_invQuantScales[needSqrtAdjustment?1:0][QP_rem];\par
00447     {\cf17 const} {\cf18 int} scaleBits = ( IQUANT_SHIFT + 1 );\par
00448 \par
00449     {\cf20 //from the dequantisation equation:}\par
00450     {\cf20 //iCoeffQ                         = Intermediate_Int((int64_t(clipQCoef) * scale + iAdd) >> rightShift);}\par
00451     {\cf20 //(sizeof(Intermediate_Int) * 8)  =                    inputBitDepth   + scaleBits      - rightShift}\par
00452     {\cf17 const} uint32_t             targetInputBitDepth = std::min<uint32_t>((maxLog2TrDynamicRange + 1), ((({\cf17 sizeof}(Intermediate_Int) * 8) + rightShift) - scaleBits));\par
00453     {\cf17 const} Intermediate_Int inputMinimum        = -(1 << (targetInputBitDepth - 1));\par
00454     {\cf17 const} Intermediate_Int inputMaximum        =  (1 << (targetInputBitDepth - 1)) - 1;\par
00455 \par
00456     {\cf19 if} (rightShift > 0)\par
00457     \{\par
00458       {\cf17 const} Intermediate_Int iAdd = (Intermediate_Int) 1 << (rightShift - 1);\par
00459 \par
00460       {\cf19 for}( {\cf18 int} n = 0; n < numSamplesInBlock; n++ )\par
00461       \{\par
00462         {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, piQCoef[n]));\par
00463         {\cf17 const} Intermediate_Int iCoeffQ   = (Intermediate_Int(clipQCoef) * scale + iAdd) >> rightShift;\par
00464 \par
00465         piCoef[n] = TCoeff(Clip3<Intermediate_Int>(transformMinimum,transformMaximum,iCoeffQ));\par
00466       \}\par
00467     \}\par
00468     {\cf19 else}\par
00469     \{\par
00470       {\cf17 const} {\cf18 int} leftShift = -rightShift;\par
00471 \par
00472       {\cf19 for}( {\cf18 int} n = 0; n < numSamplesInBlock; n++ )\par
00473       \{\par
00474         {\cf17 const} TCoeff           clipQCoef = TCoeff(Clip3<Intermediate_Int>(inputMinimum, inputMaximum, piQCoef[n]));\par
00475         {\cf17 const} Intermediate_Int iCoeffQ   = (Intermediate_Int(clipQCoef) * scale) << leftShift;\par
00476 \par
00477         piCoef[n] = TCoeff(Clip3<Intermediate_Int>(transformMinimum,transformMaximum,iCoeffQ));\par
00478       \}\par
00479     \}\par
00480   \}\par
00481 \}\par
