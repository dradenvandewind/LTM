00848 {\cf18 void} AdaptiveLoopFilter::deriveClassificationBlk(AlfClassifier **classifier, {\cf18 int} **laplacian[NUM_DIRECTIONS],\par
00849                                                  {\cf17 const} CPelBuf &srcLuma, {\cf17 const} Area &blkDst, {\cf17 const} Area &blk,\par
00850                                                  {\cf17 const} {\cf18 int} shift, {\cf17 const} {\cf18 int} vbCTUHeight, {\cf18 int} vbPos)\par
00851 \{\par
00852   CHECK((vbCTUHeight & (vbCTUHeight - 1)) != 0, {\cf22 "vbCTUHeight must be a power of 2"});\par
00853 \par
00854   {\cf17 static} {\cf17 const} {\cf18 int} th[16] = \{ 0, 1, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 3, 3, 4 \};\par
00855   {\cf17 const} {\cf18 int} stride = srcLuma.stride;\par
00856   {\cf17 const} Pel* src = srcLuma.buf;\par
00857   {\cf17 const} {\cf18 int} maxActivity = 15;\par
00858 \par
00859   {\cf18 int} fl = 2;\par
00860   {\cf18 int} flP1 = fl + 1;\par
00861   {\cf18 int} fl2 = 2 * fl;\par
00862 \par
00863   {\cf18 int} mainDirection, secondaryDirection, dirTempHV, dirTempD;\par
00864 \par
00865   {\cf18 int} pixY;\par
00866   {\cf18 int} height = blk.height + fl2;\par
00867   {\cf18 int} width = blk.width + fl2;\par
00868   {\cf18 int} posX = blk.pos().x;\par
00869   {\cf18 int} posY = blk.pos().y;\par
00870   {\cf18 int} startHeight = posY - flP1;\par
00871 \par
00872   {\cf19 for}( {\cf18 int} i = 0; i < height; i += 2 )\par
00873   \{\par
00874     {\cf18 int} yoffset = ( i + 1 + startHeight ) * stride - flP1;\par
00875     {\cf17 const} Pel *src0 = &src[yoffset - stride];\par
00876     {\cf17 const} Pel *src1 = &src[yoffset];\par
00877     {\cf17 const} Pel *src2 = &src[yoffset + stride];\par
00878     {\cf17 const} Pel *src3 = &src[yoffset + stride * 2];\par
00879 \par
00880     {\cf17 const} {\cf18 int} y = blkDst.pos().y - 2 + i;\par
00881     {\cf19 if} (y > 0 && (y & (vbCTUHeight - 1)) == vbPos - 2)\par
00882     \{\par
00883       src3 = &src[yoffset + stride];\par
00884     \}\par
00885     {\cf19 else} {\cf19 if} (y > 0 && (y & (vbCTUHeight - 1)) == vbPos)\par
00886     \{\par
00887       src0 = &src[yoffset];\par
00888     \}\par
00889     {\cf18 int}* pYver = laplacian[VER][i];\par
00890     {\cf18 int}* pYhor = laplacian[HOR][i];\par
00891     {\cf18 int}* pYdig0 = laplacian[DIAG0][i];\par
00892     {\cf18 int}* pYdig1 = laplacian[DIAG1][i];\par
00893 \par
00894     {\cf19 for}( {\cf18 int} j = 0; j < width; j += 2 )\par
00895     \{\par
00896       pixY = j + 1 + posX;\par
00897       {\cf17 const} Pel *pY = src1 + pixY;\par
00898       {\cf17 const} Pel* pYdown = src0 + pixY;\par
00899       {\cf17 const} Pel* pYup = src2 + pixY;\par
00900       {\cf17 const} Pel* pYup2 = src3 + pixY;\par
00901 \par
00902       {\cf17 const} Pel y0 = pY[0] << 1;\par
00903       {\cf17 const} Pel yup1 = pYup[1] << 1;\par
00904 \par
00905       pYver[j] = abs( y0 - pYdown[0] - pYup[0] ) + abs( yup1 - pY[1] - pYup2[1] );\par
00906       pYhor[j] = abs( y0 - pY[1] - pY[-1] ) + abs( yup1 - pYup[2] - pYup[0] );\par
00907       pYdig0[j] = abs( y0 - pYdown[-1] - pYup[1] ) + abs( yup1 - pY[0] - pYup2[2] );\par
00908       pYdig1[j] = abs( y0 - pYup[-1] - pYdown[1] ) + abs( yup1 - pYup2[0] - pY[2] );\par
00909 \par
00910       {\cf19 if}( j > 4 && ( j - 6 ) % 4 == 0 )\par
00911       \{\par
00912         {\cf18 int} jM6 = j - 6;\par
00913         {\cf18 int} jM4 = j - 4;\par
00914         {\cf18 int} jM2 = j - 2;\par
00915         pYver[jM6] += pYver[jM4] + pYver[jM2] + pYver[j];\par
00916         pYhor[jM6] += pYhor[jM4] + pYhor[jM2] + pYhor[j];\par
00917         pYdig0[jM6] += pYdig0[jM4] + pYdig0[jM2] + pYdig0[j];\par
00918         pYdig1[jM6] += pYdig1[jM4] + pYdig1[jM2] + pYdig1[j];\par
00919       \}\par
00920     \}\par
00921   \}\par
00922 \par
00923   {\cf20 // classification block size}\par
00924   {\cf17 const} {\cf18 int} clsSizeY = 4;\par
00925   {\cf17 const} {\cf18 int} clsSizeX = 4;\par
00926 \par
00927   {\cf19 for}( {\cf18 int} i = 0; i < blk.height; i += clsSizeY )\par
00928   \{\par
00929     {\cf18 int}* pYver = laplacian[VER][i];\par
00930     {\cf18 int}* pYver2 = laplacian[VER][i + 2];\par
00931     {\cf18 int}* pYver4 = laplacian[VER][i + 4];\par
00932     {\cf18 int}* pYver6 = laplacian[VER][i + 6];\par
00933 \par
00934     {\cf18 int}* pYhor = laplacian[HOR][i];\par
00935     {\cf18 int}* pYhor2 = laplacian[HOR][i + 2];\par
00936     {\cf18 int}* pYhor4 = laplacian[HOR][i + 4];\par
00937     {\cf18 int}* pYhor6 = laplacian[HOR][i + 6];\par
00938 \par
00939     {\cf18 int}* pYdig0 = laplacian[DIAG0][i];\par
00940     {\cf18 int}* pYdig02 = laplacian[DIAG0][i + 2];\par
00941     {\cf18 int}* pYdig04 = laplacian[DIAG0][i + 4];\par
00942     {\cf18 int}* pYdig06 = laplacian[DIAG0][i + 6];\par
00943 \par
00944     {\cf18 int}* pYdig1 = laplacian[DIAG1][i];\par
00945     {\cf18 int}* pYdig12 = laplacian[DIAG1][i + 2];\par
00946     {\cf18 int}* pYdig14 = laplacian[DIAG1][i + 4];\par
00947     {\cf18 int}* pYdig16 = laplacian[DIAG1][i + 6];\par
00948 \par
00949     {\cf19 for}( {\cf18 int} j = 0; j < blk.width; j += clsSizeX )\par
00950     \{\par
00951       {\cf18 int} sumV = 0; {\cf18 int} sumH = 0; {\cf18 int} sumD0 = 0; {\cf18 int} sumD1 = 0;\par
00952       {\cf19 if} (((i + blkDst.pos().y) % vbCTUHeight) == (vbPos - 4))\par
00953       \{\par
00954         sumV = pYver[j] + pYver2[j] + pYver4[j];\par
00955         sumH = pYhor[j] + pYhor2[j] + pYhor4[j];\par
00956         sumD0 = pYdig0[j] + pYdig02[j] + pYdig04[j];\par
00957         sumD1 = pYdig1[j] + pYdig12[j] + pYdig14[j];\par
00958       \}\par
00959       {\cf19 else} {\cf19 if} (((i + blkDst.pos().y) % vbCTUHeight) == vbPos)\par
00960       \{\par
00961         sumV = pYver2[j] + pYver4[j] + pYver6[j];\par
00962         sumH = pYhor2[j] + pYhor4[j] + pYhor6[j];\par
00963         sumD0 = pYdig02[j] + pYdig04[j] + pYdig06[j];\par
00964         sumD1 = pYdig12[j] + pYdig14[j] + pYdig16[j];\par
00965       \}\par
00966       {\cf19 else}\par
00967       \{\par
00968         sumV = pYver[j] + pYver2[j] + pYver4[j] + pYver6[j];\par
00969         sumH = pYhor[j] + pYhor2[j] + pYhor4[j] + pYhor6[j];\par
00970         sumD0 = pYdig0[j] + pYdig02[j] + pYdig04[j] + pYdig06[j];\par
00971         sumD1 = pYdig1[j] + pYdig12[j] + pYdig14[j] + pYdig16[j];\par
00972       \}\par
00973 \par
00974       {\cf18 int} tempAct = sumV + sumH;\par
00975       {\cf18 int} activity = 0;\par
00976 \par
00977       {\cf17 const} {\cf18 int} y = (i + blkDst.pos().y) & (vbCTUHeight - 1);\par
00978       {\cf19 if} (y == vbPos - 4 || y == vbPos)\par
00979       \{\par
00980         activity = (Pel)Clip3<int>(0, maxActivity, (tempAct * 96) >> shift);\par
00981       \}\par
00982       {\cf19 else}\par
00983       \{\par
00984         activity = (Pel)Clip3<int>(0, maxActivity, (tempAct * 64) >> shift);\par
00985       \}\par
00986       {\cf18 int} classIdx = th[activity];\par
00987 \par
00988       {\cf18 int} hv1, hv0, d1, d0, hvd1, hvd0;\par
00989 \par
00990       {\cf19 if}( sumV > sumH )\par
00991       \{\par
00992         hv1 = sumV;\par
00993         hv0 = sumH;\par
00994         dirTempHV = 1;\par
00995       \}\par
00996       {\cf19 else}\par
00997       \{\par
00998         hv1 = sumH;\par
00999         hv0 = sumV;\par
01000         dirTempHV = 3;\par
01001       \}\par
01002       {\cf19 if}( sumD0 > sumD1 )\par
01003       \{\par
01004         d1 = sumD0;\par
01005         d0 = sumD1;\par
01006         dirTempD = 0;\par
01007       \}\par
01008       {\cf19 else}\par
01009       \{\par
01010         d1 = sumD1;\par
01011         d0 = sumD0;\par
01012         dirTempD = 2;\par
01013       \}\par
01014       {\cf19 if}( (uint32_t)d1 * (uint32_t)hv0 > (uint32_t)hv1 * (uint32_t)d0 )\par
01015       \{\par
01016         hvd1 = d1;\par
01017         hvd0 = d0;\par
01018         mainDirection = dirTempD;\par
01019         secondaryDirection = dirTempHV;\par
01020       \}\par
01021       {\cf19 else}\par
01022       \{\par
01023         hvd1 = hv1;\par
01024         hvd0 = hv0;\par
01025         mainDirection = dirTempHV;\par
01026         secondaryDirection = dirTempD;\par
01027       \}\par
01028 \par
01029       {\cf18 int} directionStrength = 0;\par
01030       {\cf19 if}( hvd1 > 2 * hvd0 )\par
01031       \{\par
01032         directionStrength = 1;\par
01033       \}\par
01034       {\cf19 if}( hvd1 * 2 > 9 * hvd0 )\par
01035       \{\par
01036         directionStrength = 2;\par
01037       \}\par
01038 \par
01039       {\cf19 if}( directionStrength )\par
01040       \{\par
01041         classIdx += ( ( ( mainDirection & 0x1 ) << 1 ) + directionStrength ) * 5;\par
01042       \}\par
01043 \par
01044       {\cf17 static} {\cf17 const} {\cf18 int} transposeTable[8] = \{ 0, 1, 0, 2, 2, 3, 1, 3 \};\par
01045       {\cf18 int} transposeIdx = transposeTable[mainDirection * 2 + ( secondaryDirection >> 1 )];\par
01046 \par
01047       {\cf18 int} yOffset = i + blkDst.pos().y;\par
01048       {\cf18 int} xOffset = j + blkDst.pos().x;\par
01049 \par
01050       AlfClassifier *cl0 = classifier[yOffset] + xOffset;\par
01051       AlfClassifier *cl1 = classifier[yOffset + 1] + xOffset;\par
01052       AlfClassifier *cl2 = classifier[yOffset + 2] + xOffset;\par
01053       AlfClassifier *cl3 = classifier[yOffset + 3] + xOffset;\par
01054       cl0[0] = cl0[1] = cl0[2] = cl0[3] = cl1[0] = cl1[1] = cl1[2] = cl1[3] = cl2[0] = cl2[1] = cl2[2] = cl2[3] = cl3[0] = cl3[1] = cl3[2] = cl3[3] = AlfClassifier( classIdx, transposeIdx );\par
01055     \}\par
01056   \}\par
01057 \}\par
