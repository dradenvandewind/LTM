01059 {\cf17 template}<AlfFilterType filtType>\par
01060 {\cf18 void} AdaptiveLoopFilter::filterBlk(AlfClassifier **classifier, {\cf17 const} PelUnitBuf &recDst, {\cf17 const} CPelUnitBuf &recSrc,\par
01061                                    {\cf17 const} Area &blkDst, {\cf17 const} Area &blk, {\cf17 const} ComponentID compId,\par
01062                                    {\cf17 const} {\cf18 short} *filterSet, {\cf17 const} Pel *fClipSet, {\cf17 const} ClpRng &clpRng,\par
01063                                    CodingStructure &cs, {\cf17 const} {\cf18 int} vbCTUHeight, {\cf18 int} vbPos)\par
01064 \{\par
01065   CHECK((vbCTUHeight & (vbCTUHeight - 1)) != 0, {\cf22 "vbCTUHeight must be a power of 2"});\par
01066 \par
01067   {\cf17 const} {\cf18 bool} bChroma = isChroma( compId );\par
01068   {\cf19 if}( bChroma )\par
01069   \{\par
01070     CHECK( filtType != 0, {\cf22 "Chroma needs to have filtType == 0"} );\par
01071   \}\par
01072 \par
01073   {\cf17 const} CPelBuf srcLuma = recSrc.get( compId );\par
01074   PelBuf dstLuma = recDst.get( compId );\par
01075 \par
01076   {\cf17 const} {\cf18 int} srcStride = srcLuma.stride;\par
01077   {\cf17 const} {\cf18 int} dstStride = dstLuma.stride;\par
01078 \par
01079   {\cf17 const} {\cf18 int} startHeight = blk.y;\par
01080   {\cf17 const} {\cf18 int} endHeight = blk.y + blk.height;\par
01081   {\cf17 const} {\cf18 int} startWidth = blk.x;\par
01082   {\cf17 const} {\cf18 int} endWidth = blk.x + blk.width;\par
01083 \par
01084   {\cf17 const} Pel* src = srcLuma.buf;\par
01085   Pel* dst = dstLuma.buf + blkDst.y * dstStride;\par
01086 \par
01087   {\cf17 const} Pel *pImgYPad0, *pImgYPad1, *pImgYPad2, *pImgYPad3, *pImgYPad4, *pImgYPad5, *pImgYPad6;\par
01088   {\cf17 const} Pel *pImg0, *pImg1, *pImg2, *pImg3, *pImg4, *pImg5, *pImg6;\par
01089 \par
01090   {\cf17 const} {\cf18 short} *coef = filterSet;\par
01091   {\cf17 const} Pel *clip = fClipSet;\par
01092   {\cf17 const} {\cf18 int} shift = m_NUM_BITS - 1;\par
01093 \par
01094   {\cf17 const} {\cf18 int} offset = 1 << ( shift - 1 );\par
01095 \par
01096   {\cf18 int} transposeIdx = 0;\par
01097   {\cf17 const} {\cf18 int} clsSizeY = 4;\par
01098   {\cf17 const} {\cf18 int} clsSizeX = 4;\par
01099 \par
01100   CHECK( startHeight % clsSizeY, {\cf22 "Wrong startHeight in filtering"} );\par
01101   CHECK( startWidth % clsSizeX, {\cf22 "Wrong startWidth in filtering"} );\par
01102   CHECK( ( endHeight - startHeight ) % clsSizeY, {\cf22 "Wrong endHeight in filtering"} );\par
01103   CHECK( ( endWidth - startWidth ) % clsSizeX, {\cf22 "Wrong endWidth in filtering"} );\par
01104 \par
01105   AlfClassifier *pClass = {\cf17 nullptr};\par
01106 \par
01107   {\cf18 int} dstStride2 = dstStride * clsSizeY;\par
01108   {\cf18 int} srcStride2 = srcStride * clsSizeY;\par
01109 \par
01110   std::array<int, MAX_NUM_ALF_LUMA_COEFF> filterCoeff;\par
01111   std::array<int, MAX_NUM_ALF_LUMA_COEFF> filterClipp;\par
01112 \par
01113   pImgYPad0 = src + startHeight * srcStride + startWidth;\par
01114   pImgYPad1 = pImgYPad0 + srcStride;\par
01115   pImgYPad2 = pImgYPad0 - srcStride;\par
01116   pImgYPad3 = pImgYPad1 + srcStride;\par
01117   pImgYPad4 = pImgYPad2 - srcStride;\par
01118   pImgYPad5 = pImgYPad3 + srcStride;\par
01119   pImgYPad6 = pImgYPad4 - srcStride;\par
01120 \par
01121   Pel* pRec0 = dst + blkDst.x;\par
01122   Pel* pRec1 = pRec0 + dstStride;\par
01123 \par
01124   {\cf19 for}( {\cf18 int} i = 0; i < endHeight - startHeight; i += clsSizeY )\par
01125   \{\par
01126     {\cf19 if}( !bChroma )\par
01127     \{\par
01128       pClass = classifier[blkDst.y + i] + blkDst.x;\par
01129     \}\par
01130 \par
01131     {\cf19 for}( {\cf18 int} j = 0; j < endWidth - startWidth; j += clsSizeX )\par
01132     \{\par
01133       {\cf19 if}( !bChroma )\par
01134       \{\par
01135         AlfClassifier& cl = pClass[j];\par
01136         transposeIdx = cl.transposeIdx;\par
01137         coef = filterSet + cl.classIdx * MAX_NUM_ALF_LUMA_COEFF;\par
01138         clip = fClipSet + cl.classIdx * MAX_NUM_ALF_LUMA_COEFF;\par
01139       \}\par
01140 \par
01141       {\cf19 if}( filtType == ALF_FILTER_7 )\par
01142       \{\par
01143         {\cf19 if}( transposeIdx == 1 )\par
01144         \{\par
01145           filterCoeff = \{ coef[9], coef[4], coef[10], coef[8], coef[1], coef[5], coef[11], coef[7], coef[3], coef[0], coef[2], coef[6], coef[12] \};\par
01146           filterClipp = \{ clip[9], clip[4], clip[10], clip[8], clip[1], clip[5], clip[11], clip[7], clip[3], clip[0], clip[2], clip[6], clip[12] \};\par
01147         \}\par
01148         {\cf19 else} {\cf19 if}( transposeIdx == 2 )\par
01149         \{\par
01150           filterCoeff = \{ coef[0], coef[3], coef[2], coef[1], coef[8], coef[7], coef[6], coef[5], coef[4], coef[9], coef[10], coef[11], coef[12] \};\par
01151           filterClipp = \{ clip[0], clip[3], clip[2], clip[1], clip[8], clip[7], clip[6], clip[5], clip[4], clip[9], clip[10], clip[11], clip[12] \};\par
01152         \}\par
01153         {\cf19 else} {\cf19 if}( transposeIdx == 3 )\par
01154         \{\par
01155           filterCoeff = \{ coef[9], coef[8], coef[10], coef[4], coef[3], coef[7], coef[11], coef[5], coef[1], coef[0], coef[2], coef[6], coef[12] \};\par
01156           filterClipp = \{ clip[9], clip[8], clip[10], clip[4], clip[3], clip[7], clip[11], clip[5], clip[1], clip[0], clip[2], clip[6], clip[12] \};\par
01157         \}\par
01158         {\cf19 else}\par
01159         \{\par
01160           filterCoeff = \{ coef[0], coef[1], coef[2], coef[3], coef[4], coef[5], coef[6], coef[7], coef[8], coef[9], coef[10], coef[11], coef[12] \};\par
01161           filterClipp = \{ clip[0], clip[1], clip[2], clip[3], clip[4], clip[5], clip[6], clip[7], clip[8], clip[9], clip[10], clip[11], clip[12] \};\par
01162         \}\par
01163       \}\par
01164       {\cf19 else}\par
01165       \{\par
01166         {\cf19 if}( transposeIdx == 1 )\par
01167         \{\par
01168           filterCoeff = \{ coef[4], coef[1], coef[5], coef[3], coef[0], coef[2], coef[6] \};\par
01169           filterClipp = \{ clip[4], clip[1], clip[5], clip[3], clip[0], clip[2], clip[6] \};\par
01170         \}\par
01171         {\cf19 else} {\cf19 if}( transposeIdx == 2 )\par
01172         \{\par
01173           filterCoeff = \{ coef[0], coef[3], coef[2], coef[1], coef[4], coef[5], coef[6] \};\par
01174           filterClipp = \{ clip[0], clip[3], clip[2], clip[1], clip[4], clip[5], clip[6] \};\par
01175         \}\par
01176         {\cf19 else} {\cf19 if}( transposeIdx == 3 )\par
01177         \{\par
01178           filterCoeff = \{ coef[4], coef[3], coef[5], coef[1], coef[0], coef[2], coef[6] \};\par
01179           filterClipp = \{ clip[4], clip[3], clip[5], clip[1], clip[0], clip[2], clip[6] \};\par
01180         \}\par
01181         {\cf19 else}\par
01182         \{\par
01183           filterCoeff = \{ coef[0], coef[1], coef[2], coef[3], coef[4], coef[5], coef[6] \};\par
01184           filterClipp = \{ clip[0], clip[1], clip[2], clip[3], clip[4], clip[5], clip[6] \};\par
01185         \}\par
01186       \}\par
01187 \par
01188       {\cf19 for}( {\cf18 int} ii = 0; ii < clsSizeY; ii++ )\par
01189       \{\par
01190         pImg0 = pImgYPad0 + j + ii * srcStride;\par
01191         pImg1 = pImgYPad1 + j + ii * srcStride;\par
01192         pImg2 = pImgYPad2 + j + ii * srcStride;\par
01193         pImg3 = pImgYPad3 + j + ii * srcStride;\par
01194         pImg4 = pImgYPad4 + j + ii * srcStride;\par
01195         pImg5 = pImgYPad5 + j + ii * srcStride;\par
01196         pImg6 = pImgYPad6 + j + ii * srcStride;\par
01197 \par
01198         pRec1 = pRec0 + j + ii * dstStride;\par
01199 \par
01200         {\cf17 const} {\cf18 int} yVb = (blkDst.y + i + ii) & (vbCTUHeight - 1);\par
01201         {\cf19 if} (yVb < vbPos && (yVb >= vbPos - (bChroma ? 2 : 4)))   {\cf20 // above}\par
01202         \{\par
01203           pImg1 = (yVb == vbPos - 1) ? pImg0 : pImg1;\par
01204           pImg3 = (yVb >= vbPos - 2) ? pImg1 : pImg3;\par
01205           pImg5 = (yVb >= vbPos - 3) ? pImg3 : pImg5;\par
01206 \par
01207           pImg2 = (yVb == vbPos - 1) ? pImg0 : pImg2;\par
01208           pImg4 = (yVb >= vbPos - 2) ? pImg2 : pImg4;\par
01209           pImg6 = (yVb >= vbPos - 3) ? pImg4 : pImg6;\par
01210         \}\par
01211         {\cf19 else} {\cf19 if} (yVb >= vbPos && (yVb <= vbPos + (bChroma ? 1 : 3)))   {\cf20 // bottom}\par
01212         \{\par
01213           pImg2 = (yVb == vbPos) ? pImg0 : pImg2;\par
01214           pImg4 = (yVb <= vbPos + 1) ? pImg2 : pImg4;\par
01215           pImg6 = (yVb <= vbPos + 2) ? pImg4 : pImg6;\par
01216 \par
01217           pImg1 = (yVb == vbPos) ? pImg0 : pImg1;\par
01218           pImg3 = (yVb <= vbPos + 1) ? pImg1 : pImg3;\par
01219           pImg5 = (yVb <= vbPos + 2) ? pImg3 : pImg5;\par
01220         \}\par
01221         {\cf18 bool} isNearVBabove = yVb < vbPos && (yVb >= vbPos - 1);\par
01222         {\cf18 bool} isNearVBbelow = yVb >= vbPos && (yVb <= vbPos);\par
01223         {\cf19 for}( {\cf18 int} jj = 0; jj < clsSizeX; jj++ )\par
01224         \{\par
01225           int32_t   sum  = 0;\par
01226           {\cf17 const} Pel curr = pImg0[+0];\par
01227           {\cf19 if}( filtType == ALF_FILTER_7 )\par
01228           \{\par
01229             sum += filterCoeff[0] * ( clipALF(filterClipp[0], curr, pImg5[+0], pImg6[+0]) );\par
01230 \par
01231             sum += filterCoeff[1] * ( clipALF(filterClipp[1], curr, pImg3[+1], pImg4[-1]) );\par
01232             sum += filterCoeff[2] * ( clipALF(filterClipp[2], curr, pImg3[+0], pImg4[+0]) );\par
01233             sum += filterCoeff[3] * ( clipALF(filterClipp[3], curr, pImg3[-1], pImg4[+1]) );\par
01234 \par
01235             sum += filterCoeff[4] * ( clipALF(filterClipp[4], curr, pImg1[+2], pImg2[-2]) );\par
01236             sum += filterCoeff[5] * ( clipALF(filterClipp[5], curr, pImg1[+1], pImg2[-1]) );\par
01237             sum += filterCoeff[6] * ( clipALF(filterClipp[6], curr, pImg1[+0], pImg2[+0]) );\par
01238             sum += filterCoeff[7] * ( clipALF(filterClipp[7], curr, pImg1[-1], pImg2[+1]) );\par
01239             sum += filterCoeff[8] * ( clipALF(filterClipp[8], curr, pImg1[-2], pImg2[+2]) );\par
01240 \par
01241             sum += filterCoeff[9] * ( clipALF(filterClipp[9], curr, pImg0[+3], pImg0[-3]) );\par
01242             sum += filterCoeff[10] * ( clipALF(filterClipp[10], curr, pImg0[+2], pImg0[-2]) );\par
01243             sum += filterCoeff[11] * ( clipALF(filterClipp[11], curr, pImg0[+1], pImg0[-1]) );\par
01244           \}\par
01245           {\cf19 else}\par
01246           \{\par
01247             sum += filterCoeff[0] * ( clipALF(filterClipp[0], curr, pImg3[+0], pImg4[+0]) );\par
01248 \par
01249             sum += filterCoeff[1] * ( clipALF(filterClipp[1], curr, pImg1[+1], pImg2[-1]) );\par
01250             sum += filterCoeff[2] * ( clipALF(filterClipp[2], curr, pImg1[+0], pImg2[+0]) );\par
01251             sum += filterCoeff[3] * ( clipALF(filterClipp[3], curr, pImg1[-1], pImg2[+1]) );\par
01252 \par
01253             sum += filterCoeff[4] * ( clipALF(filterClipp[4], curr, pImg0[+2], pImg0[-2]) );\par
01254             sum += filterCoeff[5] * ( clipALF(filterClipp[5], curr, pImg0[+1], pImg0[-1]) );\par
01255           \}\par
01256           {\cf19 if} (!(isNearVBabove || isNearVBbelow))\par
01257           \{\par
01258             sum = (sum + offset) >> shift;\par
01259           \}\par
01260           {\cf19 else}\par
01261           \{\par
01262             sum = (sum + (1 << ((shift + 3) - 1))) >> (shift + 3);\par
01263           \}\par
01264           sum += curr;\par
01265           pRec1[jj] = ClipPel( sum, clpRng );\par
01266 \par
01267           pImg0++;\par
01268           pImg1++;\par
01269           pImg2++;\par
01270           pImg3++;\par
01271           pImg4++;\par
01272           pImg5++;\par
01273           pImg6++;\par
01274         \}\par
01275       \}\par
01276     \}\par
01277 \par
01278     pRec0 += dstStride2;\par
01279     pRec1 += dstStride2;\par
01280 \par
01281     pImgYPad0 += srcStride2;\par
01282     pImgYPad1 += srcStride2;\par
01283     pImgYPad2 += srcStride2;\par
01284     pImgYPad3 += srcStride2;\par
01285     pImgYPad4 += srcStride2;\par
01286     pImgYPad5 += srcStride2;\par
01287     pImgYPad6 += srcStride2;\par
01288   \}\par
01289 \}\par
01290 \par
01291 {\cf17 template}<AlfFilterType filtTypeCcAlf>\par
01292 {\cf18 void} AdaptiveLoopFilter::filterBlkCcAlf({\cf17 const} PelBuf &dstBuf, {\cf17 const} CPelUnitBuf &recSrc, {\cf17 const} Area &blkDst,\par
01293                                         {\cf17 const} Area &blkSrc, {\cf17 const} ComponentID compId, {\cf17 const} int16_t *filterCoeff,\par
01294                                         {\cf17 const} ClpRngs &clpRngs, CodingStructure &cs, {\cf18 int} vbCTUHeight, {\cf18 int} vbPos)\par
01295 \{\par
01296   CHECK(1 << floorLog2(vbCTUHeight) != vbCTUHeight, {\cf22 "Not a power of 2"});\par
01297 \par
01298   CHECK(!isChroma(compId), {\cf22 "Must be chroma"});\par
01299 \par
01300   {\cf17 const} SPS*     sps           = cs.slice->getSPS();\par
01301   ChromaFormat nChromaFormat   = sps->getChromaFormatIdc();\par
01302   {\cf17 const} {\cf18 int} clsSizeY           = 4;\par
01303   {\cf17 const} {\cf18 int} clsSizeX           = 4;\par
01304   {\cf17 const} {\cf18 int}      startHeight        = blkDst.y;\par
01305   {\cf17 const} {\cf18 int}      endHeight          = blkDst.y + blkDst.height;\par
01306   {\cf17 const} {\cf18 int}      startWidth         = blkDst.x;\par
01307   {\cf17 const} {\cf18 int}      endWidth           = blkDst.x + blkDst.width;\par
01308   {\cf17 const} {\cf18 int} scaleX             = getComponentScaleX(compId, nChromaFormat);\par
01309   {\cf17 const} {\cf18 int} scaleY             = getComponentScaleY(compId, nChromaFormat);\par
01310 \par
01311   CHECK( startHeight % clsSizeY, {\cf22 "Wrong startHeight in filtering"} );\par
01312   CHECK( startWidth % clsSizeX, {\cf22 "Wrong startWidth in filtering"} );\par
01313   CHECK( ( endHeight - startHeight ) % clsSizeY, {\cf22 "Wrong endHeight in filtering"} );\par
01314   CHECK( ( endWidth - startWidth ) % clsSizeX, {\cf22 "Wrong endWidth in filtering"} );\par
01315 \par
01316   CPelBuf     srcBuf     = recSrc.get(COMPONENT_Y);\par
01317   {\cf17 const} {\cf18 int}   lumaStride = srcBuf.stride;\par
01318   {\cf17 const} Pel * lumaPtr    = srcBuf.buf + blkSrc.y * lumaStride + blkSrc.x;\par
01319 \par
01320   {\cf17 const} {\cf18 int}   chromaStride = dstBuf.stride;\par
01321   Pel *       chromaPtr    = dstBuf.buf + blkDst.y * chromaStride + blkDst.x;\par
01322 \par
01323   {\cf19 for}( {\cf18 int} i = 0; i < endHeight - startHeight; i += clsSizeY )\par
01324   \{\par
01325     {\cf19 for}( {\cf18 int} j = 0; j < endWidth - startWidth; j += clsSizeX )\par
01326     \{\par
01327       {\cf19 for}( {\cf18 int} ii = 0; ii < clsSizeY; ii++ )\par
01328       \{\par
01329         {\cf18 int} row       = ii;\par
01330         {\cf18 int} col       = j;\par
01331         Pel *srcSelf  = chromaPtr + col + row * chromaStride;\par
01332 \par
01333         {\cf18 int} offset1 = lumaStride;\par
01334         {\cf18 int} offset2 = -lumaStride;\par
01335         {\cf18 int} offset3 = 2 * lumaStride;\par
01336         row <<= scaleY;\par
01337         col <<= scaleX;\par
01338         {\cf17 const} Pel *srcCross = lumaPtr + col + row * lumaStride;\par
01339 \par
01340         {\cf18 int} pos = ((startHeight + i + ii) << scaleY) & (vbCTUHeight - 1);\par
01341         {\cf19 if} (scaleY == 0 && (pos == vbPos || pos == vbPos + 1))\par
01342         \{\par
01343           {\cf19 continue};\par
01344         \}\par
01345         {\cf19 if} (pos == (vbPos - 2) || pos == (vbPos + 1))\par
01346         \{\par
01347           offset3 = offset1;\par
01348         \}\par
01349         {\cf19 else} {\cf19 if} (pos == (vbPos - 1) || pos == vbPos)\par
01350         \{\par
01351           offset1 = 0;\par
01352           offset2 = 0;\par
01353           offset3 = 0;\par
01354         \}\par
01355 \par
01356         {\cf19 for} ({\cf18 int} jj = 0; jj < clsSizeX; jj++)\par
01357         \{\par
01358           {\cf17 const} {\cf18 int} jj2     = (jj << scaleX);\par
01359           {\cf17 const} {\cf18 int} offset0 = 0;\par
01360 \par
01361           {\cf18 int} sum = 0;\par
01362           {\cf17 const} Pel currSrcCross = srcCross[offset0 + jj2];\par
01363           sum += filterCoeff[0] * (srcCross[offset2 + jj2    ] - currSrcCross);\par
01364           sum += filterCoeff[1] * (srcCross[offset0 + jj2 - 1] - currSrcCross);\par
01365           sum += filterCoeff[2] * (srcCross[offset0 + jj2 + 1] - currSrcCross);\par
01366           sum += filterCoeff[3] * (srcCross[offset1 + jj2 - 1] - currSrcCross);\par
01367           sum += filterCoeff[4] * (srcCross[offset1 + jj2    ] - currSrcCross);\par
01368           sum += filterCoeff[5] * (srcCross[offset1 + jj2 + 1] - currSrcCross);\par
01369           sum += filterCoeff[6] * (srcCross[offset3 + jj2    ] - currSrcCross);\par
01370 \par
01371           sum = (sum + ((1 << m_scaleBits ) >> 1)) >> m_scaleBits;\par
01372           {\cf17 const} {\cf18 int} offset = 1 << clpRngs.comp[compId].bd >> 1;\par
01373           sum = ClipPel(sum + offset, clpRngs.comp[compId]) - offset;\par
01374           sum += srcSelf[jj];\par
01375           srcSelf[jj] = ClipPel(sum, clpRngs.comp[compId]);\par
01376         \}\par
01377       \}\par
01378     \}\par
01379 \par
01380     chromaPtr += chromaStride * clsSizeY;\par
01381 \par
01382     lumaPtr += lumaStride * clsSizeY << getComponentScaleY(compId, nChromaFormat);\par
01383   \}\par
01384 \}\par
}
