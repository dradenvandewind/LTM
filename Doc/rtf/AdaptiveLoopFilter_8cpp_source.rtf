00767       m_classifier[i] = m_classifier[0] + i * picWidth;\par
00768     \}\par
00769   \}\par
00770 \par
00771   {\cf19 for} ({\cf18 int} filterSetIndex = 0; filterSetIndex < NUM_FIXED_FILTER_SETS; filterSetIndex++)\par
