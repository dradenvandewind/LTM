00402 {\cf18 void} AdaptiveLoopFilter::ALFProcess(CodingStructure& cs)\par
00403 \{\par
00404 \par
00405   {\cf20 // set clipping range}\par
00406   m_clpRngs = cs.slice->getClpRngs();\par
00407 \par
00408   {\cf20 // set CTU enable flags}\par
00409   {\cf19 for}( {\cf18 int} compIdx = 0; compIdx < MAX_NUM_COMPONENT; compIdx++ )\par
00410   \{\par
00411     m_ctuEnableFlag[compIdx] = cs.picture->getAlfCtuEnableFlag( compIdx );\par
00412     m_ctuAlternative[compIdx] = cs.picture->getAlfCtuAlternativeData( compIdx );\par
00413   \}\par
00414   {\cf18 short}* alfCtuFilterIndex = {\cf17 nullptr};\par
00415   uint32_t lastSliceIdx = 0xFFFFFFFF;\par
00416 \par
00417   PelUnitBuf recYuv = cs.getRecoBuf();\par
00418   m_tempBuf.copyFrom( recYuv );\par
00419   PelUnitBuf tmpYuv = m_tempBuf.getBuf( cs.area );\par
00420   tmpYuv.extendBorderPel( MAX_ALF_FILTER_LENGTH >> 1 );\par
00421 \par
00422   {\cf17 const} PreCalcValues& pcv = *cs.pcv;\par
00423 \par
00424   {\cf18 int} ctuIdx = 0;\par
00425   {\cf18 bool} clipTop = {\cf17 false}, clipBottom = {\cf17 false}, clipLeft = {\cf17 false}, clipRight = {\cf17 false};\par
00426   {\cf18 int} numHorVirBndry = 0, numVerVirBndry = 0;\par
00427   {\cf18 int} horVirBndryPos[] = \{ 0, 0, 0 \};\par
00428   {\cf18 int} verVirBndryPos[] = \{ 0, 0, 0 \};\par
00429 \par
00430   {\cf19 for}( {\cf18 int} yPos = 0; yPos < pcv.lumaHeight; yPos += pcv.maxCUHeight )\par
00431   \{\par
00432     {\cf19 for}( {\cf18 int} xPos = 0; xPos < pcv.lumaWidth; xPos += pcv.maxCUWidth )\par
00433     \{\par
00434       {\cf20 // get first CU in CTU}\par
00435       {\cf17 const} CodingUnit *cu = cs.getCU( Position(xPos, yPos), CHANNEL_TYPE_LUMA );\par
00436 \par
00437       {\cf20 // skip this CTU if ALF is disabled}\par
00438       {\cf19 if} (!cu->slice->getTileGroupAlfEnabledFlag(COMPONENT_Y) && !cu->slice->getTileGroupAlfEnabledFlag(COMPONENT_Cb) && !cu->slice->getTileGroupAlfEnabledFlag(COMPONENT_Cr))\par
00439       \{\par
00440         ctuIdx++;\par
00441         {\cf19 continue};\par
00442       \}\par
00443 \par
00444       {\cf20 // reload ALF APS each time the slice changes during raster scan filtering}\par
00445       {\cf19 if}(ctuIdx == 0 || lastSliceIdx != cu->slice->getSliceID() || alfCtuFilterIndex=={\cf17 nullptr})\par
00446       \{\par
00447         cs.slice = cu->slice;\par
00448         reconstructCoeffAPSs(cs, {\cf17 true}, cu->slice->getTileGroupAlfEnabledFlag(COMPONENT_Cb) || cu->slice->getTileGroupAlfEnabledFlag(COMPONENT_Cr), {\cf17 false});\par
00449         alfCtuFilterIndex = cu->slice->getPic()->getAlfCtbFilterIndex();\par
00450         m_ccAlfFilterParam = cu->slice->m_ccAlfFilterParam;\par
00451       \}\par
00452       lastSliceIdx = cu->slice->getSliceID();\par
00453 \par
00454       {\cf17 const} {\cf18 int} width = ( xPos + pcv.maxCUWidth > pcv.lumaWidth ) ? ( pcv.lumaWidth - xPos ) : pcv.maxCUWidth;\par
00455       {\cf17 const} {\cf18 int} height = ( yPos + pcv.maxCUHeight > pcv.lumaHeight ) ? ( pcv.lumaHeight - yPos ) : pcv.maxCUHeight;\par
00456       {\cf18 bool} ctuEnableFlag = m_ctuEnableFlag[COMPONENT_Y][ctuIdx];\par
00457       {\cf19 for}( {\cf18 int} compIdx = 1; compIdx < MAX_NUM_COMPONENT; compIdx++ )\par
00458       \{\par
00459         ctuEnableFlag |= m_ctuEnableFlag[compIdx][ctuIdx] > 0;\par
00460         {\cf19 if} (cu->slice->m_ccAlfFilterParam.ccAlfFilterEnabled[compIdx - 1])\par
00461         \{\par
00462           ctuEnableFlag |= m_ccAlfFilterControl[compIdx - 1][ctuIdx] > 0;\par
00463         \}\par
00464       \}\par
00465       {\cf18 int} rasterSliceAlfPad = 0;\par
00466       {\cf19 if}( ctuEnableFlag && isCrossedByVirtualBoundaries( cs, xPos, yPos, width, height, clipTop, clipBottom, clipLeft, clipRight, numHorVirBndry, numVerVirBndry, horVirBndryPos, verVirBndryPos, rasterSliceAlfPad ) )\par
00467       \{\par
00468         {\cf18 int} yStart = yPos;\par
00469         {\cf19 for}( {\cf18 int} i = 0; i <= numHorVirBndry; i++ )\par
00470         \{\par
00471           {\cf17 const} {\cf18 int} yEnd = i == numHorVirBndry ? yPos + height : horVirBndryPos[i];\par
00472           {\cf17 const} {\cf18 int} h = yEnd - yStart;\par
00473           {\cf17 const} {\cf18 bool} clipT = ( i == 0 && clipTop ) || ( i > 0 ) || ( yStart == 0 );\par
00474           {\cf17 const} {\cf18 bool} clipB = ( i == numHorVirBndry && clipBottom ) || ( i < numHorVirBndry ) || ( yEnd == pcv.lumaHeight );\par
00475           {\cf18 int} xStart = xPos;\par
00476           {\cf19 for}( {\cf18 int} j = 0; j <= numVerVirBndry; j++ )\par
00477           \{\par
00478             {\cf17 const} {\cf18 int} xEnd = j == numVerVirBndry ? xPos + width : verVirBndryPos[j];\par
00479             {\cf17 const} {\cf18 int} w = xEnd - xStart;\par
00480             {\cf17 const} {\cf18 bool} clipL = ( j == 0 && clipLeft ) || ( j > 0 ) || ( xStart == 0 );\par
00481             {\cf17 const} {\cf18 bool} clipR = ( j == numVerVirBndry && clipRight ) || ( j < numVerVirBndry ) || ( xEnd == pcv.lumaWidth );\par
00482             {\cf17 const} {\cf18 int} wBuf = w + (clipL ? 0 : MAX_ALF_PADDING_SIZE) + (clipR ? 0 : MAX_ALF_PADDING_SIZE);\par
00483             {\cf17 const} {\cf18 int} hBuf = h + (clipT ? 0 : MAX_ALF_PADDING_SIZE) + (clipB ? 0 : MAX_ALF_PADDING_SIZE);\par
00484             PelUnitBuf buf = m_tempBuf2.subBuf( UnitArea( cs.area.chromaFormat, Area( 0, 0, wBuf, hBuf ) ) );\par
00485             buf.copyFrom( tmpYuv.subBuf( UnitArea( cs.area.chromaFormat, Area( xStart - (clipL ? 0 : MAX_ALF_PADDING_SIZE), yStart - (clipT ? 0 : MAX_ALF_PADDING_SIZE), wBuf, hBuf ) ) ) );\par
00486             {\cf20 // pad top-left unavailable samples for raster slice}\par
00487             {\cf19 if} ( xStart == xPos && yStart == yPos && ( rasterSliceAlfPad & 1 ) )\par
00488             \{\par
00489               buf.padBorderPel( MAX_ALF_PADDING_SIZE, 1 );\par
00490             \}\par
00491 \par
00492             {\cf20 // pad bottom-right unavailable samples for raster slice}\par
00493             {\cf19 if} ( xEnd == xPos + width && yEnd == yPos + height && ( rasterSliceAlfPad & 2 ) )\par
00494             \{\par
00495               buf.padBorderPel( MAX_ALF_PADDING_SIZE, 2 );\par
00496             \}\par
00497             buf.extendBorderPel( MAX_ALF_PADDING_SIZE );\par
00498             buf = buf.subBuf( UnitArea ( cs.area.chromaFormat, Area( clipL ? 0 : MAX_ALF_PADDING_SIZE, clipT ? 0 : MAX_ALF_PADDING_SIZE, w, h ) ) );\par
00499 \par
00500             {\cf19 if}( m_ctuEnableFlag[COMPONENT_Y][ctuIdx] )\par
00501             \{\par
00502               {\cf17 const} Area blkSrc( 0, 0, w, h );\par
00503               {\cf17 const} Area blkDst( xStart, yStart, w, h );\par
00504               deriveClassification( m_classifier, buf.get(COMPONENT_Y), blkDst, blkSrc );\par
00505               {\cf18 short} filterSetIndex = alfCtuFilterIndex[ctuIdx];\par
00506               {\cf18 short} *coeff;\par
00507               Pel *clip;\par
00508               {\cf19 if} (filterSetIndex >= NUM_FIXED_FILTER_SETS)\par
00509               \{\par
00510                 coeff = m_coeffApsLuma[filterSetIndex - NUM_FIXED_FILTER_SETS];\par
00511                 clip = m_clippApsLuma[filterSetIndex - NUM_FIXED_FILTER_SETS];\par
00512               \}\par
00513               {\cf19 else}\par
00514               \{\par
00515                 coeff = m_fixedFilterSetCoeffDec[filterSetIndex];\par
00516                 clip = m_clipDefault;\par
00517               \}\par
00518               m_filter7x7Blk(m_classifier, recYuv, buf, blkDst, blkSrc, COMPONENT_Y, coeff, clip, m_clpRngs.comp[COMPONENT_Y], cs\par
00519                 , m_alfVBLumaCTUHeight\par
00520                 , m_alfVBLumaPos\par
00521               );\par
00522             \}\par
00523 \par
00524             {\cf19 for}( {\cf18 int} compIdx = 1; compIdx < MAX_NUM_COMPONENT; compIdx++ )\par
00525             \{\par
00526               ComponentID compID = ComponentID( compIdx );\par
00527               {\cf17 const} {\cf18 int} chromaScaleX = getComponentScaleX( compID, tmpYuv.chromaFormat );\par
00528               {\cf17 const} {\cf18 int} chromaScaleY = getComponentScaleY( compID, tmpYuv.chromaFormat );\par
00529 \par
00530               {\cf19 if}( m_ctuEnableFlag[compIdx][ctuIdx] )\par
00531               \{\par
00532                 {\cf17 const} Area blkSrc( 0, 0, w >> chromaScaleX, h >> chromaScaleY );\par
00533                 {\cf17 const} Area blkDst( xStart >> chromaScaleX, yStart >> chromaScaleY, w >> chromaScaleX, h >> chromaScaleY );\par
00534                 uint8_t alt_num = m_ctuAlternative[compIdx][ctuIdx];\par
00535                 m_filter5x5Blk(m_classifier, recYuv, buf, blkDst, blkSrc, compID, m_chromaCoeffFinal[alt_num], m_chromaClippFinal[alt_num], m_clpRngs.comp[compIdx], cs\par
00536                   , m_alfVBChmaCTUHeight\par
00537                    , m_alfVBChmaPos );\par
00538               \}\par
00539               {\cf19 if} (cu->slice->m_ccAlfFilterParam.ccAlfFilterEnabled[compIdx - 1])\par
00540               \{\par
00541                 {\cf17 const} {\cf18 int} filterIdx = m_ccAlfFilterControl[compIdx - 1][ctuIdx];\par
00542 \par
00543                 {\cf19 if} (filterIdx != 0)\par
00544                 \{\par
00545                   {\cf17 const} Area blkSrc(0, 0, w, h);\par
00546                   Area blkDst(xStart >> chromaScaleX, yStart >> chromaScaleY, w >> chromaScaleX, h >> chromaScaleY);\par
00547 \par
00548                   {\cf17 const} int16_t *filterCoeff = m_ccAlfFilterParam.ccAlfCoeff[compIdx - 1][filterIdx - 1];\par
00549 \par
00550                   m_filterCcAlf(recYuv.get(compID), buf, blkDst, blkSrc, compID, filterCoeff, m_clpRngs, cs,\par
00551                                 m_alfVBLumaCTUHeight, m_alfVBLumaPos);\par
00552                 \}\par
00553               \}\par
00554             \}\par
00555 \par
00556             xStart = xEnd;\par
00557           \}\par
00558 \par
00559           yStart = yEnd;\par
00560         \}\par
00561       \}\par
00562       {\cf19 else}\par
00563       \{\par
00564         {\cf17 const} UnitArea area( cs.area.chromaFormat, Area( xPos, yPos, width, height ) );\par
00565         {\cf19 if}( m_ctuEnableFlag[COMPONENT_Y][ctuIdx] )\par
00566         \{\par
00567           Area blk( xPos, yPos, width, height );\par
00568           deriveClassification( m_classifier, tmpYuv.get( COMPONENT_Y ), blk, blk );\par
00569           {\cf18 short} filterSetIndex = alfCtuFilterIndex[ctuIdx];\par
00570           {\cf18 short} *coeff;\par
00571           Pel *clip;\par
00572           {\cf19 if} (filterSetIndex >= NUM_FIXED_FILTER_SETS)\par
00573           \{\par
00574             coeff = m_coeffApsLuma[filterSetIndex - NUM_FIXED_FILTER_SETS];\par
00575             clip = m_clippApsLuma[filterSetIndex - NUM_FIXED_FILTER_SETS];\par
00576           \}\par
00577           {\cf19 else}\par
00578           \{\par
00579             coeff = m_fixedFilterSetCoeffDec[filterSetIndex];\par
00580             clip = m_clipDefault;\par
00581           \}\par
00582           m_filter7x7Blk(m_classifier, recYuv, tmpYuv, blk, blk, COMPONENT_Y, coeff, clip, m_clpRngs.comp[COMPONENT_Y],\par
00583                          cs, m_alfVBLumaCTUHeight, m_alfVBLumaPos);\par
00584         \}\par
00585 \par
00586         {\cf19 for}( {\cf18 int} compIdx = 1; compIdx < MAX_NUM_COMPONENT; compIdx++ )\par
00587         \{\par
00588           ComponentID compID = ComponentID( compIdx );\par
00589           {\cf17 const} {\cf18 int} chromaScaleX = getComponentScaleX( compID, tmpYuv.chromaFormat );\par
00590           {\cf17 const} {\cf18 int} chromaScaleY = getComponentScaleY( compID, tmpYuv.chromaFormat );\par
00591 \par
00592           {\cf19 if} (m_ctuEnableFlag[compIdx][ctuIdx])\par
00593           \{\par
00594             Area    blk(xPos >> chromaScaleX, yPos >> chromaScaleY, width >> chromaScaleX, height >> chromaScaleY);\par
00595             uint8_t alt_num = m_ctuAlternative[compIdx][ctuIdx];\par
00596             m_filter5x5Blk(m_classifier, recYuv, tmpYuv, blk, blk, compID, m_chromaCoeffFinal[alt_num],\par
00597                            m_chromaClippFinal[alt_num], m_clpRngs.comp[compIdx], cs, m_alfVBChmaCTUHeight,\par
00598                            m_alfVBChmaPos);\par
00599           \}\par
00600           {\cf19 if} (cu->slice->m_ccAlfFilterParam.ccAlfFilterEnabled[compIdx - 1])\par
00601           \{\par
00602             {\cf17 const} {\cf18 int} filterIdx = m_ccAlfFilterControl[compIdx - 1][ctuIdx];\par
00603 \par
00604             {\cf19 if} (filterIdx != 0)\par
00605             \{\par
00606               Area blkDst(xPos >> chromaScaleX, yPos >> chromaScaleY, width >> chromaScaleX, height >> chromaScaleY);\par
00607               Area blkSrc(xPos, yPos, width, height);\par
00608 \par
00609               {\cf17 const} int16_t *filterCoeff = m_ccAlfFilterParam.ccAlfCoeff[compIdx - 1][filterIdx - 1];\par
00610 \par
00611               m_filterCcAlf(recYuv.get(compID), tmpYuv, blkDst, blkSrc, compID, filterCoeff, m_clpRngs, cs,\par
00612                             m_alfVBLumaCTUHeight, m_alfVBLumaPos);\par
00613             \}\par
00614           \}\par
00615         \}\par
00616       \}\par
00617       ctuIdx++;\par
00618     \}\par
00619   \}\par
00620 \}\par
