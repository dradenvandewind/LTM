00622 {\cf18 void} AdaptiveLoopFilter::reconstructCoeffAPSs(CodingStructure& cs, {\cf18 bool} luma, {\cf18 bool} chroma, {\cf18 bool} isRdo)\par
00623 \{\par
00624   {\cf20 //luma}\par
00625   APS** aps = cs.slice->getAlfAPSs();\par
00626   AlfParam alfParamTmp;\par
00627   APS* curAPS;\par
00628   {\cf19 if} (luma)\par
00629   \{\par
00630     {\cf19 for} ({\cf18 int} i = 0; i < cs.slice->getTileGroupNumAps(); i++)\par
00631     \{\par
00632       {\cf18 int} apsIdx = cs.slice->getTileGroupApsIdLuma()[i];\par
00633       curAPS = aps[apsIdx];\par
00634       CHECK(curAPS == NULL, {\cf22 "invalid APS"});\par
00635       alfParamTmp = curAPS->getAlfAPSParam();\par
00636       reconstructCoeff(alfParamTmp, CHANNEL_TYPE_LUMA, isRdo, {\cf17 true});\par
00637       memcpy(m_coeffApsLuma[i], m_coeffFinal, {\cf17 sizeof}(m_coeffFinal));\par
00638       memcpy(m_clippApsLuma[i], m_clippFinal, {\cf17 sizeof}(m_clippFinal));\par
00639     \}\par
00640   \}\par
00641 \par
00642   {\cf20 //chroma}\par
00643   {\cf19 if} (chroma)\par
00644   \{\par
00645     {\cf18 int} apsIdxChroma = cs.slice->getTileGroupApsIdChroma();\par
00646     curAPS = aps[apsIdxChroma];\par
00647     m_alfParamChroma = &curAPS->getAlfAPSParam();\par
00648     alfParamTmp = *m_alfParamChroma;\par
00649     reconstructCoeff(alfParamTmp, CHANNEL_TYPE_CHROMA, isRdo, {\cf17 true});\par
00650   \}\par
00651 \}\par
00652 \par
00653 {\cf18 void} AdaptiveLoopFilter::reconstructCoeff( AlfParam& alfParam, ChannelType channel, {\cf17 const} {\cf18 bool} isRdo, {\cf17 const} {\cf18 bool} isRedo )\par
00654 \{\par
00655   {\cf18 int} factor = isRdo ? 0 : (1 << (m_NUM_BITS - 1));\par
00656   AlfFilterType filterType = isLuma( channel ) ? ALF_FILTER_7 : ALF_FILTER_5;\par
00657   {\cf18 int} numClasses = isLuma( channel ) ? MAX_NUM_ALF_CLASSES : 1;\par
00658   {\cf18 int} numCoeff = filterType == ALF_FILTER_5 ? 7 : 13;\par
00659   {\cf18 int} numCoeffMinus1 = numCoeff - 1;\par
00660   {\cf17 const} {\cf18 int} numAlts = isLuma( channel ) ? 1 : alfParam.numAlternativesChroma;\par
00661 \par
00662   {\cf19 for}( {\cf18 int} altIdx = 0; altIdx < numAlts; ++ altIdx )\par
00663   \{\par
00664     {\cf18 int} numFilters = isLuma( channel ) ? alfParam.numLumaFilters : 1;\par
00665     {\cf18 short}* coeff = isLuma( channel ) ? alfParam.lumaCoeff : alfParam.chromaCoeff[altIdx];\par
00666     Pel* clipp = isLuma( channel ) ? alfParam.lumaClipp : alfParam.chromaClipp[altIdx];\par
00667 \par
00668     {\cf19 for}( {\cf18 int} filterIdx = 0; filterIdx < numFilters; filterIdx++ )\par
00669     \{\par
00670       coeff[filterIdx* MAX_NUM_ALF_LUMA_COEFF + numCoeffMinus1] = factor;\par
00671     \}\par
00672 \par
00673     {\cf19 if}( isChroma( channel ) )\par
00674     \{\par
00675       {\cf19 for}( {\cf18 int} coeffIdx = 0; coeffIdx < numCoeffMinus1; ++coeffIdx )\par
00676       \{\par
00677         m_chromaCoeffFinal[altIdx][coeffIdx] = coeff[coeffIdx];\par
00678         {\cf18 int} clipIdx = alfParam.nonLinearFlag[channel] ? clipp[coeffIdx] : 0;\par
00679         m_chromaClippFinal[altIdx][coeffIdx] = isRdo ? clipIdx : m_alfClippingValues[channel][clipIdx];\par
00680       \}\par
00681       m_chromaCoeffFinal[altIdx][numCoeffMinus1] = factor;\par
00682       m_chromaClippFinal[altIdx][numCoeffMinus1] = isRdo ? 0 : m_alfClippingValues[channel][0];\par
00683       {\cf19 continue};\par
00684     \}\par
00685     {\cf19 for}( {\cf18 int} classIdx = 0; classIdx < numClasses; classIdx++ )\par
00686     \{\par
00687       {\cf18 int} filterIdx = alfParam.filterCoeffDeltaIdx[classIdx];\par
00688 \par
00689       CHECK(!(filterIdx >= 0 && filterIdx < alfParam.numLumaFilters), {\cf22 "Bad coeff delta idx in ALF"});\par
00690       {\cf19 for} ({\cf18 int} coeffIdx = 0; coeffIdx < numCoeffMinus1; ++coeffIdx)\par
00691       \{\par
00692         m_coeffFinal[classIdx * MAX_NUM_ALF_LUMA_COEFF + coeffIdx] = coeff[filterIdx * MAX_NUM_ALF_LUMA_COEFF + coeffIdx];\par
00693       \}\par
00694       m_coeffFinal[classIdx* MAX_NUM_ALF_LUMA_COEFF + numCoeffMinus1] = factor;\par
00695       m_clippFinal[classIdx* MAX_NUM_ALF_LUMA_COEFF + numCoeffMinus1] = isRdo ? 0 : m_alfClippingValues[channel][0];\par
00696       {\cf19 for}( {\cf18 int} coeffIdx = 0; coeffIdx < numCoeffMinus1; ++coeffIdx )\par
00697       \{\par
00698         {\cf18 int} clipIdx = alfParam.nonLinearFlag[channel] ? clipp[filterIdx * MAX_NUM_ALF_LUMA_COEFF + coeffIdx] : 0;\par
00699         CHECK(!(clipIdx >= 0 && clipIdx < MaxAlfNumClippingValues), {\cf22 "Bad clip idx in ALF"});\par
00700         m_clippFinal[classIdx * MAX_NUM_ALF_LUMA_COEFF + coeffIdx] = isRdo ? clipIdx : m_alfClippingValues[channel][clipIdx];\par
00701       \}\par
00702       m_clippFinal[classIdx* MAX_NUM_ALF_LUMA_COEFF + numCoeffMinus1] =\par
00703         isRdo ? 0 :\par
00704         m_alfClippingValues[channel][0];\par
00705     \}\par
00706   \}\par
00707 \}\par
00708 \par
00709 {\cf18 void} AdaptiveLoopFilter::create( {\cf17 const} {\cf18 int} picWidth, {\cf17 const} {\cf18 int} picHeight, {\cf17 const} ChromaFormat format, {\cf17 const} {\cf18 int} maxCUWidth, {\cf17 const} {\cf18 int} maxCUHeight, {\cf17 const} {\cf18 int} maxCUDepth, {\cf17 const} {\cf18 int} inputBitDepth[MAX_NUM_CHANNEL_TYPE] )\par
00710 \{\par
00711   destroy();\par
00712   std::memcpy( m_inputBitDepth, inputBitDepth, {\cf17 sizeof}( m_inputBitDepth ) );\par
00713   m_picWidth = picWidth;\par
00714   m_picHeight = picHeight;\par
00715   m_maxCUWidth = maxCUWidth;\par
00716   m_maxCUHeight = maxCUHeight;\par
00717   m_maxCUDepth = maxCUDepth;\par
00718   m_chromaFormat = format;\par
00719 \par
00720   m_numCTUsInWidth = ( m_picWidth / m_maxCUWidth ) + ( ( m_picWidth % m_maxCUWidth ) ? 1 : 0 );\par
00721   m_numCTUsInHeight = ( m_picHeight / m_maxCUHeight ) + ( ( m_picHeight % m_maxCUHeight ) ? 1 : 0 );\par
00722   m_numCTUsInPic = m_numCTUsInHeight * m_numCTUsInWidth;\par
00723   m_filterShapesCcAlf[0].push_back(AlfFilterShape(size_CC_ALF));\par
00724   m_filterShapesCcAlf[1].push_back(AlfFilterShape(size_CC_ALF));\par
00725   m_filterShapes[CHANNEL_TYPE_LUMA].push_back( AlfFilterShape( 7 ) );\par
00726   m_filterShapes[CHANNEL_TYPE_CHROMA].push_back( AlfFilterShape( 5 ) );\par
00727   m_alfVBLumaPos = m_maxCUHeight - ALF_VB_POS_ABOVE_CTUROW_LUMA;\par
00728   m_alfVBChmaPos = (m_maxCUHeight >> ((m_chromaFormat == CHROMA_420) ? 1 : 0)) - ALF_VB_POS_ABOVE_CTUROW_CHMA;\par
00729 \par
00730   m_alfVBLumaCTUHeight = m_maxCUHeight;\par
00731   m_alfVBChmaCTUHeight = (m_maxCUHeight >> ((m_chromaFormat == CHROMA_420) ? 1 : 0));\par
00732 \par
00733   {\cf17 static_assert}( AlfNumClippingValues[CHANNEL_TYPE_LUMA] > 0, {\cf22 "AlfNumClippingValues[CHANNEL_TYPE_LUMA] must be at least one"} );\par
00734   m_alfClippingValues[CHANNEL_TYPE_LUMA][0] = 1 << m_inputBitDepth[CHANNEL_TYPE_LUMA];\par
00735   {\cf18 int} shiftLuma = m_inputBitDepth[CHANNEL_TYPE_LUMA] - 8;\par
00736   {\cf19 for} ({\cf18 int} i = 1; i < AlfNumClippingValues[CHANNEL_TYPE_LUMA]; ++i)\par
00737   \{\par
00738     m_alfClippingValues[CHANNEL_TYPE_LUMA][i] = 1 << (7 - 2 * i + shiftLuma);\par
00739   \}\par
00740   {\cf17 static_assert}( AlfNumClippingValues[CHANNEL_TYPE_CHROMA] > 0, {\cf22 "AlfNumClippingValues[CHANNEL_TYPE_CHROMA] must be at least one"} );\par
