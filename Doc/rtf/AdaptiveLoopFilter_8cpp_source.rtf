00300 {\cf18 void} AdaptiveLoopFilter::applyCcAlfFilter(CodingStructure &cs, ComponentID compID, {\cf17 const} PelBuf &dstBuf,\par
00301                                           {\cf17 const} PelUnitBuf &recYuvExt, uint8_t *filterControl,\par
00302                                           {\cf17 const} {\cf18 short} filterSet[MAX_NUM_CC_ALF_FILTERS][MAX_NUM_CC_ALF_CHROMA_COEFF],\par
00303                                           {\cf17 const} {\cf18 int}   selectedFilterIdx)\par
00304 \{\par
00305   {\cf18 bool} clipTop = {\cf17 false}, clipBottom = {\cf17 false}, clipLeft = {\cf17 false}, clipRight = {\cf17 false};\par
00306   {\cf18 int}  numHorVirBndry = 0, numVerVirBndry = 0;\par
00307   {\cf18 int}  horVirBndryPos[] = \{ 0, 0, 0 \};\par
00308   {\cf18 int}  verVirBndryPos[] = \{ 0, 0, 0 \};\par
00309 \par
00310   {\cf18 int} ctuIdx = 0;\par
00311   {\cf19 for}( {\cf18 int} yPos = 0; yPos < m_picHeight; yPos += m_maxCUHeight )\par
00312   \{\par
00313     {\cf19 for}( {\cf18 int} xPos = 0; xPos < m_picWidth; xPos += m_maxCUWidth )\par
00314     \{\par
00315       {\cf18 int} filterIdx =\par
00316         (filterControl == {\cf17 nullptr})\par
00317           ? selectedFilterIdx\par
00318           : filterControl[(yPos >> cs.pcv->maxCUHeightLog2) * cs.pcv->widthInCtus + (xPos >> cs.pcv->maxCUWidthLog2)];\par
00319       {\cf18 bool} skipFiltering = (filterControl != {\cf17 nullptr} && filterIdx == 0) ? {\cf17 true} : {\cf17 false};\par
00320       {\cf19 if} (!skipFiltering)\par
00321       \{\par
00322         {\cf19 if} (filterControl != {\cf17 nullptr})\par
00323         \{\par
00324           filterIdx--;\par
00325         \}\par
00326 \par
00327         {\cf17 const} int16_t *filterCoeff = filterSet[filterIdx];\par
00328 \par
00329         {\cf17 const} {\cf18 int} width        = (xPos + m_maxCUWidth > m_picWidth) ? (m_picWidth - xPos) : m_maxCUWidth;\par
00330         {\cf17 const} {\cf18 int} height       = (yPos + m_maxCUHeight > m_picHeight) ? (m_picHeight - yPos) : m_maxCUHeight;\par
00331         {\cf17 const} {\cf18 int} chromaScaleX = getComponentScaleX(compID, m_chromaFormat);\par
00332         {\cf17 const} {\cf18 int} chromaScaleY = getComponentScaleY(compID, m_chromaFormat);\par
00333 \par
00334         {\cf18 int} rasterSliceAlfPad = 0;\par
00335         {\cf19 if} (isCrossedByVirtualBoundaries(cs, xPos, yPos, width, height, clipTop, clipBottom, clipLeft, clipRight,\par
00336                                          numHorVirBndry, numVerVirBndry, horVirBndryPos, verVirBndryPos,\par
00337                                          rasterSliceAlfPad))\par
00338         \{\par
00339           {\cf18 int} yStart = yPos;\par
00340           {\cf19 for} ({\cf18 int} i = 0; i <= numHorVirBndry; i++)\par
00341           \{\par
00342             {\cf17 const} {\cf18 int}  yEnd   = i == numHorVirBndry ? yPos + height : horVirBndryPos[i];\par
00343             {\cf17 const} {\cf18 int}  h      = yEnd - yStart;\par
00344             {\cf17 const} {\cf18 bool} clipT  = (i == 0 && clipTop) || (i > 0) || (yStart == 0);\par
00345             {\cf17 const} {\cf18 bool} clipB  = (i == numHorVirBndry && clipBottom) || (i < numHorVirBndry) || (yEnd == m_picHeight);\par
00346             {\cf18 int}        xStart = xPos;\par
00347             {\cf19 for} ({\cf18 int} j = 0; j <= numVerVirBndry; j++)\par
00348             \{\par
00349               {\cf17 const} {\cf18 int}  xEnd  = j == numVerVirBndry ? xPos + width : verVirBndryPos[j];\par
00350               {\cf17 const} {\cf18 int}  w     = xEnd - xStart;\par
00351               {\cf17 const} {\cf18 bool} clipL = (j == 0 && clipLeft) || (j > 0) || (xStart == 0);\par
00352               {\cf17 const} {\cf18 bool} clipR = (j == numVerVirBndry && clipRight) || (j < numVerVirBndry) || (xEnd == m_picWidth);\par
00353               {\cf17 const} {\cf18 int}  wBuf  = w + (clipL ? 0 : MAX_ALF_PADDING_SIZE) + (clipR ? 0 : MAX_ALF_PADDING_SIZE);\par
00354               {\cf17 const} {\cf18 int}  hBuf  = h + (clipT ? 0 : MAX_ALF_PADDING_SIZE) + (clipB ? 0 : MAX_ALF_PADDING_SIZE);\par
00355               PelUnitBuf buf   = m_tempBuf2.subBuf(UnitArea(cs.area.chromaFormat, Area(0, 0, wBuf, hBuf)));\par
00356               buf.copyFrom(recYuvExt.subBuf(\par
00357                 UnitArea(cs.area.chromaFormat, Area(xStart - (clipL ? 0 : MAX_ALF_PADDING_SIZE),\par
00358                                                     yStart - (clipT ? 0 : MAX_ALF_PADDING_SIZE), wBuf, hBuf))));\par
00359               {\cf20 // pad top-left unavailable samples for raster slice}\par
00360               {\cf19 if} (xStart == xPos && yStart == yPos && (rasterSliceAlfPad & 1))\par
00361               \{\par
00362                 buf.padBorderPel(MAX_ALF_PADDING_SIZE, 1);\par
00363               \}\par
00364 \par
00365               {\cf20 // pad bottom-right unavailable samples for raster slice}\par
00366               {\cf19 if} (xEnd == xPos + width && yEnd == yPos + height && (rasterSliceAlfPad & 2))\par
00367               \{\par
00368                 buf.padBorderPel(MAX_ALF_PADDING_SIZE, 2);\par
00369               \}\par
00370               buf.extendBorderPel(MAX_ALF_PADDING_SIZE);\par
00371               buf = buf.subBuf(UnitArea(\par
00372                 cs.area.chromaFormat, Area(clipL ? 0 : MAX_ALF_PADDING_SIZE, clipT ? 0 : MAX_ALF_PADDING_SIZE, w, h)));\par
00373 \par
00374               {\cf17 const} Area blkSrc(0, 0, w, h);\par
00375 \par
00376               {\cf17 const} Area blkDst(xStart >> chromaScaleX, yStart >> chromaScaleY, w >> chromaScaleX, h >> chromaScaleY);\par
00377               m_filterCcAlf(dstBuf, buf, blkDst, blkSrc, compID, filterCoeff, m_clpRngs, cs, m_alfVBLumaCTUHeight,\par
00378                             m_alfVBLumaPos);\par
00379 \par
00380               xStart = xEnd;\par
00381             \}\par
00382 \par
00383             yStart = yEnd;\par
00384           \}\par
00385         \}\par
00386         {\cf19 else}\par
00387         \{\par
00388           {\cf17 const} UnitArea area(m_chromaFormat, Area(xPos, yPos, width, height));\par
00389 \par
00390           Area blkDst(xPos >> chromaScaleX, yPos >> chromaScaleY, width >> chromaScaleX, height >> chromaScaleY);\par
00391           Area blkSrc(xPos, yPos, width, height);\par
00392 \par
00393           m_filterCcAlf(dstBuf, recYuvExt, blkDst, blkSrc, compID, filterCoeff, m_clpRngs, cs, m_alfVBLumaCTUHeight,\par
00394                         m_alfVBLumaPos);\par
