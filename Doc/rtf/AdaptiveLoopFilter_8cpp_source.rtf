00077 {\cf18 bool} AdaptiveLoopFilter::isCrossedByVirtualBoundaries( {\cf17 const} CodingStructure& cs, {\cf17 const} {\cf18 int} xPos, {\cf17 const} {\cf18 int} yPos, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height, {\cf18 bool}& clipTop, {\cf18 bool}& clipBottom, {\cf18 bool}& clipLeft, {\cf18 bool}& clipRight, {\cf18 int}& numHorVirBndry, {\cf18 int}& numVerVirBndry, {\cf18 int} horVirBndryPos[], {\cf18 int} verVirBndryPos[], {\cf18 int}& rasterSliceAlfPad )\par
00078 \{\par
00079   clipTop = {\cf17 false}; clipBottom = {\cf17 false}; clipLeft = {\cf17 false}; clipRight = {\cf17 false};\par
00080   numHorVirBndry = 0; numVerVirBndry = 0;\par
00081   {\cf17 const} PPS*   pps = cs.pps;\par
00082   {\cf17 const} PicHeader* picHeader = cs.picHeader;\par
00083 \par
00084   {\cf19 if}( picHeader->getVirtualBoundariesPresentFlag() )\par
00085   \{\par
00086     {\cf19 for}( {\cf18 int} i = 0; i < picHeader->getNumHorVirtualBoundaries(); i++ )\par
00087     \{\par
00088       {\cf19 if}( picHeader->getVirtualBoundariesPosY(i) == yPos )\par
00089       \{\par
00090         clipTop = {\cf17 true};\par
00091       \}\par
00092       {\cf19 else} {\cf19 if}( picHeader->getVirtualBoundariesPosY(i) == yPos + height )\par
00093       \{\par
00094         clipBottom = {\cf17 true};\par
00095       \}\par
00096       {\cf19 else} {\cf19 if}( yPos < picHeader->getVirtualBoundariesPosY(i) && picHeader->getVirtualBoundariesPosY(i) < yPos + height )\par
00097       \{\par
00098         horVirBndryPos[numHorVirBndry++] = picHeader->getVirtualBoundariesPosY(i);\par
00099       \}\par
00100     \}\par
00101     {\cf19 for}( {\cf18 int} i = 0; i < picHeader->getNumVerVirtualBoundaries(); i++ )\par
00102     \{\par
00103       {\cf19 if}( picHeader->getVirtualBoundariesPosX(i) == xPos )\par
00104       \{\par
00105         clipLeft = {\cf17 true};\par
00106       \}\par
00107       {\cf19 else} {\cf19 if}( picHeader->getVirtualBoundariesPosX(i) == xPos + width )\par
00108       \{\par
00109         clipRight = {\cf17 true};\par
00110       \}\par
00111       {\cf19 else} {\cf19 if}( xPos < picHeader->getVirtualBoundariesPosX(i) && picHeader->getVirtualBoundariesPosX(i) < xPos + width )\par
00112       \{\par
00113         verVirBndryPos[numVerVirBndry++] = picHeader->getVirtualBoundariesPosX(i);\par
00114       \}\par
00115     \}\par
00116   \}\par
00117 \par
00118   {\cf17 const} Slice& slice = *(cs.slice);\par
00119   {\cf18 int}   ctuSize = slice.getSPS()->getCTUSize();\par
00120   {\cf17 const} Position currCtuPos(xPos, yPos);\par
00121   {\cf17 const} CodingUnit *currCtu = cs.getCU(currCtuPos, CHANNEL_TYPE_LUMA);\par
00122   {\cf17 const} SubPic& curSubPic = slice.getPPS()->getSubPicFromPos(currCtuPos);\par
00123   {\cf18 bool} loopFilterAcrossSubPicEnabledFlag = curSubPic.getloopFilterAcrossEnabledFlag();\par
00124   {\cf20 //top}\par
00125   {\cf19 if} (yPos >= ctuSize && clipTop == {\cf17 false})\par
00126   \{\par
00127     {\cf17 const} Position prevCtuPos(xPos, yPos - ctuSize);\par
00128     {\cf17 const} CodingUnit *prevCtu = cs.getCU(prevCtuPos, CHANNEL_TYPE_LUMA);\par
00129     {\cf19 if} ((!pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice(*currCtu, *prevCtu)) ||\par
00130         (!pps->getLoopFilterAcrossTilesEnabledFlag()  && !CU::isSameTile(*currCtu,  *prevCtu))\par
00131       || (!loopFilterAcrossSubPicEnabledFlag && !CU::isSameSubPic(*currCtu, *prevCtu))\par
00132       )\par
00133     \{\par
00134       clipTop = {\cf17 true};\par
00135     \}\par
00136   \}\par
00137 \par
00138   {\cf20 //bottom}\par
00139   {\cf19 if} (yPos + ctuSize < cs.pcv->lumaHeight && clipBottom == {\cf17 false})\par
00140   \{\par
00141     {\cf17 const} Position nextCtuPos(xPos, yPos + ctuSize);\par
00142     {\cf17 const} CodingUnit *nextCtu = cs.getCU(nextCtuPos, CHANNEL_TYPE_LUMA);\par
00143     {\cf19 if} ((!pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice(*currCtu, *nextCtu)) ||\par
00144         (!pps->getLoopFilterAcrossTilesEnabledFlag()  && !CU::isSameTile(*currCtu,  *nextCtu))\par
00145       || (!loopFilterAcrossSubPicEnabledFlag && !CU::isSameSubPic(*currCtu, *nextCtu))\par
00146       )\par
00147     \{\par
00148       clipBottom = {\cf17 true};\par
00149     \}\par
00150   \}\par
00151 \par
00152   {\cf20 //left}\par
00153   {\cf19 if} (xPos >= ctuSize && clipLeft == {\cf17 false})\par
00154   \{\par
00155     {\cf17 const} Position prevCtuPos(xPos - ctuSize, yPos);\par
00156     {\cf17 const} CodingUnit *prevCtu = cs.getCU(prevCtuPos, CHANNEL_TYPE_LUMA);\par
00157     {\cf19 if} ((!pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice(*currCtu, *prevCtu)) ||\par
00158         (!pps->getLoopFilterAcrossTilesEnabledFlag()  && !CU::isSameTile(*currCtu,  *prevCtu))\par
00159       || (!loopFilterAcrossSubPicEnabledFlag && !CU::isSameSubPic(*currCtu, *prevCtu))\par
00160       )\par
00161     \{\par
00162       clipLeft = {\cf17 true};\par
00163     \}\par
00164   \}\par
00165 \par
00166   {\cf20 //right}\par
00167   {\cf19 if} (xPos + ctuSize < cs.pcv->lumaWidth && clipRight == {\cf17 false})\par
00168   \{\par
00169     {\cf17 const} Position nextCtuPos(xPos + ctuSize, yPos);\par
00170     {\cf17 const} CodingUnit *nextCtu = cs.getCU(nextCtuPos, CHANNEL_TYPE_LUMA);\par
00171     {\cf19 if} ((!pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice(*currCtu, *nextCtu)) ||\par
00172         (!pps->getLoopFilterAcrossTilesEnabledFlag()  && !CU::isSameTile(*currCtu,  *nextCtu))\par
00173       || (!loopFilterAcrossSubPicEnabledFlag && !CU::isSameSubPic(*currCtu, *nextCtu))\par
00174       )\par
00175     \{\par
00176       clipRight = {\cf17 true};\par
00177     \}\par
00178   \}\par
00179 \par
00180   rasterSliceAlfPad = 0;\par
00181   {\cf19 if} ( !clipTop && !clipLeft )\par
00182   \{\par
00183     {\cf20 //top-left CTU}\par
00184     {\cf19 if} ( xPos >= ctuSize && yPos >= ctuSize )\par
00185     \{\par
00186       {\cf17 const} Position prevCtuPos( xPos - ctuSize, yPos - ctuSize );\par
00187       {\cf17 const} CodingUnit *prevCtu = cs.getCU( prevCtuPos, CHANNEL_TYPE_LUMA );\par
00188       {\cf19 if} ( !pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice( *currCtu, *prevCtu ) )\par
00189       \{\par
00190         rasterSliceAlfPad = 1;\par
00191       \}\par
00192     \}\par
00193   \}\par
00194 \par
00195   {\cf19 if} ( !clipBottom && !clipRight )\par
00196   \{\par
00197     {\cf20 //bottom-right CTU}\par
00198     {\cf19 if} ( xPos + ctuSize < cs.pcv->lumaWidth && yPos + ctuSize < cs.pcv->lumaHeight )\par
00199     \{\par
00200       {\cf17 const} Position nextCtuPos( xPos + ctuSize, yPos + ctuSize );\par
00201       {\cf17 const} CodingUnit *nextCtu = cs.getCU( nextCtuPos, CHANNEL_TYPE_LUMA );\par
00202       {\cf19 if} ( !pps->getLoopFilterAcrossSlicesEnabledFlag() && !CU::isSameSlice( *currCtu, *nextCtu ) )\par
00203       \{\par
00204         rasterSliceAlfPad += 2;\par
00205       \}\par
00206     \}\par
00207   \}\par
00208 \par
00209   {\cf19 return} numHorVirBndry > 0 || numVerVirBndry > 0 || clipTop || clipBottom || clipLeft || clipRight || rasterSliceAlfPad;\par
00210 \}\par
