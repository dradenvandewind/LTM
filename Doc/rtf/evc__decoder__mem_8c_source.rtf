00103 {\cf17 static} {\cf18 void} print_stat(EVCD_STAT * stat, {\cf18 int} ret)\par
00104 \{\par
00105     {\cf18 int} i, j;\par
00106 \par
00107     {\cf19 if}(EVC_SUCCEEDED(ret))\par
00108     \{\par
00109         {\cf19 if}(stat->nalu_type < EVC_SPS_NUT)\par
00110         \{\par
00111             v1print({\cf22 "%c-slice"}, stat->stype == EVC_ST_I ? {\cf23 'I'} : stat->stype == EVC_ST_P ? {\cf22 'P'} : {\cf22 'B'});\par
00112 \par
00113             v1print({\cf22 " (%d bytes"}, stat->read);\par
00114             v1print({\cf22 ", poc=%d, tid=%d, "}, ({\cf18 int})stat->poc, ({\cf18 int})stat->tid);\par
00115 \par
00116             {\cf19 for} (i = 0; i < 2; i++)\par
00117             \{\par
00118                 v1print({\cf22 "[L%d "}, i);\par
00119                 {\cf19 for} (j = 0; j < stat->refpic_num[i]; j++) v1print({\cf22 "%d "}, stat->refpic[i][j]);\par
00120                 v1print({\cf22 "] "});\par
00121             \}\par
00122         \}\par
00123         {\cf19 else} {\cf19 if}(stat->nalu_type == EVC_SPS_NUT)\par
00124         \{\par
00125             v1print({\cf22 "Sequence Parameter Set (%d bytes)"}, stat->read);\par
00126         \}\par
00127         {\cf19 else} {\cf19 if} (stat->nalu_type == EVC_PPS_NUT)\par
00128         \{\par
00129             v1print({\cf22 "Picture Parameter Set (%d bytes)"}, stat->read);\par
00130         \}\par
00131         {\cf19 else} {\cf19 if} (stat->nalu_type == EVC_APS_NUT)\par
00132         \{\par
00133             v1print({\cf22 "Adaptation Parameter Set (%d bytes)"}, stat->read);\par
00134         \}\par
00135         {\cf19 else} {\cf19 if} (stat->nalu_type == EVC_SEI_NUT)\par
00136         \{\par
00137             v1print({\cf22 "SEI message: "});\par
00138             {\cf19 if} (ret == EVC_OK)\par
00139             \{\par
00140                 v1print({\cf22 "MD5 check OK"});\par
00141             \}\par
00142             {\cf19 else} {\cf19 if} (ret == EVC_ERR_BAD_CRC)\par
00143             \{\par
00144                 v1print({\cf22 "MD5 check mismatch!"});\par
00145             \}\par
00146             {\cf19 else} {\cf19 if} (ret == EVC_WARN_CRC_IGNORED)\par
00147             \{\par
00148                 v1print({\cf22 "MD5 check ignored!"});\par
00149             \}\par
00150         \}\par
00151         {\cf19 else}\par
00152         \{\par
00153             v0print({\cf22 "Unknown bitstream"});\par
00154         \}\par
00155 \par
00156         v1print({\cf22 "\\n"});\par
00157 \par
