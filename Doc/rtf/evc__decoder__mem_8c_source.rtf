00475 {\cf17 static} {\cf18 int} imgb_write_mem({\cf17 const} evc_writer_t *writer, EVC_IMGB * img)\par
00476 \{\par
00477     {\cf18 unsigned} {\cf18 char} * p8;\par
00478     {\cf18 int}             i, j, bd;\par
00479 \par
00480     {\cf19 if}(img->cs == EVC_COLORSPACE_YUV420_10LE)\par
00481     \{\par
00482         bd = 2;\par
00483     \}\par
00484     {\cf19 else} {\cf19 if}(img->cs == EVC_COLORSPACE_YUV420)\par
00485     \{\par
00486         bd = 1;\par
00487     \}\par
00488     {\cf19 else}\par
00489     \{\par
00490         print({\cf22 "cannot support the color space\\n"});\par
00491         {\cf19 return} -1;\par
00492     \}\par
00493 \par
00494     writer->output_begin_fn(writer->data, bd == 2, img->w[0], img->h[0]);\par
00495 \par
00496     {\cf19 for}(i = 0; i < 3; i++)\par
00497     \{\par
00498         p8 = ({\cf18 unsigned} {\cf18 char} *)img->a[i] + (img->s[i] * img->y[i]) + (img->x[i] * bd);\par
00499 \par
00500         {\cf19 for}(j = 0; j < img->h[i]; j++)\par
00501         \{\par
00502             writer->output_write_fn(writer->data, p8, img->w[i] * bd);\par
00503             p8 += img->s[i];\par
00504         \}\par
00505     \}\par
00506     writer->output_end_fn(writer->data);\par
00507     {\cf19 return} 0;\par
00508 \}\par
