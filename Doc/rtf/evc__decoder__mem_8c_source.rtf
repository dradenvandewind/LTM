00214 {\cf18 int} evc_decode_mem({\cf17 const} uint8_t *stream, {\cf18 size_t} stream_size, {\cf18 unsigned} output_bit_depth, {\cf17 const} evc_writer_t *writer)\par
00215 \{\par
00216     STATES             state = STATE_DECODING;\par
00217     {\cf18 unsigned} {\cf18 char}    * bs_buf = NULL;\par
00218     EVCD              {\cf18 id} = NULL;\par
00219     EVCD_CDSC         cdsc;\par
00220     EVC_BITB          bitb;\par
00221     EVC_IMGB        * imgb;\par
00222     {\cf20 /*temporal buffer for video bit depth less than 10bit */}\par
00223     EVC_IMGB        * imgb_t = NULL;\par
00224     EVCD_STAT         stat;\par
00225     EVCD_OPL          opl;\par
00226     {\cf18 int}                ret;\par
00227     EVC_CLK           clk_beg, clk_tot;\par
00228     {\cf18 int}                bs_cnt, pic_cnt;\par
00229     {\cf18 int}                bs_size, bs_read_pos = 0;\par
00230     {\cf18 int}                w, h;\par
00231     FILE             * fp_bs = NULL;\par
00232 \par
00233 {\cf21 #if M52291_HDR_DRA}\par
00234     {\cf18 int} sps_dra_enable_flag = 0;\par
00235     {\cf18 int} pps_dra_enable_flag = 0;\par
00236     EVC_IMGB          *imgb_dra = NULL;\par
00237     {\cf20 // global CVS buffer for DRA control}\par
00238     SignalledParamsDRA g_dra_control_array[32];\par
00239     {\cf20 // local PU buffer for 2 types of APS data: ALF and DRA}\par
00240     evc_AlfSliceParam g_alf_control;\par
00241     evc_AlfSliceParam *p_g_alf_control = &g_alf_control;\par
00242 \par
00243     WCGDDRAControl g_dra_control_effective;\par
00244     WCGDDRAControl g_dra_control_read;\par
00245     WCGDDRAControl *p_g_dra_control_read = &g_dra_control_read;\par
00246 \par
00247     {\cf20 // Structure to keep 2 types of APS to read at PU}\par
00248     EVC_APS_GEN aps_gen_array[2];\par
00249     EVC_APS_GEN *p_aps_gen_array = &(aps_gen_array[0]);\par
00250 \par
00251     {\cf19 for} ({\cf18 int} i = 0; i < 32; i++)\par
00252     \{\par
00253         g_dra_control_array[i].m_signal_dra_flag = -1;\par
00254     \}\par
00255     g_dra_control_read.m_signalledDRA.m_signal_dra_flag = 0;\par
00256     aps_gen_array[0].aps_data = ({\cf18 void}*)p_g_alf_control;\par
00257     aps_gen_array[1].aps_data = ({\cf18 void}*)(&(g_dra_control_read.m_signalledDRA));\par
00258     evc_resetApsGenReadBuffer(p_aps_gen_array);\par
00259 {\cf21 #endif}\par
00260 \par
00261 {\cf21 #if DECODING_TIME_TEST}\par
00262     clk_beg = evc_clk_get();\par
00263 {\cf21 #endif}\par
00264 \par
00265     bs_buf = malloc(MAX_BS_BUF);\par
00266     {\cf19 if}(bs_buf == NULL)\par
00267     \{\par
00268         v0print({\cf22 "ERROR: cannot allocate bit buffer, size=%d\\n"}, MAX_BS_BUF);\par
00269         {\cf19 return} -1;\par
00270     \}\par
00271     {\cf18 id} = evcd_create(&cdsc, NULL);\par
00272     {\cf19 if}({\cf18 id} == NULL)\par
00273     \{\par
00274         v0print({\cf22 "ERROR: cannot create EVC decoder\\n"});\par
00275         {\cf19 return} -1;\par
00276     \}\par
00277     {\cf19 if}(set_extra_config({\cf18 id}))\par
00278     \{\par
00279         v0print({\cf22 "ERROR: cannot set extra configurations\\n"});\par
00280         {\cf19 return} -1;\par
00281     \}\par
00282 \par
00283     pic_cnt = 0;\par
00284     clk_tot = 0;\par
00285     bs_cnt  = 0;\par
00286     w = h   = 0;\par
00287 \par
00288     {\cf18 int} process_status = EVC_OK;\par
00289 \par
00290     {\cf19 while}(1)\par
00291     \{\par
00292         {\cf19 if} (state == STATE_DECODING)\par
00293         \{\par
00294             evc_mset(&stat, 0, {\cf17 sizeof}(EVCD_STAT));\par
00295 \par
00296             bs_size = read_nalu(stream, stream_size, bs_read_pos, bs_buf, MAX_BS_BUF);\par
00297             {\cf18 int} nalu_size_field_in_bytes = 4;\par
00298 \par
00299             {\cf19 if} (bs_size <= 0)\par
00300             \{\par
00301                 state = STATE_BUMPING;\par
00302                 v1print({\cf22 "bumping process starting...\\n"});\par
00303                 {\cf19 continue};\par
00304             \}\par
00305 \par
00306             bs_read_pos += (nalu_size_field_in_bytes + bs_size);\par
00307             stat.read += nalu_size_field_in_bytes;\par
00308             bitb.addr = bs_buf;\par
00309             bitb.ssize = bs_size;\par
00310             bitb.bsize = MAX_BS_BUF;\par
00311 \par
00312             v1print({\cf22 "[%4d] NALU --> "}, bs_cnt++);\par
00313 {\cf21 #if !DECODING_TIME_TEST}\par
00314             clk_beg = evc_clk_get();\par
00315 {\cf21 #endif}\par
00316             {\cf20 /* main decoding block */}\par
00317 {\cf21 #if M52291_HDR_DRA}\par
00318             ret = evcd_decode({\cf18 id}, &bitb, &stat, ({\cf18 void}*)(p_aps_gen_array), ({\cf18 void}*) (&(g_dra_control_array[0])));\par
00319             sps_dra_enable_flag = evcd_get_sps_dra_flag({\cf18 id});\par
00320             {\cf19 if} (sps_dra_enable_flag)\par
00321             \{\par
00322                 {\cf20 // check if new DRA APS recieved, update buffer}\par
00323                 {\cf19 if} ((p_aps_gen_array + 1)->aps_id != -1)\par
00324                 \{\par
00325                     evc_addDraApsToBuffer(&(g_dra_control_array[0]), p_aps_gen_array);\par
00326                 \}\par
00327                 {\cf20 // Assigned effective DRA controls as specified by PPS}\par
00328                 {\cf18 int} pps_dra_id = evcd_get_pps_dra_id({\cf18 id});\par
00329                 {\cf19 if} ((pps_dra_id > -1) && (pps_dra_id < 32))\par
00330                 \{\par
00331                     memcpy(&(g_dra_control_effective.m_signalledDRA), &(g_dra_control_array[pps_dra_id]), {\cf17 sizeof}(SignalledParamsDRA));\par
00332                     g_dra_control_effective.m_flagEnabled = 1;\par
00333                     evcd_assign_pps_draParam({\cf18 id}, &(g_dra_control_effective.m_signalledDRA));\par
00334                 \}\par
00335                 {\cf19 else}\par
00336                 \{\par
00337                     g_dra_control_effective.m_flagEnabled = 0;\par
00338                     g_dra_control_effective.m_signalledDRA.m_signal_dra_flag = 0;\par
00339                 \}\par
00340             \}\par
00341 {\cf21 #else}\par
00342             ret = evcd_decode({\cf18 id}, &bitb, &stat);\par
00343 {\cf21 #endif}\par
00344 \par
00345             {\cf19 if}(EVC_FAILED(ret))\par
00346             \{\par
00347                 v0print({\cf22 "failed to decode bitstream\\n"});\par
00348                 {\cf19 goto} END;\par
00349             \}\par
00350 \par
00351 {\cf21 #if !DECODING_TIME_TEST}\par
00352             clk_tot += evc_clk_from(clk_beg);\par
00353 {\cf21 #endif}\par
00354                 print_stat(&stat, ret);\par
00355             {\cf19 if}(stat.read - nalu_size_field_in_bytes != bs_size)\par
00356             \{\par
00357                 v0print({\cf22 "\\t=> different reading of bitstream (in:%d, read:%d)\\n"},\par
00358                     bs_size, stat.read);\par
00359             \}\par
00360 \par
00361             process_status = ret;\par
00362         \}\par
00363         {\cf19 if}(stat.fnum >= 0 || state == STATE_BUMPING)\par
00364         \{\par
00365             ret = evcd_pull({\cf18 id}, &imgb, &opl);\par
00366             {\cf19 if}(ret == EVC_ERR_UNEXPECTED)\par
00367             \{\par
00368                 v1print({\cf22 "bumping process completed\\n"});\par
00369                 {\cf19 goto} END;\par
00370             \}\par
00371             {\cf19 else} {\cf19 if}(EVC_FAILED(ret))\par
00372             \{\par
00373                 v0print({\cf22 "failed to pull the decoded image\\n"});\par
00374                 {\cf19 return} -1;\par
00375             \}\par
00376         \}\par
00377         {\cf19 else}\par
00378         \{\par
00379             imgb = NULL;\par
00380         \}\par
00381 \par
00382         {\cf19 if}(imgb)\par
00383         \{\par
00384             w = imgb->w[0];\par
00385             h = imgb->h[0];\par
00386 \par
00387             {\cf19 if}(writer)\par
00388             \{\par
00389                 {\cf19 if}(op_out_bit_depth == 8 && imgb_t == NULL)\par
00390                 \{\par
00391                     imgb_t = imgb_alloc(w, h, EVC_COLORSPACE_YUV420);\par
00392                     {\cf19 if}(imgb_t == NULL)\par
00393                     \{\par
00394                         v0print({\cf22 "failed to allocate temporay image buffer\\n"});\par
00395                         {\cf19 return} -1;\par
00396                     \}\par
00397                 \}\par
00398 {\cf21 #if M52291_HDR_DRA}\par
00399                 pps_dra_enable_flag = evcd_get_pps_dra_flag({\cf18 id});\par
00400                 {\cf19 if} ( (sps_dra_enable_flag == 1) && (pps_dra_enable_flag == 1) )\par
00401                 \{\par
00402                     {\cf20 // Assigned effective DRA controls as specified by PPS}\par
00403                     {\cf18 int} pps_dra_id = evcd_get_pps_dra_id({\cf18 id});\par
00404                     assert((pps_dra_id > -1) && (pps_dra_id < 32) && (g_dra_control_array[pps_dra_id].m_signal_dra_flag == 1));\par
00405                     memcpy(&(g_dra_control_effective.m_signalledDRA), &(g_dra_control_array[pps_dra_id]), {\cf17 sizeof}(SignalledParamsDRA));\par
00406                     evcd_assign_pps_draParam({\cf18 id}, &(g_dra_control_effective.m_signalledDRA));\par
00407 \par
00408                     {\cf19 if} (g_dra_control_effective.m_flagEnabled)\par
00409                     \{\par
00410                         evcd_initDRA(&g_dra_control_effective);\par
00411                     \}\par
00412                     {\cf19 if} (g_dra_control_effective.m_flagEnabled)\par
00413                     \{\par
00414                         {\cf18 int} align[EVC_IMGB_MAX_PLANE] = \{ MIN_CU_SIZE, MIN_CU_SIZE >> 1, MIN_CU_SIZE >> 1 \};\par
00415                         {\cf18 int} pad[EVC_IMGB_MAX_PLANE] = \{ 0, 0, 0, \};\par
00416                         imgb_dra = evc_imgb_create(w, h, EVC_COLORSPACE_YUV420_10LE, 0, pad, align);\par
00417                         {\cf19 if} (imgb_dra == NULL)\par
00418                         \{\par
00419                             v0print({\cf22 "Cannot get original image buffer (DRA)\\n"});\par
00420                             {\cf19 return} -1;\par
00421                         \}\par
00422                         imgb_cpy(imgb_dra, imgb);\par
00423                         evc_apply_dra_chroma_plane(imgb, imgb, &g_dra_control_effective, 1, TRUE{\cf20 /*backwardMapping == true*/});\par
00424                         evc_apply_dra_chroma_plane(imgb, imgb, &g_dra_control_effective, 2, TRUE {\cf20 /*backwardMapping == true*/});\par
00425                         evc_apply_dra_luma_plane(imgb, imgb, &g_dra_control_effective, 0, TRUE {\cf20 /*backwardMapping == true*/});\par
00426                         write_dec_img(writer, {\cf18 id}, op_fname_out, imgb, imgb_t);\par
00427                         imgb_cpy(imgb, imgb_dra);\par
00428                         imgb_dra->release(imgb_dra);\par
00429                     \}\par
00430                     {\cf19 else}\par
00431                         write_dec_img(writer, {\cf18 id}, op_fname_out, imgb, imgb_t);\par
00432                 \}{\cf19 else}\par
00433                     write_dec_img(writer, {\cf18 id}, op_fname_out, imgb, imgb_t);\par
00434 {\cf21 #else}\par
00435                 write_dec_img(writer, {\cf18 id}, op_fname_out, imgb, imgb_t);\par
00436 {\cf21 #endif}\par
00437             \}\par
00438             imgb->release(imgb);\par
00439             pic_cnt++;\par
00440         \}\par
00441         fflush(stdout);\par
00442         fflush(stderr);\par
00443     \}\par
00444 \par
00445 END:\par
00446 {\cf21 #if DECODING_TIME_TEST}\par
00447     clk_tot += evc_clk_from(clk_beg);\par
00448 {\cf21 #endif}\par
00449     v1print({\cf22 "=======================================================================================\\n"});\par
00450     v1print({\cf22 "Resolution                        = %d x %d\\n"}, w, h);\par
00451     v1print({\cf22 "Processed NALUs                   = %d\\n"}, bs_cnt);\par
00452     v1print({\cf22 "Decoded frame count               = %d\\n"}, pic_cnt);\par
00453     {\cf19 if}(pic_cnt > 0)\par
00454     \{\par
00455         v1print({\cf22 "total decoding time               = %d msec,"},\par
00456                 ({\cf18 int})evc_clk_msec(clk_tot));\par
00457         v1print({\cf22 " %.3f sec\\n"},\par
00458             ({\cf18 float})(evc_clk_msec(clk_tot) /1000.0));\par
00459 \par
00460         v1print({\cf22 "Average decoding time for a frame = %d msec\\n"},\par
00461                 ({\cf18 int})evc_clk_msec(clk_tot)/pic_cnt);\par
00462         v1print({\cf22 "Average decoding speed            = %.3f frames/sec\\n"},\par
00463                 (({\cf18 float})pic_cnt*1000)/(({\cf18 float})evc_clk_msec(clk_tot)));\par
00464     \}\par
00465     v1print({\cf22 "=======================================================================================\\n"});\par
00466 \par
00467     {\cf19 if}({\cf18 id}) evcd_delete({\cf18 id});\par
00468     {\cf19 if}(imgb_t) imgb_free(imgb_t);\par
00469     {\cf19 if}(fp_bs) fclose(fp_bs);\par
00470     {\cf19 if}(bs_buf) free(bs_buf);\par
00471 \par
00472     {\cf19 return} process_status;\par
00473 \}\par
