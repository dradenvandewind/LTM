01191                      bPackedYUVOutputMode ? 1 : 0))\par
01192     \{\par
01193       retval={\cf17 false};\par
01194     \}\par
01195   \}\par
01196   m_writer->picture_end();\par
01197 \par
01198   {\cf19 return} retval;\par
01199 \}\par
