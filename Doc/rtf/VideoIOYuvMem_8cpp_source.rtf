00731 {\cf17 static} {\cf18 bool} writeField(VideoIOYuvMem::Writer *writer, {\cf17 const} Pel* top, {\cf17 const} Pel* bottom,\par
00732                        {\cf17 const} {\cf18 bool} is16bit,\par
00733                        {\cf17 const} uint32_t stride_src,\par
00734                        uint32_t width444, uint32_t height444,\par
00735                        {\cf17 const} ComponentID compID,\par
00736                        {\cf17 const} ChromaFormat srcFormat,\par
00737                        {\cf17 const} ChromaFormat fileFormat,\par
00738                        {\cf17 const} uint32_t fileBitDepth, {\cf17 const} {\cf18 bool} isTff,\par
00739                        {\cf17 const} uint32_t packedYUVOutputMode = 0)\par
00740 \{\par
00741   {\cf17 const} uint32_t csx_file =getComponentScaleX(compID, fileFormat);\par
00742   {\cf17 const} uint32_t csy_file =getComponentScaleY(compID, fileFormat);\par
00743   {\cf17 const} uint32_t csx_src  =getComponentScaleX(compID, srcFormat);\par
00744   {\cf17 const} uint32_t csy_src  =getComponentScaleY(compID, srcFormat);\par
00745 \par
00746   {\cf17 const} uint32_t width_file  = width444  >> csx_file;\par
00747   {\cf17 const} uint32_t height_file = height444 >> csy_file;\par
00748   {\cf17 const} {\cf18 bool}     writePYUV   = (packedYUVOutputMode > 0) && (fileBitDepth == 10 || fileBitDepth == 12) && ((width_file & (1 + (fileBitDepth & 3))) == 0);\par
00749   {\cf17 const} uint32_t stride_file = writePYUV ? (width444 * fileBitDepth) >> (csx_file + 3) : (width444 * (is16bit ? 2 : 1)) >> csx_file;\par
00750 \par
00751   std::vector<uint8_t> bufVec(stride_file * 2);\par
00752   uint8_t *buf=&(bufVec[0]);\par
00753 \par
00754   {\cf19 if} (writePYUV)\par
00755   \{\par
00756     {\cf20 // TODO}\par
00757   \}\par
00758   {\cf19 else} {\cf20 // !writePYUV}\par
00759   {\cf19 if} (compID!=COMPONENT_Y && (fileFormat==CHROMA_400 || srcFormat==CHROMA_400))\par
00760   \{\par
00761     {\cf19 if} (fileFormat!=CHROMA_400)\par
00762     \{\par
00763       {\cf17 const} uint32_t value = 1 << (fileBitDepth - 1);\par
00764 \par
00765       {\cf19 for} (uint32_t y = 0; y < height_file; y++)\par
00766       \{\par
00767         {\cf19 for} (uint32_t field = 0; field < 2; field++)\par
00768         \{\par
00769           uint8_t *fieldBuffer = buf + (field * stride_file);\par
00770 \par
00771           {\cf19 if} (!is16bit)\par
00772           \{\par
00773             uint8_t val(value);\par
00774             {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00775             \{\par
00776               fieldBuffer[x]=val;\par
00777             \}\par
00778           \}\par
00779           {\cf19 else}\par
00780           \{\par
00781             uint16_t val(value);\par
00782             {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00783             \{\par
00784               fieldBuffer[2*x  ]= (val>>0) & 0xff;\par
00785               fieldBuffer[2*x+1]= (val>>8) & 0xff;\par
00786             \}\par
00787           \}\par
00788         \}\par
00789 \par
00790         writer->write(buf, (stride_file * 2));\par
00791 {\cf20 //        if (fd.eof() || fd.fail() )}\par
00792 {\cf20 //        \{}\par
00793 {\cf20 //          return false;}\par
00794 {\cf20 //        \}}\par
00795       \}\par
00796     \}\par
00797   \}\par
00798   {\cf19 else}\par
00799   \{\par
00800     {\cf17 const} uint32_t mask_y_file=(1<<csy_file)-1;\par
00801     {\cf17 const} uint32_t mask_y_src =(1<<csy_src )-1;\par
00802     {\cf19 for}(uint32_t y444=0; y444<height444; y444++)\par
00803     \{\par
00804       {\cf19 if} ((y444&mask_y_file)==0)\par
00805       \{\par
00806         {\cf19 for} (uint32_t field = 0; field < 2; field++)\par
00807         \{\par
00808           uint8_t *fieldBuffer = buf + (field * stride_file);\par
00809           {\cf17 const} Pel *src     = (((field == 0) && isTff) || ((field == 1) && (!isTff))) ? top : bottom;\par
00810 \par
00811           {\cf20 // write a new line}\par
00812           {\cf19 if} (csx_file < csx_src)\par
00813           \{\par
00814             {\cf20 // eg file is 444, source is 422.}\par
00815             {\cf17 const} uint32_t sx=csx_src-csx_file;\par
00816             {\cf19 if} (!is16bit)\par
00817             \{\par
00818               {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00819               \{\par
00820                 fieldBuffer[x] = (uint8_t)(src[x>>sx]);\par
00821               \}\par
00822             \}\par
00823             {\cf19 else}\par
00824             \{\par
00825               {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00826               \{\par
00827                 fieldBuffer[2*x  ] = (src[x>>sx]>>0) & 0xff;\par
00828                 fieldBuffer[2*x+1] = (src[x>>sx]>>8) & 0xff;\par
00829               \}\par
00830             \}\par
00831           \}\par
00832           {\cf19 else}\par
00833           \{\par
00834             {\cf20 // eg file is 422, src is 444.}\par
00835             {\cf17 const} uint32_t sx=csx_file-csx_src;\par
00836             {\cf19 if} (!is16bit)\par
00837             \{\par
00838               {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00839               \{\par
00840                 fieldBuffer[x] = (uint8_t)(src[x<<sx]);\par
00841               \}\par
00842             \}\par
00843             {\cf19 else}\par
00844             \{\par
00845               {\cf19 for} (uint32_t x = 0; x < width_file; x++)\par
00846               \{\par
00847                 fieldBuffer[2*x  ] = (src[x<<sx]>>0) & 0xff;\par
00848                 fieldBuffer[2*x+1] = (src[x<<sx]>>8) & 0xff;\par
00849               \}\par
00850             \}\par
00851           \}\par
00852         \}\par
00853 \par
00854         writer->write(buf, (stride_file * 2));\par
00855 {\cf20 //        if (fd.eof() || fd.fail() )}\par
00856 {\cf20 //        \{}\par
00857 {\cf20 //          return false;}\par
00858 {\cf20 //        \}}\par
00859       \}\par
00860 \par
00861       {\cf19 if} ((y444&mask_y_src)==0)\par
00862       \{\par
00863         top    += stride_src;\par
00864         bottom += stride_src;\par
00865       \}\par
00866 \par
00867     \}\par
00868   \}\par
00869   {\cf19 return} {\cf17 true};\par
00870 \}\par
