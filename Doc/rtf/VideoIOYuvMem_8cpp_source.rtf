00189 {\cf18 void} VideoIOYuvMem::skipFrames({\cf18 int} numFrames, uint32_t width, uint32_t height, ChromaFormat format)\par
00190 {\cf21 #else}\par
00191 {\cf18 void} VideoIOYuvMem::skipFrames(uint32_t numFrames, uint32_t width, uint32_t height, ChromaFormat format)\par
00192 {\cf21 #endif}\par
00193 \{\par
00194   {\cf19 if} (!numFrames)\par
00195   \{\par
00196     {\cf19 return};\par
00197   \}\par
00198 \par
00199   {\cf20 //------------------}\par
00200   {\cf20 //set the frame size according to the chroma format}\par
00201   streamoff frameSize = 0;\par
00202   uint32_t wordsize=1; {\cf20 // default to 8-bit, unless a channel with more than 8-bits is detected.}\par
00203   {\cf19 for} (uint32_t component = 0; component < getNumberValidComponents(format); component++)\par
