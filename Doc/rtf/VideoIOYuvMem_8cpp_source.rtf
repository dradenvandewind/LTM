00069 {\cf17 static} {\cf18 void} scalePlane( PelBuf& areaBuf, {\cf17 const} {\cf18 int} shiftbits, {\cf17 const} Pel minval, {\cf17 const} Pel maxval)\par
00070 \{\par
00071   {\cf17 const} {\cf18 unsigned} width  = areaBuf.width;\par
00072   {\cf17 const} {\cf18 unsigned} height = areaBuf.height;\par
00073   {\cf17 const} {\cf18 unsigned} stride = areaBuf.stride;\par
00074         Pel*        img = areaBuf.bufAt(0,0);\par
00075 \par
00076   {\cf19 if}( 0 == shiftbits )\par
00077   \{\par
00078     {\cf19 return};\par
00079   \}\par
00080 \par
00081   {\cf19 if}( shiftbits > 0)\par
00082   \{\par
00083     {\cf19 for}( {\cf18 unsigned} y = 0; y < height; y++, img+=stride)\par
00084     \{\par
00085       {\cf19 for}( {\cf18 unsigned} x = 0; x < width; x++)\par
00086       \{\par
00087         img[x] <<= shiftbits;\par
00088       \}\par
00089     \}\par
00090   \}\par
00091   {\cf19 else} {\cf19 if} (shiftbits < 0)\par
00092   \{\par
00093     {\cf17 const} {\cf18 int} shiftbitsr =- shiftbits;\par
00094     {\cf17 const} Pel rounding = 1 << (shiftbitsr-1);\par
00095 \par
00096     {\cf19 for}( {\cf18 unsigned} y = 0; y < height; y++, img+=stride)\par
00097     \{\par
00098       {\cf19 for}( {\cf18 unsigned} x = 0; x < width; x++)\par
00099       \{\par
00100         img[x] = Clip3(minval, maxval, Pel((img[x] + rounding) >> shiftbitsr));\par
00101       \}\par
00102     \}\par
00103   \}\par
00104 \}\par
00105 \par
