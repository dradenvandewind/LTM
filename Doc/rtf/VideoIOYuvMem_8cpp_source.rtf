01202 {\cf20 // static member}\par
01203 {\cf18 void} VideoIOYuvMem::ColourSpaceConvert({\cf17 const} CPelUnitBuf &src, PelUnitBuf &dest, {\cf17 const} InputColourSpaceConversion conversion, {\cf18 bool} bIsForwards)\par
01204 \{\par
01205   {\cf17 const} ChromaFormat  format       = src.chromaFormat;\par
01206   {\cf17 const} uint32_t          numValidComp = ::getNumberValidComponents(format);\par
01207 \par
01208   {\cf19 switch} (conversion)\par
01209   \{\par
01210     {\cf19 case} IPCOLOURSPACE_YCbCrtoYYY:\par
01211       {\cf19 if} (format!=CHROMA_444)\par
01212       \{\par
01213         {\cf20 // only 444 is handled.}\par
01214         CHECK( format != CHROMA_444, {\cf22 "Chroma format other than 444 not supported"} );\par
01215       \}\par
01216 \par
01217       \{\par
01218         {\cf19 for}(uint32_t comp=0; comp<numValidComp; comp++)\par
01219         \{\par
01220           dest.get( ComponentID(comp) ).copyFrom( src.get( ComponentID(bIsForwards?0:comp) ) );\par
01221         \}\par
01222       \}\par
01223       {\cf19 break};\par
01224     {\cf19 case} IPCOLOURSPACE_YCbCrtoYCrCb:\par
01225       \{\par
01226         {\cf19 for}(uint32_t comp=0; comp<numValidComp; comp++)\par
01227         \{\par
01228           dest.get( ComponentID((numValidComp-comp)%numValidComp) ).copyFrom( src.get( ComponentID(comp) ) );\par
01229         \}\par
01230       \}\par
01231       {\cf19 break};\par
01232 \par
01233     {\cf19 case} IPCOLOURSPACE_RGBtoGBR:\par
01234       \{\par
01235         {\cf19 if} (format!=CHROMA_444)\par
01236         \{\par
01237           {\cf20 // only 444 is handled.}\par
01238           CHECK(format!=CHROMA_444, {\cf22 "Chroma format other than 444 not supported"});\par
01239         \}\par
01240 \par
01241         {\cf20 // channel re-mapping}\par
01242         {\cf19 for}(uint32_t comp=0; comp<numValidComp; comp++)\par
01243         \{\par
01244           {\cf17 const} ComponentID compIDsrc=ComponentID((comp+1)%numValidComp);\par
01245           {\cf17 const} ComponentID compIDdst=ComponentID(comp);\par
01246 \par
01247           dest.get( bIsForwards?compIDdst:compIDsrc ).copyFrom( src.get( bIsForwards?compIDsrc:compIDdst ) );\par
01248         \}\par
01249       \}\par
01250       {\cf19 break};\par
01251 \par
01252     {\cf19 case} IPCOLOURSPACE_UNCHANGED:\par
01253     {\cf19 default}:\par
01254       \{\par
01255         {\cf19 for}(uint32_t comp=0; comp<numValidComp; comp++)\par
01256         \{\par
01257           dest.get( ComponentID(comp) ).copyFrom( src.get( ComponentID(comp) ) );\par
01258         \}\par
01259       \}\par
01260       {\cf19 break};\par
01261   \}\par
01262 \}\par
01263 \par
01264 {\cf18 bool} VideoIOYuvMem::writeUpscaledPicture( {\cf17 const} SPS& sps, {\cf17 const} PPS& pps, {\cf17 const} CPelUnitBuf& pic, {\cf17 const} InputColourSpaceConversion ipCSC, {\cf17 const} {\cf18 bool} bPackedYUVOutputMode, {\cf18 int} outputChoice, ChromaFormat format, {\cf17 const} {\cf18 bool} bClipToRec709 )\par
01265 \{\par
01266   ChromaFormat chromaFormatIDC = sps.getChromaFormatIdc();\par
01267   {\cf18 bool} ret = {\cf17 false};\par
01268 \par
01269   {\cf17 static} Window confFullResolution;\par
01270   {\cf17 static} Window afterScaleWindowFullResolution;\par
01271 \par
01272   {\cf20 // decoder does not have information about upscaled picture scaling and conformance windows, store this information when full resolution picutre is encountered}\par
01273   {\cf19 if}( sps.getMaxPicWidthInLumaSamples() == pps.getPicWidthInLumaSamples() && sps.getMaxPicHeightInLumaSamples() == pps.getPicHeightInLumaSamples() )\par
01274   \{\par
01275     afterScaleWindowFullResolution = pps.getScalingWindow();\par
01276     afterScaleWindowFullResolution = pps.getConformanceWindow();\par
01277   \}\par
01278 \par
01279   {\cf19 if}( outputChoice && ( sps.getMaxPicWidthInLumaSamples() != pic.get( COMPONENT_Y ).width || sps.getMaxPicHeightInLumaSamples() != pic.get( COMPONENT_Y ).height ) )\par
01280   \{\par
01281     {\cf19 if}( outputChoice == 2 )\par
01282     \{\par
01283       PelStorage upscaledPic;\par
01284       upscaledPic.create( chromaFormatIDC, Area( Position(), Size( sps.getMaxPicWidthInLumaSamples(), sps.getMaxPicHeightInLumaSamples() ) ) );\par
01285 \par
01286       {\cf18 int} curPicWidth = sps.getMaxPicWidthInLumaSamples()   - SPS::getWinUnitX( sps.getChromaFormatIdc() ) * ( afterScaleWindowFullResolution.getWindowLeftOffset() + afterScaleWindowFullResolution.getWindowRightOffset() );\par
01287       {\cf18 int} curPicHeight = sps.getMaxPicHeightInLumaSamples() - SPS::getWinUnitY( sps.getChromaFormatIdc() ) * ( afterScaleWindowFullResolution.getWindowTopOffset()  + afterScaleWindowFullResolution.getWindowBottomOffset() );\par
01288 \par
01289       {\cf17 const} Window& beforeScalingWindow = pps.getScalingWindow();\par
01290       {\cf18 int} refPicWidth = pps.getPicWidthInLumaSamples()   - SPS::getWinUnitX( sps.getChromaFormatIdc() ) * ( beforeScalingWindow.getWindowLeftOffset() + beforeScalingWindow.getWindowRightOffset() );\par
01291       {\cf18 int} refPicHeight = pps.getPicHeightInLumaSamples() - SPS::getWinUnitY( sps.getChromaFormatIdc() ) * ( beforeScalingWindow.getWindowTopOffset()  + beforeScalingWindow.getWindowBottomOffset() );\par
01292 \par
01293       {\cf18 int} xScale = ( ( refPicWidth << SCALE_RATIO_BITS ) + ( curPicWidth >> 1 ) ) / curPicWidth;\par
01294       {\cf18 int} yScale = ( ( refPicHeight << SCALE_RATIO_BITS ) + ( curPicHeight >> 1 ) ) / curPicHeight;\par
01295 \par
01296       Picture::rescalePicture( std::pair<int, int>( xScale, yScale ), pic, pps.getScalingWindow(), upscaledPic, afterScaleWindowFullResolution, chromaFormatIDC, sps.getBitDepths(), {\cf17 false}, {\cf17 false}, sps.getHorCollocatedChromaFlag(), sps.getVerCollocatedChromaFlag() );\par
01297 \par
01298       ret = write( sps.getMaxPicWidthInLumaSamples(), sps.getMaxPicHeightInLumaSamples(), upscaledPic,\par
01299         ipCSC,\par
01300         bPackedYUVOutputMode,\par
01301         confFullResolution.getWindowLeftOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01302         confFullResolution.getWindowRightOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01303         confFullResolution.getWindowTopOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01304         confFullResolution.getWindowBottomOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01305         NUM_CHROMA_FORMAT, bClipToRec709, {\cf17 false} );\par
01306     \}\par
01307     {\cf19 else}\par
01308     \{\par
01309       {\cf17 const} Window &conf = pps.getConformanceWindow();\par
01310 \par
01311       ret = write( sps.getMaxPicWidthInLumaSamples(), sps.getMaxPicHeightInLumaSamples(), pic,\par
01312         ipCSC,\par
01313         bPackedYUVOutputMode,\par
01314         conf.getWindowLeftOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01315         conf.getWindowRightOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01316         conf.getWindowTopOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01317         conf.getWindowBottomOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01318         NUM_CHROMA_FORMAT, bClipToRec709, {\cf17 false} );\par
01319     \}\par
01320   \}\par
01321   {\cf19 else}\par
01322   \{\par
01323     {\cf17 const} Window &conf = pps.getConformanceWindow();\par
01324 \par
01325     ret = write( pic.get( COMPONENT_Y ).width, pic.get( COMPONENT_Y ).height, pic,\par
01326       ipCSC,\par
01327       bPackedYUVOutputMode,\par
01328       conf.getWindowLeftOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01329       conf.getWindowRightOffset() * SPS::getWinUnitX( chromaFormatIDC ),\par
01330       conf.getWindowTopOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01331       conf.getWindowBottomOffset() * SPS::getWinUnitY( chromaFormatIDC ),\par
01332       NUM_CHROMA_FORMAT, bClipToRec709 );\par
01333   \}\par
01334 \par
01335   {\cf19 return} ret;\par
01336 \}\par
}
