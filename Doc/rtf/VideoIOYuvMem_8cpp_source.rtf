00888 {\cf18 bool} VideoIOYuvMem::read ( PelUnitBuf& pic, PelUnitBuf& picOrg, {\cf17 const} InputColourSpaceConversion ipcsc, {\cf18 int} aiPad[2], ChromaFormat format, {\cf17 const} {\cf18 bool} bClipToRec709 )\par
00889 \{\par
00890   {\cf20 // check end-of-file}\par
00891   {\cf19 if} ( isEof() )\par
00892   \{\par
00893     {\cf19 return} {\cf17 false};\par
00894   \}\par
00895 \par
00896   {\cf19 if} (format >= NUM_CHROMA_FORMAT)\par
00897   \{\par
00898     format = picOrg.chromaFormat;\par
00899   \}\par
00900 \par
00901   {\cf18 bool} is16bit = {\cf17 false};\par
00902 \par
00903   {\cf19 for}(uint32_t ch=0; ch<MAX_NUM_CHANNEL_TYPE; ch++)\par
00904   \{\par
00905     {\cf19 if} (m_fileBitdepth[ch] > 8)\par
00906     \{\par
00907       is16bit={\cf17 true};\par
00908     \}\par
00909   \}\par
00910 \par
00911   {\cf17 const} PelBuf areaBufY = picOrg.get(COMPONENT_Y);\par
00912 {\cf21 #if !EXTENSION_360_VIDEO}\par
00913   {\cf17 const} uint32_t stride444      = areaBufY.stride;\par
00914 {\cf21 #endif}\par
00915   {\cf20 // compute actual YUV width & height excluding padding size}\par
00916   {\cf17 const} uint32_t pad_h444       = aiPad[0];\par
00917   {\cf17 const} uint32_t pad_v444       = aiPad[1];\par
00918 \par
00919   {\cf17 const} uint32_t width_full444  = areaBufY.width;\par
00920   {\cf17 const} uint32_t height_full444 = areaBufY.height;\par
00921 \par
00922   {\cf17 const} uint32_t width444       = width_full444 - pad_h444;\par
00923   {\cf17 const} uint32_t height444      = height_full444 - pad_v444;\par
00924 \par
00925   {\cf19 for}( uint32_t comp=0; comp < ::getNumberValidComponents(format); comp++)\par
00926   \{\par
00927     {\cf17 const} ComponentID compID = ComponentID(comp);\par
00928     {\cf17 const} ChannelType chType=toChannelType(compID);\par
00929 \par
00930     {\cf17 const} {\cf18 int} desired_bitdepth = m_MSBExtendedBitDepth[chType] + m_bitdepthShift[chType];\par
00931 \par
00932     {\cf17 const} {\cf18 bool} b709Compliance=(bClipToRec709) && (m_bitdepthShift[chType] < 0 && desired_bitdepth >= 8);     {\cf20 /* ITU-R BT.709 compliant clipping for converting say 10b to 8b */}\par
00933     {\cf17 const} Pel minval = b709Compliance? ((   1 << (desired_bitdepth - 8))   ) : 0;\par
00934     {\cf17 const} Pel maxval = b709Compliance? ((0xff << (desired_bitdepth - 8)) -1) : (1 << desired_bitdepth) - 1;\par
00935     {\cf17 const} {\cf18 bool} processComponent = (size_t)compID < picOrg.bufs.size();\par
00936     Pel* {\cf17 const} dst = processComponent ? picOrg.get(compID).bufAt(0,0) : {\cf17 nullptr};\par
00937 {\cf21 #if EXTENSION_360_VIDEO}\par
00938     {\cf17 const} uint32_t stride444 = picOrg.get(compID).stride;\par
00939 {\cf21 #endif}\par
00940     {\cf19 if} ( ! readPlane( dst, m_cHandle, is16bit, stride444, width444, height444, pad_h444, pad_v444, compID, picOrg.chromaFormat, format, m_fileBitdepth[chType]))\par
00941     \{\par
00942       {\cf19 return} {\cf17 false};\par
00943     \}\par
00944 \par
00945     {\cf19 if} (processComponent)\par
00946     \{\par
00947       {\cf19 if} (! verifyPlane( dst, stride444, width444, height444, pad_h444, pad_v444, compID, format, m_fileBitdepth[chType]) )\par
00948       \{\par
00949          EXIT({\cf22 "Source image contains values outside the specified bit range!"});\par
00950       \}\par
00951 {\cf21 #if !JVET_R0351_HIGH_BIT_DEPTH_ENABLED}\par
00952       {\cf19 if} (m_fileBitdepth[chType] > 14 && m_bitdepthShift[chType] < 0)\par
00953       \{\par
00954         EXIT({\cf22 "JVET_R0351_HIGH_BIT_DEPTH_ENABLED must be enabled for bit depths above 14 if INTERNALBITDEPTH < INPUTBITDEPTH"});\par
00955       \}\par
00956 {\cf21 #endif}\par
00957       scalePlane( picOrg.get(compID), m_bitdepthShift[chType], minval, maxval);\par
00958     \}\par
00959   \}\par
00960 \par
00961 {\cf21 #if EXTENSION_360_VIDEO}\par
00962   {\cf19 if} (pic.chromaFormat != NUM_CHROMA_FORMAT)\par
00963     ColourSpaceConvert(picOrg, pic, ipcsc, {\cf17 true});\par
00964 {\cf21 #else}\par
00965   ColourSpaceConvert( picOrg, pic, ipcsc, {\cf17 true});\par
00966 {\cf21 #endif}\par
00967 \par
00968   picOrg.copyFrom(pic);\par
00969 \par
00970   {\cf19 return} {\cf17 true};\par
00971 \}\par
