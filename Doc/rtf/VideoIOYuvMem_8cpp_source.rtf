00127 {\cf18 void} VideoIOYuvMem::open(Writer *writer, {\cf18 bool} bWriteMode, {\cf17 const} {\cf18 int} fileBitDepth[MAX_NUM_CHANNEL_TYPE], {\cf17 const} {\cf18 int} MSBExtendedBitDepth[MAX_NUM_CHANNEL_TYPE], {\cf17 const} {\cf18 int} internalBitDepth[MAX_NUM_CHANNEL_TYPE] )\par
00128 \{\par
00129   {\cf20 //NOTE: files cannot have bit depth greater than 16}\par
00130   {\cf19 for}(uint32_t ch=0; ch<MAX_NUM_CHANNEL_TYPE; ch++)\par
00131   \{\par
00132     m_fileBitdepth       [ch] = std::min<uint32_t>(fileBitDepth[ch], 16);\par
00133     m_MSBExtendedBitDepth[ch] = MSBExtendedBitDepth[ch];\par
00134     m_bitdepthShift      [ch] = internalBitDepth[ch] - m_MSBExtendedBitDepth[ch];\par
00135 \par
00136     {\cf19 if} (m_fileBitdepth[ch] > 16)\par
00137     \{\par
00138       {\cf19 if} (bWriteMode)\par
00139       \{\par
00140         std::cerr << {\cf22 "\\nWARNING: Cannot write a yuv file of bit depth greater than 16 - output will be right-shifted down to 16-bit precision\\n"} << std::endl;\par
00141       \}\par
00142       {\cf19 else}\par
00143       \{\par
00144         EXIT( {\cf22 "ERROR: Cannot read a yuv file of bit depth greater than 16"} );\par
00145       \}\par
00146     \}\par
00147   \}\par
00148 \par
00149   {\cf19 if} ( bWriteMode )\par
00150   \{\par
00151       m_writer = writer;\par
00152   \}\par
00153   {\cf19 else}\par
00154   \{\par
00155       EXIT( {\cf22 "Cannot open input YUV file"} );\par
00156 {\cf20 //    m_cHandle.open( fileName.c_str(), ios::binary | ios::in );}\par
00157 \par
00158 {\cf20 //    if( m_cHandle.fail() )}\par
00159 {\cf20 //    \{}\par
00160 {\cf20 //      EXIT( "Failed to open input YUV file: " << fileName.c_str() );}\par
00161 {\cf20 //    \}}\par
00162   \}\par
00163 \par
00164   {\cf19 return};\par
00165 \}\par
