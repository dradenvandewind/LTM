01230 {\cf17 template}<{\cf17 typename} T>\par
01231 {\cf17 class }dynamic_cache\par
01232 \{\par
01233   std::vector<T*> m_cache;\par
01234 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01235   int64_t         m_cacheId;\par
01236 {\cf21 #endif}\par
01237 \par
01238 {\cf17 public}:\par
01239 \par
01240 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01241   dynamic_cache()\par
01242   \{\par
01243     {\cf17 static} {\cf18 int} cacheId = 0;\par
01244     m_cacheId = cacheId++;\par
01245   \}\par
01246 \par
01247 {\cf21 #endif}\par
01248   ~dynamic_cache()\par
01249   \{\par
01250     deleteEntries();\par
01251   \}\par
01252 \par
01253   {\cf18 void} deleteEntries()\par
01254   \{\par
01255     {\cf19 for}( {\cf17 auto} &p : m_cache )\par
01256     \{\par
01257       {\cf17 delete} p;\par
01258       p = {\cf17 nullptr};\par
01259     \}\par
01260 \par
01261     m_cache.clear();\par
01262   \}\par
01263 \par
01264   T* get()\par
01265   \{\par
01266     T* ret;\par
01267 \par
01268     {\cf19 if}( !m_cache.empty() )\par
01269     \{\par
01270       ret = m_cache.back();\par
01271       m_cache.pop_back();\par
01272 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01273       CHECK( ret->cacheId != m_cacheId, {\cf22 "Putting item into wrong cache!"} );\par
01274       CHECK( !ret->cacheUsed,           {\cf22 "Fetched an element that should've been in cache!!"} );\par
01275 {\cf21 #endif}\par
01276     \}\par
01277     {\cf19 else}\par
01278     \{\par
01279       ret = {\cf17 new} T;\par
01280     \}\par
01281 \par
01282 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01283     ret->cacheId   = m_cacheId;\par
01284     ret->cacheUsed = {\cf17 false};\par
01285 \par
01286 {\cf21 #endif}\par
01287     {\cf19 return} ret;\par
01288   \}\par
01289 \par
01290   {\cf18 void} cache( T* el )\par
01291   \{\par
01292 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01293     CHECK( el->cacheId != m_cacheId, {\cf22 "Putting item into wrong cache!"} );\par
01294     CHECK( el->cacheUsed,            {\cf22 "Putting cached item back into cache!"} );\par
01295 \par
01296     el->cacheUsed = {\cf17 true};\par
01297 \par
01298 {\cf21 #endif}\par
01299     m_cache.push_back( el );\par
01300   \}\par
01301 \par
01302   {\cf18 void} cache( std::vector<T*>& vel )\par
01303   \{\par
01304 {\cf21 #if ENABLE_SPLIT_PARALLELISM}\par
01305     {\cf19 for}( {\cf17 auto} el : vel )\par
01306     \{\par
01307       CHECK( el->cacheId != m_cacheId, {\cf22 "Putting item into wrong cache!"} );\par
01308       CHECK( el->cacheUsed,            {\cf22 "Putting cached item back into cache!"} );\par
01309 \par
01310       el->cacheUsed = {\cf17 true};\par
01311     \}\par
01312 \par
01313 {\cf21 #endif}\par
01314     m_cache.insert( m_cache.end(), vel.begin(), vel.end() );\par
01315     vel.clear();\par
01316   \}\par
01317 \};\par
