01190   iterator        insert( const_iterator _pos, {\cf17 const} T& _val )\par
01191                                                 \{ CHECKD( _size >= N, {\cf22 "capacity exceeded"} );\par
01192                                                   {\cf19 for}( difference_type i = _size - 1; i >= _pos - _arr; i-- ) _arr[i + 1] = _arr[i];\par
01193                                                   *{\cf17 const_cast<}iterator{\cf17 >}( _pos ) = _val;\par
