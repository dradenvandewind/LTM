01206                                                   {\cf19 for}( difference_type i = _size - 1; i >= _pos - _arr; i-- ) _arr[i + numEl] = _arr[i];\par
01207                                                   iterator it = {\cf17 const_cast<}iterator{\cf17 >}( _pos ); _size += numEl;\par
