01197   iterator        insert( const_iterator _pos, T&& _val )\par
01198                                                 \{ CHECKD( _size >= N, {\cf22 "capacity exceeded"} );\par
01199                                                   {\cf19 for}( difference_type i = _size - 1; i >= _pos - _arr; i-- ) _arr[i + 1] = _arr[i];\par
01200                                                   *{\cf17 const_cast<}iterator{\cf17 >}( _pos ) = std::forward<T>( _val );\par
