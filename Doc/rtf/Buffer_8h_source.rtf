00609 {\cf17 template}<{\cf17 typename} T>\par
00610 {\cf18 void} AreaBuf<T>::extendBorderPel( {\cf18 unsigned} margin )\par
00611 \{\par
00612   T*  p = buf;\par
00613   {\cf18 int} h = height;\par
00614   {\cf18 int} w = width;\par
00615   {\cf18 int} s = stride;\par
00616 \par
00617   CHECK( ( w + 2 * margin ) > s, {\cf22 "Size of buffer too small to extend"} );\par
00618   {\cf20 // do left and right margins}\par
00619   {\cf19 for}( {\cf18 int} y = 0; y < h; y++ )\par
00620   \{\par
00621     {\cf19 for}( {\cf18 int} x = 0; x < margin; x++ )\par
00622     \{\par
00623       *( p - margin + x ) = p[0];\par
00624       p[w + x] = p[w - 1];\par
00625     \}\par
00626     p += s;\par
00627   \}\par
00628 \par
00629   {\cf20 // p is now the (0,height) (bottom left of image within bigger picture}\par
00630   p -= ( s + margin );\par
00631   {\cf20 // p is now the (-margin, height-1)}\par
00632   {\cf19 for}( {\cf18 int} y = 0; y < margin; y++ )\par
00633   \{\par
00634     ::memcpy( p + ( y + 1 ) * s, p, {\cf17 sizeof}( T ) * ( w + ( margin << 1 ) ) );\par
00635   \}\par
00636 \par
00637   {\cf20 // pi is still (-marginX, height-1)}\par
00638   p -= ( ( h - 1 ) * s );\par
00639   {\cf20 // pi is now (-marginX, 0)}\par
00640   {\cf19 for}( {\cf18 int} y = 0; y < margin; y++ )\par
00641   \{\par
00642     ::memcpy( p - ( y + 1 ) * s, p, {\cf17 sizeof}( T ) * ( w + ( margin << 1 ) ) );\par
00643   \}\par
00644 \}\par
