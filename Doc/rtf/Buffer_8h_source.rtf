00240 {\cf18 void} AreaBuf<T>::fill({\cf17 const} T &val)\par
00241 \{\par
00242   {\cf19 if}( {\cf17 sizeof}( T ) == 1 )\par
00243   \{\par
00244     {\cf19 if}( width == stride )\par
00245     \{\par
00246       ::memset( buf, {\cf17 reinterpret_cast<} {\cf17 const }{\cf18 signed} {\cf18 char}& {\cf17 >}( val ), width * height * {\cf17 sizeof}( T ) );\par
00247     \}\par
00248     {\cf19 else}\par
00249     \{\par
00250       T* dest = buf;\par
00251       {\cf18 size_t} line = width * {\cf17 sizeof}( T );\par
00252 \par
00253       {\cf19 for}( {\cf18 unsigned} y = 0; y < height; y++ )\par
00254       \{\par
00255         ::memset( dest, {\cf17 reinterpret_cast<} {\cf17 const }{\cf18 signed} {\cf18 char}& {\cf17 >}( val ), line );\par
00256 \par
00257         dest += stride;\par
00258       \}\par
00259     \}\par
00260   \}\par
00261   {\cf19 else} {\cf19 if}( T( 0 ) == val )\par
00262   \{\par
00263     {\cf19 if}( width == stride )\par
00264     \{\par
00265       ::memset( buf, 0, width * height * {\cf17 sizeof}( T ) );\par
00266     \}\par
00267     {\cf19 else}\par
00268     \{\par
00269       T* dest = buf;\par
00270       {\cf18 size_t} line = width * {\cf17 sizeof}( T );\par
00271 \par
00272       {\cf19 for}( {\cf18 unsigned} y = 0; y < height; y++ )\par
00273       \{\par
00274         ::memset( dest, 0, line );\par
00275 \par
00276         dest += stride;\par
00277       \}\par
00278     \}\par
00279   \}\par
00280   {\cf19 else}\par
00281   \{\par
00282     T* dest = buf;\par
00283 \par
00284 {\cf21 #define FILL_INC        dest      += stride}\par
00285 {\cf21 #define FILL_OP( ADDR ) dest[ADDR] = val}\par
00286 \par
00287     SIZE_AWARE_PER_EL_OP( FILL_OP, FILL_INC );\par
00288 \par
00289 {\cf21 #undef FILL_INC}\par
00290 {\cf21 #undef FILL_OP}\par
00291   \}\par
00292 \}\par
