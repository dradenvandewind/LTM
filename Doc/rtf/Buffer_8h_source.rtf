00315 {\cf17 template}<{\cf17 typename} T>\par
00316 {\cf18 void} AreaBuf<T>::copyFrom( {\cf17 const} AreaBuf<const T> &other )\par
00317 \{\par
00318 {\cf21 #if !defined(__GNUC__) || __GNUC__ > 5}\par
00319   {\cf17 static_assert}( std::is_trivially_copyable<T>::value, {\cf22 "Type T is not trivially_copyable"} );\par
00320 {\cf21 #endif}\par
00321 \par
00322   CHECK( width  != other.width,  {\cf22 "Incompatible size"} );\par
00323   CHECK( height != other.height, {\cf22 "Incompatible size"} );\par
00324 \par
00325   {\cf19 if}( buf == other.buf )\par
00326   \{\par
00327     {\cf19 return};\par
00328   \}\par
00329 \par
00330   {\cf19 if}( width == stride && stride == other.stride )\par
00331   \{\par
00332     memcpy( buf, other.buf, width * height * {\cf17 sizeof}( T ) );\par
00333   \}\par
00334   {\cf19 else}\par
00335   \{\par
00336           T* dst         = buf;\par
00337     {\cf17 const} T* src         = other.buf;\par
00338     {\cf17 const} {\cf18 unsigned} srcStride = other.stride;\par
00339 \par
00340     {\cf19 for}( {\cf18 unsigned} y = 0; y < height; y++ )\par
00341     \{\par
00342       memcpy( dst, src, width * {\cf17 sizeof}( T ) );\par
00343 \par
00344       dst += stride;\par
00345       src += srcStride;\par
00346     \}\par
00347   \}\par
00348 \}\par
