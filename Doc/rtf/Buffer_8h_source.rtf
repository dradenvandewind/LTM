00178 {\cf21 #define SIZE_AWARE_PER_EL_OP( OP, INC )                     \\}\par
00179 {\cf21 if( ( width & 7 ) == 0 )                                    \\}\par
00180 {\cf21 \{                                                           \\}\par
00181 {\cf21   for( int y = 0; y < height; y++ )                         \\}\par
00182 {\cf21   \{                                                         \\}\par
00183 {\cf21     for( int x = 0; x < width; x += 8 )                     \\}\par
00184 {\cf21     \{                                                       \\}\par
00185 {\cf21       OP( x + 0 );                                          \\}\par
00186 {\cf21       OP( x + 1 );                                          \\}\par
00187 {\cf21       OP( x + 2 );                                          \\}\par
00188 {\cf21       OP( x + 3 );                                          \\}\par
00189 {\cf21       OP( x + 4 );                                          \\}\par
00190 {\cf21       OP( x + 5 );                                          \\}\par
00191 {\cf21       OP( x + 6 );                                          \\}\par
00192 {\cf21       OP( x + 7 );                                          \\}\par
00193 {\cf21     \}                                                       \\}\par
00194 {\cf21                                                             \\}\par
00195 {\cf21     INC;                                                    \\}\par
00196 {\cf21   \}                                                         \\}\par
00197 {\cf21 \}                                                           \\}\par
00198 {\cf21 else if( ( width & 3 ) == 0 )                               \\}\par
00199 {\cf21 \{                                                           \\}\par
00200 {\cf21   for( int y = 0; y < height; y++ )                         \\}\par
00201 {\cf21   \{                                                         \\}\par
00202 {\cf21     for( int x = 0; x < width; x += 4 )                     \\}\par
00203 {\cf21     \{                                                       \\}\par
00204 {\cf21       OP( x + 0 );                                          \\}\par
00205 {\cf21       OP( x + 1 );                                          \\}\par
00206 {\cf21       OP( x + 2 );                                          \\}\par
00207 {\cf21       OP( x + 3 );                                          \\}\par
00208 {\cf21     \}                                                       \\}\par
00209 {\cf21                                                             \\}\par
00210 {\cf21     INC;                                                    \\}\par
00211 {\cf21   \}                                                         \\}\par
00212 {\cf21 \}                                                           \\}\par
00213 {\cf21 else if( ( width & 1 ) == 0 )                               \\}\par
00214 {\cf21 \{                                                           \\}\par
00215 {\cf21   for( int y = 0; y < height; y++ )                         \\}\par
00216 {\cf21   \{                                                         \\}\par
00217 {\cf21     for( int x = 0; x < width; x += 2 )                     \\}\par
00218 {\cf21     \{                                                       \\}\par
00219 {\cf21       OP( x + 0 );                                          \\}\par
00220 {\cf21       OP( x + 1 );                                          \\}\par
00221 {\cf21     \}                                                       \\}\par
00222 {\cf21                                                             \\}\par
00223 {\cf21     INC;                                                    \\}\par
00224 {\cf21   \}                                                         \\}\par
00225 {\cf21 \}                                                           \\}\par
00226 {\cf21 else                                                        \\}\par
00227 {\cf21 \{                                                           \\}\par
00228 {\cf21   for( int y = 0; y < height; y++ )                         \\}\par
00229 {\cf21   \{                                                         \\}\par
00230 {\cf21     for( int x = 0; x < width; x++ )                        \\}\par
00231 {\cf21     \{                                                       \\}\par
00232 {\cf21       OP( x );                                              \\}\par
00233 {\cf21     \}                                                       \\}\par
00234 {\cf21                                                             \\}\par
00235 {\cf21     INC;                                                    \\}\par
00236 {\cf21   \}                                                         \\}\par
