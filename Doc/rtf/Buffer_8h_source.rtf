00533 {\cf17 template}<{\cf17 typename} T>\par
00534 {\cf18 void} AreaBuf<T>::extendBorderPel({\cf18 unsigned} marginX, {\cf18 unsigned} marginY)\par
00535 \{\par
00536   T* p = buf;\par
00537   {\cf18 int} h = height;\par
00538   {\cf18 int} w = width;\par
00539   {\cf18 int} s = stride;\par
00540 \par
00541   CHECK((w + 2 * marginX) > s, {\cf22 "Size of buffer too small to extend"});\par
00542   {\cf20 // do left and right margins}\par
00543   {\cf19 for} ({\cf18 int} y = 0; y < h; y++)\par
00544   \{\par
00545     {\cf19 for} ({\cf18 int} x = 0; x < marginX; x++)\par
00546     \{\par
00547       *(p - marginX + x) = p[0];\par
00548       p[w + x] = p[w - 1];\par
00549     \}\par
00550     p += s;\par
00551   \}\par
00552 \par
00553   {\cf20 // p is now the (0,height) (bottom left of image within bigger picture}\par
00554   p -= (s + marginX);\par
00555   {\cf20 // p is now the (-margin, height-1)}\par
00556   {\cf19 for} ({\cf18 int} y = 0; y < marginY; y++)\par
00557   \{\par
00558     ::memcpy(p + (y + 1) * s, p, {\cf17 sizeof}(T) * (w + (marginX << 1)));\par
00559   \}\par
00560 \par
00561   {\cf20 // p is still (-marginX, height-1)}\par
00562   p -= ((h - 1) * s);\par
00563   {\cf20 // p is now (-marginX, 0)}\par
00564   {\cf19 for} ({\cf18 int} y = 0; y < marginY; y++)\par
00565   \{\par
00566     ::memcpy(p - (y + 1) * s, p, {\cf17 sizeof}(T) * (w + (marginX << 1)));\par
00567   \}\par
00568 \}\par
