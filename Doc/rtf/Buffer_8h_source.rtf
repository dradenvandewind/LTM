00570 {\cf17 template}<{\cf17 typename} T>\par
00571 {\cf18 void} AreaBuf<T>::padBorderPel( {\cf18 unsigned} marginX, {\cf18 unsigned} marginY, {\cf18 int} dir )\par
00572 \{\par
00573   T*  p = buf;\par
00574   {\cf18 int} s = stride;\par
00575   {\cf18 int} h = height;\par
00576   {\cf18 int} w = width;\par
00577 \par
00578   CHECK( w  > s, {\cf22 "Size of buffer too small to extend"} );\par
00579 \par
00580   {\cf20 // top-left margin}\par
00581   {\cf19 if} ( dir == 1 )\par
00582   \{\par
00583     {\cf19 for}( {\cf18 int} y = 0; y < marginY; y++ )\par
00584     \{\par
00585       {\cf19 for}( {\cf18 int} x = 0; x < marginX; x++ )\par
00586       \{\par
00587         p[x] = p[marginX];\par
00588       \}\par
00589       p += s;\par
00590     \}\par
00591   \}\par
00592 \par
00593   {\cf20 // bottom-right margin}\par
00594   {\cf19 if} ( dir == 2 )\par
00595   \{\par
00596     p = buf + s * ( h - marginY ) + w - marginX;\par
00597 \par
00598     {\cf19 for}( {\cf18 int} y = 0; y < marginY; y++ )\par
00599     \{\par
00600       {\cf19 for}( {\cf18 int} x = 0; x < marginX; x++ )\par
00601       \{\par
00602         p[x] = p[-1];\par
00603       \}\par
00604       p += s;\par
00605     \}\par
00606   \}\par
00607 \}\par
