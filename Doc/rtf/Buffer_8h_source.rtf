00420 {\cf18 void} AreaBuf<T>::removeWeightHighFreq({\cf17 const} AreaBuf<T>& other, {\cf17 const} {\cf18 bool} bClip, {\cf17 const} ClpRng& clpRng, {\cf17 const} int8_t bcwWeight)\par
00421 \{\par
00422   {\cf17 const} int8_t bcwWeightOther = g_BcwWeightBase - bcwWeight;\par
00423   {\cf17 const} int8_t log2WeightBase = g_BcwLog2WeightBase;\par
00424 \par
00425   {\cf17 const} Pel* src = other.buf;\par
00426   {\cf17 const} {\cf18 int}  srcStride = other.stride;\par
00427 \par
00428   Pel* dst = buf;\par
00429   {\cf17 const} {\cf18 int}  dstStride = stride;\par
00430 \par
00431 {\cf21 #if ENABLE_SIMD_OPT_BCW}\par
00432   {\cf19 if}(!bClip)\par
00433   \{\par
00434     {\cf19 if}(!(width & 7))\par
00435       g_pelBufOP.removeWeightHighFreq8(dst, dstStride, src, srcStride, width, height, 16, bcwWeight);\par
00436     {\cf19 else} {\cf19 if}(!(width & 3))\par
00437       g_pelBufOP.removeWeightHighFreq4(dst, dstStride, src, srcStride, width, height, 16, bcwWeight);\par
00438     {\cf19 else}\par
00439       CHECK({\cf17 true}, {\cf22 "Not supported"});\par
00440   \}\par
00441   {\cf19 else}\par
00442   \{\par
00443 {\cf21 #endif}\par
00444     Intermediate_Int normalizer = ((1 << 16) + (bcwWeight > 0 ? (bcwWeight >> 1) : -(bcwWeight >> 1))) / bcwWeight;\par
00445     Intermediate_Int weight0 = normalizer << log2WeightBase;\par
00446     Intermediate_Int weight1 = bcwWeightOther * normalizer;\par
00447 {\cf21 #define REM_HF_INC  \\}\par
00448 {\cf21   src += srcStride; \\}\par
00449 {\cf21   dst += dstStride; \\}\par
00450 {\cf21 }\par
00451 {\cf21 #define REM_HF_OP_CLIP( ADDR ) dst[ADDR] = ClipPel<T>( T((dst[ADDR]*weight0 - src[ADDR]*weight1 + (1<<15))>>16), clpRng )}\par
00452 {\cf21 #define REM_HF_OP( ADDR )      dst[ADDR] =             T((dst[ADDR]*weight0 - src[ADDR]*weight1 + (1<<15))>>16)}\par
00453 \par
00454     {\cf19 if}(bClip)\par
00455     \{\par
00456       SIZE_AWARE_PER_EL_OP(REM_HF_OP_CLIP, REM_HF_INC);\par
00457     \}\par
00458     {\cf19 else}\par
00459     \{\par
00460       SIZE_AWARE_PER_EL_OP(REM_HF_OP, REM_HF_INC);\par
00461     \}\par
00462 \par
00463 {\cf21 #undef REM_HF_INC}\par
00464 {\cf21 #undef REM_HF_OP}\par
00465 {\cf21 #undef REM_HF_OP_CLIP}\par
00466 {\cf21 #if ENABLE_SIMD_OPT_BCW}\par
00467   \}\par
00468 {\cf21 #endif}\par
00469 \}\par
