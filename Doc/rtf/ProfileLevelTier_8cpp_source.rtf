00163 uint32_t ProfileLevelTierFeatures::getMaxDpbSize( uint32_t picSizeMaxInSamplesY ){\cf17  const}\par
00164 {\cf17 }\{\par
00165   {\cf17 const} uint32_t maxDpbPicBuf = 8;\par
00166   uint32_t       maxDpbSize;\par
00167 \par
00168   {\cf19 if} (m_pLevelTier->level == Level::LEVEL15_5)\par
00169   \{\par
00170     {\cf20 // maxDpbSize is unconstrained in this case}\par
00171     maxDpbSize = std::numeric_limits<uint32_t>::max();\par
00172   \}\par
00173   {\cf19 else} {\cf19 if} (2 * picSizeMaxInSamplesY <= m_pLevelTier->maxLumaPs)\par
00174   \{\par
00175     maxDpbSize = 2 * maxDpbPicBuf;\par
00176   \}\par
00177   {\cf19 else} {\cf19 if} (3 * picSizeMaxInSamplesY <= 2 * m_pLevelTier->maxLumaPs)\par
00178   \{\par
00179     maxDpbSize = 3 * maxDpbPicBuf / 2;\par
00180   \}\par
00181   {\cf19 else}\par
00182   \{\par
00183     maxDpbSize = maxDpbPicBuf;\par
00184   \}\par
00185 \par
00186   {\cf19 return} maxDpbSize;\par
00187 \}\par
