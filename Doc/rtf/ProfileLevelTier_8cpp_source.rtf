00116 {\cf18 void}\par
00117 ProfileLevelTierFeatures::extractPTLInformation({\cf17 const} SPS &sps)\par
00118 \{\par
00119   {\cf17 const} ProfileTierLevel &spsPtl =*(sps.getProfileTierLevel());\par
00120 \par
00121   m_pProfile = {\cf17 nullptr};\par
00122   m_pLevelTier = {\cf17 nullptr};\par
00123   m_tier = spsPtl.getTierFlag();\par
00124 \par
00125   {\cf20 // Identify the profile from the profile Idc, and possibly other constraints.}\par
00126   {\cf19 for}(int32_t i=0; validProfiles[i].profile != Profile::NONE; i++)\par
00127   \{\par
00128     {\cf19 if} (spsPtl.getProfileIdc() == validProfiles[i].profile)\par
00129     \{\par
00130       m_pProfile = &(validProfiles[i]);\par
00131       {\cf19 break};\par
00132     \}\par
00133   \}\par
00134 \par
00135   {\cf19 if} (m_pProfile != {\cf17 nullptr})\par
00136   \{\par
00137     {\cf20 // Now identify the level:}\par
00138     {\cf17 const} LevelTierFeatures *pLTF = m_pProfile->pLevelTiersListInfo;\par
00139     {\cf17 const} Level::Name spsLevelName = spsPtl.getLevelIdc();\par
00140     {\cf19 if} (spsLevelName!=Level::LEVEL15_5 || m_pProfile->canUseLevel15p5)\par
00141     \{\par
00142       {\cf19 for}({\cf18 int} i=0; pLTF[i].level!=Level::NONE; i++)\par
00143       \{\par
00144         {\cf19 if} (pLTF[i].level == spsLevelName)\par
00145         \{\par
00146           m_pLevelTier = &(pLTF[i]);\par
00147         \}\par
00148       \}\par
00149     \}\par
00150   \}\par
00151 \}\par
