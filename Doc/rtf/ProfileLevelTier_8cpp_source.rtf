00153 {\cf18 double} ProfileLevelTierFeatures::getMinCr(){\cf17  const}\par
00154 {\cf17 }\{\par
00155   {\cf19 return} (m_pLevelTier!=0 && m_pProfile!=0) ? (m_pProfile->minCrScaleFactorx100 * m_pLevelTier->minCrBase[m_tier?1:0])/100.0 : 0.0 ;\par
00156 \}\par
