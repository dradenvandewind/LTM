\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 {\cf20 #!/usr/bin/env python3}\par
00002 {\cf20 #}\par
00003 {\cf20 # codectest.py [--encoder=<encoder>] [--decoder=<decoder>] [--test_file=<tests-csv>] [--label=<label>] [--input_dir=<dir>] [--progress=<bool>]}\par
00004 {\cf20 #}\par
00005 {\cf17 import} csv\par
00006 {\cf17 import} hashlib\par
00007 {\cf17 import} os.path\par
00008 {\cf17 import} re\par
00009 {\cf17 import} subprocess\par
00010 {\cf17 import} sys\par
00011 \par
00012 {\cf20 # Columns in CSV that are consumed by test, not by codec}\par
00013 TEST_PARAMETERS=[ {\cf22 'checksum'} ]\par
00014 \par
00015 INPUTS=[{\cf22 'input_file'}, {\cf22 'base'}, {\cf22 'base_recon'}]\par
00016 {\cf17 def }make_opt(d, k, v):\par
00017     {\cf22 """Convert key,value into a command line parameter, prefixing any inputs with input base dir."""}\par
00018     {\cf19 if} k {\cf19 in} INPUTS {\cf19 and} {\cf19 not} os.path.isabs(v):\par
00019         p = os.path.join(d, v)\par
00020     {\cf19 else}:\par
00021         p = v\par
00022     {\cf19 return} f{\cf22 "--\{k\}=\{p\}"}\par
00023 \par
00024 {\cf17 def }md5sum(filename, blocksize=65536):\par
00025     {\cf22 """}\par
00026 {\cf22     Compute MD5 checksum of named file.}\par
00027 {\cf22     """}\par
00028     hash = hashlib.md5()\par
00029     {\cf17 with} open(filename, {\cf22 "rb"}) {\cf17 as} f:\par
00030         {\cf19 for} block {\cf19 in} iter({\cf17 lambda}: f.read(blocksize), b{\cf22 ""}):\par
00031             hash.update(block)\par
00032     {\cf19 return} hash.hexdigest()\par
00033 \par
00034 IMAGE_NAME_PARAMS = [\par
00035     ({\cf22 "width"}, re.compile({\cf22 "([0-9]+)x[0-9]+"})),\par
00036     ({\cf22 "height"}, re.compile({\cf22 "[0-9]+x([0-9]+)"})),\par
00037     ({\cf22 "fps"}, re.compile({\cf22 "([0-9]+)(fps|hz)"})),\par
00038     ({\cf22 "bit_depth"}, re.compile({\cf22 "([0-9]+)(bits?|bpp)"})),\par
00039     ({\cf22 "format"}, re.compile({\cf22 "^(420p|422p|yuv|yuyv|y|)$"}))\par
00040 ]\par
00041 \par
00042 {\cf17 def }parse_filename(name):\par
00043     {\cf22 """}\par
00044 {\cf22     Extract vooya-ish image metadata from filename in form suitable for use as encoder parameters.}\par
00045 {\cf22     """}\par
00046     params = \{\}\par
00047     {\cf19 for} p {\cf19 in} name.split({\cf22 "_"}):\par
00048         {\cf19 for} n,r {\cf19 in} IMAGE_NAME_PARAMS:\par
00049             m = r.match(p)\par
00050             {\cf19 if} m:\par
00051                 params[n] = m.group(1)\par
00052 \par
00053     {\cf19 if} {\cf22 'bit_depth'} {\cf19 in} params:\par
00054         params[{\cf22 'format'}] += params.pop({\cf22 'bit_depth'})\par
00055 \par
00056     {\cf19 if} {\cf22 'format'} {\cf19 in} params {\cf19 and} params[{\cf22 'format'}].startswith({\cf22 '4'}):\par
00057         params[{\cf22 'format'}] = {\cf22 'yuv'} + params[{\cf22 'format'}]\par
00058 \par
00059     {\cf19 return} params\par
00060 \par
00061 {\cf17 def }run_subprocess(title, args, logfile, show_progress):\par
00062     {\cf22 """Run a comamnd as a subprocess - report progress and capture output (both stderr and stdout) to a log file."""}\par
00063 \par
00064     {\cf17 with} open(logfile, {\cf22 "wt"}) {\cf17 as} log:\par
00065         sys.stderr.write(f{\cf22 "    \{title\}: Start\\r"})\par
00066         {\cf19 if} show_progress:\par
00067             sys.stderr.write({\cf22 "\\r"})\par
00068         {\cf19 else}:\par
00069             sys.stderr.write({\cf22 "\\n"})\par
00070 \par
00071         print({\cf22 " "}.join(args), file=log)\par
00072 \par
00073         {\cf17 with} subprocess.Popen(args, bufsize=1, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\par
00074                               universal_newlines={\cf17 True}) {\cf17 as} p:\par
00075             {\cf19 for} n,l {\cf19 in} enumerate(p.stdout):\par
00076                 {\cf19 if} show_progress:\par
00077                     progress_indicator = {\cf22 "|/-\\\\|/-\\\\"}[n % 8]\par
00078                     sys.stderr.write(f{\cf22 "    \{title\}: \{progress_indicator\}      \\r"})\par
00079                 print(l.strip(), file=log)\par
00080 \par
00081             {\cf19 if} p.wait() != 0:\par
00082                 sys.stderr.write(f{\cf22 "    \{title\}: FAILED\\n"})\par
00083                 {\cf19 return} {\cf17 False}\par
00084 \par
00085     sys.stderr.write(f{\cf22 "    \{title\}: OK\\n"})\par
00086     {\cf19 return} {\cf17 True}\par
00087 \par
00088 {\cf17 def }run_testmodel_encode_decode(encoder, decoder, input_dir, params, label, show_progress):\par
00089     {\cf22 """}\par
00090 {\cf22     Run an encode followed by decode of given file (using given params)}\par
00091 {\cf22     Return true is recon & decoded yuv match required checksum.}\par
00092 {\cf22     """}\par
00093     basename = os.path.splitext(os.path.basename(params[{\cf22 'input_file'}]))[0]\par
00094     output = f{\cf22 "test_\{label\}"}\par
00095     args = list(map({\cf17 lambda} i: make_opt(input_dir, i[0], i[1]),\par
00096                     filter({\cf17 lambda} i: i[0] {\cf19 not} {\cf19 in} TEST_PARAMETERS {\cf19 and} i[1],\par
00097                            params.items())))\par
00098 \par
00099     sys.stderr.write(f{\cf22 "Encode/Decode Test: \{label\} \{basename\} "}\par
00100                      f{\cf22 "SW1:\{params['cq_step_width_loq_1']\} "}\par
00101                      f{\cf22 "SW2:\{params['cq_step_width_loq_0']\} "}\par
00102                      f{\cf22 "QP:\{params['qp']\}\\n"})\par
00103 \par
00104     {\cf20 # Encode}\par
00105     encoder_ok = run_subprocess(f{\cf22 "YUV Encode"}, [encoder, {\cf22 "--parameters=config_TM.json"},\par
00106                                                 {\cf22 "--output_file="}+output+{\cf22 ".lvc"},\par
00107                                                 {\cf22 "--output_recon="}+output+{\cf22 ".yuv"} ] + args,\par
00108                                 f{\cf22 "test_\{label\}_encoder.log"}, show_progress)\par
00109 \par
00110     {\cf20 # Encode recon checksum}\par
00111     encoded_checksum = md5sum(output+{\cf22 ".yuv"})\par
00112 \par
00113     {\cf20 # Decode}\par
00114     decoder_ok = run_subprocess(f{\cf22 "YUV Decode"}, [decoder, {\cf22 "--format=yuv420p"},\par
00115                                                 {\cf22 "--base_encoder="}+params[{\cf22 'base_encoder'}],\par
00116                                                 {\cf22 "--encapsulation="}+params[{\cf22 'encapsulation'}],\par
00117                                                 {\cf22 "--input_file="}+output+{\cf22 ".lvc"},\par
00118                                                 {\cf22 "--output_file="}+output+{\cf22 "_decoded.yuv"} ],\par
00119                                 f{\cf22 "test_\{label\}_decoder.log"}, show_progress)\par
00120 \par
00121     {\cf20 # Decode checksum}\par
00122     decoded_checksum = md5sum(output+{\cf22 "_decoded.yuv"})\par
00123 \par
00124     check_encode = ({\cf19 not} params[{\cf22 'checksum'}]) {\cf19 or} params[{\cf22 'checksum'}] == encoded_checksum\par
00125     check_match = encoded_checksum == decoded_checksum\par
00126 \par
00127     print({\cf22 "Encoded checksum: "}, check_encode {\cf19 and} {\cf22 "OK"} {\cf19 or} {\cf22 "FAILED"}, file=sys.stderr)\par
00128     print({\cf22 "Encoded vs decoded checksum: "}, check_match {\cf19 and} {\cf22 "OK"} {\cf19 or} {\cf22 "FAILED"}, file=sys.stderr)\par
00129     {\cf19 return} encoder_ok {\cf19 and} decoder_ok {\cf19 and} check_encode {\cf19 and} check_match\par
00130 \par
00131 {\cf17 def }run_testmodel_decode(decoder, input_dir, params, label, show_progress):\par
00132     {\cf22 """}\par
