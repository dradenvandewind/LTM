00949 \par
00950     b.u(8, additional_info.additional_info_type, {\cf22 "additional_info_type"});\par
00951     {\cf19 if} (additional_info.additional_info_type == 0) \{\par
00952         b.u(8, additional_info.payload_type, {\cf22 "payload_type"});\par
00953         INFO({\cf22 "SeiPayload"});\par
00954     \} {\cf19 else} {\cf19 if} (additional_info.additional_info_type == 1) \{\par
