00958         INFO({\cf22 "additional_info_type MUST be 0 or 1 - type = %4d"}, additional_info.additional_info_type);\par
00959         CHECK(0);\par
00960     \}\par
00961 \par
00962 {\cf21 #if BITSTREAM_DEBUG}\par
00963     fprintf(goBits, {\cf22 "@@@@ @@@@ additional_info <<<< \\n"});\par
00964     fflush(goBits);\par
00965 {\cf21 #endif}\par
00966 \}\par
