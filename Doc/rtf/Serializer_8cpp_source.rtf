00053 {\cf20 // Write a multibyte encoded uint64_t}\par
00054 {\cf20 //}\par
00055 {\cf17 static} {\cf18 void} write_multibyte_bytes(BitstreamPacker &b, uint64_t value, {\cf18 bool} more) \{\par
00056     {\cf19 if} (value > 0x7f)\par
00057         write_multibyte_bytes(b, value >> 7, {\cf17 true});\par
00058 \par
00059     b.u(1, more ? 1 : 0, {\cf22 "mb-more"});\par
00060     b.u(7, value & 0x7f, {\cf22 "mb-bits"});\par
00061 \}\par
00062 \par
00063 {\cf17 static} {\cf18 void} write_multibyte(BitstreamPacker &b, uint64_t value, {\cf17 const} std::string &label) \{\par
00064     BitstreamPacker::ScopedContextLabel l(b, label);\par
00065     write_multibyte_bytes(b, value, {\cf17 false});\par
00066 \}\par
