00604         {\cf19 case} DequantOffset_Default:\par
00605             b.u(1, 0, {\cf22 "dequant_offset_mode"});\par
00606             {\cf19 break};\par
00607         {\cf19 case} DequantOffset_ConstOffset:\par
00608             b.u(1, 1, {\cf22 "dequant_offset_mode"});\par
00609             {\cf19 break};\par
00610         {\cf19 default}:\par
00611             CHECK(0);\par
00612         \}\par
00613         b.u(7, picture_configuration.dequant_offset, {\cf22 "dequant_offset"});\par
00614     \}\par
00615 \par
00616     {\cf19 if} (picture_configuration.dithering_control) \{\par
00617         {\cf19 switch} (picture_configuration.dithering_type) \{\par
00618         {\cf19 case} Dithering_None:\par
00619             b.u(2, 0, {\cf22 "dithering_type"});\par
00620             {\cf19 break};\par
00621         {\cf19 case} Dithering_Uniform:\par
00622         {\cf19 case} Dithering_UniformFixed:\par
00623             b.u(2, 1, {\cf22 "dithering_type"});\par
00624             {\cf19 break};\par
00625         {\cf19 default}:\par
00626             CHECK(0);\par
00627         \}\par
00628         b.u(1, 0, {\cf22 "reserved"});\par
00629         {\cf19 if} (picture_configuration.dithering_type != Dithering_None)\par
00630             b.u(5, picture_configuration.dithering_strength, {\cf22 "dithering_strength"});\par
00631         {\cf19 else}\par
00632             b.u(5, 0, {\cf22 "reserved"});\par
00633     \}\par
00634 {\cf21 #if BITSTREAM_DEBUG}\par
00635     fprintf(goBits, {\cf22 "@@@@ @@@@ picture_config <<<< \\n"});\par
00636     fflush(goBits);\par
00637 {\cf21 #endif}\par
00638 \}\par
00639 \par
00640 {\cf20 // Return whether temporal layer is enabled}\par
00641 {\cf20 //}\par
00642 {\cf17 static} {\cf18 unsigned} temporal_layer_({\cf17 const} SignaledConfiguration &signaled_configuration, {\cf18 unsigned} loq) \{\par
00643     {\cf19 if} (loq == LOQ_LEVEL_2 && signaled_configuration.picture_configuration.temporal_signalling_present)\par
00644         {\cf19 return} 1;\par
00645     {\cf19 else}\par
00646         {\cf19 return} 0;\par
00647 \}\par
00648 \par
00649 {\cf20 // Number of encoded layers in bitstream - residual + temporal}\par
00650 {\cf17 static} {\cf18 unsigned} total_layers({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq) \{\par
00651     {\cf19 return} configuration.global_configuration.num_residual_layers +\par
00652            ((loq == LOQ_LEVEL_2 && configuration.picture_configuration.temporal_signalling_present) ? 1 : 0);\par
00653 \}\par
00654 \par
00655 {\cf17 static} {\cf18 unsigned} first_layer({\cf17 const} SignaledConfiguration &configuration) \{\par
00656     {\cf19 if} (configuration.picture_configuration.enhancement_enabled)\par
00657         {\cf19 return} 0;\par
00658     {\cf19 else}\par
00659         {\cf19 return} configuration.global_configuration.num_residual_layers;\par
00660 \}\par
00661 \par
00662 {\cf17 static} {\cf18 bool} is_temporal_layer({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} plane, {\cf18 unsigned} loq, {\cf18 unsigned} layer) \{\par
00663     {\cf19 return} layer == configuration.global_configuration.num_residual_layers;\par
00664 \}\par
00665 \par
00666 {\cf18 void} Serializer::emit_encoded_data({\cf17 const} SignaledConfiguration &signaled_configuration, BitstreamPacker &b,\par
00667                                    {\cf17 const} Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS], {\cf18 unsigned} num_layers) \{\par
00668     CHECK(signaled_configuration.global_configuration.tile_dimensions_type == TileDimensions_None);\par
00669 \par
00670 {\cf21 #if BITSTREAM_DEBUG}\par
00671     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data >>>> \\n"});\par
00672     fflush(goBits);\par
00673 {\cf21 #endif}\par
00674     {\cf20 // Entropy code the layers}\par
00675     {\cf18 bool} entropy_enabled[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS] = \{{\cf17 false}\};\par
00676     {\cf18 bool} rle_only[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS] = \{{\cf17 false}\};\par
00677     Packet data[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS];\par
00678 \par
00679     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < signaled_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00680         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00681             {\cf19 for} ({\cf18 unsigned} layer = first_layer(signaled_configuration); layer < total_layers(signaled_configuration, plane, loq);\par
00682                  ++layer) \{\par
00683                 {\cf20 // Entropy code symbols}\par
00684                 EncodedChunk e;\par
00685                 {\cf19 if} (!is_temporal_layer(signaled_configuration, plane, loq, layer)) \{\par
00686                     {\cf17 const} {\cf18 bool} use_tiled_encoding_order = signaled_configuration.global_configuration.temporal_enabled ||\par
00687                                                           signaled_configuration.global_configuration.tile_dimensions_type > 0;\par
00688                     {\cf19 if} (use_tiled_encoding_order) \{\par
00689                         e = EntropyEncoderResidualsTiled().process(\par
00690                             symbols[plane][loq][layer], signaled_configuration.global_configuration.transform_block_size);\par
00691                     \} {\cf19 else} \{\par
00692                         e = EntropyEncoderResiduals().process(symbols[plane][loq][layer]);\par
00693                     \}\par
00694 \par
00695                 \} {\cf19 else} \{\par
00696                     e = EntropyEncoderTemporal().process(\par
00697                         symbols[plane][loq][layer], signaled_configuration.global_configuration.transform_block_size,\par
00698                         signaled_configuration.global_configuration.temporal_tile_intra_signalling_enabled);\par
00699                 \}\par
00700                 {\cf19 if} (!e.empty()) \{\par
00701                     entropy_enabled[plane][loq][layer] = {\cf17 true};\par
00702 \par
00703                     {\cf20 // Choose smaller of prefix coded vs. raw}\par
00704                     {\cf19 if} (e.prefix.size() > e.raw.size()) \{\par
00705                         rle_only[plane][loq][layer] = {\cf17 true};\par
00706                         data[plane][loq][layer] = e.raw;\par
00707                     \} {\cf19 else} \{\par
00708                         rle_only[plane][loq][layer] = {\cf17 false};\par
00709                         data[plane][loq][layer] = e.prefix;\par
00710                     \}\par
00711                 \}\par
00712             \}\par
00713         \}\par
00714     \}\par
00715 \par
00716     {\cf20 // Emit flags}\par
00717     BitstreamPacker::ScopedContextLabel label(b, {\cf22 "encoded_data"});\par
00718 \par
00719     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < signaled_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00720         {\cf19 if} (signaled_configuration.picture_configuration.enhancement_enabled) \{\par
00721             {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00722                 {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_layers; ++layer) \{\par
00723                     b.u(1, entropy_enabled[plane][loq][layer], {\cf22 "entropy_enabled"});\par
00724                     b.u(1, rle_only[plane][loq][layer], {\cf22 "rle_only"});\par
00725                 \}\par
00726             \}\par
00727         \}\par
00728         {\cf19 if} (temporal_layer_(signaled_configuration, LOQ_LEVEL_2)) \{\par
00729             b.u(1, entropy_enabled[plane][LOQ_LEVEL_2][num_layers], {\cf22 "entropy_enabled"});\par
00730             b.u(1, rle_only[plane][LOQ_LEVEL_2][num_layers], {\cf22 "rle_only"});\par
00731         \}\par
00732     \}\par
00733 \par
00734     {\cf20 // Byte alignment}\par
00735 {\cf21 #if defined __OPT_MODULO__}\par
00736     {\cf19 while} ((b.bit_offset() & 0x07))\par
00737 {\cf21 #else}\par
00738     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00739 {\cf21 #endif}\par
00740         b.u(1, 0, {\cf22 "alignment"});\par
00741 \par
00742     {\cf20 // Emit surfaces}\par
00743     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < signaled_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00744         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00745 \par
00746             {\cf17 const} {\cf18 unsigned} n = num_layers + temporal_layer_(signaled_configuration, loq);\par
00747 \par
00748             {\cf19 for} ({\cf18 unsigned} layer = 0; layer < n; ++layer) \{\par
00749                 BitstreamPacker::ScopedContextLabel label(b, format({\cf22 "surface[%d][%d][%d]"}, plane, loq, layer));\par
00750                 {\cf19 if} (entropy_enabled[plane][loq][layer]) \{\par
00751                     write_multibyte(b, data[plane][loq][layer].size(), {\cf22 "data_size"});\par
00752                     b.bytes(data[plane][loq][layer]);\par
00753                 \}\par
00754             \}\par
00755         \}\par
00756     \}\par
00757 \par
00758 {\cf21 #if BITSTREAM_DEBUG}\par
00759     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data <<<< \\n"});\par
00760     fflush(goBits);\par
00761 {\cf21 #endif}\par
00762 \}\par
00763 \par
00764 {\cf18 void} Serializer::emit_encoded_data_tiled({\cf17 const} SignaledConfiguration &signaled_configuration, BitstreamPacker &b,\par
00765                                          {\cf17 const} Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS], {\cf18 unsigned} num_layers) \{\par
00766 \par
00767     CHECK(signaled_configuration.global_configuration.tile_dimensions_type != TileDimensions_None);\par
00768 \par
00769     Dimensions dimensions;\par
00770     dimensions.set(signaled_configuration,\par
00771                    signaled_configuration.global_configuration.resolution_width,\par
00772                    signaled_configuration.global_configuration.resolution_height);\par
00773 \par
00774 {\cf21 #if BITSTREAM_DEBUG}\par
00775     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data_tiled >>>> \\n"});\par
00776     fflush(goBits);\par
00777 {\cf21 #endif}\par
00778 \par
00779     {\cf20 // Accumulated flags and data}\par
00780     std::vector<bool> rle_only;        {\cf20 // Per layer}\par
00781     std::vector<bool> entropy_enabled; {\cf20 // Per tile}\par
00782     std::vector<Packet> chunks;        {\cf20 // Per tile}\par
00783 \par
00784     {\cf18 unsigned} num_tiles[MAX_NUM_PLANES][MAX_NUM_LOQS] = \{0\};\par
00785 \par
00786     {\cf20 // Entropy code the tiles in each layer}\par
00787     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < signaled_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00788         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00789 \par
00790             {\cf20 // All tile dimensions are in terms of transform blocks}\par
00791             {\cf17 const} {\cf18 unsigned} tile_width = dimensions.tile_width(plane, loq);\par
00792             {\cf17 const} {\cf18 unsigned} tile_height = dimensions.tile_height(plane, loq);\par
00793 \par
00794             {\cf20 // Figure out tile breakdown for this level}\par
00795             {\cf17 const} {\cf18 unsigned} width = symbols[plane][loq][0].width();\par
00796             {\cf17 const} {\cf18 unsigned} height = symbols[plane][loq][0].height();\par
00797 \par
00798             {\cf17 const} {\cf18 unsigned} tiles_x = (width + tile_width - 1) / tile_width;\par
00799             {\cf17 const} {\cf18 unsigned} tiles_y = (height + tile_height - 1) / tile_height;\par
00800 \par
00801             num_tiles[plane][loq] = tiles_x * tiles_y;\par
00802 \par
00803             {\cf19 for} ({\cf18 unsigned} layer = first_layer(signaled_configuration); layer < total_layers(signaled_configuration, plane, loq);\par
00804                  ++layer) \{\par
00805 \par
00806                 std::vector<EncodedChunk> encoded_chunks;\par
00807                 {\cf18 unsigned} layer_raw_sizes = 0;\par
00808                 {\cf18 unsigned} layer_prefix_sizes = 0;\par
00809 \par
00810                 {\cf20 // For each tile ...}\par
00811                 {\cf19 for} ({\cf18 unsigned} ty = 0; ty < tiles_y; ++ty) \{\par
00812                     {\cf19 for} ({\cf18 unsigned} tx = 0; tx < tiles_x; ++tx) \{\par
00813                         {\cf20 // Extract tile}\par
00814                         {\cf17 const} {\cf18 unsigned} tx0 = tx * tile_width;\par
00815                         {\cf17 const} {\cf18 unsigned} ty0 = ty * tile_height;\par
00816                         {\cf17 const} {\cf18 unsigned} tx1 = std::min((tx + 1) * tile_width, width);\par
00817                         {\cf17 const} {\cf18 unsigned} ty1 = std::min((ty + 1) * tile_height, height);\par
00818 \par
00819                         {\cf20 // Entropy code (raw & prefix)}\par
00820                         {\cf19 if} (!is_temporal_layer(signaled_configuration, plane, loq, layer)) \{\par
00821                             Surface tile_symbols = CropResiduals().process(symbols[plane][loq][layer], tx0, ty0, tx1, ty1);\par
00822                             encoded_chunks.push_back(EntropyEncoderResidualsTiled().process(\par
00823                                 tile_symbols, signaled_configuration.global_configuration.transform_block_size));\par
00824                         \} {\cf19 else} \{\par
00825                             Surface tile_symbols = CropTemporal().process(symbols[plane][loq][layer], tx0, ty0, tx1, ty1);\par
00826                             encoded_chunks.push_back(EntropyEncoderTemporal().process(\par
00827                                 tile_symbols, signaled_configuration.global_configuration.transform_block_size,\par
00828                                 signaled_configuration.global_configuration.temporal_tile_intra_signalling_enabled));\par
00829                         \}\par
00830                         {\cf20 // Accumalate raw/prefix sizes for each layer}\par
00831                         layer_raw_sizes += encoded_chunks.back().raw.size();\par
00832                         layer_prefix_sizes += encoded_chunks.back().prefix.size();\par
00833 \par
00834                         {\cf20 // Accumalate entropy_enabled for each tile}\par
00835                         CHECK((encoded_chunks.back().raw.size() == 0) == (encoded_chunks.back().prefix.size() == 0));\par
00836                         entropy_enabled.push_back(encoded_chunks.back().raw.size() > 0);\par
00837                     \}\par
00838                 \}\par
00839                 {\cf20 // Decide rle_only for layer based on accumulated sizes}\par
00840                 {\cf17 const} {\cf18 bool} r = layer_raw_sizes < layer_prefix_sizes;\par
00841                 rle_only.push_back(r);\par
00842                 {\cf20 // Accumulate chosen packets}\par
00843                 {\cf19 for} ({\cf17 auto} ec : encoded_chunks)\par
00844                     chunks.push_back(r ? ec.raw : ec.prefix);\par
00845             \}\par
00846         \}\par
00847     \}\par
00848 \par
00849     CHECK(chunks.size() == entropy_enabled.size());\par
00850 \par
00851     BitstreamPacker::ScopedContextLabel label(b, {\cf22 "encoded_data_tiled"});\par
00852 \par
00853     {\cf19 for} ({\cf17 auto} r : rle_only)\par
00854         b.u(1, r, {\cf22 "rle_only"});\par
00855 \par
00856         {\cf20 // Byte alignment}\par
00857 {\cf21 #if defined __OPT_MODULO__}\par
00858     {\cf19 while} ((b.bit_offset() & 0x07))\par
00859 #{\cf19 else}\par
00860     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00861 #endif\par
00862         b.u(1, 0, {\cf22 "alignment"});\par
00863 \par
00864     {\cf20 // Emit per tile entropy_enabled}\par
00865     {\cf19 if} (!signaled_configuration.global_configuration.compression_type_entropy_enabled_per_tile) \{\par
00866         {\cf20 // Don't compress entropy_enabled flags}\par
00867         {\cf19 for} ({\cf17 auto} r : entropy_enabled)\par
00868             b.u(1, r, {\cf22 "entropy_enabled"});\par
00869     \} {\cf19 else} \{\par
00870         {\cf20 // Prefix code the entropy_enabled flags}\par
00871         {\cf17 const} Surface ee = Surface::build_from<uint8_t>()\par
00872                                .generate({\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(entropy_enabled.size()), 1,\par
00873                                          [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{ return entropy_enabled[x]; \})\par
00874                                .finish();\par
00875         b.bytes(EntropyEncoderFlags().process(ee).raw);\par
00876     \}\par
00877 \par
00878     {\cf20 // Byte alignment}\par
00879 {\cf21 #if defined __OPT_MODULO__}\par
00880     {\cf19 while} ((b.bit_offset() & 0x07))\par
00881 {\cf21 #else}\par
00882     {\cf19 while} ((b.bit_offset() % 8 != 0))\par
00883 {\cf21 #endif}\par
00884         b.u(1, 0, {\cf22 "alignment"});\par
00885 \par
00886     {\cf19 if} (signaled_configuration.global_configuration.compression_type_size_per_tile == CompressionType_None) \{\par
00887         {\cf20 // Don't compress tile sizes}\par
00888         {\cf19 for} ({\cf18 unsigned} c = 0; c < chunks.size(); ++c) \{\par
00889             {\cf19 if} (entropy_enabled[c]) \{\par
00890                 CHECK(chunks[c].size() > 0);\par
00891                 write_multibyte(b, chunks[c].size(), {\cf22 "data_size"});\par
00892                 b.bytes(chunks[c]);\par
00893             \}\par
00894         \}\par
00895     \} {\cf19 else} \{\par
00896         {\cf20 // Prefix code each layer's tile sizes}\par
00897         {\cf18 unsigned} idx = 0;\par
00898         {\cf19 for} ({\cf18 unsigned} plane = 0; plane < signaled_configuration.global_configuration.num_processed_planes; ++plane) \{\par
00899             {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00900                 {\cf19 for} ({\cf18 unsigned} layer = first_layer(signaled_configuration); layer < total_layers(signaled_configuration, plane, loq);\par
00901                      ++layer) \{\par
00902 \par
00903                     {\cf20 // Does any tile contain data?}\par
00904                     {\cf18 bool} any_tile_enabled = {\cf17 false};\par
00905                     {\cf19 for} ({\cf18 unsigned} x = 0; x < num_tiles[plane][loq]; x++) \{\par
00906                         {\cf19 if} (entropy_enabled[idx + x]) \{\par
00907                             any_tile_enabled = {\cf17 true};\par
00908                             {\cf19 break};\par
00909                         \}\par
00910                     \}\par
00911 \par
00912                     {\cf19 if} (any_tile_enabled) \{\par
00913                         {\cf20 // Collect tile sizes for this layer - optionally converting to deltas}\par
00914                         {\cf17 auto} sb = Surface::build_from<uint16_t>();\par
00915                         sb.generate(num_tiles[plane][loq], 1,\par
00916                                     [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{ {\cf19 return} chunks[idx + x].size(); \});\par
00917                         {\cf17 const} Surface sz = sb.finish();\par
00918 \par
00919                         {\cf20 // Prefix code and emit them}\par
00920                         b.bytes(EntropyEncoderSizes()\par
00921                                     .process(sz, entropy_enabled, idx,\par
00922                                              signaled_configuration.global_configuration.compression_type_size_per_tile)\par
00923                                     .prefix);\par
00924                         {\cf20 // Emit tiles}\par
00925                         {\cf19 for} ({\cf18 unsigned} t = 0; t < num_tiles[plane][loq]; ++t)\par
00926                             {\cf19 if} (chunks[idx + t].size() > 0)\par
00927                                 b.bytes(chunks[idx + t]);\par
00928                     \}\par
00929 \par
00930                     idx += num_tiles[plane][loq];\par
00931                 \}\par
00932             \}\par
00933         \}\par
00934     \}\par
00935 \par
00936 {\cf21 #if BITSTREAM_DEBUG}\par
00937     fprintf(goBits, {\cf22 "@@@@ @@@@ encoded_data_tiled >>>> \\n"});\par
00938     fflush(goBits);\par
00939 {\cf21 #endif}\par
00940 \}\par
00941 \par
00942 {\cf18 void} Serializer::emit_additional_info({\cf17 const} AdditionalInfo &additional_info, BitstreamPacker &b) \{\par
00943 {\cf21 #if BITSTREAM_DEBUG}\par
00944     fprintf(goBits, {\cf22 "@@@@ @@@@ additional_info >>>> \\n"});\par
00945     fflush(goBits);\par
00946 {\cf21 #endif}\par
