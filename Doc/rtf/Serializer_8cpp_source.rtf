00082 Packet Serializer::emit({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} block_mask,\par
00083                         {\cf17 const} Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS]) \{\par
00084     BitstreamPacker bitstream;\par
00085 \par
00086     {\cf19 for} ({\cf18 unsigned} b = SyntaxBlock_Sequence; b <= SyntaxBlock_Filler; b <<= 1) \{\par
00087         {\cf19 if} (block_mask & b) \{\par
00088             Packet p = emit_block(configuration, b, symbols);\par
00089             bitstream.bytes(p);\par
00090         \}\par
00091     \}\par
00092 \par
00093     {\cf19 return} bitstream.finish();\par
00094 \}\par
00095 \par
00096 Packet Serializer::emit_block({\cf17 const} SignaledConfiguration &configuration, {\cf18 unsigned} block,\par
00097                               {\cf17 const} Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS]) \{\par
00098 \par
00099     {\cf17 const} {\cf18 unsigned} num_residual_layers = configuration.global_configuration.num_residual_layers;\par
00100 \par
00101     {\cf20 // Emit block into a packet}\par
00102     {\cf20 //}\par
00103     BitstreamPacker contents_bitstream;\par
00104 \par
00105     {\cf18 unsigned} payload_type\{\};\par
00106 \par
00107     {\cf19 switch} (block) \{\par
00108     {\cf19 case} SyntaxBlock_Sequence:\par
00109         emit_sequence_configuration(configuration.sequence_configuration, contents_bitstream);\par
00110         payload_type = 0;\par
00111         {\cf19 break};\par
00112 \par
00113     {\cf19 case} SyntaxBlock_Global:\par
00114         emit_global_configuration(configuration.global_configuration, contents_bitstream);\par
00115         payload_type = 1;\par
00116         {\cf19 break};\par
00117 \par
00118     {\cf19 case} SyntaxBlock_Picture:\par
00119         emit_picture_configuration(configuration.picture_configuration, contents_bitstream, num_residual_layers);\par
00120         payload_type = 2;\par
00121         {\cf19 break};\par
00122 \par
00123     {\cf19 case} SyntaxBlock_EncodedData:\par
00124         emit_encoded_data(configuration, contents_bitstream, symbols, num_residual_layers);\par
00125         payload_type = 3;\par
00126         {\cf19 break};\par
00127 \par
00128     {\cf19 case} SyntaxBlock_EncodedData_Tiled:\par
00129         emit_encoded_data_tiled(configuration, contents_bitstream, symbols, num_residual_layers);\par
00130         payload_type = 4;\par
00131         {\cf19 break};\par
00132 \par
00133     {\cf19 case} SyntaxBlock_Additional_Info:\par
00134         INFO({\cf22 "emit_additional_info"});\par
00135         emit_additional_info(configuration.additional_info, contents_bitstream);\par
00136         payload_type = 5;\par
00137         {\cf19 break};\par
00138 \par
00139 {\cf20         /***}\par
00140 {\cf20     case SyntaxBlock_Additional_Info:}\par
00141 {\cf20         emit_additional_info(contents_bitstream);}\par
00142 {\cf20         payload_type = 6;}\par
00143 {\cf20         break;}\par
00144 {\cf20         ***/}\par
00145 \par
00146     {\cf19 case} SyntaxBlock_Filler:\par
