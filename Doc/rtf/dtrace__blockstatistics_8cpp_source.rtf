00108 {\cf18 void} CDTrace::dtrace_block_scalar( {\cf18 int} k, {\cf17 const} CodingStructure &cs, std::string stat_type, {\cf18 signed} value )\par
00109 \{\par
00110 {\cf21 #if BLOCK_STATS_AS_CSV}\par
00111   dtrace<false>( k, {\cf22 "BlockStat;%d;%4d;%4d;%2d;%2d;%s;%d\\n"}, cs.picture->poc, cs.area.lx(), cs.area.ly(), cs.area.lwidth(), cs.area.lheight(), stat_type.c_str(), value );\par
00112 {\cf21 #else}\par
00113   dtrace<false>( k, {\cf22 "BlockStat: POC %d @(%4d,%4d) [%2dx%2d] %s=%d\\n"}, cs.picture->poc, cs.area.lx(), cs.area.ly(), cs.area.lwidth(), cs.area.lheight(), stat_type.c_str(), value );\par
00114 {\cf21 #endif}\par
00115 \}\par
00116 \par
00117 {\cf18 void} CDTrace::dtrace_block_scalar( {\cf18 int} k, {\cf17 const} CodingUnit &cu, std::string stat_type, {\cf18 signed} value,  {\cf18 bool} isChroma {\cf20 /*= false*/}  )\par
00118 \{\par
00119   {\cf17 const} CodingStructure& cs = *cu.cs;\par
00120 {\cf21 #if BLOCK_STATS_AS_CSV}\par
00121   {\cf19 if}(isChroma)\par
00122   \{\par
00123     dtrace<false>( k, {\cf22 "BlockStat;%d;%4d;%4d;%2d;%2d;%s;%d\\n"}, cs.picture->poc, cu.Cb().x*2, cu.Cb().y*2, cu.Cb().width*2, cu.Cb().height*2, stat_type.c_str(), value );\par
00124   \}\par
00125   {\cf19 else}\par
00126   \{\par
00127     dtrace<false>( k, {\cf22 "BlockStat;%d;%4d;%4d;%2d;%2d;%s;%d\\n"}, cs.picture->poc, cu.lx(), cu.ly(), cu.lwidth(), cu.lheight(), stat_type.c_str(), value );\par
00128   \}\par
00129 {\cf21 #else}\par
