01123                 mv[0].ver = mv[0].ver >= 0 ? (mv[0].ver + nOffset) >> nShift : -((-mv[0].ver + nOffset) >> nShift);\par
01124                 mv[1].hor = mv[1].hor >= 0 ? (mv[1].hor + nOffset) >> nShift : -((-mv[1].hor + nOffset) >> nShift);\par
01125                 mv[1].ver = mv[1].ver >= 0 ? (mv[1].ver + nOffset) >> nShift : -((-mv[1].ver + nOffset) >> nShift);\par
01126                 mv[2].hor = mv[2].hor >= 0 ? (mv[2].hor + nOffset) >> nShift : -((-mv[2].hor + nOffset) >> nShift);\par
01127                 mv[2].ver = mv[2].ver >= 0 ? (mv[2].ver + nOffset) >> nShift : -((-mv[2].ver + nOffset) >> nShift);\par
01128                 DTRACE_BLOCK_AFFINETF(g_trace_ctx, D_BLOCK_STATISTICS_CODED, pu, GetBlockStatisticName(BlockStatistic::AffineMVL1), mv[0].hor, mv[0].ver, mv[1].hor, mv[1].ver, mv[2].hor, mv[2].ver);\par
01129               \}\par
01130             \}\par
01131             {\cf19 if} (cu.cs->sps->getAMVREnabledFlag() && CU::hasSubCUNonZeroMVd(cu))\par
01132             \{\par
01133               DTRACE_BLOCK_SCALAR(g_trace_ctx, D_BLOCK_STATISTICS_CODED, cu, GetBlockStatisticName(BlockStatistic::IMVMode), cu.imv);\par
01134             \}\par
01135             {\cf19 if} (CU::isBcwIdxCoded(cu))\par
01136             \{\par
01137               DTRACE_BLOCK_SCALAR(g_trace_ctx, D_BLOCK_STATISTICS_ALL, cu, GetBlockStatisticName(BlockStatistic::BCWIndex), cu.BcwIdx);\par
01138             \}\par
01139             {\cf19 break};\par
01140           \}\par
01141           {\cf19 default}:\par
01142           \{\par
01143             CHECK(1, {\cf22 "Invalid prediction mode"});\par
01144             {\cf19 break};\par
01145           \}\par
01146         \}\par
01147       \} {\cf20 // end pu}\par
01148       {\cf19 if} (CU::isInter(cu))\par
01149       \{\par
01150         {\cf17 const} PredictionUnit &pu = *cu.firstPU;\par
01151         {\cf19 if} ( !pu.mergeFlag )\par
01152         \{\par
01153           DTRACE_BLOCK_SCALAR(g_trace_ctx, D_BLOCK_STATISTICS_CODED, cu, GetBlockStatisticName(BlockStatistic::RootCbf), cu.rootCbf);\par
01154         \}\par
01155       \}\par
01156       {\cf19 if} (cu.rootCbf || CU::isIntra(cu))\par
01157       \{\par
01158         {\cf19 for} ({\cf17 const} TransformUnit &tu : CU::traverseTUs(cu))\par
01159         \{\par
01160           {\cf19 if} (tu.Y().valid())\par
01161           \{\par
01162             DTRACE_BLOCK_SCALAR(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::Cbf_Y), tu.cbf[COMPONENT_Y]);\par
01163             DTRACE_BLOCK_SCALAR(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::MTSIdx_Y), tu.mtsIdx[COMPONENT_Y]);\par
01164           \}\par
01165           {\cf19 if} (!(cu.chromaFormat == CHROMA_400 || (cu.isSepTree() && cu.chType == CHANNEL_TYPE_LUMA)))\par
01166           \{\par
01167             DTRACE_BLOCK_SCALAR_CHROMA(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::Cbf_Cb), tu.cbf[COMPONENT_Cb]);\par
01168             DTRACE_BLOCK_SCALAR_CHROMA(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::Cbf_Cr), tu.cbf[COMPONENT_Cr]);\par
01169             DTRACE_BLOCK_SCALAR_CHROMA(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::MTSIdx_Cb), tu.mtsIdx[COMPONENT_Cb]);\par
01170             DTRACE_BLOCK_SCALAR_CHROMA(g_trace_ctx, D_BLOCK_STATISTICS_CODED, tu, GetBlockStatisticName(BlockStatistic::MTSIdx_Cr), tu.mtsIdx[COMPONENT_Cr]);\par
01171           \}\par
01172         \}\par
01173       \}\par
01174     \}\par
01175   \}\par
01176 \}\par
01177 {\cf21 #endif}\par
