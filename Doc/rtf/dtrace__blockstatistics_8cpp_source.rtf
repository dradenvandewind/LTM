00051 std::string GetBlockStatisticName(BlockStatistic statistic)\par
00052 \{\par
00053   {\cf17 auto} statisticIterator = blockstatistic2description.find(statistic);\par
00054   {\cf20 // enforces that all delcared statistic enum items are also part of the map}\par
00055   assert(statisticIterator != blockstatistic2description.end() && {\cf22 "A block statistics declared in the enum is missing in the map for statistic description."});\par
00056 \par
00057   {\cf19 return} std::get<0>(statisticIterator->second);\par
00058 \}\par
00059 \par
00060 std::string GetBlockStatisticTypeString(BlockStatistic statistic)\par
00061 \{\par
00062   {\cf17 auto} statisticIterator = blockstatistic2description.find(statistic);\par
00063   {\cf20 // enforces that all delcared statistic enum items are also part of the map}\par
00064   assert(statisticIterator != blockstatistic2description.end() && {\cf22 "A block statistics declared in the enum is missing in the map for statistic description."});\par
00065 \par
00066   BlockStatisticType statisticType = std::get<1>(statisticIterator->second);\par
00067   {\cf19 switch} (statisticType) \{\par
00068   {\cf19 case} BlockStatisticType::Flag:\par
00069     {\cf19 return} std::string({\cf22 "Flag"});\par
00070     {\cf19 break};\par
00071   {\cf19 case} BlockStatisticType::Vector:\par
00072     {\cf19 return} std::string({\cf22 "Vector"});\par
00073     {\cf19 break};\par
00074   {\cf19 case} BlockStatisticType::Integer:\par
00075     {\cf19 return} std::string({\cf22 "Integer"});\par
00076     {\cf19 break};\par
00077   {\cf19 case} BlockStatisticType::AffineTFVectors:\par
00078     {\cf19 return} std::string({\cf22 "AffineTFVectors"});\par
00079     {\cf19 break};\par
00080   {\cf19 case} BlockStatisticType::Line:\par
00081     {\cf19 return} std::string({\cf22 "Line"});\par
00082     {\cf19 break};\par
00083   {\cf19 case} BlockStatisticType::FlagPolygon:\par
00084     {\cf19 return} std::string({\cf22 "FlagPolygon"});\par
00085     {\cf19 break};\par
00086   {\cf19 case} BlockStatisticType::VectorPolygon:\par
00087     {\cf19 return} std::string({\cf22 "VectorPolygon"});\par
00088     {\cf19 break};\par
00089   {\cf19 case} BlockStatisticType::IntegerPolygon:\par
00090     {\cf19 return} std::string({\cf22 "IntegerPolygon"});\par
00091     {\cf19 break};\par
00092   {\cf19 default}:\par
00093     assert(0);\par
00094     {\cf19 break};\par
00095   \}\par
00096   {\cf19 return} std::string();\par
00097 \}\par
00098 \par
00099 std::string GetBlockStatisticTypeSpecificInfo(BlockStatistic statistic)\par
