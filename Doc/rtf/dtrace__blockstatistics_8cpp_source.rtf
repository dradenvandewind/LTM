00300 {\cf18 void} retrieveGeoPolygons({\cf17 const} CodingUnit& cu, std::vector<Position> (&geoPartitions)[2], Position (&linePositions)[2])\par
00301 \{\par
00302   {\cf20 // adapted code from interpolation filter to find geo partition polygons like this:}\par
00303   {\cf20 // use SAD mask, which should clearly partition the two polygons.}\par
00304   {\cf20 // loop over boundary pixels and find positions where there is a change, these should be the polygon corners}\par
00305   {\cf17 static} {\cf18 bool} isInitialized = {\cf17 false};\par
00306   {\cf17 static} std::vector<Position> allGeoPartitionings[GEO_NUM_CU_SIZE][GEO_NUM_CU_SIZE][GEO_NUM_PARTITION_MODE][2];\par
00307   {\cf17 static} Position allGeoPartitioningLines[GEO_NUM_CU_SIZE][GEO_NUM_CU_SIZE][GEO_NUM_PARTITION_MODE][2];\par
00308 \par
00309   {\cf19 if}(!isInitialized)\par
00310   \{\par
00311     {\cf19 for}( {\cf18 int} hIdx = 0; hIdx < GEO_NUM_CU_SIZE; hIdx++ )\par
00312     \{\par
00313       int16_t height = 1 << ( hIdx + GEO_MIN_CU_LOG2);\par
00314       {\cf19 for}( {\cf18 int} wIdx = 0; wIdx < GEO_NUM_CU_SIZE; wIdx++ )\par
00315       \{\par
00316         int16_t width = 1 << (wIdx + GEO_MIN_CU_LOG2);\par
00317         {\cf19 for}( {\cf18 int} splitDir = 0; splitDir < GEO_NUM_PARTITION_MODE; splitDir++ )\par
00318         \{\par
00319           int16_t angle         = g_GeoParams[splitDir][0];\par
00320 \par
00321           {\cf18 int} maskStride = 0;\par
00322           {\cf18 int} stepX = 1;\par
00323           Pel* SADmask;\par
00324           {\cf19 if} (g_angle2mirror[angle] == 2)\par
00325           \{\par
00326             maskStride = -GEO_WEIGHT_MASK_SIZE;\par
00327             SADmask = &g_globalGeoEncSADmask[g_angle2mask[g_GeoParams[splitDir][0]]][(GEO_WEIGHT_MASK_SIZE - 1 - g_weightOffset[splitDir][hIdx][wIdx][1]) * GEO_WEIGHT_MASK_SIZE + g_weightOffset[splitDir][hIdx][wIdx][0]];\par
00328           \}\par
00329           {\cf19 else} {\cf19 if} (g_angle2mirror[angle] == 1)\par
00330           \{\par
00331             stepX = -1;\par
00332             maskStride = GEO_WEIGHT_MASK_SIZE;\par
00333             SADmask = &g_globalGeoEncSADmask[g_angle2mask[g_GeoParams[splitDir][0]]][g_weightOffset[splitDir][hIdx][wIdx][1] * GEO_WEIGHT_MASK_SIZE + (GEO_WEIGHT_MASK_SIZE - 1 - g_weightOffset[splitDir][hIdx][wIdx][0])];\par
00334           \}\par
00335           {\cf19 else}\par
00336           \{\par
00337             maskStride = GEO_WEIGHT_MASK_SIZE;\par
00338             SADmask = &g_globalGeoEncSADmask[g_angle2mask[g_GeoParams[splitDir][0]]][g_weightOffset[splitDir][hIdx][wIdx][1] * GEO_WEIGHT_MASK_SIZE + g_weightOffset[splitDir][hIdx][wIdx][0]];\par
00339           \}\par
00340 \par
00341           {\cf18 int} currentPartition = 0;\par
00342           std::vector<Pel> boundaryOfMask; {\cf20 // for debugging}\par
00343 \par
00344           Area partitionArea = Area(0, 0, width, height);\par
00345           Position TL = partitionArea.topLeft();\par
00346           Position TR = partitionArea.topRight();    TR = TR.offset(1, 0);\par
00347           Position BL = partitionArea.bottomLeft();  BL = BL.offset(0, 1);\par
00348           Position BR = partitionArea.bottomRight(); BR = BR.offset(1, 1);\par
00349 \par
00350           std::vector<Position> oneGeoPartitioning[2];\par
00351           Position oneGeoPartitioningLine[2];\par
00352           {\cf20 // corner of block is a corner of the first partition}\par
00353           oneGeoPartitioning[currentPartition].push_back(TL);\par
00354 \par
00355           {\cf20 // process top boundary}\par
00356           {\cf19 for}( {\cf18 int} x = 0; x < width-1; x++ )\par
00357           \{\par
00358             boundaryOfMask.push_back(*SADmask);\par
00359             {\cf19 if}(*SADmask != *(SADmask+stepX))\par
00360             \{\par
00361               {\cf20 // found a change of partitions, it is a corner of both partition polygons}\par
00362               oneGeoPartitioning[currentPartition].push_back(Position(TL.x + x, TL.y));\par
00363               oneGeoPartitioningLine[currentPartition] = Position(TL.x + x, TL.y);\par
00364               currentPartition ^= 0x01;\par
00365               oneGeoPartitioning[currentPartition].push_back(Position(TL.x + x, TL.y));\par
00366             \}\par
00367             SADmask += stepX;\par
00368           \}\par
00369 \par
00370           {\cf20 // corner of block is a corner of the current partition}\par
00371           oneGeoPartitioning[currentPartition].push_back(TR);\par
00372 \par
00373           {\cf20 // process right boundary}\par
00374           {\cf19 for}( {\cf18 int} y = 0; y < height-1; y++ )\par
00375           \{\par
00376             boundaryOfMask.push_back(*SADmask);\par
00377             {\cf19 if}(*SADmask != *(SADmask+maskStride))\par
00378             \{\par
00379               {\cf20 // found a change of partitions, it is a corner of both partition polygons}\par
00380               oneGeoPartitioning[currentPartition].push_back(Position(TR.x, TR.y + y));\par
00381               oneGeoPartitioningLine[currentPartition] = Position(TR.x, TR.y + y);\par
00382               currentPartition ^= 0x01;\par
00383               oneGeoPartitioning[currentPartition].push_back(Position(TR.x, TR.y + y));\par
00384             \}\par
00385             SADmask += maskStride;\par
00386           \}\par
00387 \par
00388           {\cf20 // corner of block is a corner of the current partition}\par
00389           oneGeoPartitioning[currentPartition].push_back(BR);\par
00390 \par
00391           {\cf20 // process bottom boundary}\par
00392           {\cf19 for}( {\cf18 int} x = width-1; x > 0; x-- )\par
00393           \{\par
00394             boundaryOfMask.push_back(*SADmask);\par
00395             {\cf19 if}(*SADmask != *(SADmask-stepX))\par
00396             \{\par
00397               {\cf20 // found a change of partitions, it is a corner of both partition polygons}\par
00398               oneGeoPartitioning[currentPartition].push_back(Position(BL.x + x, BL.y));\par
00399               oneGeoPartitioningLine[currentPartition] = Position(BL.x + x, BL.y);\par
00400               currentPartition ^= 0x01;\par
00401               oneGeoPartitioning[currentPartition].push_back(Position(BL.x + x, BL.y));\par
00402             \}\par
00403             SADmask -= stepX;\par
00404           \}\par
00405 \par
00406           {\cf20 // corner of block is a corner of the current partition}\par
00407           oneGeoPartitioning[currentPartition].push_back(BL);\par
00408 \par
00409           {\cf20 // process left boundary}\par
00410           {\cf19 for}( {\cf18 int} y = height-1; y > 0; y-- )\par
00411           \{\par
00412             boundaryOfMask.push_back(*SADmask);\par
00413             {\cf19 if}(*SADmask != *(SADmask-maskStride))\par
00414             \{\par
00415               {\cf20 // found a change of partitions, it is a corner of both partition polygons}\par
00416               oneGeoPartitioning[currentPartition].push_back(Position(TL.x, TL.y + y));\par
00417               oneGeoPartitioningLine[currentPartition] = Position(TL.x, TL.y + y);\par
00418               currentPartition ^= 0x01;\par
00419               oneGeoPartitioning[currentPartition].push_back(Position(TL.x, TL.y + y));\par
00420             \}\par
00421             SADmask -= maskStride;\par
00422           \}\par
00423 \par
00424           {\cf20 // corner of block is a corner of the current partition}\par
00425           oneGeoPartitioning[currentPartition].push_back(TL);\par
00426 \par
00427           {\cf20 // remove duplicate points}\par
00428           {\cf19 for}( {\cf17 auto} geoPartIdx = 0; geoPartIdx < 2; geoPartIdx++)\par
00429           \{\par
00430             {\cf20 // this will only remove consecutive duplicates}\par
00431             {\cf17 auto} last = std::unique(oneGeoPartitioning[geoPartIdx].begin(), oneGeoPartitioning[geoPartIdx].end());\par
00432             oneGeoPartitioning[geoPartIdx].erase(last, oneGeoPartitioning[geoPartIdx].end());\par
00433             {\cf20 // also check if first and last are the same}\par
00434             {\cf19 if}(oneGeoPartitioning[geoPartIdx].front() == oneGeoPartitioning[geoPartIdx].back())\par
00435             \{\par
00436               oneGeoPartitioning[geoPartIdx].pop_back();\par
00437             \}\par
00438 \par
00439             CHECK(!(oneGeoPartitioning[geoPartIdx].size() > 2 && oneGeoPartitioning[geoPartIdx].size() < 6), {\cf22 "Invalid geo partition shape. Polygon should have between 3 and 5 corners."});\par
00440           \}\par
00441 \par
00442           allGeoPartitionings[hIdx][wIdx][splitDir][0] = oneGeoPartitioning[0];\par
00443           allGeoPartitionings[hIdx][wIdx][splitDir][1] = oneGeoPartitioning[1];\par
00444           allGeoPartitioningLines[hIdx][wIdx][splitDir][0] = oneGeoPartitioningLine[0];\par
00445           allGeoPartitioningLines[hIdx][wIdx][splitDir][1] = oneGeoPartitioningLine[1];\par
00446         \}\par
00447       \}\par
00448     \}\par
00449     isInitialized = {\cf17 true};\par
00450   \}\par
00451 \par
00452   {\cf17 const} uint8_t splitDir = cu.firstPU->geoSplitDir;\par
00453   int16_t wIdx = floorLog2(cu.lwidth()) - GEO_MIN_CU_LOG2;\par
00454   int16_t hIdx = floorLog2(cu.lheight()) - GEO_MIN_CU_LOG2;\par
00455 \par
00456   Position TL = cu.Y().topLeft();\par
00457 \par
00458   geoPartitions[0] = allGeoPartitionings[hIdx][wIdx][splitDir][0];\par
00459   geoPartitions[1] = allGeoPartitionings[hIdx][wIdx][splitDir][1];\par
00460   linePositions[0] = allGeoPartitioningLines[hIdx][wIdx][splitDir][0];\par
00461   linePositions[1] = allGeoPartitioningLines[hIdx][wIdx][splitDir][1];\par
00462 \par
00463   {\cf20 // offset the partitioning to the current cu}\par
00464   {\cf19 for}( {\cf17 auto} geoPartIdx = 0; geoPartIdx < 2; geoPartIdx++)\par
00465   \{\par
00466     {\cf19 for}( Position &polygonCorner : geoPartitions[geoPartIdx])\par
00467     \{\par
00468       polygonCorner.repositionTo(polygonCorner.offset(TL));\par
00469     \}\par
00470   \}\par
00471 \}\par
