00162 {\cf17 template}< {\cf17 typename} Tsrc >\par
00163 {\cf18 void} dtrace_block( CDTrace *trace_ctx, DTRACE_CHANNEL channel, Tsrc *buf, {\cf18 unsigned} stride, {\cf18 unsigned} block_w, {\cf18 unsigned} block_h )\par
00164 \{\par
00165   {\cf18 unsigned} i, j;\par
00166   {\cf19 for}( j = 0; j < block_h; j++ )\par
00167   \{\par
00168     {\cf19 for}( i = 0; i < block_w; i++ )\par
00169     \{\par
00170       trace_ctx->dtrace<{\cf17 false}>( channel, {\cf22 "%04x "}, buf[j*stride + i] );\par
00171       {\cf20 //trace_ctx->dtrace<false>( channel, "%4d ", buf[j*stride + i] );}\par
00172     \}\par
00173     trace_ctx->dtrace<{\cf17 false}>( channel, {\cf22 "\\n"} );\par
00174   \}\par
00175   trace_ctx->dtrace<{\cf17 false}>( channel, {\cf22 "\\n"} );\par
00176 \}\par
00177 \par
00178 {\cf17 template}< {\cf17 typename} Tsrc >\par
00179 {\cf18 void} dtrace_frame_blockwise( CDTrace *trace_ctx, DTRACE_CHANNEL channel, Tsrc *buf, {\cf18 unsigned} stride, {\cf18 unsigned} frm_w, {\cf18 unsigned} frm_h, {\cf18 unsigned} block_w, {\cf18 unsigned} block_h )\par
00180 \{\par
00181   {\cf18 unsigned} i, j, block;\par
00182   {\cf19 for}( j = 0, block = 0; j < frm_h; j += block_h )\par
00183   \{\par
00184     {\cf18 unsigned} blockhf = std::min( block_h, frm_h - j);\par
00185     Tsrc *p_buf = buf + j*stride;\par
00186     {\cf19 for}( i = 0; i < frm_w; i += block_w, block++ )\par
00187     \{\par
00188       {\cf18 unsigned} blockwf = std::min( block_w, frm_w - i);\par
00189 \par
00190       trace_ctx->dtrace<{\cf17 false}>( channel, {\cf22 "Frame BLOCK=%d (x,y) = (%d, %d)\\n"}, block, i, j );\par
00191       dtrace_block( trace_ctx, channel, p_buf, stride, blockwf, blockhf );\par
00192       p_buf += block_w;\par
00193     \}\par
00194   \}\par
00195 \}\par
