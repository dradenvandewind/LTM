00051 \par
00053 {\cf20 //}\par
00054 {\cf20 // DTRACE SHORT MANUAL}\par
00055 {\cf20 //}\par
00056 {\cf20 // 1. General info}\par
00057 {\cf20 //}\par
00058 {\cf20 // DTrace is a simple tracer that can be controlled at command line of the executable.}\par
00059 {\cf20 //}\par
00060 {\cf20 // Please have a look into command line parameter options to find the correspondent DTrace parameters.}\par
00061 {\cf20 // There are only two command-line parameters: tracing file and tracing rule.}\par
00062 {\cf20 // At initialization, DTrace-module parses the rule and set up the tracing context.}\par
00063 {\cf20 // The tracing context is stored in a global variable. All trace-outputs should use this global context.}\par
00064 {\cf20 //}\par
00065 {\cf20 // 2. Parameters}\par
00066 {\cf20 // 2.1 Tracing file (--TraceFile)}\par
00067 {\cf20 //}\par
00068 {\cf20 // Just a filename for a text-file.}\par
00069 {\cf20 // E.g.: --TraceFile="tracefile_rec.txt"}\par
00070 {\cf20 //}\par
00071 {\cf20 // 2.2 Tracing rule (--TraceRule)}\par
00072 {\cf20 //}\par
00073 {\cf20 // Tracing rule describes when during a runtime a particular output should be activated.}\par
00074 {\cf20 // Tracing rule consists of tracing channel(s) and tracing condition(s).}\par
00075 {\cf20 // The construction of the rule is: "channel_1,channel_2,...:condition_1,condition_2,..."}\par
00076 {\cf20 //}\par
00077 {\cf20 // Example for a tracing rule: --TraceRule="D_CABAC:poc==0"}\par
00078 {\cf20 // Here, tracing channel is D_CABAC and condition is poc==0, which means CABAC tracing output is activated at POC 0 only.}\par
00079 {\cf20 // You can also use poc>=2 or set the range like poc>=0,poc<=3 for example.}\par
00080 {\cf20 //}\par
00081 {\cf20 //}\par
00082 {\cf20 // 2.2.1 Tracing channel}\par
00083 {\cf20 //}\par
00084 {\cf20 // Channels are defined in dtrace_next.h. Users can add their own channels.}\par
00085 {\cf20 // Just put the channel definition into enum-list AND add it to the next_channels-table in the function tracing_init().}\par
00086 {\cf20 //}\par
00087 {\cf20 // 2.2.2 Tracing condition}\par
00088 {\cf20 //}\par
00089 {\cf20 // Currently supported: poc (the currently processed poc) and final ('0' if currently in RD-search, '1' if the current state is final)}\par
00090 {\cf20 // NOTE: Conditions are added and updated during runtime through DTRACE_UPDATE(...).}\par
00091 {\cf20 // It updates the DTrace internal state, so channels can be activated at the right moment.}\par
00092 {\cf20 // If it's not updated properly (at right place in the code, e.g. too late), the trace output can become wrong.}\par
00093 {\cf20 // For example, "poc"-condition should be updated at the start of the picture(AccesUnit).}\par
00094 {\cf20 // Please look into source code for how the "poc"-condition is used.}\par
00095 {\cf20 //}\par
00096 {\cf20 // 3. Using of DTrace macros}\par
00097 {\cf20 //}\par
00098 {\cf20 // The most used macro is DTRACE. It's like a printf-function with some additional parameters at the beginning.}\par
00099 {\cf20 // Format:}\par
00100 {\cf20 // DTRACE( tracing context, tracing channel, "..." [,params] );}\par
00101 {\cf20 // Example:}\par
00102 {\cf20 // DTRACE( g_trace_ctx, D_CABAC, "EP=%d \\n", bin );}\par
00103 {\cf20 // There are also macros for output of buffers, picture components or conditional-outputs available. Please have a look into dtrace_next.h.}\par
00105 \par
00106 \par
00107 {\cf20 // DTrace channels}\par
00108 {\cf20 // Use already defined channels or add your own tracing channels}\par
00109 \par
00110 {\cf17 enum} DTRACE_CHANNEL\par
00111 \{\par
00112   D_COMMON,\par
00113   D_HEADER,               {\cf20 // header file infos}\par
00114   D_NALUNITHEADER,        {\cf20 // NAL unit header infos}\par
00115   D_RPSINFO,              {\cf20 // bits used to send the RPS}\par
00116   D_REC_CB_LUMA,          {\cf20 // reconstructed coding block luma pixel}\par
00117   D_REC_CB_CHROMA,        {\cf20 // reconstructed coding block chroma pixel}\par
00118   D_REC_CB_LUMA_LF,       {\cf20 // reconstructed coding block luma pixel after deblocking filter}\par
00119   D_REC_CB_CHROMA_LF,     {\cf20 // reconstructed coding block chroma pixel after deblocking filter}\par
00120   D_REC_CB_LUMA_SAO,      {\cf20 // reconstructed coding block luma pixel after SAO filter}\par
00121   D_REC_CB_CHROMA_SAO,    {\cf20 // reconstructed coding block chroma pixel after SAO filter}\par
00122   D_REC_CB_LUMA_ALF,      {\cf20 // reconstructed coding block luma pixel after ALF filter}\par
00123   D_REC_CB_CHROMA_ALF,    {\cf20 // reconstructed coding block chroma pixel after ALF filter}\par
00124   D_ME,                   {\cf20 // Motion Estimation}\par
00125   D_CABAC,                {\cf20 // CABAC engine}\par
00126   D_SYNTAX,               {\cf20 // syntax}\par
00127   D_SYNTAX_RESI,          {\cf20 // syntax of the residual coding}\par
00128   D_BEST_MODE,            {\cf20 // Cost for coding mode (encoder only)}\par
00129   D_MODE_COST,            {\cf20 // Cost for coding mode (encoder only)}\par
00130   D_QP_PRED,              {\cf20 // QP Prediction for DQP process}\par
00131   D_DQP,                  {\cf20 // Delta QP read/write}\par
00132   D_QP,                   {\cf20 // final CU QP at reading/writing stage}\par
00133   D_QP_PER_CTU,           {\cf20 // final QP per CTU at reading}\par
00134   D_MISC,                 {\cf20 // Miscellaneous}\par
00135   D_TU_ABS_SUM,\par
00136   D_EST_FRAC_BITS,\par
