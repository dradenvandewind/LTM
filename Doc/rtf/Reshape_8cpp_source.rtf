00240 {\cf18 void} Reshape::constructReshaper()\par
00241 \{\par
00242   {\cf18 int} pwlFwdLUTsize = PIC_CODE_CW_BINS;\par
00243   {\cf18 int} pwlFwdBinLen = m_reshapeLUTSize / PIC_CODE_CW_BINS;\par
00244 \par
00245   {\cf19 for} ({\cf18 int} i = 0; i < m_sliceReshapeInfo.reshaperModelMinBinIdx; i++)\par
00246     m_binCW[i] = 0;\par
00247   {\cf19 for} ({\cf18 int} i = m_sliceReshapeInfo.reshaperModelMaxBinIdx + 1; i < PIC_CODE_CW_BINS; i++)\par
00248     m_binCW[i] = 0;\par
00249   {\cf19 for} ({\cf18 int} i = m_sliceReshapeInfo.reshaperModelMinBinIdx; i <= m_sliceReshapeInfo.reshaperModelMaxBinIdx; i++)\par
00250     m_binCW[i] = (uint16_t)(m_sliceReshapeInfo.reshaperModelBinCWDelta[i] + (int)m_initCW);\par
00251 \par
00252   {\cf19 for} ({\cf18 int} i = 0; i < pwlFwdLUTsize; i++)\par
00253   \{\par
00254     m_reshapePivot[i + 1] = m_reshapePivot[i] + m_binCW[i];\par
00255     m_inputPivot[i + 1] = m_inputPivot[i] + m_initCW;\par
00256     m_fwdScaleCoef[i] = ((int32_t)m_binCW[i] * (1 << FP_PREC) + (1 << (floorLog2(pwlFwdBinLen) - 1))) >> floorLog2(pwlFwdBinLen);\par
00257     {\cf19 if} (m_binCW[i] == 0)\par
00258     \{\par
00259       m_invScaleCoef[i] = 0;\par
00260       m_chromaAdjHelpLUT[i] = 1 << CSCALE_FP_PREC;\par
00261     \}\par
00262     {\cf19 else}\par
00263     \{\par
00264       m_invScaleCoef[i] = (int32_t)(m_initCW * (1 << FP_PREC) / m_binCW[i]);\par
00265       m_chromaAdjHelpLUT[i] = (int32_t)(m_initCW * (1 << FP_PREC) / ( m_binCW[i] + m_sliceReshapeInfo.chrResScalingOffset ) );\par
00266     \}\par
00267   \}\par
00268   {\cf19 for} ({\cf18 int} lumaSample = 0; lumaSample < m_reshapeLUTSize; lumaSample++)\par
00269   \{\par
00270     {\cf18 int} idxY = lumaSample / m_initCW;\par
00271     {\cf18 int} tempVal = m_reshapePivot[idxY] + ((m_fwdScaleCoef[idxY] * (lumaSample - m_inputPivot[idxY]) + (1 << (FP_PREC - 1))) >> FP_PREC);\par
