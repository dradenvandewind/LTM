00273 \par
00274     {\cf18 int} idxYInv = getPWLIdxInv(lumaSample);\par
00275     {\cf18 int} invSample = m_inputPivot[idxYInv] + ((m_invScaleCoef[idxYInv] * (lumaSample - m_reshapePivot[idxYInv]) + (1 << (FP_PREC - 1))) >> FP_PREC);\par
00276     m_invLUT[lumaSample] = Clip3((Pel)0, (Pel)((1 << m_lumaBD) - 1), (Pel)(invSample));\par
00277   \}\par
00278 \}\par
