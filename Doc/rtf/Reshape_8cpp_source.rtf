00106 {\cf18 int}  Reshape::calculateChromaAdjVpduNei(TransformUnit &tu, {\cf17 const} CompArea &areaY)\par
00107 \{\par
00108   CodingStructure &cs = *tu.cs;\par
00109   {\cf18 int} xPos = areaY.lumaPos().x;\par
00110   {\cf18 int} yPos = areaY.lumaPos().y;\par
00111   {\cf18 int} ctuSize = cs.sps->getCTUSize();\par
00112   {\cf18 int} numNeighbor = std::min(64, ctuSize);\par
00113   {\cf18 int} numNeighborLog = floorLog2(numNeighbor);\par
00114   {\cf19 if} (ctuSize == 128)\par
00115   \{\par
00116     xPos = xPos / 64 * 64;\par
00117     yPos = yPos / 64 * 64;\par
00118   \}\par
00119   {\cf19 else}\par
00120   \{\par
00121     xPos = xPos / ctuSize * ctuSize;\par
00122     yPos = yPos / ctuSize * ctuSize;\par
00123   \}\par
00124 \par
00125   {\cf19 if} (isVPDUprocessed(xPos, yPos) && !cs.pcv->isEncoder)\par
00126   \{\par
00127     {\cf19 return} getChromaScale();\par
00128   \}\par
00129   {\cf19 else}\par
00130   \{\par
00131     setVPDULoc(xPos, yPos);\par
00132     Position topLeft(xPos, yPos);\par
00133     CodingUnit *topLeftLuma;\par
00134     {\cf17 const} CodingUnit *cuAbove, *cuLeft;\par
00135     {\cf19 if} (CS::isDualITree(cs) && cs.slice->getSliceType() == I_SLICE)\par
00136     \{\par
00137       topLeftLuma = tu.cs->picture->cs->getCU(topLeft, CHANNEL_TYPE_LUMA);\par
00138       cuAbove = cs.picture->cs->getCURestricted(topLeftLuma->lumaPos().offset(0, -1), *topLeftLuma, CHANNEL_TYPE_LUMA);\par
00139       cuLeft  = cs.picture->cs->getCURestricted(topLeftLuma->lumaPos().offset(-1, 0), *topLeftLuma, CHANNEL_TYPE_LUMA);\par
00140     \}\par
00141     {\cf19 else}\par
00142     \{\par
00143       topLeftLuma = cs.getCU(topLeft, CHANNEL_TYPE_LUMA);\par
00144       cuAbove = cs.getCURestricted(topLeftLuma->lumaPos().offset(0, -1), *topLeftLuma, CHANNEL_TYPE_LUMA);\par
00145       cuLeft  = cs.getCURestricted(topLeftLuma->lumaPos().offset(-1, 0), *topLeftLuma, CHANNEL_TYPE_LUMA);\par
00146     \}\par
00147 \par
00148     xPos = topLeftLuma->lumaPos().x;\par
00149     yPos = topLeftLuma->lumaPos().y;\par
00150 \par
00151     CompArea lumaArea = CompArea(COMPONENT_Y, tu.chromaFormat, topLeftLuma->lumaPos(), topLeftLuma->lumaSize(), {\cf17 true});\par
00152     PelBuf piRecoY = cs.picture->getRecoBuf(lumaArea);\par
00153     {\cf18 int} strideY = piRecoY.stride;\par
00154     {\cf18 int} chromaScale = (1 << CSCALE_FP_PREC);\par
00155     {\cf18 int} lumaValue = -1;\par
00156 \par
00157     Pel* recSrc0 = piRecoY.bufAt(0, 0);\par
00158     {\cf17 const} uint32_t picH = tu.cs->picture->lheight();\par
