00010 {\cf17 def }platform_exe(path, name):\par
00011     {\cf22 """Given a directory and an executable file name, return platform specifix path."""}\par
00012     exesuffix = \{{\cf22 "win32"}:{\cf22 ".exe"},{\cf22 "linux"}:{\cf22 ""}\}\par
00013     {\cf19 return} os.path.join(path, name+exesuffix.get(sys.platform,{\cf22 ""}))\par
00014 \par
00015 {\cf17 def }run_subprocess(title, args, logfile, show_progress):\par
00016     {\cf22 """Run a comamnd as a subprocess - report progress and capture output (both stderr and stdout) to a log file."""}\par
00017 \par
00018     {\cf17 with} open(logfile, {\cf22 "wt"}) {\cf17 as} log:\par
00019         sys.stderr.write(f{\cf22 "    \{title\}: Start\\r"})\par
00020         {\cf19 if} show_progress:\par
00021             sys.stderr.write({\cf22 "\\r"})\par
00022         {\cf19 else}:\par
00023             sys.stderr.write({\cf22 "\\n"})\par
00024 \par
00025         print({\cf22 " "}.join(args), file=log)\par
00026 \par
00027         {\cf17 with} subprocess.Popen(args, bufsize=1, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\par
00028                               universal_newlines={\cf17 True}) {\cf17 as} p:\par
00029             {\cf19 for} n,l {\cf19 in} enumerate(p.stdout):\par
00030                 {\cf20 # Progress}\par
00031                 {\cf19 if} show_progress == {\cf22 "spinner"}:\par
00032                     progress_indicator = {\cf22 "|/-\\\\|/-\\\\"}[n % 8]\par
00033                     sys.stderr.write(f{\cf22 "    \{title\}: \{progress_indicator\}      \\r"})\par
00034                 {\cf19 elif} show_progress == {\cf22 "verbose"}:\par
00035                     sys.stderr.write(l)\par
00036                 {\cf20 # Log file}\par
00037                 print(l.strip(), file=log)\par
00038 \par
00039             {\cf19 if} p.wait() != 0:\par
00040                 sys.stderr.write(f{\cf22 "    \{title\}: FAILED\\n"})\par
00041                 {\cf19 return} {\cf17 False}\par
00042 \par
00043     sys.stderr.write(f{\cf22 "    \{title\}: OK\\n"})\par
00044     {\cf19 return} {\cf17 True}\par
00045 \par
00046 {\cf17 def }hash_md5(filename, blocksize=65536):\par
00047     {\cf22 """}\par
00048 {\cf22     Compute md5 hash of named file.}\par
00049 {\cf22     """}\par
00050     hash = hashlib.md5()\par
00051     {\cf17 with} open(filename, {\cf22 "rb"}) {\cf17 as} f:\par
00052         {\cf19 for} block {\cf19 in} iter({\cf17 lambda}: f.read(blocksize), b{\cf22 ""}):\par
00053             hash.update(block)\par
00054     {\cf19 return} hash.hexdigest()\par
00055 \par
00056 {\cf17 def }run_decode(decoder, input_dir, base):\par
00057 \par
00058     os.chdir(input_dir)\par
00059 \par
00060     {\cf19 for} filename {\cf19 in} glob.glob({\cf22 "**/*.bit"}):\par
00061         name = filename[:-4]\par
00062         {\cf19 if} base == {\cf22 'auto'}:\par
00063             {\cf19 if} os.path.isfile(f{\cf22 "\{name\}.cfg"}):\par
00064                 {\cf17 with} open(f{\cf22 "\{name\}.cfg"}) {\cf17 as} json_file:\par
00065                     config = json.load(json_file)\par
00066                     base_run = config[{\cf22 'base_encoder'}]\par
00067                     yuv_format = config[{\cf22 'format'}]\par
00068                     base_external = {\cf17 False}\par
00069                     {\cf19 if} {\cf19 not} yuv_format.startswith({\cf22 "yuv"}):\par
00070                         base_external = {\cf17 True}\par
00071                     {\cf19 elif} yuv_format.endswith({\cf22 "12"}):\par
00072                         base_external = {\cf17 True}\par
00073                     {\cf19 elif} yuv_format.endswith({\cf22 "14"}):\par
00074                         base_external = {\cf17 True}\par
00075             {\cf19 else}:\par
00076                 {\cf19 if} {\cf22 'Cactus'} {\cf19 in} name {\cf19 or} {\cf22 'CanYouReadThis'} {\cf19 in} name:\par
00077                     base_run = {\cf22 "avc"}\par
00078                     base_external = {\cf17 False}\par
00079                 {\cf19 elif} {\cf22 'ParkRunning3'} {\cf19 in} name:\par
00080                     base_run = {\cf22 "hevc"}\par
00081                     {\cf19 if} {\cf22 '12bit'} {\cf19 in} name {\cf19 or} {\cf22 '14bit'} {\cf19 in} name:\par
00082                         base_external = {\cf17 True}\par
00083                     {\cf19 else}:\par
00084                         base_external = {\cf17 False}\par
00085                 {\cf19 else}:\par
00086                     NameError\par
00087         {\cf19 else}:\par
00088             base_run = base\par
00089             base_external = {\cf17 False}\par
00090 \par
00091 \par
00092         decode_arguments = [\par
00093             os.path.abspath(decoder),\par
00094             f{\cf22 "--base_encoder=\{base_run\}"},\par
00095             f{\cf22 "--encapsulation=nal"},\par
00096             f{\cf22 "--input_file=\{filename\}"},\par
00097             f{\cf22 "--output_file=\{name\}.yuv"}\par
00098         ]\par
00099 \par
00100         {\cf19 if} base_external:\par
00101             decode_arguments.append({\cf22 "--base_external=true"})\par
00102 \par
00103         {\cf20 # Decode}\par
00104         decoder_ok = run_subprocess(f{\cf22 "  Decode \{name\}"}, decode_arguments,\par
00105                                     f{\cf22 "\{name\}_decoder.log"}, show_progress={\cf22 'spinner'})\par
00106 \par
00107         {\cf20 # Decode checksum}\par
00108         {\cf19 if} decoder_ok:\par
00109             decoded_checksum = hash_md5(f{\cf22 "\{name\}.yuv"})\par
00110             {\cf19 if} os.path.isfile(f{\cf22 "\{name\}.yuv.md5"}):\par
00111                 f = open(f{\cf22 "\{name\}.yuv.md5"}, {\cf22 "r"})\par
00112                 stored_checksum = f.readline()[0:32]\par
00113                 check_checksum = stored_checksum == decoded_checksum\par
00114                 print(f{\cf22 "Encoded vs stored checksum \{name\}: "}, check_checksum {\cf19 and} {\cf22 "OK"} {\cf19 or} {\cf22 "FAILED"})\par
00115                 {\cf19 if} {\cf19 not} check_checksum:\par
00116                     print(f{\cf22 "Decoded MD5: \{decoded_checksum\}"})\par
00117                     print(f{\cf22 "Stored MD5:  \{stored_checksum\}"})\par
00118             {\cf19 else}:\par
00119                 print(f{\cf22 "MD5 \{name\}.yuv  --  \{decoded_checksum\}"})\par
00120 \par
00121             {\cf20 # Check Userdata Files}\par
00122             {\cf19 if} os.path.isfile(f{\cf22 "\{name\}_userdata.bin"}):\par
00123                 {\cf19 if} os.path.isfile({\cf22 "userdata_dec.bin"}):\par
00124                     userdata = filecmp.cmp(f{\cf22 "\{name\}_userdata.bin"}, {\cf22 "userdata_dec.bin"})\par
00125                     os.remove({\cf22 "userdata_dec.bin"})\par
00126                 {\cf19 else}:\par
00127                     userdata = {\cf17 False}    \par
00128                 print(f{\cf22 "Userdata Comparison \{name\}: "}, userdata {\cf19 and} {\cf22 "OK"} {\cf19 or} {\cf22 "FAILED"})\par
00129 \par
00130             {\cf20 # Remove temporary files}\par
00131             {\cf19 try}:\par
00132                 os.remove(f{\cf22 "\{name\}.yuv"})\par
00133                 {\cf20 # os.remove(f"\{name\}_decoder.log")}\par
00134             {\cf19 except} FileNotFoundError:\par
00135                 {\cf19 pass}\par
00136         {\cf19 else}:\par
00137             print(f{\cf22 "decode FAILED: \{name\}"})\par
00138 \par
00139 \par
00140 {\cf19 if} __name__ == {\cf22 "__main__"}:\par
00141     {\cf17 import} argparse\par
