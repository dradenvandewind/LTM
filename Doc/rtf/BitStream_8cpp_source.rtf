00330 uint32_t InputBitstream::readOutTrailingBits ()\par
00331 \{\par
00332   uint32_t count=0;\par
00333   uint32_t uiBits = 0;\par
00334 \par
00335   {\cf19 while} ( ( getNumBitsLeft() > 0 ) && (getNumBitsUntilByteAligned()!=0) )\par
00336   \{\par
00337     count++;\par
00338     read ( 1, uiBits );\par
00339   \}\par
00340   {\cf19 return} count;\par
00341 \}\par
