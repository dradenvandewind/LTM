00397 uint32_t InputBitstream::readByteAlignment()\par
00398 \{\par
00399   uint32_t code = 0;\par
00400   read( 1, code );\par
00401   CHECK(code != 1, {\cf22 "Code is not '1'"});\par
00402 \par
00403   uint32_t numBits = getNumBitsUntilByteAligned();\par
00404   {\cf19 if}(numBits)\par
00405   \{\par
00406     CHECK(numBits > getNumBitsLeft(), {\cf22 "More bits available than left"});\par
00407     read( numBits, code );\par
00408     CHECK(code != 0, {\cf22 "Code not '0'"});\par
00409   \}\par
00410   {\cf19 return} numBits+1;\par
00411 \}\par
