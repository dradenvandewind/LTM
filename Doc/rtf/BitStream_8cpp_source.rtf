00359 InputBitstream *InputBitstream::extractSubstream( uint32_t uiNumBits )\par
00360 \{\par
00361   uint32_t uiNumBytes = uiNumBits/8;\par
00362   InputBitstream *pResult = {\cf17 new} InputBitstream;\par
00363 \par
00364   std::vector<uint8_t> &buf = pResult->getFifo();\par
00365   buf.reserve((uiNumBits+7)>>3);\par
00366 \par
00367   {\cf19 if} (m_num_held_bits == 0)\par
00368   \{\par
00369     std::size_t currentOutputBufferSize=buf.size();\par
00370     {\cf17 const} uint32_t uiNumBytesToReadFromFifo = std::min<uint32_t>(uiNumBytes, (uint32_t)m_fifo.size() - m_fifo_idx);\par
00371     buf.resize(currentOutputBufferSize+uiNumBytes);\par
00372     memcpy(&(buf[currentOutputBufferSize]), &(m_fifo[m_fifo_idx]), uiNumBytesToReadFromFifo); m_fifo_idx+=uiNumBytesToReadFromFifo;\par
00373     {\cf19 if} (uiNumBytesToReadFromFifo != uiNumBytes)\par
00374     \{\par
00375       memset(&(buf[currentOutputBufferSize+uiNumBytesToReadFromFifo]), 0, uiNumBytes - uiNumBytesToReadFromFifo);\par
00376     \}\par
00377   \}\par
00378   {\cf19 else}\par
00379   \{\par
00380     {\cf19 for} (uint32_t ui = 0; ui < uiNumBytes; ui++)\par
00381     \{\par
00382       uint32_t uiByte;\par
00383       read(8, uiByte);\par
00384       buf.push_back(uiByte);\par
00385     \}\par
00386   \}\par
00387   {\cf19 if} (uiNumBits&0x7)\par
00388   \{\par
00389     uint32_t uiByte = 0;\par
00390     read(uiNumBits&0x7, uiByte);\par
00391     uiByte <<= 8-(uiNumBits&0x7);\par
00392     buf.push_back(uiByte);\par
00393   \}\par
00394   {\cf19 return} pResult;\par
00395 \}\par
