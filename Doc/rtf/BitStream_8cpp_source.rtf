00200 {\cf18 int} OutputBitstream::countStartCodeEmulations()\par
00201 \{\par
00202   uint32_t cnt = 0;\par
00203   vector<uint8_t>& rbsp   = getFIFO();\par
00204   {\cf19 for} (vector<uint8_t>::iterator it = rbsp.begin(); it != rbsp.end();)\par
00205   \{\par
00206     vector<uint8_t>::iterator found = it;\par
00207     {\cf19 do}\par
00208     \{\par
00209       {\cf20 // find the next emulated 00 00 \{00,01,02,03\}}\par
00210       {\cf20 // NB, end()-1, prevents finding a trailing two byte sequence}\par
00211       found = search_n(found, rbsp.end()-1, 2, 0);\par
00212       found++;\par
00213       {\cf20 // if not found, found == end, otherwise found = second zero byte}\par
00214       {\cf19 if} (found == rbsp.end())\par
00215       \{\par
00216         {\cf19 break};\par
00217       \}\par
00218       {\cf19 if} (*(++found) <= 3)\par
00219       \{\par
00220         {\cf19 break};\par
00221       \}\par
00222     \} {\cf19 while} ({\cf17 true});\par
00223     it = found;\par
00224     {\cf19 if} (found != rbsp.end())\par
00225     \{\par
00226       cnt++;\par
00227     \}\par
00228   \}\par
00229   {\cf19 return} cnt;\par
00230 \}\par
