00112 {\cf18 void} OutputBitstream::write   ( uint32_t uiBits, uint32_t uiNumberOfBits )\par
00113 \{\par
00114   CHECK( uiNumberOfBits > 32, {\cf22 "Number of bits is exceeds '32'"} );\par
00115   CHECK( uiNumberOfBits != 32 && (uiBits & (~0 << uiNumberOfBits)) != 0, {\cf22 "Unsupported parameters"} );\par
00116 \par
00117   {\cf20 /* any modulo 8 remainder of num_total_bits cannot be written this time,}\par
00118 {\cf20    * and will be held until next time. */}\par
00119   uint32_t num_total_bits = uiNumberOfBits + m_num_held_bits;\par
00120   uint32_t next_num_held_bits = num_total_bits % 8;\par
00121 \par
00122   {\cf20 /* form a byte aligned word (write_bits), by concatenating any held bits}\par
00123 {\cf20    * with the new bits, discarding the bits that will form the next_held_bits.}\par
00124 {\cf20    * eg: H = held bits, V = n new bits        /---- next_held_bits}\par
00125 {\cf20    * len(H)=7, len(V)=1: ... ---- HHHH HHHV . 0000 0000, next_num_held_bits=0}\par
00126 {\cf20    * len(H)=7, len(V)=2: ... ---- HHHH HHHV . V000 0000, next_num_held_bits=1}\par
00127 {\cf20    * if total_bits < 8, the value of v_ is not used */}\par
00128   uint8_t next_held_bits = uiBits << (8 - next_num_held_bits);\par
00129 \par
00130   {\cf19 if} (!(num_total_bits >> 3))\par
00131   \{\par
00132     {\cf20 /* insufficient bits accumulated to write out, append new_held_bits to}\par
00133 {\cf20      * current held_bits */}\par
00134     {\cf20 /* NB, this requires that v only contains 0 in bit positions \{31..n\} */}\par
00135     m_held_bits |= next_held_bits;\par
00136     m_num_held_bits = next_num_held_bits;\par
00137     {\cf19 return};\par
00138   \}\par
00139 \par
00140   {\cf20 /* topword serves to justify held_bits to align with the msb of uiBits */}\par
00141   uint32_t topword = (uiNumberOfBits - next_num_held_bits) & ~((1 << 3) -1);\par
00142   uint32_t write_bits = (m_held_bits << topword) | (uiBits >> next_num_held_bits);\par
00143 \par
00144   {\cf19 switch} (num_total_bits >> 3)\par
00145   \{\par
00146   {\cf19 case} 4: m_fifo.push_back(write_bits >> 24);\par
00147   {\cf19 case} 3: m_fifo.push_back(write_bits >> 16);\par
00148   {\cf19 case} 2: m_fifo.push_back(write_bits >> 8);\par
00149   {\cf19 case} 1: m_fifo.push_back(write_bits);\par
00150   \}\par
00151 \par
00152   m_held_bits = next_held_bits;\par
00153   m_num_held_bits = next_num_held_bits;\par
00154 \}\par
00155 \par
00156 {\cf18 void} OutputBitstream::writeAlignOne()\par
00157 \{\par
00158   uint32_t num_bits = getNumBitsUntilByteAligned();\par
00159   write((1 << num_bits) - 1, num_bits);\par
00160   {\cf19 return};\par
00161 \}\par
00162 \par
00163 {\cf18 void} OutputBitstream::writeAlignZero()\par
00164 \{\par
00165   {\cf19 if} (0 == m_num_held_bits)\par
00166   \{\par
00167     {\cf19 return};\par
00168   \}\par
00169   m_fifo.push_back(m_held_bits);\par
00170   m_held_bits = 0;\par
00171   m_num_held_bits = 0;\par
00172 \}\par
00173 \par
00179 {\cf18 void}   OutputBitstream::addSubstream( OutputBitstream* pcSubstream )\par
00180 \{\par
00181   uint32_t uiNumBits = pcSubstream->getNumberOfWrittenBits();\par
00182 \par
00183   {\cf17 const} vector<uint8_t>& rbsp = pcSubstream->getFIFO();\par
00184   {\cf19 for} (vector<uint8_t>::const_iterator it = rbsp.begin(); it != rbsp.end();)\par
00185   \{\par
00186     write(*it++, 8);\par
00187   \}\par
00188   {\cf19 if} (uiNumBits&0x7)\par
00189   \{\par
00190     write(pcSubstream->getHeldBits()>>(8-(uiNumBits&0x7)), uiNumBits&0x7);\par
00191   \}\par
00192 \}\par
