00240 {\cf18 void} InputBitstream::pseudoRead ( uint32_t uiNumberOfBits, uint32_t& ruiBits )\par
00241 \{\par
00242   uint32_t saved_num_held_bits = m_num_held_bits;\par
00243   uint8_t saved_held_bits = m_held_bits;\par
00244   uint32_t saved_fifo_idx = m_fifo_idx;\par
00245 \par
00246   uint32_t num_bits_to_read = min(uiNumberOfBits, getNumBitsLeft());\par
00247   read(num_bits_to_read, ruiBits);\par
00248   ruiBits <<= (uiNumberOfBits - num_bits_to_read);\par
00249 \par
00250   m_fifo_idx = saved_fifo_idx;\par
00251   m_held_bits = saved_held_bits;\par
00252   m_num_held_bits = saved_num_held_bits;\par
00253 \}\par
00254 \par
00255 \par
00256 {\cf18 void} InputBitstream::read (uint32_t uiNumberOfBits, uint32_t& ruiBits)\par
00257 \{\par
00258   CHECK( uiNumberOfBits > 32, {\cf22 "Too many bits read"} );\par
00259 \par
00260   m_numBitsRead += uiNumberOfBits;\par
00261 \par
00262   {\cf20 /* NB, bits are extracted from the MSB of each byte. */}\par
00263   uint32_t retval = 0;\par
00264   {\cf19 if} (uiNumberOfBits <= m_num_held_bits)\par
00265   \{\par
00266     {\cf20 /* n=1, len(H)=7:   -VHH HHHH, shift_down=6, mask=0xfe}\par
00267 {\cf20      * n=3, len(H)=7:   -VVV HHHH, shift_down=4, mask=0xf8}\par
00268 {\cf20      */}\par
00269     retval = m_held_bits >> (m_num_held_bits - uiNumberOfBits);\par
00270     retval &= ~(0xff << uiNumberOfBits);\par
00271     m_num_held_bits -= uiNumberOfBits;\par
00272     ruiBits = retval;\par
00273     {\cf19 return};\par
00274   \}\par
00275 \par
00276   {\cf20 /* all num_held_bits will go into retval}\par
00277 {\cf20    *   => need to mask leftover bits from previous extractions}\par
00278 {\cf20    *   => align retval with top of extracted word */}\par
00279   {\cf20 /* n=5, len(H)=3: ---- -VVV, mask=0x07, shift_up=5-3=2,}\par
00280 {\cf20    * n=9, len(H)=3: ---- -VVV, mask=0x07, shift_up=9-3=6 */}\par
00281   uiNumberOfBits -= m_num_held_bits;\par
00282   retval = m_held_bits & ~(0xff << m_num_held_bits);\par
00283   retval <<= uiNumberOfBits;\par
00284 \par
00285   {\cf20 /* number of whole bytes that need to be loaded to form retval */}\par
00286   {\cf20 /* n=32, len(H)=0, load 4bytes, shift_down=0}\par
00287 {\cf20    * n=32, len(H)=1, load 4bytes, shift_down=1}\par
00288 {\cf20    * n=31, len(H)=1, load 4bytes, shift_down=1+1}\par
00289 {\cf20    * n=8,  len(H)=0, load 1byte,  shift_down=0}\par
00290 {\cf20    * n=8,  len(H)=3, load 1byte,  shift_down=3}\par
00291 {\cf20    * n=5,  len(H)=1, load 1byte,  shift_down=1+3}\par
00292 {\cf20    */}\par
00293   uint32_t aligned_word = 0;\par
00294   uint32_t num_bytes_to_load = (uiNumberOfBits - 1) >> 3;\par
00295   CHECK(m_fifo_idx + num_bytes_to_load >= m_fifo.size(), {\cf22 "Exceeded FIFO size"});\par
00296 \par
00297   {\cf19 switch} (num_bytes_to_load)\par
00298   \{\par
00299   {\cf19 case} 3: aligned_word  = m_fifo[m_fifo_idx++] << 24;\par
00300   {\cf19 case} 2: aligned_word |= m_fifo[m_fifo_idx++] << 16;\par
00301   {\cf19 case} 1: aligned_word |= m_fifo[m_fifo_idx++] <<  8;\par
00302   {\cf19 case} 0: aligned_word |= m_fifo[m_fifo_idx++];\par
00303   \}\par
00304 \par
00305   {\cf20 /* resolve remainder bits */}\par
00306   uint32_t next_num_held_bits = (32 - uiNumberOfBits) % 8;\par
00307 \par
00308   {\cf20 /* copy required part of aligned_word into retval */}\par
00309   retval |= aligned_word >> next_num_held_bits;\par
00310 \par
00311   {\cf20 /* store held bits */}\par
00312   m_num_held_bits = next_num_held_bits;\par
00313   m_held_bits = aligned_word;\par
00314 \par
00315   ruiBits = retval;\par
00316 \}\par
00317 \par
00322 {\cf18 void} OutputBitstream::insertAt({\cf17 const} OutputBitstream& src, uint32_t pos)\par
00323 \{\par
00324   CHECK(0 != src.getNumberOfWrittenBits() % 8, {\cf22 "Number of written bits is not a multiple of 8"});\par
00325 \par
00326   vector<uint8_t>::iterator at = m_fifo.begin() + pos;\par
00327   m_fifo.insert(at, src.m_fifo.begin(), src.m_fifo.end());\par
00328 \}\par
