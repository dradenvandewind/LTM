00311 \{\par
00312    {\cf18 int} i, add;\par
00313 \par
00314   {\cf19 if} (real_structure==FRAME)\par
00315   \{\par
00316     \par
00317     flush_pending_output(p_Vid, p_out);\par
00318     write_out_picture(p_Vid, p, p_out);\par
00319     {\cf19 return};\par
00320   \}\par
00321   {\cf19 if} (real_structure == p_Vid->pending_output_state)\par
00322   \{\par
00323     flush_pending_output(p_Vid, p_out);\par
00324     write_picture(p_Vid, p, p_out, real_structure);\par
00325     {\cf19 return};\par
00326   \}\par
00327 \par
00328   {\cf19 if} (p_Vid->pending_output_state == FRAME)\par
00329   \{\par
00330     p_Vid->pending_output->size_x = p->size_x;\par
00331     p_Vid->pending_output->size_y = p->size_y;\par
00332     p_Vid->pending_output->size_x_cr = p->size_x_cr;\par
