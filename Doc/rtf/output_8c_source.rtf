00387       write_picture (p_Vid, p, p_out, real_structure);\par
00388       {\cf19 return};\par
00389     \}\par
00390     {\cf20 // copy second field}\par
00391     {\cf19 if} (real_structure == TOP_FIELD)\par
00392     \{\par
00393       add = 0;\par
00394     \}\par
00395     {\cf19 else}\par
00396     \{\par
00397       add = 1;\par
00398     \}\par
00399 \par
00400     {\cf19 for} (i=0; i<p_Vid->pending_output->size_y; i+=2)\par
00401     \{\par
00402       memcpy(p_Vid->pending_output->imgY[(i+add)], p->imgY[(i+add)], p->size_x * {\cf17 sizeof}(imgpel));\par
00403     \}\par
00404     {\cf19 for} (i=0; i<p_Vid->pending_output->size_y_cr; i+=2)\par
