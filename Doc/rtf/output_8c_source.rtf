00659       ret = write(p_out, buf, symbol_size_in_bytes * (p->size_y-crop_bottom-crop_top)/2 * (p->size_x-crop_right-crop_left)/2 );\par
00660       {\cf19 if} (ret != (symbol_size_in_bytes * (p->size_y-crop_bottom-crop_top)/2 * (p->size_x-crop_right-crop_left)/2))\par
00661       \{\par
00662         error ({\cf22 "write_out_picture: error writing to YUV file"}, 500);\par
00663       \}\par
00664       free(buf);\par
00665       free_mem3Dpel(p->imgUV);\par
00666       p->imgUV=NULL;\par
00667     \}\par
00668   \}\par
00669 \par
00670   {\cf20 //free(buf);}\par
00671  {\cf19 if}(p_out >=0)\par
00672    pDecPic->bValid = 0;\par
00673 \par
00674   {\cf20 //  fsync(p_out);}\par
00675 \}\par
00676 \par
