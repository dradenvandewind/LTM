00349     clear_picture(p_Vid, p_Vid->pending_output);\par
00350 \par
00351     {\cf20 // copy first field}\par
00352     {\cf19 if} (real_structure == TOP_FIELD)\par
00353     \{\par
00354       add = 0;\par
00355     \}\par
00356     {\cf19 else}\par
00357     \{\par
00358       add = 1;\par
00359     \}\par
00360 \par
00361     {\cf19 for} (i=0; i<p_Vid->pending_output->size_y; i+=2)\par
00362     \{\par
00363       memcpy(p_Vid->pending_output->imgY[(i+add)], p->imgY[(i+add)], p->size_x * {\cf17 sizeof}(imgpel));\par
00364     \}\par
00365     {\cf19 for} (i=0; i<p_Vid->pending_output->size_y_cr; i+=2)\par
00366     \{\par
00367       memcpy(p_Vid->pending_output->imgUV[0][(i+add)], p->imgUV[0][(i+add)], p->size_x_cr * {\cf17 sizeof}(imgpel));\par
00368       memcpy(p_Vid->pending_output->imgUV[1][(i+add)], p->imgUV[1][(i+add)], p->size_x_cr * {\cf17 sizeof}(imgpel));\par
00369     \}\par
00370     p_Vid->pending_output_state = real_structure;\par
00371   \}\par
00372   {\cf19 else}\par
00373   \{\par
00374     {\cf19 if} (  (p_Vid->pending_output->size_x!=p->size_x) || (p_Vid->pending_output->size_y!= p->size_y)\par
00375        || (p_Vid->pending_output->frame_mbs_only_flag != p->frame_mbs_only_flag)\par
00376        || (p_Vid->pending_output->frame_cropping_flag != p->frame_cropping_flag)\par
