00752 {\cf18 void} write_unpaired_field(VideoParameters *p_Vid, FrameStore* fs, {\cf18 int} p_out)\par
00753 \{\par
00754   StorablePicture *p;\par
00755   assert (fs->is_used<3);\par
00756 \par
00757   {\cf19 if}(fs->is_used & 0x01)\par
00758   \{\par
00759     {\cf20 // we have a top field}\par
00760     {\cf20 // construct an empty bottom field}\par
00761     p = fs->top_field;\par
00762     fs->bottom_field = alloc_storable_picture(p_Vid, BOTTOM_FIELD, p->size_x, 2*p->size_y, p->size_x_cr, 2*p->size_y_cr, 1);\par
00763     fs->bottom_field->chroma_format_idc = p->chroma_format_idc;\par
00764     clear_picture(p_Vid, fs->bottom_field);\par
00765     dpb_combine_field_yuv(p_Vid, fs);\par
00766 {\cf21 #if (MVC_EXTENSION_ENABLE)}\par
00767     fs->frame->view_id = fs->view_id;\par
00768 {\cf21 #endif}\par
00769     write_picture (p_Vid, fs->frame, p_out, TOP_FIELD);\par
00770   \}\par
00771 \par
00772   {\cf19 if}(fs->is_used & 0x02)\par
00773   \{\par
00774     {\cf20 // we have a bottom field}\par
00775     {\cf20 // construct an empty top field}\par
00776     p = fs->bottom_field;\par
00777     fs->top_field = alloc_storable_picture(p_Vid, TOP_FIELD, p->size_x, 2*p->size_y, p->size_x_cr, 2*p->size_y_cr, 1);\par
00778     fs->top_field->chroma_format_idc = p->chroma_format_idc;\par
00779     clear_picture(p_Vid, fs->top_field);\par
00780     fs ->top_field->frame_cropping_flag = fs->bottom_field->frame_cropping_flag;\par
00781     {\cf19 if}(fs ->top_field->frame_cropping_flag)\par
00782     \{\par
00783       fs ->top_field->frame_crop_top_offset = fs->bottom_field->frame_crop_top_offset;\par
00784       fs ->top_field->frame_crop_bottom_offset = fs->bottom_field->frame_crop_bottom_offset;\par
00785       fs ->top_field->frame_crop_left_offset = fs->bottom_field->frame_crop_left_offset;\par
00786       fs ->top_field->frame_crop_right_offset = fs->bottom_field->frame_crop_right_offset;\par
00787     \}\par
00788     dpb_combine_field_yuv(p_Vid, fs);\par
00789 {\cf21 #if (MVC_EXTENSION_ENABLE)}\par
00790     fs->frame->view_id = fs->view_id;\par
00791 {\cf21 #endif}\par
00792     write_picture (p_Vid, fs->frame, p_out, BOTTOM_FIELD);\par
00793   \}\par
00794 \par
00795   fs->is_used = 3;\par
00796 \}\par
00797 \par
00809 {\cf18 void} flush_direct_output(VideoParameters *p_Vid, {\cf18 int} p_out)\par
00810 \{\par
00811   write_unpaired_field(p_Vid, p_Vid->out_buffer, p_out);\par
00812 \par
00813   free_storable_picture(p_Vid->out_buffer->frame);\par
00814   p_Vid->out_buffer->frame = NULL;\par
00815   free_storable_picture(p_Vid->out_buffer->top_field);\par
00816   p_Vid->out_buffer->top_field = NULL;\par
00817   free_storable_picture(p_Vid->out_buffer->bottom_field);\par
00818   p_Vid->out_buffer->bottom_field = NULL;\par
00819   p_Vid->out_buffer->is_used = 0;\par
00820 \}\par
00821 \par
00822 \par
00836 {\cf18 void} write_stored_frame( VideoParameters *p_Vid, FrameStore *fs, {\cf18 int} p_out)\par
00837 \{\par
00838   {\cf20 // make sure no direct output field is pending}\par
00839   flush_direct_output(p_Vid, p_out);\par
00840 \par
00841   {\cf19 if} (fs->is_used<3)\par
00842   \{\par
00843     write_unpaired_field(p_Vid, fs, p_out);\par
00844   \}\par
00845   {\cf19 else}\par
00846   \{\par
00847     {\cf19 if} (fs->recovery_frame)\par
00848       p_Vid->recovery_flag = 1;\par
00849     {\cf19 if} ((!p_Vid->non_conforming_stream) || p_Vid->recovery_flag)\par
00850       write_picture(p_Vid, fs->frame, p_out, FRAME);\par
00851   \}\par
00852 \par
00853   fs->is_output = 1;\par
00854 \}\par
00855 \par
00870 {\cf18 void} direct_output(VideoParameters *p_Vid, StorablePicture *p, {\cf18 int} p_out)\par
00871 \{\par
00872   InputParameters *p_Inp = p_Vid->p_Inp;\par
00873   {\cf19 if} (p->structure==FRAME)\par
00874   \{\par
00875     {\cf20 // we have a frame (or complementary field pair)}\par
00876     {\cf20 // so output it directly}\par
00877     flush_direct_output(p_Vid, p_out);\par
00878     write_picture (p_Vid, p, p_out, FRAME);\par
00879     calculate_frame_no(p_Vid, p);\par
00880     {\cf19 if} (-1 != p_Vid->p_ref && !p_Inp->silent)\par
00881       find_snr(p_Vid, p, &p_Vid->p_ref);\par
00882     free_storable_picture(p);\par
00883     {\cf19 return};\par
00884   \}\par
00885 \par
00886   {\cf19 if} (p->structure == TOP_FIELD)\par
00887   \{\par
00888     {\cf19 if} (p_Vid->out_buffer->is_used &1)\par
00889       flush_direct_output(p_Vid, p_out);\par
00890     p_Vid->out_buffer->top_field = p;\par
00891     p_Vid->out_buffer->is_used |= 1;\par
00892   \}\par
00893 \par
00894   {\cf19 if} (p->structure == BOTTOM_FIELD)\par
00895   \{\par
00896     {\cf19 if} (p_Vid->out_buffer->is_used &2)\par
00897       flush_direct_output(p_Vid, p_out);\par
00898     p_Vid->out_buffer->bottom_field = p;\par
00899     p_Vid->out_buffer->is_used |= 2;\par
00900   \}\par
00901 \par
00902   {\cf19 if} (p_Vid->out_buffer->is_used == 3)\par
00903   \{\par
00904     {\cf20 // we have both fields, so output them}\par
00905     dpb_combine_field_yuv(p_Vid, p_Vid->out_buffer);\par
00906 {\cf21 #if (MVC_EXTENSION_ENABLE)}\par
00907     p_Vid->out_buffer->frame->view_id = p_Vid->out_buffer->view_id;\par
00908 {\cf21 #endif}\par
00909     write_picture (p_Vid, p_Vid->out_buffer->frame, p_out, FRAME);\par
00910 \par
00911     calculate_frame_no(p_Vid, p);\par
00912     {\cf19 if} (-1 != p_Vid->p_ref && !p_Inp->silent)\par
00913       find_snr(p_Vid, p_Vid->out_buffer->frame, &p_Vid->p_ref);\par
00914     free_storable_picture(p_Vid->out_buffer->frame);\par
00915     p_Vid->out_buffer->frame = NULL;\par
00916     free_storable_picture(p_Vid->out_buffer->top_field);\par
00917     p_Vid->out_buffer->top_field = NULL;\par
00918     free_storable_picture(p_Vid->out_buffer->bottom_field);\par
00919     p_Vid->out_buffer->bottom_field = NULL;\par
00920     p_Vid->out_buffer->is_used = 0;\par
00921   \}\par
00922 \}\par
00923 \par
}
