00717 {\cf18 void} clear_picture(VideoParameters *p_Vid, StorablePicture *p)\par
00718 \{\par
00719   {\cf18 int} i,j;\par
00720 \par
00721   {\cf19 for}(i=0;i<p->size_y;i++)\par
00722   \{\par
00723     {\cf19 for} (j=0; j<p->size_x; j++)\par
00724       p->imgY[i][j] = (imgpel) p_Vid->dc_pred_value_comp[0];\par
00725   \}\par
00726   {\cf19 for}(i=0;i<p->size_y_cr;i++)\par
00727   \{\par
00728     {\cf19 for} (j=0; j<p->size_x_cr; j++)\par
00729       p->imgUV[0][i][j] = (imgpel) p_Vid->dc_pred_value_comp[1];\par
00730   \}\par
00731   {\cf19 for}(i=0;i<p->size_y_cr;i++)\par
00732   \{\par
00733     {\cf19 for} (j=0; j<p->size_x_cr; j++)\par
00734       p->imgUV[1][i][j] = (imgpel) p_Vid->dc_pred_value_comp[2];\par
00735   \}\par
00736 \}\par
