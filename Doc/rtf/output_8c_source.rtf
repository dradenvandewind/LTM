00083 {\cf17 static} {\cf18 void} img2buf_normal (imgpel** imgX, {\cf18 unsigned} {\cf18 char}* buf, {\cf18 int} size_x, {\cf18 int} size_y, {\cf18 int} symbol_size_in_bytes, {\cf18 int} crop_left, {\cf18 int} crop_right, {\cf18 int} crop_top, {\cf18 int} crop_bottom, {\cf18 int} iOutStride)\par
00084 \{\par
00085   {\cf18 int} i,j;\par
00086 \par
00087   {\cf18 int} twidth  = size_x - crop_left - crop_right;\par
00088   {\cf18 int} theight = size_y - crop_top - crop_bottom;\par
00089 \par
00090   {\cf18 int} size = 0;\par
00091 \par
00092   {\cf20 // sizeof (imgpel) > sizeof(char)}\par
00093   {\cf20 // little endian}\par
00094   {\cf19 if} ({\cf17 sizeof} (imgpel) < symbol_size_in_bytes)\par
00095   \{\par
00096     {\cf20 // this should not happen. we should not have smaller imgpel than our source material.}\par
00097     size = {\cf17 sizeof} (imgpel);\par
00098     {\cf20 // clear buffer}\par
00099     {\cf19 for}(j=0; j<theight; j++)\par
00100       memset (buf+j*iOutStride, 0, (twidth * symbol_size_in_bytes));\par
00101   \}\par
00102   {\cf19 else}\par
00103   \{\par
00104     size = symbol_size_in_bytes;\par
00105   \}\par
00106 \par
00107   {\cf19 if} ((crop_top || crop_bottom || crop_left || crop_right) || (size != 1))\par
00108   \{\par
00109     {\cf19 for}(i=crop_top; i<size_y-crop_bottom; i++)\par
00110     \{\par
00111       {\cf18 int} ipos = (i - crop_top) * iOutStride;\par
00112       {\cf19 for}(j=crop_left; j<size_x-crop_right; j++)\par
00113       \{\par
00114         memcpy(buf+(ipos+(j-crop_left)*symbol_size_in_bytes),&(imgX[i][j]), size);\par
00115       \}\par
00116     \}\par
00117   \}\par
00118   {\cf19 else}\par
00119   \{\par
00120 {\cf21 #if (IMGTYPE == 0)}\par
00121     {\cf20 //if (sizeof(imgpel) == sizeof(char))}\par
00122     \{\par
00123       {\cf20 //memcpy(buf, &(imgX[0][0]), size_y * size_x * sizeof(imgpel));}\par
00124       {\cf19 for}(j=0; j<size_y; j++)\par
00125         memcpy(buf+j*iOutStride, imgX[j], size_x*{\cf17 sizeof}(imgpel));\par
00126     \}\par
00127     {\cf20 //else}\par
00128 {\cf21 #else}\par
00129     \{\par
00130       imgpel *cur_pixel;\par
00131       {\cf18 unsigned} {\cf18 char} *pDst;\par
00132       {\cf19 for}(j = 0; j < size_y; j++)\par
00133       \{\par
00134         cur_pixel = imgX[j];\par
00135         pDst = buf +j*iOutStride;\par
00136         {\cf19 for}(i=0; i < size_x; i++)\par
00137           *(pDst++)=({\cf18 unsigned} char)*(cur_pixel++);\par
00138       \}\par
00139     \}\par
00140 {\cf21 #endif}\par
00141   \}\par
00142 \}\par
00143 \par
00168 {\cf17 static} {\cf18 void} img2buf_byte (imgpel** imgX, {\cf18 unsigned} {\cf18 char}* buf, {\cf18 int} size_x, {\cf18 int} size_y, {\cf18 int} symbol_size_in_bytes, {\cf18 int} crop_left, {\cf18 int} crop_right, {\cf18 int} crop_top, {\cf18 int} crop_bottom, {\cf18 int} iOutStride)\par
00169 \{\par
00170   {\cf18 int} twidth  = size_x - crop_left - crop_right;\par
00171   {\cf18 int} theight = size_y - crop_top - crop_bottom;\par
00172   imgpel **img = &imgX[crop_top];\par
00173   {\cf18 int} i;\par
00174   {\cf19 for}(i = 0; i < theight; i++) \par
00175   \{\par
00176     memcpy(buf, *img++ + crop_left, twidth);\par
00177     buf += iOutStride;\par
00178   \}\par
00179 \}\par
00180 \par
00205 {\cf17 static} {\cf18 void} img2buf_endian (imgpel** imgX, {\cf18 unsigned} {\cf18 char}* buf, {\cf18 int} size_x, {\cf18 int} size_y, {\cf18 int} symbol_size_in_bytes, {\cf18 int} crop_left, {\cf18 int} crop_right, {\cf18 int} crop_top, {\cf18 int} crop_bottom, {\cf18 int} iOutStride)\par
00206 \{\par
00207   {\cf18 int} i,j;\par
00208   {\cf18 unsigned} {\cf18 char}  ui8;\par
00209   uint16 tmp16, ui16;\par
00210   {\cf18 unsigned} {\cf18 long}  tmp32, ui32;\par
00211 \par
00212   {\cf20 //int twidth  = size_x - crop_left - crop_right;}\par
00213 \par
00214   {\cf20 // big endian}\par
00215   {\cf19 switch} (symbol_size_in_bytes)\par
00216   \{\par
00217   {\cf19 case} 1:\par
00218     \{\par
00219       {\cf19 for}(i=crop_top;i<size_y-crop_bottom;i++)\par
00220       \{\par
00221         {\cf19 for}(j=crop_left;j<size_x-crop_right;j++)\par
00222         \{\par
00223           ui8 = ({\cf18 unsigned} char) (imgX[i][j]);\par
00224           buf[(j-crop_left+((i-crop_top)*iOutStride))] = ui8;\par
00225         \}\par
00226       \}\par
00227       {\cf19 break};\par
00228     \}\par
00229   {\cf19 case} 2:\par
00230     \{\par
00231       {\cf19 for}(i=crop_top;i<size_y-crop_bottom;i++)\par
00232       \{\par
00233         {\cf19 for}(j=crop_left;j<size_x-crop_right;j++)\par
00234         \{\par
00235           tmp16 = (uint16) (imgX[i][j]);\par
00236           ui16  = (uint16) ((tmp16 >> 8) | ((tmp16&0xFF)<<8));\par
00237           memcpy(buf+((j-crop_left+((i-crop_top)*iOutStride))*2),&(ui16), 2);\par
00238         \}\par
00239       \}\par
00240       {\cf19 break};\par
00241     \}\par
00242   {\cf19 case} 4:\par
00243     \{\par
00244       {\cf19 for}(i=crop_top;i<size_y-crop_bottom;i++)\par
00245       \{\par
00246         {\cf19 for}(j=crop_left;j<size_x-crop_right;j++)\par
00247         \{\par
00248           tmp32 = ({\cf18 unsigned} long) (imgX[i][j]);\par
00249           ui32  = ({\cf18 unsigned} long) (((tmp32&0xFF00)<<8) | ((tmp32&0xFF)<<24) | ((tmp32&0xFF0000)>>8) | ((tmp32&0xFF000000)>>24));\par
00250           memcpy(buf+((j-crop_left+((i-crop_top)*iOutStride))*4),&(ui32), 4);\par
00251         \}\par
00252       \}\par
00253       {\cf19 break};\par
00254     \}\par
00255   {\cf19 default}:\par
00256     \{\par
00257       error ({\cf22 "writing only to formats of 8, 16 or 32 bit allowed on big endian architecture"}, 500);\par
00258       {\cf19 break};\par
00259     \}\par
00260   \}\par
