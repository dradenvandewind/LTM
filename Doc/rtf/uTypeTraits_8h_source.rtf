00040     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00041     {\cf20 // IntegralConstant - used to generate a compile time value constant that can be used for}\par
00042     {\cf20 // conditions checking.}\par
00043     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00044 \par
00045     {\cf17 template}<{\cf17 class} T, T v> {\cf17 struct }IntegralConstant \{ {\cf17 static} {\cf17 const} T Value = v; \};\par
00046     {\cf17 typedef} IntegralConstant<bool, true> TrueType;\par
00047     {\cf17 typedef} IntegralConstant<bool, false> FalseType;\par
00048 \par
00049     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00050     {\cf20 // IsIntegral - Compile time helper that indicates if a type is integral. These have been }\par
00051     {\cf20 // limited to the explicit types we utilise.}\par
00052     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00053 \par
00054     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsIntegral                      : {\cf17 public} FalseType \{\};\par
00055     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsIntegral<const T>             : {\cf17 public} IsIntegral<T> \{\};  {\cf20 // Helper to strip const from T.}\par
00056     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsIntegral<volatile T>          : {\cf17 public} IsIntegral<T> \{\};  {\cf20 // Helper to strip volatile from T.}\par
00057     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsIntegral<volatile const T>    : {\cf17 public} IsIntegral<T> \{\};  {\cf20 // Helper to strip volatile const from T.}\par
00058     {\cf17 template}<> {\cf17 struct }IsIntegral<uint8_t>                       : {\cf17 public} TrueType \{\};\par
00059     {\cf17 template}<> {\cf17 struct }IsIntegral<uint16_t>                      : {\cf17 public} TrueType \{\};\par
00060     {\cf17 template}<> {\cf17 struct }IsIntegral<uint32_t>                      : {\cf17 public} TrueType \{\};\par
00061     {\cf17 template}<> {\cf17 struct }IsIntegral<uint64_t>                      : {\cf17 public} TrueType \{\};\par
00062     {\cf17 template}<> {\cf17 struct }IsIntegral<int8_t>                        : {\cf17 public} TrueType \{\};\par
00063     {\cf17 template}<> {\cf17 struct }IsIntegral<int16_t>                       : {\cf17 public} TrueType \{\};\par
00064     {\cf17 template}<> {\cf17 struct }IsIntegral<int32_t>                       : {\cf17 public} TrueType \{\};\par
00065     {\cf17 template}<> {\cf17 struct }IsIntegral<int64_t>                       : {\cf17 public} TrueType \{\};\par
00066     {\cf17 template}<> {\cf17 struct }IsIntegral<bool>                          : {\cf17 public} TrueType \{\};\par
00067 \par
00068     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00069     {\cf20 // IsFloat - Compile time helper that indicates if a type is floating pointer. These have been }\par
00070     {\cf20 // limited to the explicit types we utilise.}\par
00071     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00072 \par
00073     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsFloat                         : {\cf17 public} FalseType \{\};\par
00074     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsFloat<const T>                : {\cf17 public} IsFloat<T> \{\};     {\cf20 // Helper to strip const from T.}\par
00075     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsFloat<volatile T>             : {\cf17 public} IsFloat<T> \{\};     {\cf20 // Helper to strip volatile from T.}\par
00076     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsFloat<volatile const T>       : {\cf17 public} IsFloat<T> \{\};     {\cf20 // Helper to strip volatile const from T.}\par
00077     {\cf17 template}<> {\cf17 struct }IsFloat<float>                            : {\cf17 public} TrueType \{\};\par
00078     {\cf17 template}<> {\cf17 struct }IsFloat<double>                           : {\cf17 public} TrueType \{\};\par
00079 \par
00080     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00081     {\cf20 // IsSigned - Compile time helper that indicates if a type is signed. These have been }\par
00082     {\cf20 // limited to the explicit types we utilise.}\par
00083     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00084 \par
00085     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsSigned                        : {\cf17 public} FalseType \{\};\par
00086     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsSigned<const T>               : {\cf17 public} IsSigned<T> \{\};    {\cf20 // Helper to strip const from T.}\par
00087     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsSigned<volatile T>            : {\cf17 public} IsSigned<T> \{\};    {\cf20 // Helper to strip volatile from T.}\par
00088     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsSigned<volatile const T>      : {\cf17 public} IsSigned<T> \{\};    {\cf20 // Helper to strip volatile const from T.}\par
00089     {\cf17 template}<> {\cf17 struct }IsSigned<uint8_t>                         : {\cf17 public} FalseType \{\};\par
00090     {\cf17 template}<> {\cf17 struct }IsSigned<uint16_t>                        : {\cf17 public} FalseType \{\};\par
00091     {\cf17 template}<> {\cf17 struct }IsSigned<uint32_t>                        : {\cf17 public} FalseType \{\};\par
00092     {\cf17 template}<> {\cf17 struct }IsSigned<uint64_t>                        : {\cf17 public} FalseType \{\};\par
00093     {\cf17 template}<> {\cf17 struct }IsSigned<int8_t>                          : {\cf17 public} TrueType \{\};\par
00094     {\cf17 template}<> {\cf17 struct }IsSigned<int16_t>                         : {\cf17 public} TrueType \{\};\par
00095     {\cf17 template}<> {\cf17 struct }IsSigned<int32_t>                         : {\cf17 public} TrueType \{\};\par
00096     {\cf17 template}<> {\cf17 struct }IsSigned<int64_t>                         : {\cf17 public} TrueType \{\};\par
00097 \par
00098     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00099     {\cf20 // IsEnum - Compile time helper that indicates if a type is an enum.}\par
00100     {\cf20 // @note: Uses C++11 feature std::is_enum, disable if on an unsupporting compiler.}\par
00101     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00102 \par
00103     {\cf17 template}<{\cf17 typename} T> {\cf17 struct }IsEnum                          : {\cf17 public} IntegralConstant<typename std::is_enum<T>::value_type, std::is_enum<T>::value> \{\};\par
00104 \par
00105     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00106     {\cf20 // Low bit mask - Generates an integer with the lowest N contiguous bits set of the supplied}\par
00107     {\cf20 // integer type.}\par
00108     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00109 \par
00110     {\cf17 template}<{\cf17 typename} INTEGER_TYPE, u{\cf18 int}32_t Bits>\par
00111     {\cf17 struct }LowBitMask\par
00112     \{\par
00113         VNStaticAssert(Bits <= ({\cf17 sizeof}(INTEGER_TYPE) * 8));\par
00114         {\cf17 static} {\cf17 const} INTEGER_TYPE Value = (1 << Bits) - 1;\par
00115     \};\par
00116 \par
00117     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00118     {\cf20 // MinValue - Generates the minimum value represented by the lowest N contiguous bits, }\par
00119     {\cf20 // accounting for a signed bit when INTEGER_TYPE is signed.}\par
00120     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00121 \par
00122     {\cf17 template}<{\cf17 typename} INTEGER_TYPE, u{\cf18 int}32_t Bits>\par
00123     {\cf17 struct }MinValue\par
00124     \{\par
00125         {\cf17 static} {\cf17 const} INTEGER_TYPE Value = IsSigned<INTEGER_TYPE>::Value ? ~(LowBitMask<INTEGER_TYPE, Bits>::Value) : 0;\par
00126     \};\par
00127 \par
00128     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00129     {\cf20 // MaxValue - Generates the maximum value represented by the lowest N contiguous bits.}\par
00130     {\cf20 // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}\par
00131 \par
00132     {\cf17 template}<{\cf17 typename} INTEGER_TYPE, u{\cf18 int}32_t Bits>\par
00133     {\cf17 struct }MaxValue\par
00134     \{\par
00135         {\cf17 static} {\cf17 const} INTEGER_TYPE Value = LowBitMask<INTEGER_TYPE, Bits>::Value;\par
00136     \};\par
00137 \}\}\par
