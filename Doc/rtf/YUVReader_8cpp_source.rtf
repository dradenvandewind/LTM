00138 {\cf17 static} ImageDescription ParseYUVFilename({\cf17 const} {\cf18 string} &name, {\cf18 float} *pRate) \{\par
00139 \par
00140     ImageFormat image_format = IMAGE_FORMAT_NONE;\par
00141     {\cf18 unsigned} width = 0;\par
00142     {\cf18 unsigned} height = 0;\par
00143 \par
00144     {\cf20 // Parse filename for picture description}\par
00145     {\cf20 //}\par
00146     vector<string> parts;\par
00147     split(parts, name, ({\cf22 "-_."}));\par
00148 \par
00149     {\cf17 static} {\cf17 const} regex dimensions_re({\cf22 "([0-9]+)x([0-9]+)"});                     {\cf20 // Size}\par
00150     {\cf17 static} {\cf17 const} regex fps_re({\cf22 "([0-9]+)(fps|hz)"});                             {\cf20 // Hz}\par
00151     {\cf17 static} {\cf17 const} regex bits_re({\cf22 "([0-9]+)(bits?|bpp)"});                         {\cf20 // Bit depth}\par
00152     {\cf17 static} {\cf17 const} regex format_re({\cf22 "(420|420p|p420|422|p422|422p|yuv|yuyv|y|)"}); {\cf20 // Format}\par
00153 \par
00154     {\cf18 string} format;\par
00155     {\cf18 int} bits = -1;\par
00156 \par
00157     {\cf19 for} ({\cf17 auto} {\cf17 const} p : parts) \{\par
00158         cmatch m;\par
00159         {\cf17 const} {\cf18 string} lp = lowercase(p);\par
00160 \par
00161         {\cf19 if} (regex_match(lp.c_str(), m, dimensions_re)) \{\par
00162             width = stoi(m[1]);\par
00163             height = stoi(m[2]);\par
00164         \}\par
00165 \par
00166         {\cf19 if} (regex_match(p.c_str(), m, fps_re)) \{\par
00167             {\cf19 if} (pRate)\par
00168                 *pRate = stof(m[1].str());\par
00169         \}\par
00170 \par
00171         {\cf19 if} (regex_match(p.c_str(), m, bits_re)) \{\par
00172             bits = stoi(m[1].str());\par
00173         \}\par
00174 \par
00175         {\cf19 if} (regex_match(p.c_str(), m, format_re)) \{\par
00176             {\cf19 if} (format.empty())\par
00177                 format = lowercase(m[1].str());\par
00178         \}\par
00179     \}\par
00180 \par
00181     {\cf19 for} ({\cf18 size_t} i = 0; i < ARRAY_SIZE(KnownFormats); ++i)\par
00182         {\cf19 if} (format == KnownFormats[i].name && bits == KnownFormats[i].bits)\par
00183             image_format = KnownFormats[i].format;\par
00184 \par
00185     {\cf19 return} ImageDescription(image_format, width, height);\par
00186 \}\par
00187 \par
00188 {\cf20 // Open file for reading, given explicit format}\par
00189 {\cf20 //}\par
00190 std::unique_ptr<YUVReader> CreateYUVReader({\cf17 const} std::string &name, {\cf17 const} ImageDescription &description, {\cf18 unsigned} rate) \{\par
00191     {\cf20 // Is file there?}\par
00192     {\cf17 const} uintmax_t fileSize = file_size(name);\par
00193     {\cf19 if} (fileSize == {\cf17 static_cast<}uintmax_t{\cf17 >}(-1))\par
00194         {\cf19 return} 0;\par
00195 \par
00196     {\cf20 // Figure length}\par
00197     {\cf18 unsigned} length = {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(fileSize / description.byte_size());\par
00198 \par
00199     {\cf19 if} (length == 0)\par
00200         ERR({\cf22 "YUV file is too small"});\par
00201 \par
00202     UniquePtrFile yuvFile(std::fopen(name.c_str(), {\cf22 "rb"}));\par
00203 \par
00204     {\cf19 if} (yuvFile)\par
00205         {\cf19 return} unique_ptr<YUVReader>({\cf17 new} YUVReader(name, description, length, ({\cf18 float})rate, yuvFile.release(), fileSize));\par
00206 \par
00207     ERR({\cf22 "Cannot open YUV file"});\par
00208     {\cf19 return} 0;\par
00209 \}\par
00210 \par
00211 {\cf20 // Open file for reading, format is inferred from filename}\par
00212 {\cf20 //}\par
00213 unique_ptr<YUVReader> CreateYUVReader({\cf17 const} {\cf18 string} &name) \{\par
00214     {\cf20 // Does it have a sensible name?}\par
00215     {\cf18 float} rate = 25.0f;\par
00216     ImageDescription description = ParseYUVFilename(name, &rate);\par
00217     {\cf19 if} (description.format() == IMAGE_FORMAT_NONE)\par
00218         ERR({\cf22 "Cannot parse YUV filename"});\par
00219 \par
00220     {\cf19 return} CreateYUVReader(name, description, ({\cf18 unsigned})rate);\par
00221 \}\par
