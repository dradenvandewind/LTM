00055 {\cf17 using namespace }std;\par
00056 \par
00057 YUVReader::YUVReader({\cf17 const} std::string &name, {\cf18 float} rate, FILE *file, uintmax_t fileSize)\par
00058     : name_(name), length_(0), rate_(rate), file_(file), fileSize_(fileSize) \{\}\par
00059 \par
00060 YUVReader::YUVReader({\cf17 const} std::string &name, {\cf17 const} ImageDescription &image_description, {\cf18 unsigned} length, {\cf18 float} rate, FILE *file,\par
00061                      uintmax_t fileSize)\par
00062     : name_(name), image_description_(image_description), length_(length), rate_(rate), file_(file), fileSize_(fileSize) \{\}\par
00063 \par
00064 {\cf18 void} YUVReader::update_data({\cf17 const} ImageDescription &image_description) \{\par
00065     {\cf19 if} (fileSize_ == {\cf17 static_cast<}uintmax_t{\cf17 >}(-1))\par
00066         ERR({\cf22 "Cannot open YUV file"});\par
00067 \par
00068     {\cf20 // Figure length}\par
00069     {\cf18 unsigned} length = {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(fileSize_ / image_description.byte_size());\par
00070 \par
00071     {\cf19 if} (length == 0)\par
00072         ERR({\cf22 "YUV file is too small"});\par
00073 \par
00074     image_description_ = image_description;\par
00075     length_ = length;\par
00076 \par
00077     {\cf19 return};\par
00078 \}\par
00079 \par
00080 {\cf18 void} YUVReader::set_position({\cf18 unsigned} position){\cf17  const }\{\par
00081     CHECK(position < length_);\par
00082     position_ = position;\par
00083     CHECK(fseeko(file_.get(), (uint64_t)position_ * (uint64_t)image_description_.byte_size(), SEEK_SET) == 0);\par
00084 \}\par
00085 \par
00086 {\cf20 // Get image from frame position}\par
00087 Image YUVReader::read({\cf18 unsigned} position, uint64_t timestamp){\cf17  const }\{\par
00088     set_position(position);\par
00089 \par
00090     std::vector<Surface> surfaces;\par
00091 \par
00092     {\cf19 for} ({\cf18 unsigned} p = 0; p < image_description_.num_planes(); ++p) \{\par
00093         {\cf17 auto} b = Surface::build_from<int8_t>();\par
00094         b.reserve_bpp(image_description_.width(p), image_description_.height(p), image_description_.byte_depth(),\par
00095                       image_description_.row_stride(p));\par
00096         {\cf19 if} (image_description_.rows_are_contiguous(p)) \{\par
00097             {\cf19 if} (fread(b.data(), image_description_.plane_size(p), 1, file_.get()) != 1)\par
00098                 ERR({\cf22 "Cannot read YUV file"});\par
00099         \} {\cf19 else} \{\par
00100             {\cf19 for} ({\cf18 unsigned} y = 0; y < image_description_.height(p); ++y) \{\par
00101                 {\cf19 if} (fread(b.data(0, y), image_description_.row_size(p), 1, file_.get()) != 1)\par
00102                     ERR({\cf22 "Cannot read YUV file"});\par
00103             \}\par
00104         \}\par
00105         surfaces.push_back(b.finish());\par
00106     \}\par
00107 \par
00108     {\cf19 return} Image(format({\cf22 "%s:%d"}, name_.c_str(), position_), image_description_, timestamp, surfaces);\par
00109 \}\par
00110 \par
00111 {\cf20 // Parse the picture details from the filename}\par
00112 {\cf20 //}\par
00113 {\cf20 // Uses roughly the same conventions as Vooya and YUVDeluxe}\par
00114 {\cf20 //}\par
00115 {\cf20 // Returns a description - if format == PF_NONE, then no format was recognised}\par
00116 {\cf20 // If a rate is recognized, and pRate != NULL, then the frame rate will be stored through that pointer}\par
00117 {\cf20 //}\par
00118 \par
00119 {\cf20 // Map of format names to internal version}\par
00120 {\cf17 static} {\cf17 const} {\cf17 struct }\{\par
00121     {\cf17 const} {\cf18 char} *name;\par
00122     {\cf18 int} bits;\par
00123     ImageFormat format;\par
00124 \} KnownFormats[] = \{\par
00125     \{{\cf22 "420"}, -1, IMAGE_FORMAT_YUV420P8\},  \{{\cf22 "420p"}, -1, IMAGE_FORMAT_YUV420P8\},  \{{\cf22 "p420"}, -1, IMAGE_FORMAT_YUV420P8\},\par
00126     \{{\cf22 "yuv"}, -1, IMAGE_FORMAT_YUV420P8\},\par
00127 \par
00128     \{{\cf22 "420"}, 8, IMAGE_FORMAT_YUV420P8\},   \{{\cf22 "420p"}, 8, IMAGE_FORMAT_YUV420P8\},   \{{\cf22 "p420"}, 8, IMAGE_FORMAT_YUV420P8\},\par
00129     \{{\cf22 "yuv"}, 8, IMAGE_FORMAT_YUV420P8\},\par
00130 \par
00131     \{{\cf22 "420"}, 10, IMAGE_FORMAT_YUV420P10\}, \{{\cf22 "420p"}, 10, IMAGE_FORMAT_YUV420P10\}, \{{\cf22 "p420"}, 10, IMAGE_FORMAT_YUV420P10\},\par
00132     \{{\cf22 "yuv"}, 10, IMAGE_FORMAT_YUV420P10\},\par
00133 \par
00134     \{{\cf22 "y"}, 8, IMAGE_FORMAT_Y8\},           \{{\cf22 "y"}, 10, IMAGE_FORMAT_Y10\},          \{{\cf22 "y"}, 16, IMAGE_FORMAT_Y16\},\par
