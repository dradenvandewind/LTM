00156 \par
00157     {\cf19 case} StateDecoding:\par
00158         context->decoder_thread_ = std::thread([context] \{\par
00159                 context->decode();\par
00160                 context->decoded_images_.push({\cf17 nullptr});\par
00161             \});\par
00162 \par
00163         context->state_ = StateFlushing;\par
00164         {\cf20 /* Fall through */}\par
00165 \par
00166     {\cf19 case} StateFlushing:\par
00167         context->decoded_images_.pop(context->decoded_image_);\par
00168         {\cf19 if}(context->decoded_image_) \{\par
00169             *image = context->decoded_image_->image_;\par
00170             *eos = 0;\par
00171             {\cf19 return} 1;\par
00172         \} {\cf19 else} \{\par
00173             {\cf19 if}(context->decoder_thread_.joinable())\par
00174                 context->decoder_thread_.join();\par
00175             *eos = 1;\par
00176             {\cf19 return} 0;\par
00177         \}\par
00178     {\cf19 default}:\par
00179         ERR({\cf22 "Unexpected decoder state"});\par
00180     \}\par
00181     {\cf19 return} 0;\par
00182 \}\par
