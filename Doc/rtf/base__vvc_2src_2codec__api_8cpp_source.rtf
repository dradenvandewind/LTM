00112 {\cf20 // Push encoded data into decoder}\par
00113 {\cf20 //}\par
00114 {\cf17 static} int32_t push_packet(CodecContext c, {\cf17 const} uint8_t *data, {\cf18 size_t} length, CodecMetadata metadata, int8_t eos, CodecError *error) \{\par
00115     Context *context = (Context *)c;\par
00116     {\cf19 if}(error)\par
00117         *error = 0;\par
00118 \par
00119     {\cf19 switch}(context->state_) \{\par
00120     {\cf19 case} StatePushing:\par
00121         {\cf19 if}(!eos) \{\par
00122             CHECK(data);\par
00123             CHECK(length >= 3);\par
00124             {\cf20 // Fixup NALU start code - if first is 3 bytes, make it 4}\par
00125             {\cf19 if} (data[0] == {\cf23 '\\0'} && data[1] == {\cf23 '\\0'} && data[2] == {\cf23 '\\1'}) \{\par
00126                 {\cf18 char} {\cf17 const} zero = {\cf23 '\\0'};\par
00127                 context->base_bitstream_.put(0);\par
00128             \}\par
00129 \par
00130             {\cf20 // Accumulate AUs into a temporary buffer}\par
00131             context->base_bitstream_.write(({\cf17 const} {\cf18 char} *)data, length);\par
00132         \} {\cf19 else} \{\par
00134             context->state_ = StateDecoding;\par
00135 \par
00136             {\cf20 // XXXX}\par
00137         \}\par
00138         {\cf19 return} 0;\par
00139 \par
