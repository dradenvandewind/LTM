00146 {\cf17 static} int32_t pull_image(CodecContext c, CodecImage* image, CodecMetadata *metadata, int8_t* eos, CodecError *error)\{\par
00147     Context *context = (Context *)c;\par
00148     {\cf19 if}(error)\par
00149         *error = 0;\par
00150 \par
00151     {\cf19 switch}(context->state_) \{\par
00152     {\cf19 case} StatePushing:\par
00153         {\cf20 // Still accumulating input stream}\par
00154         *eos = 0;\par
