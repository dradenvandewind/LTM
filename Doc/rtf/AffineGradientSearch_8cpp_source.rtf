00053 AffineGradientSearch::AffineGradientSearch()\par
00054 \{\par
00055   m_HorizontalSobelFilter = xHorizontalSobelFilter;\par
00056   m_VerticalSobelFilter = xVerticalSobelFilter;\par
00057   m_EqualCoeffComputer = xEqualCoeffComputer;\par
