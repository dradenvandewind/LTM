00066 {\cf18 void} AffineGradientSearch::xHorizontalSobelFilter( Pel *{\cf17 const} pPred, {\cf17 const} {\cf18 int} predStride, {\cf18 int} *{\cf17 const} pDerivate, {\cf17 const} {\cf18 int} derivateBufStride, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height )\par
00067 \{\par
00068   {\cf19 for} ( {\cf18 int} j = 1; j < height - 1; j++ )\par
00069   \{\par
00070     {\cf19 for} ( {\cf18 int} k = 1; k < width - 1; k++ )\par
00071     \{\par
00072       {\cf18 int} iCenter = j * predStride + k;\par
00073 \par
00074       pDerivate[j * derivateBufStride + k] =\par
00075         (pPred[iCenter + 1 - predStride] -\par
00076           pPred[iCenter - 1 - predStride] +\par
00077           (pPred[iCenter + 1] << 1) -\par
00078           (pPred[iCenter - 1] << 1) +\par
00079           pPred[iCenter + 1 + predStride] -\par
00080           pPred[iCenter - 1 + predStride]);\par
00081     \}\par
00082 \par
00083     pDerivate[j * derivateBufStride] = pDerivate[j * derivateBufStride + 1];\par
00084     pDerivate[j * derivateBufStride + width - 1] = pDerivate[j * derivateBufStride + width - 2];\par
00085   \}\par
00086 \par
00087   pDerivate[0] = pDerivate[derivateBufStride + 1];\par
00088   pDerivate[width - 1] = pDerivate[derivateBufStride + width - 2];\par
00089   pDerivate[(height - 1) * derivateBufStride] = pDerivate[(height - 2) * derivateBufStride + 1];\par
00090   pDerivate[(height - 1) * derivateBufStride + width - 1] = pDerivate[(height - 2) * derivateBufStride + (width - 2)];\par
00091 \par
00092   {\cf19 for} ( {\cf18 int} j = 1; j < width - 1; j++ )\par
00093   \{\par
00094     pDerivate[j] = pDerivate[derivateBufStride + j];\par
00095     pDerivate[(height - 1) * derivateBufStride + j] = pDerivate[(height - 2) * derivateBufStride + j];\par
00096   \}\par
00097 \}\par
00098 \par
00099 {\cf18 void} AffineGradientSearch::xVerticalSobelFilter( Pel *{\cf17 const} pPred, {\cf17 const} {\cf18 int} predStride, {\cf18 int} *{\cf17 const} pDerivate, {\cf17 const} {\cf18 int} derivateBufStride, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height )\par
00100 \{\par
00101   {\cf19 for} ( {\cf18 int} k = 1; k < width - 1; k++ )\par
00102   \{\par
00103     {\cf19 for} ( {\cf18 int} j = 1; j < height - 1; j++ )\par
00104     \{\par
00105       {\cf18 int} iCenter = j * predStride + k;\par
00106 \par
00107       pDerivate[j * derivateBufStride + k] =\par
00108         (pPred[iCenter + predStride - 1] -\par
00109           pPred[iCenter - predStride - 1] +\par
00110           (pPred[iCenter + predStride] << 1) -\par
00111           (pPred[iCenter - predStride] << 1) +\par
00112           pPred[iCenter + predStride + 1] -\par
00113           pPred[iCenter - predStride + 1]);\par
00114     \}\par
00115 \par
00116     pDerivate[k] = pDerivate[derivateBufStride + k];\par
00117     pDerivate[(height - 1) * derivateBufStride + k] = pDerivate[(height - 2) * derivateBufStride + k];\par
00118   \}\par
00119 \par
00120   pDerivate[0] = pDerivate[derivateBufStride + 1];\par
00121   pDerivate[width - 1] = pDerivate[derivateBufStride + width - 2];\par
00122   pDerivate[(height - 1) * derivateBufStride] = pDerivate[(height - 2) * derivateBufStride + 1];\par
00123   pDerivate[(height - 1) * derivateBufStride + width - 1] = pDerivate[(height - 2) * derivateBufStride + (width - 2)];\par
00124 \par
00125   {\cf19 for} ( {\cf18 int} j = 1; j < height - 1; j++ )\par
00126   \{\par
00127     pDerivate[j * derivateBufStride] = pDerivate[j * derivateBufStride + 1];\par
00128     pDerivate[j * derivateBufStride + width - 1] = pDerivate[j * derivateBufStride + width - 2];\par
00129   \}\par
00130 \}\par
00131 \par
00132 {\cf18 void} AffineGradientSearch::xEqualCoeffComputer( Pel *pResidue, {\cf18 int} residueStride, {\cf18 int} **ppDerivate, {\cf18 int} derivateBufStride, int64_t( *pEqualCoeff )[7], {\cf18 int} width, {\cf18 int} height, {\cf18 bool} b6Param )\par
00133 \{\par
00134   {\cf18 int} affineParamNum = b6Param ? 6 : 4;\par
00135 \par
00136   {\cf19 for} ( {\cf18 int} j = 0; j != height; j++ )\par
00137   \{\par
00138     {\cf18 int} cy = ((j >> 2) << 2) + 2;\par
00139     {\cf19 for} ( {\cf18 int} k = 0; k != width; k++ )\par
00140     \{\par
00141       {\cf18 int} iC[6];\par
00142 \par
00143       {\cf18 int} idx = j * derivateBufStride + k;\par
00144       {\cf18 int} cx = ((k >> 2) << 2) + 2;\par
00145       {\cf19 if} ( !b6Param )\par
00146       \{\par
00147         iC[0] = ppDerivate[0][idx];\par
00148         iC[1] = cx * ppDerivate[0][idx] + cy * ppDerivate[1][idx];\par
00149         iC[2] = ppDerivate[1][idx];\par
00150         iC[3] = cy * ppDerivate[0][idx] - cx * ppDerivate[1][idx];\par
00151       \}\par
00152       {\cf19 else}\par
00153       \{\par
00154         iC[0] = ppDerivate[0][idx];\par
00155         iC[1] = cx * ppDerivate[0][idx];\par
00156         iC[2] = ppDerivate[1][idx];\par
00157         iC[3] = cx * ppDerivate[1][idx];\par
00158         iC[4] = cy * ppDerivate[0][idx];\par
00159         iC[5] = cy * ppDerivate[1][idx];\par
00160       \}\par
00161       {\cf19 for} ( {\cf18 int} col = 0; col < affineParamNum; col++ )\par
00162       \{\par
00163         {\cf19 for} ( {\cf18 int} row = 0; row < affineParamNum; row++ )\par
00164         \{\par
00165           pEqualCoeff[col + 1][row] += (int64_t)iC[col] * iC[row];\par
00166         \}\par
00167         pEqualCoeff[col + 1][affineParamNum] += ((int64_t)iC[col] * pResidue[idx]) << 3;\par
00168       \}\par
00169     \}\par
00170   \}\par
00171 \}\par
00172 \par
