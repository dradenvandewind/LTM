00046 {\cf20 // Extract the single-bit-per-transform signalling as a mask}\par
00047 {\cf20 //}\par
00048 Surface TemporalExtractMask::process({\cf17 const} Surface &symbols) \{\par
00049     {\cf17 const} {\cf17 auto} src_symbols = symbols.view_as<int16_t>();\par
00050 \par
00051 {\cf21 #if defined __OPT_MATRIX__}\par
00052     {\cf17 auto} dest = Surface::build_from<uint8_t>();\par
00053     dest.reserve(src_symbols.width(), src_symbols.height());\par
00054     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_symbols.height(); ++y) \{\par
00055         {\cf17 const} int16_t *__restrict psrc = src_symbols.data(0, y);\par
00056         uint8_t *__restrict pdst = dest.data(0, y);\par
00057         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_symbols.width(); ++x) \{\par
00058             {\cf20 // dest.write(x, y, (src_symbols.read(x, y) & 1) ? TemporalType::TEMPORAL_INTR : TemporalType::TEMPORAL_PRED);}\par
00059             *pdst++ = ((*psrc++ & 1) ? TemporalType::TEMPORAL_INTR : TemporalType::TEMPORAL_PRED);\par
00060         \}\par
00061     \}\par
00062     {\cf19 return} dest.finish();\par
00063 {\cf21 #else}\par
00064     {\cf19 return} Surface::build_from<uint8_t>()\par
00065         .generate(src_symbols.width(), src_symbols.height(),\par
00066                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{\par
00067                       return (src_symbols.read(x, y) & 1) ? TemporalType::TEMPORAL_INTR : TemporalType::TEMPORAL_PRED;\par
00068                   \})\par
00069         .finish();\par
00070 {\cf21 #endif}\par
00071 \}\par
00072 \par
00073 {\cf20 // Filter out the single-bit-per-transform signalling as a mask}\par
00074 {\cf20 //}\par
00075 Surface TemporalClear::process({\cf17 const} Surface &symbols) \{\par
00076     {\cf17 const} {\cf17 auto} src_symbols = symbols.view_as<int16_t>();\par
00077 \par
00078 {\cf21 #if defined __OPT_MATRIX__}\par
00079     {\cf17 auto} dest = Surface::build_from<int16_t>();\par
00080     dest.reserve(src_symbols.width(), src_symbols.height());\par
00081     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_symbols.height(); ++y) \{\par
00082         {\cf17 const} int16_t *__restrict psrc = src_symbols.data(0, y);\par
00083         int16_t *__restrict pdst = dest.data(0, y);\par
00084         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_symbols.width(); ++x) \{\par
00085             {\cf20 // dest.write(x, y, (src_symbols.read(x, y) >> 1));}\par
00086             *pdst++ = (*psrc++ >> 1);\par
00087         \}\par
00088     \}\par
00089     {\cf19 return} dest.finish();\par
00090 {\cf21 #else}\par
00091     {\cf19 return} Surface::build_from<int16_t>()\par
00092         .generate(src_symbols.width(), src_symbols.height(),\par
00093                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{ return src_symbols.read(x, y) >> 1; \})\par
00094         .finish();\par
00095 {\cf21 #endif}\par
00096 \}\par
00097 \par
00098 {\cf20 // Combine the previous temporal buffer, the current residuals and the signalling mask to make a new temporal buffer}\par
00099 {\cf20 //}\par
00100 Surface TemporalUpdate::process({\cf17 const} Surface &temporal_plane, {\cf17 const} Surface &residuals_plane, Surface &mask_plane,\par
00101                                 {\cf18 unsigned} transform_block_size, {\cf18 bool} per_picture_intra, {\cf18 bool} use_reduced_signalling) \{\par
00102     {\cf19 if} (mask_plane.empty()) \{\par
00103         mask_plane = Surface::build_from<uint8_t>()\par
00104                          .generate(residuals_plane.width() / transform_block_size, residuals_plane.height() / transform_block_size,\par
00105                                    [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{ return TemporalType::TEMPORAL_INTR; \})\par
00106                          .finish();\par
00107     \}\par
00108     {\cf17 const} {\cf17 auto} src_temporal = temporal_plane.view_as<int16_t>();\par
00109     {\cf17 const} {\cf17 auto} src_residuals = residuals_plane.view_as<int16_t>();\par
00110     {\cf17 const} {\cf17 auto} src_mask = mask_plane.view_as<uint8_t>();\par
00111 \par
00112     {\cf17 const} {\cf18 unsigned} tb_shift = log2(transform_block_size);\par
00113     {\cf17 const} {\cf18 unsigned} d = 32 / transform_block_size;\par
00114 \par
00115 {\cf21 #if defined __OPT_MATRIX__}\par
00116     {\cf17 auto} dest = Surface::build_from<int16_t>();\par
00117     dest.reserve(src_temporal.width(), src_temporal.height());\par
00118     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_temporal.height(); ++y) \{\par
00119         {\cf17 const} int16_t *__restrict psrc = src_residuals.data(0, y);\par
00120         int16_t *__restrict pdst = dest.data(0, y);\par
00121         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_temporal.width(); ++x) \{\par
00122             {\cf17 const} {\cf18 bool} per_tile_intra =\par
00123                 use_reduced_signalling && (src_mask.read((x >> 5) * d, (y >> 5) * d) == TemporalType::TEMPORAL_INTR);\par
00124             {\cf17 const} {\cf18 bool} per_block_intra = (src_mask.read(x >> tb_shift, y >> tb_shift) == TemporalType::TEMPORAL_INTR);\par
00125             {\cf20 // int16_t out = 0;}\par
00126             {\cf19 if} (per_picture_intra || per_tile_intra || per_block_intra) \{\par
00127                 {\cf20 // out = src_residuals.read(x, y);}\par
00128                 *pdst++ = *psrc++;\par
00129             \} {\cf19 else} \{\par
00130                 {\cf20 // out = src_residuals.read(x, y) + src_temporal.read(x, y);}\par
00131                 *pdst++ = *psrc++ + src_temporal.read(x, y);\par
00132             \}\par
00133             {\cf20 // dest.write(x, y, out);}\par
00134         \}\par
00135     \}\par
00136     {\cf19 return} dest.finish();\par
00137 {\cf21 #else}\par
00138     {\cf19 return} Surface::build_from<int16_t>()\par
00139         .generate(src_temporal.width(), src_temporal.height(),\par
00140                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00141                       const bool per_tile_intra =\par
00142 #if defined __OPT_DIVISION__\par
00143                           use_reduced_signalling && (src_mask.read((x >> 5) * d, (y >> 5) * d) == TemporalType::TEMPORAL_INTR);\par
00144 #else\par
00145                           use_reduced_signalling && (src_mask.read((x / 32) * d, (y / 32) * d) == TemporalType::TEMPORAL_INTR);\par
00146 #endif\par
00147                       const bool per_block_intra = (src_mask.read(x >> tb_shift, y >> tb_shift) == TemporalType::TEMPORAL_INTR);\par
00148 \par
00149                       if (per_picture_intra || per_tile_intra || per_block_intra) \{\par
00150                           return src_residuals.read(x, y);\par
00151                       \} {\cf19 else} \{\par
00152                           return src_residuals.read(x, y) + src_temporal.read(x, y);\par
00153                       \}\par
00154                   \})\par
00155         .finish();\par
00156 {\cf21 #endif}\par
00157 \}\par
00158 \par
00159 {\cf20 // Perform a per-tile temporal decision based upon the calculated residuals}\par
00160 {\cf20 // for each pass and store result in a tile-map.}\par
00161 {\cf20 //}\par
00162 \par
00163 {\cf17 const} std::vector<SurfaceView<int16_t>> TemporalTileMap::collect_surfaces_DD(Surface symbols[MAX_NUM_LAYERS]) \{\par
00164     {\cf17 using }view_t = SurfaceView<int16_t>;\par
00165     {\cf17 const} std::vector<view_t> surfaces = \{view_t\{symbols[0]\}, view_t\{symbols[1]\}, view_t\{symbols[2]\}, view_t\{symbols[3]\}\};\par
00166     {\cf19 return} surfaces;\par
00167 \}\par
00168 \par
00169 {\cf17 const} std::vector<SurfaceView<int16_t>> TemporalTileMap::collect_surfaces_DDS(Surface symbols[MAX_NUM_LAYERS]) \{\par
00170     {\cf17 using }view_t = SurfaceView<int16_t>;\par
00171     {\cf17 const} std::vector<view_t> surfaces = \{view_t\{symbols[0]\},  view_t\{symbols[1]\},  view_t\{symbols[2]\},  view_t\{symbols[3]\},\par
00172                                           view_t\{symbols[4]\},  view_t\{symbols[5]\},  view_t\{symbols[6]\},  view_t\{symbols[7]\},\par
00173                                           view_t\{symbols[8]\},  view_t\{symbols[9]\},  view_t\{symbols[10]\}, view_t\{symbols[11]\},\par
00174                                           view_t\{symbols[12]\}, view_t\{symbols[13]\}, view_t\{symbols[14]\}, view_t\{symbols[15]\}\};\par
00175     {\cf19 return} surfaces;\par
00176 \}\par
00177 \par
00178 Surface TemporalTileMap::process(Surface intra_symbols[MAX_NUM_LAYERS], Surface inter_symbols[MAX_NUM_LAYERS],\par
00179                                  {\cf18 unsigned} transform_block_size) \{\par
00180     {\cf17 const} {\cf18 unsigned} tile_size = 32;\par
00181     {\cf17 const} {\cf18 unsigned} transforms_per_tile = tile_size / transform_block_size;\par
00182 \par
00183     {\cf17 const} {\cf18 unsigned} level_width = intra_symbols[0].width() * transform_block_size;\par
00184     {\cf17 const} {\cf18 unsigned} level_height = intra_symbols[0].height() * transform_block_size;\par
00185 \par
00186     {\cf17 const} {\cf18 unsigned} tiles_wide = (level_width + tile_size - 1) / tile_size;\par
00187     {\cf17 const} {\cf18 unsigned} tiles_high = (level_height + tile_size - 1) / tile_size;\par
00188 \par
00189     {\cf20 // These all have S=2 as template param in inverse.}\par
00190     {\cf17 const} std::vector<SurfaceView<int16_t>> srcs_intra =\par
00191         (transform_block_size == 2) ? collect_surfaces_DD(intra_symbols) : collect_surfaces_DDS(intra_symbols);\par
00192 \par
00193     {\cf17 const} std::vector<SurfaceView<int16_t>> srcs_inter =\par
00194         (transform_block_size == 2) ? collect_surfaces_DD(inter_symbols) : collect_surfaces_DDS(inter_symbols);\par
00195 \par
00196     {\cf19 return} Surface::build_from<uint8_t>()\par
00197         .generate(tiles_wide, tiles_high,\par
00198                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{\par
00199                       {\cf20 // This can be based on 2x2 regions, even for DDS.}\par
00200                       {\cf18 unsigned} both_z = 0;\par
00201                       {\cf18 unsigned} inter_nz = 0;\par
00202                       {\cf18 unsigned} inter_z = 0;\par
00203                       {\cf18 unsigned} intra_nz = 0;\par
00204                       {\cf18 unsigned} intra_z = 0;\par
00205                       {\cf18 unsigned} inter_accum = 0;\par
00206                       {\cf18 unsigned} intra_accum = 0;\par
00207                       {\cf18 unsigned} sav_mixed = 0;\par
00208 \par
00209                       {\cf19 for} ({\cf18 unsigned} tile_y = y * transforms_per_tile; tile_y < (y + 1) * transforms_per_tile; ++tile_y) \{\par
00210                           {\cf19 if} (tile_y >= intra_symbols[0].height())\par
00211                               {\cf19 continue};\par
00212 \par
00213                           {\cf19 for} ({\cf18 unsigned} tile_x = x * transforms_per_tile; tile_x < (x + 1) * transforms_per_tile; ++tile_x) \{\par
00214                               {\cf19 if} (tile_x >= intra_symbols[0].width())\par
00215                                   {\cf19 continue};\par
00216 \par
00217                               {\cf20 // for each transform in each tile.}\par
00218                               {\cf18 unsigned} intra_sav = 0;\par
00219                               {\cf18 unsigned} inter_sav = 0;\par
00220 \par
00221                               {\cf19 for} ({\cf18 unsigned} l = 0; l < transform_block_size * transform_block_size; ++l) \{\par
00222                                   intra_sav += std::abs(srcs_intra[l].read(tile_x, tile_y));\par
00223                                   inter_sav += std::abs(srcs_inter[l].read(tile_x, tile_y));\par
00224                               \}\par
00225 \par
00226                               {\cf19 if} (inter_sav == 0 && intra_sav == 0) \{\par
00227                                   both_z++;\par
00228                               \} {\cf19 else} {\cf19 if} (inter_sav == 0) \{\par
00229                                   inter_z++;\par
00230                               \} {\cf19 else} {\cf19 if} (intra_sav == 0) \{\par
00231                                   intra_z++;\par
00232                               \} {\cf19 else} {\cf19 if} (intra_sav < inter_sav) \{\par
00233                                   intra_nz++;\par
00234                               \} {\cf19 else} \{\par
00235                                   inter_nz++;\par
00236                               \}\par
00237 \par
00238                               intra_accum += intra_sav;\par
00239                               inter_accum += inter_sav;\par
00240                               {\cf20 // sav_mixed += std::min(intra_sav, inter_sav);}\par
00241                               sav_mixed += LCEVC_MIN(intra_sav, inter_sav);\par
00242                           \}\par
00243                       \}\par
00244 \par
00245                       {\cf18 unsigned} num_temporals = intra_z + intra_nz + inter_z + inter_nz;\par
00246                       {\cf18 unsigned} intra_pct = (100 * (intra_z + intra_nz)) / (num_temporals + 1);\par
00247                       {\cf18 unsigned} inter_pct = (100 * inter_z) / (num_temporals + 1);\par
00248 \par
00249                       {\cf18 unsigned} intra_accum_75 = intra_accum - (inter_accum >> 2);\par
00250                       {\cf18 unsigned} inter_accum_25 = inter_accum >> 2;\par
00251 \par
00252                       {\cf19 if} (intra_pct > 38 && inter_pct < 20 && (intra_accum_75 <= sav_mixed || inter_accum_25 > sav_mixed)) \{\par
00253                           {\cf19 return} TemporalType::TEMPORAL_INTR;\par
00254                       \}\par
00255 \par
00256                       {\cf19 return} TemporalType::TEMPORAL_PRED;\par
00257                   \})\par
00258         .finish();\par
00259 \}\par
00260 \par
00261 {\cf20 // Perform sweep updating temporal mask based upon tile type with reduced signalling.}\par
00262 {\cf20 //}\par
00263 Surface TemporalTileIntraSignal::process({\cf17 const} Surface &temporal_tile_map, {\cf17 const} Surface &mask_plane,\par
00264                                          {\cf18 unsigned} transform_block_size) \{\par
00265     {\cf17 const} {\cf18 unsigned} transforms_per_tile = 32 / transform_block_size;\par
00266     {\cf17 const} {\cf17 auto} src_tile_map = temporal_tile_map.view_as<uint8_t>();\par
00267     {\cf17 const} {\cf17 auto} src_mask_plane = mask_plane.view_as<uint8_t>();\par
00268 \par
00269     {\cf19 return} Surface::build_from<uint8_t>()\par
00270         .generate(mask_plane.width(), mask_plane.height(),\par
00271                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{\par
00272                       const unsigned tile_x = x / transforms_per_tile;\par
00273                       const unsigned tile_y = y / transforms_per_tile;\par
00274 \par
00275                       const bool tile_intra = (src_tile_map.read(tile_x, tile_y) == TemporalType::TEMPORAL_INTR);\par
00276                       const bool tile_start = ((x % transforms_per_tile) == 0) && ((y % transforms_per_tile) == 0);\par
00277 \par
00278                       if (tile_intra)\par
00279                           return TemporalType::TEMPORAL_INTR;\par
00280                       else if (tile_start)\par
00281                           return TemporalType::TEMPORAL_PRED;\par
00282 \par
00283                       {\cf20 // Pass through the mask based on cost}\par
00284                       return src_mask_plane.read(x, y);\par
00285                   \})\par
00286         .finish();\par
00287 \}\par
00288 \par
00289 {\cf20 // Clear out the symbols where the temporal tile type is intra.}\par
00290 {\cf20 //}\par
00291 Surface TemporalTileIntraClear::process(Surface &temporal_tile_map, {\cf17 const} Surface &temporal_signal_syms,\par
00292                                         {\cf18 unsigned} transform_block_size) \{\par
00293     {\cf20 // transforms_per_tile is 8 for (4x4) and 16 for (2x2)}\par
00294     {\cf17 const} {\cf18 unsigned} transforms_per_tile = 32 / transform_block_size;\par
00295     {\cf20 // when tile map is empty, create a default one}\par
00296     {\cf19 if} (temporal_tile_map.empty()) \{\par
00297         temporal_tile_map =\par
00298             Surface::build_from<uint8_t>()\par
00299                 .generate(temporal_signal_syms.width() / transforms_per_tile, temporal_signal_syms.height() / transforms_per_tile,\par
00300                           [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> uint8_t \{ return TemporalType::TEMPORAL_INTR; \})\par
00301                 .finish();\par
00302     \}\par
00303     {\cf17 const} {\cf17 auto} src_tile_map = temporal_tile_map.view_as<uint8_t>();\par
00304     {\cf17 const} {\cf17 auto} src_syms = temporal_signal_syms.view_as<int16_t>();\par
00305 \par
00306     {\cf19 return} Surface::build_from<int16_t>()\par
00307         .generate(temporal_signal_syms.width(), temporal_signal_syms.height(),\par
00308                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00309                       const unsigned tile_x = x / transforms_per_tile;\par
00310                       const unsigned tile_y = y / transforms_per_tile;\par
00311 \par
00312                       const bool tile_intra = (src_tile_map.read(tile_x, tile_y) == TemporalType::TEMPORAL_INTR);\par
00313                       const bool tile_start = ((x % transforms_per_tile) == 0) && ((y % transforms_per_tile) == 0);\par
00314 \par
00315                       if (tile_start || !tile_intra) \{\par
00316                           return src_syms.read(x, y);\par
00317                       \}\par
00318 \par
00319                       {\cf19 return} 0;\par
00320                   \})\par
00321         .finish();\par
00322 \}\par
00323 \par
00324 {\cf20 // For each block in map - zero prediction if corresponding block is set to INTRA in map}\par
00325 {\cf20 //}\par
00326 Surface ApplyTemporalMap::process({\cf17 const} Surface &src_plane, Surface &map_plane, {\cf18 unsigned} transform_block_size) \{\par
00327 \par
00328     {\cf20 // Scale the residual map to cover source image}\par
00329     {\cf20 //}\par
00330     {\cf17 const} {\cf18 unsigned} block_w = tile_size(map_plane.width(), src_plane.width());\par
00331     {\cf17 const} {\cf18 unsigned} block_h = tile_size(map_plane.height(), src_plane.height());\par
00332     {\cf17 const} {\cf18 unsigned} shift_bw = log2(block_w);\par
00333     {\cf17 const} {\cf18 unsigned} shift_bh = log2(block_h);\par
00334 \par
00335     CHECK(src_plane.width() == map_plane.width() * block_w);\par
00336     CHECK(src_plane.height() == map_plane.height() * block_h);\par
00337 \par
00338     {\cf17 const} {\cf17 auto} src = src_plane.view_as<int16_t>();\par
00339     {\cf17 const} {\cf17 auto} map = map_plane.view_as<uint8_t>();\par
00340 \par
00341 {\cf21 #if defined __OPT_MATRIX__}\par
00342     {\cf17 auto} dest = Surface::build_from<int16_t>();\par
00343     dest.reserve(src.width(), src.height());\par
00344     {\cf19 for} ({\cf18 unsigned} y = 0; y < src.height(); ++y) \{\par
00345         {\cf17 const} int16_t *__restrict psrc = src.data(0, y);\par
00346         int16_t *__restrict pdst = dest.data(0, y);\par
00347         {\cf19 for} ({\cf18 unsigned} x = 0; x < src.width(); ++x) \{\par
00348             {\cf20 // apply the "buffer refresh" per block}\par
00349             {\cf19 if} (map.read(x >> shift_bw, y >> shift_bh) == TemporalType::TEMPORAL_INTR)\par
00350                 {\cf20 // dest.write(x, y, 0);}\par
00351                 *pdst++ = 0;\par
00352             {\cf19 else}\par
00353                 {\cf20 // dest.write(x, y, src.read(x, y));}\par
00354                 *pdst++ = *psrc;\par
00355             psrc++;\par
00356         \}\par
00357     \}\par
00358     {\cf19 return} dest.finish();\par
00359 {\cf21 #else}\par
00360     {\cf19 return} Surface::build_from<int16_t>()\par
00361         .generate(src.width(), src.height(),\par
00362                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00363                       {\cf20 // apply the "buffer refresh" per block}\par
00364                       if (map.read(x >> shift_bw, y >> shift_bh) == TemporalType::TEMPORAL_INTR)\par
00365                           return 0;\par
00366                       else\par
00367                           return src.read(x, y);\par
00368                   \})\par
00369         .finish();\par
00370 {\cf21 #endif}\par
00371 \}\par
00372 \par
00373 {\cf20 // Filter out the embedded user_data}\par
00374 {\cf20 //}\par
00375 Surface UserDataClear::process({\cf17 const} Surface &symbols, UserDataMode user_data) \{\par
00376     {\cf18 unsigned} size;\par
00377     {\cf19 switch} (user_data) \{\par
00378     {\cf19 case} lctm::UserData_2bits:\par
00379         size = 2;\par
00380         {\cf19 break};\par
00381     {\cf19 case} lctm::UserData_6bits:\par
00382         size = 6;\par
00383         {\cf19 break};\par
00384     {\cf19 default}:\par
00385         CHECK(0);\par
00386         {\cf19 break};\par
00387     \}\par
00388     {\cf17 const} {\cf17 auto} src_symbols = symbols.view_as<int16_t>();\par
00389 \par
00390 {\cf21 #if defined __OPT_MATRIX__}\par
00391     {\cf17 auto} dest = Surface::build_from<int16_t>();\par
00392     dest.reserve(src_symbols.width(), src_symbols.height());\par
00393     {\cf19 for} ({\cf18 unsigned} y = 0; y < src_symbols.height(); ++y) \{\par
00394         {\cf17 const} int16_t *__restrict psrc = src_symbols.data(0, y);\par
00395         int16_t *__restrict pdst = dest.data(0, y);\par
00396         {\cf19 for} ({\cf18 unsigned} x = 0; x < src_symbols.width(); ++x) \{\par
00397             uint16_t value = *psrc++;\par
00398             value >>= size;\par
00399             {\cf18 bool} sign = (value & 0x01) == 0x00 ? {\cf17 false} : {\cf17 true};\par
00400             value >>= 1;\par
00401             *pdst++ = (int16_t)(sign ? (-value) : (value));\par
00402         \}\par
00403     \}\par
00404     {\cf19 return} dest.finish();\par
00405 {\cf21 #else}\par
00406     {\cf19 return} Surface::build_from<int16_t>()\par
00407         .generate(src_symbols.width(), src_symbols.height(),\par
00408                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00409                       uint16_t value = src_symbols.read(x, y);\par
00410                       value >>= size;\par
00411                       bool sign = (value & 0x01) == 0x00 ? false : true;\par
00412                       value >>= 1;\par
00413                       return (int16_t)(sign ? (-value) : (value));\par
00414                   \})\par
00415         .finish();\par
00416 {\cf21 #endif}\par
00417 \}\par
00418 \par
