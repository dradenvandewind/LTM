00821 Bool TVideoIOYuvMem::write( TComPicYuv* pPicYuvUserTop, TComPicYuv* pPicYuvUserBottom, {\cf17 const} InputColourSpaceConversion ipCSC, Int confLeft, Int confRight, Int confTop, Int confBottom, ChromaFormat format, {\cf17 const} Bool isTff, {\cf17 const} Bool bClipToRec709 )\par
00822 \{\par
00823 \par
00824   TComPicYuv cPicYuvTopCSCd;\par
00825   TComPicYuv cPicYuvBottomCSCd;\par
00826   {\cf19 if} (ipCSC!=IPCOLOURSPACE_UNCHANGED)\par
00827   \{\par
00828     cPicYuvTopCSCd   .createWithoutCUInfo(pPicYuvUserTop   ->getWidth(COMPONENT_Y), pPicYuvUserTop   ->getHeight(COMPONENT_Y), pPicYuvUserTop   ->getChromaFormat() );\par
00829     cPicYuvBottomCSCd.createWithoutCUInfo(pPicYuvUserBottom->getWidth(COMPONENT_Y), pPicYuvUserBottom->getHeight(COMPONENT_Y), pPicYuvUserBottom->getChromaFormat() );\par
00830     ColourSpaceConvert(*pPicYuvUserTop,    cPicYuvTopCSCd,    ipCSC, {\cf17 false});\par
00831     ColourSpaceConvert(*pPicYuvUserBottom, cPicYuvBottomCSCd, ipCSC, {\cf17 false});\par
00832   \}\par
00833   TComPicYuv *pPicYuvTop    = (ipCSC==IPCOLOURSPACE_UNCHANGED) ? pPicYuvUserTop    : &cPicYuvTopCSCd;\par
00834   TComPicYuv *pPicYuvBottom = (ipCSC==IPCOLOURSPACE_UNCHANGED) ? pPicYuvUserBottom : &cPicYuvBottomCSCd;\par
00835 \par
00836   Bool is16bit = {\cf17 false};\par
00837   Bool nonZeroBitDepthShift={\cf17 false};\par
00838 \par
00839   {\cf19 for}(UInt ch=0; ch<MAX_NUM_CHANNEL_TYPE; ch++)\par
00840   \{\par
00841     {\cf19 if} (m_fileBitdepth[ch] > 8)\par
00842     \{\par
00843       is16bit={\cf17 true};\par
00844     \}\par
00845     {\cf19 if} (m_bitdepthShift[ch] != 0)\par
00846     \{\par
00847       nonZeroBitDepthShift={\cf17 true};\par
00848     \}\par
00849   \}\par
00850 \par
00851   TComPicYuv *dstPicYuvTop    = NULL;\par
00852   TComPicYuv *dstPicYuvBottom = NULL;\par
00853 \par
00854   {\cf19 for} (UInt field = 0; field < 2; field++)\par
00855   \{\par
00856     TComPicYuv *pPicYuv = (field == 0) ? pPicYuvTop : pPicYuvBottom;\par
00857 \par
00858     {\cf19 if} (format>=NUM_CHROMA_FORMAT)\par
00859     \{\par
00860       format=pPicYuv->getChromaFormat();\par
00861     \}\par
00862 \par
00863     TComPicYuv* &dstPicYuv = (field == 0) ? dstPicYuvTop : dstPicYuvBottom;\par
00864 \par
00865     {\cf19 if} (nonZeroBitDepthShift)\par
00866     \{\par
00867       dstPicYuv = {\cf17 new} TComPicYuv;\par
00868       dstPicYuv->createWithoutCUInfo( pPicYuv->getWidth(COMPONENT_Y), pPicYuv->getHeight(COMPONENT_Y), pPicYuv->getChromaFormat() );\par
00869 \par
00870       {\cf19 for}(UInt comp=0; comp<dstPicYuv->getNumberValidComponents(); comp++)\par
00871       \{\par
00872         {\cf17 const} ComponentID compID=ComponentID(comp);\par
00873         {\cf17 const} ChannelType ch=toChannelType(compID);\par
00874         {\cf17 const} Bool b709Compliance=bClipToRec709 && (-m_bitdepthShift[ch] < 0 && m_MSBExtendedBitDepth[ch] >= 8);     {\cf20 /* ITU-R BT.709 compliant clipping for converting say 10b to 8b */}\par
00875         {\cf17 const} Pel minval = b709Compliance? ((   1 << (m_MSBExtendedBitDepth[ch] - 8))   ) : 0;\par
00876         {\cf17 const} Pel maxval = b709Compliance? ((0xff << (m_MSBExtendedBitDepth[ch] - 8)) -1) : (1 << m_MSBExtendedBitDepth[ch]) - 1;\par
00877 \par
00878         copyPlane(*pPicYuv, compID, *dstPicYuv, compID);\par
00879         scalePlane(dstPicYuv->getAddr(compID), dstPicYuv->getStride(compID), dstPicYuv->getWidth(compID), dstPicYuv->getHeight(compID), -m_bitdepthShift[ch], minval, maxval);\par
00880       \}\par
00881     \}\par
00882     {\cf19 else}\par
00883     \{\par
00884       dstPicYuv = pPicYuv;\par
00885     \}\par
00886   \}\par
00887 \par
00888   Bool retval = {\cf17 true};\par
00889 \par
00890   assert(dstPicYuvTop->getNumberValidComponents() == dstPicYuvBottom->getNumberValidComponents());\par
00891   assert(dstPicYuvTop->getChromaFormat()          == dstPicYuvBottom->getChromaFormat()         );\par
00892 \par
00893   \{\par
00894     {\cf17 const} UInt width444   = dstPicYuvTop->getWidth(COMPONENT_Y)  - (confLeft + confRight);\par
00895     {\cf17 const} UInt height444  = dstPicYuvTop->getHeight(COMPONENT_Y) - (confTop + confBottom);\par
00896 \par
00897     m_writer->picture_begin(is16bit, width444, height444, dstPicYuvTop->getChromaFormat());\par
00898   \}\par
00899 \par
00900   {\cf19 for}(UInt comp=0; retval && comp<dstPicYuvTop->getNumberValidComponents(); comp++)\par
00901   \{\par
00902     {\cf17 const} ComponentID compID = ComponentID(comp);\par
00903     {\cf17 const} ChannelType ch=toChannelType(compID);\par
00904 \par
00905     assert(dstPicYuvTop->getWidth          (compID) == dstPicYuvBottom->getWidth          (compID));\par
00906     assert(dstPicYuvTop->getHeight         (compID) == dstPicYuvBottom->getHeight         (compID));\par
00907     assert(dstPicYuvTop->getComponentScaleX(compID) == dstPicYuvBottom->getComponentScaleX(compID));\par
00908     assert(dstPicYuvTop->getComponentScaleY(compID) == dstPicYuvBottom->getComponentScaleY(compID));\par
00909     assert(dstPicYuvTop->getStride         (compID) == dstPicYuvBottom->getStride         (compID));\par
00910 \par
00911     {\cf17 const} UInt width444   = dstPicYuvTop->getWidth(COMPONENT_Y)  - (confLeft + confRight);\par
00912     {\cf17 const} UInt height444  = dstPicYuvTop->getHeight(COMPONENT_Y) - (confTop + confBottom);\par
00913 \par
00914     {\cf19 if} ((width444 == 0) || (height444 == 0))\par
00915     \{\par
00916       printf ({\cf22 "\\nWarning: writing %d x %d luma sample output picture!"}, width444, height444);\par
00917     \}\par
00918 \par
00919     {\cf17 const} UInt csx = dstPicYuvTop->getComponentScaleX(compID);\par
00920     {\cf17 const} UInt csy = dstPicYuvTop->getComponentScaleY(compID);\par
00921     {\cf17 const} Int planeOffset  = (confLeft>>csx) + ( confTop>>csy) * dstPicYuvTop->getStride(compID); {\cf20 //offset is for entire frame - round up for top field and down for bottom field}\par
00922 \par
00923     {\cf19 if} (! writeField(m_writer,\par
00924                      (dstPicYuvTop   ->getAddr(compID) + planeOffset),\par
00925                      (dstPicYuvBottom->getAddr(compID) + planeOffset),\par
00926                      is16bit,\par
00927                      dstPicYuvTop->getStride(COMPONENT_Y),\par
00928                      width444, height444, compID, dstPicYuvTop->getChromaFormat(), format, m_fileBitdepth[ch], isTff))\par
00929     \{\par
00930       retval={\cf17 false};\par
00931     \}\par
00932   \}\par
00933 \par
00934   m_writer->picture_end();\par
00935  \par
00936   {\cf19 if} (nonZeroBitDepthShift)\par
00937   \{\par
00938     dstPicYuvTop->destroy();\par
00939     dstPicYuvBottom->destroy();\par
00940     {\cf17 delete} dstPicYuvTop;\par
00941     {\cf17 delete} dstPicYuvBottom;\par
00942   \}\par
00943 \par
00944   cPicYuvTopCSCd.destroy();\par
00945   cPicYuvBottomCSCd.destroy();\par
00946 \par
00947   {\cf19 return} retval;\par
00948 \}\par
