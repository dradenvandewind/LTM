00774       {\cf17 const} Pel maxval = b709Compliance? ((0xff << (m_MSBExtendedBitDepth[ch] - 8)) -1) : (1 << m_MSBExtendedBitDepth[ch]) - 1;\par
00775 \par
00776       copyPlane(*pPicYuv, compID, *dstPicYuv, compID);\par
00777       scalePlane(dstPicYuv->getAddr(compID), dstPicYuv->getStride(compID), dstPicYuv->getWidth(compID), dstPicYuv->getHeight(compID), -m_bitdepthShift[ch], minval, maxval);\par
00778     \}\par
00779   \}\par
00780   {\cf19 else}\par
00781   \{\par
00782     dstPicYuv = pPicYuv;\par
00783   \}\par
00784 \par
00785   {\cf17 const} Int  stride444 = dstPicYuv->getStride(COMPONENT_Y);\par
00786   {\cf17 const} UInt width444  = dstPicYuv->getWidth(COMPONENT_Y) - confLeft - confRight;\par
00787   {\cf17 const} UInt height444 = dstPicYuv->getHeight(COMPONENT_Y) -  confTop  - confBottom;\par
00788 \par
00789   {\cf19 if} ((width444 == 0) || (height444 == 0))\par
00790   \{\par
00791     printf ({\cf22 "\\nWarning: writing %d x %d luma sample output picture!"}, width444, height444);\par
00792   \}\par
00793 \par
00794   m_writer->picture_begin(is16bit, width444, height444, dstPicYuv->getChromaFormat());\par
00795   {\cf19 for}(UInt comp=0; retval && comp<dstPicYuv->getNumberValidComponents(); comp++)\par
00796   \{\par
00797     {\cf17 const} ComponentID compID = ComponentID(comp);\par
00798     {\cf17 const} ChannelType ch=toChannelType(compID);\par
00799     {\cf17 const} UInt csx = dstPicYuv->getComponentScaleX(compID);\par
00800     {\cf17 const} UInt csy = dstPicYuv->getComponentScaleY(compID);\par
00801     {\cf17 const} Int planeOffset =  (confLeft>>csx) + (confTop>>csy) * dstPicYuv->getStride(compID);\par
00802     {\cf19 if} (! writePlane(m_writer, dstPicYuv->getAddr(compID) + planeOffset, is16bit, stride444, width444, height444, compID, dstPicYuv->getChromaFormat(), format, m_fileBitdepth[ch]))\par
00803     \{\par
00804       retval={\cf17 false};\par
00805     \}\par
00806   \}\par
00807 \par
00808   m_writer->picture_end();\par
00809 \par
00810   {\cf19 if} (nonZeroBitDepthShift)\par
00811   \{\par
00812     dstPicYuv->destroy();\par
00813     {\cf17 delete} dstPicYuv;\par
00814   \}\par
00815 \par
00816   cPicYuvCSCd.destroy();\par
00817 \par
00818   {\cf19 return} retval;\par
00819 \}\par
