00160 Void TVideoIOYuvMem::skipFrames(Int numFrames, UInt width, UInt height, ChromaFormat format)\par
00161 \{\par
00162   {\cf19 if} (numFrames==0)\par
00163   \{\par
00164     {\cf19 return};\par
00165   \}\par
00166 \par
00167   {\cf20 //------------------}\par
00168   {\cf20 //set the frame size according to the chroma format}\par
00169   streamoff frameSize = 0;\par
00170   UInt wordsize=1; {\cf20 // default to 8-bit, unless a channel with more than 8-bits is detected.}\par
00171   {\cf19 for} (UInt component = 0; component < getNumberValidComponents(format); component++)\par
00172   \{\par
00173     ComponentID compID=ComponentID(component);\par
00174     frameSize += (width >> getComponentScaleX(compID, format)) * (height >> getComponentScaleY(compID, format));\par
00175     {\cf19 if} (m_fileBitdepth[toChannelType(compID)] > 8)\par
00176     \{\par
00177       wordsize=2;\par
00178     \}\par
00179   \}\par
00180   frameSize *= wordsize;\par
00181   {\cf20 //------------------}\par
00182 \par
00183   {\cf17 const} streamoff offset = frameSize * numFrames;\par
00184 \par
00185 {\cf21 #if 0}\par
00186   {\cf20 /* attempt to seek */}\par
00187   {\cf19 if} (!!m_cHandle.seekg(offset, ios::cur))\par
00188   \{\par
00189     {\cf19 return}; {\cf20 /* success */}\par
00190   \}\par
00191   m_cHandle.clear();\par
00192 \par
00193   {\cf20 /* fall back to consuming the input */}\par
00194   TChar buf[512];\par
00195   {\cf17 const} streamoff offset_mod_bufsize = offset % {\cf17 sizeof}(buf);\par
00196   {\cf19 for} (streamoff i = 0; i < offset - offset_mod_bufsize; i += {\cf17 sizeof}(buf))\par
00197   \{\par
00198     m_cHandle.read(buf, {\cf17 sizeof}(buf));\par
00199   \}\par
00200   m_cHandle.read(buf, offset_mod_bufsize);\par
00201 {\cf21 #endif}\par
00202 \}\par
