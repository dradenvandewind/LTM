00119 Void TVideoIOYuvMem::open(Writer *writer, {\cf17 const} Int fileBitDepth[MAX_NUM_CHANNEL_TYPE], {\cf17 const} Int MSBExtendedBitDepth[MAX_NUM_CHANNEL_TYPE], {\cf17 const} Int internalBitDepth[MAX_NUM_CHANNEL_TYPE] )\par
00120 \{\par
00121   {\cf20 //NOTE: files cannot have bit depth greater than 16}\par
00122   {\cf19 for}(UInt ch=0; ch<MAX_NUM_CHANNEL_TYPE; ch++)\par
00123   \{\par
00124     m_fileBitdepth       [ch] = std::min<UInt>(fileBitDepth[ch], 16);\par
00125     m_MSBExtendedBitDepth[ch] = MSBExtendedBitDepth[ch];\par
00126     m_bitdepthShift      [ch] = internalBitDepth[ch] - m_MSBExtendedBitDepth[ch];\par
00127 \par
00128     {\cf19 if} (m_fileBitdepth[ch] > 16)\par
00129     \{\par
00130         std::cerr << {\cf22 "\\nWARNING: Cannot write a yuv file of bit depth greater than 16 - output will be right-shifted down to 16-bit precision\\n"} << std::endl;\par
00131     \}\par
00132   \}\par
00133 \par
00134   m_writer = writer;\par
00135 \par
00136   {\cf19 return};\par
00137 \}\par
00138 \par
00139 Void TVideoIOYuvMem::close()\par
00140 \{\par
00141     m_writer = {\cf17 nullptr};\par
00142 \}\par
