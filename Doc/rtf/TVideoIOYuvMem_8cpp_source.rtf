00967 {\cf20 // static member}\par
00968 Void TVideoIOYuvMem::ColourSpaceConvert({\cf17 const} TComPicYuv &src, TComPicYuv &dest, {\cf17 const} InputColourSpaceConversion conversion, Bool bIsForwards)\par
00969 \{\par
00970   {\cf17 const} ChromaFormat  format=src.getChromaFormat();\par
00971   {\cf17 const} UInt          numValidComp=src.getNumberValidComponents();\par
00972 \par
00973   {\cf19 switch} (conversion)\par
00974   \{\par
00975     {\cf19 case} IPCOLOURSPACE_YCbCrtoYYY:\par
00976       {\cf19 if} (format!=CHROMA_444)\par
00977       \{\par
00978         {\cf20 // only 444 is handled.}\par
00979         assert(format==CHROMA_444);\par
00980         exit(1);\par
00981       \}\par
00982 \par
00983       \{\par
00984         {\cf19 for}(UInt comp=0; comp<numValidComp; comp++)\par
00985         \{\par
00986           copyPlane(src, ComponentID(bIsForwards?0:comp), dest, ComponentID(comp));\par
00987         \}\par
00988       \}\par
00989       {\cf19 break};\par
00990     {\cf19 case} IPCOLOURSPACE_YCbCrtoYCrCb:\par
00991       \{\par
00992         {\cf19 for}(UInt comp=0; comp<numValidComp; comp++)\par
00993         \{\par
00994           copyPlane(src, ComponentID(comp), dest, ComponentID((numValidComp-comp)%numValidComp));\par
00995         \}\par
00996       \}\par
00997       {\cf19 break};\par
00998 \par
00999     {\cf19 case} IPCOLOURSPACE_RGBtoGBR:\par
01000       \{\par
01001         {\cf19 if} (format!=CHROMA_444)\par
01002         \{\par
01003           {\cf20 // only 444 is handled.}\par
01004           assert(format==CHROMA_444);\par
01005           exit(1);\par
01006         \}\par
01007 \par
01008         {\cf20 // channel re-mapping}\par
01009         {\cf19 for}(UInt comp=0; comp<numValidComp; comp++)\par
01010         \{\par
01011           {\cf17 const} ComponentID compIDsrc=ComponentID((comp+1)%numValidComp);\par
01012           {\cf17 const} ComponentID compIDdst=ComponentID(comp);\par
01013           copyPlane(src, bIsForwards?compIDsrc:compIDdst, dest, bIsForwards?compIDdst:compIDsrc);\par
01014         \}\par
01015       \}\par
01016       {\cf19 break};\par
01017 \par
01018     {\cf19 case} IPCOLOURSPACE_UNCHANGED:\par
01019     {\cf19 default}:\par
01020       \{\par
01021         {\cf19 for}(UInt comp=0; comp<numValidComp; comp++)\par
01022         \{\par
01023           copyPlane(src, ComponentID(comp), dest, ComponentID(comp));\par
01024         \}\par
01025       \}\par
01026       {\cf19 break};\par
01027   \}\par
01028 \}\par
}
