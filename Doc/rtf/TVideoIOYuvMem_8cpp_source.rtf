00950 {\cf17 static} Void\par
00951 copyPlane({\cf17 const} TComPicYuv &src, {\cf17 const} ComponentID srcPlane, TComPicYuv &dest, {\cf17 const} ComponentID destPlane)\par
00952 \{\par
00953   {\cf17 const} UInt width=src.getWidth(srcPlane);\par
00954   {\cf17 const} UInt height=src.getHeight(srcPlane);\par
00955   assert(dest.getWidth(destPlane) == width);\par
00956   assert(dest.getHeight(destPlane) == height);\par
00957   {\cf17 const} Pel *pSrc=src.getAddr(srcPlane);\par
00958   Pel *pDest=dest.getAddr(destPlane);\par
00959   {\cf17 const} UInt strideSrc=src.getStride(srcPlane);\par
00960   {\cf17 const} UInt strideDest=dest.getStride(destPlane);\par
00961   {\cf19 for}(UInt y=0; y<height; y++, pSrc+=strideSrc, pDest+=strideDest)\par
00962   \{\par
00963     memcpy(pDest, pSrc, width*{\cf17 sizeof}(Pel));\par
00964   \}\par
00965 \}\par
