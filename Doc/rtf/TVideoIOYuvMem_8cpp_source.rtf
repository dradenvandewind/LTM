00069 {\cf17 static} Void scalePlane(Pel* img, {\cf17 const} UInt stride, {\cf17 const} UInt width, {\cf17 const} UInt height, Int shiftbits, Pel minval, Pel maxval)\par
00070 \{\par
00071   {\cf19 if} (shiftbits > 0)\par
00072   \{\par
00073     {\cf19 for} (UInt y = 0; y < height; y++, img+=stride)\par
00074     \{\par
00075       {\cf19 for} (UInt x = 0; x < width; x++)\par
00076       \{\par
00077         img[x] <<= shiftbits;\par
00078       \}\par
00079     \}\par
00080   \}\par
00081   {\cf19 else} {\cf19 if} (shiftbits < 0)\par
00082   \{\par
00083     shiftbits=-shiftbits;\par
00084 \par
00085     Pel rounding = 1 << (shiftbits-1);\par
00086     {\cf19 for} (UInt y = 0; y < height; y++, img+=stride)\par
00087     \{\par
00088       {\cf19 for} (UInt x = 0; x < width; x++)\par
00089       \{\par
00090         img[x] = Clip3(minval, maxval, Pel((img[x] + rounding) >> shiftbits));\par
00091       \}\par
00092     \}\par
00093   \}\par
00094 \}\par
