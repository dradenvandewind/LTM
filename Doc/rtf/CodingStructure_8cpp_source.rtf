00243   \}\par
00244 \par
00245   {\cf20 //pop cu/pu/tus}\par
00246   {\cf19 for}( {\cf18 int} i = m_numTUs; i > numTu; i-- )\par
00247   \{\par
00248     m_tuCache.cache( tus.back() );\par
00249     tus.pop_back();\par
00250     m_numTUs--;\par
00251   \}\par
00252   {\cf19 for}( {\cf18 int} i = m_numPUs; i > numPu; i-- )\par
00253   \{\par
