00682   \{\par
00683     {\cf19 if}( tu->cu->firstTU == {\cf17 nullptr} )\par
00684     \{\par
00685       tu->cu->firstTU = tu;\par
00686     \}\par
00687     tu->cu->lastTU = tu;\par
00688   \}\par
00689 \par
00690   uint32_t idx = ++m_numTUs;\par
00691   tu->idx  = idx;\par
00692 \par
00693   TCoeff *coeffs[5] = \{ {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr} \};\par
00694   Pel    *pcmbuf[5] = \{ {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr} \};\par
00695   {\cf18 bool}   *runType[5]   = \{ {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr}, {\cf17 nullptr} \};\par
00696 \par
00697   uint32_t numCh = vtm::getNumberValidComponents( area.chromaFormat );\par
00698 \par
00699   {\cf19 for} (uint32_t i = 0; i < numCh; i++)\par
00700   \{\par
00701     {\cf19 if} (!tu->blocks[i].valid())\par
00702     \{\par
00703       {\cf19 continue};\par
00704     \}\par
00705 \par
00706     {\cf19 if} (i < vtm::getNumberValidChannels(area.chromaFormat))\par
00707     \{\par
00708       {\cf17 const} CompArea &_selfBlk = area.blocks[i];\par
00709       {\cf17 const} CompArea     &_blk = tu->blocks[i];\par
00710 \par
00711       {\cf18 bool} isIspTu = tu->cu != {\cf17 nullptr} && tu->cu->ispMode && isLuma(_blk.compID);\par
00712 \par
00713       {\cf18 bool} isFirstIspTu = {\cf17 false};\par
00714       {\cf19 if} (isIspTu)\par
00715       \{\par
00716         isFirstIspTu = CU::isISPFirst(*tu->cu, _blk, getFirstComponentOfChannel(ChannelType(i)));\par
00717       \}\par
00718       {\cf19 if} (!isIspTu || isFirstIspTu)\par
00719       \{\par
00720         {\cf17 const} UnitScale& scale = unitScale[_blk.compID];\par
00721 \par
00722         {\cf17 const} Area scaledSelf = scale.scale(_selfBlk);\par
00723         {\cf17 const} Area scaledBlk = isIspTu ? scale.scale(tu->cu->blocks[i]) : scale.scale(_blk);\par
00724         {\cf18 unsigned} *idxPtr = m_tuIdx[i] + rsAddr(scaledBlk.pos(), scaledSelf.pos(), scaledSelf.width);\par
00725         CHECK(*idxPtr, {\cf22 "Overwriting a pre-existing value, should be '0'!"});\par
00726         AreaBuf<uint32_t>(idxPtr, scaledSelf.width, scaledBlk.size()).fill(idx);\par
00727       \}\par
00728     \}\par
00729 \par
00730     coeffs[i] = m_coeffs[i] + m_offsets[i];\par
00731     pcmbuf[i] = m_pcmbuf[i] + m_offsets[i];\par
00732 \par
00733     {\cf19 if} (i < MAX_NUM_CHANNEL_TYPE)\par
00734     \{\par
00735       {\cf19 if} (m_runType[i] != {\cf17 nullptr})\par
00736       \{\par
00737         runType[i] = m_runType[i] + m_offsets[i];\par
00738       \}\par
00739     \}\par
00740 \par
00741     {\cf18 unsigned} areaSize = tu->blocks[i].area();\par
00742     m_offsets[i] += areaSize;\par
00743   \}\par
00744   tu->init(coeffs, pcmbuf, runType);\par
00745 \par
00746   {\cf19 return} *tu;\par
00747 \}\par
