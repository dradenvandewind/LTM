00749 {\cf18 void} CodingStructure::addEmptyTUs( Partitioner &partitioner )\par
00750 \{\par
00751   {\cf17 const} UnitArea& area    = partitioner.currArea();\par
00752   {\cf18 bool}            split   = partitioner.canSplit(TU_MAX_TR_SPLIT, *{\cf17 this});\par
00753   {\cf17 const} {\cf18 unsigned}  trDepth = partitioner.currTrDepth;\par
00754 \par
00755   {\cf19 if}( split )\par
00756   \{\par
00757     partitioner.splitCurrArea( TU_MAX_TR_SPLIT, *{\cf17 this} );\par
00758     {\cf19 do}\par
00759     \{\par
00760       addEmptyTUs( partitioner );\par
00761     \} {\cf19 while}( partitioner.nextPart( *{\cf17 this} ) );\par
00762 \par
00763     partitioner.exitCurrSplit();\par
00764   \}\par
00765   {\cf19 else}\par
00766   \{\par
00767     TransformUnit &tu = this->addTU( CS::getArea( *{\cf17 this}, area, partitioner.chType ), partitioner.chType );\par
00768     {\cf18 unsigned} numBlocks = vtm::getNumberValidTBlocks( *this->pcv );\par
00769     {\cf19 for}( {\cf18 unsigned} compID = COMPONENT_Y; compID < numBlocks; compID++ )\par
00770     \{\par
00771       {\cf19 if}( tu.blocks[compID].valid() )\par
00772       \{\par
00773         tu.getCoeffs( ComponentID( compID ) ).fill( 0 );\par
00774         tu.getPcmbuf( ComponentID( compID ) ).fill( 0 );\par
00775       \}\par
00776     \}\par
00777     tu.depth = trDepth;\par
00778   \}\par
00779 \}\par
