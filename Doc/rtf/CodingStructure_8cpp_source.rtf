01609   CHECKD( !area.blocks[compID].contains( blk ), {\cf22 "Buffer not contained in self requested"} );\par
01610 \par
01611   CompArea cFinal = blk;\par
01612   cFinal.relativeTo( area.blocks[compID] );\par
01613 \par
01614 {\cf21 #if !KEEP_PRED_AND_RESI_SIGNALS}\par
01615   {\cf19 if}( !parent && ( type == PIC_RESIDUAL || type == PIC_PREDICTION ) )\par
01616   \{\par
01617     cFinal.x &= ( pcv->maxCUWidthMask  >> getComponentScaleX( blk.compID, blk.chromaFormat ) );\par
01618     cFinal.y &= ( pcv->maxCUHeightMask >> getComponentScaleY( blk.compID, blk.chromaFormat ) );\par
01619   \}\par
01620 {\cf21 #endif}\par
01621 \par
01622   {\cf19 return} buf->getBuf( cFinal );\par
01623 \}\par
