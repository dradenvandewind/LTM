01327 {\cf18 void} CodingStructure::copyStructure( {\cf17 const} CodingStructure& other, {\cf17 const} ChannelType chType, {\cf17 const} {\cf18 bool} copyTUs, {\cf17 const} {\cf18 bool} copyRecoBuf )\par
01328 \{\par
01329   fracBits = other.fracBits;\par
01330   dist     = other.dist;\par
01331   cost     = other.cost;\par
01332   costDbOffset = other.costDbOffset;\par
01333   CHECKD( area != other.area, {\cf22 "Incompatible sizes"} );\par
01334 \par
01335   {\cf17 const} UnitArea dualITreeArea = CS::getArea( *{\cf17 this}, this->area, chType );\par
01336 \par
01337   {\cf20 // copy the CUs over}\par
01338   {\cf19 for} ({\cf17 const} {\cf17 auto} &pcu : other.cus)\par
01339   \{\par
01340     {\cf19 if}( !dualITreeArea.contains( *pcu ) )\par
01341     \{\par
01342       {\cf19 continue};\par
01343     \}\par
01344     {\cf20 // add an analogue CU into own CU store}\par
01345     {\cf17 const} UnitArea &cuPatch = *pcu;\par
01346 \par
01347     CodingUnit &cu = addCU(cuPatch, pcu->chType);\par
01348 \par
01349     {\cf20 // copy the CU info from subPatch}\par
01350     cu = *pcu;\par
01351   \}\par
01352 \par
01353   {\cf20 // copy the PUs over}\par
01354   {\cf19 for} ({\cf17 const} {\cf17 auto} &ppu : other.pus)\par
01355   \{\par
01356     {\cf19 if}( !dualITreeArea.contains( *ppu ) )\par
01357     \{\par
01358       {\cf19 continue};\par
01359     \}\par
01360     {\cf20 // add an analogue PU into own PU store}\par
01361     {\cf17 const} UnitArea &puPatch = *ppu;\par
01362 \par
01363     PredictionUnit &pu = addPU(puPatch, ppu->chType);\par
01364     {\cf20 // copy the PU info from subPatch}\par
01365     pu = *ppu;\par
01366   \}\par
01367 \par
01368   {\cf19 if} (!other.slice->isIntra() || other.slice->getSPS()->getIBCFlag())\par
01369   \{\par
01370     {\cf20 // copy motion buffer}\par
01371     MotionBuf  ownMB = getMotionBuf();\par
01372     CMotionBuf subMB = other.getMotionBuf();\par
01373 \par
01374     ownMB.copyFrom( subMB );\par
01375 \par
01376     motionLut = other.motionLut;\par
01377   \}\par
01378   prevPLT = other.prevPLT;\par
01379 \par
01380   {\cf19 if}( copyTUs )\par
01381   \{\par
01382     {\cf20 // copy the TUs over}\par
01383     {\cf19 for}( {\cf17 const} {\cf17 auto} &ptu : other.tus )\par
01384     \{\par
01385       {\cf19 if}( !dualITreeArea.contains( *ptu ) )\par
01386       \{\par
01387         {\cf19 continue};\par
01388       \}\par
01389       {\cf20 // add an analogue TU into own TU store}\par
01390       {\cf17 const} UnitArea &tuPatch = *ptu;\par
01391       TransformUnit &tu = addTU( tuPatch, ptu->chType );\par
01392       {\cf20 // copy the TU info from subPatch}\par
01393       tu = *ptu;\par
01394     \}\par
01395   \}\par
01396 \par
01397   {\cf19 if}( copyRecoBuf )\par
01398   \{\par
01399     CPelUnitBuf recoBuf = other.getRecoBuf( area );\par
01400 \par
01401     {\cf19 if}( parent )\par
01402     \{\par
01403       {\cf20 // copy data to self for neighbors}\par
01404       getRecoBuf( area ).copyFrom( recoBuf );\par
01405     \}\par
01406 \par
01407     {\cf20 // copy data to picture}\par
01408     picture->getRecoBuf( area ).copyFrom( recoBuf );\par
01409     {\cf19 if} (other.pcv->isEncoder)\par
01410     \{\par
01411       CPelUnitBuf predBuf = other.getPredBuf(area);\par
01412       {\cf19 if} (parent)\par
01413       \{\par
01414         getPredBuf(area).copyFrom(predBuf);\par
01415       \}\par
01416       picture->getPredBuf(area).copyFrom(predBuf);\par
01417     \}\par
01418 \par
01419     {\cf20 // required for DebugCTU}\par
01420     {\cf18 int} numCh = vtm::getNumberValidChannels( area.chromaFormat );\par
01421     {\cf19 for}( {\cf18 int} i = 0; i < numCh; i++ )\par
01422     \{\par
01423       {\cf17 const} {\cf18 size_t} _area = unitScale[i].scaleArea( area.blocks[i].area() );\par
01424 \par
01425       memcpy( m_isDecomp[i], other.m_isDecomp[i], {\cf17 sizeof}( *m_isDecomp[0] ) * _area );\par
01426     \}\par
01427   \}\par
01428 \}\par
