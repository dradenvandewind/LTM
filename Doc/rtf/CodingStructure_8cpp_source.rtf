01685 {\cf17 const} CodingUnit* CodingStructure::getCURestricted( {\cf17 const} Position &pos, {\cf17 const} CodingUnit& curCu, {\cf17 const} ChannelType _chType ){\cf17  const}\par
01686 {\cf17 }\{\par
01687   {\cf17 const} CodingUnit* cu = getCU( pos, _chType );\par
01688   {\cf20 // exists       same slice and tile                  cu precedes curCu in encoding order}\par
01689   {\cf20 //                                                  (thus, is either from parent CS in RD-search or its index is lower)}\par
01690   {\cf17 const} {\cf18 bool} wavefrontsEnabled = curCu.slice->getSPS()->getEntropyCodingSyncEnabledFlag();\par
01691   {\cf18 int} ctuSizeBit = floorLog2(curCu.cs->sps->getMaxCUWidth());\par
01692   {\cf18 int} xNbY  = pos.x << getChannelTypeScaleX( _chType, curCu.chromaFormat );\par
01693   {\cf18 int} xCurr = curCu.blocks[_chType].x << getChannelTypeScaleX( _chType, curCu.chromaFormat );\par
01694   {\cf18 bool} addCheck = (wavefrontsEnabled && (xNbY >> ctuSizeBit) >= (xCurr >> ctuSizeBit) + 1 ) ? {\cf17 false} : {\cf17 true};\par
01695   {\cf19 if}( cu && CU::isSameSliceAndTile( *cu, curCu ) && ( cu->cs != curCu.cs || cu->idx <= curCu.idx ) && addCheck)\par
01696   \{\par
01697     {\cf19 return} cu;\par
01698   \}\par
01699   {\cf19 else}\par
01700   \{\par
01701     {\cf19 return} {\cf17 nullptr};\par
01702   \}\par
01703 \}\par
