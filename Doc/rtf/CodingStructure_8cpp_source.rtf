00991 {\cf18 void} CodingStructure::reorderPrevPLT(PLTBuf& prevPLT, uint8_t curPLTSize[MAX_NUM_CHANNEL_TYPE], Pel curPLT[MAX_NUM_COMPONENT][MAXPLTSIZE], {\cf18 bool} reuseflag[MAX_NUM_CHANNEL_TYPE][MAXPLTPREDSIZE], uint32_t compBegin, uint32_t numComp, {\cf18 bool} jointPLT)\par
00992 \{\par
00993   Pel stuffedPLT[MAX_NUM_COMPONENT][MAXPLTPREDSIZE];\par
00994   uint8_t tempCurPLTsize[MAX_NUM_CHANNEL_TYPE];\par
00995   uint8_t stuffPLTsize[MAX_NUM_COMPONENT];\par
00996 \par
00997   uint32_t maxPredPltSize = jointPLT ? MAXPLTPREDSIZE : MAXPLTPREDSIZE_DUALTREE;\par
00998 \par
00999   {\cf19 for} ({\cf18 int} i = compBegin; i < (compBegin + numComp); i++)\par
01000   \{\par
01001     ComponentID comID = jointPLT ? (ComponentID)compBegin : ((i > 0) ? COMPONENT_Cb : COMPONENT_Y);\par
01002     tempCurPLTsize[comID] = curPLTSize[comID];\par
01003     stuffPLTsize[i] = 0;\par
01004     memcpy(stuffedPLT[i], curPLT[i], curPLTSize[comID] * {\cf17 sizeof}(Pel));\par
01005   \}\par
01006 \par
01007   {\cf19 for} ({\cf18 int} ch = compBegin; ch < (compBegin + numComp); ch++)\par
01008   \{\par
01009     ComponentID comID = jointPLT ? (ComponentID)compBegin : ((ch > 0) ? COMPONENT_Cb : COMPONENT_Y);\par
01010     {\cf19 if} (ch > 1) {\cf19 break};\par
01011     {\cf19 for} ({\cf18 int} i = 0; i < prevPLT.curPLTSize[comID]; i++)\par
01012     \{\par
01013       {\cf19 if} (tempCurPLTsize[comID] + stuffPLTsize[ch] >= maxPredPltSize)\par
01014       \{\par
01015         {\cf19 break};\par
01016       \}\par
01017 \par
01018       {\cf19 if} (!reuseflag[comID][i])\par
01019       \{\par
01020         {\cf19 if} (ch == COMPONENT_Y)\par
01021         \{\par
01022           stuffedPLT[0][tempCurPLTsize[comID] + stuffPLTsize[ch]] = prevPLT.curPLT[0][i];\par
01023         \}\par
01024         {\cf19 else}\par
01025         \{\par
01026           stuffedPLT[1][tempCurPLTsize[comID] + stuffPLTsize[ch]] = prevPLT.curPLT[1][i];\par
01027           stuffedPLT[2][tempCurPLTsize[comID] + stuffPLTsize[ch]] = prevPLT.curPLT[2][i];\par
01028         \}\par
01029         stuffPLTsize[ch]++;\par
01030       \}\par
01031     \}\par
01032   \}\par
01033 \par
01034   {\cf19 for} ({\cf18 int} i = compBegin; i < (compBegin + numComp); i++)\par
01035   \{\par
01036     ComponentID comID = jointPLT ? (ComponentID)compBegin : ((i > 0) ? COMPONENT_Cb : COMPONENT_Y);\par
01037     prevPLT.curPLTSize[comID] = curPLTSize[comID] + stuffPLTsize[comID];\par
01038     memcpy(prevPLT.curPLT[i], stuffedPLT[i], prevPLT.curPLTSize[comID] * {\cf17 sizeof}(Pel));\par
01039     CHECK(prevPLT.curPLTSize[comID] > maxPredPltSize, {\cf22 " Maximum palette predictor size exceed limit"});\par
01040   \}\par
01041 \}\par
