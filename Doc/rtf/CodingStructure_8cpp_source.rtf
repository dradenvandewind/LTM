00202 {\cf17 const} {\cf18 int} CodingStructure::signalModeCons( {\cf17 const} PartSplit split, Partitioner &partitioner, {\cf17 const} ModeType modeTypeParent ){\cf17  const}\par
00203 {\cf17 }\{\par
00204   {\cf19 if} (CS::isDualITree(*{\cf17 this}) || modeTypeParent != MODE_TYPE_ALL || partitioner.currArea().chromaFormat == CHROMA_444 || partitioner.currArea().chromaFormat == CHROMA_400 )\par
00205   \{\par
