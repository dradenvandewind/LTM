01231 {\cf18 void} CodingStructure::useSubStructure( {\cf17 const} CodingStructure& subStruct, {\cf17 const} ChannelType chType, {\cf17 const} UnitArea &subArea, {\cf17 const} {\cf18 bool} cpyPred {\cf20 /*= true*/}, {\cf17 const} {\cf18 bool} cpyReco {\cf20 /*= true*/}, {\cf17 const} {\cf18 bool} cpyOrgResi {\cf20 /*= true*/}, {\cf17 const} {\cf18 bool} cpyResi {\cf20 /*= true*/}, {\cf17 const} {\cf18 bool} updateCost {\cf20 /*= true*/} )\par
01232 \{\par
01233   UnitArea clippedArea = clipArea( subArea, *picture );\par
01234 \par
01235   setDecomp( clippedArea );\par
01236 \par
01237   CPelUnitBuf subPredBuf = cpyPred ? subStruct.getPredBuf( clippedArea ) : CPelUnitBuf();\par
01238   CPelUnitBuf subResiBuf = cpyResi ? subStruct.getResiBuf( clippedArea ) : CPelUnitBuf();\par
01239   CPelUnitBuf subRecoBuf = cpyReco ? subStruct.getRecoBuf( clippedArea ) : CPelUnitBuf();\par
01240 \par
01241   {\cf19 if}( parent )\par
01242   \{\par
01243     {\cf20 // copy data to picture}\par
01244     {\cf19 if}( cpyPred )    getPredBuf   ( clippedArea ).copyFrom( subPredBuf );\par
01245     {\cf19 if}( cpyResi )    getResiBuf   ( clippedArea ).copyFrom( subResiBuf );\par
01246     {\cf19 if}( cpyReco )    getRecoBuf   ( clippedArea ).copyFrom( subRecoBuf );\par
01247     {\cf19 if}( cpyOrgResi ) getOrgResiBuf( clippedArea ).copyFrom( subStruct.getOrgResiBuf( clippedArea ) );\par
01248   \}\par
01249 \par
01250   {\cf19 if}( cpyPred ) picture->getPredBuf( clippedArea ).copyFrom( subPredBuf );\par
01251   {\cf19 if}( cpyResi ) picture->getResiBuf( clippedArea ).copyFrom( subResiBuf );\par
01252   {\cf19 if}( cpyReco ) picture->getRecoBuf( clippedArea ).copyFrom( subRecoBuf );\par
01253 \par
01254   {\cf19 if} (!subStruct.m_isTuEnc && ((!slice->isIntra() || slice->getSPS()->getIBCFlag()) && chType != CHANNEL_TYPE_CHROMA))\par
01255   \{\par
01256     {\cf20 // copy motion buffer}\par
01257     MotionBuf ownMB  = getMotionBuf          ( clippedArea );\par
01258     CMotionBuf subMB = subStruct.getMotionBuf( clippedArea );\par
01259 \par
01260     ownMB.copyFrom( subMB );\par
01261 \par
01262     motionLut = subStruct.motionLut;\par
01263   \}\par
01264   prevPLT = subStruct.prevPLT;\par
01265 \par
01266 \par
01267   {\cf19 if} ( updateCost )\par
01268   \{\par
01269     fracBits += subStruct.fracBits;\par
01270     dist     += subStruct.dist;\par
01271     cost     += subStruct.cost;\par
01272     costDbOffset += subStruct.costDbOffset;\par
01273   \}\par
01274   {\cf19 if}( parent )\par
01275   \{\par
01276     {\cf20 // allow this to be false at the top level}\par
01277     CHECKD( !area.contains( subArea ), {\cf22 "Trying to use a sub-structure not contained in self"} );\par
01278   \}\par
01279 \par
01280   {\cf20 // copy the CUs over}\par
01281   {\cf19 if}( subStruct.m_isTuEnc )\par
01282   \{\par
01283     {\cf20 // don't copy if the substruct was created for encoding of the TUs}\par
01284   \}\par
01285   {\cf19 else}\par
01286   \{\par
01287     {\cf19 for}( {\cf17 const} {\cf17 auto} &pcu : subStruct.cus )\par
01288     \{\par
01289       {\cf20 // add an analogue CU into own CU store}\par
01290       {\cf17 const} UnitArea &cuPatch = *pcu;\par
01291       CodingUnit &cu = addCU( cuPatch, pcu->chType );\par
01292 \par
01293       {\cf20 // copy the CU info from subPatch}\par
01294       cu = *pcu;\par
01295     \}\par
01296   \}\par
01297 \par
01298   {\cf20 // copy the PUs over}\par
01299   {\cf19 if}( subStruct.m_isTuEnc )\par
01300   \{\par
01301     {\cf20 // don't copy if the substruct was created for encoding of the TUs}\par
01302   \}\par
01303   {\cf19 else}\par
01304   \{\par
01305     {\cf19 for}( {\cf17 const} {\cf17 auto} &ppu : subStruct.pus )\par
01306     \{\par
01307       {\cf20 // add an analogue PU into own PU store}\par
01308       {\cf17 const} UnitArea &puPatch = *ppu;\par
01309       PredictionUnit &pu = addPU( puPatch, ppu->chType );\par
01310 \par
01311       {\cf20 // copy the PU info from subPatch}\par
01312       pu = *ppu;\par
01313     \}\par
01314   \}\par
01315   {\cf20 // copy the TUs over}\par
01316   {\cf19 for}( {\cf17 const} {\cf17 auto} &ptu : subStruct.tus )\par
01317   \{\par
01318     {\cf20 // add an analogue TU into own TU store}\par
01319     {\cf17 const} UnitArea &tuPatch = *ptu;\par
01320     TransformUnit &tu = addTU( tuPatch, ptu->chType );\par
01321 \par
01322     {\cf20 // copy the TU info from subPatch}\par
01323     tu = *ptu;\par
01324   \}\par
01325 \}\par
