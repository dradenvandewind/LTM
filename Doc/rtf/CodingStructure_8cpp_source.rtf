00781 CUTraverser CodingStructure::traverseCUs( {\cf17 const} UnitArea& unit, {\cf17 const} ChannelType effChType )\par
00782 \{\par
00783   CodingUnit* firstCU = getCU( isLuma( effChType ) ? unit.lumaPos() : unit.chromaPos(), effChType );\par
00784   CodingUnit* lastCU = firstCU;\par
00785   {\cf19 if}( !CS::isDualITree( *{\cf17 this} ) ) {\cf20 //for a more generalized separate tree}\par
00786   \{\par
00787     {\cf18 bool} bContinue = {\cf17 true};\par
00788     CodingUnit* currCU = firstCU;\par
00789     {\cf19 while}( bContinue )\par
00790     \{\par
00791       {\cf19 if}( currCU == {\cf17 nullptr} )\par
00792       \{\par
00793         bContinue = {\cf17 false};\par
00794         lastCU = currCU;\par
00795       \}\par
00796       {\cf19 else} {\cf19 if}( currCU->chType != effChType )\par
00797       \{\par
00798         lastCU = currCU;\par
00799         currCU = currCU->next;\par
00800       \}\par
00801       {\cf19 else}\par
00802       \{\par
00803         {\cf19 if}( unit.contains( *currCU ) )\par
00804         \{\par
00805           lastCU = currCU;\par
00806           currCU = currCU->next;\par
00807         \}\par
00808         {\cf19 else}\par
00809         \{\par
00810           bContinue = {\cf17 false};\par
00811           lastCU = currCU;\par
00812         \}\par
00813       \}\par
00814     \}\par
00815   \}\par
00816   {\cf19 else}\par
00817   \{\par
00818     {\cf19 do}\par
00819     \{\par
00820     \} {\cf19 while} (lastCU && (lastCU = lastCU->next) && unit.contains(*lastCU));\par
00821   \}\par
00822 \par
00823   {\cf19 return} CUTraverser( firstCU, lastCU );\par
00824 \}\par
