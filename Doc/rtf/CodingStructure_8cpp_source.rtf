00261     cus.pop_back();\par
00262     m_numCUs--;\par
00263   \}\par
00264   {\cf19 for}( {\cf18 int} i = 0; i < 3; i++ )\par
00265   \{\par
00266     m_offsets[i] = pOffset[i];\par
00267   \}\par
00268 \}\par
