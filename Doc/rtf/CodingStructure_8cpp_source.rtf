00222 {\cf18 void} CodingStructure::clearCuPuTuIdxMap( {\cf17 const} UnitArea &_area, uint32_t numCu, uint32_t numPu, uint32_t numTu, uint32_t* pOffset )\par
00223 \{\par
00224   UnitArea clippedArea = clipArea( _area, *picture );\par
00225   uint32_t numCh = vtm::getNumberValidChannels( _area.chromaFormat );\par
00226   {\cf19 for}( uint32_t i = 0; i < numCh; i++ )\par
00227   \{\par
00228     {\cf17 const} CompArea &_selfBlk = area.blocks[i];\par
00229     {\cf17 const} CompArea     &_blk = clippedArea.blocks[i];\par
00230 \par
00231     {\cf17 const} UnitScale& scale = unitScale[_blk.compID];\par
00232     {\cf17 const} Area scaledSelf = scale.scale( _selfBlk );\par
00233     {\cf17 const} Area scaledBlk = scale.scale( _blk );\par
00234     {\cf17 const} {\cf18 size_t} offset = rsAddr( scaledBlk.pos(), scaledSelf.pos(), scaledSelf.width );\par
00235     {\cf18 unsigned} *idxPtrCU = m_cuIdx[i] + offset;\par
