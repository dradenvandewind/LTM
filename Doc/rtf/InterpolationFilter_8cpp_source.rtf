00399 {\cf17 template}<{\cf18 bool} isFirst, {\cf18 bool} isLast>\par
00400 {\cf18 void} InterpolationFilter::filterCopy( {\cf17 const} ClpRng& clpRng, {\cf17 const} Pel *src, {\cf18 int} srcStride, Pel *dst, {\cf18 int} dstStride, {\cf18 int} width, {\cf18 int} height, {\cf18 bool} biMCForDMVR)\par
00401 \{\par
00402   {\cf18 int} row, col;\par
00403 \par
00404   {\cf19 if} ( isFirst == isLast )\par
00405   \{\par
00406     {\cf19 for} (row = 0; row < height; row++)\par
00407     \{\par
00408       {\cf19 for} (col = 0; col < width; col++)\par
00409       \{\par
00410         dst[col] = src[col];\par
00411         JVET_J0090_CACHE_ACCESS( &src[col], __FILE__, __LINE__ );\par
00412       \}\par
00413 \par
00414       src += srcStride;\par
00415       dst += dstStride;\par
00416     \}\par
00417   \}\par
00418   {\cf19 else} {\cf19 if} ( isFirst )\par
00419   \{\par
00420     {\cf17 const} {\cf18 int} shift = IF_INTERNAL_FRAC_BITS(clpRng.bd);\par
00421 \par
00422     {\cf19 if} (biMCForDMVR)\par
00423     \{\par
00424       {\cf18 int} shift10BitOut, offset;\par
00425       {\cf19 if} ((clpRng.bd - IF_INTERNAL_PREC_BILINEAR) > 0)\par
00426       \{\par
00427         shift10BitOut = (clpRng.bd - IF_INTERNAL_PREC_BILINEAR);\par
00428         offset = (1 << (shift10BitOut - 1));\par
00429         {\cf19 for} (row = 0; row < height; row++)\par
00430         \{\par
00431           {\cf19 for} (col = 0; col < width; col++)\par
00432           \{\par
00433             dst[col] = (src[col] + offset) >> shift10BitOut;\par
00434           \}\par
00435           src += srcStride;\par
00436           dst += dstStride;\par
00437         \}\par
00438       \}\par
00439       {\cf19 else}\par
00440       \{\par
00441         shift10BitOut = (IF_INTERNAL_PREC_BILINEAR - clpRng.bd);\par
00442         {\cf19 for} (row = 0; row < height; row++)\par
00443         \{\par
00444           {\cf19 for} (col = 0; col < width; col++)\par
00445           \{\par
00446             dst[col] = src[col] << shift10BitOut;\par
00447           \}\par
00448           src += srcStride;\par
00449           dst += dstStride;\par
00450         \}\par
00451       \}\par
00452     \}\par
00453     {\cf19 else}\par
00454     {\cf19 for} (row = 0; row < height; row++)\par
00455     \{\par
00456       {\cf19 for} (col = 0; col < width; col++)\par
00457       \{\par
00458         Pel val = leftShift_round(src[col], shift);\par
00459         dst[col] = val - (Pel)IF_INTERNAL_OFFS;\par
00460         JVET_J0090_CACHE_ACCESS( &src[col], __FILE__, __LINE__ );\par
00461       \}\par
00462 \par
00463       src += srcStride;\par
00464       dst += dstStride;\par
00465     \}\par
00466   \}\par
00467   {\cf19 else}\par
00468   \{\par
00469     {\cf17 const} {\cf18 int} shift = IF_INTERNAL_FRAC_BITS(clpRng.bd);\par
00470 \par
00471     {\cf19 if} (biMCForDMVR)\par
00472     \{\par
00473       {\cf18 int} shift10BitOut, offset;\par
00474       {\cf19 if} ((clpRng.bd - IF_INTERNAL_PREC_BILINEAR) > 0)\par
00475       \{\par
00476         shift10BitOut = (clpRng.bd - IF_INTERNAL_PREC_BILINEAR);\par
00477         offset = (1 << (shift10BitOut - 1));\par
00478         {\cf19 for} (row = 0; row < height; row++)\par
00479         \{\par
00480           {\cf19 for} (col = 0; col < width; col++)\par
00481           \{\par
00482             dst[col] = (src[col] + offset) >> shift10BitOut;\par
00483           \}\par
00484           src += srcStride;\par
00485           dst += dstStride;\par
00486         \}\par
00487       \}\par
00488       {\cf19 else}\par
00489       \{\par
00490         shift10BitOut = (IF_INTERNAL_PREC_BILINEAR - clpRng.bd);\par
00491         {\cf19 for} (row = 0; row < height; row++)\par
00492         \{\par
00493           {\cf19 for} (col = 0; col < width; col++)\par
00494           \{\par
00495             dst[col] = src[col] << shift10BitOut;\par
00496           \}\par
00497           src += srcStride;\par
00498           dst += dstStride;\par
00499         \}\par
00500       \}\par
00501     \}\par
00502     {\cf19 else}\par
00503     \{\par
00504       {\cf19 for} (row = 0; row < height; row++)\par
00505       \{\par
00506         {\cf19 for} (col = 0; col < width; col++)\par
00507         \{\par
00508           Pel val = src[col];\par
00509           val     = rightShift_round((val + IF_INTERNAL_OFFS), shift);\par
00510 \par
00511           dst[col] = ClipPel(val, clpRng);\par
00512           JVET_J0090_CACHE_ACCESS(&src[col], __FILE__, __LINE__);\par
00513         \}\par
00514 \par
00515         src += srcStride;\par
00516         dst += dstStride;\par
00517       \}\par
00518     \}\par
00519   \}\par
00520 \}\par
