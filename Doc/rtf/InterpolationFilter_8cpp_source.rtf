00546 {\cf17 template}<{\cf18 int} N, {\cf18 bool} isVertical, {\cf18 bool} isFirst, {\cf18 bool} isLast>\par
00547 {\cf18 void} InterpolationFilter::filter({\cf17 const} ClpRng& clpRng, Pel {\cf17 const} *src, {\cf18 int} srcStride, Pel *dst, {\cf18 int} dstStride, {\cf18 int} width, {\cf18 int} height, TFilterCoeff {\cf17 const} *coeff, {\cf18 bool} biMCForDMVR)\par
00548 \{\par
00549   {\cf18 int} row, col;\par
00550 \par
00551   Pel c[8];\par
00552   c[0] = coeff[0];\par
00553   c[1] = coeff[1];\par
00554   {\cf19 if} ( N >= 4 )\par
00555   \{\par
00556     c[2] = coeff[2];\par
00557     c[3] = coeff[3];\par
00558   \}\par
00559   {\cf19 if} ( N >= 6 )\par
00560   \{\par
00561     c[4] = coeff[4];\par
00562     c[5] = coeff[5];\par
00563   \}\par
00564   {\cf19 if} ( N == 8 )\par
00565   \{\par
00566     c[6] = coeff[6];\par
00567     c[7] = coeff[7];\par
00568   \}\par
00569 \par
00570   {\cf18 int} cStride = ( isVertical ) ? srcStride : 1;\par
00571   src -= ( N/2 - 1 ) * cStride;\par
00572 \par
00573   {\cf18 int} offset;\par
00574   {\cf18 int} headRoom = IF_INTERNAL_FRAC_BITS(clpRng.bd);\par
00575   {\cf18 int} shift    = IF_FILTER_PREC;\par
00576   {\cf20 // with the current settings (IF_INTERNAL_PREC = 14 and IF_FILTER_PREC = 6), though headroom can be}\par
00577   {\cf20 // negative for bit depths greater than 14, shift will remain non-negative for bit depths of 8->20}\par
00578   CHECK(shift < 0, {\cf22 "Negative shift"});\par
00579 \par
00580   {\cf19 if} ( isLast )\par
00581   \{\par
00582     shift += (isFirst) ? 0 : headRoom;\par
00583     offset = 1 << (shift - 1);\par
00584     offset += (isFirst) ? 0 : IF_INTERNAL_OFFS << IF_FILTER_PREC;\par
00585   \}\par
00586   {\cf19 else}\par
00587   \{\par
00588     shift -= (isFirst) ? headRoom : 0;\par
00589     offset = (isFirst) ? -IF_INTERNAL_OFFS << shift : 0;\par
00590   \}\par
00591 \par
00592   {\cf19 if} (biMCForDMVR)\par
00593   \{\par
00594     {\cf19 if}( isFirst )\par
00595     \{\par
00596       shift = IF_FILTER_PREC_BILINEAR - (IF_INTERNAL_PREC_BILINEAR - clpRng.bd);\par
00597       offset = 1 << (shift - 1);\par
00598     \}\par
00599     {\cf19 else}\par
00600     \{\par
00601       shift = 4;\par
00602       offset = 1 << (shift - 1);\par
00603     \}\par
00604   \}\par
00605   {\cf19 for} (row = 0; row < height; row++)\par
00606   \{\par
00607     {\cf19 for} (col = 0; col < width; col++)\par
00608     \{\par
00609       {\cf18 int} sum;\par
00610 \par
00611       sum  = src[ col + 0 * cStride] * c[0];\par
00612       sum += src[ col + 1 * cStride] * c[1];\par
00613       JVET_J0090_CACHE_ACCESS( &src[ col + 0 * cStride], __FILE__, __LINE__ );\par
00614       JVET_J0090_CACHE_ACCESS( &src[ col + 1 * cStride], __FILE__, __LINE__ );\par
00615       {\cf19 if} ( N >= 4 )\par
00616       \{\par
00617         sum += src[ col + 2 * cStride] * c[2];\par
00618         sum += src[ col + 3 * cStride] * c[3];\par
00619         JVET_J0090_CACHE_ACCESS( &src[ col + 2 * cStride], __FILE__, __LINE__ );\par
00620         JVET_J0090_CACHE_ACCESS( &src[ col + 3 * cStride], __FILE__, __LINE__ );\par
00621       \}\par
00622       {\cf19 if} ( N >= 6 )\par
00623       \{\par
00624         sum += src[ col + 4 * cStride] * c[4];\par
00625         sum += src[ col + 5 * cStride] * c[5];\par
00626         JVET_J0090_CACHE_ACCESS( &src[ col + 4 * cStride], __FILE__, __LINE__ );\par
00627         JVET_J0090_CACHE_ACCESS( &src[ col + 5 * cStride], __FILE__, __LINE__ );\par
00628       \}\par
00629       {\cf19 if} ( N == 8 )\par
00630       \{\par
00631         sum += src[ col + 6 * cStride] * c[6];\par
00632         sum += src[ col + 7 * cStride] * c[7];\par
00633         JVET_J0090_CACHE_ACCESS( &src[ col + 6 * cStride], __FILE__, __LINE__ );\par
00634         JVET_J0090_CACHE_ACCESS( &src[ col + 7 * cStride], __FILE__, __LINE__ );\par
00635       \}\par
00636 \par
00637       Pel val = ( sum + offset ) >> shift;\par
00638       {\cf19 if} ( isLast )\par
00639       \{\par
00640         val = ClipPel( val, clpRng );\par
00641       \}\par
00642       dst[col] = val;\par
00643     \}\par
00644 \par
00645     src += srcStride;\par
00646     dst += dstStride;\par
00647   \}\par
00648 \}\par
