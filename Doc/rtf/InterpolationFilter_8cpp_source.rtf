00893 {\cf18 void} InterpolationFilter::xWeightedGeoBlk({\cf17 const} PredictionUnit &pu, {\cf17 const} uint32_t width, {\cf17 const} uint32_t height, {\cf17 const} ComponentID compIdx, {\cf17 const} uint8_t splitDir, PelUnitBuf& predDst, PelUnitBuf& predSrc0, PelUnitBuf& predSrc1)\par
00894 \{\par
00895   Pel*    dst = predDst.get(compIdx).buf;\par
00896   Pel*    src0 = predSrc0.get(compIdx).buf;\par
00897   Pel*    src1 = predSrc1.get(compIdx).buf;\par
00898   int32_t strideDst = predDst.get(compIdx).stride - width;\par
00899   int32_t strideSrc0 = predSrc0.get(compIdx).stride - width;\par
00900   int32_t strideSrc1 = predSrc1.get(compIdx).stride - width;\par
00901 \par
00902   {\cf17 const} {\cf18 char}    log2WeightBase = 3;\par
00903   {\cf17 const} ClpRng  clipRng = pu.cu->slice->clpRngs().comp[compIdx];\par
00904   {\cf17 const} int32_t clipbd = clipRng.bd;\par
00905   {\cf17 const} int32_t shiftWeighted = IF_INTERNAL_FRAC_BITS(clipbd) + log2WeightBase;\par
00906   {\cf17 const} int32_t offsetWeighted = (1 << (shiftWeighted - 1)) + (IF_INTERNAL_OFFS << log2WeightBase);\par
00907   {\cf17 const} uint32_t scaleX = getComponentScaleX(compIdx, pu.chromaFormat);\par
00908   {\cf17 const} uint32_t scaleY = getComponentScaleY(compIdx, pu.chromaFormat);\par
00909 \par
00910   int16_t angle = g_GeoParams[splitDir][0];\par
00911   int16_t wIdx = floorLog2(pu.lwidth()) - GEO_MIN_CU_LOG2;\par
00912   int16_t hIdx = floorLog2(pu.lheight()) - GEO_MIN_CU_LOG2;\par
00913   int16_t stepX = 1 << scaleX;\par
00914   int16_t stepY = 0;\par
00915   int16_t* weight = {\cf17 nullptr};\par
00916   {\cf19 if} (g_angle2mirror[angle] == 2)\par
00917   \{\par
00918     stepY = -(int)((GEO_WEIGHT_MASK_SIZE << scaleY) + pu.lwidth());\par
00919     weight = &g_globalGeoWeights[g_angle2mask[angle]][(GEO_WEIGHT_MASK_SIZE - 1 - g_weightOffset[splitDir][hIdx][wIdx][1]) * GEO_WEIGHT_MASK_SIZE + g_weightOffset[splitDir][hIdx][wIdx][0]];\par
00920   \}\par
00921   {\cf19 else} {\cf19 if} (g_angle2mirror[angle] == 1)\par
00922   \{\par
00923     stepX = -1 << scaleX;\par
00924     stepY = (GEO_WEIGHT_MASK_SIZE << scaleY) + pu.lwidth();\par
00925     weight = &g_globalGeoWeights[g_angle2mask[angle]][g_weightOffset[splitDir][hIdx][wIdx][1] * GEO_WEIGHT_MASK_SIZE + (GEO_WEIGHT_MASK_SIZE - 1 - g_weightOffset[splitDir][hIdx][wIdx][0])];\par
00926   \}\par
00927   {\cf19 else}\par
00928   \{\par
00929     stepY = (GEO_WEIGHT_MASK_SIZE << scaleY) - pu.lwidth();\par
00930     weight = &g_globalGeoWeights[g_angle2mask[angle]][g_weightOffset[splitDir][hIdx][wIdx][1] * GEO_WEIGHT_MASK_SIZE + g_weightOffset[splitDir][hIdx][wIdx][0]];\par
00931   \}\par
00932   {\cf19 for}( {\cf18 int} y = 0; y < height; y++ )\par
00933   \{\par
00934     {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00935     \{\par
00936       *dst++  = ClipPel(rightShift((*weight*(*src0++) + ((8 - *weight) * (*src1++)) + offsetWeighted), shiftWeighted), clipRng);\par
00937       weight += stepX;\par
00938     \}\par
00939     dst    += strideDst;\par
00940     src0   += strideSrc0;\par
00941     src1   += strideSrc1;\par
00942     weight += stepY;\par
00943   \}\par
00944 \}\par
