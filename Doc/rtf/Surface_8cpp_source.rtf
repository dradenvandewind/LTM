00053 Surface::Surface({\cf17 const} std::string name, uint64_t checksum, {\cf17 const} std::shared_ptr<Buffer> &buffer, {\cf18 unsigned} offset, {\cf18 unsigned} width,\par
00054                  {\cf18 unsigned} height, {\cf18 unsigned} stride)\par
00055     : name_(name), checksum_(checksum), buffer_(buffer), offset_(offset), width_(width), height_(height), stride_(stride) \{\}\par
00056 \par
00057 {\cf20 // Global debug state for surface dumping}\par
00058 {\cf20 //}\par
00059 {\cf17 static} {\cf18 bool} dump_surfaces = {\cf17 true};\par
00060 {\cf17 static} std::map<std::string, std::unique_ptr<YUVWriter>> yuv_writers;\par
00061 \par
00062 {\cf18 void} Surface::set_dump_surfaces({\cf18 bool} b) \{ dump_surfaces = b; \}\par
00063 \par
00064 {\cf18 bool} Surface::get_dump_surfaces() \{ {\cf19 return} dump_surfaces; \}\par
00065 \par
00066 {\cf20 // Dump surface as 8bit p420, with dummy chroma planes}\par
00067 {\cf20 //}\par
00068 {\cf18 void} Surface::dump_p420({\cf17 const} std::string &name){\cf17  const }\{\par
00069     {\cf19 if} (!dump_surfaces)\par
00070         {\cf19 return};\par
00071 \par
00072     ImageDescription desc(IMAGE_FORMAT_YUV420P8, width(), height());\par
00073 \par
00074     {\cf19 if} (yuv_writers.find(name) == yuv_writers.end())\par
00075         yuv_writers[name] = CreateYUVWriter(name, desc, {\cf17 true});\par
00076 \par
00077     Surface planes[3];\par
00078 \par
00079     {\cf19 if} (bpp() == 1)\par
00080         {\cf20 // Just use base as bytes}\par
00081         planes[0] = *{\cf17 this};\par
00082     {\cf19 else}\par
00083         {\cf20 // Assume S87}\par
00084         planes[0] = ConvertToU8().process(*{\cf17 this}, 7);\par
00085 \par
00086     {\cf20 // Create a dummy surface for U&V}\par
00087     {\cf17 auto} sb = Surface::build_from<uint8_t>();\par
00088     {\cf20 // sb.reserve(width() / 2, height() / 2);}\par
00089     sb.reserve(width() >> 1, height() >> 1);\par
00090     memset(sb.data(0, 0), 0x80, sb.width() * sb.height());\par
00091     planes[1] = planes[2] = sb.finish();\par
00092 \par
00093     yuv_writers[name]->write(Image(name, desc, 0, planes));\par
00094 \}\par
00095 \par
00096 {\cf20 // Dump surface as 8bpp, 10bpp, 12bpp, or 14bpp with correct chroma subsampling and proper chroma planes}\par
00097 {\cf20 //}\par
00098 {\cf18 void} Surface::dump_yuv({\cf17 const} std::string &name, Surface (&planes)[3], ImageDescription desc, {\cf18 bool} decorate){\cf17  const }\{\par
00099     {\cf19 if} (desc.bit_depth() == 8) \{\par
00100         Surface converted[3];\par
00101         {\cf19 if} (yuv_writers.find(name) == yuv_writers.end())\par
00102             yuv_writers[name] = CreateYUVWriter(name, desc, decorate);\par
00103         {\cf19 for} ({\cf18 unsigned} p = 0; p < desc.num_planes(); p++)\par
00104             converted[p] = ConvertToU8().process(planes[p], 7);\par
00105         yuv_writers[name]->write(Image(name, desc, 0, converted));\par
00106     \} {\cf19 else} {\cf19 if} (desc.bit_depth() == 10) \{\par
00107         Surface converted[3];\par
00108         {\cf19 if} (yuv_writers.find(name) == yuv_writers.end())\par
00109             yuv_writers[name] = CreateYUVWriter(name, desc, decorate);\par
00110         {\cf19 for} ({\cf18 unsigned} p = 0; p < desc.num_planes(); p++)\par
00111             converted[p] = ConvertToU16().process(planes[p], 5);\par
00112         yuv_writers[name]->write(Image(name, desc, 0, converted));\par
00113     \} {\cf19 else} {\cf19 if} (desc.bit_depth() == 12) \{\par
00114         Surface converted[3];\par
00115         {\cf19 if} (yuv_writers.find(name) == yuv_writers.end())\par
00116             yuv_writers[name] = CreateYUVWriter(name, desc, decorate);\par
00117         {\cf19 for} ({\cf18 unsigned} p = 0; p < desc.num_planes(); p++)\par
00118             converted[p] = ConvertToU16().process(planes[p], 3);\par
00119         yuv_writers[name]->write(Image(name, desc, 0, converted));\par
00120     \} {\cf19 else} {\cf19 if} (desc.bit_depth() == 14) \{\par
00121         Surface converted[3];\par
00122         {\cf19 if} (yuv_writers.find(name) == yuv_writers.end())\par
00123             yuv_writers[name] = CreateYUVWriter(name, desc, decorate);\par
00124         {\cf19 for} ({\cf18 unsigned} p = 0; p < desc.num_planes(); p++)\par
00125             converted[p] = ConvertToU16().process(planes[p], 1);\par
00126         yuv_writers[name]->write(Image(name, desc, 0, converted));\par
00127     \} {\cf19 else} \{\par
00128         INFO({\cf22 "Image Format not supported %4d bpp"}, desc.bit_depth());\par
00129     \}\par
00130 \}\par
00131 \par
00132 {\cf20 // Dump surface as 8 or 16 bit Y}\par
00133 {\cf20 //}\par
00134 {\cf18 void} Surface::dump({\cf17 const} std::string &name){\cf17  const }\{\par
00135     {\cf19 if} (!dump_surfaces)\par
00136         {\cf19 return};\par
00137 \par
00138     ImageFormat fmt = IMAGE_FORMAT_NONE;\par
00139     {\cf19 switch} (bpp()) \{\par
00140     {\cf19 case} 2:\par
00141         fmt = IMAGE_FORMAT_Y16;\par
00142         {\cf19 break};\par
00143     {\cf19 case} 1:\par
