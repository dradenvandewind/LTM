00103 {\cf17 struct }MotionInfo\par
00104 \{\par
00105   {\cf18 bool}     isInter;\par
00106   {\cf18 bool}     isIBCmot;\par
00107   {\cf18 char}     interDir;\par
00108   {\cf18 bool}     useAltHpelIf;\par
00109   uint16_t   sliceIdx;\par
00110   Mv      mv     [ NUM_REF_PIC_LIST_01 ];\par
00111   int16_t   refIdx [ NUM_REF_PIC_LIST_01 ];\par
00112   uint8_t         BcwIdx;\par
00113   Mv      bv;\par
00114   MotionInfo() : isInter(false), isIBCmot(false), interDir(0), useAltHpelIf(false), sliceIdx(0), refIdx\{ NOT_VALID, NOT_VALID \}, BcwIdx(0) \{ \}\par
00115   {\cf20 // ensure that MotionInfo(0) produces '\\x000....' bit pattern - needed to work with AreaBuf - don't use this constructor for anything else}\par
00116   MotionInfo({\cf18 int} i) : isInter(i != 0), isIBCmot(false), interDir(0), useAltHpelIf(false), sliceIdx(0), refIdx\{ 0,         0 \}, BcwIdx(0) \{ CHECKD(i != 0, {\cf22 "The argument for this constructor has to be '0'"}); \}\par
00117 \par
00118   {\cf18 bool} operator==( {\cf17 const} MotionInfo& mi ){\cf17  const}\par
00119 {\cf17   }\{\par
00120     {\cf19 if}( isInter != mi.isInter  ) {\cf19 return} {\cf17 false};\par
00121     {\cf19 if} (isIBCmot != mi.isIBCmot) {\cf19 return} {\cf17 false};\par
00122     {\cf19 if}( isInter )\par
00123     \{\par
00124       {\cf19 if}( sliceIdx != mi.sliceIdx ) {\cf19 return} {\cf17 false};\par
00125       {\cf19 if}( interDir != mi.interDir ) {\cf19 return} {\cf17 false};\par
00126 \par
00127       {\cf19 if}( interDir != 2 )\par
00128       \{\par
00129         {\cf19 if}( refIdx[0] != mi.refIdx[0] ) {\cf19 return} {\cf17 false};\par
00130         {\cf19 if}( mv[0]     != mi.mv[0]     ) {\cf19 return} {\cf17 false};\par
00131       \}\par
00132 \par
00133       {\cf19 if}( interDir != 1 )\par
00134       \{\par
00135         {\cf19 if}( refIdx[1] != mi.refIdx[1] ) {\cf19 return} {\cf17 false};\par
00136         {\cf19 if}( mv[1]     != mi.mv[1]     ) {\cf19 return} {\cf17 false};\par
00137       \}\par
00138     \}\par
00139 \par
00140     {\cf19 return} {\cf17 true};\par
00141   \}\par
00142 \par
00143   {\cf18 bool} operator!=( {\cf17 const} MotionInfo& mi ){\cf17  const}\par
00144 {\cf17   }\{\par
00145     {\cf19 return} !( *{\cf17 this} == mi );\par
00146   \}\par
00147 \};\par
