00074 {\cf17 struct }MvField\par
00075 \{\par
00076   Mv    mv;\par
00077   int16_t refIdx;\par
00078 \par
00079   MvField()                                    :            refIdx( NOT_VALID ) \{\}\par
00080   MvField( Mv {\cf17 const} & cMv, {\cf17 const} {\cf18 int} iRefIdx ) : mv( cMv ), refIdx(   iRefIdx ) \{\}\par
00081 \par
00082   {\cf18 void} setMvField( Mv {\cf17 const} & cMv, {\cf17 const} {\cf18 int} iRefIdx )\par
00083   \{\par
00084     CHECK( iRefIdx == -1 && cMv != Mv(0,0), {\cf22 "Must not happen."} );\par
00085     mv     = cMv;\par
00086     refIdx = iRefIdx;\par
00087   \}\par
00088 \par
00089   {\cf18 bool} operator==( {\cf17 const} MvField& other ){\cf17  const}\par
00090 {\cf17   }\{\par
00091     CHECK( refIdx == -1 && mv != Mv(0,0), {\cf22 "Error in operator== of MvField."} );\par
00092     CHECK( other.refIdx == -1 && other.mv != Mv(0,0), {\cf22 "Error in operator== of MvField."} );\par
00093     {\cf19 return} refIdx == other.refIdx && mv == other.mv;\par
00094   \}\par
00095   {\cf18 bool} operator!=( {\cf17 const} MvField& other ){\cf17  const}\par
00096 {\cf17   }\{\par
00097     CHECK( refIdx == -1 && mv != Mv(0,0), {\cf22 "Error in operator!= of MvField."} );\par
00098     CHECK( other.refIdx == -1 && other.mv != Mv(0,0), {\cf22 "Error in operator!= of MvField."} );\par
00099     {\cf19 return} refIdx != other.refIdx || mv != other.mv;\par
00100   \}\par
00101 \};\par
