00158         {\cf20 // Temp. copy of AU}\par
00159         vector<uint8_t> b(data, data + data_size);\par
00160 \par
00161         {\cf20 // Pick out enhancement data - may be removed - new size is returned}\par
00162         {\cf18 size_t} new_size =\par
00163             scan_enhancement(b.data(), data_size, encapsulation_, BaseCoding_AVC, pts, [is_base_idr, {\cf17 this}]({\cf17 const} Packet &pkt) \{\par
00164                 this->enhancement_queue_.push(\{pkt, is_base_idr\});\par
00165             \});\par
00166 \par
00167         goReportStructure.miTimeStamp = (int)(pts);\par
00168         goReportStructure.miPictureType = iPictureType;\par
00169         goReportStructure.miBaseSize = (int)(new_size);\par
00170         goReportStructure.miEnhancementSize = (int)(data_size - new_size);\par
00171         goReportQueue.push(goReportStructure);\par
00172 \par
00173         b.resize(new_size);\par
00174 \par
00175         {\cf20 // Flush any previous buffer}\par
00176         {\cf19 if} (!buffer_.empty())\par
00177             push_es(buffer_.data(), buffer_.size(), pts, is_base_idr);\par
00178 \par
00179         buffer_.swap(b);\par
00180     \} {\cf19 else} \{\par
00181         {\cf19 if} (!buffer_.empty()) \{\par
00182             push_es(buffer_.data(), buffer_.size(), pts, is_base_idr);\par
00183         \}\par
00184 \par
00185         flush();\par
00186     \}\par
