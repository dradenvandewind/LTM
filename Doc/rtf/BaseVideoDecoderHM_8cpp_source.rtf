00201 {\cf18 void} BaseVideoDecoderHM::flush() \{\par
00202     Bool openedRecon = {\cf17 false};\par
00203     {\cf18 bool} loopFiltered = {\cf17 false};\par
00204     {\cf18 int} poc = 0;\par
00205     TComList<TComPic *> *pcListPic = NULL;\par
00206     InputByteStream bytestream(base_bitstream_);\par
00207 \par
00208     {\cf19 while} (!!base_bitstream_) \{\par
00209         streampos location = base_bitstream_.tellg();\par
00210 \par
00211         AnnexBStats stats = AnnexBStats();\par
00212         InputNALUnit nalu;\par
00213         byteStreamNALUnit(bytestream, nalu.getBitstream().getFifo(), stats);\par
00214 \par
00215         {\cf20 // call actual decoding function}\par
00216         Bool bNewPicture = {\cf17 false};\par
00217         {\cf19 if} (nalu.getBitstream().getFifo().empty()) \{\par
00218             WARN({\cf22 "Attempt to decode an empty NAL unit"});\par
00219         \} {\cf19 else} \{\par
00220             read(nalu);\par
00221             {\cf18 int} skip = 0;\par
00222             bNewPicture = m_cTDecTop.decode(nalu, skip, m_iPOCLastDisplay);\par
00223 \par
00224             {\cf19 if} (bNewPicture) \{\par
00225                 base_bitstream_.clear();\par
00226                 base_bitstream_.seekg(location - streamoff(3));\par
00227                 bytestream.reset();\par
00228             \}\par
00229         \}\par
00230 \par
00231         {\cf19 if} ((bNewPicture || !base_bitstream_ || nalu.m_nalUnitType == NAL_UNIT_EOS) && !m_cTDecTop.getFirstSliceInSequence()) \{\par
00232             {\cf19 if} (!loopFiltered || base_bitstream_) \{\par
00233                 m_cTDecTop.executeLoopFilters(poc, pcListPic);\par
00234             \}\par
00235             loopFiltered = (nalu.m_nalUnitType == NAL_UNIT_EOS);\par
00236             {\cf19 if} (nalu.m_nalUnitType == NAL_UNIT_EOS) \{\par
00237                 m_cTDecTop.setFirstSliceInSequence({\cf17 true});\par
00238             \}\par
00239         \} {\cf19 else} {\cf19 if} ((bNewPicture || !base_bitstream_ || nalu.m_nalUnitType == NAL_UNIT_EOS) &&\par
00240                    m_cTDecTop.getFirstSliceInSequence()) \{\par
00241             m_cTDecTop.setFirstSliceInPicture({\cf17 true});\par
00242         \}\par
00243 \par
00244         {\cf19 if} (pcListPic) \{\par
00245             {\cf19 if} (!openedRecon) \{\par
00246                 {\cf17 const} BitDepths &bitDepths =\par
00247                     pcListPic->front()->getPicSym()->getSPS().getBitDepths(); {\cf20 // use bit depths of first reconstructed picture.}\par
00248                 {\cf19 for} (UInt channelType = 0; channelType < MAX_NUM_CHANNEL_TYPE; channelType++) \{\par
00249                     {\cf19 if} (m_outputBitDepth[channelType] == 0) \{\par
00250                         m_outputBitDepth[channelType] = bitDepths.recon[channelType];\par
00251                     \}\par
00252                 \}\par
00253 \par
00254                 m_cTVideoIOYuvRecon.open({\cf17 this}, m_outputBitDepth, m_outputBitDepth, bitDepths.recon); {\cf20 // write mode}\par
00255                 openedRecon = {\cf17 true};\par
00256             \}\par
00257 \par
00258             {\cf20 // write reconstruction to file}\par
00259             {\cf19 if} (bNewPicture) \{\par
00260                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00261             \}\par
00262             {\cf19 if} ((bNewPicture || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_CRA) && m_cTDecTop.getNoOutputPriorPicsFlag()) \{\par
00263                 m_cTDecTop.checkNoOutputPriorPics(pcListPic);\par
00264                 m_cTDecTop.setNoOutputPriorPicsFlag({\cf17 false});\par
00265             \}\par
00266             {\cf19 if} (bNewPicture &&\par
00267                 (nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_IDR_W_RADL || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_IDR_N_LP ||\par
00268                  nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_N_LP || nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_W_RADL ||\par
00269                  nalu.m_nalUnitType == NAL_UNIT_CODED_SLICE_BLA_W_LP)) \{\par
00270                 FlushOutput(pcListPic);\par
00271             \}\par
00272             {\cf19 if} (nalu.m_nalUnitType == NAL_UNIT_EOS) \{\par
00273                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00274                 m_cTDecTop.setFirstSliceInPicture({\cf17 false});\par
00275             \}\par
00276             {\cf20 // write reconstruction to file -- for additional bumping as defined in C.5.2.3}\par
00277             {\cf19 if} (!bNewPicture && nalu.m_nalUnitType >= NAL_UNIT_CODED_SLICE_TRAIL_N &&\par
00278                 nalu.m_nalUnitType <= NAL_UNIT_RESERVED_VCL31) \{\par
00279                 WriteOutput(pcListPic, nalu.m_temporalId);\par
00280             \}\par
00281         \}\par
00282     \}\par
00283 \par
00284     FlushOutput(pcListPic);\par
00285 \par
00286     {\cf20 // delete buffers}\par
00287     m_cTDecTop.deletePicBuffer();\par
00288 \}\par
