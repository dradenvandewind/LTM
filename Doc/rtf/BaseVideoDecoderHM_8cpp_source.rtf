00293 {\cf18 void} BaseVideoDecoderHM::WriteOutput(TComList<TComPic *> *pcListPic, {\cf18 unsigned} {\cf18 int} tId) \{\par
00294     {\cf19 if} (pcListPic->empty()) \{\par
00295         {\cf19 return};\par
00296     \}\par
00297 \par
00298     TComList<TComPic *>::iterator iterPic = pcListPic->begin();\par
00299     Int numPicsNotYetDisplayed = 0;\par
00300     Int dpbFullness = 0;\par
00301     {\cf17 const} TComSPS *activeSPS = &(pcListPic->front()->getPicSym()->getSPS());\par
00302     UInt numReorderPicsHighestTid;\par
00303     UInt maxDecPicBufferingHighestTid;\par
00304     UInt maxNrSublayers = activeSPS->getMaxTLayers();\par
00305 \par
00306     numReorderPicsHighestTid = activeSPS->getNumReorderPics(maxNrSublayers - 1);\par
00307     maxDecPicBufferingHighestTid = activeSPS->getMaxDecPicBuffering(maxNrSublayers - 1);\par
00308 \par
00309     {\cf19 while} (iterPic != pcListPic->end()) \{\par
00310         TComPic *pcPic = *(iterPic);\par
00311         {\cf19 if} (pcPic->getOutputMark() && pcPic->getPOC() > m_iPOCLastDisplay) \{\par
00312             numPicsNotYetDisplayed++;\par
00313             dpbFullness++;\par
00314         \} {\cf19 else} {\cf19 if} (pcPic->getSlice(0)->isReferenced()) \{\par
00315             dpbFullness++;\par
00316         \}\par
00317         iterPic++;\par
00318     \}\par
00319 \par
00320     iterPic = pcListPic->begin();\par
00321 \par
00322     {\cf19 if} (numPicsNotYetDisplayed > 2) \{\par
00323         iterPic++;\par
00324     \}\par
00325 \par
00326     TComPic *pcPic = *(iterPic);\par
00327     {\cf19 if} (numPicsNotYetDisplayed > 2 && pcPic->isField()) {\cf20 // Field Decoding}\par
00328     \{\par
00329         TComList<TComPic *>::iterator endPic = pcListPic->end();\par
00330         endPic--;\par
00331         iterPic = pcListPic->begin();\par
00332         {\cf19 while} (iterPic != endPic) \{\par
00333             TComPic *pcPicTop = *(iterPic);\par
00334             iterPic++;\par
00335             TComPic *pcPicBottom = *(iterPic);\par
00336 \par
00337             {\cf19 if} (pcPicTop->getOutputMark() && pcPicBottom->getOutputMark() &&\par
00338                 (numPicsNotYetDisplayed > numReorderPicsHighestTid || dpbFullness > maxDecPicBufferingHighestTid) &&\par
00339                 (!(pcPicTop->getPOC() % 2) && pcPicBottom->getPOC() == pcPicTop->getPOC() + 1) &&\par
00340                 (pcPicTop->getPOC() == m_iPOCLastDisplay + 1 || m_iPOCLastDisplay < 0)) \{\par
00341                 {\cf20 // write to file}\par
00342                 numPicsNotYetDisplayed = numPicsNotYetDisplayed - 2;\par
00343                 {\cf17 const} Window &conf = pcPicTop->getConformanceWindow();\par
00344                 {\cf17 const} Window defDisp = pcPicTop->getDefDisplayWindow();\par
00345                 {\cf17 const} Bool isTff = pcPicTop->isTopField();\par
00346 \par
00347                 m_cTVideoIOYuvRecon.write(pcPicTop->getPicYuvRec(), pcPicBottom->getPicYuvRec(),\par
00348                                           IPCOLOURSPACE_UNCHANGED {\cf20 /*m_outputColourSpaceConvert*/},\par
00349                                           conf.getWindowLeftOffset() + defDisp.getWindowLeftOffset(),\par
00350                                           conf.getWindowRightOffset() + defDisp.getWindowRightOffset(),\par
00351                                           conf.getWindowTopOffset() + defDisp.getWindowTopOffset(),\par
00352                                           conf.getWindowBottomOffset() + defDisp.getWindowBottomOffset(), NUM_CHROMA_FORMAT, isTff);\par
00353 \par
00354                 {\cf20 // update POC of display order}\par
00355                 m_iPOCLastDisplay = pcPicBottom->getPOC();\par
00356 \par
00357                 {\cf20 // erase non-referenced picture in the reference picture list after display}\par
00358                 {\cf19 if} (!pcPicTop->getSlice(0)->isReferenced() && pcPicTop->getReconMark() == {\cf17 true}) \{\par
00359                     pcPicTop->setReconMark({\cf17 false});\par
00360 \par
00361                     {\cf20 // mark it should be extended later}\par
00362                     pcPicTop->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00363                 \}\par
00364                 {\cf19 if} (!pcPicBottom->getSlice(0)->isReferenced() && pcPicBottom->getReconMark() == {\cf17 true}) \{\par
00365                     pcPicBottom->setReconMark({\cf17 false});\par
00366 \par
00367                     {\cf20 // mark it should be extended later}\par
00368                     pcPicBottom->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00369                 \}\par
00370                 pcPicTop->setOutputMark({\cf17 false});\par
00371                 pcPicBottom->setOutputMark({\cf17 false});\par
00372             \}\par
00373         \}\par
00374     \} {\cf19 else} {\cf19 if} (!pcPic->isField()) {\cf20 // Frame Decoding}\par
00375     \{\par
00376         iterPic = pcListPic->begin();\par
00377 \par
00378         {\cf19 while} (iterPic != pcListPic->end()) \{\par
00379             pcPic = *(iterPic);\par
00380 \par
00381             {\cf19 if} (pcPic->getOutputMark() && pcPic->getPOC() > m_iPOCLastDisplay &&\par
00382                 (numPicsNotYetDisplayed > numReorderPicsHighestTid || dpbFullness > maxDecPicBufferingHighestTid)) \{\par
00383                 {\cf20 // write to file}\par
00384                 numPicsNotYetDisplayed--;\par
00385                 {\cf19 if} (pcPic->getSlice(0)->isReferenced() == {\cf17 false}) \{\par
00386                     dpbFullness--;\par
00387                 \}\par
00388 \par
00389                 {\cf17 const} Window &conf = pcPic->getConformanceWindow();\par
00390                 {\cf17 const} Window defDisp = {\cf17 true} {\cf20 /*m_respectDefDispWindow*/} ? pcPic->getDefDisplayWindow() : Window();\par
00391 \par
00392                 m_cTVideoIOYuvRecon.write(pcPic->getPicYuvRec(), IPCOLOURSPACE_UNCHANGED {\cf20 /*m_outputColourSpaceConvert*/},\par
00393                                           conf.getWindowLeftOffset() + defDisp.getWindowLeftOffset(),\par
00394                                           conf.getWindowRightOffset() + defDisp.getWindowRightOffset(),\par
00395                                           conf.getWindowTopOffset() + defDisp.getWindowTopOffset(),\par
00396                                           conf.getWindowBottomOffset() + defDisp.getWindowBottomOffset(), NUM_CHROMA_FORMAT,\par
00397                                           {\cf17 false} {\cf20 /*m_bClipOutputVideoToRec709Range */});\par
00398 \par
00399                 {\cf20 // update POC of display order}\par
00400                 m_iPOCLastDisplay = pcPic->getPOC();\par
00401 \par
00402                 {\cf20 // erase non-referenced picture in the reference picture list after display}\par
00403                 {\cf19 if} (!pcPic->getSlice(0)->isReferenced() && pcPic->getReconMark() == {\cf17 true}) \{\par
00404                     pcPic->setReconMark({\cf17 false});\par
00405 \par
00406                     {\cf20 // mark it should be extended later}\par
00407                     pcPic->getPicYuvRec()->setBorderExtension({\cf17 false});\par
00408                 \}\par
00409                 pcPic->setOutputMark({\cf17 false});\par
00410             \}\par
00411 \par
00412             iterPic++;\par
00413         \}\par
00414     \}\par
00415 \}\par
