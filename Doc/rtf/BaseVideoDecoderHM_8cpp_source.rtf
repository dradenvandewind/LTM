00189 {\cf18 void} BaseVideoDecoderHM::push_es({\cf17 const} uint8_t *data, {\cf18 size_t} data_size, uint64_t pts, {\cf18 bool} is_base_idr) \{\par
00190 \par
00191     {\cf20 // Fixup NALU start code - if first is 3 bytes, make it 4}\par
00192     {\cf19 if} (data[0] == {\cf23 '\\0'} && data[1] == {\cf23 '\\0'} && data[2] == {\cf23 '\\1'}) \{\par
00193         {\cf18 char} {\cf17 const} zero = {\cf23 '\\0'};\par
00194         base_bitstream_.put(0);\par
00195     \}\par
00196 \par
