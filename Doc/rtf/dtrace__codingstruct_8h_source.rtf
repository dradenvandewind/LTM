00057 {\cf17 inline} {\cf18 void} dtracePicComp( DTRACE_CHANNEL channel, CodingStructure& cs, {\cf17 const} CPelUnitBuf& pelUnitBuf, ComponentID compId )\par
00058 \{\par
00059   {\cf19 if}( !g_trace_ctx ) {\cf19 return};\par
00060   {\cf19 if}( pelUnitBuf.chromaFormat == CHROMA_400 && compId != COMPONENT_Y )  {\cf19 return};\par
00061   {\cf17 const} Pel* piSrc    = pelUnitBuf.bufs[compId].buf;\par
00062   uint32_t       uiStride = pelUnitBuf.bufs[compId].stride;\par
00063   uint32_t       uiWidth  = pelUnitBuf.bufs[compId].width;\par
00064   uint32_t       uiHeight = pelUnitBuf.bufs[compId].height;\par
00065   uint32_t       uiChromaScaleX = getComponentScaleX( compId, pelUnitBuf.chromaFormat );\par
00066   uint32_t       uiChromaScaleY = getComponentScaleY( compId, pelUnitBuf.chromaFormat );\par
00067 \par
00068   DTRACE                ( g_trace_ctx, channel, {\cf22 "\\n%s: poc = %d, size=%dx%d\\n\\n"}, g_trace_ctx->getChannelName(channel), cs.slice->getPOC(), uiWidth, uiHeight );\par
00069   DTRACE_FRAME_BLOCKWISE( g_trace_ctx, channel, piSrc, uiStride, uiWidth, uiHeight, cs.sps->getMaxCUWidth() >> uiChromaScaleX, cs.sps->getMaxCUHeight() >> uiChromaScaleY);\par
00070 \}\par
00071 \par
00072 {\cf21 #define OLD_RDCOST 1}\par
00073 \par
00074 {\cf17 inline} {\cf18 void} dtraceModeCost(CodingStructure &cs, {\cf18 double} lambda)\par
00075 \{\par
00076   CHECK( cs.cus.size() != 1, {\cf22 "Only the cost for a single CU can be show with dtraceModeCost!"} );\par
00077 \par
00078   Distortion tempDist = cs.dist;\par
00079 \par
00080 {\cf21 #if OLD_RDCOST}\par
00081   uint64_t tempBits = cs.fracBits >> SCALE_BITS;\par
00082   uint64_t tempCost = (uint64_t)(cs.dist + ({\cf18 double})tempBits * lambda);\par
00083 {\cf21 #else}\par
00084   uint64_t tempBits = cs.fracBits;\par
00085   uint64_t tempCost = (uint64_t)cs.cost;\par
00086 {\cf21 #endif}\par
00087 \par
00088   {\cf19 if}( cs.cost == MAX_DOUBLE )\par
00089   \{\par
00090     tempCost = 0;\par
00091     tempBits = 0;\par
00092     tempDist = 0;\par
00093   \}\par
00094 \par
00095   {\cf18 bool} isIntra = CU::isIntra( *cs.cus.front() );\par
00096   {\cf18 int} intraModeL = isIntra ? cs.pus.front()->intraDir[0] : 0;\par
00097   {\cf18 int} intraModeC = isIntra ? cs.pus.front()->intraDir[1] : 0;\par
00098   {\cf19 if} (isIntra && intraModeC == DM_CHROMA_IDX)\par
00099     intraModeC = 68;\par
00100   {\cf18 int} imvVal = 0;\par
00101   imvVal = cs.cus[0]->imv;\par
00102   DTRACE( g_trace_ctx, D_MODE_COST, {\cf22 "ModeCost: %6lld %3d @(%4d,%4d) [%2dx%2d] %d (qp%d,pm%d,skip%d,mrg%d,fruc%d,obmc%d,ic%d,imv%d,affn%d,%d,%d) tempCS = %lld (%d,%d)\\n"},\par
00103     DTRACE_GET_COUNTER( g_trace_ctx, D_MODE_COST ),\par
00104     cs.slice->getPOC(),\par
00105     cs.area.Y().x, cs.area.Y().y,\par
00106     cs.area.Y().width, cs.area.Y().height,\par
00107     cs.cus[0]->qtDepth,\par
00108     cs.cus[0]->qp,\par
00109     cs.cus[0]->predMode,\par
00110     cs.cus[0]->skip,\par
00111     cs.pus[0]->mergeFlag,\par
00112     0, 0,\par
00113     imvVal,\par
00114     0, 0,\par
00115           intraModeL, intraModeC,\par
00116           tempCost, tempBits, tempDist );\par
00117 \}\par
00118 \par
00119 {\cf17 inline} {\cf18 void} dtraceBestMode(CodingStructure *&tempCS, CodingStructure *&bestCS, {\cf18 double} lambda)\par
00120 \{\par
00121   {\cf18 bool} bSplitCS = tempCS->cus.size() > 1 || bestCS->cus.size() > 1;\par
00122   ChannelType chType = tempCS->cus.back()->chType;\par
00123 \par
00124   {\cf20 // if the last CU does not align with the CS, we probably are at the edge}\par
00125   bSplitCS |= tempCS->cus.back()->blocks[chType].bottomRight() != tempCS->area.blocks[chType].bottomRight();\par
00126 \par
00127   Distortion tempDist = tempCS->dist;\par
00128 \par
00129 {\cf21 #if OLD_RDCOST}\par
00130   uint64_t tempBits = tempCS->fracBits >> SCALE_BITS;\par
00131   uint64_t bestBits = bestCS->fracBits >> SCALE_BITS;\par
00132   uint64_t tempCost = (uint64_t)(tempCS->dist + ({\cf18 double})tempBits * lambda);\par
00133   uint64_t bestCost = (uint64_t)(bestCS->dist + ({\cf18 double})bestBits * lambda);\par
00134 {\cf21 #else}\par
00135   uint64_t tempBits = tempCS->fracBits;\par
00136   uint64_t bestBits = bestCS->fracBits;\par
