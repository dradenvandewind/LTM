00640 {\cf18 void} Picture::sampleRateConv( {\cf17 const} std::pair<int, int> scalingRatio, {\cf17 const} std::pair<int, int> compScale,\par
00641                               {\cf17 const} CPelBuf& beforeScale, {\cf17 const} {\cf18 int} beforeScaleLeftOffset, {\cf17 const} {\cf18 int} beforeScaleTopOffset,\par
00642                               {\cf17 const} PelBuf& afterScale, {\cf17 const} {\cf18 int} afterScaleLeftOffset, {\cf17 const} {\cf18 int} afterScaleTopOffset,\par
00643                               {\cf17 const} {\cf18 int} bitDepth, {\cf17 const} {\cf18 bool} useLumaFilter, {\cf17 const} {\cf18 bool} downsampling,\par
00644                               {\cf17 const} {\cf18 bool} horCollocatedPositionFlag, {\cf17 const} {\cf18 bool} verCollocatedPositionFlag )\par
00645 \{\par
00646   {\cf17 const} Pel* orgSrc = beforeScale.buf;\par
00647   {\cf17 const} {\cf18 int} orgWidth = beforeScale.width;\par
00648   {\cf17 const} {\cf18 int} orgHeight = beforeScale.height;\par
00649   {\cf17 const} {\cf18 int} orgStride = beforeScale.stride;\par
00650 \par
00651   Pel* scaledSrc = afterScale.buf;\par
00652   {\cf17 const} {\cf18 int} scaledWidth = afterScale.width;\par
00653   {\cf17 const} {\cf18 int} scaledHeight = afterScale.height;\par
00654   {\cf17 const} {\cf18 int} scaledStride = afterScale.stride;\par
00655 \par
00656   {\cf19 if}( orgWidth == scaledWidth && orgHeight == scaledHeight && scalingRatio == SCALE_1X && !beforeScaleLeftOffset && !beforeScaleTopOffset && !afterScaleLeftOffset && !afterScaleTopOffset )\par
00657   \{\par
00658     {\cf19 for}( {\cf18 int} j = 0; j < orgHeight; j++ )\par
00659     \{\par
00660       memcpy( scaledSrc + j * scaledStride, orgSrc + j * orgStride, {\cf17 sizeof}( Pel ) * orgWidth );\par
00661     \}\par
00662 \par
00663     {\cf19 return};\par
00664   \}\par
00665 \par
00666   {\cf17 const} TFilterCoeff* filterHor = useLumaFilter ? &InterpolationFilter::m_lumaFilter[0][0] : &InterpolationFilter::m_chromaFilter[0][0];\par
00667   {\cf17 const} TFilterCoeff* filterVer = useLumaFilter ? &InterpolationFilter::m_lumaFilter[0][0] : &InterpolationFilter::m_chromaFilter[0][0];\par
00668   {\cf17 const} {\cf18 int} numFracPositions = useLumaFilter ? 15 : 31;\par
00669   {\cf17 const} {\cf18 int} numFracShift = useLumaFilter ? 4 : 5;\par
00670   {\cf17 const} {\cf18 int} posShiftX = SCALE_RATIO_BITS - numFracShift + compScale.first;\par
00671   {\cf17 const} {\cf18 int} posShiftY = SCALE_RATIO_BITS - numFracShift + compScale.second;\par
00672   {\cf18 int} addX = ( 1 << ( posShiftX - 1 ) ) + ( beforeScaleLeftOffset << SCALE_RATIO_BITS ) + ( ( {\cf18 int}( 1 - horCollocatedPositionFlag ) * 8 * ( scalingRatio.first - SCALE_1X.first ) + ( 1 << ( 2 + compScale.first ) ) ) >> ( 3 + compScale.first ) );\par
00673   {\cf18 int} addY = ( 1 << ( posShiftY - 1 ) ) + ( beforeScaleTopOffset << SCALE_RATIO_BITS ) + ( ( {\cf18 int}( 1 - verCollocatedPositionFlag ) * 8 * ( scalingRatio.second - SCALE_1X.second ) + ( 1 << ( 2 + compScale.second ) ) ) >> ( 3 + compScale.second ) );\par
00674 \par
00675   {\cf19 if}( downsampling )\par
00676   \{\par
00677     {\cf18 int} verFilter = 0;\par
00678     {\cf18 int} horFilter = 0;\par
00679 \par
00680     {\cf19 if} (scalingRatio.first > (15 << SCALE_RATIO_BITS) / 4)\par
00681     \{\par
00682       horFilter = 7;\par
00683     \}\par
00684     {\cf19 else} {\cf19 if} (scalingRatio.first > (20 << SCALE_RATIO_BITS) / 7)\par
00685     \{\par
00686       horFilter = 6;\par
00687     \}\par
00688     {\cf19 else} {\cf19 if} (scalingRatio.first > (5 << SCALE_RATIO_BITS) / 2)\par
00689     \{\par
00690       horFilter = 5;\par
00691     \}\par
00692     {\cf19 else} {\cf19 if} (scalingRatio.first > (2 << SCALE_RATIO_BITS))\par
00693     \{\par
00694       horFilter = 4;\par
00695     \}\par
00696     {\cf19 else} {\cf19 if} (scalingRatio.first > (5 << SCALE_RATIO_BITS) / 3)\par
00697     \{\par
00698       horFilter = 3;\par
00699     \}\par
00700     {\cf19 else} {\cf19 if} (scalingRatio.first > (5 << SCALE_RATIO_BITS) / 4)\par
00701     \{\par
00702       horFilter = 2;\par
00703     \}\par
00704     {\cf19 else} {\cf19 if} (scalingRatio.first > (20 << SCALE_RATIO_BITS) / 19)\par
00705     \{\par
00706       horFilter = 1;\par
00707     \}\par
00708 \par
00709     {\cf19 if} (scalingRatio.second > (15 << SCALE_RATIO_BITS) / 4)\par
00710     \{\par
00711       verFilter = 7;\par
00712     \}\par
00713     {\cf19 else} {\cf19 if} (scalingRatio.second > (20 << SCALE_RATIO_BITS) / 7)\par
00714     \{\par
00715       verFilter = 6;\par
00716     \}\par
00717     {\cf19 else} {\cf19 if} (scalingRatio.second > (5 << SCALE_RATIO_BITS) / 2)\par
00718     \{\par
00719       verFilter = 5;\par
00720     \}\par
00721     {\cf19 else} {\cf19 if} (scalingRatio.second > (2 << SCALE_RATIO_BITS))\par
00722     \{\par
00723       verFilter = 4;\par
00724     \}\par
00725     {\cf19 else} {\cf19 if} (scalingRatio.second > (5 << SCALE_RATIO_BITS) / 3)\par
00726     \{\par
00727       verFilter = 3;\par
00728     \}\par
00729     {\cf19 else} {\cf19 if} (scalingRatio.second > (5 << SCALE_RATIO_BITS) / 4)\par
00730     \{\par
00731       verFilter = 2;\par
00732     \}\par
00733     {\cf19 else} {\cf19 if} (scalingRatio.second > (20 << SCALE_RATIO_BITS) / 19)\par
00734     \{\par
00735       verFilter = 1;\par
00736     \}\par
00737 \par
00738     filterHor = &DownsamplingFilterSRC[horFilter][0][0];\par
00739     filterVer = &DownsamplingFilterSRC[verFilter][0][0];\par
00740   \}\par
00741 \par
00742   {\cf17 const} {\cf18 int} filterLength = downsampling ? 12 : ( useLumaFilter ? NTAPS_LUMA : NTAPS_CHROMA );\par
00743   {\cf17 const} {\cf18 int} log2Norm = downsampling ? 14 : 12;\par
00744 \par
00745   {\cf18 int} *buf = {\cf17 new} {\cf18 int}[orgHeight * scaledWidth];\par
00746   {\cf18 int} maxVal = ( 1 << bitDepth ) - 1;\par
00747 \par
00748   CHECK( bitDepth > 17, {\cf22 "Overflow may happen!"} );\par
00749 \par
00750   {\cf19 for}( {\cf18 int} i = 0; i < scaledWidth; i++ )\par
00751   \{\par
00752     {\cf17 const} Pel* org = orgSrc;\par
00753     {\cf18 int} refPos = ( ( ( i << compScale.first ) - afterScaleLeftOffset ) * scalingRatio.first + addX ) >> posShiftX;\par
00754     {\cf18 int} integer = refPos >> numFracShift;\par
00755     {\cf18 int} frac = refPos & numFracPositions;\par
00756     {\cf18 int}* tmp = buf + i;\par
00757 \par
00758     {\cf19 for}( {\cf18 int} j = 0; j < orgHeight; j++ )\par
00759     \{\par
00760       {\cf18 int} sum = 0;\par
00761       {\cf17 const} TFilterCoeff* f = filterHor + frac * filterLength;\par
00762 \par
00763       {\cf19 for}( {\cf18 int} k = 0; k < filterLength; k++ )\par
00764       \{\par
00765         {\cf18 int} xInt = std::min<int>( std::max( 0, integer + k - filterLength / 2 + 1 ), orgWidth - 1 );\par
00766         sum += f[k] * org[xInt]; {\cf20 // postpone horizontal filtering gain removal after vertical filtering}\par
00767       \}\par
00768 \par
00769       *tmp = sum;\par
00770 \par
00771       tmp += scaledWidth;\par
00772       org += orgStride;\par
00773     \}\par
00774   \}\par
00775 \par
00776   Pel* dst = scaledSrc;\par
00777 \par
00778   {\cf19 for}( {\cf18 int} j = 0; j < scaledHeight; j++ )\par
00779   \{\par
00780     {\cf18 int} refPos = ( ( ( j << compScale.second ) - afterScaleTopOffset ) * scalingRatio.second + addY ) >> posShiftY;\par
00781     {\cf18 int} integer = refPos >> numFracShift;\par
00782     {\cf18 int} frac = refPos & numFracPositions;\par
00783 \par
00784     {\cf19 for}( {\cf18 int} i = 0; i < scaledWidth; i++ )\par
00785     \{\par
00786       {\cf18 int} sum = 0;\par
00787       {\cf18 int}* tmp = buf + i;\par
00788       {\cf17 const} TFilterCoeff* f = filterVer + frac * filterLength;\par
00789 \par
00790       {\cf19 for}( {\cf18 int} k = 0; k < filterLength; k++ )\par
00791       \{\par
00792         {\cf18 int} yInt = std::min<int>( std::max( 0, integer + k - filterLength / 2 + 1 ), orgHeight - 1 );\par
00793         sum += f[k] * tmp[yInt*scaledWidth];\par
00794       \}\par
00795 \par
00796       dst[i] = std::min<int>( std::max( 0, ( sum + ( 1 << ( log2Norm - 1 ) ) ) >> log2Norm ), maxVal );\par
00797     \}\par
00798 \par
00799     dst += scaledStride;\par
00800   \}\par
00801 \par
00802   {\cf17 delete}[] buf;\par
00803 \}\par
