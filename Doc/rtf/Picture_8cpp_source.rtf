01339 {\cf18 void} Picture::addPictureToHashMapForInter()\par
01340 \{\par
01341   {\cf18 int} picWidth = slices[0]->getPPS()->getPicWidthInLumaSamples();\par
01342   {\cf18 int} picHeight = slices[0]->getPPS()->getPicHeightInLumaSamples();\par
01343   uint32_t* blockHashValues[2][2];\par
01344   {\cf18 bool}* bIsBlockSame[2][3];\par
01345 \par
01346   {\cf19 for} ({\cf18 int} i = 0; i < 2; i++)\par
01347   \{\par
01348     {\cf19 for} ({\cf18 int} j = 0; j < 2; j++)\par
01349     \{\par
01350       blockHashValues[i][j] = {\cf17 new} uint32_t[picWidth*picHeight];\par
01351     \}\par
01352 \par
01353     {\cf19 for} ({\cf18 int} j = 0; j < 3; j++)\par
01354     \{\par
01355       bIsBlockSame[i][j] = {\cf17 new} {\cf18 bool}[picWidth*picHeight];\par
01356     \}\par
01357   \}\par
01358   m_hashMap.create(picWidth, picHeight);\par
01359   m_hashMap.generateBlock2x2HashValue(getOrigBuf(), picWidth, picHeight, slices[0]->getSPS()->getBitDepths(), blockHashValues[0], bIsBlockSame[0]);{\cf20 //2x2}\par
01360   m_hashMap.generateBlockHashValue(picWidth, picHeight, 4, 4, blockHashValues[0], blockHashValues[1], bIsBlockSame[0], bIsBlockSame[1]);{\cf20 //4x4}\par
01361   m_hashMap.addToHashMapByRowWithPrecalData(blockHashValues[1], bIsBlockSame[1][2], picWidth, picHeight, 4, 4);\par
01362 \par
01363   m_hashMap.generateBlockHashValue(picWidth, picHeight, 8, 8, blockHashValues[1], blockHashValues[0], bIsBlockSame[1], bIsBlockSame[0]);{\cf20 //8x8}\par
01364   m_hashMap.addToHashMapByRowWithPrecalData(blockHashValues[0], bIsBlockSame[0][2], picWidth, picHeight, 8, 8);\par
01365 \par
01366   m_hashMap.generateBlockHashValue(picWidth, picHeight, 16, 16, blockHashValues[0], blockHashValues[1], bIsBlockSame[0], bIsBlockSame[1]);{\cf20 //16x16}\par
01367   m_hashMap.addToHashMapByRowWithPrecalData(blockHashValues[1], bIsBlockSame[1][2], picWidth, picHeight, 16, 16);\par
01368 \par
01369   m_hashMap.generateBlockHashValue(picWidth, picHeight, 32, 32, blockHashValues[1], blockHashValues[0], bIsBlockSame[1], bIsBlockSame[0]);{\cf20 //32x32}\par
01370   m_hashMap.addToHashMapByRowWithPrecalData(blockHashValues[0], bIsBlockSame[0][2], picWidth, picHeight, 32, 32);\par
01371 \par
01372   m_hashMap.generateBlockHashValue(picWidth, picHeight, 64, 64, blockHashValues[0], blockHashValues[1], bIsBlockSame[0], bIsBlockSame[1]);{\cf20 //64x64}\par
01373   m_hashMap.addToHashMapByRowWithPrecalData(blockHashValues[1], bIsBlockSame[1][2], picWidth, picHeight, 64, 64);\par
01374 \par
01375   m_hashMap.setInitial();\par
01376 \par
01377   {\cf19 for} ({\cf18 int} i = 0; i < 2; i++)\par
01378   \{\par
01379     {\cf19 for} ({\cf18 int} j = 0; j < 2; j++)\par
01380     \{\par
01381       {\cf17 delete}[] blockHashValues[i][j];\par
01382     \}\par
01383 \par
01384     {\cf19 for} ({\cf18 int} j = 0; j < 3; j++)\par
01385     \{\par
01386       {\cf17 delete}[] bIsBlockSame[i][j];\par
01387     \}\par
01388   \}\par
01389 \}\par
