00825 {\cf18 void} Picture::saveSubPicBorder({\cf18 int} POC, {\cf18 int} subPicX0, {\cf18 int} subPicY0, {\cf18 int} subPicWidth, {\cf18 int} subPicHeight)\par
00826 \{\par
00827 \par
00828   {\cf20 // 1.1 set up margin for back up memory allocation}\par
00829   {\cf18 int} xMargin = margin >> getComponentScaleX(COMPONENT_Y, cs->area.chromaFormat);\par
00830   {\cf18 int} yMargin = margin >> getComponentScaleY(COMPONENT_Y, cs->area.chromaFormat);\par
00831 \par
00832   {\cf20 // 1.2 measure the size of back up memory}\par
00833   Area areaAboveBelow(0, 0, subPicWidth + 2 * xMargin, yMargin);\par
00834   Area areaLeftRight(0, 0, xMargin, subPicHeight);\par
00835   UnitArea unitAreaAboveBelow(cs->area.chromaFormat, areaAboveBelow);\par
00836   UnitArea unitAreaLeftRight(cs->area.chromaFormat, areaLeftRight);\par
00837 \par
00838   {\cf20 // 1.3 create back up memory}\par
00839   m_bufSubPicAbove.create(unitAreaAboveBelow);\par
00840   m_bufSubPicBelow.create(unitAreaAboveBelow);\par
00841   m_bufSubPicLeft.create(unitAreaLeftRight);\par
00842   m_bufSubPicRight.create(unitAreaLeftRight);\par
00843   m_bufWrapSubPicAbove.create(unitAreaAboveBelow);\par
00844   m_bufWrapSubPicBelow.create(unitAreaAboveBelow);\par
00845 \par
00846   {\cf19 for} ({\cf18 int} comp = 0; comp < getNumberValidComponents(cs->area.chromaFormat); comp++)\par
00847   \{\par
00848     ComponentID compID = ComponentID(comp);\par
00849 \par
00850     {\cf20 // 2.1 measure the margin for each component}\par
00851     {\cf18 int} xmargin = margin >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00852     {\cf18 int} ymargin = margin >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00853 \par
00854     {\cf20 // 2.2 calculate the origin of the subpicture}\par
00855     {\cf18 int} left = subPicX0 >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00856     {\cf18 int} top = subPicY0 >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00857 \par
00858     {\cf20 // 2.3 calculate the width/height of the subPic}\par
00859     {\cf18 int} width = subPicWidth >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00860     {\cf18 int} height = subPicHeight >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00861 \par
00862 \par
00863     {\cf20 // 3.1.1 set reconstructed picture}\par
00864     PelBuf s = M_BUFS(0, PIC_RECONSTRUCTION).get(compID);\par
00865     Pel *src = s.bufAt(left, top);\par
00866 \par
00867     {\cf20 // 3.2.1 set back up buffer for left}\par
00868     PelBuf dBufLeft   = m_bufSubPicLeft.getBuf(compID);\par
00869     Pel    *dstLeft   = dBufLeft.bufAt(0, 0);\par
00870 \par
00871 \par
00872     {\cf20 // 3.2.2 set back up buffer for right}\par
00873     PelBuf dBufRight  = m_bufSubPicRight.getBuf(compID);\par
00874     Pel    *dstRight  = dBufRight.bufAt(0, 0);\par
00875 \par
00876     {\cf20 // 3.2.3 copy to recon picture to back up buffer}\par
00877     Pel *srcLeft  = src - xmargin;\par
00878     Pel *srcRight = src + width;\par
00879     {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00880     \{\par
00881       ::memcpy(dstLeft  + y *  dBufLeft.stride, srcLeft  + y * s.stride, {\cf17 sizeof}(Pel) * xmargin);\par
00882       ::memcpy(dstRight + y * dBufRight.stride, srcRight + y * s.stride, {\cf17 sizeof}(Pel) * xmargin);\par
00883     \}\par
00884 \par
00885     {\cf20 // 3.3.1 set back up buffer for above}\par
00886     PelBuf dBufTop = m_bufSubPicAbove.getBuf(compID);\par
00887     Pel    *dstTop = dBufTop.bufAt(0, 0);\par
00888 \par
00889     {\cf20 // 3.3.2 set back up buffer for below}\par
00890     PelBuf dBufBottom = m_bufSubPicBelow.getBuf(compID);\par
00891     Pel    *dstBottom = dBufBottom.bufAt(0, 0);\par
00892 \par
00893     {\cf20 // 3.3.3 copy to recon picture to back up buffer}\par
00894     Pel *srcTop    = src - xmargin - ymargin * s.stride;\par
00895     Pel *srcBottom = src - xmargin +  height * s.stride;\par
00896     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
00897     \{\par
00898       ::memcpy(dstTop    + y *    dBufTop.stride, srcTop    + y * s.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
00899       ::memcpy(dstBottom + y * dBufBottom.stride, srcBottom + y * s.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
00900     \}\par
00901 \par
00902     {\cf20 // back up recon wrap buffer}\par
00903     {\cf19 if} (cs->sps->getWrapAroundEnabledFlag())\par
00904     \{\par
00905       PelBuf sWrap = M_BUFS(0, PIC_RECON_WRAP).get(compID);\par
00906       Pel *srcWrap = sWrap.bufAt(left, top);\par
00907 \par
00908       {\cf20 // 3.4.1 set back up buffer for above}\par
00909       PelBuf dBufTopWrap = m_bufWrapSubPicAbove.getBuf(compID);\par
00910       Pel    *dstTopWrap = dBufTopWrap.bufAt(0, 0);\par
00911 \par
00912       {\cf20 // 3.4.2 set back up buffer for below}\par
00913       PelBuf dBufBottomWrap = m_bufWrapSubPicBelow.getBuf(compID);\par
00914       Pel    *dstBottomWrap = dBufBottomWrap.bufAt(0, 0);\par
00915 \par
00916       {\cf20 // 3.4.3 copy recon wrap picture to back up buffer}\par
00917       Pel *srcTopWrap    = srcWrap - xmargin - ymargin * sWrap.stride;\par
00918       Pel *srcBottomWrap = srcWrap - xmargin +  height * sWrap.stride;\par
00919       {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
00920       \{\par
00921         ::memcpy(dstTopWrap    + y *    dBufTopWrap.stride, srcTopWrap    + y * sWrap.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
00922         ::memcpy(dstBottomWrap + y * dBufBottomWrap.stride, srcBottomWrap + y * sWrap.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
00923       \}\par
00924     \}\par
00925   \}\par
00926 \}\par
00927 \par
00928 {\cf18 void} Picture::extendSubPicBorder({\cf18 int} POC, {\cf18 int} subPicX0, {\cf18 int} subPicY0, {\cf18 int} subPicWidth, {\cf18 int} subPicHeight)\par
00929 \{\par
00930 \par
00931   {\cf19 for} ({\cf18 int} comp = 0; comp < getNumberValidComponents(cs->area.chromaFormat); comp++)\par
00932   \{\par
00933     ComponentID compID = ComponentID(comp);\par
00934 \par
00935     {\cf20 // 2.1 measure the margin for each component}\par
00936     {\cf18 int} xmargin = margin >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00937     {\cf18 int} ymargin = margin >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00938 \par
00939     {\cf20 // 2.2 calculate the origin of the Subpicture}\par
00940     {\cf18 int} left = subPicX0 >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00941     {\cf18 int} top = subPicY0 >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00942 \par
00943     {\cf20 // 2.3 calculate the width/height of the Subpicture}\par
00944     {\cf18 int} width = subPicWidth >> getComponentScaleX(compID, cs->area.chromaFormat);\par
00945     {\cf18 int} height = subPicHeight >> getComponentScaleY(compID, cs->area.chromaFormat);\par
00946 \par
00947     {\cf20 // 3.1 set reconstructed picture}\par
00948     PelBuf s = M_BUFS(0, PIC_RECONSTRUCTION).get(compID);\par
00949     Pel *src = s.bufAt(left, top);\par
00950 \par
00951     {\cf20 // 4.1 apply padding for left and right}\par
00952     \{\par
00953       Pel *dstLeft  = src - xmargin;\par
00954       Pel *dstRight = src + width;\par
00955       Pel *srcLeft  = src + 0;\par
00956       Pel *srcRight = src + width - 1;\par
00957 \par
00958       {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00959       \{\par
00960         {\cf19 for} ({\cf18 int} x = 0; x < xmargin; x++)\par
00961         \{\par
00962           dstLeft[x]  = *srcLeft;\par
00963           dstRight[x] = *srcRight;\par
00964         \}\par
00965         dstLeft += s.stride;\par
00966         dstRight += s.stride;\par
00967         srcLeft += s.stride;\par
00968         srcRight += s.stride;\par
00969       \}\par
00970     \}\par
00971 \par
00972     {\cf20 // 4.2 apply padding on bottom}\par
00973     Pel *srcBottom = src + s.stride * (height - 1) - xmargin;\par
00974     Pel *dstBottom = srcBottom + s.stride;\par
00975     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
00976     \{\par
00977       ::memcpy(dstBottom, srcBottom, {\cf17 sizeof}(Pel)*(2 * xmargin + width));\par
00978       dstBottom += s.stride;\par
00979     \}\par
00980 \par
00981     {\cf20 // 4.3 apply padding for top}\par
00982     {\cf20 // si is still (-marginX, SubpictureHeight-1)}\par
00983     Pel *srcTop = src - xmargin;\par
00984     Pel *dstTop = srcTop - s.stride;\par
00985     {\cf20 // si is now (-marginX, 0)}\par
00986     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
00987     \{\par
00988       ::memcpy(dstTop, srcTop, {\cf17 sizeof}(Pel)*(2 * xmargin + width));\par
00989       dstTop -= s.stride;\par
00990     \}\par
00991 \par
00992     {\cf20 // Appy padding for recon wrap buffer}\par
00993     {\cf19 if} (cs->sps->getWrapAroundEnabledFlag())\par
00994     \{\par
00995       {\cf20 // set recon wrap picture}\par
00996       PelBuf sWrap = M_BUFS(0, PIC_RECON_WRAP).get(compID);\par
00997       Pel *srcWrap = sWrap.bufAt(left, top);\par
00998 \par
00999       {\cf20 // apply padding on bottom}\par
01000       Pel *srcBottomWrap = srcWrap + sWrap.stride * (height - 1) - xmargin;\par
01001       Pel *dstBottomWrap = srcBottomWrap + sWrap.stride;\par
01002       {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
01003       \{\par
01004         ::memcpy(dstBottomWrap, srcBottomWrap, {\cf17 sizeof}(Pel)*(2 * xmargin + width));\par
01005         dstBottomWrap += sWrap.stride;\par
01006       \}\par
01007 \par
01008       {\cf20 // apply padding for top}\par
01009       {\cf20 // si is still (-marginX, SubpictureHeight-1)}\par
01010       Pel *srcTopWrap = srcWrap - xmargin;\par
01011       Pel *dstTopWrap = srcTopWrap - sWrap.stride;\par
01012       {\cf20 // si is now (-marginX, 0)}\par
01013       {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
01014       \{\par
01015         ::memcpy(dstTopWrap, srcTopWrap, {\cf17 sizeof}(Pel)*(2 * xmargin + width));\par
01016         dstTopWrap -= sWrap.stride;\par
01017       \}\par
01018     \}\par
01019   \} {\cf20 // end of for}\par
01020 \}\par
