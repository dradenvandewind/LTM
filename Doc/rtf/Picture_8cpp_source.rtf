01022 {\cf18 void} Picture::restoreSubPicBorder({\cf18 int} POC, {\cf18 int} subPicX0, {\cf18 int} subPicY0, {\cf18 int} subPicWidth, {\cf18 int} subPicHeight)\par
01023 \{\par
01024   {\cf19 for} ({\cf18 int} comp = 0; comp < getNumberValidComponents(cs->area.chromaFormat); comp++)\par
01025   \{\par
01026     ComponentID compID = ComponentID(comp);\par
01027 \par
01028     {\cf20 // 2.1 measure the margin for each component}\par
01029     {\cf18 int} xmargin = margin >> getComponentScaleX(compID, cs->area.chromaFormat);\par
01030     {\cf18 int} ymargin = margin >> getComponentScaleY(compID, cs->area.chromaFormat);\par
01031 \par
01032     {\cf20 // 2.2 calculate the origin of the subpicture}\par
01033     {\cf18 int} left = subPicX0 >> getComponentScaleX(compID, cs->area.chromaFormat);\par
01034     {\cf18 int} top = subPicY0 >> getComponentScaleY(compID, cs->area.chromaFormat);\par
01035 \par
01036     {\cf20 // 2.3 calculate the width/height of the subpicture}\par
01037     {\cf18 int} width = subPicWidth >> getComponentScaleX(compID, cs->area.chromaFormat);\par
01038     {\cf18 int} height = subPicHeight >> getComponentScaleY(compID, cs->area.chromaFormat);\par
01039 \par
01040     {\cf20 // 3.1 set reconstructed picture}\par
01041     PelBuf s = M_BUFS(0, PIC_RECONSTRUCTION).get(compID);\par
01042     Pel *src = s.bufAt(left, top);\par
01043 \par
01044     {\cf20 // 4.2.1 copy from back up buffer to recon picture}\par
01045     PelBuf dBufLeft = m_bufSubPicLeft.getBuf(compID);\par
01046     Pel    *dstLeft = dBufLeft.bufAt(0, 0);\par
01047 \par
01048     {\cf20 // 4.2.2 set back up buffer for right}\par
01049     PelBuf dBufRight = m_bufSubPicRight.getBuf(compID);\par
01050     Pel    *dstRight = dBufRight.bufAt(0, 0);\par
01051 \par
01052     {\cf20 // 4.2.3 copy to recon picture to back up buffer}\par
01053     Pel *srcLeft  = src - xmargin;\par
01054     Pel *srcRight = src + width;\par
01055 \par
01056     {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
01057     \{\par
01058       {\cf20 // the destination and source position is reversed on purpose}\par
01059       ::memcpy(srcLeft  + y * s.stride,  dstLeft + y *  dBufLeft.stride, {\cf17 sizeof}(Pel) * xmargin);\par
01060       ::memcpy(srcRight + y * s.stride, dstRight + y * dBufRight.stride, {\cf17 sizeof}(Pel) * xmargin);\par
01061     \}\par
01062 \par
01063 \par
01064     {\cf20 // 4.3.1 set back up buffer for above}\par
01065     PelBuf dBufTop = m_bufSubPicAbove.getBuf(compID);\par
01066     Pel    *dstTop = dBufTop.bufAt(0, 0);\par
01067 \par
01068     {\cf20 // 4.3.2 set back up buffer for below}\par
01069     PelBuf dBufBottom = m_bufSubPicBelow.getBuf(compID);\par
01070     Pel    *dstBottom = dBufBottom.bufAt(0, 0);\par
01071 \par
01072     {\cf20 // 4.3.3 copy to recon picture to back up buffer}\par
01073     Pel *srcTop = src - xmargin - ymargin * s.stride;\par
01074     Pel *srcBottom = src - xmargin + height * s.stride;\par
01075 \par
01076     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
01077     \{\par
01078       ::memcpy(srcTop    + y * s.stride, dstTop    + y *    dBufTop.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
01079       ::memcpy(srcBottom + y * s.stride, dstBottom + y * dBufBottom.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
01080     \}\par
01081 \par
01082     {\cf20 // restore recon wrap buffer}\par
01083     {\cf19 if} (cs->sps->getWrapAroundEnabledFlag())\par
01084     \{\par
01085       {\cf20 // set recon wrap picture}\par
01086       PelBuf sWrap = M_BUFS(0, PIC_RECON_WRAP).get(compID);\par
01087       Pel *srcWrap = sWrap.bufAt(left, top);\par
01088 \par
01089       {\cf20 // set back up buffer for above}\par
01090       PelBuf dBufTopWrap = m_bufWrapSubPicAbove.getBuf(compID);\par
01091       Pel    *dstTopWrap = dBufTopWrap.bufAt(0, 0);\par
01092 \par
01093       {\cf20 // set back up buffer for below}\par
01094       PelBuf dBufBottomWrap = m_bufWrapSubPicBelow.getBuf(compID);\par
01095       Pel    *dstBottomWrap = dBufBottomWrap.bufAt(0, 0);\par
01096 \par
01097       {\cf20 // copy to recon wrap picture from back up buffer}\par
01098       Pel *srcTopWrap = srcWrap - xmargin - ymargin * sWrap.stride;\par
01099       Pel *srcBottomWrap = srcWrap - xmargin + height * sWrap.stride;\par
01100 \par
01101       {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++)\par
01102       \{\par
01103         ::memcpy(srcTopWrap    + y * sWrap.stride, dstTopWrap    + y *    dBufTopWrap.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
01104         ::memcpy(srcBottomWrap + y * sWrap.stride, dstBottomWrap + y * dBufBottomWrap.stride, {\cf17 sizeof}(Pel) * (2 * xmargin + width));\par
01105       \}\par
01106     \}\par
01107   \}\par
01108 \par
01109   {\cf20 // 5.0 destroy the back up memory}\par
01110   m_bufSubPicAbove.destroy();\par
01111   m_bufSubPicBelow.destroy();\par
01112   m_bufSubPicLeft.destroy();\par
01113   m_bufSubPicRight.destroy();\par
01114   m_bufWrapSubPicAbove.destroy();\par
01115   m_bufWrapSubPicBelow.destroy();\par
01116 \}\par
01117 \par
01118 {\cf18 void} Picture::extendPicBorder( {\cf17 const} PPS *pps )\par
01119 \{\par
01120   {\cf19 if} ( m_bIsBorderExtended )\par
01121   \{\par
01122     {\cf19 if}( isWrapAroundEnabled( pps ) && ( !m_wrapAroundValid || m_wrapAroundOffset != pps->getWrapAroundOffset() ) )\par
01123     \{\par
01124       extendWrapBorder( pps );\par
01125     \}\par
01126     {\cf19 return};\par
01127   \}\par
01128 \par
01129   {\cf19 for}({\cf18 int} comp=0; comp<getNumberValidComponents( cs->area.chromaFormat ); comp++)\par
01130   \{\par
01131     ComponentID compID = ComponentID( comp );\par
01132     PelBuf p = M_BUFS( 0, PIC_RECONSTRUCTION ).get( compID );\par
01133     Pel *piTxt = p.bufAt(0,0);\par
01134     {\cf18 int} xmargin = margin >> getComponentScaleX( compID, cs->area.chromaFormat );\par
01135     {\cf18 int} ymargin = margin >> getComponentScaleY( compID, cs->area.chromaFormat );\par
01136 \par
01137     Pel*  pi = piTxt;\par
01138     {\cf20 // do left and right margins}\par
01139     {\cf19 for} ({\cf18 int} y = 0; y < p.height; y++)\par
01140     \{\par
01141       {\cf19 for} ({\cf18 int} x = 0; x < xmargin; x++)\par
01142       \{\par
01143         pi[-xmargin + x] = pi[0];\par
01144         pi[p.width + x]  = pi[p.width - 1];\par
01145       \}\par
01146       pi += p.stride;\par
01147     \}\par
01148 \par
01149     {\cf20 // pi is now the (0,height) (bottom left of image within bigger picture}\par
01150     pi -= (p.stride + xmargin);\par
01151     {\cf20 // pi is now the (-marginX, height-1)}\par
01152     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++ )\par
01153     \{\par
01154       ::memcpy( pi + (y+1)*p.stride, pi, {\cf17 sizeof}(Pel)*(p.width + (xmargin << 1)));\par
01155     \}\par
01156 \par
01157     {\cf20 // pi is still (-marginX, height-1)}\par
01158     pi -= ((p.height-1) * p.stride);\par
01159     {\cf20 // pi is now (-marginX, 0)}\par
01160     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++ )\par
01161     \{\par
01162       ::memcpy( pi - (y+1)*p.stride, pi, {\cf17 sizeof}(Pel)*(p.width + (xmargin<<1)) );\par
01163     \}\par
01164 \par
01165     {\cf20 // reference picture with horizontal wrapped boundary}\par
01166     {\cf19 if} ( isWrapAroundEnabled( pps ) )\par
01167     \{\par
01168       extendWrapBorder( pps );\par
01169     \}\par
01170     {\cf19 else}\par
01171     \{\par
01172       m_wrapAroundValid = {\cf17 false};\par
01173       m_wrapAroundOffset = 0;\par
01174     \}\par
01175   \}\par
01176 \par
01177   m_bIsBorderExtended = {\cf17 true};\par
01178 \}\par
01179 \par
01180 {\cf18 void} Picture::extendWrapBorder( {\cf17 const} PPS *pps )\par
01181 \{\par
01182   {\cf19 for}({\cf18 int} comp=0; comp<getNumberValidComponents( cs->area.chromaFormat ); comp++)\par
01183   \{\par
01184     ComponentID compID = ComponentID( comp );\par
01185     PelBuf p = M_BUFS( 0, PIC_RECON_WRAP ).get( compID );\par
01186     p.copyFrom(M_BUFS( 0, PIC_RECONSTRUCTION ).get( compID ));\par
01187     Pel *piTxt = p.bufAt(0,0);\par
01188     {\cf18 int} xmargin = margin >> getComponentScaleX( compID, cs->area.chromaFormat );\par
01189     {\cf18 int} ymargin = margin >> getComponentScaleY( compID, cs->area.chromaFormat );\par
01190     Pel*  pi = piTxt;\par
01191     {\cf18 int} xoffset = pps->getWrapAroundOffset() >> getComponentScaleX( compID, cs->area.chromaFormat );\par
01192     {\cf19 for} ({\cf18 int} y = 0; y < p.height; y++)\par
01193     \{\par
01194       {\cf19 for} ({\cf18 int} x = 0; x < xmargin; x++ )\par
01195       \{\par
01196         {\cf19 if}( x < xoffset )\par
01197         \{\par
01198           pi[ -x - 1 ] = pi[ -x - 1 + xoffset ];\par
01199           pi[  p.width + x ] = pi[ p.width + x - xoffset ];\par
01200         \}\par
01201         {\cf19 else}\par
01202         \{\par
01203           pi[ -x - 1 ] = pi[ 0 ];\par
01204           pi[  p.width + x ] = pi[ p.width - 1 ];\par
01205         \}\par
01206       \}\par
01207       pi += p.stride;\par
01208     \}\par
01209     pi -= (p.stride + xmargin);\par
01210     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++ )\par
01211     \{\par
01212       ::memcpy( pi + (y+1)*p.stride, pi, {\cf17 sizeof}(Pel)*(p.width + (xmargin << 1)));\par
01213     \}\par
01214     pi -= ((p.height-1) * p.stride);\par
01215     {\cf19 for} ({\cf18 int} y = 0; y < ymargin; y++ )\par
01216     \{\par
01217       ::memcpy( pi - (y+1)*p.stride, pi, {\cf17 sizeof}(Pel)*(p.width + (xmargin<<1)) );\par
01218     \}\par
01219   \}\par
01220   m_wrapAroundValid = {\cf17 true};\par
01221   m_wrapAroundOffset = pps->getWrapAroundOffset();\par
01222 \}\par
01223 \par
