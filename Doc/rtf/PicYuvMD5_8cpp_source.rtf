00090 uint32_t compCRC({\cf18 int} bitdepth, {\cf17 const} Pel* plane, uint32_t width, uint32_t height, uint32_t stride, PictureHash &digest)\par
00091 \{\par
00092   uint32_t crcMsb;\par
00093   uint32_t bitVal;\par
00094   uint32_t crcVal = 0xffff;\par
00095   uint32_t bitIdx;\par
00096   {\cf19 for} (uint32_t y = 0; y < height; y++)\par
00097   \{\par
00098     {\cf19 for} (uint32_t x = 0; x < width; x++)\par
00099     \{\par
00100       {\cf20 // take CRC of first pictureData byte}\par
00101       {\cf19 for}(bitIdx=0; bitIdx<8; bitIdx++)\par
00102       \{\par
00103         crcMsb = (crcVal >> 15) & 1;\par
00104         bitVal = (plane[y*stride+x] >> (7 - bitIdx)) & 1;\par
00105         crcVal = (((crcVal << 1) + bitVal) & 0xffff) ^ (crcMsb * 0x1021);\par
00106       \}\par
00107       {\cf20 // take CRC of second pictureData byte if bit depth is greater than 8-bits}\par
00108       {\cf19 if}(bitdepth > 8)\par
00109       \{\par
00110         {\cf19 for}(bitIdx=0; bitIdx<8; bitIdx++)\par
00111         \{\par
00112           crcMsb = (crcVal >> 15) & 1;\par
00113           bitVal = (plane[y*stride+x] >> (15 - bitIdx)) & 1;\par
00114           crcVal = (((crcVal << 1) + bitVal) & 0xffff) ^ (crcMsb * 0x1021);\par
00115         \}\par
00116       \}\par
00117     \}\par
00118   \}\par
00119   {\cf19 for}(bitIdx=0; bitIdx<16; bitIdx++)\par
00120   \{\par
00121     crcMsb = (crcVal >> 15) & 1;\par
00122     crcVal = ((crcVal << 1) & 0xffff) ^ (crcMsb * 0x1021);\par
00123   \}\par
00124 \par
00125   digest.hash.push_back((crcVal>>8)  & 0xff);\par
00126   digest.hash.push_back( crcVal      & 0xff);\par
00127   {\cf19 return} 2;\par
00128 \}\par
00129 \par
00130 uint32_t calcCRC({\cf17 const} CPelUnitBuf& pic, PictureHash &digest, {\cf17 const} BitDepths &bitDepths)\par
00131 \{\par
00132   uint32_t digestLen=0;\par
00133   digest.hash.clear();\par
00134   {\cf19 for} (uint32_t chan = 0; chan< (uint32_t)pic.bufs.size(); chan++)\par
00135   \{\par
00136     {\cf17 const} ComponentID compID = ComponentID(chan);\par
00137     {\cf17 const} CPelBuf area = pic.get(compID);\par
00138     digestLen = compCRC(bitDepths.recon[toChannelType(compID)], area.bufAt(0, 0), area.width, area.height, area.stride, digest );\par
00139   \}\par
00140   {\cf19 return} digestLen;\par
00141 \}\par
00142 \par
00143 uint32_t compChecksum({\cf18 int} bitdepth, {\cf17 const} Pel* plane, uint32_t width, uint32_t height, uint32_t stride, PictureHash &digest, {\cf17 const} BitDepths &{\cf20 /*bitDepths*/})\par
00144 \{\par
00145   uint32_t checksum = 0;\par
00146   uint8_t xor_mask;\par
00147 \par
00148   {\cf19 for} (uint32_t y = 0; y < height; y++)\par
00149   \{\par
00150     {\cf19 for} (uint32_t x = 0; x < width; x++)\par
00151     \{\par
00152       xor_mask = (x & 0xff) ^ (y & 0xff) ^ (x >> 8) ^ (y >> 8);\par
00153       checksum = (checksum + ((plane[y*stride+x] & 0xff) ^ xor_mask)) & 0xffffffff;\par
00154 \par
00155       {\cf19 if}(bitdepth > 8)\par
00156       \{\par
00157         checksum = (checksum + ((plane[y*stride+x]>>8) ^ xor_mask)) & 0xffffffff;\par
00158       \}\par
00159     \}\par
00160   \}\par
00161 \par
00162   digest.hash.push_back((checksum>>24) & 0xff);\par
00163   digest.hash.push_back((checksum>>16) & 0xff);\par
00164   digest.hash.push_back((checksum>>8)  & 0xff);\par
00165   digest.hash.push_back( checksum      & 0xff);\par
00166   {\cf19 return} 4;\par
00167 \}\par
00168 \par
00169 uint32_t calcChecksum({\cf17 const} CPelUnitBuf& pic, PictureHash &digest, {\cf17 const} BitDepths &bitDepths)\par
00170 \{\par
00171   uint32_t digestLen=0;\par
00172   digest.hash.clear();\par
00173   {\cf19 for}(uint32_t chan=0; chan< (uint32_t)pic.bufs.size(); chan++)\par
00174   \{\par
00175     {\cf17 const} ComponentID compID=ComponentID(chan);\par
00176     {\cf17 const} CPelBuf area = pic.get(compID);\par
00177     digestLen=compChecksum(bitDepths.recon[toChannelType(compID)], area.bufAt(0,0), area.width, area.height, area.stride, digest, bitDepths);\par
00178   \}\par
00179   {\cf19 return} digestLen;\par
00180 \}\par
00188 uint32_t calcMD5({\cf17 const} CPelUnitBuf& pic, PictureHash &digest, {\cf17 const} BitDepths &bitDepths)\par
00189 \{\par
00190   {\cf19 return} calcMD5WithCropping(pic, digest, bitDepths, 0, 0, 0, 0);\par
00191 \}\par
00192 \par
00193 uint32_t calcMD5WithCropping({\cf17 const} CPelUnitBuf &pic, PictureHash &digest, {\cf17 const} BitDepths &bitDepths,\par
00194                              {\cf17 const} {\cf18 int} leftOffset, {\cf17 const} {\cf18 int} rightOffset, {\cf17 const} {\cf18 int} topOffset, {\cf17 const} {\cf18 int} bottomOffset)\par
00195 \{\par
00196   {\cf20 /* choose an md5_plane packing function based on the system bitdepth */}\par
00197   {\cf17 typedef} void (*MD5PlaneFunc)(MD5&, {\cf17 const} Pel*, uint32_t, uint32_t, uint32_t);\par
00198   MD5PlaneFunc md5_plane_func;\par
00199 \par
00200   MD5 md5[MAX_NUM_COMPONENT];\par
00201 \par
00202   digest.hash.clear();\par
00203 \par
00204   {\cf19 for} (uint32_t chan = 0; chan< (uint32_t)pic.bufs.size(); chan++)\par
00205   \{\par
00206     {\cf17 const} ComponentID compID           = ComponentID(chan);\par
00207     {\cf17 const} CPelBuf     area             = pic.get(compID);\par
00208     {\cf17 const} {\cf18 int}         chromaScaleX     = getComponentScaleX(compID, pic.chromaFormat);\par
00209     {\cf17 const} {\cf18 int}         chromaScaleY     = getComponentScaleY(compID, pic.chromaFormat);\par
00210     {\cf17 const} {\cf18 int}         compLeftOffset   = leftOffset >> chromaScaleX;\par
00211     {\cf17 const} {\cf18 int}         compRightOffset  = rightOffset >> chromaScaleX;\par
00212     {\cf17 const} {\cf18 int}         compTopOffset    = topOffset >> chromaScaleY;\par
00213     {\cf17 const} {\cf18 int}         compBottomOffset = bottomOffset >> chromaScaleY;\par
00214     md5_plane_func = bitDepths.recon[toChannelType(compID)] <= 8 ? (MD5PlaneFunc)md5_plane<1> : (MD5PlaneFunc)md5_plane<2>;\par
00215     uint8_t tmp_digest[MD5_DIGEST_STRING_LENGTH];\par
00216     md5_plane_func(md5[compID], area.bufAt(compLeftOffset, compTopOffset),\par
00217                    area.width - compRightOffset - compLeftOffset, area.height - compTopOffset - compBottomOffset,\par
00218                    area.stride);\par
00219     md5[compID].finalize(tmp_digest);\par
00220     {\cf19 for} (uint32_t i = 0; i < MD5_DIGEST_STRING_LENGTH; i++)\par
00221     \{\par
00222       digest.hash.push_back(tmp_digest[i]);\par
00223     \}\par
00224   \}\par
00225 \par
00226   {\cf19 return} 16;\par
00227 \}\par
00228 \par
00229 std::string hashToString({\cf17 const} PictureHash &digest, {\cf18 int} numChar)\par
00230 \{\par
00231   {\cf17 static} {\cf17 const} {\cf18 char}* hex = {\cf22 "0123456789abcdef"};\par
00232   std::string result;\par
00233 \par
00234   {\cf19 for}({\cf18 int} pos=0; pos<int(digest.hash.size()); pos++)\par
00235   \{\par
00236     {\cf19 if} ((pos % numChar) == 0 && pos!=0 )\par
00237     \{\par
00238       result += {\cf23 ','};\par
00239     \}\par
00240     result += hex[digest.hash[pos] >> 4];\par
00241     result += hex[digest.hash[pos] & 0xf];\par
00242   \}\par
00243 \par
00244   {\cf19 return} result;\par
00245 \}\par
00246 \par
00247 {\cf18 int} calcAndPrintHashStatus({\cf17 const} CPelUnitBuf& pic, {\cf17 const} SEIDecodedPictureHash* pictureHashSEI, {\cf17 const} BitDepths &bitDepths, {\cf17 const} MsgLevel msgl)\par
00248 \{\par
00249   {\cf20 /* calculate MD5sum for entire reconstructed picture */}\par
00250   PictureHash recon_digest;\par
00251   {\cf18 int} numChar=0;\par
00252   {\cf17 const} {\cf18 char}* hashType = {\cf22 "\\0"};\par
00253 \par
00254   {\cf19 if} (pictureHashSEI)\par
00255   \{\par
00256 {\cf21 #if FIX_TICKET_1405}\par
00257     CHECK ((uint32_t)pic.bufs.size() != ( pictureHashSEI->singleCompFlag ? 1 : 3 ), {\cf22 "The value of dph_sei_single_component_flag shall be equal to (ChromaFormatIdc == 0)."});\par
00258 {\cf21 #endif}\par
00259     {\cf19 switch} (pictureHashSEI->method)\par
00260     \{\par
00261       {\cf19 case} HASHTYPE_MD5:\par
00262         \{\par
00263           hashType = {\cf22 "MD5"};\par
00264           numChar = calcMD5(pic, recon_digest, bitDepths);\par
00265           {\cf19 break};\par
00266         \}\par
00267       {\cf19 case} HASHTYPE_CRC:\par
00268         \{\par
00269           hashType = {\cf22 "CRC"};\par
00270           numChar = calcCRC(pic, recon_digest, bitDepths);\par
00271           {\cf19 break};\par
00272         \}\par
00273       {\cf19 case} HASHTYPE_CHECKSUM:\par
00274         \{\par
00275           hashType = {\cf22 "Checksum"};\par
00276           numChar = calcChecksum(pic, recon_digest, bitDepths);\par
00277           {\cf19 break};\par
00278         \}\par
00279       {\cf19 default}:\par
00280         \{\par
00281           THROW({\cf22 "Unknown hash type"});\par
00282           {\cf19 break};\par
00283         \}\par
00284     \}\par
00285   \}\par
00286 \par
00287   {\cf20 /* compare digest against received version */}\par
00288   {\cf17 const} {\cf18 char}* ok = {\cf22 "(unk)"};\par
00289   {\cf18 bool} mismatch = {\cf17 false};\par
00290 \par
00291   {\cf19 if} (pictureHashSEI)\par
00292   \{\par
00293     ok = {\cf22 "(OK)"};\par
00294     {\cf19 if} (recon_digest != pictureHashSEI->m_pictureHash)\par
00295     \{\par
00296       ok = {\cf22 "(***ERROR***)"};\par
00297       mismatch = {\cf17 true};\par
00298     \}\par
00299   \}\par
00300 \par
00301   msg( msgl, {\cf22 "[%s:%s,%s] "}, hashType, hashToString(recon_digest, numChar).c_str(), ok);\par
00302 \par
00303   {\cf19 if} (mismatch)\par
00304   \{\par
00305     msg( msgl, {\cf22 "[rx%s:%s] "}, hashType, hashToString(pictureHashSEI->m_pictureHash, numChar).c_str());\par
00306   \}\par
00307   {\cf19 return} mismatch;\par
00308 \}\par
00309 \par
}
