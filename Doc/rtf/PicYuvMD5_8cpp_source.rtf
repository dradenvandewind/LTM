00045 {\cf17 template}<u{\cf18 int}32_t OUTPUT_BITDEPTH_DIV8>\par
00046 {\cf17 static} {\cf18 void} md5_block(MD5& md5, {\cf17 const} Pel* plane, uint32_t n)\par
00047 \{\par
00048   {\cf20 /* create a 64 byte buffer for packing Pel's into */}\par
00049   uint8_t buf[64/OUTPUT_BITDEPTH_DIV8][OUTPUT_BITDEPTH_DIV8];\par
00050   {\cf19 for} (uint32_t i = 0; i < n; i++)\par
00051   \{\par
00052     Pel pel = plane[i];\par
00053     {\cf20 /* perform bitdepth and endian conversion */}\par
00054     {\cf19 for} (uint32_t d = 0; d < OUTPUT_BITDEPTH_DIV8; d++)\par
00055     \{\par
00056       buf[i][d] = pel >> (d*8);\par
00057     \}\par
00058   \}\par
00059   md5.update((uint8_t*)buf, n * OUTPUT_BITDEPTH_DIV8);\par
00060 \}\par
00061 \par
00066 {\cf17 template}<u{\cf18 int}32_t OUTPUT_BITDEPTH_DIV8>\par
00067 {\cf17 static} {\cf18 void} md5_plane(MD5& md5, {\cf17 const} Pel* plane, uint32_t width, uint32_t height, uint32_t stride)\par
00068 \{\par
00069   {\cf20 /* N is the number of samples to process per md5 update.}\par
00070 {\cf20    * All N samples must fit in buf */}\par
00071   uint32_t N = 32;\par
00072   uint32_t width_modN = width % N;\par
00073   uint32_t width_less_modN = width - width_modN;\par
00074 \par
00075   {\cf19 for} (uint32_t y = 0; y < height; y++)\par
00076   \{\par
00077     {\cf20 /* convert pels into unsigned chars in little endian byte order.}\par
00078 {\cf20      * NB, for 8bit data, data is truncated to 8bits. */}\par
00079     {\cf19 for} (uint32_t x = 0; x < width_less_modN; x += N)\par
00080     \{\par
00081       md5_block<OUTPUT_BITDEPTH_DIV8>(md5, &plane[y*stride + x], N);\par
00082     \}\par
00083 \par
00084     {\cf20 /* mop up any of the remaining line */}\par
00085     md5_block<OUTPUT_BITDEPTH_DIV8>(md5, &plane[y*stride + width_less_modN], width_modN);\par
00086   \}\par
00087 \}\par
00088 \par
