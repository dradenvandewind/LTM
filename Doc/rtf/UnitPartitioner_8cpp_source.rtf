00271 {\cf18 void} QTBTPartitioner::splitCurrArea( {\cf17 const} PartSplit split, {\cf17 const} CodingStructure& cs )\par
00272 \{\par
00273   CHECKD( !canSplit( split, cs ), {\cf22 "Trying to apply a prohibited split!"} );\par
00274 \par
00275   {\cf18 bool} isImplicit = isSplitImplicit( split, cs );\par
00276   {\cf18 bool} canQtSplit = canSplit( CU_QUAD_SPLIT, cs );\par
00277   {\cf18 bool} qgEnable = currQgEnable();\par
00278   {\cf18 bool} qgChromaEnable = currQgChromaEnable();\par
00279 \par
00280   {\cf19 switch}( split )\par
00281   \{\par
00282   {\cf19 case} CU_QUAD_SPLIT:\par
00283     m_partStack.push_back( PartLevel( split, PartitionerImpl::getCUSubPartitions( currArea(), cs ) ) );\par
00284     m_partStack.back().modeType = modeType;\par
00285     {\cf19 break};\par
00286   {\cf19 case} CU_HORZ_SPLIT:\par
00287   {\cf19 case} CU_VERT_SPLIT:\par
00288     m_partStack.push_back( PartLevel( split, PartitionerImpl::getCUSubPartitions( currArea(), cs, split ) ) );\par
00289     m_partStack.back().modeType = modeType;\par
00290     {\cf19 break};\par
00291   {\cf19 case} CU_TRIH_SPLIT:\par
00292   {\cf19 case} CU_TRIV_SPLIT:\par
00293     m_partStack.push_back( PartLevel( split, PartitionerImpl::getCUSubPartitions( currArea(), cs, split ) ) );\par
00294     m_partStack.back().modeType = modeType;\par
00295     {\cf19 break};\par
00296   {\cf19 case} TU_MAX_TR_SPLIT:\par
00297     m_partStack.push_back( PartLevel( split, PartitionerImpl::getMaxTuTiling( currArea(), cs ) ) );\par
00298     {\cf19 break};\par
00299   {\cf19 case} SBT_VER_HALF_POS0_SPLIT:\par
00300   {\cf19 case} SBT_VER_HALF_POS1_SPLIT:\par
00301   {\cf19 case} SBT_HOR_HALF_POS0_SPLIT:\par
00302   {\cf19 case} SBT_HOR_HALF_POS1_SPLIT:\par
00303   {\cf19 case} SBT_VER_QUAD_POS0_SPLIT:\par
00304   {\cf19 case} SBT_VER_QUAD_POS1_SPLIT:\par
00305   {\cf19 case} SBT_HOR_QUAD_POS0_SPLIT:\par
00306   {\cf19 case} SBT_HOR_QUAD_POS1_SPLIT:\par
00307     m_partStack.push_back( PartLevel( split, PartitionerImpl::getSbtTuTiling( currArea(), cs, split ) ) );\par
00308     {\cf19 break};\par
00309   {\cf19 default}:\par
00310     THROW( {\cf22 "Unknown split mode"} );\par
00311     {\cf19 break};\par
00312   \}\par
00313 \par
00314   currDepth++;\par
00315   currSubdiv++;\par
00316 {\cf21 #if _DEBUG}\par
00317   m_currArea = m_partStack.back().parts.front();\par
00318 {\cf21 #endif}\par
00319 \par
00320   {\cf19 if}( split == TU_MAX_TR_SPLIT )\par
00321   \{\par
00322     currTrDepth++;\par
00323   \}\par
00324   {\cf19 else} {\cf19 if}( split >= SBT_VER_HALF_POS0_SPLIT && split <= SBT_HOR_QUAD_POS1_SPLIT )\par
00325   \{\par
00326     currTrDepth++;\par
00327   \}\par
00328   {\cf19 else}\par
00329   \{\par
00330     currTrDepth = 0;\par
00331   \}\par
00332 \par
00333   {\cf19 if}( split == CU_HORZ_SPLIT || split == CU_VERT_SPLIT || split == CU_TRIH_SPLIT || split == CU_TRIV_SPLIT )\par
00334   \{\par
00335     currBtDepth++;\par
00336     {\cf19 if}( isImplicit ) currImplicitBtDepth++;\par
00337     currMtDepth++;\par
00338 \par
00339     {\cf19 if}( split == CU_TRIH_SPLIT || split == CU_TRIV_SPLIT )\par
00340     \{\par
00341       {\cf20 // first and last part of triple split are equivalent to double bt split}\par
00342       currBtDepth++;\par
00343       currSubdiv++;\par
00344     \}\par
00345     m_partStack.back().canQtSplit = canQtSplit;\par
00346   \}\par
00347   {\cf19 else} {\cf19 if}( split == CU_QUAD_SPLIT )\par
00348   \{\par
00349     CHECK( currBtDepth > 0, {\cf22 "Cannot split a non-square area other than with a binary split"} );\par
00350     CHECK( currMtDepth > 0, {\cf22 "Cannot split a non-square area other than with a binary split"} );\par
00351     currMtDepth = 0;\par
00352     currBtDepth = 0;\par
00353     currQtDepth++;\par
00354     currSubdiv++;\par
00355   \}\par
00356   qgEnable       &= (currSubdiv <= cs.slice->getCuQpDeltaSubdiv());\par
00357   qgChromaEnable &= (currSubdiv <= cs.slice->getCuChromaQpOffsetSubdiv());\par
00358   m_partStack.back().qgEnable       = qgEnable;\par
00359   m_partStack.back().qgChromaEnable = qgChromaEnable;\par
00360   {\cf19 if} (qgEnable)\par
00361     currQgPos = currArea().lumaPos();\par
00362   {\cf19 if} (qgChromaEnable)\par
00363     currQgChromaPos = currArea().chromaPos();\par
00364 \}\par
00365 \par
00366 {\cf18 void} QTBTPartitioner::canSplit( {\cf17 const} CodingStructure &cs, {\cf18 bool}& canNo, {\cf18 bool}& canQt, {\cf18 bool}& canBh, {\cf18 bool}& canBv, {\cf18 bool}& canTh, {\cf18 bool}& canTv )\par
00367 \{\par
00368   {\cf17 const} PartSplit implicitSplit = m_partStack.back().checkdIfImplicit ? m_partStack.back().implicitSplit : getImplicitSplit( cs );\par
00369 \par
00370   {\cf17 const} {\cf18 unsigned} maxBTD         = cs.pcv->getMaxBtDepth( *cs.slice, chType ) + currImplicitBtDepth;\par
00371   {\cf17 const} {\cf18 unsigned} maxBtSize      = cs.pcv->getMaxBtSize ( *cs.slice, chType );\par
00372   {\cf17 const} {\cf18 unsigned} minBtSize      = cs.pcv->getMinBtSize ( *cs.slice, chType );\par
00373   {\cf17 const} {\cf18 unsigned} maxTtSize      = cs.pcv->getMaxTtSize ( *cs.slice, chType );\par
00374   {\cf17 const} {\cf18 unsigned} minTtSize      = cs.pcv->getMinTtSize ( *cs.slice, chType );\par
00375   {\cf17 const} {\cf18 unsigned} minQtSize      = cs.pcv->getMinQtSize ( *cs.slice, chType );\par
00376 \par
00377   canNo = canQt = canBh = canTh = canBv = canTv = {\cf17 true};\par
00378   {\cf18 bool} canBtt = currMtDepth < maxBTD;\par
00379 \par
00380   {\cf20 // the minimal and maximal sizes are given in luma samples}\par
00381   {\cf17 const} CompArea&  area  = currArea().Y();\par
00382   {\cf17 const} CompArea  *areaC = (chType == CHANNEL_TYPE_CHROMA) ? &(currArea().Cb()) : {\cf17 nullptr};\par
00383         PartLevel& level = m_partStack.back();\par
00384 \par
00385   {\cf17 const} PartSplit lastSplit = level.split;\par
00386   {\cf17 const} PartSplit parlSplit = lastSplit == CU_TRIH_SPLIT ? CU_HORZ_SPLIT : CU_VERT_SPLIT;\par
00387 \par
00388   {\cf20 // don't allow QT-splitting below a BT split}\par
00389   {\cf19 if}( lastSplit != CTU_LEVEL && lastSplit != CU_QUAD_SPLIT ) canQt = {\cf17 false};\par
00390   {\cf19 if}( area.width <= minQtSize )                              canQt = {\cf17 false};\par
00391 \par
00392   {\cf19 if}( areaC && areaC->width <= MIN_DUALTREE_CHROMA_WIDTH ) canQt = {\cf17 false};\par
00393   {\cf19 if}( treeType == TREE_C )\par
00394   \{\par
00395     canQt = canBh = canTh = canBv = canTv = {\cf17 false};\par
00396     {\cf19 return};\par
00397   \}\par
00398   {\cf19 if}( implicitSplit != CU_DONT_SPLIT )\par
00399   \{\par
00400     canNo = canTh = canTv = {\cf17 false};\par
00401 \par
00402     canBh = implicitSplit == CU_HORZ_SPLIT;\par
00403     canBv = implicitSplit == CU_VERT_SPLIT;\par
00404     {\cf19 if} (areaC && areaC->width == 4) canBv = {\cf17 false};\par
00405     {\cf19 if}( !canBh && !canBv && !canQt ) canQt = {\cf17 true};\par
00406     {\cf19 return};\par
00407   \}\par
00408 \par
00409   {\cf19 if}( ( lastSplit == CU_TRIH_SPLIT || lastSplit == CU_TRIV_SPLIT ) && currPartIdx() == 1 )\par
00410   \{\par
00411     canBh = parlSplit != CU_HORZ_SPLIT;\par
00412     canBv = parlSplit != CU_VERT_SPLIT;\par
00413   \}\par
00414 \par
00415   {\cf19 if}( canBtt && ( area.width <= minBtSize && area.height <= minBtSize )\par
00416       && ( ( area.width <= minTtSize && area.height <= minTtSize ) ) )\par
00417   \{\par
00418     canBtt = {\cf17 false};\par
00419   \}\par
00420   {\cf19 if}( canBtt && ( area.width > maxBtSize || area.height > maxBtSize )\par
00421       && ( ( area.width > maxTtSize || area.height > maxTtSize ) ) )\par
00422   \{\par
00423     canBtt = {\cf17 false};\par
00424   \}\par
00425 \par
00426   {\cf19 if}( !canBtt )\par
00427   \{\par
00428     canBh = canTh = canBv = canTv = {\cf17 false};\par
00429 \par
00430     {\cf19 return};\par
00431   \}\par
00432 \par
00433   {\cf19 if}( area.width > maxBtSize || area.height > maxBtSize )\par
00434   \{\par
00435     canBh = canBv = {\cf17 false};\par
00436   \}\par
00437 \par
00438   {\cf20 // specific check for BT splits}\par
00439   {\cf19 if}( area.height <= minBtSize )                            canBh = {\cf17 false};\par
00440   {\cf19 if}( area.width > MAX_TB_SIZEY && area.height <= MAX_TB_SIZEY ) canBh = {\cf17 false};\par
00441   {\cf19 if}( areaC && areaC->width * areaC->height <= MIN_DUALTREE_CHROMA_SIZE )     canBh = {\cf17 false};\par
00442   {\cf19 if}( area.width <= minBtSize )                              canBv = {\cf17 false};\par
00443   {\cf19 if}( area.width <= MAX_TB_SIZEY && area.height > MAX_TB_SIZEY ) canBv = {\cf17 false};\par
00444   {\cf19 if} (areaC && (areaC->width * areaC->height <= MIN_DUALTREE_CHROMA_SIZE || areaC->width == 4))     canBv = {\cf17 false};\par
00445   {\cf19 if}( modeType == MODE_TYPE_INTER && area.width * area.height == 32 )  canBv = canBh = {\cf17 false};\par
00446   {\cf19 if}( area.height <= 2 * minTtSize || area.height > maxTtSize || area.width > maxTtSize )\par
00447                                                                                        canTh = {\cf17 false};\par
00448   {\cf19 if}( area.width > MAX_TB_SIZEY || area.height > MAX_TB_SIZEY )  canTh = {\cf17 false};\par
00449   {\cf19 if}( areaC && areaC->width * areaC->height <= MIN_DUALTREE_CHROMA_SIZE*2 )     canTh = {\cf17 false};\par
00450   {\cf19 if}( area.width <= 2 * minTtSize || area.width > maxTtSize || area.height > maxTtSize )\par
00451                                                                                        canTv = {\cf17 false};\par
00452   {\cf19 if}( area.width > MAX_TB_SIZEY || area.height > MAX_TB_SIZEY )  canTv = {\cf17 false};\par
00453   {\cf19 if} (areaC && (areaC->width * areaC->height <= MIN_DUALTREE_CHROMA_SIZE * 2 || areaC->width == 8))     canTv = {\cf17 false};\par
00454   {\cf19 if}( modeType == MODE_TYPE_INTER && area.width * area.height == 64 )  canTv = canTh = {\cf17 false};\par
00455 \par
00456 \}\par
00457 \par
00458 {\cf18 bool} QTBTPartitioner::canSplit( {\cf17 const} PartSplit split, {\cf17 const} CodingStructure &cs )\par
00459 \{\par
00460   {\cf17 const} CompArea area       = currArea().Y();\par
00461   {\cf17 const} {\cf18 unsigned} maxTrSize  = cs.sps->getMaxTbSize();\par
00462 \par
00463   {\cf18 bool} canNo, canQt, canBh, canTh, canBv, canTv;\par
00464 \par
00465   canSplit( cs, canNo, canQt, canBh, canBv, canTh, canTv );\par
00466   {\cf19 switch}( split )\par
00467   \{\par
00468   {\cf19 case} CTU_LEVEL:\par
00469     THROW( {\cf22 "Checking if top level split is possible"} );\par
00470     {\cf19 return} {\cf17 true};\par
00471     {\cf19 break};\par
00472   {\cf19 case} TU_MAX_TR_SPLIT:\par
00473     {\cf19 return} area.width > maxTrSize || area.height > maxTrSize;\par
00474     {\cf19 break};\par
00475   {\cf19 case} SBT_VER_HALF_POS0_SPLIT:\par
00476   {\cf19 case} SBT_VER_HALF_POS1_SPLIT:\par
00477   {\cf19 case} SBT_HOR_HALF_POS0_SPLIT:\par
00478   {\cf19 case} SBT_HOR_HALF_POS1_SPLIT:\par
00479   {\cf19 case} SBT_VER_QUAD_POS0_SPLIT:\par
00480   {\cf19 case} SBT_VER_QUAD_POS1_SPLIT:\par
00481   {\cf19 case} SBT_HOR_QUAD_POS0_SPLIT:\par
00482   {\cf19 case} SBT_HOR_QUAD_POS1_SPLIT:\par
00483     {\cf19 return} currTrDepth == 0;\par
00484     {\cf19 break};\par
00485   {\cf19 case} CU_QUAD_SPLIT:\par
00486     {\cf19 return} canQt;\par
00487   {\cf19 case} CU_DONT_SPLIT:\par
00488     {\cf19 return} canNo;\par
00489   {\cf19 case} CU_HORZ_SPLIT:\par
00490     {\cf19 return} canBh;\par
00491   {\cf19 case} CU_VERT_SPLIT:\par
00492     {\cf19 return} canBv;\par
00493   {\cf19 case} CU_TRIH_SPLIT:\par
00494     {\cf19 return} canTh;\par
00495   {\cf19 case} CU_TRIV_SPLIT:\par
00496     {\cf19 return} canTv;\par
00497   {\cf19 case} CU_MT_SPLIT:\par
00498     {\cf19 return} ( canBh || canTh || canBv || canTv );\par
00499   {\cf19 case} CU_BT_SPLIT:\par
00500     {\cf19 return} ( canBh || canBv );\par
00501   {\cf19 break};\par
00502   {\cf19 default}:\par
00503     THROW( {\cf22 "Unknown split mode"} );\par
00504     {\cf19 return} {\cf17 false};\par
00505     {\cf19 break};\par
00506   \}\par
00507 \par
00508   {\cf19 return} {\cf17 true};\par
00509 \}\par
00510 \par
00511 {\cf18 bool} QTBTPartitioner::isSplitImplicit( {\cf17 const} PartSplit split, {\cf17 const} CodingStructure &cs )\par
00512 \{\par
00513   {\cf19 return} split == getImplicitSplit( cs );\par
00514 \}\par
00515 \par
00516 PartSplit QTBTPartitioner::getImplicitSplit( {\cf17 const} CodingStructure &cs )\par
00517 \{\par
00518   {\cf19 if}( m_partStack.back().checkdIfImplicit )\par
00519   \{\par
00520     {\cf19 return} m_partStack.back().implicitSplit;\par
00521   \}\par
00522 \par
00523   PartSplit split = CU_DONT_SPLIT;\par
00524 \par
00525   {\cf19 if}( split == CU_DONT_SPLIT )\par
00526   \{\par
00527     {\cf17 const} {\cf18 bool} isBlInPic = cs.picture->Y().contains( currArea().Y().bottomLeft() );\par
00528     {\cf17 const} {\cf18 bool} isTrInPic = cs.picture->Y().contains( currArea().Y().topRight() );\par
00529 \par
00530     {\cf17 const} CompArea& area      = currArea().Y();\par
00531     {\cf17 const} {\cf18 unsigned} maxBtSize  = cs.pcv->getMaxBtSize( *cs.slice, chType );\par
00532     {\cf17 const} {\cf18 bool} isBtAllowed    = area.width <= maxBtSize && area.height <= maxBtSize && currMtDepth < (cs.pcv->getMaxBtDepth(*cs.slice, chType) + currImplicitBtDepth);\par
00533     {\cf17 const} {\cf18 unsigned} minQtSize  = cs.pcv->getMinQtSize( *cs.slice, chType );\par
00534     {\cf17 const} {\cf18 bool} isQtAllowed    = area.width >  minQtSize && area.height >  minQtSize && currBtDepth == 0;\par
00535 \par
00536     {\cf19 if}( !isBlInPic && !isTrInPic && isQtAllowed )\par
00537     \{\par
00538       split = CU_QUAD_SPLIT;\par
00539     \}\par
00540     {\cf19 else} {\cf19 if}( !isBlInPic && isBtAllowed && area.width <= MAX_TB_SIZEY )\par
00541     \{\par
00542       split = CU_HORZ_SPLIT;\par
00543     \}\par
00544     {\cf19 else} {\cf19 if}( !isTrInPic && isBtAllowed && area.height <= MAX_TB_SIZEY )\par
00545     \{\par
00546       split = CU_VERT_SPLIT;\par
00547     \}\par
00548     {\cf19 else} {\cf19 if}( !isBlInPic || !isTrInPic )\par
00549     \{\par
00550       split = CU_QUAD_SPLIT;\par
00551     \}\par
00552     {\cf19 if} (CS::isDualITree(cs) && (currArea().Y().width > 64 || currArea().Y().height > 64))\par
00553     \{\par
00554       split = CU_QUAD_SPLIT;\par
00555     \}\par
00556     {\cf19 if}( (!isBlInPic || !isTrInPic) && split == CU_DONT_SPLIT )\par
00557     \{\par
00558       split = CU_QUAD_SPLIT;\par
00559     \}\par
00560   \}\par
00561 \par
00562   m_partStack.back().checkdIfImplicit = {\cf17 true};\par
00563   m_partStack.back().isImplicit = split != CU_DONT_SPLIT;\par
00564   m_partStack.back().implicitSplit = split;\par
00565 \par
00566   {\cf19 return} split;\par
00567 \}\par
00568 \par
00569 {\cf18 void} QTBTPartitioner::exitCurrSplit()\par
00570 \{\par
00571   PartSplit currSplit = m_partStack.back().split;\par
00572   {\cf18 unsigned}  currIdx = m_partStack.back().idx;\par
00573 \par
00574   m_partStack.pop_back();\par
00575 \par
00576   CHECK( currDepth == 0, {\cf22 "depth is '0', although a split was performed"} );\par
00577   currDepth--;\par
00578   currSubdiv--;\par
00579   {\cf19 if}( currQgEnable() )\par
00580     currQgPos = currArea().lumaPos();\par
00581   {\cf19 if}( currArea().chromaFormat != CHROMA_400 && currQgChromaEnable() )\par
00582     currQgChromaPos = currArea().chromaPos();\par
00583 {\cf21 #if _DEBUG}\par
00584   m_currArea = m_partStack.back().parts[m_partStack.back().idx];\par
00585 {\cf21 #endif}\par
00586 \par
00587   {\cf19 if}( currSplit == CU_HORZ_SPLIT || currSplit == CU_VERT_SPLIT || currSplit == CU_TRIH_SPLIT || currSplit == CU_TRIV_SPLIT )\par
00588   \{\par
00589     CHECK( !m_partStack.back().checkdIfImplicit, {\cf22 "Didn't check if the current split is implicit"} );\par
00590     CHECK( currBtDepth == 0, {\cf22 "BT depth is '0', athough a BT split was performed"} );\par
00591     CHECK( currMtDepth == 0, {\cf22 "MT depth is '0', athough a BT split was performed"} );\par
00592     currMtDepth--;\par
00593     {\cf19 if}( m_partStack.back().isImplicit ) currImplicitBtDepth--;\par
00594     currBtDepth--;\par
00595     {\cf19 if}( ( currSplit == CU_TRIH_SPLIT || currSplit == CU_TRIV_SPLIT ) && currIdx != 1 )\par
00596     \{\par
00597       CHECK( currBtDepth == 0, {\cf22 "BT depth is '0', athough a TT split was performed"} );\par
00598       currBtDepth--;\par
00599       currSubdiv--;\par
00600     \}\par
00601   \}\par
00602   {\cf19 else} {\cf19 if}( currSplit == TU_MAX_TR_SPLIT )\par
00603   \{\par
00604     CHECK( currTrDepth == 0, {\cf22 "TR depth is '0', although a TU split was performed"} );\par
00605     currTrDepth--;\par
00606   \}\par
00607   {\cf19 else} {\cf19 if}( currSplit >= SBT_VER_HALF_POS0_SPLIT && currSplit <= SBT_HOR_QUAD_POS1_SPLIT )\par
00608   \{\par
00609     CHECK( currTrDepth == 0, {\cf22 "TR depth is '0', although a TU split was performed"} );\par
00610     currTrDepth--;\par
00611   \}\par
00612   {\cf19 else}\par
00613   \{\par
00614     CHECK( currTrDepth > 0, {\cf22 "RQT found with QTBT partitioner"} );\par
00615 \par
00616     CHECK( currQtDepth == 0, {\cf22 "QT depth is '0', although a QT split was performed"} );\par
00617     currQtDepth--;\par
00618     currSubdiv--;\par
00619   \}\par
00620 \}\par
00621 \par
00622 {\cf18 bool} QTBTPartitioner::nextPart( {\cf17 const} CodingStructure &cs, {\cf18 bool} autoPop {\cf20 /*= false*/} )\par
00623 \{\par
00624   {\cf17 const} Position &prevPos = currArea().blocks[chType].pos();\par
00625 \par
00626   {\cf18 unsigned} currIdx = ++m_partStack.back().idx;\par
00627 \par
00628   m_partStack.back().checkdIfImplicit = {\cf17 false};\par
00629   m_partStack.back().isImplicit = {\cf17 false};\par
00630 \par
00631   {\cf19 if}( currIdx == 1 )\par
00632   \{\par
00633     {\cf17 const} CodingUnit* prevCU = cs.getCU( prevPos, chType );\par
00634     m_partStack.back().firstSubPartSplit = prevCU ? CU::getSplitAtDepth( *prevCU, currDepth ) : CU_DONT_SPLIT;\par
00635   \}\par
00636 \par
00637   {\cf19 if}( currIdx < m_partStack.back().parts.size() )\par
00638   \{\par
00639     {\cf19 if}( m_partStack.back().split == CU_TRIH_SPLIT || m_partStack.back().split == CU_TRIV_SPLIT )\par
00640     \{\par
00641       {\cf20 // adapt the current bt depth}\par
00642       {\cf19 if}( currIdx == 1 ) currBtDepth--;\par
00643       {\cf19 else}               currBtDepth++;\par
00644       {\cf19 if}( currIdx == 1 ) currSubdiv--;\par
00645       {\cf19 else}               currSubdiv++;\par
00646     \}\par
00647   {\cf19 if}( currQgEnable() )\par
00648     currQgPos = currArea().lumaPos();\par
00649   {\cf19 if}( currQgChromaEnable() )\par
00650     currQgChromaPos = currArea().chromaPos();\par
00651 {\cf21 #if _DEBUG}\par
00652     m_currArea = m_partStack.back().parts[currIdx];\par
00653 {\cf21 #endif}\par
00654     {\cf19 return} {\cf17 true};\par
00655   \}\par
00656   {\cf19 else}\par
00657   \{\par
00658     {\cf19 if}( autoPop ) exitCurrSplit();\par
00659     {\cf19 return} {\cf17 false};\par
00660   \}\par
00661 \}\par
00662 \par
00663 {\cf18 bool} QTBTPartitioner::hasNextPart()\par
00664 \{\par
00665   {\cf19 return} ( ( m_partStack.back().idx + 1 ) < m_partStack.back().parts.size() );\par
00666 \}\par
00667 \par
00668 {\cf18 void} TUIntraSubPartitioner::splitCurrArea( {\cf17 const} PartSplit split, {\cf17 const} CodingStructure& cs )\par
00669 \{\par
00670   {\cf19 switch}( split )\par
00671   \{\par
00672     {\cf19 case} TU_1D_HORZ_SPLIT:\par
00673     {\cf19 case} TU_1D_VERT_SPLIT:\par
00674     \{\par
00675       {\cf17 const} UnitArea &area = currArea();\par
00676       m_partStack.push_back( PartLevel() );\par
00677       m_partStack.back().split = split;\par
00678       PartitionerImpl::getTUIntraSubPartitions( m_partStack.back().parts, area, cs, split );\par
00679       {\cf19 break};\par
00680     \}\par
00681     {\cf19 case} TU_MAX_TR_SPLIT: {\cf20 //we need this non ISP split because of the maxTrSize limitation}\par
00682       m_partStack.push_back( PartLevel( split, PartitionerImpl::getMaxTuTiling( currArea(), cs ) ) );\par
00683       {\cf19 break};\par
00684     {\cf19 default}:\par
00685       THROW( {\cf22 "Unknown ISP split mode"} );\par
00686       {\cf19 break};\par
00687   \}\par
00688 \par
00689   currDepth++;\par
00690   currTrDepth++; {\cf20 // we need this to identify the level. since the 1d partitions are forbidden if the RQT is on, there area no compatibility issues}\par
00691 \par
00692 {\cf21 #if _DEBUG}\par
00693   m_currArea = m_partStack.back().parts.front();\par
00694 {\cf21 #endif}\par
00695 \}\par
00696 \par
00697 {\cf18 void} TUIntraSubPartitioner::exitCurrSplit()\par
00698 \{\par
00699   PartSplit currSplit = m_partStack.back().split;\par
00700 \par
00701   m_partStack.pop_back();\par
00702 \par
00703   CHECK( currDepth == 0, {\cf22 "depth is '0', although a split was performed"} );\par
00704 \par
00705   currDepth--;\par
00706   currTrDepth--;\par
00707 \par
00708 {\cf21 #if _DEBUG}\par
00709   m_currArea = m_partStack.back().parts[m_partStack.back().idx];\par
00710 {\cf21 #endif}\par
00711 \par
00712   CHECK( !( currSplit == TU_1D_HORZ_SPLIT || currSplit == TU_1D_VERT_SPLIT || currSplit == TU_MAX_TR_SPLIT ), {\cf22 "Unknown 1D partition split type!"} );\par
00713 \}\par
00714 \par
00715 {\cf18 bool} TUIntraSubPartitioner::nextPart( {\cf17 const} CodingStructure &cs, {\cf18 bool} autoPop {\cf20 /*= false*/} )\par
00716 \{\par
00717   {\cf18 unsigned} currIdx = ++m_partStack.back().idx;\par
00718 \par
00719   m_partStack.back().checkdIfImplicit = {\cf17 false};\par
00720   m_partStack.back().isImplicit = {\cf17 false};\par
00721 \par
00722   {\cf19 if}( currIdx < m_partStack.back().parts.size() )\par
