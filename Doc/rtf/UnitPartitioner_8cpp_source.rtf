00171 {\cf18 void} AdaptiveDepthPartitioner::setMaxMinDepth( {\cf18 unsigned}& minDepth, {\cf18 unsigned}& maxDepth, {\cf17 const} CodingStructure& cs ){\cf17  const}\par
00172 {\cf17 }\{\par
00173   {\cf18 unsigned}          stdMinDepth = 0;\par
00174   {\cf18 unsigned}          stdMaxDepth = ( floorLog2(cs.sps->getCTUSize()) - floorLog2(cs.sps->getMinQTSize( cs.slice->getSliceType(), chType )));\par
00175   {\cf17 const} Position    pos         = currArea().blocks[chType].pos();\par
00176   {\cf17 const} {\cf18 unsigned}    curSliceIdx = cs.slice->getIndependentSliceIdx();\par
00177   {\cf17 const} {\cf18 unsigned}    curTileIdx  = cs.pps->getTileIdx( currArea().lumaPos() );\par
00178 \par
00179   {\cf17 const} CodingUnit* cuLeft        = cs.getCURestricted( pos.offset( -1,                               0 ), pos, curSliceIdx, curTileIdx, chType );\par
00180   {\cf17 const} CodingUnit* cuBelowLeft   = cs.getCURestricted( pos.offset( -1, currArea().blocks[chType].height), pos, curSliceIdx, curTileIdx, chType );\par
00181   {\cf17 const} CodingUnit* cuAbove       = cs.getCURestricted( pos.offset(  0,                              -1 ), pos, curSliceIdx, curTileIdx, chType );\par
00182   {\cf17 const} CodingUnit* cuAboveRight  = cs.getCURestricted( pos.offset( currArea().blocks[chType].width, -1 ), pos, curSliceIdx, curTileIdx, chType );\par
00183 \par
00184   minDepth = stdMaxDepth;\par
00185   maxDepth = stdMinDepth;\par
00186 \par
00187   {\cf19 if}( cuLeft )\par
00188   \{\par
00189     minDepth = std::min<unsigned>( minDepth, cuLeft->qtDepth );\par
00190     maxDepth = std::max<unsigned>( maxDepth, cuLeft->qtDepth );\par
00191   \}\par
00192   {\cf19 else}\par
00193   \{\par
00194     minDepth = stdMinDepth;\par
00195     maxDepth = stdMaxDepth;\par
00196   \}\par
00197 \par
00198   {\cf19 if}( cuBelowLeft )\par
00199   \{\par
00200     minDepth = std::min<unsigned>( minDepth, cuBelowLeft->qtDepth );\par
00201     maxDepth = std::max<unsigned>( maxDepth, cuBelowLeft->qtDepth );\par
00202   \}\par
00203   {\cf19 else}\par
00204   \{\par
00205     minDepth = stdMinDepth;\par
00206     maxDepth = stdMaxDepth;\par
00207   \}\par
00208 \par
00209   {\cf19 if}( cuAbove )\par
00210   \{\par
00211     minDepth = std::min<unsigned>( minDepth, cuAbove->qtDepth );\par
00212     maxDepth = std::max<unsigned>( maxDepth, cuAbove->qtDepth );\par
00213   \}\par
00214   {\cf19 else}\par
00215   \{\par
00216     minDepth = stdMinDepth;\par
00217     maxDepth = stdMaxDepth;\par
00218   \}\par
00219 \par
00220   {\cf19 if}( cuAboveRight )\par
00221   \{\par
00222     minDepth = std::min<unsigned>( minDepth, cuAboveRight->qtDepth );\par
00223     maxDepth = std::max<unsigned>( maxDepth, cuAboveRight->qtDepth );\par
00224   \}\par
00225   {\cf19 else}\par
00226   \{\par
00227     minDepth = stdMinDepth;\par
00228     maxDepth = stdMaxDepth;\par
00229   \}\par
00230 \par
00231   minDepth = ( minDepth >= 1 ? minDepth - 1 : 0 );\par
00232   maxDepth = std::min<unsigned>( stdMaxDepth, maxDepth + 1 );\par
00233 \}\par
