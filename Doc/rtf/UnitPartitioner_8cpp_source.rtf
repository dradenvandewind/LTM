00096 SplitSeries Partitioner::getSplitSeries(){\cf17  const}\par
00097 {\cf17 }\{\par
00098   SplitSeries splitSeries = 0;\par
00099   SplitSeries depth = 0;\par
00100 \par
00101   {\cf19 for}( {\cf17 const} {\cf17 auto} &level : m_partStack )\par
00102   \{\par
00103     {\cf19 if}( level.split == CTU_LEVEL ) {\cf19 continue};\par
00104     {\cf19 else} splitSeries += {\cf17 static_cast<} SplitSeries {\cf17 >}( level.split ) << ( depth * SPLIT_DMULT );\par
00105 \par
00106     depth++;\par
00107   \}\par
00108 \par
00109   {\cf19 return} splitSeries;\par
00110 \}\par
00111 \par
00112 ModeTypeSeries Partitioner::getModeTypeSeries(){\cf17  const}\par
00113 {\cf17 }\{\par
00114   ModeTypeSeries modeTypeSeries = 0;\par
00115   {\cf18 int} depth = 0;\par
00116 \par
00117   {\cf19 for}( {\cf17 const} {\cf17 auto} &level : m_partStack )\par
00118   \{\par
00119     {\cf19 if}( level.split == CTU_LEVEL ) {\cf19 continue};\par
00120     {\cf19 else} modeTypeSeries += {\cf17 static_cast<}{\cf18 int}{\cf17 >}(level.modeType) << (depth * 3);\par
00121 \par
00122     depth++;\par
00123   \}\par
00124 \par
00125   {\cf19 return} modeTypeSeries;\par
00126 \}\par
