00260   currQgPos   = ctuArea.lumaPos();\par
00261   currQgChromaPos = ctuArea.chromaFormat != CHROMA_400 ? ctuArea.chromaPos() : Position();\par
00262   currImplicitBtDepth = 0;\par
00263   chType      = _chType;\par
00264 \par
00265   m_partStack.clear();\par
00266   m_partStack.push_back( PartLevel( CTU_LEVEL, Partitioning\{ ctuArea \} ) );\par
