00770 \par
00771 Partitioning PartitionerImpl::getCUSubPartitions( {\cf17 const} UnitArea &cuArea, {\cf17 const} CodingStructure &cs, {\cf17 const} PartSplit _splitType {\cf20 /*= CU_QUAD_SPLIT*/} )\par
00772 \{\par
00773   {\cf17 const} PartSplit splitType = _splitType;\par
00774 \par
00775   {\cf19 if}( splitType == CU_QUAD_SPLIT )\par
00776   \{\par
00777     {\cf19 if}( !cs.pcv->noChroma2x2 )\par
00778     \{\par
00779       Partitioning sub;\par
00780 \par
00781       sub.resize( 4, cuArea );\par
00782 \par
00783       {\cf19 for}( uint32_t i = 0; i < 4; i++ )\par
00784       \{\par
00785         {\cf19 for}( {\cf17 auto} &blk : sub[i].blocks )\par
00786         \{\par
00787           blk.height >>= 1;\par
00788           blk.width  >>= 1;\par
00789           {\cf19 if}( i >= 2 ) blk.y += blk.height;\par
00790           {\cf19 if}( i &  1 ) blk.x += blk.width;\par
00791         \}\par
00792 \par
00793         CHECK( sub[i].lumaSize().height < MIN_TB_SIZEY, {\cf22 "the split causes the block to be smaller than the minimal TU size"} );\par
00794       \}\par
00795 \par
00796       {\cf19 return} sub;\par
00797     \}\par
00798     {\cf19 else}\par
00799     \{\par
00800       {\cf17 const} uint32_t minCUSize = 1 << cs.sps->getLog2MinCodingBlockSize();\par
00801 \par
00802       {\cf18 bool} canSplit = cuArea.lumaSize().width > minCUSize && cuArea.lumaSize().height > minCUSize;\par
00803 \par
00804       Partitioning ret;\par
00805 \par
00806 \par
00807       {\cf19 if}( canSplit )\par
00808       \{\par
00809         ret.resize( 4 );\par
00810 \par
00811         {\cf19 if}( cuArea.chromaFormat == CHROMA_400 )\par
00812         \{\par
00813           CompArea  blkY = cuArea.Y();\par
00814           blkY.width >>= 1;\par
00815           blkY.height >>= 1;\par
00816           ret[0]  = UnitArea( cuArea.chromaFormat, blkY );\par
00817           blkY.x += blkY.width;\par
00818           ret[1]  = UnitArea( cuArea.chromaFormat, blkY );\par
00819           blkY.x -= blkY.width;\par
00820           blkY.y += blkY.height;\par
00821           ret[2]  = UnitArea( cuArea.chromaFormat, blkY );\par
00822           blkY.x += blkY.width;\par
00823           ret[3]  = UnitArea( cuArea.chromaFormat, blkY );\par
00824         \}\par
00825         {\cf19 else}\par
00826         \{\par
00827           {\cf19 for}( uint32_t i = 0; i < 4; i++ )\par
00828           \{\par
00829             ret[i] = cuArea;\par
00830 \par
00831             CompArea &blkY  = ret[i].Y();\par
00832             CompArea &blkCb = ret[i].Cb();\par
00833             CompArea &blkCr = ret[i].Cr();\par
00834 \par
00835             blkY.width  /= 2;\par
00836             blkY.height /= 2;\par
00837 \par
00838             {\cf20 // TODO: get those params from SPS}\par
00839             {\cf19 if}( blkCb.width > 4 )\par
00840             \{\par
00841               blkCb.width  /= 2;\par
00842               blkCb.height /= 2;\par
00843               blkCr.width  /= 2;\par
00844               blkCr.height /= 2;\par
00845             \}\par
00846             {\cf19 else} {\cf19 if}( i > 0 )\par
00847             \{\par
00848               blkCb = CompArea();\par
00849               blkCr = CompArea();\par
00850             \}\par
00851 \par
00852             {\cf19 if}( ( i & 1 ) == 1 )\par
00853             \{\par
00854               blkY.x  += blkY .width;\par
00855               blkCb.x += blkCb.width;\par
00856               blkCr.x += blkCr.width;\par
00857             \}\par
00858 \par
00859             {\cf19 if}( i > 1 )\par
00860             \{\par
00861               blkY.y  += blkY .height;\par
00862               blkCb.y += blkCb.height;\par
00863               blkCr.y += blkCr.height;\par
00864             \}\par
00865           \}\par
00866         \}\par
00867       \}\par
00868 \par
00869       {\cf19 return} ret;\par
00870     \}\par
00871   \}\par
00872   {\cf19 else} {\cf19 if}( splitType == CU_HORZ_SPLIT )\par
00873   \{\par
00874     Partitioning sub;\par
00875 \par
00876     sub.resize(2, cuArea);\par
00877 \par
00878     {\cf19 for} (uint32_t i = 0; i < 2; i++)\par
00879     \{\par
00880       {\cf19 for} ({\cf17 auto} &blk : sub[i].blocks)\par
00881       \{\par
00882         blk.height >>= 1;\par
00883         {\cf19 if} (i == 1) blk.y += blk.height;\par
00884       \}\par
00885 \par
00886       CHECK(sub[i].lumaSize().height < MIN_TB_SIZEY, {\cf22 "the cs split causes the block to be smaller than the minimal TU size"});\par
00887     \}\par
00888 \par
00889     {\cf19 return} sub;\par
00890   \}\par
00891   {\cf19 else} {\cf19 if}( splitType == CU_VERT_SPLIT )\par
00892   \{\par
00893     Partitioning sub;\par
00894 \par
00895     sub.resize( 2, cuArea );\par
00896 \par
00897     {\cf19 for}( uint32_t i = 0; i < 2; i++ )\par
00898     \{\par
00899       {\cf19 for}( {\cf17 auto} &blk : sub[i].blocks )\par
00900       \{\par
00901         blk.width >>= 1;\par
00902         {\cf19 if}( i == 1 ) blk.x += blk.width;\par
00903       \}\par
00904 \par
00905       CHECK( sub[i].lumaSize().width < MIN_TB_SIZEY, {\cf22 "the split causes the block to be smaller than the minimal TU size"} );\par
00906     \}\par
00907 \par
00908     {\cf19 return} sub;\par
00909   \}\par
00910   {\cf19 else} {\cf19 if}( splitType == CU_TRIH_SPLIT )\par
00911   \{\par
00912     Partitioning sub;\par
00913 \par
00914     sub.resize( 3, cuArea );\par
00915 \par
00916     {\cf19 for}( {\cf18 int} i = 0; i < 3; i++ )\par
00917     \{\par
00918       {\cf19 for}( {\cf17 auto} &blk : sub[i].blocks )\par
00919       \{\par
00920         blk.height >>= 1;\par
00921         {\cf19 if}( ( i + 1 ) & 1 ) blk.height >>= 1;\par
00922         {\cf19 if}( i == 1 )        blk.y       +=     blk.height / 2;\par
00923         {\cf19 if}( i == 2 )        blk.y       += 3 * blk.height;\par
00924       \}\par
00925 \par
00926       CHECK( sub[i].lumaSize().height < MIN_TB_SIZEY, {\cf22 "the cs split causes the block to be smaller than the minimal TU size"} );\par
00927     \}\par
00928 \par
00929     {\cf19 return} sub;\par
00930   \}\par
00931   {\cf19 else} {\cf19 if}( splitType == CU_TRIV_SPLIT )\par
00932   \{\par
00933     Partitioning sub;\par
00934 \par
00935     sub.resize( 3, cuArea );\par
00936 \par
00937     {\cf19 for}( {\cf18 int} i = 0; i < 3; i++ )\par
00938     \{\par
00939       {\cf19 for}( {\cf17 auto} &blk : sub[i].blocks )\par
00940       \{\par
00941         blk.width >>= 1;\par
00942 \par
00943         {\cf19 if}( ( i + 1 ) & 1 ) blk.width >>= 1;\par
00944         {\cf19 if}( i == 1 )        blk.x      +=     blk.width / 2;\par
00945         {\cf19 if}( i == 2 )        blk.x      += 3 * blk.width;\par
00946       \}\par
00947 \par
00948       CHECK( sub[i].lumaSize().width < MIN_TB_SIZEY, {\cf22 "the cs split causes the block to be smaller than the minimal TU size"} );\par
00949     \}\par
00950 \par
00951     {\cf19 return} sub;\par
00952   \}\par
00953   {\cf19 else}\par
00954   \{\par
00955     THROW( {\cf22 "Unknown CU sub-partitioning"} );\par
00956     {\cf19 return} Partitioning();\par
00957   \}\par
00958 \}\par
00959 \par
00960 {\cf18 void} PartitionerImpl::getTUIntraSubPartitions( Partitioning &sub, {\cf17 const} UnitArea &tuArea, {\cf17 const} CodingStructure &cs, {\cf17 const} PartSplit splitType )\par
00961 \{\par
00962   uint32_t nPartitions;\par
00963   uint32_t splitDimensionSize = CU::getISPSplitDim( tuArea.lumaSize().width, tuArea.lumaSize().height, splitType );\par
00964 \par
00965   {\cf18 bool} isDualTree = CS::isDualITree( cs ) || cs.treeType != TREE_D;\par
00966 \par
00967   {\cf19 if}( splitType == TU_1D_HORZ_SPLIT )\par
00968   \{\par
00969     nPartitions = tuArea.lumaSize().height >> floorLog2(splitDimensionSize);\par
00970 \par
00971     sub.resize( nPartitions );\par
00972 \par
00973     {\cf19 for}( uint32_t i = 0; i < nPartitions; i++ )\par
00974     \{\par
00975       sub[i] = tuArea;\par
00976       CompArea& blkY = sub[i].blocks[COMPONENT_Y];\par
00977 \par
00978       blkY.height = splitDimensionSize;\par
00979       blkY.y = i > 0 ? sub[i - 1].blocks[COMPONENT_Y].y + splitDimensionSize : blkY.y;\par
00980 \par
00981       CHECK( sub[i].lumaSize().height < 1, {\cf22 "the cs split causes the block to be smaller than the minimal TU size"} );\par
00982     \}\par
00983   \}\par
00984   {\cf19 else} {\cf19 if}( splitType == TU_1D_VERT_SPLIT )\par
00985   \{\par
00986     nPartitions = tuArea.lumaSize().width >> floorLog2(splitDimensionSize);\par
00987 \par
00988     sub.resize( nPartitions );\par
00989 \par
00990     {\cf19 for}( uint32_t i = 0; i < nPartitions; i++ )\par
00991     \{\par
00992       sub[i] = tuArea;\par
00993       CompArea& blkY = sub[i].blocks[COMPONENT_Y];\par
00994 \par
00995       blkY.width = splitDimensionSize;\par
00996       blkY.x = i > 0 ? sub[i - 1].blocks[COMPONENT_Y].x + splitDimensionSize : blkY.x;\par
00997       CHECK( sub[i].lumaSize().width < 1, {\cf22 "the split causes the block to be smaller than the minimal TU size"} );\par
00998     \}\par
00999   \}\par
01000   {\cf19 else}\par
01001   \{\par
01002     THROW( {\cf22 "Unknown TU sub-partitioning"} );\par
01003   \}\par
01004   {\cf20 //we only partition luma, so there is going to be only one chroma tu at the end (unless it is dual tree, in which case there won't be any chroma components)}\par
01005   uint32_t partitionsWithoutChroma = (cs.area.chromaFormat == CHROMA_400) ? 0 : (isDualTree ? nPartitions : nPartitions - 1);\par
01006   {\cf19 for}( uint32_t i = 0; i < partitionsWithoutChroma; i++ )\par
01007   \{\par
01008     CompArea& blkCb = sub[i].blocks[COMPONENT_Cb];\par
01009     CompArea& blkCr = sub[i].blocks[COMPONENT_Cr];\par
01010     blkCb = CompArea();\par
01011     blkCr = CompArea();\par
01012   \}\par
01013 \}\par
01014 \par
01015 {\cf17 static} {\cf17 const} {\cf18 int} g_maxRtGridSize = 3;\par
01016 \par
01017 {\cf17 static} {\cf17 const} {\cf18 int} g_zScanToX[1 << ( g_maxRtGridSize << 1 )] =\par
01018 \{\par
01019    0,  1,  0,  1,  2,  3,  2,  3,\par
01020    0,  1,  0,  1,  2,  3,  2,  3,\par
01021    4,  5,  4,  5,  6,  7,  6,  7,\par
01022    4,  5,  4,  5,  6,  7,  6,  7,\par
01023    0,  1,  0,  1,  2,  3,  2,  3,\par
01024    0,  1,  0,  1,  2,  3,  2,  3,\par
01025    4,  5,  4,  5,  6,  7,  6,  7,\par
01026    4,  5,  4,  5,  6,  7,  6,  7,\par
01027 \};\par
01028 {\cf17 static} {\cf17 const} {\cf18 int} g_zScanToY[1 << ( g_maxRtGridSize << 1 )] =\par
01029 \{\par
01030    0,  0,  1,  1,  0,  0,  1,  1,\par
01031    2,  2,  3,  3,  2,  2,  3,  3,\par
01032    0,  0,  1,  1,  0,  0,  1,  1,\par
01033    2,  2,  3,  3,  2,  2,  3,  3,\par
01034    4,  4,  5,  5,  4,  4,  5,  5,\par
01035    6,  6,  7,  7,  6,  6,  7,  7,\par
01036    4,  4,  5,  5,  4,  4,  5,  5,\par
01037    6,  6,  7,  7,  6,  6,  7,  7,\par
01038 \};\par
01039 {\cf17 static} {\cf17 const} {\cf18 int} g_rsScanToZ[1 << ( g_maxRtGridSize << 1 )] =\par
01040 \{\par
01041    0,  1,  4,  5, 16, 17, 20, 21,\par
01042    2,  3,  6,  7, 18, 19, 22, 23,\par
01043    8,  9, 12, 13, 24, 25, 28, 29,\par
01044   10, 11, 14, 15, 26, 27, 30, 31,\par
01045   32, 33, 36, 37, 48, 49, 52, 53,\par
01046   34, 35, 38, 39, 50, 51, 54, 55,\par
01047   40, 41, 44, 45, 56, 57, 60, 61,\par
01048   42, 43, 46, 47, 58, 59, 62, 63,\par
01049 \};\par
01050 \par
01051 Partitioning PartitionerImpl::getMaxTuTiling( {\cf17 const} UnitArea &cuArea, {\cf17 const} CodingStructure &cs )\par
01052 \{\par
01053   {\cf17 static_assert}( MAX_LOG2_DIFF_CU_TR_SIZE <= g_maxRtGridSize, {\cf22 "Z-scan tables are only provided for MAX_LOG2_DIFF_CU_TR_SIZE for up to 3 (8x8 tiling)!"} );\par
01054 \par
01055   {\cf17 const} Size area     = cuArea.lumaSize();\par
01056   {\cf17 const} {\cf18 int} maxTrSize = (area.width>64 || area.height>64) ? 64 : cs.sps->getMaxTbSize();\par
01057   {\cf17 const} {\cf18 int} numTilesH = std::max<int>( 1, area.width  / maxTrSize );\par
01058   {\cf17 const} {\cf18 int} numTilesV = std::max<int>( 1, area.height / maxTrSize );\par
01059   {\cf17 const} {\cf18 int} numTiles  = numTilesH * numTilesV;\par
01060 \par
01061   CHECK( numTiles > MAX_CU_TILING_PARTITIONS, {\cf22 "CU partitioning requires more partitions than available"} );\par
01062 \par
01063   Partitioning ret;\par
01064   ret.resize( numTiles, cuArea );\par
01065 \par
01066   {\cf19 for}( {\cf18 int} i = 0; i < numTiles; i++ )\par
01067   \{\par
01068     {\cf17 const} {\cf18 int} rsy = i / numTilesH;\par
01069     {\cf17 const} {\cf18 int} rsx = i % numTilesH;\par
01070 \par
01071     {\cf17 const} {\cf18 int} x = g_zScanToX[g_rsScanToZ[( rsy << g_maxRtGridSize ) + rsx]];\par
01072     {\cf17 const} {\cf18 int} y = g_zScanToY[g_rsScanToZ[( rsy << g_maxRtGridSize ) + rsx]];\par
01073 \par
01074     UnitArea& tile = ret[i];\par
01075 \par
01076     {\cf19 for}( CompArea &comp : tile.blocks )\par
01077     \{\par
01078       {\cf19 if}( !comp.valid() ) {\cf19 continue};\par
01079 \par
01080       comp.width  /= numTilesH;\par
01081       comp.height /= numTilesV;\par
01082 \par
01083       comp.x += comp.width  * x;\par
01084       comp.y += comp.height * y;\par
01085     \}\par
01086   \}\par
01087 \par
01088   {\cf19 return} ret;\par
01089 \}\par
01090 \par
01091 Partitioning PartitionerImpl::getSbtTuTiling( {\cf17 const} UnitArea& cuArea, {\cf17 const} CodingStructure &cs, {\cf17 const} PartSplit splitType )\par
01092 \{\par
01093   Partitioning ret;\par
01094   {\cf18 int} numTiles = 2;\par
01095   {\cf18 int} widthFactor, heightFactor, xOffsetFactor, yOffsetFactor; {\cf20 // y = (x * factor) >> 2;}\par
01096   assert( splitType >= SBT_VER_HALF_POS0_SPLIT && splitType <= SBT_HOR_QUAD_POS1_SPLIT );\par
01097 \par
01098   ret.resize( numTiles, cuArea );\par
01099   {\cf19 for}( {\cf18 int} i = 0; i < numTiles; i++ )\par
01100   \{\par
01101     {\cf19 if}( splitType >= SBT_VER_QUAD_POS0_SPLIT )\par
01102     \{\par
01103       {\cf19 if}( splitType == SBT_HOR_QUAD_POS0_SPLIT || splitType == SBT_HOR_QUAD_POS1_SPLIT )\par
01104       \{\par
01105         widthFactor = 4;\par
01106         xOffsetFactor = 0;\par
01107         heightFactor = ( ( i == 0 && splitType == SBT_HOR_QUAD_POS0_SPLIT ) || ( i == 1 && splitType == SBT_HOR_QUAD_POS1_SPLIT ) ) ? 1 : 3;\par
01108         yOffsetFactor = ( i == 0 ) ? 0 : ( splitType == SBT_HOR_QUAD_POS0_SPLIT ? 1 : 3 );\par
01109       \}\par
01110       {\cf19 else}\par
01111       \{\par
01112         widthFactor = ( ( i == 0 && splitType == SBT_VER_QUAD_POS0_SPLIT ) || ( i == 1 && splitType == SBT_VER_QUAD_POS1_SPLIT ) ) ? 1 : 3;\par
01113         xOffsetFactor = ( i == 0 ) ? 0 : ( splitType == SBT_VER_QUAD_POS0_SPLIT ? 1 : 3 );\par
01114         heightFactor = 4;\par
01115         yOffsetFactor = 0;\par
01116       \}\par
01117     \}\par
01118     {\cf19 else}\par
01119     \{\par
01120       {\cf19 if}( splitType == SBT_HOR_HALF_POS0_SPLIT || splitType == SBT_HOR_HALF_POS1_SPLIT )\par
01121       \{\par
01122         widthFactor = 4;\par
01123         xOffsetFactor = 0;\par
01124         heightFactor = 2;\par
01125         yOffsetFactor = ( i == 0 ) ? 0 : 2;\par
01126       \}\par
01127       {\cf19 else}\par
01128       \{\par
01129         widthFactor = 2;\par
01130         xOffsetFactor = ( i == 0 ) ? 0 : 2;\par
01131         heightFactor = 4;\par
01132         yOffsetFactor = 0;\par
01133       \}\par
01134     \}\par
01135 \par
01136     UnitArea& tile = ret[i];\par
01137     {\cf19 for}( CompArea &comp : tile.blocks )\par
01138     \{\par
01139       {\cf19 if}( !comp.valid() ) {\cf19 continue};\par
01140       comp.x += ( comp.width  * xOffsetFactor ) >> 2;\par
01141       comp.y += ( comp.height * yOffsetFactor ) >> 2;\par
01142       comp.width = ( comp.width  * widthFactor ) >> 2;\par
01143       comp.height = ( comp.height * heightFactor ) >> 2;\par
01144     \}\par
01145   \}\par
01146 \par
01147   {\cf19 return} ret;\par
01148 \}\par
}
