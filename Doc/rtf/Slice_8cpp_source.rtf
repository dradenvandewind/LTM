04045 {\cf18 bool} ScalingList::xParseScalingList({\cf17 const} std::string &fileName)\par
04046 \{\par
04047   {\cf17 static} {\cf17 const} {\cf18 int} LINE_SIZE=1024;\par
04048   FILE *fp = NULL;\par
04049   {\cf18 char} line[LINE_SIZE];\par
04050 \par
04051   {\cf19 if} (fileName.empty())\par
04052   \{\par
04053     msg( ERROR, {\cf22 "Error: no scaling list file specified. Help on scaling lists being output\\n"});\par
04054     outputScalingListHelp(std::cout);\par
04055     std::cout << {\cf22 "\\n\\nExample scaling list file using default values:\\n\\n"};\par
04056     outputScalingLists(std::cout);\par
04057     {\cf19 return} {\cf17 true};\par
04058   \}\par
04059   {\cf19 else} {\cf19 if} ((fp = fopen(fileName.c_str(),{\cf22 "r"})) == (FILE*)NULL)\par
04060   \{\par
04061     msg( ERROR, {\cf22 "Error: cannot open scaling list file %s for reading\\n"}, fileName.c_str());\par
04062     {\cf19 return} {\cf17 true};\par
04063   \}\par
04064 \par
04065   {\cf18 int} scalingListId = 0;\par
04066   {\cf19 for} (uint32_t sizeIdc = SCALING_LIST_2x2; sizeIdc <= SCALING_LIST_64x64; sizeIdc++){\cf20 //2x2-128x128}\par
04067   \{\par
04068     {\cf17 const} uint32_t size = std::min(MAX_MATRIX_COEF_NUM,({\cf18 int})g_scalingListSize[sizeIdc]);\par
04069 \par
04070     {\cf19 for}(uint32_t listIdc = 0; listIdc < SCALING_LIST_NUM; listIdc++)\par
04071     \{\par
04072 \par
04073       {\cf19 if} ((sizeIdc == SCALING_LIST_64x64 && listIdc % (SCALING_LIST_NUM / SCALING_LIST_PRED_MODES) != 0) || (sizeIdc == SCALING_LIST_2x2 && listIdc < 4))\par
04074       \{\par
04075         {\cf19 continue};\par
04076       \}\par
04077       {\cf19 else}\par
04078       \{\par
04079         {\cf18 int} * {\cf17 const} src = getScalingListAddress(scalingListId);\par
04080         \{\par
04081           fseek(fp, 0, SEEK_SET);\par
04082           {\cf18 bool} bFound={\cf17 false};\par
04083           {\cf19 while} ((!feof(fp)) && (!bFound))\par
04084           \{\par
04085             {\cf18 char} *ret = fgets(line, LINE_SIZE, fp);\par
04086             {\cf18 char} *findNamePosition= ret==NULL ? NULL : strstr(line, MatrixType[sizeIdc][listIdc]);\par
04087             {\cf20 // This could be a match against the DC string as well, so verify it isn't}\par
04088             {\cf19 if} (findNamePosition!= NULL && (MatrixType_DC[sizeIdc][listIdc]==NULL || strstr(line, MatrixType_DC[sizeIdc][listIdc])==NULL))\par
04089             \{\par
04090               bFound={\cf17 true};\par
04091             \}\par
04092           \}\par
04093           {\cf19 if} (!bFound)\par
04094           \{\par
04095             msg( ERROR, {\cf22 "Error: cannot find Matrix %s from scaling list file %s\\n"}, MatrixType[sizeIdc][listIdc], fileName.c_str());\par
04096             {\cf19 return} {\cf17 true};\par
04097 \par
04098           \}\par
04099         \}\par
04100         {\cf19 for} (uint32_t i=0; i<size; i++)\par
04101         \{\par
04102           {\cf18 int} data;\par
04103           {\cf19 if} (fscanf(fp, {\cf22 "%d,"}, &data)!=1)\par
04104           \{\par
04105             msg( ERROR, {\cf22 "Error: cannot read value #%d for Matrix %s from scaling list file %s at file position %ld\\n"}, i, MatrixType[sizeIdc][listIdc], fileName.c_str(), ftell(fp));\par
04106             {\cf19 return} {\cf17 true};\par
04107           \}\par
04108           {\cf19 if} (data<0 || data>255)\par
04109           \{\par
04110             msg( ERROR, {\cf22 "Error: QMatrix entry #%d of value %d for Matrix %s from scaling list file %s at file position %ld is out of range (0 to 255)\\n"}, i, data, MatrixType[sizeIdc][listIdc], fileName.c_str(), ftell(fp));\par
04111             {\cf19 return} {\cf17 true};\par
04112           \}\par
04113           src[i] = data;\par
04114         \}\par
04115 \par
04116         {\cf20 //set DC value for default matrix check}\par
04117         setScalingListDC(scalingListId, src[0]);\par
04118 \par
04119         {\cf19 if}(sizeIdc > SCALING_LIST_8x8)\par
04120         \{\par
04121           \{\par
04122             fseek(fp, 0, SEEK_SET);\par
04123             {\cf18 bool} bFound={\cf17 false};\par
04124             {\cf19 while} ((!feof(fp)) && (!bFound))\par
04125             \{\par
04126               {\cf18 char} *ret = fgets(line, LINE_SIZE, fp);\par
04127               {\cf18 char} *findNamePosition= ret==NULL ? NULL : strstr(line, MatrixType_DC[sizeIdc][listIdc]);\par
04128               {\cf19 if} (findNamePosition!= NULL)\par
04129               \{\par
04130                 {\cf20 // This won't be a match against the non-DC string.}\par
04131                 bFound={\cf17 true};\par
04132               \}\par
04133             \}\par
04134             {\cf19 if} (!bFound)\par
04135             \{\par
04136               msg( ERROR, {\cf22 "Error: cannot find DC Matrix %s from scaling list file %s\\n"}, MatrixType_DC[sizeIdc][listIdc], fileName.c_str());\par
04137               {\cf19 return} {\cf17 true};\par
04138             \}\par
04139           \}\par
04140           {\cf18 int} data;\par
04141           {\cf19 if} (fscanf(fp, {\cf22 "%d,"}, &data)!=1)\par
04142           \{\par
04143             msg( ERROR, {\cf22 "Error: cannot read DC %s from scaling list file %s at file position %ld\\n"}, MatrixType_DC[sizeIdc][listIdc], fileName.c_str(), ftell(fp));\par
04144             {\cf19 return} {\cf17 true};\par
04145           \}\par
04146           {\cf19 if} (data<0 || data>255)\par
04147           \{\par
04148             msg( ERROR, {\cf22 "Error: DC value %d for Matrix %s from scaling list file %s at file position %ld is out of range (0 to 255)\\n"}, data, MatrixType[sizeIdc][listIdc], fileName.c_str(), ftell(fp));\par
04149             {\cf19 return} {\cf17 true};\par
04150           \}\par
04151           {\cf20 //overwrite DC value when size of matrix is larger than 16x16}\par
04152           setScalingListDC(scalingListId, data);\par
04153         \}\par
04154       \}\par
04155       scalingListId++;\par
04156     \}\par
04157   \}\par
04158 {\cf20 //  std::cout << "\\n\\nRead scaling lists of:\\n\\n";}\par
04159 {\cf20 //  outputScalingLists(std::cout);}\par
04160 \par
04161   fclose(fp);\par
04162   {\cf19 return} {\cf17 false};\par
04163 \}\par
