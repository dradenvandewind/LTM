02197     {\cf19 if}( getSliceType() == B_SLICE )\par
02198     \{\par
02199       {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < getNumRefIdx(REF_PIC_LIST_1); refIdx++)\par
02200       \{\par
02201         minPicDist = std::min(minPicDist, std::abs(currPOC - getRefPic(REF_PIC_LIST_1, refIdx)->getPOC()));\par
02202       \}\par
02203     \}\par
02204   \}\par
02205   {\cf19 return} ({\cf18 unsigned}) minPicDist;\par
02206 \}\par
