00489 \par
00490       {\cf18 int} refLayerId = m_pcPic->cs->vps->getLayerId( m_pcPic->cs->vps->getDirectRefLayerIdx( layerIdx, m_RPL1.getInterLayerRefPicIdx( ii ) ) );\par
00491 \par
00492       pcRefPic = xGetRefPic( rcListPic, getPOC(), refLayerId );\par
00493       pcRefPic->longTerm = {\cf17 true};\par
00494     \}\par
00495     {\cf19 else}\par
00496     {\cf19 if} (!m_RPL1.isRefPicLongterm(ii))\par
00497     \{\par
00498       pcRefPic = xGetRefPic(rcListPic, getPOC() + m_RPL1.getRefPicIdentifier(ii), m_pcPic->layerId);\par
00499       pcRefPic->longTerm = {\cf17 false};\par
00500     \}\par
00501     {\cf19 else}\par
00502     \{\par
00503       {\cf18 int} pocBits = getSPS()->getBitsForPOC();\par
00504       {\cf18 int} pocMask = (1 << pocBits) - 1;\par
00505       {\cf18 int} ltrpPoc = m_RPL1.getRefPicIdentifier(ii) & pocMask;\par
00506       {\cf19 if}(m_RPL1.getDeltaPocMSBPresentFlag(ii))\par
00507       \{\par
00508         ltrpPoc += getPOC() - m_RPL1.getDeltaPocMSBCycleLT(ii) * (pocMask + 1) - (getPOC() & pocMask);\par
00509       \}\par
00510       pcRefPic = xGetLongTermRefPicCandidate( rcListPic, ltrpPoc, m_RPL1.getDeltaPocMSBPresentFlag( ii ), m_pcPic->layerId );\par
00511       pcRefPic->longTerm = {\cf17 true};\par
00512     \}\par
00513     {\cf19 if}(ii < numOfActiveRef)\par
00514     \{\par
00515       pcRefPic->extendPicBorder( getPPS() );\par
00516       m_apcRefPicList[REF_PIC_LIST_1][ii] = pcRefPic;\par
