00611 {\cf18 void} Slice::checkRPL({\cf17 const} ReferencePictureList* pRPL0, {\cf17 const} ReferencePictureList* pRPL1, {\cf17 const} {\cf18 int} associatedIRAPDecodingOrderNumber, PicList& rcListPic)\par
00612 \{\par
00613   Picture* pcRefPic;\par
00614   {\cf18 int} refPicPOC;\par
00615   {\cf18 int} refPicDecodingOrderNumber;\par
00616 \par
00617   {\cf18 int} irapPOC = getAssociatedIRAPPOC();\par
00618 \par
00619   {\cf17 const} {\cf18 int} numEntries[] = \{ pRPL0->getNumberOfShorttermPictures() + pRPL0->getNumberOfLongtermPictures() + pRPL0->getNumberOfInterLayerPictures(), pRPL1->getNumberOfShorttermPictures() + pRPL1->getNumberOfLongtermPictures() + pRPL1->getNumberOfInterLayerPictures() \};\par
00620   {\cf17 const} {\cf18 int} numActiveEntries[] = \{ getNumRefIdx( REF_PIC_LIST_0 ), getNumRefIdx( REF_PIC_LIST_1 ) \};\par
00621   {\cf17 const} ReferencePictureList* rpl[] = \{ pRPL0, pRPL1 \};\par
00622   {\cf17 const} {\cf18 bool} fieldSeqFlag = getSPS()->getFieldSeqFlag();\par
00623   {\cf17 const} {\cf18 int} layerIdx = m_pcPic->cs->vps == {\cf17 nullptr} ? 0 : m_pcPic->cs->vps->getGeneralLayerIdx( m_pcPic->layerId );\par
00624 \par
00625   {\cf19 for}( {\cf18 int} refPicList = 0; refPicList < 2; refPicList++ )\par
00626   \{\par
00627     {\cf19 for}( {\cf18 int} i = 0; i < numEntries[refPicList]; i++ )\par
00628     \{\par
00629       {\cf19 if}( rpl[refPicList]->isInterLayerRefPic( i ) )\par
00630       \{\par
00631         {\cf18 int} refLayerId = m_pcPic->cs->vps->getLayerId( m_pcPic->cs->vps->getDirectRefLayerIdx( layerIdx, rpl[refPicList]->getInterLayerRefPicIdx( i ) ) );\par
00632         pcRefPic = xGetRefPic( rcListPic, getPOC(), refLayerId );\par
00633         refPicPOC = pcRefPic->getPOC();\par
00634       \}\par
00635       {\cf19 else} {\cf19 if}( !rpl[refPicList]->isRefPicLongterm( i ) )\par
00636       \{\par
00637         refPicPOC = getPOC() + rpl[refPicList]->getRefPicIdentifier(i);\par
00638         pcRefPic = xGetRefPic( rcListPic, refPicPOC, m_pcPic->layerId );\par
00639       \}\par
00640       {\cf19 else}\par
00641       \{\par
00642         {\cf18 int} pocBits = getSPS()->getBitsForPOC();\par
00643         {\cf18 int} pocMask = ( 1 << pocBits ) - 1;\par
00644         {\cf18 int} ltrpPoc = rpl[refPicList]->getRefPicIdentifier( i ) & pocMask;\par
00645         {\cf19 if}( rpl[refPicList]->getDeltaPocMSBPresentFlag( i ) )\par
00646         \{\par
00647           ltrpPoc += getPOC() - rpl[refPicList]->getDeltaPocMSBCycleLT( i ) * ( pocMask + 1 ) - ( getPOC() & pocMask );\par
00648         \}\par
00649         pcRefPic = xGetLongTermRefPic( rcListPic, ltrpPoc, rpl[refPicList]->getDeltaPocMSBPresentFlag( i ), m_pcPic->layerId );\par
00650         refPicPOC = pcRefPic->getPOC();\par
00651       \}\par
00652       {\cf19 if} (pcRefPic) {\cf20 // the checks are for all reference picture, but we may not have an inactive reference picture, if starting with a CRA}\par
00653       \{\par
00654         refPicDecodingOrderNumber = pcRefPic->getDecodingOrderNumber();\par
00655 \par
00656         {\cf19 if}( m_eNalUnitType == NAL_UNIT_CODED_SLICE_CRA || m_eNalUnitType == NAL_UNIT_CODED_SLICE_IDR_W_RADL || m_eNalUnitType == NAL_UNIT_CODED_SLICE_IDR_N_LP )\par
00657         \{\par
00658           CHECK( refPicPOC < irapPOC || refPicDecodingOrderNumber < associatedIRAPDecodingOrderNumber, {\cf22 "When the current picture, with nuh_layer_id equal to a particular value layerId, "}\par
00659             {\cf22 "is an IRAP picture, there shall be no picture referred to by an entry in RefPicList[ 0 ] that precedes, in output order or decoding order, any preceding IRAP picture "}\par
00660             {\cf22 "with nuh_layer_id equal to layerId in decoding order (when present)."} );\par
00661         \}\par
00662 \par
00663         {\cf19 if}( irapPOC < getPOC() && !fieldSeqFlag )\par
00664         \{\par
00665           CHECK( refPicPOC < irapPOC || refPicDecodingOrderNumber < associatedIRAPDecodingOrderNumber, {\cf22 "When the current picture follows an IRAP picture having the same value "}\par
00666             {\cf22 "of nuh_layer_id and the leading pictures, if any, associated with that IRAP picture, in both decoding order and output order, there shall be no picture referred "}\par
00667             {\cf22 "to by an entry in RefPicList[ 0 ] or RefPicList[ 1 ] that precedes that IRAP picture in output order or decoding order."} );\par
00668         \}\par
00669 \par
00670         {\cf20 // Generated reference picture does not have picture header}\par
00671         {\cf17 const} {\cf18 bool} isGeneratedRefPic = pcRefPic->slices[0]->getPicHeader() ? false : {\cf17 true};\par
00672 \par
00673         {\cf17 const} {\cf18 bool} nonReferencePictureFlag = isGeneratedRefPic ? pcRefPic->slices[0]->getPicHeader()->getNonReferencePictureFlag() : pcRefPic->nonReferencePictureFlag;\par
00674         CHECK( pcRefPic == m_pcPic || nonReferencePictureFlag, {\cf22 "The picture referred to by each entry in RefPicList[ 0 ] or RefPicList[ 1 ] shall not be the current picture and shall have ph_non_ref_pic_flag equal to 0"} );\par
00675 \par
00676         {\cf19 if}( i < numActiveEntries[refPicList] )\par
00677         \{\par
00678           {\cf19 if}( irapPOC < getPOC() )\par
00679           \{\par
00680             CHECK( refPicPOC < irapPOC || refPicDecodingOrderNumber < associatedIRAPDecodingOrderNumber, {\cf22 "When the current picture follows an IRAP picture having the same value "}\par
00681               {\cf22 "of nuh_layer_id in both decoding order and output order, there shall be no picture referred to by an active entry in RefPicList[ 0 ] or RefPicList[ 1 ] that "}\par
00682               {\cf22 "precedes that IRAP picture in output order or decoding order."} );\par
00683           \}\par
00684 \par
00685           {\cf20 // Checking this: "When the current picture is a RADL picture, there shall be no active entry in RefPicList[ 0 ] or}\par
00686           {\cf20 // RefPicList[ 1 ] that is any of the following: A picture that precedes the associated IRAP picture in decoding order"}\par
00687           {\cf19 if}( m_eNalUnitType == NAL_UNIT_CODED_SLICE_RADL )\par
00688           \{\par
00689             CHECK( refPicDecodingOrderNumber < associatedIRAPDecodingOrderNumber, {\cf22 "RADL picture detected that violate the rule that no active entry in RefPicList[] shall precede the associated IRAP picture in decoding order"} );\par
00690 {\cf21 #if JVET_S0084_S0110_RADL}\par
00691             {\cf20 // Checking this: "When the current picture is a RADL picture, there shall be no active entry in RefPicList[ 0 ] or }\par
00692             {\cf20 // RefPicList[ 1 ] that is any of the following: A RASL picture with pps_mixed_nalu_types_in_pic_flag is equal to 0}\par
00693             {\cf19 for} ({\cf18 int} i = 0; i < pcRefPic->numSlices; i++)\par
00694             \{\par
00695               {\cf19 if} (pcRefPic->slices[i]->getPPS()->getMixedNaluTypesInPicFlag() == 0)\par
00696               \{\par
00697                 CHECK(pcRefPic->slices[i]->getNalUnitType() == NAL_UNIT_CODED_SLICE_RASL, {\cf22 "When the current picture is a RADL picture, there shall be no active entry in RefPicList[ 0 ] or RefPicList[ 1 ] that is a RASL picture with pps_mixed_nalu_types_in_pic_flag is equal to 0"});\par
00698               \}\par
00699             \}\par
00700 {\cf21 #endif}\par
00701 \par
00702           \}\par
00703 \par
00704           CHECK( pcRefPic->temporalId > m_pcPic->temporalId, {\cf22 "The picture referred to by each active entry in RefPicList[ 0 ] or RefPicList[ 1 ] shall be present in the DPB and shall have TemporalId less than or equal to that of the current picture."} );\par
00705         \}\par
00706 {\cf21 #if JVET_R0046_IRAP_ASPECT2}\par
00707         {\cf20 // Add a constraint on an ILRP being either an IRAP picture or having TemporalId less than or equal to}\par
00708         {\cf20 // Max (0, vps_max_tid_il_ref_pics_plus1[ refPicVpsLayerId ] - 1 ), with refPicVpsLayerId equal to the value of}\par
00709         {\cf20 // the nuh_layer_id of the referenced picture.}\par
00710         {\cf19 if} (rpl[refPicList]->isInterLayerRefPic(i))\par
00711         \{\par
00712           {\cf18 bool} cond1      = (pcRefPic->getPictureType() == NAL_UNIT_CODED_SLICE_GDR);\par
00713           {\cf18 bool} cond2      = (pcRefPic->slices[0]->getPicHeader()->getRecoveryPocCnt() == 0);\par
00714           {\cf18 bool} cond3      = (pcRefPic->cs->slice->isIRAP());\par
00715           \par
00716           {\cf17 const} VPS *vps                  = pcRefPic->cs->vps;\par
00717           {\cf17 const} {\cf18 int}  maxTidILRefPicsPlus1 = vps->getMaxTidIlRefPicsPlus1(layerIdx, pcRefPic->layerId);\par
00718           {\cf18 bool} cond4 = (pcRefPic->temporalId < maxTidILRefPicsPlus1);\par
00719 \par
00720           CHECK((cond1 && cond2) || cond3 || cond4,\par
00721                 {\cf22 "Either of the following conditions shall apply for the picture referred to by each ILRP entry, when "}\par
00722                 {\cf22 "present, in RefPicList[ 0 ] or RefPicList[ 1 ] of a slice of the current picture:-The picture is a "}\par
00723                 {\cf22 "GDR picture with "}\par
00724                 {\cf22 "ph_recovery_poc_cnt equal to 0 or an IRAP picture."}\par
00725                 {\cf22 "-The picture has TemporalId less than vps_max_tid_il_ref_pics_plus1[ currLayerIdx ][ refLayerIdx ], "}\par
00726                 {\cf22 "where currLayerIdx and refLayerIdx are equal to "}\par
00727                 {\cf22 "GeneralLayerIdx[ nuh_layer_id ] and GeneralLayerIdx[ refpicLayerId ], respectively. "});\par
00728         \}\par
00729 {\cf21 #endif}\par
00730       \}\par
00731     \}\par
00732   \}\par
00733 \}\par
