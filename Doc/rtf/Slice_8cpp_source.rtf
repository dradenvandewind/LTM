03602 {\cf18 void} PPS::initRasterSliceMap( std::vector<uint32_t> numTilesInSlice )\par
03603 \{\par
03604   uint32_t tileIdx = 0;\par
03605   setNumSlicesInPic( (uint32_t) numTilesInSlice.size() );\par
03606 \par
03607   {\cf20 // allocate new memory for slice list}\par
03608   CHECK(m_numSlicesInPic > MAX_SLICES, {\cf22 "Number of slices in picture exceeds valid range"});\par
03609   m_sliceMap.resize( m_numSlicesInPic );\par
03610 \par
03611   {\cf19 for}( uint32_t sliceIdx = 0; sliceIdx < numTilesInSlice.size(); sliceIdx++ )\par
03612   \{\par
03613     m_sliceMap[sliceIdx].initSliceMap();\par
03614     m_sliceMap[sliceIdx].setSliceID( tileIdx );\par
03615     m_sliceMap[sliceIdx].setNumTilesInSlice( numTilesInSlice[sliceIdx] );\par
03616     {\cf19 for}( uint32_t idx = 0; idx < numTilesInSlice[sliceIdx]; idx++ )\par
03617     \{\par
03618       uint32_t tileX = tileIdx % getNumTileColumns();\par
03619       uint32_t tileY = tileIdx / getNumTileColumns();\par
03620       CHECK(tileY >= getNumTileRows(), {\cf22 "Number of tiles in slice exceeds the remaining number of tiles in picture"});\par
03621 \par
03622       m_sliceMap[sliceIdx].addCtusToSlice(getTileColumnBd(tileX), getTileColumnBd(tileX + 1),\par
03623                                           getTileRowBd(tileY), getTileRowBd(tileY + 1),\par
03624                                           getPicWidthInCtu());\par
03625       tileIdx++;\par
03626     \}\par
03627   \}\par
03628 \par
03629   {\cf20 // check for valid raster-scan slice map}\par
03630   checkSliceMap();\par
03631 \}\par
