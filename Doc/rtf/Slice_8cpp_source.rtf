01058 {\cf18 void} Slice::checkLeadingPictureRestrictions(PicList& rcListPic, {\cf17 const} PPS& pps){\cf17  const}\par
01059 {\cf17 }\{\par
01060   {\cf18 int} nalUnitType = this->getNalUnitType();\par
01061 \par
01062   {\cf20 // When a picture is a leading picture, it shall be a RADL or RASL picture.}\par
01063   {\cf19 if}(this->getAssociatedIRAPPOC() > this->getPOC())\par
01064   \{\par
01065     {\cf20 //check this only when pps_mixed_nalu_types_in_pic_flag is equal to 0}\par
01066     {\cf19 if} (pps.getMixedNaluTypesInPicFlag() == 0)\par
01067     \{\par
01068       {\cf20 // Do not check IRAP pictures since they may get a POC lower than their associated IRAP}\par
01069       {\cf19 if} (nalUnitType < NAL_UNIT_CODED_SLICE_IDR_W_RADL ||\par
01070           nalUnitType > NAL_UNIT_CODED_SLICE_CRA)\par
01071       \{\par
01072         CHECK(nalUnitType != NAL_UNIT_CODED_SLICE_RASL &&\par
01073               nalUnitType != NAL_UNIT_CODED_SLICE_RADL, {\cf22 "Invalid NAL unit type"});\par
01074       \}\par
01075     \}\par
01076   \}\par
01077 \par
01078   {\cf19 if} (this->getAssociatedIRAPPOC() <= this->getPOC())\par
01079   \{\par
01080     {\cf19 if} (pps.getMixedNaluTypesInPicFlag() == 0)\par
01081     \{\par
01082       CHECK(nalUnitType == NAL_UNIT_CODED_SLICE_RASL || nalUnitType == NAL_UNIT_CODED_SLICE_RADL, {\cf22 "When a picture is not a leading picture, it shall not be a RADL or RASL picture."});\par
01083     \}\par
01084   \}\par
01085 \par
01086   {\cf20 // No RASL pictures shall be present in the bitstream that are associated with}\par
01087   {\cf20 // an IDR picture.}\par
01088   {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RASL && !pps.getMixedNaluTypesInPicFlag())\par
01089   \{\par
01090     CHECK( this->getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_IDR_N_LP   ||\par
01091            this->getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_IDR_W_RADL, {\cf22 "Invalid NAL unit type"});\par
01092   \}\par
01093 \par
01094   {\cf20 // No RADL pictures shall be present in the bitstream that are associated with}\par
01095   {\cf20 // a BLA picture having nal_unit_type equal to BLA_N_LP or that are associated}\par
01096   {\cf20 // with an IDR picture having nal_unit_type equal to IDR_N_LP.}\par
01097   {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RADL && !pps.getMixedNaluTypesInPicFlag())\par
01098   \{\par
01099     CHECK (this->getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_IDR_N_LP, {\cf22 "Invalid NAL unit type"});\par
01100   \}\par
01101 \par
01102   {\cf20 // loop through all pictures in the reference picture buffer}\par
01103   PicList::iterator iterPic = rcListPic.begin();\par
01104   {\cf18 int} numNonLPFound = 0;\par
01105   {\cf19 while} ( iterPic != rcListPic.end())\par
01106   \{\par
01107     Picture* pcPic = *(iterPic++);\par
01108     {\cf19 if}( ! pcPic->reconstructed)\par
01109     \{\par
01110       {\cf19 continue};\par
01111     \}\par
01112     {\cf19 if}( pcPic->poc == this->getPOC())\par
01113     \{\par
01114       {\cf19 continue};\par
01115     \}\par
01116     {\cf17 const} Slice* pcSlice = pcPic->slices[0];\par
01117 \par
01118     {\cf19 if} (pcSlice->getPicHeader()->getPicOutputFlag() == 1 && !this->getNoOutputOfPriorPicsFlag() && pcPic->layerId == this->m_nuhLayerId)\par
01119     \{\par
01120       {\cf19 if} ((nalUnitType == NAL_UNIT_CODED_SLICE_CRA || nalUnitType == NAL_UNIT_CODED_SLICE_IDR_N_LP || nalUnitType == NAL_UNIT_CODED_SLICE_IDR_W_RADL) && !pps.getMixedNaluTypesInPicFlag())\par
01121       \{\par
01122         CHECK(pcPic->poc >= this->getPOC(), {\cf22 "Any picture, with nuh_layer_id equal to a particular value layerId, that precedes an IRAP picture with nuh_layer_id "}\par
01123               {\cf22 "equal to layerId in decoding order shall precede the IRAP picture in output order."});\par
01124       \}\par
01125     \}\par
01126 \par
01127     {\cf19 if} (pcSlice->getPicHeader()->getPicOutputFlag() == 1 && pcPic->layerId == this->m_nuhLayerId)\par
01128     \{\par
01129       {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RADL)\par
01130       \{\par
01131         {\cf19 if} (this->getAssociatedIRAPPOC() > pcSlice->getAssociatedIRAPPOC() && !pps.getMixedNaluTypesInPicFlag())\par
01132         \{\par
01133           {\cf19 if} (this->getAssociatedIRAPPOC() != pcPic->poc)\par
01134           \{\par
01135             CHECK(pcPic->poc >= this->getPOC(), {\cf22 "Any picture, with nuh_layer_id equal to a particular value layerId, that precedes an IRAP picture with nuh_layer_id "}\par
01136                   {\cf22 "equal to layerId in decoding order shall precede any RADL picture associated with the IRAP picture in output order."});\par
01137           \}\par
01138         \}\par
01139       \}\par
01140     \}\par
01141 \par
01142     {\cf19 if} (pcSlice->getPicHeader()->getPicOutputFlag() == 1 && !this->getPicHeader()->getNoOutputBeforeRecoveryFlag() && pcPic->layerId == this->m_nuhLayerId\par
01143         && nalUnitType != NAL_UNIT_CODED_SLICE_GDR && this->getPicHeader()->getRecoveryPocCnt() != -1)\par
01144     \{\par
01145       {\cf19 if} (this->getPOC() == this->getPicHeader()->getRecoveryPocCnt() + this->getPrevGDRInSameLayerPOC())\par
01146       \{\par
01147         CHECK(pcPic->poc >= this->getPOC(), {\cf22 "Any picture, with nuh_layer_id equal to a particular value layerId, that precedes a recovery point picture with "}\par
01148               {\cf22 "nuh_layer_id equal to layerId in decoding order shall precede the recovery point picture in output order."});\par
01149       \}\par
01150     \}\par
01151 \par
01152     {\cf19 if} ((nalUnitType == NAL_UNIT_CODED_SLICE_RASL || nalUnitType == NAL_UNIT_CODED_SLICE_RADL) && \par
01153       (pcSlice->getNalUnitType() != NAL_UNIT_CODED_SLICE_RASL && pcSlice->getNalUnitType() != NAL_UNIT_CODED_SLICE_RADL) && !pps.getMixedNaluTypesInPicFlag())\par
01154     \{\par
01155       {\cf19 if} (pcSlice->getAssociatedIRAPPOC() == this->getAssociatedIRAPPOC() && pcPic->layerId == this->m_nuhLayerId)\par
01156       \{\par
01157         numNonLPFound++;\par
01158         {\cf18 int} limitNonLP = 0;\par
01159         {\cf19 if} (pcSlice->getSPS()->getFieldSeqFlag())\par
01160         \{\par
01161           limitNonLP = 1;\par
01162         \}\par
01163         CHECK(pcPic->poc > this->getAssociatedIRAPPOC() && numNonLPFound > limitNonLP, {\cf22 "If sps_field_seq_flag is equal to 0 and the current picture, with nuh_layer_id "}\par
01164               {\cf22 "equal to a particular value layerId, is a leading picture associated with an IRAP picture, it shall precede, in decoding order, all non-leading "}\par
01165               {\cf22 "pictures that are associated with the same IRAP picture.Otherwise, let picA and picB be the first and the last leading pictures, in decoding order, "}\par
01166               {\cf22 "associated with an IRAP picture, respectively, there shall be at most one non-leading picture with nuh_layer_id equal to layerId preceding picA in "}\par
01167               {\cf22 "decoding order, and there shall be no non-leading picture with nuh_layer_id equal to layerId between picA and picB in decoding order."});\par
01168       \}\par
01169     \}\par
01170 \par
01171     {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RASL && !pps.getMixedNaluTypesInPicFlag())\par
01172     \{\par
01173       {\cf19 if} ((this->getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_CRA) &&\par
01174           this->getAssociatedIRAPPOC() == pcSlice->getAssociatedIRAPPOC())\par
01175       \{\par
01176         {\cf19 if} (pcSlice->getNalUnitType() == NAL_UNIT_CODED_SLICE_RADL)\par
01177         \{\par
01178           CHECK(pcPic->poc <= this->getPOC(), {\cf22 "Any RASL picture associated with a CRA picture shall precede any RADL picture associated with the CRA picture in output order."});\par
01179         \}\par
01180       \}\par
01181     \}\par
01182 \par
01183     {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RASL && !pps.getMixedNaluTypesInPicFlag())\par
01184     \{\par
01185       {\cf19 if}(this->getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_CRA)\par
01186       \{\par
01187         {\cf19 if}(pcSlice->getPOC() < this->getAssociatedIRAPPOC() &&\par
01188           (\par
01189             pcSlice->getNalUnitType() == NAL_UNIT_CODED_SLICE_IDR_N_LP   ||\par
01190             pcSlice->getNalUnitType() == NAL_UNIT_CODED_SLICE_IDR_W_RADL ||\par
01191             pcSlice->getNalUnitType() == NAL_UNIT_CODED_SLICE_CRA ||\par
01192             pcSlice->getNalUnitType() == NAL_UNIT_CODED_SLICE_GDR) &&\par
01193             pcPic->layerId == this->m_nuhLayerId)\par
01194         \{\par
01195           CHECK(this->getPOC() <= pcSlice->getPOC(), {\cf22 "Any RASL picture, with nuh_layer_id equal to a particular value layerId, associated with a CRA picture shall follow, "}\par
01196                {\cf22 "in output order, any IRAP or GDR picture with nuh_layer_id equal to layerId that precedes the CRA picture in decoding order."});\par
01197         \}\par
01198       \}\par
01199     \}\par
01200   \}\par
01201 \}\par
01202 \par
01203 {\cf18 void} Slice::checkSubpicTypeConstraints(PicList& rcListPic, {\cf17 const} ReferencePictureList* pRPL0, {\cf17 const} ReferencePictureList* pRPL1, {\cf17 const} {\cf18 int} prevIRAPSubpicDecOrderNo)\par
01204 \{\par
01205   {\cf18 int} curSubpicIdx = getPPS()->getSubPicIdxFromSubPicId(getSliceSubPicId());\par
01206 \par
01207   {\cf19 if} (getPPS()->getMixedNaluTypesInPicFlag() && getSliceType() != I_SLICE)\par
01208   \{\par
01209     CHECK(!getSPS()->getSubPicTreatedAsPicFlag(curSubpicIdx), {\cf22 "When pps_mixed_nalu_types_in_pic_flag is equal 1, the value of sps_subpic_treated_as_pic_flag shall be equal to 1 "}\par
01210           {\cf22 "for all the subpictures that are in the picture and contain at least one P or B slice"});\par
01211   \}\par
01212 \par
01213   {\cf18 int} nalUnitType = getNalUnitType();\par
01214   {\cf18 int} prevIRAPSubpicPOC = getPrevIRAPSubpicPOC();\par
01215 \par
01216   {\cf19 if} (getCtuAddrInSlice(0) == getPPS()->getSubPic(curSubpicIdx).getFirstCTUInSubPic())\par
01217   \{\par
01218     {\cf20 // subpicture type related constraints invoked only if the current slice is the first slice of a subpicture}\par
01219     {\cf18 int} prevGDRSubpicPOC = getPrevGDRSubpicPOC();\par
01220     {\cf18 int} prevIRAPSubpicType = getPrevIRAPSubpicType();\par
01221 \par
01222     {\cf19 if} (prevIRAPSubpicPOC > getPOC() && (nalUnitType < NAL_UNIT_CODED_SLICE_IDR_W_RADL || nalUnitType > NAL_UNIT_CODED_SLICE_CRA))\par
01223     \{\par
01224       CHECK(nalUnitType != NAL_UNIT_CODED_SLICE_RASL && nalUnitType != NAL_UNIT_CODED_SLICE_RADL,\par
01225         {\cf22 "When a subpicture is a leading subpicture of an IRAP subpicture, it shall be a RADL or RASL subpicture"});\par
01226     \}\par
01227 \par
01228     {\cf19 if} (prevIRAPSubpicPOC <= getPOC())\par
01229     \{\par
01230       CHECK(nalUnitType == NAL_UNIT_CODED_SLICE_RASL || nalUnitType == NAL_UNIT_CODED_SLICE_RADL,\par
01231         {\cf22 "When a subpicture is not a leading subpicture of an IRAP subpicture, it shall not be a RADL or RASL subpicture"});\par
01232     \}\par
01233 \par
01234     CHECK(nalUnitType == NAL_UNIT_CODED_SLICE_RASL && (prevIRAPSubpicType == NAL_UNIT_CODED_SLICE_IDR_N_LP || prevIRAPSubpicType == NAL_UNIT_CODED_SLICE_IDR_W_RADL),\par
01235       {\cf22 "No RASL subpictures shall be present in the bitstream that are associated with an IDR subpicture"});\par
01236 \par
01237     CHECK(nalUnitType == NAL_UNIT_CODED_SLICE_RADL && prevIRAPSubpicType == NAL_UNIT_CODED_SLICE_IDR_N_LP,\par
01238       {\cf22 "No RADL subpictures shall be present in the bitstream that are associated with an IDR subpicture having nal_unit_type equal to IDR_N_LP"});\par
01239 \par
01240     {\cf20 //constraints related to current subpicture type and its preceding subpicture types}\par
01241     PicList::iterator iterPic = rcListPic.begin();\par
01242     {\cf18 int} numNonLeadingPic = 0;\par
01243     {\cf19 while} (iterPic != rcListPic.end())\par
01244     \{\par
01245       Picture* bufPic = *(iterPic++);\par
01246       {\cf19 if} (!bufPic->reconstructed)\par
01247       \{\par
01248         {\cf19 continue};\par
01249       \}\par
01250       {\cf19 if} (bufPic->poc == getPOC())\par
01251       \{\par
01252         {\cf19 continue};\par
01253       \}\par
01254 \par
01255       {\cf20 //identify the subpicture in the reference picture buffer that with nuh_layer_id equal to current subpicture layerId and subpicture index equal to current subpicIdx}\par
01256       {\cf18 bool} isBufPicOutput = {\cf17 false};\par
01257       {\cf18 int} bufSubpicType = NAL_UNIT_INVALID;\par
01258       {\cf18 int} bufSubpicPrevIRAPSubpicPOC = 0;\par
01259       {\cf19 for} ({\cf18 int} i = 0; i < bufPic->numSlices; i++)\par
01260       \{\par
01261         {\cf19 if} (bufPic->sliceSubpicIdx[i] == curSubpicIdx)\par
01262         \{\par
01263           isBufPicOutput = bufPic->slices[i]->getPicHeader()->getPicOutputFlag();\par
01264           bufSubpicType = bufPic->slices[i]->getNalUnitType();\par
01265           bufSubpicPrevIRAPSubpicPOC = bufPic->slices[i]->getPrevIRAPSubpicPOC();\par
01266           {\cf19 break};\par
01267         \}\par
01268       \}\par
01269 \par
01270       {\cf19 if} ((nalUnitType == NAL_UNIT_CODED_SLICE_CRA || nalUnitType == NAL_UNIT_CODED_SLICE_IDR_N_LP || nalUnitType == NAL_UNIT_CODED_SLICE_IDR_W_RADL) &&\par
01271         !this->getNoOutputOfPriorPicsFlag() && isBufPicOutput == 1 && bufPic->layerId == m_nuhLayerId)\par
01272       \{\par
01273         CHECK(bufPic->poc >= getPOC(), {\cf22 "Any subpicture, with nuh_layer_id equal to a particular value layerId and subpicture index equal to a particular value subpicIdx, that "}\par
01274           {\cf22 "precedes, in decoding order, an IRAP subpicture with nuh_layer_id equal to layerId and subpicture index equal to subpicIdx shall precede, in output order, the "}\par
01275           {\cf22 "IRAP subpicture"});\par
01276       \}\par
01277 \par
01278       {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RADL && isBufPicOutput == 1 && bufPic->layerId == m_nuhLayerId &&\par
01279         prevIRAPSubpicPOC > bufSubpicPrevIRAPSubpicPOC && prevIRAPSubpicPOC != bufPic->poc)\par
01280       \{\par
01281         CHECK(bufPic->poc >= getPOC(), {\cf22 "Any subpicture, with nuh_layer_id equal to a particular value layerId and subpicture index equal to a particular value subpicIdx, that "}\par
01282           {\cf22 "precedes, in decoding order, an IRAP subpicture with nuh_layer_id equal to layerId and subpicture index equal to subpicIdx shall precede, in output order, all "}\par
01283           {\cf22 "its associated RADL subpictures"});\par
01284       \}\par
01285 \par
01286       {\cf19 if} ((getPOC() == getPicHeader()->getRecoveryPocCnt() + prevGDRSubpicPOC) && !this->getNoOutputOfPriorPicsFlag() && isBufPicOutput == 1 &&\par
01287         bufPic->layerId == m_nuhLayerId && nalUnitType != NAL_UNIT_CODED_SLICE_GDR && getPicHeader()->getRecoveryPocCnt() != -1)\par
01288       \{\par
01289         CHECK(bufPic->poc >= getPOC(), {\cf22 "Any subpicture, with nuh_layer_id equal to a particular value layerId and subpicture index equal to a particular value subpicIdx, that "}\par
01290           {\cf22 "precedes, in decoding order, a subpicture with nuh_layer_id equal to layerId and subpicture index equal to subpicIdx in a recovery point picture shall precede "}\par
01291           {\cf22 "that subpicture in the recovery point picture in output order"});\par
01292       \}\par
01293 \par
01294       {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RASL && prevIRAPSubpicType == NAL_UNIT_CODED_SLICE_CRA && bufSubpicType == NAL_UNIT_CODED_SLICE_RADL &&\par
01295         prevIRAPSubpicPOC == bufSubpicPrevIRAPSubpicPOC)\par
01296       \{\par
01297         CHECK(bufPic->poc <= getPOC(), {\cf22 "Any RASL subpicture associated with a CRA subpicture shall precede any RADL subpicture associated with the CRA subpicture in output order"});\par
01298       \}\par
01299 \par
01300       {\cf19 if} (nalUnitType == NAL_UNIT_CODED_SLICE_RASL && prevIRAPSubpicType == NAL_UNIT_CODED_SLICE_CRA && bufPic->layerId == m_nuhLayerId && bufPic->poc < prevIRAPSubpicPOC)\par
01301       \{\par
01302         {\cf19 if} (bufSubpicType == NAL_UNIT_CODED_SLICE_IDR_N_LP || bufSubpicType == NAL_UNIT_CODED_SLICE_IDR_W_RADL ||\par
01303           bufSubpicType == NAL_UNIT_CODED_SLICE_CRA || bufSubpicType == NAL_UNIT_CODED_SLICE_GDR)\par
01304         \{\par
01305           CHECK(bufPic->poc >= getPOC(), {\cf22 "Any RASL subpicture, with nuh_layer_id equal to a particular value layerId and subpicture index equal to a particular value subpicIdx, "}\par
01306             {\cf22 "associated with a CRA subpicture shall follow, in output order, any IRAP or GDR subpicture , with nuh_layer_id equal to layerId and subpicture index equal to "}\par
01307             {\cf22 "subpicIdx, that precedes the CRA subpicture in decoding order"});\par
01308         \}\par
01309       \}\par
01310 \par
01311       {\cf19 if} ((nalUnitType == NAL_UNIT_CODED_SLICE_RASL || nalUnitType == NAL_UNIT_CODED_SLICE_RADL) &&\par
01312         bufSubpicType != NAL_UNIT_CODED_SLICE_RASL && bufSubpicType != NAL_UNIT_CODED_SLICE_RADL &&\par
01313         bufSubpicPrevIRAPSubpicPOC == prevIRAPSubpicPOC && bufPic->layerId == m_nuhLayerId)\par
01314       \{\par
01315         numNonLeadingPic++;\par
01316         {\cf18 int} th = bufPic->cs->sps->getFieldSeqFlag() ? 1 : 0;\par
01317         CHECK(bufPic->poc > prevIRAPSubpicPOC && numNonLeadingPic > th, {\cf22 "If sps_field_seq_flag is equal to 0 and the current subpicture, with nuh_layer_id equal to a particular value "}\par
