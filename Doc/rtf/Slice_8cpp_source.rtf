00580         {\cf17 const} Picture *ltrp =\par
00581           xGetLongTermRefPic(rcListPic, ltrpPoc, pRPL0->getDeltaPocMSBPresentFlag(i), m_pcPic->layerId);\par
00582         CHECK(ltrp == {\cf17 nullptr}, {\cf22 "Long-term pic not found"});\par
00583         CHECK(ltrp->getPOC() < pocCRA, {\cf22 "Invalid state"});\par
00584       \}\par
00585     \}\par
00586     numRefPic = pRPL1->getNumberOfShorttermPictures() + pRPL1->getNumberOfLongtermPictures();\par
00587     {\cf19 for} ({\cf18 int} i = 0; i < numRefPic; i++)\par
00588     \{\par
00589       {\cf19 if} (!pRPL1->isRefPicLongterm(i))\par
00590       \{\par
00591         CHECK(getPOC() + pRPL1->getRefPicIdentifier(i) < pocCRA, {\cf22 "Invalid state"});\par
00592       \}\par
00593       {\cf19 else} {\cf19 if}( !pRPL1->isInterLayerRefPic( i ) )\par
00594       \{\par
00595         {\cf18 int} pocBits = getSPS()->getBitsForPOC();\par
00596         {\cf18 int} pocMask = (1 << pocBits) - 1;\par
00597         {\cf18 int} ltrpPoc = pRPL1->getRefPicIdentifier(i) & pocMask;\par
00598         {\cf19 if}(pRPL1->getDeltaPocMSBPresentFlag(i))\par
00599         \{\par
00600           ltrpPoc += getPOC() - pRPL1->getDeltaPocMSBCycleLT(i) * (pocMask + 1) - (getPOC() & pocMask);\par
00601         \}\par
00602         {\cf17 const} Picture *ltrp =\par
00603           xGetLongTermRefPic(rcListPic, ltrpPoc, pRPL1->getDeltaPocMSBPresentFlag(i), m_pcPic->layerId);\par
00604         CHECK(ltrp == {\cf17 nullptr}, {\cf22 "Long-term pic not found"});\par
00605         CHECK(ltrp->getPOC() < pocCRA, {\cf22 "Invalid state"});\par
00606       \}\par
00607     \}\par
00608   \}\par
00609 \}\par
