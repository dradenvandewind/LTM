03272 {\cf18 void} PPS::initRectSliceMap({\cf17 const} SPS  *sps)\par
03273 \{\par
03274   uint32_t  ctuY;\par
03275   uint32_t  tileX, tileY;\par
03276 \par
03277   {\cf19 if} (sps)\par
03278   \{\par
03279     m_ctuToSubPicIdx.resize(getPicWidthInCtu() * getPicHeightInCtu());\par
03280     {\cf19 if} (sps->getNumSubPics() > 1)\par
03281     \{\par
03282       {\cf19 for} ({\cf18 int} i = 0; i <= sps->getNumSubPics() - 1; i++)\par
03283       \{\par
03284         {\cf19 for} ({\cf18 int} y = sps->getSubPicCtuTopLeftY(i); y < sps->getSubPicCtuTopLeftY(i) + sps->getSubPicHeight(i); y++)\par
03285         \{\par
03286           {\cf19 for} ({\cf18 int} x = sps->getSubPicCtuTopLeftX(i); x < sps->getSubPicCtuTopLeftX(i) + sps->getSubPicWidth(i); x++)\par
03287           \{\par
03288             m_ctuToSubPicIdx[ x+ y * getPicWidthInCtu()] = i;\par
03289           \}\par
03290         \}\par
03291       \}\par
03292     \}\par
03293     {\cf19 else}\par
03294     \{\par
03295       {\cf19 for} ({\cf18 int} i = 0; i < getPicWidthInCtu() * getPicHeightInCtu(); i++)\par
03296       \{\par
03297         m_ctuToSubPicIdx[i] = 0;\par
03298       \}\par
03299     \}\par
03300   \}\par
03301 \par
03302   {\cf19 if}( getSingleSlicePerSubPicFlag() )\par
03303   \{\par
03304     CHECK (sps=={\cf17 nullptr}, {\cf22 "RectSliceMap can only be initialized for slice_per_sub_pic_flag with a valid SPS"});\par
03305     m_numSlicesInPic = sps->getNumSubPics();\par
03306 \par
03307     {\cf20 // allocate new memory for slice list}\par
03308     CHECK(m_numSlicesInPic > MAX_SLICES, {\cf22 "Number of slices in picture exceeds valid range"});\par
03309     m_sliceMap.resize( m_numSlicesInPic );\par
03310 \par
03311     {\cf19 if} (sps->getNumSubPics() > 1)\par
03312     \{\par
03313       {\cf20 // Q2001 v15 equation 29}\par
03314       std::vector<uint32_t> subpicWidthInTiles;\par
03315       std::vector<uint32_t> subpicHeightInTiles;\par
03316       std::vector<uint32_t> subpicHeightLessThanOneTileFlag;\par
03317       subpicWidthInTiles.resize(sps->getNumSubPics());\par
03318       subpicHeightInTiles.resize(sps->getNumSubPics());\par
03319       subpicHeightLessThanOneTileFlag.resize(sps->getNumSubPics());\par
03320       {\cf19 for} (uint32_t i = 0; i <sps->getNumSubPics(); i++)\par
03321       \{\par
03322         uint32_t leftX = sps->getSubPicCtuTopLeftX(i);\par
03323         uint32_t rightX = leftX + sps->getSubPicWidth(i) - 1;\par
03324         subpicWidthInTiles[i] = m_ctuToTileCol[rightX] + 1 - m_ctuToTileCol[leftX];\par
03325 \par
03326         uint32_t topY = sps->getSubPicCtuTopLeftY(i);\par
03327         uint32_t bottomY = topY + sps->getSubPicHeight(i) - 1;\par
03328         subpicHeightInTiles[i] = m_ctuToTileRow[bottomY] + 1 - m_ctuToTileRow[topY];\par
03329 \par
03330         {\cf19 if} (subpicHeightInTiles[i] == 1 && sps->getSubPicHeight(i) < m_tileRowHeight[m_ctuToTileRow[topY]] )\par
03331         \{\par
03332           subpicHeightLessThanOneTileFlag[i] = 1;\par
03333         \}\par
03334         {\cf19 else}\par
03335         \{\par
03336           subpicHeightLessThanOneTileFlag[i] = 0;\par
03337         \}\par
03338       \}\par
03339 \par
03340       {\cf19 for}( {\cf18 int} i = 0; i < m_numSlicesInPic; i++ )\par
03341       \{\par
03342         CHECK(m_numSlicesInPic != sps->getNumSubPics(), {\cf22 "in single slice per subpic mode, number of slice and subpic shall be equal"});\par
03343         m_sliceMap[ i ].initSliceMap();\par
03344         {\cf19 if} (subpicHeightLessThanOneTileFlag[i])\par
03345         \{\par
03346           m_sliceMap[i].addCtusToSlice(sps->getSubPicCtuTopLeftX(i), sps->getSubPicCtuTopLeftX(i) + sps->getSubPicWidth(i),\par
03347                                        sps->getSubPicCtuTopLeftY(i), sps->getSubPicCtuTopLeftY(i) + sps->getSubPicHeight(i), m_picWidthInCtu);\par
03348         \}\par
03349         {\cf19 else}\par
03350         \{\par
03351           tileX = m_ctuToTileCol[sps->getSubPicCtuTopLeftX(i)];\par
03352           tileY = m_ctuToTileRow[sps->getSubPicCtuTopLeftY(i)];\par
03353           {\cf19 for} (uint32_t j = 0; j< subpicHeightInTiles[i]; j++)\par
03354           \{\par
03355             {\cf19 for} (uint32_t k = 0; k < subpicWidthInTiles[i]; k++)\par
03356             \{\par
03357               m_sliceMap[i].addCtusToSlice(getTileColumnBd(tileX + k), getTileColumnBd(tileX + k + 1), getTileRowBd(tileY + j), getTileRowBd(tileY + j + 1), m_picWidthInCtu);\par
03358             \}\par
03359           \}\par
03360         \}\par
03361       \}\par
03362       subpicWidthInTiles.clear();\par
03363       subpicHeightInTiles.clear();\par
03364       subpicHeightLessThanOneTileFlag.clear();\par
03365     \}\par
03366     {\cf19 else}\par
03367     \{\par
03368       m_sliceMap[0].initSliceMap();\par
03369       {\cf19 for} ({\cf18 int} tileY=0; tileY<m_numTileRows; tileY++)\par
03370       \{\par
03371         {\cf19 for} ({\cf18 int} tileX=0; tileX<m_numTileCols; tileX++)\par
03372         \{\par
03373           m_sliceMap[0].addCtusToSlice(getTileColumnBd(tileX), getTileColumnBd(tileX + 1),\par
03374                                        getTileRowBd(tileY), getTileRowBd(tileY + 1), m_picWidthInCtu);\par
03375         \}\par
03376       \}\par
03377       m_sliceMap[0].setSliceID(0);\par
03378     \}\par
03379   \}\par
03380   {\cf19 else}\par
03381   \{\par
03382     {\cf20 // allocate new memory for slice list}\par
03383     CHECK(m_numSlicesInPic > MAX_SLICES, {\cf22 "Number of slices in picture exceeds valid range"});\par
03384     m_sliceMap.resize( m_numSlicesInPic );\par
03385     {\cf20 // generate CTU maps for all rectangular slices in picture}\par
03386     {\cf19 for}( uint32_t i = 0; i < m_numSlicesInPic; i++ )\par
03387     \{\par
03388       m_sliceMap[ i ].initSliceMap();\par
03389 \par
03390       {\cf20 // get position of first tile in slice}\par
03391       tileX =  m_rectSlices[ i ].getTileIdx() % m_numTileCols;\par
03392       tileY =  m_rectSlices[ i ].getTileIdx() / m_numTileCols;\par
03393 \par
03394       {\cf20 // infer slice size for last slice in picture}\par
03395       {\cf19 if}( i == m_numSlicesInPic-1 )\par
03396       \{\par
03397         m_rectSlices[ i ].setSliceWidthInTiles ( m_numTileCols - tileX );\par
03398         m_rectSlices[ i ].setSliceHeightInTiles( m_numTileRows - tileY );\par
03399         m_rectSlices[ i ].setNumSlicesInTile( 1 );\par
03400       \}\par
03401 \par
03402       {\cf20 // set slice index}\par
03403       m_sliceMap[ i ].setSliceID(i);\par
03404 \par
03405       {\cf20 // complete tiles within a single slice case}\par
03406       {\cf19 if}( m_rectSlices[ i ].getSliceWidthInTiles( ) > 1 || m_rectSlices[ i ].getSliceHeightInTiles( ) > 1)\par
03407       \{\par
03408         {\cf19 for}( uint32_t j = 0; j < m_rectSlices[ i ].getSliceHeightInTiles( ); j++ )\par
03409         \{\par
03410           {\cf19 for}( uint32_t k = 0; k < m_rectSlices[ i ].getSliceWidthInTiles( ); k++ )\par
03411           \{\par
03412             m_sliceMap[ i ].addCtusToSlice( getTileColumnBd(tileX + k), getTileColumnBd(tileX + k +1),\par
03413                                             getTileRowBd(tileY + j), getTileRowBd(tileY + j +1), m_picWidthInCtu);\par
03414           \}\par
03415         \}\par
03416       \}\par
03417       {\cf20 // multiple slices within a single tile case}\par
03418       {\cf19 else}\par
03419       \{\par
03420         uint32_t  numSlicesInTile = m_rectSlices[ i ].getNumSlicesInTile( );\par
03421 \par
03422         ctuY = getTileRowBd( tileY );\par
03423         {\cf19 for}( uint32_t j = 0; j < numSlicesInTile-1; j++ )\par
03424         \{\par
03425           m_sliceMap[ i ].addCtusToSlice( getTileColumnBd(tileX), getTileColumnBd(tileX+1),\par
03426                                           ctuY, ctuY + m_rectSlices[ i ].getSliceHeightInCtu(), m_picWidthInCtu);\par
03427           ctuY += m_rectSlices[ i ].getSliceHeightInCtu();\par
03428           i++;\par
03429           m_sliceMap[ i ].initSliceMap();\par
03430           m_sliceMap[ i ].setSliceID(i);\par
03431         \}\par
03432 \par
03433         {\cf20 // infer slice height for last slice in tile}\par
03434         CHECK( ctuY >= getTileRowBd( tileY + 1 ), {\cf22 "Invalid rectangular slice signalling"});\par
03435         m_rectSlices[ i ].setSliceHeightInCtu( getTileRowBd( tileY + 1 ) - ctuY );\par
03436         m_sliceMap[ i ].addCtusToSlice( getTileColumnBd(tileX), getTileColumnBd(tileX+1),\par
03437                                         ctuY, getTileRowBd( tileY + 1 ), m_picWidthInCtu);\par
03438       \}\par
03439     \}\par
03440   \}\par
03441   {\cf20 // check for valid rectangular slice map}\par
03442   checkSliceMap();\par
03443 \}\par
