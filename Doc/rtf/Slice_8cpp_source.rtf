02275 {\cf18 void} VPS::deriveOutputLayerSets()\par
02276 \{\par
02277   {\cf19 if}( m_vpsEachLayerIsAnOlsFlag || m_vpsOlsModeIdc < 2 )\par
02278   \{\par
02279     m_totalNumOLSs = m_maxLayers;\par
02280   \}\par
02281   {\cf19 else} {\cf19 if}( m_vpsOlsModeIdc == 2 )\par
02282   \{\par
02283     m_totalNumOLSs = m_vpsNumOutputLayerSets;\par
02284   \}\par
02285 \par
02286   m_olsDpbParamsIdx.resize( m_totalNumOLSs );\par
02287   m_olsDpbPicSize.resize( m_totalNumOLSs, Size(0, 0) );\par
02288   m_numOutputLayersInOls.resize( m_totalNumOLSs );\par
02289   m_numLayersInOls.resize( m_totalNumOLSs );\par
02290   m_outputLayerIdInOls.resize( m_totalNumOLSs, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02291   m_numSubLayersInLayerInOLS.resize( m_totalNumOLSs, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02292   m_layerIdInOls.resize( m_totalNumOLSs, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02293   m_olsDpbChromaFormatIdc.resize(m_totalNumOLSs);\par
02294   m_olsDpbBitDepthMinus8.resize(m_totalNumOLSs);\par
02295 \par
02296   std::vector<int> numRefLayers( m_maxLayers );\par
02297   std::vector<std::vector<int>> outputLayerIdx( m_totalNumOLSs, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02298   std::vector<std::vector<int>> layerIncludedInOlsFlag( m_totalNumOLSs, std::vector<int>( m_maxLayers, 0 ) );\par
02299   std::vector<std::vector<int>> dependencyFlag( m_maxLayers, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02300   std::vector<std::vector<int>> refLayerIdx( m_maxLayers, std::vector<int>( m_maxLayers, NOT_VALID ) );\par
02301   std::vector<int> layerUsedAsRefLayerFlag( m_maxLayers, 0 );\par
02302   std::vector<int> layerUsedAsOutputLayerFlag( m_maxLayers, NOT_VALID );\par
02303 \par
02304   {\cf19 for}( {\cf18 int} i = 0; i < m_maxLayers; i++ )\par
02305   \{\par
02306     {\cf18 int} r = 0;\par
02307 \par
02308     {\cf19 for}( {\cf18 int} j = 0; j < m_maxLayers; j++ )\par
02309     \{\par
02310       dependencyFlag[i][j] = m_vpsDirectRefLayerFlag[i][j];\par
02311 \par
02312       {\cf19 for}( {\cf18 int} k = 0; k < i; k++ )\par
02313       \{\par
02314         {\cf19 if}( m_vpsDirectRefLayerFlag[i][k] && dependencyFlag[k][j] )\par
02315         \{\par
02316           dependencyFlag[i][j] = 1;\par
02317         \}\par
02318       \}\par
02319       {\cf19 if} (m_vpsDirectRefLayerFlag[i][j])\par
02320       \{\par
02321         layerUsedAsRefLayerFlag[j] = 1;\par
02322       \}\par
02323 \par
02324       {\cf19 if}( dependencyFlag[i][j] )\par
02325       \{\par
02326         refLayerIdx[i][r++] = j;\par
02327       \}\par
02328     \}\par
02329 \par
02330     numRefLayers[i] = r;\par
02331   \}\par
02332 \par
02333   m_numOutputLayersInOls[0] = 1;\par
02334   m_outputLayerIdInOls[0][0] = m_vpsLayerId[0];\par
02335 {\cf21 #if JVET_R0193_S0141}\par
02336   m_numSubLayersInLayerInOLS[0][0] = m_ptlMaxTemporalId[m_olsPtlIdx[0]] + 1;\par
02337 {\cf21 #else}\par
02338   m_numSubLayersInLayerInOLS[0][0] = m_vpsMaxSubLayers;\par
02339 {\cf21 #endif}\par
02340   layerUsedAsOutputLayerFlag[0] = 1;\par
02341   {\cf19 for} ({\cf18 int} i = 1; i < m_maxLayers; i++)\par
02342   \{\par
02343     {\cf19 if} (m_vpsEachLayerIsAnOlsFlag || m_vpsOlsModeIdc < 2)\par
02344     \{\par
02345       layerUsedAsOutputLayerFlag[i] = 1;\par
02346     \}\par
02347     {\cf19 else}\par
02348     \{\par
02349       layerUsedAsOutputLayerFlag[i] = 0;\par
02350     \}\par
02351   \}\par
02352   {\cf19 for}( {\cf18 int} i = 1; i < m_totalNumOLSs; i++ )\par
02353   \{\par
02354     {\cf19 if}( m_vpsEachLayerIsAnOlsFlag || m_vpsOlsModeIdc == 0 )\par
02355     \{\par
02356       m_numOutputLayersInOls[i] = 1;\par
02357       m_outputLayerIdInOls[i][0] = m_vpsLayerId[i];\par
02358 {\cf21 #if JVET_R0193_S0141}\par
02359       {\cf19 if} (m_vpsEachLayerIsAnOlsFlag)\par
02360       \{\par
02361         m_numSubLayersInLayerInOLS[i][0] = m_ptlMaxTemporalId[m_olsPtlIdx[i]] + 1;\par
02362       \}\par
02363       {\cf19 else}\par
02364       \{\par
02365         m_numSubLayersInLayerInOLS[i][i] = m_ptlMaxTemporalId[m_olsPtlIdx[i]] + 1;\par
02366         {\cf19 for} ({\cf18 int} k = i - 1; k >= 0; k--)\par
02367         \{\par
02368           m_numSubLayersInLayerInOLS[i][k] = 0;\par
02369           {\cf19 for} ({\cf18 int} m = k + 1; m <= i; m++)\par
02370           \{\par
02371             uint32_t maxSublayerNeeded = std::min((uint32_t)m_numSubLayersInLayerInOLS[i][m], m_vpsMaxTidIlRefPicsPlus1[m][k]);\par
02372             {\cf19 if} (m_vpsDirectRefLayerFlag[m][k] && m_numSubLayersInLayerInOLS[i][k] < maxSublayerNeeded)\par
02373             \{\par
02374               m_numSubLayersInLayerInOLS[i][k] = maxSublayerNeeded;\par
02375             \}\par
02376           \}\par
02377       \}\par
02378       \}\par
02379 {\cf21 #else}\par
02380       {\cf19 for}({\cf18 int}  j = 0; j < i  &&  ( m_vpsOlsModeIdc  ==  0 ); j++ )\par
02381       \{\par
02382         m_numSubLayersInLayerInOLS[i][j] = m_vpsMaxTidIlRefPicsPlus1[i];\par
02383       \}\par
02384       m_numSubLayersInLayerInOLS[i][i] = m_vpsMaxSubLayers;\par
02385 {\cf21 #endif}\par
02386     \}\par
02387     {\cf19 else} {\cf19 if}( m_vpsOlsModeIdc == 1 )\par
02388     \{\par
02389       m_numOutputLayersInOls[i] = i + 1;\par
02390 \par
02391       {\cf19 for}( {\cf18 int} j = 0; j < m_numOutputLayersInOls[i]; j++ )\par
02392       \{\par
02393         m_outputLayerIdInOls[i][j] = m_vpsLayerId[j];\par
02394 {\cf21 #if JVET_R0193_S0141}\par
02395         m_numSubLayersInLayerInOLS[i][j] = m_ptlMaxTemporalId[m_olsPtlIdx[i]] + 1;\par
02396 {\cf21 #else}\par
02397         m_numSubLayersInLayerInOLS[i][j] = m_vpsMaxSubLayers;\par
02398 {\cf21 #endif}\par
02399       \}\par
02400     \}\par
02401     {\cf19 else} {\cf19 if}( m_vpsOlsModeIdc == 2 )\par
02402     \{\par
02403       {\cf18 int} j = 0;\par
02404 {\cf21 #if JVET_R0193}\par
02405       {\cf18 int} highestIncludedLayer = 0;\par
02406 {\cf21 #endif}\par
02407       {\cf19 for}( j = 0; j  <  m_maxLayers; j++ )\par
02408       \{\par
02409         m_numSubLayersInLayerInOLS[i][j] = 0;\par
02410       \}\par
02411       j = 0;\par
02412       {\cf19 for}( {\cf18 int} k = 0; k < m_maxLayers; k++ )\par
02413       \{\par
02414         {\cf19 if}( m_vpsOlsOutputLayerFlag[i][k] )\par
02415         \{\par
02416           layerIncludedInOlsFlag[i][k] = 1;\par
02417 {\cf21 #if JVET_R0193}\par
02418           highestIncludedLayer = k;\par
02419 {\cf21 #endif}\par
02420           layerUsedAsOutputLayerFlag[k] = 1;\par
02421           outputLayerIdx[i][j] = k;\par
02422           m_outputLayerIdInOls[i][j++] = m_vpsLayerId[k];\par
02423 {\cf21 #if JVET_R0193_S0141}\par
02424           m_numSubLayersInLayerInOLS[i][k] = m_ptlMaxTemporalId[m_olsPtlIdx[i]] + 1;\par
02425 {\cf21 #else}\par
02426           m_numSubLayersInLayerInOLS[i][k] = m_vpsMaxSubLayers;\par
02427 {\cf21 #endif}\par
02428         \}\par
02429       \}\par
02430       m_numOutputLayersInOls[i] = j;\par
02431 \par
02432       {\cf19 for}( j = 0; j < m_numOutputLayersInOls[i]; j++ )\par
02433       \{\par
02434         {\cf18 int} idx = outputLayerIdx[i][j];\par
02435         {\cf19 for}( {\cf18 int} k = 0; k < numRefLayers[idx]; k++ )\par
02436         \{\par
02437           layerIncludedInOlsFlag[i][refLayerIdx[idx][k]] = 1;\par
02438 {\cf21 #if !JVET_R0193}\par
02439           {\cf19 if}( m_numSubLayersInLayerInOLS[i][ refLayerIdx[idx][k] ] < m_vpsMaxTidIlRefPicsPlus1[ m_outputLayerIdInOls[i][j] ] )\par
02440           \{\par
02441             m_numSubLayersInLayerInOLS[i][ refLayerIdx[idx][k] ] =  m_vpsMaxTidIlRefPicsPlus1[ m_outputLayerIdInOls[i][j] ];\par
02442           \}\par
02443 {\cf21 #endif}\par
02444         \}\par
02445       \}\par
02446 {\cf21 #if JVET_R0193}\par
02447       {\cf19 for} ({\cf18 int} k = highestIncludedLayer - 1; k >= 0; k--)\par
02448       \{\par
02449         {\cf19 if} (layerIncludedInOlsFlag[i][k] && !m_vpsOlsOutputLayerFlag[i][k])\par
02450         \{\par
02451           {\cf19 for} ({\cf18 int} m = k + 1; m <= highestIncludedLayer; m++)\par
02452           \{\par
02453             uint32_t maxSublayerNeeded = std::min((uint32_t)m_numSubLayersInLayerInOLS[i][m], m_vpsMaxTidIlRefPicsPlus1[m][k]);\par
02454             {\cf19 if} (m_vpsDirectRefLayerFlag[m][k] && layerIncludedInOlsFlag[i][m] && m_numSubLayersInLayerInOLS[i][k] < maxSublayerNeeded)\par
02455             \{\par
02456               m_numSubLayersInLayerInOLS[i][k] = maxSublayerNeeded;\par
02457             \}\par
02458           \}\par
02459         \}\par
02460       \}\par
02461 {\cf21 #endif}\par
02462     \}\par
02463   \}\par
02464   {\cf19 for} ({\cf18 int} i = 0; i < m_maxLayers; i++)\par
02465   \{\par
02466     CHECK(layerUsedAsRefLayerFlag[i] == 0 && layerUsedAsOutputLayerFlag[i] == 0, {\cf22 "There shall be no layer that is neither an output layer nor a direct reference layer"});\par
02467   \}\par
02468 \par
02469   m_numLayersInOls[0] = 1;\par
02470   m_layerIdInOls[0][0] = m_vpsLayerId[0];\par
02471   m_numMultiLayeredOlss = 0;\par
02472   {\cf19 for}( {\cf18 int} i = 1; i < m_totalNumOLSs; i++ )\par
02473   \{\par
02474     {\cf19 if}( m_vpsEachLayerIsAnOlsFlag )\par
02475     \{\par
02476       m_numLayersInOls[i] = 1;\par
02477       m_layerIdInOls[i][0] = m_vpsLayerId[i];\par
02478     \}\par
02479     {\cf19 else} {\cf19 if}( m_vpsOlsModeIdc == 0 || m_vpsOlsModeIdc == 1 )\par
02480     \{\par
02481       m_numLayersInOls[i] = i + 1;\par
02482       {\cf19 for}( {\cf18 int} j = 0; j < m_numLayersInOls[i]; j++ )\par
02483       \{\par
02484         m_layerIdInOls[i][j] = m_vpsLayerId[j];\par
02485       \}\par
02486     \}\par
02487     {\cf19 else} {\cf19 if}( m_vpsOlsModeIdc == 2 )\par
02488     \{\par
02489       {\cf18 int} j = 0;\par
02490       {\cf19 for}( {\cf18 int} k = 0; k < m_maxLayers; k++ )\par
02491       \{\par
02492         {\cf19 if}( layerIncludedInOlsFlag[i][k] )\par
02493         \{\par
02494           m_layerIdInOls[i][j++] = m_vpsLayerId[k];\par
02495         \}\par
02496       \}\par
02497 \par
02498       m_numLayersInOls[i] = j;\par
02499     \}\par
02500     {\cf19 if}( m_numLayersInOls[i] > 1 )\par
02501     \{\par
02502       m_multiLayerOlsIdx[i] = m_numMultiLayeredOlss;\par
02503       m_numMultiLayeredOlss++;\par
02504     \}\par
02505   \}\par
02506   m_multiLayerOlsIdxToOlsIdx.resize(m_numMultiLayeredOlss);\par
02507 \par
02508   {\cf19 for} ({\cf18 int} i=0, j=0; i<m_totalNumOLSs; i++)\par
02509   \{\par
02510     {\cf19 if} (m_numLayersInOls[i] > 1)\par
02511     \{\par
02512       m_multiLayerOlsIdxToOlsIdx[j] = i;\par
02513     \}\par
02514   \}\par
02515 \}\par
