00735 {\cf18 void} Slice::checkSTSA(PicList& rcListPic)\par
00736 \{\par
00737   {\cf18 int} ii;\par
00738   Picture* pcRefPic = NULL;\par
00739   {\cf18 int} numOfActiveRef = getNumRefIdx(REF_PIC_LIST_0);\par
00740 \par
00741   {\cf19 for} (ii = 0; ii < numOfActiveRef; ii++)\par
00742   \{\par
00743     pcRefPic = m_apcRefPicList[REF_PIC_LIST_0][ii];\par
00744 \par
00745     {\cf19 if}( m_eNalUnitType == NAL_UNIT_CODED_SLICE_STSA && pcRefPic->layerId == m_pcPic->layerId )\par
00746     \{\par
00747       CHECK( pcRefPic->temporalId == m_uiTLayer, {\cf22 "When the current picture is an STSA picture and nuh_layer_id equal to that of the current picture, there shall be no active entry in the RPL that has TemporalId equal to that of the current picture"} );\par
00748     \}\par
00749 \par
00750     {\cf20 // Checking this: "When the current picture is a picture that follows, in decoding order, an STSA picture that has TemporalId equal to that of the current picture, there shall be no}\par
00751     {\cf20 // picture that has TemporalId equal to that of the current picture included as an active entry in RefPicList[ 0 ] or RefPicList[ 1 ] that precedes the STSA picture in decoding order."}\par
00752     CHECK(pcRefPic->subLayerNonReferencePictureDueToSTSA, {\cf22 "The RPL of the current picture contains a picture that is not allowed in this temporal layer due to an earlier STSA picture"});\par
00753   \}\par
00754 \par
00755   numOfActiveRef = getNumRefIdx(REF_PIC_LIST_1);\par
00756   {\cf19 for} (ii = 0; ii < numOfActiveRef; ii++)\par
00757   \{\par
00758     pcRefPic = m_apcRefPicList[REF_PIC_LIST_1][ii];\par
00759 \par
00760     {\cf19 if}( m_eNalUnitType == NAL_UNIT_CODED_SLICE_STSA && pcRefPic->layerId == m_pcPic->layerId )\par
00761     \{\par
00762       CHECK( pcRefPic->temporalId == m_uiTLayer, {\cf22 "When the current picture is an STSA picture and nuh_layer_id equal to that of the current picture, there shall be no active entry in the RPL that has TemporalId equal to that of the current picture"} );\par
00763     \}\par
00764 \par
00765     {\cf20 // Checking this: "When the current picture is a picture that follows, in decoding order, an STSA picture that has TemporalId equal to that of the current picture, there shall be no}\par
00766     {\cf20 // picture that has TemporalId equal to that of the current picture included as an active entry in RefPicList[ 0 ] or RefPicList[ 1 ] that precedes the STSA picture in decoding order."}\par
00767     CHECK(pcRefPic->subLayerNonReferencePictureDueToSTSA, {\cf22 "The active RPL part of the current picture contains a picture that is not allowed in this temporal layer due to an earlier STSA picture"});\par
00768   \}\par
00769 \par
00770   {\cf20 // If the current picture is an STSA picture, make all reference pictures in the DPB with temporal}\par
00771   {\cf20 // id equal to the temproal id of the current picture sub-layer non-reference pictures. The flag}\par
00772   {\cf20 // subLayerNonReferencePictureDueToSTSA equal to true means that the picture may not be used for}\par
00773   {\cf20 // reference by a picture that follows the current STSA picture in decoding order}\par
00774   {\cf19 if} (getNalUnitType() == NAL_UNIT_CODED_SLICE_STSA)\par
00775   \{\par
00776     PicList::iterator iterPic = rcListPic.begin();\par
00777     {\cf19 while} (iterPic != rcListPic.end())\par
00778     \{\par
00779       pcRefPic = *(iterPic++);\par
00780       {\cf19 if} (!pcRefPic->referenced || pcRefPic->getPOC() == m_iPOC)\par
00781       \{\par
00782         {\cf19 continue};\par
00783       \}\par
00784 \par
00785       {\cf19 if} (pcRefPic->temporalId == m_uiTLayer)\par
00786       \{\par
00787         pcRefPic->subLayerNonReferencePictureDueToSTSA = {\cf17 true};\par
00788       \}\par
00789     \}\par
00790   \}\par
00791 \}\par
