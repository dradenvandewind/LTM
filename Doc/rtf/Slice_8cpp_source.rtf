00257 {\cf18 void} Slice::setNumSubstream({\cf17 const} SPS* sps, {\cf17 const} PPS* pps)\par
00258 \{\par
00259   uint32_t ctuAddr, ctuX, ctuY;\par
00260   m_numSubstream = 0;\par
00261 \par
00262   {\cf20 // count the number of CTUs that align with either the start of a tile, or with an entropy coding sync point}\par
00263   {\cf20 // ignore the first CTU since it doesn't count as an entry point}\par
00264   {\cf19 for} (uint32_t i = 1; i < m_sliceMap.getNumCtuInSlice(); i++)\par
00265   \{\par
00266     ctuAddr = m_sliceMap.getCtuAddrInSlice(i);\par
00267     ctuX    = (ctuAddr % pps->getPicWidthInCtu());\par
00268     ctuY    = (ctuAddr / pps->getPicWidthInCtu());\par
00269 \par
00270     {\cf19 if} (pps->ctuIsTileColBd(ctuX) && (pps->ctuIsTileRowBd(ctuY) || sps->getEntropyCodingSyncEnabledFlag()))\par
00271     \{\par
00272       m_numSubstream++;\par
00273     \}\par
00274   \}\par
00275 \}\par
