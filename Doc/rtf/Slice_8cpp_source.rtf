04273 {\cf18 void} Slice::scaleRefPicList( Picture *scaledRefPic[ ], PicHeader *picHeader, APS** apss, APS* lmcsAps, APS* scalingListAps, {\cf17 const} {\cf18 bool} isDecoder )\par
04274 \{\par
04275   {\cf18 int} i;\par
04276   {\cf17 const} SPS* sps = getSPS();\par
04277   {\cf17 const} PPS* pps = getPPS();\par
04278 \par
04279   {\cf18 bool} refPicIsSameRes = {\cf17 false};\par
04280 \par
04281   {\cf20 // this is needed for IBC}\par
04282   m_pcPic->unscaledPic = m_pcPic;\par
04283 \par
04284   {\cf19 if}( m_eSliceType == I_SLICE )\par
04285   \{\par
04286     {\cf19 return};\par
04287   \}\par
04288 \par
04289   freeScaledRefPicList( scaledRefPic );\par
04290 \par
04291   {\cf19 for}( {\cf18 int} refList = 0; refList < NUM_REF_PIC_LIST_01; refList++ )\par
04292   \{\par
04293     {\cf19 if}( refList == 1 && m_eSliceType != B_SLICE )\par
04294     \{\par
04295       {\cf19 continue};\par
04296     \}\par
04297 \par
04298     {\cf19 for}( {\cf18 int} rIdx = 0; rIdx < m_aiNumRefIdx[refList]; rIdx++ )\par
04299     \{\par
04300       {\cf20 // if rescaling is needed, otherwise just reuse the original picture pointer; it is needed for motion field, otherwise motion field requires a copy as well}\par
04301       {\cf20 // reference resampling for the whole picture is not applied at decoder}\par
04302 \par
04303       {\cf18 int} xScale, yScale;\par
04304       CU::getRprScaling( sps, pps, m_apcRefPicList[refList][rIdx], xScale, yScale );\par
04305       m_scalingRatio[refList][rIdx] = std::pair<int, int>( xScale, yScale );\par
04306 \par
04307       CHECK( m_apcRefPicList[refList][rIdx]->unscaledPic == {\cf17 nullptr}, {\cf22 "unscaledPic is not properly set"} );\par
04308 \par
04309       {\cf19 if}( m_apcRefPicList[refList][rIdx]->isRefScaled( pps ) == {\cf17 false} )\par
04310       \{\par
04311         refPicIsSameRes = {\cf17 true};\par
04312       \}\par
04313 \par
04314       {\cf19 if}( m_scalingRatio[refList][rIdx] == SCALE_1X || isDecoder )\par
04315       \{\par
04316         m_scaledRefPicList[refList][rIdx] = m_apcRefPicList[refList][rIdx];\par
04317       \}\par
04318       {\cf19 else}\par
04319       \{\par
04320         {\cf18 int} poc = m_apcRefPicList[refList][rIdx]->getPOC();\par
04321         {\cf18 int} layerId = m_apcRefPicList[refList][rIdx]->layerId;\par
04322 \par
04323         {\cf20 // check whether the reference picture has already been scaled}\par
04324         {\cf19 for}( i = 0; i < MAX_NUM_REF; i++ )\par
04325         \{\par
04326           {\cf19 if}( scaledRefPic[i] != {\cf17 nullptr} && scaledRefPic[i]->poc == poc && scaledRefPic[i]->layerId == layerId )\par
04327           \{\par
04328             {\cf19 break};\par
04329           \}\par
04330         \}\par
04331 \par
04332         {\cf19 if}( i == MAX_NUM_REF )\par
04333         \{\par
04334           {\cf18 int} j;\par
04335           {\cf20 // search for unused Picture structure in scaledRefPic}\par
04336           {\cf19 for}( j = 0; j < MAX_NUM_REF; j++ )\par
04337           \{\par
04338             {\cf19 if}( scaledRefPic[j] == {\cf17 nullptr} )\par
04339             \{\par
04340               {\cf19 break};\par
04341             \}\par
04342           \}\par
04343 \par
04344           CHECK( j >= MAX_NUM_REF, {\cf22 "scaledRefPic can not hold all reference pictures!"} );\par
04345 \par
04346           {\cf19 if}( j >= MAX_NUM_REF )\par
04347           \{\par
04348             j = 0;\par
04349           \}\par
04350 \par
04351           {\cf19 if}( scaledRefPic[j] == {\cf17 nullptr} )\par
04352           \{\par
04353             scaledRefPic[j] = {\cf17 new} Picture;\par
04354 \par
04355             scaledRefPic[j]->setBorderExtension( {\cf17 false} );\par
04356             scaledRefPic[j]->reconstructed = {\cf17 false};\par
04357             scaledRefPic[j]->referenced = {\cf17 true};\par
04358 \par
04359             scaledRefPic[j]->finalInit( m_pcPic->cs->vps, *sps, *pps, picHeader, apss, lmcsAps, scalingListAps );\par
04360 \par
04361             scaledRefPic[j]->poc = NOT_VALID;\par
04362 \par
04363             scaledRefPic[j]->create( sps->getChromaFormatIdc(), Size( pps->getPicWidthInLumaSamples(), pps->getPicHeightInLumaSamples() ), sps->getMaxCUWidth(), sps->getMaxCUWidth() + 16, isDecoder, layerId );\par
04364           \}\par
04365 \par
04366           scaledRefPic[j]->poc = poc;\par
04367           scaledRefPic[j]->longTerm = m_apcRefPicList[refList][rIdx]->longTerm;\par
04368 \par
04369           {\cf20 // rescale the reference picture}\par
04370           {\cf17 const} {\cf18 bool} downsampling = m_apcRefPicList[refList][rIdx]->getRecoBuf().Y().width >= scaledRefPic[j]->getRecoBuf().Y().width && m_apcRefPicList[refList][rIdx]->getRecoBuf().Y().height >= scaledRefPic[j]->getRecoBuf().Y().height;\par
04371           Picture::rescalePicture( m_scalingRatio[refList][rIdx],\par
04372                                    m_apcRefPicList[refList][rIdx]->getRecoBuf(), m_apcRefPicList[refList][rIdx]->slices[0]->getPPS()->getScalingWindow(),\par
04373                                    scaledRefPic[j]->getRecoBuf(), pps->getScalingWindow(),\par
04374                                    sps->getChromaFormatIdc(), sps->getBitDepths(), {\cf17 true}, downsampling,\par
04375                                    sps->getHorCollocatedChromaFlag(), sps->getVerCollocatedChromaFlag() );\par
04376           scaledRefPic[j]->unscaledPic = m_apcRefPicList[refList][rIdx];\par
04377           scaledRefPic[j]->extendPicBorder( getPPS() );\par
04378 \par
04379           m_scaledRefPicList[refList][rIdx] = scaledRefPic[j];\par
04380         \}\par
04381         {\cf19 else}\par
04382         \{\par
04383           m_scaledRefPicList[refList][rIdx] = scaledRefPic[i];\par
04384         \}\par
04385       \}\par
04386     \}\par
04387   \}\par
04388 \par
04389   {\cf20 // make the scaled reference picture list as the default reference picture list}\par
04390   {\cf19 for}( {\cf18 int} refList = 0; refList < NUM_REF_PIC_LIST_01; refList++ )\par
04391   \{\par
04392     {\cf19 if}( refList == 1 && m_eSliceType != B_SLICE )\par
04393     \{\par
04394       {\cf19 continue};\par
04395     \}\par
