03448 {\cf18 void} PPS::initSubPic({\cf17 const} SPS &sps)\par
03449 \{\par
03450   {\cf19 if} (getSubPicIdMappingInPpsFlag())\par
03451   \{\par
03452     {\cf20 // When signalled, the number of subpictures has to match in PPS and SPS}\par
03453     CHECK (getNumSubPics() != sps.getNumSubPics(), {\cf22 "pps_num_subpics_minus1 shall be equal to sps_num_subpics_minus1"});\par
03454   \}\par
03455   {\cf19 else}\par
03456   \{\par
03457     {\cf20 // When not signalled  set the numer equal for convenient access}\par
03458     setNumSubPics(sps.getNumSubPics());\par
03459   \}\par
03460 \par
03461   CHECK(getNumSubPics() > MAX_NUM_SUB_PICS, {\cf22 "Number of sub-pictures in picture exceeds valid range"});\par
03462   m_subPics.resize(getNumSubPics());\par
03463 \par
03464   {\cf20 // Check that no subpicture is specified outside of the conformance cropping window}\par
03465   {\cf19 for}({\cf18 int} i = 0; i < sps.getNumSubPics(); i++)\par
03466   \{\par
03467     CHECK( (sps.getSubPicCtuTopLeftX(i) * sps.getCTUSize()) >=\par
03468           (sps.getMaxPicWidthInLumaSamples() - sps.getConformanceWindow().getWindowRightOffset() * SPS::getWinUnitX(sps.getChromaFormatIdc())),\par
03469           {\cf22 "No subpicture can be located completely outside of the conformance cropping window"});\par
03470     CHECK( ((sps.getSubPicCtuTopLeftX(i) + sps.getSubPicWidth(i)) * sps.getCTUSize()) <= (sps.getConformanceWindow().getWindowLeftOffset() * SPS::getWinUnitX(sps.getChromaFormatIdc())),\par
03471           {\cf22 "No subpicture can be located completely outside of the conformance cropping window"} );\par
03472     CHECK( (sps.getSubPicCtuTopLeftY(i) * sps.getCTUSize()) >=\par
03473           (sps.getMaxPicHeightInLumaSamples()  - sps.getConformanceWindow().getWindowBottomOffset() * SPS::getWinUnitY(sps.getChromaFormatIdc())),\par
03474           {\cf22 "No subpicture can be located completely outside of the conformance cropping window"});\par
03475     CHECK( ((sps.getSubPicCtuTopLeftY(i) + sps.getSubPicHeight(i)) * sps.getCTUSize()) <= (sps.getConformanceWindow().getWindowTopOffset() * SPS::getWinUnitY(sps.getChromaFormatIdc())),\par
03476           {\cf22 "No subpicture can be located completely outside of the conformance cropping window"});\par
03477   \}\par
03478 \par
03479   {\cf20 // m_ctuSize,  m_picWidthInCtu, and m_picHeightInCtu might not be initialized yet.}\par
03480   {\cf19 if} (m_ctuSize == 0 || m_picWidthInCtu == 0 || m_picHeightInCtu == 0)\par
03481   \{\par
03482     m_ctuSize = sps.getCTUSize();\par
03483     m_picWidthInCtu = (m_picWidthInLumaSamples + m_ctuSize - 1) / m_ctuSize;\par
03484     m_picHeightInCtu = (m_picHeightInLumaSamples + m_ctuSize - 1) / m_ctuSize;\par
03485   \}\par
03486   {\cf19 for} ({\cf18 int} i=0; i< getNumSubPics(); i++)\par
03487   \{\par
03488     m_subPics[i].setSubPicIdx(i);\par
03489     {\cf19 if}(sps.getSubPicIdMappingExplicitlySignalledFlag())\par
03490     \{\par
03491       {\cf19 if}(m_subPicIdMappingInPpsFlag)\par
03492       \{\par
03493         m_subPics[i].setSubPicID(m_subPicId[i]);\par
03494       \}\par
03495       {\cf19 else}\par
03496       \{\par
03497         m_subPics[i].setSubPicID(sps.getSubPicId(i));\par
03498       \}\par
03499     \}\par
03500     {\cf19 else}\par
03501     \{\par
03502       m_subPics[i].setSubPicID(i);\par
03503     \}\par
03504     m_subPics[i].setSubPicCtuTopLeftX(sps.getSubPicCtuTopLeftX(i));\par
03505     m_subPics[i].setSubPicCtuTopLeftY(sps.getSubPicCtuTopLeftY(i));\par
03506     m_subPics[i].setSubPicWidthInCTUs(sps.getSubPicWidth(i));\par
03507     m_subPics[i].setSubPicHeightInCTUs(sps.getSubPicHeight(i));\par
03508 \par
03509     uint32_t firstCTU = sps.getSubPicCtuTopLeftY(i) * m_picWidthInCtu + sps.getSubPicCtuTopLeftX(i);    \par
03510     m_subPics[i].setFirstCTUInSubPic(firstCTU);\par
03511     uint32_t lastCTU = (sps.getSubPicCtuTopLeftY(i) + sps.getSubPicHeight(i) - 1) * m_picWidthInCtu + sps.getSubPicCtuTopLeftX(i) + sps.getSubPicWidth(i) - 1;\par
03512     m_subPics[i].setLastCTUInSubPic(lastCTU);\par
03513 \par
03514     uint32_t left = sps.getSubPicCtuTopLeftX(i) * m_ctuSize;\par
03515     m_subPics[i].setSubPicLeft(left);\par
03516 \par
03517     uint32_t right = std::min(m_picWidthInLumaSamples - 1, (sps.getSubPicCtuTopLeftX(i) + sps.getSubPicWidth(i)) * m_ctuSize - 1);\par
03518     m_subPics[i].setSubPicRight(right);\par
03519 \par
03520     m_subPics[i].setSubPicWidthInLumaSample(right - left + 1);\par
03521 \par
03522     uint32_t top = sps.getSubPicCtuTopLeftY(i) * m_ctuSize;\par
03523     m_subPics[i].setSubPicTop(top);\par
03524 \par
03525     uint32_t bottom = std::min(m_picHeightInLumaSamples - 1, (sps.getSubPicCtuTopLeftY(i) + sps.getSubPicHeight(i)) * m_ctuSize - 1);\par
03526 \par
03527     m_subPics[i].setSubPicHeightInLumaSample(bottom - top + 1);\par
03528 \par
03529     m_subPics[i].setSubPicBottom(bottom);\par
03530 \par
03531     m_subPics[i].clearCTUAddrList();\par
03532 \par
03533     {\cf19 if} (m_numSlicesInPic == 1)\par
03534     \{\par
03535       CHECK(getNumSubPics() != 1, {\cf22 "only one slice in picture, but number of subpic is not one"});\par
03536       m_subPics[i].addAllCtusInPicToSubPic(0, getPicWidthInCtu(), 0, getPicHeightInCtu(), getPicWidthInCtu());\par
03537       m_subPics[i].setNumSlicesInSubPic(1);\par
03538     \}\par
03539     {\cf19 else}\par
03540     \{\par
03541       {\cf18 int} numSlicesInSubPic = 0;\par
03542       {\cf18 int} idxLastSliceInSubpic = -1;\par
03543       {\cf18 int} idxFirstSliceAfterSubpic = m_numSlicesInPic;\par
03544       {\cf19 for} ({\cf18 int} j = 0; j < m_numSlicesInPic; j++)\par
03545       \{\par
03546         uint32_t ctu = m_sliceMap[j].getCtuAddrInSlice(0);\par
03547         uint32_t ctu_x = ctu % m_picWidthInCtu;\par
03548         uint32_t ctu_y = ctu / m_picWidthInCtu;\par
03549         {\cf19 if} (ctu_x >= sps.getSubPicCtuTopLeftX(i) &&\par
03550           ctu_x < (sps.getSubPicCtuTopLeftX(i) + sps.getSubPicWidth(i)) &&\par
03551           ctu_y >= sps.getSubPicCtuTopLeftY(i) &&\par
03552           ctu_y < (sps.getSubPicCtuTopLeftY(i) + sps.getSubPicHeight(i)))\par
03553         \{\par
03554           {\cf20 // add ctus in a slice to the subpicture it belongs to}\par
03555           m_subPics[i].addCTUsToSubPic(m_sliceMap[j].getCtuAddrList());\par
03556       numSlicesInSubPic++;\par
03557           idxLastSliceInSubpic = j;\par
03558         \}\par
03559         {\cf19 else} {\cf19 if} (idxFirstSliceAfterSubpic == m_numSlicesInPic && idxLastSliceInSubpic != -1)\par
03560         \{\par
03561           idxFirstSliceAfterSubpic = j;\par
03562         \}\par
03563       \}\par
03564       CHECK( idxFirstSliceAfterSubpic < idxLastSliceInSubpic, {\cf22 "The signalling order of slices shall follow the coding order"} );\par
03565       m_subPics[i].setNumSlicesInSubPic(numSlicesInSubPic);\par
03566     \}\par
03567     m_subPics[i].setTreatedAsPicFlag(sps.getSubPicTreatedAsPicFlag(i));\par
03568     m_subPics[i].setloopFilterAcrossEnabledFlag(sps.getLoopFilterAcrossSubpicEnabledFlag(i));\par
03569   \}\par
03570 \}\par
