02964 {\cf18 void} ChromaQpMappingTable::setParams({\cf17 const} ChromaQpMappingTableParams &params, {\cf17 const} {\cf18 int} qpBdOffset)\par
02965 \{\par
02966   m_qpBdOffset = qpBdOffset;\par
02967   m_sameCQPTableForAllChromaFlag = params.m_sameCQPTableForAllChromaFlag;\par
02968   m_numQpTables = params.m_numQpTables;\par
02969 \par
02970   {\cf19 for} ({\cf18 int} i = 0; i < MAX_NUM_CQP_MAPPING_TABLES; i++)\par
02971   \{\par
02972     m_numPtsInCQPTableMinus1[i] = params.m_numPtsInCQPTableMinus1[i];\par
02973     m_deltaQpInValMinus1[i] = params.m_deltaQpInValMinus1[i];\par
02974     m_qpTableStartMinus26[i] = params.m_qpTableStartMinus26[i];\par
02975     m_deltaQpOutVal[i] = params.m_deltaQpOutVal[i];\par
02976   \}\par
02977 \}\par
02978 {\cf18 void} ChromaQpMappingTable::derivedChromaQPMappingTables()\par
02979 \{\par
02980   {\cf19 for} ({\cf18 int} i = 0; i < getNumQpTables(); i++)\par
02981   \{\par
02982     {\cf17 const} {\cf18 int} qpBdOffsetC = m_qpBdOffset;\par
02983     {\cf17 const} {\cf18 int} numPtsInCQPTableMinus1 = getNumPtsInCQPTableMinus1(i);\par
02984     std::vector<int> qpInVal(numPtsInCQPTableMinus1 + 2), qpOutVal(numPtsInCQPTableMinus1 + 2);\par
02985 \par
02986     qpInVal[0] = getQpTableStartMinus26(i) + 26;\par
02987     qpOutVal[0] = qpInVal[0];\par
02988     {\cf19 for} ({\cf18 int} j = 0; j <= getNumPtsInCQPTableMinus1(i); j++)\par
02989     \{\par
02990       qpInVal[j + 1] = qpInVal[j] + getDeltaQpInValMinus1(i, j) + 1;\par
02991       qpOutVal[j + 1] = qpOutVal[j] + getDeltaQpOutVal(i, j);\par
02992     \}\par
02993 \par
02994     {\cf19 for} ({\cf18 int} j = 0; j <= getNumPtsInCQPTableMinus1(i); j++)\par
02995     \{\par
02996       CHECK(qpInVal[j]  < -qpBdOffsetC || qpInVal[j]  > MAX_QP, {\cf22 "qpInVal out of range"});\par
02997       CHECK(qpOutVal[j] < -qpBdOffsetC || qpOutVal[j] > MAX_QP, {\cf22 "qpOutVal out of range"});\par
02998     \}\par
02999 \par
03000     m_chromaQpMappingTables[i][qpInVal[0]] = qpOutVal[0];\par
03001     {\cf19 for} ({\cf18 int} k = qpInVal[0] - 1; k >= -qpBdOffsetC; k--)\par
03002     \{\par
03003       m_chromaQpMappingTables[i][k] = Clip3(-qpBdOffsetC, MAX_QP, m_chromaQpMappingTables[i][k + 1] - 1);\par
03004     \}\par
03005     {\cf19 for} ({\cf18 int} j = 0; j <= numPtsInCQPTableMinus1; j++)\par
03006     \{\par
03007       {\cf18 int} sh = (getDeltaQpInValMinus1(i, j) + 1) >> 1;\par
03008       {\cf19 for} ({\cf18 int} k = qpInVal[j] + 1, m = 1; k <= qpInVal[j + 1]; k++, m++)\par
03009       \{\par
03010         m_chromaQpMappingTables[i][k] = m_chromaQpMappingTables[i][qpInVal[j]]\par
03011           + ((qpOutVal[j + 1] - qpOutVal[j]) * m + sh) / (getDeltaQpInValMinus1(i, j) + 1);\par
03012       \}\par
03013     \}\par
03014     {\cf19 for} ({\cf18 int} k = qpInVal[numPtsInCQPTableMinus1 + 1] + 1; k <= MAX_QP; k++)\par
03015     \{\par
03016       m_chromaQpMappingTables[i][k] = Clip3(-qpBdOffsetC, MAX_QP, m_chromaQpMappingTables[i][k - 1] + 1);\par
03017     \}\par
03018   \}\par
03019 \}\par
