03852 {\cf18 void} ScalingList::codePredScalingList({\cf18 int}* scalingList, {\cf17 const} {\cf18 int}* scalingListPred, {\cf18 int} scalingListDC, {\cf18 int} scalingListPredDC, {\cf18 int} scalingListId, {\cf18 int}& bitsCost) {\cf20 //sizeId, listId is current to-be-coded matrix idx}\par
03853 \{\par
03854   {\cf18 int} deltaValue = 0;\par
03855   {\cf18 int} matrixSize = (scalingListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalingListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03856   {\cf18 int} coefNum = matrixSize*matrixSize;\par
03857   ScanElement *scan = g_scanOrder[SCAN_UNGROUPED][SCAN_DIAG][gp_sizeIdxInfo->idxFrom(matrixSize)][gp_sizeIdxInfo->idxFrom(matrixSize)];\par
03858   {\cf18 int} nextCoef = 0;\par
03859 \par
03860   int8_t data;\par
03861   {\cf17 const} {\cf18 int} *src = scalingList;\par
03862   {\cf17 const} {\cf18 int} *srcPred = scalingListPred;\par
03863   {\cf19 if} (scalingListDC!=-1 && scalingListPredDC!=-1)\par
03864   \{\par
03865     bitsCost += lengthSvlc((int8_t)(scalingListDC - scalingListPredDC - nextCoef));\par
03866     nextCoef =  scalingListDC - scalingListPredDC;\par
03867   \}\par
03868   {\cf19 else} {\cf19 if} ((scalingListDC != -1 && scalingListPredDC == -1))\par
03869   \{\par
03870     bitsCost += lengthSvlc((int8_t)(scalingListDC - srcPred[scan[0].idx] - nextCoef));\par
03871     nextCoef =  scalingListDC - srcPred[scan[0].idx];\par
03872   \}\par
03873   {\cf19 else} {\cf19 if} ((scalingListDC == -1 && scalingListPredDC == -1))\par
03874   \{\par
03875   \}\par
03876   {\cf19 else}\par
03877   \{\par
03878     printf({\cf22 "Predictor DC mismatch! \\n"});\par
03879   \}\par
03880   {\cf19 for} ({\cf18 int} i = 0; i < coefNum; i++)\par
03881   \{\par
03882     {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_64x64 && scan[i].x >= 4 && scan[i].y >= 4)\par
03883       {\cf19 continue};\par
03884     deltaValue = (src[scan[i].idx] - srcPred[scan[i].idx]);\par
03885     data = (int8_t)(deltaValue - nextCoef);\par
03886     nextCoef = deltaValue;\par
03887 \par
03888     bitsCost += lengthSvlc(data);\par
03889   \}\par
03890 \}\par
03891 {\cf18 void} ScalingList::codeScalingList({\cf18 int}* scalingList, {\cf18 int} scalingListDC, {\cf18 int} scalingListId, {\cf18 int}& bitsCost) {\cf20 //sizeId, listId is current to-be-coded matrix idx}\par
03892 \{\par
03893   {\cf18 int} matrixSize = (scalingListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalingListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03894   {\cf18 int} coefNum = matrixSize * matrixSize;\par
03895   ScanElement *scan = g_scanOrder[SCAN_UNGROUPED][SCAN_DIAG][gp_sizeIdxInfo->idxFrom(matrixSize)][gp_sizeIdxInfo->idxFrom(matrixSize)];\par
03896   {\cf18 int} nextCoef = SCALING_LIST_START_VALUE;\par
03897   int8_t data;\par
03898   {\cf17 const} {\cf18 int} *src = scalingList;\par
03899 \par
03900   {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_16x16)\par
03901   \{\par
03902     bitsCost += lengthSvlc(int8_t(getScalingListDC(scalingListId) - nextCoef));\par
03903     nextCoef = getScalingListDC(scalingListId);\par
03904   \}\par
03905 \par
03906   {\cf19 for} ({\cf18 int} i = 0; i < coefNum; i++)\par
03907   \{\par
03908     {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_64x64 && scan[i].x >= 4 && scan[i].y >= 4)\par
03909       {\cf19 continue};\par
03910     data = int8_t(src[scan[i].idx] - nextCoef);\par
03911     nextCoef = src[scan[i].idx];\par
03912 \par
03913     bitsCost += lengthSvlc(data);\par
03914   \}\par
03915 \}\par
03916 {\cf18 void} ScalingList::CheckBestPredScalingList({\cf18 int} scalingListId, {\cf18 int} predListId, {\cf18 int}& BitsCount)\par
03917 \{\par
03918   {\cf20 //check previously coded matrix as a predictor, code "lengthUvlc" function}\par
03919   {\cf18 int} *scalingList = getScalingListAddress(scalingListId);\par
03920   {\cf17 const} {\cf18 int} *scalingListPred = (scalingListId == predListId) ? ((predListId < SCALING_LIST_1D_START_8x8) ? g_quantTSDefault4x4 : g_quantIntraDefault8x8) : getScalingListAddress(predListId);\par
03921   {\cf18 int} scalingListDC = (scalingListId >= SCALING_LIST_1D_START_16x16) ? getScalingListDC(scalingListId) : -1;\par
03922   {\cf18 int} scalingListPredDC = (predListId >= SCALING_LIST_1D_START_16x16) ? ((scalingListId == predListId) ? 16 : getScalingListDC(predListId)) : -1;\par
03923 \par
03924   {\cf18 int} bitsCost = 0;\par
03925   {\cf18 int} matrixSize = (scalingListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalingListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03926   {\cf18 int} predMatrixSize = (predListId < SCALING_LIST_1D_START_4x4) ? 2 : (predListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03927 \par
03928   {\cf19 if} (matrixSize != predMatrixSize) printf({\cf22 "Predictor size mismatch! \\n"});\par
03929 \par
03930   bitsCost = 2 + lengthUvlc(scalingListId - predListId);\par
03931   {\cf20 //copy-flag + predictor-mode-flag + deltaListId}\par
03932   codePredScalingList(scalingList, scalingListPred, scalingListDC, scalingListPredDC, scalingListId, bitsCost);\par
03933   BitsCount = bitsCost;\par
03934 \}\par
03935 {\cf18 void} ScalingList::processRefMatrix(uint32_t scalinListId, uint32_t refListId)\par
03936 \{\par
03937   {\cf18 int} matrixSize = (scalinListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalinListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03938   ::memcpy(getScalingListAddress(scalinListId), ((scalinListId == refListId) ? getScalingListDefaultAddress(refListId) : getScalingListAddress(refListId)), {\cf17 sizeof}({\cf18 int})*matrixSize*matrixSize);\par
03939 \}\par
03940 {\cf18 void} ScalingList::checkPredMode(uint32_t scalingListId)\par
03941 \{\par
03942   {\cf18 int} bestBitsCount = MAX_INT;\par
03943   {\cf18 int} BitsCount = 2;\par
03944   setScalingListPreditorModeFlag(scalingListId, {\cf17 false});\par
03945   codeScalingList(getScalingListAddress(scalingListId), ((scalingListId >= SCALING_LIST_1D_START_16x16) ? getScalingListDC(scalingListId) : -1), scalingListId, BitsCount);\par
03946   bestBitsCount = BitsCount;\par
03947 \par
03948   {\cf19 for} ({\cf18 int} predListIdx = ({\cf18 int})scalingListId; predListIdx >= 0; predListIdx--)\par
03949   \{\par
03950 \par
03951     {\cf18 int} matrixSize = (scalingListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalingListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03952     {\cf18 int} predMatrixSize = (predListIdx < SCALING_LIST_1D_START_4x4) ? 2 : (predListIdx < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
03953     {\cf19 if} (((scalingListId == SCALING_LIST_1D_START_2x2 || scalingListId == SCALING_LIST_1D_START_4x4 || scalingListId == SCALING_LIST_1D_START_8x8) && predListIdx != ({\cf18 int})scalingListId) || matrixSize != predMatrixSize)\par
03954       {\cf19 continue};\par
03955     {\cf17 const} {\cf18 int}* refScalingList = (scalingListId == predListIdx) ? getScalingListDefaultAddress(predListIdx) : getScalingListAddress(predListIdx);\par
03956     {\cf17 const} {\cf18 int} refDC = (predListIdx < SCALING_LIST_1D_START_16x16) ? refScalingList[0] : (scalingListId == predListIdx) ? 16 : getScalingListDC(predListIdx);\par
03957     {\cf19 if} (!::memcmp(getScalingListAddress(scalingListId), refScalingList, {\cf17 sizeof}({\cf18 int})*matrixSize*matrixSize) {\cf20 // check value of matrix}\par
03958       {\cf20 // check DC value}\par
03959       && (scalingListId < SCALING_LIST_1D_START_16x16 || getScalingListDC(scalingListId) == refDC))\par
03960     \{\par
03961       {\cf20 //copy mode}\par
03962       setRefMatrixId(scalingListId, predListIdx);\par
03963       setScalingListCopyModeFlag(scalingListId, {\cf17 true});\par
03964       setScalingListPreditorModeFlag(scalingListId, {\cf17 false});\par
03965       {\cf19 return};\par
03966     \}\par
03967     {\cf19 else}\par
03968     \{\par
03969       {\cf20 //predictor mode}\par
03970       {\cf20 //use previously coded matrix as a predictor}\par
03971       CheckBestPredScalingList(scalingListId, predListIdx, BitsCount);\par
03972       {\cf19 if} (BitsCount < bestBitsCount)\par
03973       \{\par
03974         bestBitsCount = BitsCount;\par
03975         setScalingListCopyModeFlag(scalingListId, {\cf17 false});\par
03976         setScalingListPreditorModeFlag(scalingListId, {\cf17 true});\par
03977         setRefMatrixId(scalingListId, predListIdx);\par
03978       \}\par
03979     \}\par
03980   \}\par
03981   setScalingListCopyModeFlag(scalingListId, {\cf17 false});\par
03982 \}\par
