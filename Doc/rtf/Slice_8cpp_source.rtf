03177 {\cf18 void} PPS::initTiles()\par
03178 \{\par
03179   {\cf18 int}       colIdx, rowIdx;\par
03180   {\cf18 int}       ctuX, ctuY;\par
03181 \par
03182   {\cf20 // check explicit tile column sizes}\par
03183   uint32_t  remainingWidthInCtu  = m_picWidthInCtu;\par
03184 \par
03185   {\cf19 for}( colIdx = 0; colIdx < m_numExpTileCols; colIdx++ )\par
03186   \{\par
03187     CHECK(m_tileColWidth[colIdx] > remainingWidthInCtu,    {\cf22 "Tile column width exceeds picture width"});\par
03188     remainingWidthInCtu -= m_tileColWidth[colIdx];\par
03189   \}\par
03190 \par
03191   {\cf20 // divide remaining picture width into uniform tile columns}\par
03192   uint32_t  uniformTileColWidth = m_tileColWidth[colIdx-1];\par
03193   {\cf19 while}( remainingWidthInCtu > 0 )\par
03194   \{\par
03195     CHECK(colIdx >= MAX_TILE_COLS, {\cf22 "Number of tile columns exceeds valid range"});\par
03196     uniformTileColWidth = std::min(remainingWidthInCtu, uniformTileColWidth);\par
03197     m_tileColWidth.push_back( uniformTileColWidth );\par
03198     remainingWidthInCtu -= uniformTileColWidth;\par
03199     colIdx++;\par
03200   \}\par
03201   m_numTileCols = colIdx;\par
03202 \par
03203   {\cf20 // check explicit tile row sizes}\par
03204   uint32_t  remainingHeightInCtu  = m_picHeightInCtu;\par
03205 \par
03206   {\cf19 for}( rowIdx = 0; rowIdx < m_numExpTileRows; rowIdx++ )\par
03207   \{\par
03208     CHECK(m_tileRowHeight[rowIdx] > remainingHeightInCtu,     {\cf22 "Tile row height exceeds picture height"});\par
03209     remainingHeightInCtu -= m_tileRowHeight[rowIdx];\par
03210   \}\par
03211 \par
03212   {\cf20 // divide remaining picture height into uniform tile rows}\par
03213   uint32_t  uniformTileRowHeight = m_tileRowHeight[rowIdx - 1];\par
03214   {\cf19 while}( remainingHeightInCtu > 0 )\par
03215   \{\par
03216     uniformTileRowHeight = std::min(remainingHeightInCtu, uniformTileRowHeight);\par
03217     m_tileRowHeight.push_back( uniformTileRowHeight );\par
03218     remainingHeightInCtu -= uniformTileRowHeight;\par
03219     rowIdx++;\par
03220   \}\par
03221   m_numTileRows = rowIdx;\par
03222 \par
03223   {\cf20 // set left column bounaries}\par
03224   m_tileColBd.push_back( 0 );\par
03225   {\cf19 for}( colIdx = 0; colIdx < m_numTileCols; colIdx++ )\par
03226   \{\par
03227     m_tileColBd.push_back( m_tileColBd[ colIdx ] + m_tileColWidth[ colIdx ] );\par
03228   \}\par
03229 \par
03230   {\cf20 // set top row bounaries}\par
03231   m_tileRowBd.push_back( 0 );\par
03232   {\cf19 for}( rowIdx = 0; rowIdx < m_numTileRows; rowIdx++ )\par
03233   \{\par
03234     m_tileRowBd.push_back( m_tileRowBd[ rowIdx ] + m_tileRowHeight[ rowIdx ] );\par
03235   \}\par
03236 \par
03237   {\cf20 // set mapping between horizontal CTU address and tile column index}\par
03238   colIdx = 0;\par
03239   {\cf19 for}( ctuX = 0; ctuX <= m_picWidthInCtu; ctuX++ )\par
03240   \{\par
03241     {\cf19 if}( ctuX == m_tileColBd[ colIdx + 1 ] )\par
03242     \{\par
03243       colIdx++;\par
03244     \}\par
03245     m_ctuToTileCol.push_back( colIdx );\par
03246   \}\par
03247 \par
03248   {\cf20 // set mapping between vertical CTU address and tile row index}\par
03249   rowIdx = 0;\par
03250   {\cf19 for}( ctuY = 0; ctuY <= m_picHeightInCtu; ctuY++ )\par
03251   \{\par
03252     {\cf19 if}( ctuY == m_tileRowBd[ rowIdx + 1 ] )\par
03253     \{\par
03254       rowIdx++;\par
03255     \}\par
03256     m_ctuToTileRow.push_back( rowIdx );\par
03257   \}\par
03258 \}\par
