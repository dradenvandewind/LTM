00429 {\cf18 void} Slice::constructRefPicList(PicList& rcListPic)\par
00430 \{\par
00431   ::memset(m_bIsUsedAsLongTerm, 0, {\cf17 sizeof}(m_bIsUsedAsLongTerm));\par
00432   {\cf19 if} (m_eSliceType == I_SLICE)\par
00433   \{\par
00434     ::memset(m_apcRefPicList, 0, {\cf17 sizeof}(m_apcRefPicList));\par
00435     ::memset(m_aiNumRefIdx, 0, {\cf17 sizeof}(m_aiNumRefIdx));\par
00436     {\cf19 return};\par
00437   \}\par
00438 \par
00439   Picture*  pcRefPic = NULL;\par
00440   uint32_t numOfActiveRef = 0;\par
00441   {\cf20 //construct L0}\par
00442   numOfActiveRef = getNumRefIdx(REF_PIC_LIST_0);\par
00443   {\cf18 int} layerIdx = m_pcPic->cs->vps == {\cf17 nullptr} ? 0 : m_pcPic->cs->vps->getGeneralLayerIdx( m_pcPic->layerId );\par
00444 \par
00445   {\cf19 for} ({\cf18 int} ii = 0; ii < m_RPL0.getNumRefEntries(); ii++)\par
00446   \{\par
00447     {\cf19 if}( m_RPL0.isInterLayerRefPic( ii ) )\par
00448     \{\par
00449       CHECK( m_RPL0.getInterLayerRefPicIdx( ii ) == NOT_VALID, {\cf22 "Wrong ILRP index"} );\par
00450 \par
00451       {\cf18 int} refLayerId = m_pcPic->cs->vps->getLayerId( m_pcPic->cs->vps->getDirectRefLayerIdx( layerIdx, m_RPL0.getInterLayerRefPicIdx( ii ) ) );\par
00452 \par
00453       pcRefPic = xGetRefPic( rcListPic, getPOC(), refLayerId );\par
00454       pcRefPic->longTerm = {\cf17 true};\par
00455     \}\par
00456     {\cf19 else}\par
00457     {\cf19 if} (!m_RPL0.isRefPicLongterm(ii))\par
00458     \{\par
00459       pcRefPic = xGetRefPic(rcListPic, getPOC() + m_RPL0.getRefPicIdentifier(ii), m_pcPic->layerId);\par
00460       pcRefPic->longTerm = {\cf17 false};\par
00461     \}\par
00462     {\cf19 else}\par
00463     \{\par
00464       {\cf18 int} pocBits = getSPS()->getBitsForPOC();\par
00465       {\cf18 int} pocMask = (1 << pocBits) - 1;\par
00466       {\cf18 int} ltrpPoc = m_RPL0.getRefPicIdentifier(ii) & pocMask;\par
00467       {\cf19 if}(m_RPL0.getDeltaPocMSBPresentFlag(ii))\par
00468       \{\par
00469         ltrpPoc += getPOC() - m_RPL0.getDeltaPocMSBCycleLT(ii) * (pocMask + 1) - (getPOC() & pocMask);\par
00470       \}\par
00471       pcRefPic = xGetLongTermRefPicCandidate( rcListPic, ltrpPoc, m_RPL0.getDeltaPocMSBPresentFlag( ii ), m_pcPic->layerId );\par
00472       pcRefPic->longTerm = {\cf17 true};\par
00473     \}\par
00474     {\cf19 if}(ii < numOfActiveRef)\par
00475     \{\par
00476       pcRefPic->extendPicBorder( getPPS() );\par
00477       m_apcRefPicList[REF_PIC_LIST_0][ii] = pcRefPic;\par
00478       m_bIsUsedAsLongTerm[REF_PIC_LIST_0][ii] = pcRefPic->longTerm;\par
00479     \}\par
00480   \}\par
00481 \par
00482   {\cf20 //construct L1}\par
00483   numOfActiveRef = getNumRefIdx(REF_PIC_LIST_1);\par
00484   {\cf19 for} ({\cf18 int} ii = 0; ii < m_RPL1.getNumRefEntries(); ii++)\par
