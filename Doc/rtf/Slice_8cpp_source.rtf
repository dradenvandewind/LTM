00812 {\cf18 void} Slice::decodingRefreshMarking({\cf18 int}& pocCRA, {\cf18 bool}& bRefreshPending, PicList& rcListPic, {\cf17 const} {\cf18 bool} bEfficientFieldIRAPEnabled)\par
00813 \{\par
00814   Picture* rpcPic;\par
00815   {\cf18 int}      pocCurr = getPOC();\par
00816 \par
00817   {\cf19 if} ( getNalUnitType() == NAL_UNIT_CODED_SLICE_IDR_W_RADL\par
00818     || getNalUnitType() == NAL_UNIT_CODED_SLICE_IDR_N_LP)  {\cf20 // IDR picture}\par
00819   \{\par
00820     {\cf20 // mark all pictures as not used for reference}\par
00821     PicList::iterator        iterPic       = rcListPic.begin();\par
00822     {\cf19 while} (iterPic != rcListPic.end())\par
00823     \{\par
00824       rpcPic = *(iterPic);\par
00825       {\cf19 if} (rpcPic->getPOC() != pocCurr)\par
00826       \{\par
00827         rpcPic->referenced = {\cf17 false};\par
00828         rpcPic->getHashMap()->clearAll();\par
00829       \}\par
00830       iterPic++;\par
00831     \}\par
00832     {\cf19 if} (bEfficientFieldIRAPEnabled)\par
00833     \{\par
00834       bRefreshPending = {\cf17 true};\par
00835     \}\par
00836   \}\par
00837   {\cf19 else} {\cf20 // CRA or No DR}\par
00838   \{\par
00839     {\cf19 if}(bEfficientFieldIRAPEnabled && (getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_IDR_N_LP || getAssociatedIRAPType() == NAL_UNIT_CODED_SLICE_IDR_W_RADL))\par
00840     \{\par
00841       {\cf19 if} (bRefreshPending=={\cf17 true} && pocCurr > m_iLastIDR) {\cf20 // IDR reference marking pending}\par
00842       \{\par
00843         PicList::iterator        iterPic       = rcListPic.begin();\par
00844         {\cf19 while} (iterPic != rcListPic.end())\par
00845         \{\par
00846           rpcPic = *(iterPic);\par
00847           {\cf19 if} (rpcPic->getPOC() != pocCurr && rpcPic->getPOC() != m_iLastIDR)\par
00848           \{\par
00849             rpcPic->referenced = {\cf17 false};\par
00850             rpcPic->getHashMap()->clearAll();\par
00851           \}\par
00852           iterPic++;\par
00853         \}\par
00854         bRefreshPending = {\cf17 false};\par
00855       \}\par
00856     \}\par
00857     {\cf19 else}\par
00858     \{\par
00859       {\cf19 if} (bRefreshPending=={\cf17 true} && pocCurr > pocCRA) {\cf20 // CRA reference marking pending}\par
00860       \{\par
00861         PicList::iterator iterPic = rcListPic.begin();\par
00862         {\cf19 while} (iterPic != rcListPic.end())\par
00863         \{\par
00864           rpcPic = *(iterPic);\par
00865           {\cf19 if} (rpcPic->getPOC() != pocCurr && rpcPic->getPOC() != pocCRA)\par
00866           \{\par
00867             rpcPic->referenced = {\cf17 false};\par
00868             rpcPic->getHashMap()->clearAll();\par
00869           \}\par
00870           iterPic++;\par
00871         \}\par
00872         bRefreshPending = {\cf17 false};\par
00873       \}\par
00874     \}\par
00875     {\cf19 if} ( getNalUnitType() == NAL_UNIT_CODED_SLICE_CRA ) {\cf20 // CRA picture found}\par
00876     \{\par
00877       bRefreshPending = {\cf17 true};\par
00878       pocCRA = pocCurr;\par
00879     \}\par
00880   \}\par
00881 \}\par
