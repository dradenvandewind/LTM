00277 {\cf18 void} Slice::setNumEntryPoints({\cf17 const} SPS *sps, {\cf17 const} PPS *pps)\par
00278 \{\par
00279   uint32_t ctuAddr, ctuX, ctuY;\par
00280   uint32_t prevCtuAddr, prevCtuX, prevCtuY;\par
00281   m_numEntryPoints = 0;\par
00282 \par
00283   {\cf19 if} (!sps->getEntryPointsPresentFlag())\par
00284   \{\par
00285     {\cf19 return};\par
00286   \}\par
00287 \par
00288   {\cf20 // count the number of CTUs that align with either the start of a tile, or with an entropy coding sync point}\par
00289   {\cf20 // ignore the first CTU since it doesn't count as an entry point}\par
00290   {\cf19 for}( uint32_t i = 1; i < m_sliceMap.getNumCtuInSlice(); i++ )\par
00291   \{\par
00292     ctuAddr = m_sliceMap.getCtuAddrInSlice( i );\par
00293     ctuX = ( ctuAddr % pps->getPicWidthInCtu() );\par
00294     ctuY = ( ctuAddr / pps->getPicWidthInCtu() );\par
00295     prevCtuAddr = m_sliceMap.getCtuAddrInSlice(i - 1);\par
00296     prevCtuX    = (prevCtuAddr % pps->getPicWidthInCtu());\par
00297     prevCtuY    = (prevCtuAddr / pps->getPicWidthInCtu());\par
00298 \par
00299     {\cf19 if} (pps->ctuToTileRowBd(ctuY) != pps->ctuToTileRowBd(prevCtuY) || pps->ctuToTileColBd(ctuX) != pps->ctuToTileColBd(prevCtuX) || (ctuY != prevCtuY && sps->getEntropyCodingSyncEnabledFlag()))\par
00300     \{\par
00301       m_numEntryPoints++;\par
00302     \}\par
00303   \}\par
00304 \}\par
