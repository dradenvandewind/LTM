00048 {\cf20 // ====================================================================================================================}\par
00049 {\cf20 // Class definition}\par
00050 {\cf20 // ====================================================================================================================}\par
00051 \par
00052 {\cf17 enum} MvPrecision\par
00053 \{\par
00054   MV_PRECISION_4PEL     = 0,      {\cf20 // 4-pel}\par
00055   MV_PRECISION_INT      = 2,      {\cf20 // 1-pel, shift 2 bits from 4-pel}\par
00056   MV_PRECISION_HALF     = 3,      {\cf20 // 1/2-pel}\par
00057   MV_PRECISION_QUARTER  = 4,      {\cf20 // 1/4-pel (the precision of regular MV difference signaling), shift 4 bits from 4-pel}\par
00058   MV_PRECISION_SIXTEENTH = 6,     {\cf20 // 1/16-pel (the precision of internal MV), shift 6 bits from 4-pel}\par
00059   MV_PRECISION_INTERNAL = 2 + MV_FRACTIONAL_BITS_INTERNAL,\par
00060 \};\par
00061 \par
00063 {\cf17 class }Mv\par
00064 \{\par
00065 {\cf17 private}:\par
00066   {\cf17 static} {\cf17 const} MvPrecision m_amvrPrecision[4];\par
00067   {\cf17 static} {\cf17 const} MvPrecision m_amvrPrecAffine[3];\par
00068   {\cf17 static} {\cf17 const} MvPrecision m_amvrPrecIbc[3];\par
00069 \par
00070   {\cf17 static} {\cf17 const} {\cf18 int} mvClipPeriod = (1 << MV_BITS);\par
00071   {\cf17 static} {\cf17 const} {\cf18 int} halfMvClipPeriod = (1 << (MV_BITS - 1));\par
00072 \par
00073 {\cf17 public}:\par
00074   {\cf18 int}   hor;     \par
00075   {\cf18 int}   ver;     \par
00076 \par
00077   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00078   {\cf20 // constructors}\par
00079   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00080 \par
00081   Mv(                    ) : hor( 0    ), ver( 0    ) \{\}\par
00082   Mv( {\cf18 int} iHor, {\cf18 int} iVer ) : hor( iHor ), ver( iVer ) \{\}\par
00083 \par
00084   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00085   {\cf20 // set}\par
00086   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00087 \par
00088   {\cf18 void}  set       ( {\cf18 int} iHor, {\cf18 int} iVer)     \{ hor = iHor;  ver = iVer; \}\par
00089   {\cf18 void}  setHor    ( {\cf18 int} i )                 \{ hor = i;                 \}\par
00090   {\cf18 void}  setVer    ( {\cf18 int} i )                 \{ ver = i;                 \}\par
00091   {\cf18 void}  setZero   ()                        \{ hor = ver = 0;           \}\par
00092 \par
00093   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00094   {\cf20 // get}\par
00095   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00096 \par
00097   {\cf18 int}   getHor    (){\cf17  const }\{ {\cf19 return} hor;          \}\par
00098   {\cf18 int}   getVer    (){\cf17  const }\{ {\cf19 return} ver;          \}\par
00099   {\cf18 int}   getAbsHor (){\cf17  const }\{ {\cf19 return} abs( hor );   \}\par
00100   {\cf18 int}   getAbsVer (){\cf17  const }\{ {\cf19 return} abs( ver );   \}\par
00101 \par
00102   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00103   {\cf20 // operations}\par
00104   {\cf20 // ------------------------------------------------------------------------------------------------------------------}\par
00105 \par
00106   {\cf17 const} Mv& operator += ({\cf17 const} Mv& _rcMv)\par
00107   \{\par
00108     \{\par
00109       Mv rcMv = _rcMv;\par
00110 \par
00111       hor += rcMv.hor;\par
00112       ver += rcMv.ver;\par
00113     \}\par
00114     {\cf19 return}  *{\cf17 this};\par
00115   \}\par
00116 \par
00117   {\cf17 const} Mv& operator-= ({\cf17 const} Mv& _rcMv)\par
00118   \{\par
00119     \{\par
00120       Mv rcMv = _rcMv;\par
00121 \par
00122       hor -= rcMv.hor;\par
00123       ver -= rcMv.ver;\par
00124     \}\par
00125     {\cf19 return}  *{\cf17 this};\par
00126   \}\par
00127 \par
00128 \par
00130   {\cf18 void} divideByPowerOf2 ({\cf17 const} {\cf18 int} i)\par
00131   \{\par
00132     {\cf19 if} (i != 0)\par
00133     \{\par
00134       {\cf17 const} {\cf18 int} offset = (1 << (i - 1));\par
00135       hor = (hor + offset - (hor >= 0)) >> i;\par
00136       ver = (ver + offset - (ver >= 0)) >> i;\par
00137     \}\par
00138   \}\par
00139 \par
00140   {\cf17 const} Mv& operator<<= ({\cf17 const} {\cf18 int} i)\par
00141   \{\par
00142     hor <<= i;\par
00143     ver <<= i;\par
00144     {\cf19 return}  *{\cf17 this};\par
00145   \}\par
00146 \par
00147   {\cf17 const} Mv& operator>>= ( {\cf17 const} {\cf18 int} i )\par
00148   \{\par
00149     {\cf19 if} (i != 0)\par
00150     \{\par
00151       {\cf17 const} {\cf18 int} offset = (1 << (i - 1));\par
00152       hor = (hor + offset - (hor >= 0)) >> i;\par
00153       ver = (ver + offset - (ver >= 0)) >> i;\par
00154     \}\par
00155     {\cf19 return}  *{\cf17 this};\par
00156   \}\par
00157 \par
00158   {\cf17 const} Mv operator - ( {\cf17 const} Mv& rcMv ){\cf17  const}\par
00159 {\cf17   }\{\par
00160     {\cf19 return} Mv( hor - rcMv.hor, ver - rcMv.ver );\par
00161   \}\par
00162 \par
00163   {\cf17 const} Mv operator + ( {\cf17 const} Mv& rcMv ){\cf17  const}\par
00164 {\cf17   }\{\par
00165     {\cf19 return} Mv( hor + rcMv.hor, ver + rcMv.ver );\par
00166   \}\par
00167 \par
00168   {\cf18 bool} operator== ( {\cf17 const} Mv& rcMv ){\cf17  const}\par
00169 {\cf17   }\{\par
00170     {\cf19 return} ( hor == rcMv.hor && ver == rcMv.ver );\par
00171   \}\par
