00261   {\cf18 void} clipToStorageBitDepth()\par
00262   \{\par
00263     hor = Clip3( -(1 << 17), (1 << 17) - 1, hor );\par
00264     ver = Clip3( -(1 << 17), (1 << 17) - 1, ver );\par
00265   \}\par
00266   {\cf18 void} mvCliptoStorageBitDepth()  {\cf20 // periodic clipping}\par
00267   \{\par
00268     hor = (hor + mvClipPeriod) & (mvClipPeriod - 1);\par
00269     hor = (hor >= halfMvClipPeriod) ? (hor - mvClipPeriod) : hor;\par
00270     ver = (ver + mvClipPeriod) & (mvClipPeriod - 1);\par
00271     ver = (ver >= halfMvClipPeriod) ? (ver - mvClipPeriod) : ver;\par
00272   \}\par
