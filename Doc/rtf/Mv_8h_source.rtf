00178   {\cf17 const} Mv scaleMv( {\cf18 int} iScale ){\cf17  const}\par
00179 {\cf17   }\{\par
00180     {\cf17 const} {\cf18 int} mvx = Clip3(MV_MIN, MV_MAX, (iScale * getHor() + 128 - (iScale * getHor() >= 0)) >> 8);\par
00181     {\cf17 const} {\cf18 int} mvy = Clip3(MV_MIN, MV_MAX, (iScale * getVer() + 128 - (iScale * getVer() >= 0)) >> 8);\par
00182     {\cf19 return} Mv( mvx, mvy );\par
00183   \}\par
00184 \par
00185   {\cf18 void} changePrecision({\cf17 const} MvPrecision& src, {\cf17 const} MvPrecision& dst)\par
00186   \{\par
00187     {\cf17 const} {\cf18 int} shift = (int)dst - ({\cf18 int})src;\par
00188     {\cf19 if} (shift >= 0)\par
00189     \{\par
00190       *{\cf17 this} <<= shift;\par
00191     \}\par
00192     {\cf19 else}\par
00193     \{\par
00194       {\cf17 const} {\cf18 int} rightShift = -shift;\par
00195       {\cf17 const} {\cf18 int} nOffset = 1 << (rightShift - 1);\par
00196       hor = hor >= 0 ? (hor + nOffset - 1) >> rightShift : (hor + nOffset) >> rightShift;\par
00197       ver = ver >= 0 ? (ver + nOffset - 1) >> rightShift : (ver + nOffset) >> rightShift;\par
00198     \}\par
00199   \}\par
00200 \par
00201   {\cf18 void} roundToPrecision({\cf17 const} MvPrecision& src, {\cf17 const} MvPrecision& dst)\par
00202   \{\par
00203     changePrecision(src, dst);\par
00204     changePrecision(dst, src);\par
00205   \}\par
