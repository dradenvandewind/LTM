00467 Distortion xCalcHADs8x8w( {\cf17 const} WPScalingParam &wpCur, {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
00468 \{\par
00469   Distortion sad=0;\par
00470   TCoeff diff[64], m1[8][8], m2[8][8], m3[8][8];\par
00471   {\cf18 int} iStep2 = iStep<<1;\par
00472   {\cf18 int} iStep3 = iStep2 + iStep;\par
00473   {\cf18 int} iStep4 = iStep3 + iStep;\par
00474   {\cf18 int} iStep5 = iStep4 + iStep;\par
00475   {\cf18 int} iStep6 = iStep5 + iStep;\par
00476   {\cf18 int} iStep7 = iStep6 + iStep;\par
00477   {\cf17 const} {\cf18 int} round  = wpCur.round;\par
00478   {\cf17 const} {\cf18 int} shift  = wpCur.shift;\par
00479   {\cf17 const} {\cf18 int} offset = wpCur.offset;\par
00480   {\cf17 const} {\cf18 int} w0     = wpCur.w;\par
00481 \par
00482   Pel   pred;\par
00483 \par
00484   {\cf19 for}({\cf18 int} k = 0; k < 64; k+=8 )\par
00485   \{\par
00486     pred      = ( (w0*piCur[     0] + round) >> shift ) + offset ;\par
00487     diff[k+0] = piOrg[0] - pred;\par
00488     pred      = ( (w0*piCur[iStep ] + round) >> shift ) + offset ;\par
00489     diff[k+1] = piOrg[1] - pred;\par
00490     pred      = ( (w0*piCur[iStep2] + round) >> shift ) + offset ;\par
00491     diff[k+2] = piOrg[2] - pred;\par
00492     pred      = ( (w0*piCur[iStep3] + round) >> shift ) + offset ;\par
00493     diff[k+3] = piOrg[3] - pred;\par
00494     pred      = ( (w0*piCur[iStep4] + round) >> shift ) + offset ;\par
00495     diff[k+4] = piOrg[4] - pred;\par
00496     pred      = ( (w0*piCur[iStep5] + round) >> shift ) + offset ;\par
00497     diff[k+5] = piOrg[5] - pred;\par
00498     pred      = ( (w0*piCur[iStep6] + round) >> shift ) + offset ;\par
00499     diff[k+6] = piOrg[6] - pred;\par
00500     pred      = ( (w0*piCur[iStep7] + round) >> shift ) + offset ;\par
00501     diff[k+7] = piOrg[7] - pred;\par
00502 \par
00503     piCur += iStrideCur;\par
00504     piOrg += iStrideOrg;\par
00505   \}\par
00506 \par
00507   {\cf20 //horizontal}\par
00508   {\cf19 for} ({\cf18 int} j=0; j < 8; j++)\par
00509   \{\par
00510     {\cf17 const} {\cf18 int} jj = j << 3;\par
00511     m2[j][0] = diff[jj  ] + diff[jj+4];\par
00512     m2[j][1] = diff[jj+1] + diff[jj+5];\par
00513     m2[j][2] = diff[jj+2] + diff[jj+6];\par
00514     m2[j][3] = diff[jj+3] + diff[jj+7];\par
00515     m2[j][4] = diff[jj  ] - diff[jj+4];\par
00516     m2[j][5] = diff[jj+1] - diff[jj+5];\par
00517     m2[j][6] = diff[jj+2] - diff[jj+6];\par
00518     m2[j][7] = diff[jj+3] - diff[jj+7];\par
00519 \par
00520     m1[j][0] = m2[j][0] + m2[j][2];\par
00521     m1[j][1] = m2[j][1] + m2[j][3];\par
00522     m1[j][2] = m2[j][0] - m2[j][2];\par
00523     m1[j][3] = m2[j][1] - m2[j][3];\par
00524     m1[j][4] = m2[j][4] + m2[j][6];\par
00525     m1[j][5] = m2[j][5] + m2[j][7];\par
00526     m1[j][6] = m2[j][4] - m2[j][6];\par
00527     m1[j][7] = m2[j][5] - m2[j][7];\par
00528 \par
00529     m2[j][0] = m1[j][0] + m1[j][1];\par
00530     m2[j][1] = m1[j][0] - m1[j][1];\par
00531     m2[j][2] = m1[j][2] + m1[j][3];\par
00532     m2[j][3] = m1[j][2] - m1[j][3];\par
00533     m2[j][4] = m1[j][4] + m1[j][5];\par
00534     m2[j][5] = m1[j][4] - m1[j][5];\par
00535     m2[j][6] = m1[j][6] + m1[j][7];\par
00536     m2[j][7] = m1[j][6] - m1[j][7];\par
00537   \}\par
00538 \par
00539   {\cf20 //vertical}\par
00540   {\cf19 for} ({\cf18 int} i=0; i < 8; i++)\par
00541   \{\par
00542     m3[0][i] = m2[0][i] + m2[4][i];\par
00543     m3[1][i] = m2[1][i] + m2[5][i];\par
00544     m3[2][i] = m2[2][i] + m2[6][i];\par
00545     m3[3][i] = m2[3][i] + m2[7][i];\par
00546     m3[4][i] = m2[0][i] - m2[4][i];\par
00547     m3[5][i] = m2[1][i] - m2[5][i];\par
00548     m3[6][i] = m2[2][i] - m2[6][i];\par
00549     m3[7][i] = m2[3][i] - m2[7][i];\par
00550 \par
00551     m1[0][i] = m3[0][i] + m3[2][i];\par
00552     m1[1][i] = m3[1][i] + m3[3][i];\par
00553     m1[2][i] = m3[0][i] - m3[2][i];\par
00554     m1[3][i] = m3[1][i] - m3[3][i];\par
00555     m1[4][i] = m3[4][i] + m3[6][i];\par
00556     m1[5][i] = m3[5][i] + m3[7][i];\par
00557     m1[6][i] = m3[4][i] - m3[6][i];\par
00558     m1[7][i] = m3[5][i] - m3[7][i];\par
00559 \par
00560     m2[0][i] = m1[0][i] + m1[1][i];\par
00561     m2[1][i] = m1[0][i] - m1[1][i];\par
00562     m2[2][i] = m1[2][i] + m1[3][i];\par
00563     m2[3][i] = m1[2][i] - m1[3][i];\par
00564     m2[4][i] = m1[4][i] + m1[5][i];\par
00565     m2[5][i] = m1[4][i] - m1[5][i];\par
00566     m2[6][i] = m1[6][i] + m1[7][i];\par
00567     m2[7][i] = m1[6][i] - m1[7][i];\par
00568   \}\par
00569 \par
00570   {\cf19 for} ({\cf18 int} j=0; j < 8; j++)\par
00571   \{\par
00572     {\cf19 for} ({\cf18 int} i=0; i < 8; i++)\par
00573     \{\par
00574       sad += (abs(m2[j][i]));\par
00575     \}\par
00576   \}\par
00577 \par
00578   sad=((sad+2)>>2);\par
00579 \par
00580   {\cf19 return} sad;\par
00581 \}\par
00582 \par
