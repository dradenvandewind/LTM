00600 \par
00601   {\cf19 if}( ( iRows % 8 == 0) && (iCols % 8 == 0) )\par
00602   \{\par
00603     {\cf17 const} {\cf18 int} iOffsetOrg = iStrideOrg<<3;\par
00604     {\cf17 const} {\cf18 int} iOffsetCur = iStrideCur<<3;\par
00605     {\cf19 for} ({\cf18 int} y=0; y<iRows; y+= 8 )\par
00606     \{\par
