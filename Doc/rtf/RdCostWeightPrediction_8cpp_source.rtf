00058 Distortion RdCostWeightPrediction::xGetSADw( {\cf17 const} DistParam &rcDtParam )\par
00059 \{\par
00060   {\cf17 const} Pel            *piOrg      = rcDtParam.org.buf;\par
00061   {\cf17 const} Pel            *piCur      = rcDtParam.cur.buf;\par
00062   {\cf17 const} {\cf18 int}             iCols      = rcDtParam.org.width;\par
00063   {\cf17 const} {\cf18 int}             iStrideCur = rcDtParam.cur.stride;\par
00064   {\cf17 const} {\cf18 int}             iStrideOrg = rcDtParam.org.stride;\par
00065   {\cf17 const} ComponentID     compID     = rcDtParam.compID;\par
00066 \par
00067   CHECK( compID >= MAX_NUM_COMPONENT, {\cf22 "Invalid component"} );\par
00068 \par
00069   {\cf17 const} WPScalingParam &wpCur      = rcDtParam.wpCur[compID];\par
00070 \par
00071   {\cf17 const} {\cf18 int}             w0         = wpCur.w;\par
00072   {\cf17 const} {\cf18 int}             offset     = wpCur.offset;\par
00073   {\cf17 const} {\cf18 int}             shift      = wpCur.shift;\par
00074   {\cf17 const} {\cf18 int}             round      = wpCur.round;\par
00075   {\cf17 const} {\cf18 int} distortionShift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth);\par
00076 \par
00077   Distortion uiSum = 0;\par
00078 \par
00079 {\cf21 #if !U0040_MODIFIED_WEIGHTEDPREDICTION_WITH_BIPRED_AND_CLIPPING}\par
00080   {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00081   \{\par
00082     {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00083     \{\par
00084       {\cf17 const} Pel pred = ( (w0*piCur[n] + round) >> shift ) + offset ;\par
00085 \par
00086       uiSum += abs( piOrg[n] - pred );\par
00087     \}\par
00088     {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00089     \{\par
00090       {\cf19 return} uiSum >> distortionShift;\par
00091     \}\par
00092     piOrg += iStrideOrg;\par
00093     piCur += iStrideCur;\par
00094   \}\par
00095 \par
00096   {\cf20 //rcDtParam.compID = MAX_NUM_COMPONENT;  // reset for DEBUG (assert test)}\par
00097 {\cf21 #else}\par
00098   ClpRng clpRng; {\cf20 // this just affects the cost}\par
00099   clpRng.min = 0;\par
00100   clpRng.max = (1 << rcDtParam.bitDepth) - 1;\par
00101 \par
00102   {\cf20 // Default weight}\par
00103   {\cf19 if} (w0 == 1 << shift)\par
00104   \{\par
00105     {\cf20 // no offset}\par
00106     {\cf19 if} (offset == 0)\par
00107     \{\par
00108       {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00109       \{\par
00110         {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00111         \{\par
00112           uiSum += abs( piOrg[n] - piCur[n] );\par
00113         \}\par
00114         {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00115         \{\par
00116           {\cf19 return} uiSum >> distortionShift;\par
00117         \}\par
00118         piOrg += iStrideOrg;\par
00119         piCur += iStrideCur;\par
00120       \}\par
00121     \}\par
00122     {\cf19 else}\par
00123     \{\par
00124       {\cf20 // Lets not clip for the bipredictive case since clipping should be done after}\par
00125       {\cf20 // combining both elements. Unfortunately the code uses the suboptimal "subtraction"}\par
00126       {\cf20 // method, which is faster but introduces the clipping issue (therefore Bipred is suboptimal).}\par
00127       {\cf19 if} (rcDtParam.isBiPred)\par
00128       \{\par
00129         {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00130         \{\par
00131           {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00132           \{\par
00133             uiSum += abs( piOrg[n] - (piCur[n] + offset) );\par
00134           \}\par
00135           {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00136           \{\par
00137             {\cf19 return} uiSum >> distortionShift;\par
00138           \}\par
00139 \par
00140           piOrg += iStrideOrg;\par
00141           piCur += iStrideCur;\par
00142         \}\par
00143       \}\par
00144       {\cf19 else}\par
00145       \{\par
00146         {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00147         \{\par
00148           {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00149           \{\par
00150             {\cf17 const} Pel pred = ClipPel( piCur[n] + offset, clpRng);\par
00151 \par
00152             uiSum += abs( piOrg[n] - pred );\par
00153           \}\par
00154           {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00155           \{\par
00156             {\cf19 return} uiSum >> distortionShift;\par
00157           \}\par
00158           piOrg += iStrideOrg;\par
00159           piCur += iStrideCur;\par
00160         \}\par
00161       \}\par
00162     \}\par
00163   \}\par
00164   {\cf19 else}\par
00165   \{\par
00166     {\cf20 // Lets not clip for the bipredictive case since clipping should be done after}\par
00167     {\cf20 // combining both elements. Unfortunately the code uses the suboptimal "subtraction"}\par
00168     {\cf20 // method, which is faster but introduces the clipping issue (therefore Bipred is suboptimal).}\par
00169     {\cf19 if} (rcDtParam.isBiPred)\par
00170     \{\par
00171       {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00172       \{\par
00173         {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00174         \{\par
00175           {\cf17 const} Pel pred = ( (w0*piCur[n] + round) >> shift ) + offset ;\par
00176           uiSum += abs( piOrg[n] - pred );\par
00177         \}\par
00178         {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00179         \{\par
00180           {\cf19 return} uiSum >> distortionShift;\par
00181         \}\par
00182 \par
00183         piOrg += iStrideOrg;\par
00184         piCur += iStrideCur;\par
00185       \}\par
00186     \}\par
00187     {\cf19 else}\par
00188     \{\par
00189       {\cf19 if} (offset == 0)\par
00190       \{\par
00191         {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00192         \{\par
00193           {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00194           \{\par
00195             {\cf17 const} Pel pred = ClipPel( (w0*piCur[n] + round) >> shift, clpRng);\par
00196 \par
00197             uiSum += abs( piOrg[n] - pred );\par
00198           \}\par
00199           {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00200           \{\par
00201             {\cf19 return} uiSum >> distortionShift;\par
00202           \}\par
00203           piOrg += iStrideOrg;\par
00204           piCur += iStrideCur;\par
00205         \}\par
00206       \}\par
00207       {\cf19 else}\par
00208       \{\par
00209         {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00210         \{\par
00211           {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00212           \{\par
00213             {\cf17 const} Pel pred = ClipPel(((w0*piCur[n] + round) >> shift ) + offset,  clpRng) ;\par
00214 \par
00215             uiSum += abs( piOrg[n] - pred );\par
00216           \}\par
00217           {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit <  ( uiSum >> distortionShift))\par
00218           \{\par
00219             {\cf19 return} uiSum >> distortionShift;\par
00220           \}\par
00221           piOrg += iStrideOrg;\par
00222           piCur += iStrideCur;\par
00223         \}\par
00224       \}\par
00225     \}\par
00226   \}\par
00227   {\cf20 //rcDtParam.compIdx = MAX_NUM_COMPONENT;  // reset for DEBUG (assert test)}\par
00228 {\cf21 #endif}\par
00229 \par
00230   {\cf19 return} uiSum >> distortionShift;\par
00231 \}\par
