00610       \}\par
00611       piOrg += iOffsetOrg;\par
00612       piCur += iOffsetCur;\par
00613     \}\par
00614   \}\par
00615   {\cf19 else} {\cf19 if}( ( iRows % 4 == 0) && (iCols % 4 == 0) )\par
00616   \{\par
00617     {\cf17 const} {\cf18 int} iOffsetOrg = iStrideOrg<<2;\par
00618     {\cf17 const} {\cf18 int} iOffsetCur = iStrideCur<<2;\par
00619 \par
00620     {\cf19 for} ({\cf18 int} y=0; y<iRows; y+= 4 )\par
00621     \{\par
00622       {\cf19 for} ({\cf18 int} x=0; x<iCols; x+= 4 )\par
00623       \{\par
00624         uiSum += xCalcHADs4x4w( wpCur, &piOrg[x], &piCur[x*iStep], iStrideOrg, iStrideCur, iStep );\par
00625       \}\par
00626       piOrg += iOffsetOrg;\par
00627       piCur += iOffsetCur;\par
00628     \}\par
00629   \}\par
00630   {\cf19 else}\par
00631   \{\par
00632     {\cf19 for} ({\cf18 int} y=0; y<iRows; y+=2 )\par
00633     \{\par
00634       {\cf19 for} ({\cf18 int} x=0; x<iCols; x+=2 )\par
00635       \{\par
00636         uiSum += xCalcHADs2x2w( wpCur, &piOrg[x], &piCur[x*iStep], iStrideOrg, iStrideCur, iStep );\par
00637       \}\par
