00241 Distortion RdCostWeightPrediction::xGetSSEw( {\cf17 const} DistParam &rcDtParam )\par
00242 \{\par
00243   {\cf17 const} Pel            *piOrg      = rcDtParam.org.buf;\par
00244   {\cf17 const} Pel            *piCur      = rcDtParam.cur.buf;\par
00245   {\cf17 const} {\cf18 int}             iCols      = rcDtParam.org.width;\par
00246   {\cf17 const} {\cf18 int}             iStrideCur = rcDtParam.cur.stride;\par
00247   {\cf17 const} {\cf18 int}             iStrideOrg = rcDtParam.org.stride;\par
00248   {\cf17 const} ComponentID     compID     = rcDtParam.compID;\par
00249 \par
00250   CHECK( rcDtParam.subShift != 0, {\cf22 "Subshift not supported"} ); {\cf20 // NOTE: what is this protecting?}\par
00251   CHECK( compID >= MAX_NUM_COMPONENT, {\cf22 "Invalid channel"} );\par
00252 \par
00253   {\cf17 const} WPScalingParam &wpCur           = rcDtParam.wpCur[compID];\par
00254   {\cf17 const} {\cf18 int}             w0              = wpCur.w;\par
00255   {\cf17 const} {\cf18 int}             offset          = wpCur.offset;\par
00256   {\cf17 const} {\cf18 int}             shift           = wpCur.shift;\par
00257   {\cf17 const} {\cf18 int}             round           = wpCur.round;\par
00258   {\cf17 const} uint32_t distortionShift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth) << 1;\par
00259 \par
00260   Distortion sum = 0;\par
00261 \par
00262 {\cf21 #if !U0040_MODIFIED_WEIGHTEDPREDICTION_WITH_BIPRED_AND_CLIPPING}\par
00263   {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height ; iRows != 0; iRows-- )\par
00264   \{\par
00265     {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00266     \{\par
00267       {\cf17 const} Pel pred     = ( (w0*piCur[n] + round) >> shift ) + offset ;\par
00268       {\cf17 const} Pel residual = piOrg[n] - pred;\par
00269       sum += ( Distortion(residual) * Distortion(residual) ) >> distortionShift;\par
00270     \}\par
00271     piOrg += iStrideOrg;\par
00272     piCur += iStrideCur;\par
00273   \}\par
00274 \par
00275   {\cf20 //rcDtParam.compIdx = MAX_NUM_COMPONENT; // reset for DEBUG (assert test)}\par
00276 {\cf21 #else}\par
00277   {\cf19 if} (rcDtParam.isBiPred)\par
00278   \{\par
00279     {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height ; iRows != 0; iRows-- )\par
00280     \{\par
00281       {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00282       \{\par
00283         {\cf17 const} Pel pred     = ( (w0*piCur[n] + round) >> shift ) + offset ;\par
00284         {\cf17 const} Pel residual = piOrg[n] - pred;\par
00285         sum += ( Distortion(residual) * Distortion(residual) ) >> distortionShift;\par
00286       \}\par
00287       piOrg += iStrideOrg;\par
00288       piCur += iStrideCur;\par
00289     \}\par
00290   \}\par
00291   {\cf19 else}\par
00292   \{\par
00293     ClpRng clpRng;  {\cf20 // this just affects the cost - fix this later}\par
00294     clpRng.min = 0;\par
00295     clpRng.max = (1 << rcDtParam.bitDepth) - 1;\par
00296 \par
00297     {\cf19 for}({\cf18 int} iRows = rcDtParam.org.height; iRows != 0; iRows-- )\par
00298     \{\par
00299       {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00300       \{\par
00301         {\cf17 const} Pel pred     = ClipPel(( (w0*piCur[n] + round) >> shift ) + offset, clpRng) ;\par
00302         {\cf17 const} Pel residual = piOrg[n] - pred;\par
00303         sum += ( Distortion(residual) * Distortion(residual) ) >> distortionShift;\par
00304       \}\par
00305       piOrg += iStrideOrg;\par
00306       piCur += iStrideCur;\par
00307     \}\par
00308   \}\par
00309 \par
00310   {\cf20 //rcDtParam.compIdx = MAX_NUM_COMPONENT; // reset for DEBUG (assert test)}\par
00311 {\cf21 #endif}\par
00312 \par
00313   {\cf19 return} sum;\par
00314 \}\par
