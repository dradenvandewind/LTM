00319 {\cf20 // --------------------------------------------------------------------------------------------------------------------}\par
00321 Distortion xCalcHADs2x2w( {\cf17 const} WPScalingParam &wpCur, {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
00322 \{\par
00323   {\cf17 const} {\cf18 int} round  = wpCur.round;\par
00324   {\cf17 const} {\cf18 int} shift  = wpCur.shift;\par
00325   {\cf17 const} {\cf18 int} offset = wpCur.offset;\par
00326   {\cf17 const} {\cf18 int} w0     = wpCur.w;\par
00327 \par
00328   Distortion satd  = 0;\par
00329   TCoeff     diff[4];\par
00330   TCoeff     m[4];\par
00331 \par
00332   Pel   pred;\par
00333 \par
00334   pred    = ( (w0*piCur[0*iStep             ] + round) >> shift ) + offset ;\par
00335   diff[0] = piOrg[0             ] - pred;\par
00336   pred    = ( (w0*piCur[1*iStep             ] + round) >> shift ) + offset ;\par
00337   diff[1] = piOrg[1             ] - pred;\par
00338   pred    = ( (w0*piCur[0*iStep + iStrideCur] + round) >> shift ) + offset ;\par
00339   diff[2] = piOrg[iStrideOrg    ] - pred;\par
00340   pred    = ( (w0*piCur[1*iStep + iStrideCur] + round) >> shift ) + offset ;\par
00341   diff[3] = piOrg[iStrideOrg + 1] - pred;\par
00342 \par
00343   m[0] = diff[0] + diff[2];\par
00344   m[1] = diff[1] + diff[3];\par
00345   m[2] = diff[0] - diff[2];\par
00346   m[3] = diff[1] - diff[3];\par
00347 \par
00348   satd += abs(m[0] + m[1]);\par
00349   satd += abs(m[0] - m[1]);\par
00350   satd += abs(m[2] + m[3]);\par
00351   satd += abs(m[2] - m[3]);\par
00352 \par
00353   {\cf19 return} satd;\par
00354 \}\par
00355 \par
