00585 Distortion RdCostWeightPrediction::xGetHADsw( {\cf17 const} DistParam &rcDtParam )\par
00586 \{\par
00587   {\cf17 const} Pel        *piOrg      = rcDtParam.org.buf;\par
00588   {\cf17 const} Pel        *piCur      = rcDtParam.cur.buf;\par
00589   {\cf17 const} {\cf18 int}         iRows      = rcDtParam.org.height;\par
