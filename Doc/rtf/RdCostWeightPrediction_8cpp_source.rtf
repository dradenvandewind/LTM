00358 Distortion xCalcHADs4x4w( {\cf17 const} WPScalingParam &wpCur, {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
00359 \{\par
00360   {\cf17 const} {\cf18 int} round  = wpCur.round;\par
00361   {\cf17 const} {\cf18 int} shift  = wpCur.shift;\par
00362   {\cf17 const} {\cf18 int} offset = wpCur.offset;\par
00363   {\cf17 const} {\cf18 int} w0     = wpCur.w;\par
00364 \par
00365   Distortion satd = 0;\par
00366   TCoeff     diff[16];\par
00367   TCoeff     m[16];\par
00368   TCoeff     d[16];\par
00369 \par
00370 \par
00371   {\cf19 for}({\cf18 int} k = 0; k < 16; k+=4 )\par
00372   \{\par
00373     Pel pred;\par
00374     pred      = ( (w0*piCur[0*iStep] + round) >> shift ) + offset ;\par
00375     diff[k+0] = piOrg[0] - pred;\par
00376     pred      = ( (w0*piCur[1*iStep] + round) >> shift ) + offset ;\par
00377     diff[k+1] = piOrg[1] - pred;\par
00378     pred      = ( (w0*piCur[2*iStep] + round) >> shift ) + offset ;\par
00379     diff[k+2] = piOrg[2] - pred;\par
00380     pred      = ( (w0*piCur[3*iStep] + round) >> shift ) + offset ;\par
00381     diff[k+3] = piOrg[3] - pred;\par
00382 \par
00383     piCur += iStrideCur;\par
00384     piOrg += iStrideOrg;\par
00385   \}\par
00386 \par
00387   {\cf20 /*===== hadamard transform =====*/}\par
00388   m[ 0] = diff[ 0] + diff[12];\par
00389   m[ 1] = diff[ 1] + diff[13];\par
00390   m[ 2] = diff[ 2] + diff[14];\par
00391   m[ 3] = diff[ 3] + diff[15];\par
00392   m[ 4] = diff[ 4] + diff[ 8];\par
00393   m[ 5] = diff[ 5] + diff[ 9];\par
00394   m[ 6] = diff[ 6] + diff[10];\par
00395   m[ 7] = diff[ 7] + diff[11];\par
00396   m[ 8] = diff[ 4] - diff[ 8];\par
00397   m[ 9] = diff[ 5] - diff[ 9];\par
00398   m[10] = diff[ 6] - diff[10];\par
00399   m[11] = diff[ 7] - diff[11];\par
00400   m[12] = diff[ 0] - diff[12];\par
00401   m[13] = diff[ 1] - diff[13];\par
00402   m[14] = diff[ 2] - diff[14];\par
00403   m[15] = diff[ 3] - diff[15];\par
00404 \par
00405   d[ 0] = m[ 0] + m[ 4];\par
00406   d[ 1] = m[ 1] + m[ 5];\par
00407   d[ 2] = m[ 2] + m[ 6];\par
00408   d[ 3] = m[ 3] + m[ 7];\par
00409   d[ 4] = m[ 8] + m[12];\par
00410   d[ 5] = m[ 9] + m[13];\par
00411   d[ 6] = m[10] + m[14];\par
00412   d[ 7] = m[11] + m[15];\par
00413   d[ 8] = m[ 0] - m[ 4];\par
00414   d[ 9] = m[ 1] - m[ 5];\par
00415   d[10] = m[ 2] - m[ 6];\par
00416   d[11] = m[ 3] - m[ 7];\par
00417   d[12] = m[12] - m[ 8];\par
00418   d[13] = m[13] - m[ 9];\par
00419   d[14] = m[14] - m[10];\par
00420   d[15] = m[15] - m[11];\par
00421 \par
00422   m[ 0] = d[ 0] + d[ 3];\par
00423   m[ 1] = d[ 1] + d[ 2];\par
00424   m[ 2] = d[ 1] - d[ 2];\par
00425   m[ 3] = d[ 0] - d[ 3];\par
00426   m[ 4] = d[ 4] + d[ 7];\par
00427   m[ 5] = d[ 5] + d[ 6];\par
00428   m[ 6] = d[ 5] - d[ 6];\par
00429   m[ 7] = d[ 4] - d[ 7];\par
00430   m[ 8] = d[ 8] + d[11];\par
00431   m[ 9] = d[ 9] + d[10];\par
00432   m[10] = d[ 9] - d[10];\par
00433   m[11] = d[ 8] - d[11];\par
00434   m[12] = d[12] + d[15];\par
00435   m[13] = d[13] + d[14];\par
00436   m[14] = d[13] - d[14];\par
00437   m[15] = d[12] - d[15];\par
00438 \par
00439   d[ 0] = m[ 0] + m[ 1];\par
00440   d[ 1] = m[ 0] - m[ 1];\par
00441   d[ 2] = m[ 2] + m[ 3];\par
00442   d[ 3] = m[ 3] - m[ 2];\par
00443   d[ 4] = m[ 4] + m[ 5];\par
00444   d[ 5] = m[ 4] - m[ 5];\par
00445   d[ 6] = m[ 6] + m[ 7];\par
00446   d[ 7] = m[ 7] - m[ 6];\par
00447   d[ 8] = m[ 8] + m[ 9];\par
00448   d[ 9] = m[ 8] - m[ 9];\par
00449   d[10] = m[10] + m[11];\par
00450   d[11] = m[11] - m[10];\par
00451   d[12] = m[12] + m[13];\par
00452   d[13] = m[12] - m[13];\par
00453   d[14] = m[14] + m[15];\par
00454   d[15] = m[15] - m[14];\par
00455 \par
00456   {\cf19 for} ({\cf18 int} k=0; k<16; ++k)\par
00457   \{\par
00458     satd += abs(d[k]);\par
00459   \}\par
00460   satd = ((satd+1)>>1);\par
00461 \par
00462   {\cf19 return} satd;\par
00463 \}\par
00464 \par
