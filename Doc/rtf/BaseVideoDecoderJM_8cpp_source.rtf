00148 {\cf18 void} BaseVideoDecoderJM::stop() \{\par
00149     {\cf19 if}(context_) \{\par
00150         CHECK(codec_);\par
00151         codec_->release_context(context_);\par
00152         context_ = 0;\par
00153     \}\par
00154 \par
00155     {\cf19 if}(codec_) \{\par
00156         CodecRelease(codec_);\par
00157         codec_ = 0;\par
00158     \}\par
