00140 \par
00141     CodecError error=0;\par
00142     {\cf19 if}(!codec_->create_context(&context_, {\cf22 ""}, &error)) \{\par
00143         ERR({\cf22 "Codec error: %s"}, CodecErrorToString(codec_, error).c_str());\par
00144         error = 0;\par
00145     \}\par
00146 \}\par
