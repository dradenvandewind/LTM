00196 {\cf18 void} BaseVideoDecoderJM::push_es({\cf17 const} uint8_t *data, {\cf18 size_t} data_size, uint64_t pts, {\cf18 bool} is_base_idr) \{\par
00197     CHECK(context_);\par
00198 \par
00199     {\cf20 // Push packet into codec}\par
00200     CodecError error = 0;\par
00201     codec_->push_packet(context_, data, data_size, 0, data == {\cf17 nullptr}, &error);\par
00202 \par
00203     {\cf20 // Pull images while codec continues to return them}\par
00204     int32_t n = 0;\par
00205     int8_t eos = 0;\par
00206     {\cf19 do} \{\par
00207         CodecImage codec_image = \{0\};\par
00208         CodecError error = 0;\par
00209         n = codec_->pull_image(context_, &codec_image, 0, &eos, &error);\par
00210 \par
00211         {\cf19 if}(n)  \{\par
00212             {\cf20 // Get next PSS from queue}\par
00213             {\cf20 //}\par
00214             CHECK(!enhancement_queue_.empty());\par
00215             PssPacket pss = enhancement_queue_.top();\par
00216             enhancement_queue_.pop();\par
00217 \par
00218             {\cf20 // Send to enhancement decoder}\par
00219             {\cf20 //}\par
00220             PacketView enhancement_view(pss.packet);\par
00221             output_.push_base_enhancement(&codec_image, enhancement_view.data(), enhancement_view.size(), pss.packet.timestamp(),\par
00222                                           pss.is_base_idr);\par
00223         \}\par
00224     \} {\cf19 while}(n);\par
00225 \}\par
