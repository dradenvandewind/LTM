00166         {\cf20 // Pick out enhancement data - may be removed - new size is returned}\par
00167         {\cf18 size_t} new_size =\par
00168             scan_enhancement(b.data(), data_size, encapsulation_, BaseCoding_AVC, pts, [is_base_idr, {\cf17 this}]({\cf17 const} Packet &pkt) \{\par
00169                 this->enhancement_queue_.push(\{pkt, is_base_idr\});\par
00170             \});\par
00171 \par
00172         b.resize(new_size);\par
00173 \par
00174         goReportStructure.miTimeStamp = (int)(pts);\par
00175         goReportStructure.miPictureType = iPictureType;\par
00176         goReportStructure.miBaseSize = (int)(new_size);\par
00177         goReportStructure.miEnhancementSize = (int)(data_size - new_size);\par
00178         goReportQueue.push(goReportStructure);\par
00179 \par
00180         {\cf20 // Flush any previous buffer}\par
00181         {\cf19 if} (!buffer_.empty()) \{\par
00182             push_es(buffer_.data(), buffer_.size(), pts, is_base_idr);\par
00183         \}\par
00184 \par
00185         buffer_.swap(b);\par
00186     \} {\cf19 else} \{\par
00187         {\cf20 // this comment is specifically to trigger the pipeline (and for Florian) and serves no other purpose}\par
00188         {\cf19 if} (!buffer_.empty()) \{\par
00189             push_es(buffer_.data(), buffer_.size(), pts, is_base_idr);\par
00190         \}\par
00191 \par
00192         push_es(0, 0, pts, is_base_idr);\par
00193     \}\par
00194 \}\par
