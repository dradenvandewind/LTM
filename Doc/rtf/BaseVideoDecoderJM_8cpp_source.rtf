00227 {\cf18 void} BaseVideoDecoderJM::flush() \{\par
00228 \par
00229     {\cf20 // Poke bitstream into our JM hooks}\par
00230     inject_annex_b_bitstream(base_bitstream_.data(), ({\cf18 unsigned})base_bitstream_.size());\par
00231 \par
00232     InputParameters input_parameters;\par
00233     memset(&input_parameters, 0, {\cf17 sizeof}(input_parameters));\par
00234     strcpy(input_parameters.infile, {\cf22 ""});\par
00235     strcpy(input_parameters.outfile, {\cf22 ""});\par
00236     strcpy(input_parameters.reffile, {\cf22 ""});\par
00237 \par
00238     {\cf17 const} {\cf18 char} *{\cf17 const} decoder_args[] = \{{\cf22 "ldecod"}\};\par
00239     ParseCommand(&input_parameters, ARRAY_SIZE(decoder_args), ({\cf18 char} **)decoder_args);\par
00240 \par
00241     {\cf20 // Open decoder}\par
00242     {\cf19 if} (OpenDecoder(&input_parameters) != DEC_OPEN_NOERR) \{\par
00243         ERR({\cf22 "Cannot open base decoder"});\par
00244     \}\par
00245 \par
00246     p_Dec->p_Vid->p_out = -2;\par
00247 \par
00248     {\cf20 // Run decoder}\par
00249     {\cf20 //}\par
00250     DecodedPicList *pDecPicList = 0;\par
00251     {\cf18 int} frame_count = 0;\par
00252 \par
00253     {\cf18 int} r = 0;\par
00254     {\cf19 do} \{\par
00255         r = DecodeOneFrame(&pDecPicList);\par
00256 \par
00257         {\cf19 if} (r == DEC_EOS || r == DEC_SUCCEED) \{\par
00258             decode_enhanced_frames(pDecPicList, {\cf17 false});\par
00259             frame_count++;\par
00260         \} {\cf19 else} \{\par
00261             ERR({\cf22 "Error in decoding process: 0x%x"}, r);\par
00262         \}\par
00263     \} {\cf19 while} ((r == DEC_SUCCEED) && ((p_Dec->p_Inp->iDecFrmNum == 0) || (frame_count < p_Dec->p_Inp->iDecFrmNum)));\par
00264 \par
00265     FinitDecoder(&pDecPicList);\par
00266 \par
00267     {\cf20 // Write last frame}\par
00268     decode_enhanced_frames(pDecPicList, {\cf17 true});\par
00269 \par
00270     CloseDecoder();\par
00271 \}\par
