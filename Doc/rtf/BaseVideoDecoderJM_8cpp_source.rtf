00273 {\cf18 void} BaseVideoDecoderJM::decode_enhanced_frames(DecodedPicList *pic, {\cf18 bool} all_frames) \{\par
00274     {\cf20 // Check picture and plane pointers - valid flag seems to be wrong sometimes!?}\par
00275     {\cf19 if} (!pic || !pic->pY || !pic->pU || !pic->pV) \{\par
00276         {\cf19 return};\par
00277     \}\par
00278 \par
00279     {\cf19 if} (!pic->bValid) \{\par
00280         INFO({\cf22 "Picture not marked valid?"});\par
00281     \}\par
00282 \par
00283     {\cf19 do} \{\par
00284         BasePicture base_picture = \{0\};\par
00285         base_picture.bpp = ((pic->iBitDepth + 7) >> 3);\par
00286         base_picture.width_y = pic->iWidth;\par
00287         base_picture.height_y = pic->iHeight;\par
00288         base_picture.stride_y = pic->iYBufStride;\par
00289 \par
00290         base_picture.width_uv = (pic->iYUVFormat != YUV444) ? (pic->iWidth / 2) : pic->iWidth;\par
00291         base_picture.height_uv = (pic->iYUVFormat == YUV420) ? (pic->iHeight / 2) : pic->iHeight;\par
00292         base_picture.stride_uv = pic->iUVBufStride;\par
00293 \par
00294         base_picture.data_y = pic->pY;\par
00295         base_picture.data_u = pic->pU;\par
00296         base_picture.data_v = pic->pV;\par
00297 \par
00298         {\cf20 // Get next PSS from queue}\par
00299         {\cf20 //}\par
00300         CHECK(!enhancement_queue_.empty());\par
00301         PssPacket pss = enhancement_queue_.top();\par
00302         enhancement_queue_.pop();\par
00303 \par
00304         {\cf20 // Send to enhancement decoder}\par
00305         {\cf20 //}\par
00306         PacketView enhancement_view(pss.packet);\par
00307         output_.push_base_enhancement(&base_picture, enhancement_view.data(), enhancement_view.size(), pss.packet.timestamp(),\par
00308                                       pss.is_base_idr);\par
00309 \par
00310         {\cf20 // Mark as used and move to next}\par
00311         pic->bValid = 0;\par
00312         pic = pic->pNext;\par
00313     \} {\cf19 while} (pic != NULL && pic->bValid && all_frames);\par
00314 \}\par
