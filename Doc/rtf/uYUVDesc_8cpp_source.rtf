00144 {\cf18 void} YUVDesc::Initialise(YUVFormat::Enum format, uint32_t width, uint32_t height) \{\par
00145     {\cf17 const} YUVFormatInfo &info = kFormatInfo[format];\par
00146 \par
00147     m_format = format;\par
00148     m_planeCount = info.m_planeCount;\par
00149     assert(m_planeCount <= kMaxNumPlanes);\par
00150 \par
00151     m_bitDepth = info.m_bitDepth;\par
00152     m_bitDepthContainer = (m_bitDepth + 7) & ~7;\par
00153 \par
00154     {\cf17 const} uint8_t byteDepth = GetByteDepth();\par
00155 \par
00156     {\cf19 for} (uint32_t planeIndex = 0; planeIndex < m_planeCount; ++planeIndex) \{\par
00157         {\cf17 const} uint32_t planeWidth =\par
00158             (planeIndex == 0 || (info.m_horizontalDownsample == 1)) ? width : ((width + 1) / info.m_horizontalDownsample);\par
00159         {\cf17 const} uint32_t planeHeight =\par
00160             (planeIndex == 0 || (info.m_verticalDownsample == 1)) ? height : ((height + 1) / info.m_verticalDownsample);\par
00161         m_planeDesc[planeIndex] = PlaneDesc(planeWidth, planeHeight, planeWidth, byteDepth * planeWidth);\par
00162     \}\par
00163 \par
00164     m_byteSize = (width * height * info.m_sizeMult) / info.m_sizeDiv;\par
00165 \}\par
