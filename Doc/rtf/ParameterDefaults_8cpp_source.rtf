00047 {\cf17 template} <{\cf17 typename} A, {\cf17 typename} B, {\cf18 size_t} N> B piecewise_linear({\cf17 const} std::array<A, N> &a, {\cf17 const} std::array<B, N> &b, A v) \{\par
00048     CHECK(N > 0);\par
00049 \par
00050     {\cf20 // Check top and bottom of range}\par
00051     {\cf19 if} (v <= a[0])\par
00052         {\cf19 return} b[0];\par
00053     {\cf19 if} (v >= a[N - 1])\par
00054         {\cf19 return} b[N - 1];\par
00055 \par
00056     {\cf20 // Find pair that input falls between}\par
00057     {\cf18 unsigned} i = 0;\par
00058     {\cf19 for} (i = 0; i < N - 1; ++i)\par
00059         {\cf19 if} (v < a[i + 1])\par
00060             {\cf19 break};\par
00061 \par
00062     {\cf20 // Lerp}\par
00063     {\cf19 return} int(v - a[i]) * (b[i + 1] - b[i]) / {\cf18 int}(a[i + 1] - a[i]) + b[i];\par
00064 \}\par
