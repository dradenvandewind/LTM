00104             \} {\cf19 else} {\cf19 if} (base_codec == BaseCoding_HEVC) \{\par
00105                 {\cf19 if} ((resolution <= ((10000 * 1920) + (1080))))\par
00106                     base_qp = (int)((0.012f * ({\cf18 float})(step_width_2)) - 15.5f);\par
00107                 {\cf19 else}\par
00108                     base_qp = (int)((0.0148f * ({\cf18 float})(step_width_2)) - 21.751f);\par
00109             \} {\cf19 else} {\cf19 if} (base_codec == BaseCoding_EVC) \{\par
00110                 {\cf19 if} ((resolution <= ((10000 * 1920) + (1080))))\par
00111                     base_qp = (int)((0.0068f * ({\cf18 float})(step_width_2)) + 3.9939f);\par
00112                 {\cf19 else}\par
00113                     base_qp = (int)((0.0131f * ({\cf18 float})(step_width_2)) - 16.669f);\par
00114             \} {\cf19 else} {\cf19 if} (base_codec == BaseCoding_VVC) \{\par
00115                 {\cf19 if} ((resolution <= ((10000 * 1920) + (1080))))\par
