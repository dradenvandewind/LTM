00073     {\cf17 auto} pb = Parameters::build();\par
00074 \par
00075     ParameterConfig config = p[{\cf22 "parameter_config"}].get_enum<ParameterConfig>(ParameterConfig_Default);\par
00076     {\cf19 if} (config == ParameterConfig_Default) \{\par
00077         {\cf17 const} {\cf18 unsigned} step_width_2 = p[{\cf22 "cq_step_width_loq_0"}].get<{\cf18 unsigned}>(32767);\par
00078         {\cf18 unsigned} base_qp = p[{\cf22 "qp"}].get<{\cf18 unsigned}>(28);\par
00079         {\cf18 unsigned} planes = p[{\cf22 "num_processed_planes"}].get<{\cf18 unsigned}>(1);\par
00080         {\cf17 const} {\cf18 unsigned} width = p[{\cf22 "width"}].get<{\cf18 unsigned}>(1920);\par
00081         {\cf17 const} {\cf18 unsigned} height = p[{\cf22 "height"}].get<{\cf18 unsigned}>(1080);\par
00082         {\cf17 const} {\cf18 unsigned} resolution = (10000 * width) + (height);\par
00083         BaseCoding base_codec = BaseCoding_AVC;\par
00084         {\cf19 if} (lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "hevc"}) == 0 ||\par
00085             lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "baseyuv_hevc"}) == 0)\par
00086             base_codec = BaseCoding_HEVC;\par
00087         {\cf19 else} {\cf19 if} (lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "vvc"}) == 0 ||\par
00088                  lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "baseyuv_vvc"}) == 0)\par
00089             base_codec = BaseCoding_VVC;\par
00090         {\cf19 else} {\cf19 if} (lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "evc"}) == 0 ||\par
00091                  lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "baseyuv_evc"}) == 0)\par
00092             base_codec = BaseCoding_EVC;\par
00093         {\cf19 else} {\cf19 if} (lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "x265"}) == 0 ||\par
00094                  lowercase(p[{\cf22 "base_encoder"}].get<std::string>()).compare({\cf22 "baseyuv_x265"}) == 0)\par
00095             base_codec = BaseCoding_EVC;\par
00096 \par
00097         {\cf20 // Base qp}\par
00098         {\cf19 if} (p[{\cf22 "qp"}].empty()) \{\par
