00172         m_currentBits = *m_currentNalPayload.data();\par
00173         m_remainingBits = 8;\par
00174         m_byteOffset = 0;\par
00175 \par
00176         {\cf19 switch} (nalType) \{\par
00177         {\cf19 case} BaseDecNalUnitType::VPS:\par
00178             bSuccess = ParseVPS();\par
00179             {\cf19 break};\par
00180         {\cf19 case} BaseDecNalUnitType::PPS:\par
00181             bSuccess = ParsePPS();\par
00182             {\cf19 break};\par
00183         {\cf19 case} BaseDecNalUnitType::SPS:\par
00184             bSuccess = ParseSPS();\par
00185             {\cf19 break};\par
00186         {\cf19 case} BaseDecNalUnitType::Slice:\par
00187             {\cf19 if} ((bSuccess = ParseSliceHeader())) \{\par
00188                 HandleSliceHeader();\par
00189                 HandlePictureOrderCount();\par
00190                 m_bFirstPicture = {\cf17 false};\par
00191             \}\par
00192             {\cf19 break};\par
00193         {\cf19 case} BaseDecNalUnitType::EOS:\par
00194             m_bFirstPicture = {\cf17 true};\par
00195             {\cf19 break};\par
00196         {\cf19 default}:\par
00197             {\cf19 break};\par
00198         \}\par
00199     \}\par
00200     {\cf20 // else}\par
00201     {\cf20 //    printf("BaseDecoderHEVC::ParseNalUnit [%d] --> [%s] nallenght [%d] ---->> SKIPPED\\n", m_currentNalType,}\par
00202     {\cf20 //    uToString(nalType), nalLengthIn);}\par
