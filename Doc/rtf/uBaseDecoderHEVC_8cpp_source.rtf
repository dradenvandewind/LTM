00878 {\cf18 bool} BaseDecoderHEVC::ParseShortTermRefSet(uint32_t idx) \{\par
00879     {\cf18 bool} bInterRefPicSetPrediction = {\cf17 false};\par
00880 \par
00881     {\cf19 if} (idx != 0) \{\par
00882         bInterRefPicSetPrediction = ReadFlag();\par
00883         {\cf20 // REPORT("%-40s - %8d", "inter_ref_pic_set_prediction_flag", bInterRefPicSetPrediction);}\par
00884     \}\par
00885 \par
00886     uint32_t deltaIdxMinus1 = 0;\par
00887     {\cf19 if} (bInterRefPicSetPrediction) \{\par
00888         {\cf20 // printf("Unimplemented HEVC header parsing [short-term ref]");}\par
00889         {\cf20 // throw std::runtime_error("Unimplemented HEVC header parsing [short-term ref]");}\par
00890 \par
00891         {\cf20 // printf("ParseShortTermRefSet:[%d] (bInterRefPicSetPrediction)\\n", idx);}\par
00892 \par
00893         {\cf19 if} (idx == m_activeSPS->m_numShortTermRefPicSets) \{\par
00894             deltaIdxMinus1 = ReadUE(); {\cf20 // delta_idx_minus1}\par
00895         \}\par
00896 \par
00897         uint32_t delta_rps_sign = ReadBits(1); {\cf20 // delta_rps_sign}\par
00898         {\cf20 // REPORT("%-40s - %8d", "delta_rps_sign", delta_rps_sign);}\par
00899         uint32_t abs_delta_rps_minus1 = ReadUE(); {\cf20 // abs_delta_rps_minus1}\par
00900         {\cf20 // REPORT("%-40s - %8d", "abs_delta_rps_minus1", abs_delta_rps_minus1);}\par
00901 \par
00902         uint32_t RefRpsIdx = idx - (deltaIdxMinus1 + 1);\par
00903         int32_t deltaRps = (1 - 2 * delta_rps_sign) * (abs_delta_rps_minus1 + 1);\par
00904 \par
00905         {\cf18 bool} use_delta_flag[32] = \{{\cf17 true}\};\par
00906 \par
00907         {\cf20 // REPORT("**** %4d **** %4d ****", deltaRps, m_activeSPS->m_NumDeltaPocs[RefRpsIdx]);}\par
00908 \par
00909         {\cf19 for} (uint32_t j = 0; j <= m_activeSPS->m_NumDeltaPocs[RefRpsIdx]; ++j) \{\par
00910             m_activeSPS->m_used_by_curr_pic_flag[j] = ReadFlag();\par
00911             {\cf20 // REPORT("%-40s - %8d", "used_by_curr_pic_flag", m_activeSPS->m_used_by_curr_pic_flag[j]);}\par
00912             {\cf19 if} (!m_activeSPS->m_used_by_curr_pic_flag[j]) \{\par
00913                 use_delta_flag[j] = ReadFlag();\par
00914                 {\cf20 // REPORT("%-40s - %8d", "use_delta_flag", use_delta_flag[j]);}\par
00915             \}\par
00916         \}\par
00917 \par
00918         uint32_t u = 0;\par
00919         {\cf19 for} (int32_t j = m_activeSPS->m_numPositivePics[RefRpsIdx] - 1; j >= 0; j--) \{\par
00920             int32_t dpoc = m_activeSPS->m_DeltaPocS1[RefRpsIdx][j] + deltaRps;\par
00921             uint32_t kdx = m_activeSPS->m_numNegativePics[RefRpsIdx] + j;\par
00922             {\cf19 if} (dpoc < 0 && use_delta_flag[kdx]) \{\par
00923                 m_activeSPS->m_DeltaPocS0[idx][u] = dpoc;\par
00924                 m_activeSPS->m_UsedByCurrPicS0[idx][u] = m_activeSPS->m_used_by_curr_pic_flag[kdx];\par
00925                 u++;\par
00926             \}\par
00927         \}\par
00928         uint32_t fdx = m_activeSPS->m_NumDeltaPocs[RefRpsIdx];\par
00929         {\cf19 if} (deltaRps < 0 && use_delta_flag[fdx]) \{\par
00930             m_activeSPS->m_DeltaPocS0[idx][u] = deltaRps;\par
00931             m_activeSPS->m_UsedByCurrPicS0[idx][u] = m_activeSPS->m_used_by_curr_pic_flag[fdx];\par
00932             u++;\par
00933         \}\par
00934         {\cf19 for} (uint32_t j = 0; j < m_activeSPS->m_numNegativePics[RefRpsIdx]; ++j) \{\par
00935             int32_t dpoc = m_activeSPS->m_DeltaPocS0[RefRpsIdx][j] + deltaRps;\par
00936             {\cf19 if} (dpoc < 0 && use_delta_flag[j]) \{\par
00937                 m_activeSPS->m_DeltaPocS0[idx][u] = dpoc;\par
00938                 m_activeSPS->m_UsedByCurrPicS0[idx][u] = m_activeSPS->m_used_by_curr_pic_flag[j];\par
00939                 u++;\par
00940             \}\par
00941         \}\par
00942         m_activeSPS->m_numNegativePics[idx] = u;\par
00943         {\cf20 //==========================================================================================}\par
00944         u = 0;\par
00945         {\cf19 for} (int32_t j = m_activeSPS->m_numNegativePics[RefRpsIdx] - 1; j >= 0; j--) \{\par
00946             int32_t dpoc = m_activeSPS->m_DeltaPocS0[RefRpsIdx][j] + deltaRps;\par
00947             {\cf19 if} (dpoc > 0 && use_delta_flag[j]) \{\par
00948                 m_activeSPS->m_DeltaPocS1[idx][u] = dpoc;\par
