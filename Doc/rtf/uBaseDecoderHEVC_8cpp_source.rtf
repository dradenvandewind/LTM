01086 {\cf18 bool} BaseDecoderHEVC::HandleScalingList() \{\par
01087     {\cf19 for} (uint32_t sizeId = 0; sizeId < 4; ++sizeId) \{\par
01088         uint32_t idx = ((sizeId == 3) ? 2 : 6);\par
01089         {\cf19 for} (uint32_t matrixId = 0; matrixId < idx; matrixId++) \{\par
01090             m_activeSPS->m_scaling_list_pred_mode_flag[sizeId][matrixId] = ReadFlag();\par
01091             {\cf19 if} (!m_activeSPS->m_scaling_list_pred_mode_flag[sizeId][matrixId])\par
01092                 m_activeSPS->m_scaling_list_pred_matrix_id_delta[sizeId][matrixId] = ReadUE();\par
01093             {\cf19 else} \{\par
01094                 uint32_t nextCoef = 8;\par
01095                 uint8_t coefNum = (64 > (1 << (4 + (sizeId << 1)))) ? (1 << (4 + (sizeId << 1))) : 64; {\cf20 // min function}\par
01096                 {\cf19 if} (sizeId > 1) \{\par
01097                     m_activeSPS->m_scaling_list_dc_coef_minus8[sizeId - 2][matrixId] = ReadSE();\par
01098                     nextCoef = m_activeSPS->m_scaling_list_dc_coef_minus8[sizeId - 2][matrixId] + 8;\par
01099                 \}\par
01100                 {\cf19 for} ({\cf18 int} i = 0; i < coefNum; ++i) \{\par
01101                     m_activeSPS->m_scaling_list_delta_coef = ReadSE();\par
01102                     nextCoef = (nextCoef + m_activeSPS->m_scaling_list_delta_coef + 256) % 256;\par
01103                     m_activeSPS->m_ScalingList[sizeId][matrixId][i] = nextCoef;\par
01104                 \}\par
01105             \}\par
01106         \}\par
01107     \}\par
01108 \par
01109     {\cf19 return} {\cf17 true};\par
01110 \}\par
