00303 {\cf18 void} BaseDecoderHEVC::HandlePictureOrderCount() \{\par
00304     uint32_t picOrderCntMsb = 0;\par
00305     uint32_t maxPicOrderCntLsb = 1 << m_activeSPS->m_log2MaxPicOrderCntLSB;\par
00306     HEVCNalType::Enum nalType = {\cf17 static_cast<}HEVCNalType::Enum{\cf17 >}(m_currentNalType);\par
00307 \par
00308     {\cf19 if} (isIdr(nalType)) \{\par
00309         {\cf20 // Note 1}\par
00310         m_prevTid0Pic.m_picOrderCntLsb = 0;\par
00311         m_prevTid0Pic.m_picOrderCntMsb = 0;\par
00312         m_activeSlice.m_slicePicOrderCntLSB = 0;\par
00313     \}\par
00314 \par
00315     uint32_t prevPicOrderCntLsb = m_prevTid0Pic.m_picOrderCntLsb;\par
00316     uint32_t prevPicOrderCntMsb = m_prevTid0Pic.m_picOrderCntMsb;\par
00317 \par
00318     {\cf20 // (8-1)}\par
00319     {\cf19 if} (isIrap(nalType) && m_bNoRaslOutput) \{\par
00320         picOrderCntMsb = 0;\par
00321     \} {\cf19 else} {\cf19 if} (m_activeSlice.m_slicePicOrderCntLSB < prevPicOrderCntLsb &&\par
00322                (prevPicOrderCntLsb - m_activeSlice.m_slicePicOrderCntLSB) >= (maxPicOrderCntLsb / 2)) \{\par
00323         picOrderCntMsb = prevPicOrderCntMsb + maxPicOrderCntLsb;\par
00324     \} {\cf19 else} {\cf19 if} (m_activeSlice.m_slicePicOrderCntLSB > prevPicOrderCntLsb &&\par
00325                (m_activeSlice.m_slicePicOrderCntLSB - prevPicOrderCntLsb) > (maxPicOrderCntLsb / 2)) \{\par
00326         picOrderCntMsb = prevPicOrderCntMsb - maxPicOrderCntLsb;\par
00327     \} {\cf19 else}\par
00328         picOrderCntMsb = prevPicOrderCntMsb;\par
00329 \par
00330     {\cf19 if} (!isRasl(nalType) && !isRadl(nalType) && !isSubLayerNonReferencePicture(nalType) && m_currentTemporalId == 0) \{\par
00331         m_prevTid0Pic.m_picOrderCntLsb = m_activeSlice.m_slicePicOrderCntLSB;\par
00332         m_prevTid0Pic.m_picOrderCntMsb = picOrderCntMsb;\par
00333     \}\par
00334 \par
00335     {\cf20 // (8-2)}\par
00336     m_currentPictureOrderCount = picOrderCntMsb + m_activeSlice.m_slicePicOrderCntLSB;\par
00337 \}\par
