01645 {\cf17 inline} uint32_t QuantRDOQ::xGetCodedLevelTSPred({\cf18 double}&            rd64CodedCost,\par
01646   {\cf18 double}&            rd64CodedCost0,\par
01647   {\cf18 double}&            rd64CodedCostSig,\par
01648   Intermediate_Int    levelDouble,\par
01649   {\cf18 int}                 qBits,\par
01650   {\cf18 double}              errorScale,\par
01651   uint32_t coeffLevels[],\par
01652   {\cf18 double} coeffLevelError[],\par
01653   {\cf17 const} BinFracBits* fracBitsSig,\par
01654   {\cf17 const} BinFracBits& fracBitsPar,\par
01655   CoeffCodingContext& cctx,\par
01656   {\cf17 const} FracBitsAccess& fracBitsAccess,\par
01657   {\cf17 const} BinFracBits& fracBitsSign,\par
01658   {\cf17 const} BinFracBits& fracBitsGt1,\par
01659   {\cf17 const} uint8_t      sign,\par
01660   {\cf18 int}                rightPixel,\par
01661   {\cf18 int}                belowPixel,\par
01662   uint16_t           ricePar,\par
01663   {\cf18 bool}               isLast,\par
01664   {\cf18 bool}               useLimitedPrefixLength,\par
01665   {\cf17 const} {\cf18 int}          maxLog2TrDynamicRange\par
01666   , {\cf18 int}&               numUsedCtxBins\par
01667 ){\cf17  const}\par
01668 {\cf17 }\{\par
01669   {\cf18 double} currCostSig = 0;\par
01670   uint32_t   bestAbsLevel = 0;\par
01671   numUsedCtxBins = 0;\par
01672   {\cf18 int} numBestCtxBin = 0;\par
01673   {\cf19 if} (!isLast && coeffLevels[0] < 3)\par
01674   \{\par
01675     {\cf19 if} (cctx.numCtxBins() >= 4)\par
01676       rd64CodedCostSig = xGetRateSigCoef(*fracBitsSig, 0);\par
01677     {\cf19 else}\par
01678       rd64CodedCostSig = xGetICost(1 << SCALE_BITS);\par
01679     rd64CodedCost = rd64CodedCost0 + rd64CodedCostSig;\par
01680     {\cf19 if} (cctx.numCtxBins() >= 4)\par
01681       numUsedCtxBins++;\par
01682     {\cf19 if} (coeffLevels[0] == 0)\par
01683     \{\par
01684       {\cf19 return} bestAbsLevel;\par
01685     \}\par
01686   \}\par
01687   {\cf19 else}\par
01688   \{\par
01689     rd64CodedCost = MAX_DOUBLE;\par
01690   \}\par
01691 \par
01692   {\cf19 if} (!isLast)\par
01693   \{\par
01694     {\cf19 if} (cctx.numCtxBins() >= 4)\par
01695       currCostSig = xGetRateSigCoef(*fracBitsSig, 1);\par
01696     {\cf19 else}\par
01697       currCostSig = xGetICost(1 << SCALE_BITS);\par
01698     {\cf19 if} (coeffLevels[0] >= 3 && cctx.numCtxBins() >= 4)\par
01699       numUsedCtxBins++;\par
01700   \}\par
01701 \par
01702   {\cf19 for} ({\cf18 int} errorInd = 1; errorInd <= m_testedLevels; errorInd++)\par
01703   \{\par
01704     {\cf18 int} absLevel = coeffLevels[errorInd - 1];\par
01705     {\cf18 double} dErr = 0.0;\par
01706     dErr = double(levelDouble - (Intermediate_Int(absLevel) << qBits));\par
01707     coeffLevelError[errorInd] = dErr * dErr * errorScale;\par
01708     {\cf18 int} modAbsLevel = absLevel;\par
01709     {\cf19 if} (cctx.numCtxBins() >= 4)\par
01710     \{\par
01711       modAbsLevel = cctx.deriveModCoeff(rightPixel, belowPixel, absLevel, m_bdpcm);\par
01712     \}\par
01713     {\cf18 int} numCtxBins = 0;\par
01714     {\cf18 double} dCurrCost = coeffLevelError[errorInd] + xGetICost(xGetICRateTS(modAbsLevel, fracBitsPar, cctx, fracBitsAccess, fracBitsSign, fracBitsGt1, numCtxBins, sign, ricePar, useLimitedPrefixLength, maxLog2TrDynamicRange));\par
01715 \par
01716     {\cf19 if} (cctx.numCtxBins() >= 4)\par
01717       dCurrCost += currCostSig; {\cf20 // if cctx.numCtxBins < 4, xGetICRateTS return rate including sign cost. dont need to add any more}\par
01718 \par
01719     {\cf19 if} (dCurrCost < rd64CodedCost)\par
01720     \{\par
01721       bestAbsLevel = absLevel;\par
01722       rd64CodedCost = dCurrCost;\par
01723       rd64CodedCostSig = currCostSig;\par
01724       numBestCtxBin = numCtxBins;\par
01725     \}\par
01726   \}\par
01727   numUsedCtxBins += numBestCtxBin;\par
01728   {\cf19 return} bestAbsLevel;\par
01729 \}\par
01730 \par
01731 {\cf17 inline} {\cf18 int} QuantRDOQ::xGetICRateTS( {\cf17 const} uint32_t            absLevel,\par
01732                                     {\cf17 const} BinFracBits&        fracBitsPar,\par
01733                                     {\cf17 const} CoeffCodingContext& cctx,\par
01734                                     {\cf17 const} FracBitsAccess&     fracBitsAccess,\par
01735                                     {\cf17 const} BinFracBits&        fracBitsSign,\par
01736                                     {\cf17 const} BinFracBits&        fracBitsGt1,\par
01737                                     {\cf18 int}&                      numCtxBins,\par
01738                                     {\cf17 const} uint8_t             sign,\par
01739                                     {\cf17 const} uint16_t            ricePar,\par
01740                                     {\cf17 const} {\cf18 bool}                useLimitedPrefixLength,\par
01741                                     {\cf17 const} {\cf18 int}                 maxLog2TrDynamicRange  ){\cf17  const}\par
01742 {\cf17 }\{\par
01743 \par
01744 \par
01745   {\cf19 if} (cctx.numCtxBins() < 4) {\cf20 // Full by-pass coding}\par
01746   \{\par
01747     {\cf18 int} rate = absLevel ? (1 << SCALE_BITS) : 0; {\cf20 // 1 bit to signal sign of non-zero}\par
01748 \par
01749     uint32_t symbol = absLevel;\par
01750 \par
01751     uint32_t length;\par
01752     {\cf17 const} {\cf18 int} threshold = COEF_REMAIN_BIN_REDUCTION;\par
01753     {\cf19 if} (symbol < (threshold << ricePar))\par
01754     \{\par
01755       length = symbol >> ricePar;\par
01756       rate += (length + 1 + ricePar) << SCALE_BITS;\par
01757     \}\par
01758     {\cf19 else} {\cf19 if} (useLimitedPrefixLength)\par
01759     \{\par
01760       {\cf17 const} uint32_t maximumPrefixLength = (32 - (COEF_REMAIN_BIN_REDUCTION + maxLog2TrDynamicRange));\par
01761 \par
01762       uint32_t prefixLength = 0;\par
01763       uint32_t suffix = (symbol >> ricePar) - COEF_REMAIN_BIN_REDUCTION;\par
01764 \par
01765       {\cf19 while} ((prefixLength < maximumPrefixLength) && (suffix > ((2 << prefixLength) - 2)))\par
01766       \{\par
01767         prefixLength++;\par
01768       \}\par
01769 \par
01770       {\cf17 const} uint32_t suffixLength = (prefixLength == maximumPrefixLength) ? (maxLog2TrDynamicRange - ricePar) : (prefixLength + 1{\cf20 /*separator*/});\par
01771 \par
01772       rate += (COEF_REMAIN_BIN_REDUCTION + prefixLength + suffixLength + ricePar) << SCALE_BITS;\par
01773     \}\par
01774     {\cf19 else}\par
01775     \{\par
01776       length = ricePar;\par
01777       symbol = symbol - (threshold << ricePar);\par
01778       {\cf19 while} (symbol >= (1 << length))\par
01779       \{\par
01780         symbol -= (1 << (length++));\par
01781       \}\par
01782       rate += (threshold + length + 1 - ricePar + length) << SCALE_BITS;\par
01783     \}\par
01784 \par
01785     {\cf19 return} rate;\par
01786   \}\par
01787 \par
01788   {\cf19 else} {\cf19 if} (cctx.numCtxBins() >= 4 && cctx.numCtxBins() < 8) {\cf20 // First pass context coding and all by-pass coding ( Sign flag is not counted here)}\par
01789   \{\par
01790     {\cf18 int} rate = fracBitsSign.intBits[sign]; {\cf20 // sign bits}\par
01791     {\cf19 if} (absLevel)\par
01792       numCtxBins++;\par
01793 \par
01794     {\cf19 if} (absLevel > 1)\par
01795     \{\par
01796       rate += fracBitsGt1.intBits[1];\par
01797       rate += fracBitsPar.intBits[(absLevel - 2) & 1];\par
01798 \par
01799       numCtxBins += 2;\par
01800 \par
01801       {\cf18 int} cutoffVal = 2;\par
01802 \par
01803       {\cf19 if} (absLevel >= cutoffVal)\par
01804       \{\par
01805         uint32_t symbol = (absLevel - cutoffVal) >> 1;\par
01806         uint32_t length;\par
01807         {\cf17 const} {\cf18 int} threshold = COEF_REMAIN_BIN_REDUCTION;\par
01808         {\cf19 if} (symbol < (threshold << ricePar))\par
01809         \{\par
01810           length = symbol >> ricePar;\par
01811           rate += (length + 1 + ricePar) << SCALE_BITS;\par
01812         \}\par
01813         {\cf19 else} {\cf19 if} (useLimitedPrefixLength)\par
01814         \{\par
01815           {\cf17 const} uint32_t maximumPrefixLength = (32 - (COEF_REMAIN_BIN_REDUCTION + maxLog2TrDynamicRange));\par
01816 \par
01817           uint32_t prefixLength = 0;\par
01818           uint32_t suffix = (symbol >> ricePar) - COEF_REMAIN_BIN_REDUCTION;\par
01819 \par
01820           {\cf19 while} ((prefixLength < maximumPrefixLength) && (suffix > ((2 << prefixLength) - 2)))\par
01821           \{\par
01822             prefixLength++;\par
01823           \}\par
01824 \par
01825           {\cf17 const} uint32_t suffixLength = (prefixLength == maximumPrefixLength) ? (maxLog2TrDynamicRange - ricePar) : (prefixLength + 1{\cf20 /*separator*/});\par
01826 \par
01827           rate += (COEF_REMAIN_BIN_REDUCTION + prefixLength + suffixLength + ricePar) << SCALE_BITS;\par
01828         \}\par
01829         {\cf19 else}\par
01830         \{\par
01831           length = ricePar;\par
01832           symbol = symbol - (threshold << ricePar);\par
01833           {\cf19 while} (symbol >= (1 << length))\par
01834           \{\par
01835             symbol -= (1 << (length++));\par
01836           \}\par
01837           rate += (threshold + length + 1 - ricePar + length) << SCALE_BITS;\par
01838         \}\par
01839       \}\par
01840     \}\par
01841     {\cf19 else} {\cf19 if} (absLevel == 1)\par
01842     \{\par
01843       rate += fracBitsGt1.intBits[0];\par
01844       numCtxBins++;\par
01845     \}\par
01846     {\cf19 else}\par
01847     \{\par
01848       rate = 0;\par
01849     \}\par
