01401 {\cf18 void} QuantRDOQ::forwardBDPCM(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &coeffs, TCoeff &absSum,\par
01402                              {\cf17 const} QpParam &qp, {\cf17 const} Ctx &ctx)\par
