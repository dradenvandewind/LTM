01235   uint32_t  goRiceParam = 0;\par
01236 \par
01237   {\cf18 double} *costSigSubBlock = m_pdCostCoeffGroupSig;\par
01238   memset( costSigSubBlock, 0, ( maxNumCoeff >> cctx.log2CGSize() ) * {\cf17 sizeof}( {\cf18 double} ) );\par
01239 \par
01240   {\cf17 const} {\cf18 int} sbNum = width * height >> cctx.log2CGSize();\par
01241   {\cf18 int} scanPos;\par
01242   coeffGroupRDStats rdStats;\par
01243 \par
01244   {\cf18 bool} anySigCG = {\cf17 false};\par
01245 \par
01246   {\cf18 int} maxCtxBins = (cctx.maxNumCoeff() * 7) >> 2;\par
01247   cctx.setNumCtxBins(maxCtxBins);\par
01248 \par
01249   {\cf19 for}( {\cf18 int} sbId = 0; sbId < sbNum; sbId++ )\par
01250   \{\par
01251     cctx.initSubblock( sbId );\par
01252 \par
01253     {\cf18 int} noCoeffCoded = 0;\par
01254     baseCost = 0.0;\par
01255     memset( &rdStats, 0, {\cf17 sizeof} (coeffGroupRDStats));\par
01256 \par
01257     rdStats.iNumSbbCtxBins = 0;\par
01258 \par
01259     {\cf19 for}( {\cf18 int} scanPosInSB = 0; scanPosInSB <= sbSizeM1; scanPosInSB++ )\par
01260     \{\par
