00999           uint32_t   uiPosX = uiBlkPos - ( uiPosY << uiLog2BlockWidth );\par
01000           {\cf18 double} d64CostLast  = xGetRateLast( lastBitsX, lastBitsY, uiPosX, uiPosY );\par
01001 \par
01002           {\cf18 double} totalCost = d64BaseCost + d64CostLast - pdCostSig[ iScanPos ];\par
01003 \par
01004           {\cf19 if}( totalCost < d64BestCost )\par
01005           \{\par
01006             iBestLastIdxP1  = iScanPos + 1;\par
01007             d64BestCost     = totalCost;\par
01008           \}\par
01009           {\cf19 if}( piDstCoeff[ uiBlkPos ] > 1 )\par
01010           \{\par
01011             bFoundLast = {\cf17 true};\par
01012             {\cf19 break};\par
01013           \}\par
01014           d64BaseCost      -= pdCostCoeff[ iScanPos ];\par
01015           d64BaseCost      += pdCostCoeff0[ iScanPos ];\par
01016         \}\par
01017         {\cf19 else}\par
01018         \{\par
01019           d64BaseCost      -= pdCostSig[ iScanPos ];\par
01020         \}\par
01021       \} {\cf20 //end for}\par
01022       {\cf19 if} (bFoundLast)\par
01023       \{\par
01024         {\cf19 break};\par
01025       \}\par
01026     \} {\cf20 // end if (uiSigCoeffGroupFlag[ uiCGBlkPos ])}\par
01027     DTRACE( g_trace_ctx, D_RDOQ_COST, {\cf22 "%d: %3d, %3d, %dx%d, comp=%d\\n"}, DTRACE_GET_COUNTER( g_trace_ctx, D_RDOQ_COST ), rect.x, rect.y, rect.width, rect.height, compID );\par
01028     DTRACE( g_trace_ctx, D_RDOQ_COST, {\cf22 "Uncoded=%d\\n"}, (int64_t)( d64BlockUncodedCost ) );\par
01029     DTRACE( g_trace_ctx, D_RDOQ_COST, {\cf22 "Coded  =%d\\n"}, (int64_t)( d64BaseCost ) );\par
01030 \par
01031   \} {\cf20 // end for}\par
01032 \par
01033 \par
01034   {\cf19 for} ( {\cf18 int} scanPos = 0; scanPos < iBestLastIdxP1; scanPos++ )\par
01035   \{\par
01036     {\cf18 int} blkPos = cctx.blockPos( scanPos );\par
01037     TCoeff level = piDstCoeff[ blkPos ];\par
01038     uiAbsSum += level;\par
01039     piDstCoeff[ blkPos ] = ( plSrcCoeff[ blkPos ] < 0 ) ? -level : level;\par
01040   \}\par
01041 \par
01042   {\cf20 //===== clean uncoded coefficients =====}\par
01043   {\cf19 for} ( {\cf18 int} scanPos = iBestLastIdxP1; scanPos <= iLastScanPos; scanPos++ )\par
01044   \{\par
01045     piDstCoeff[ cctx.blockPos( scanPos ) ] = 0;\par
01046   \}\par
01047 \par
01048   {\cf19 if}( cctx.signHiding() && uiAbsSum>=2)\par
01049   \{\par
01050     {\cf17 const} {\cf18 double} inverseQuantScale = double(g_invQuantScales[0][cQP.rem(isTransformSkip)]);\par
01051     int64_t rdFactor = (int64_t)(inverseQuantScale * inverseQuantScale * (1 << (2 * cQP.per(isTransformSkip))) / m_dLambda / 16\par
01052                                   / (1 << (2 * DISTORTION_PRECISION_ADJUSTMENT(channelBitDepth)))\par
01053                              + 0.5);\par
01054 \par
01055     {\cf18 int} lastCG = -1;\par
01056     {\cf18 int} absSum = 0 ;\par
01057     {\cf18 int} n ;\par
01058     {\cf19 for} ({\cf18 int} subSet = iCGNum - 1; subSet >= 0; subSet--)\par
01059     \{\par
01060       {\cf18 int}  subPos         = subSet << cctx.log2CGSize();\par
01061       {\cf18 int}  firstNZPosInCG = iCGSizeM1 + 1, lastNZPosInCG = -1;\par
01062       absSum = 0 ;\par
01063 \par
01064       {\cf19 for}( n = iCGSizeM1; n >= 0; --n )\par
01065       \{\par
01066         {\cf19 if}( piDstCoeff[ cctx.blockPos( n + subPos )] )\par
01067         \{\par
01068           lastNZPosInCG = n;\par
01069           {\cf19 break};\par
01070         \}\par
01071       \}\par
01072 \par
01073       {\cf19 for}( n = 0; n <= iCGSizeM1; n++ )\par
01074       \{\par
01075         {\cf19 if}( piDstCoeff[ cctx.blockPos( n + subPos )] )\par
01076         \{\par
01077           firstNZPosInCG = n;\par
01078           {\cf19 break};\par
01079         \}\par
01080       \}\par
01081 \par
01082       {\cf19 for}( n = firstNZPosInCG; n <= lastNZPosInCG; n++ )\par
01083       \{\par
01084         absSum += int(piDstCoeff[ cctx.blockPos( n + subPos )]);\par
01085       \}\par
01086 \par
01087       {\cf19 if}(lastNZPosInCG>=0 && lastCG==-1)\par
01088       \{\par
01089         lastCG = 1;\par
01090       \}\par
01091 \par
01092       {\cf19 if}( lastNZPosInCG-firstNZPosInCG>=SBH_THRESHOLD )\par
01093       \{\par
01094         uint32_t signbit = (piDstCoeff[cctx.blockPos(subPos+firstNZPosInCG)]>0?0:1);\par
01095         {\cf19 if}( signbit!=(absSum&0x1) )  {\cf20 // hide but need tune}\par
01096         \{\par
01097           {\cf20 // calculate the cost}\par
01098           int64_t minCostInc = std::numeric_limits<int64_t>::max(), curCost = std::numeric_limits<int64_t>::max();\par
01099           {\cf18 int} minPos = -1, finalChange = 0, curChange = 0;\par
01100 \par
01101           {\cf19 for}( n = (lastCG == 1 ? lastNZPosInCG : iCGSizeM1); n >= 0; --n )\par
01102           \{\par
01103             uint32_t uiBlkPos   = cctx.blockPos( n + subPos );\par
01104             {\cf19 if}(piDstCoeff[ uiBlkPos ] != 0 )\par
01105             \{\par
01106               int64_t costUp   = rdFactor * ( - deltaU[uiBlkPos] ) + rateIncUp[uiBlkPos];\par
01107               int64_t costDown = rdFactor * (   deltaU[uiBlkPos] ) + rateIncDown[uiBlkPos]\par
01108                 -   ((abs(piDstCoeff[uiBlkPos]) == 1) ? sigRateDelta[uiBlkPos] : 0);\par
01109 \par
01110               {\cf19 if}(lastCG==1 && lastNZPosInCG==n && abs(piDstCoeff[uiBlkPos])==1)\par
01111               \{\par
01112                 costDown -= (4<<SCALE_BITS);\par
01113               \}\par
01114 \par
01115               {\cf19 if}(costUp<costDown)\par
01116               \{\par
01117                 curCost = costUp;\par
01118                 curChange =  1;\par
01119               \}\par
01120               {\cf19 else}\par
01121               \{\par
01122                 curChange = -1;\par
01123                 {\cf19 if}(n==firstNZPosInCG && abs(piDstCoeff[uiBlkPos])==1)\par
01124                 \{\par
01125                   curCost = std::numeric_limits<int64_t>::max();\par
01126                 \}\par
01127                 {\cf19 else}\par
01128                 \{\par
01129                   curCost = costDown;\par
01130                 \}\par
01131               \}\par
01132             \}\par
01133             {\cf19 else}\par
01134             \{\par
01135               curCost = rdFactor * ( - (abs(deltaU[uiBlkPos])) ) + (1<<SCALE_BITS) + rateIncUp[uiBlkPos] + sigRateDelta[uiBlkPos] ;\par
01136               curChange = 1 ;\par
01137 \par
01138               {\cf19 if}(n<firstNZPosInCG)\par
01139               \{\par
01140                 uint32_t thissignbit = (plSrcCoeff[uiBlkPos]>=0?0:1);\par
01141                 {\cf19 if}(thissignbit != signbit )\par
01142                 \{\par
01143                   curCost = std::numeric_limits<int64_t>::max();\par
01144                 \}\par
01145               \}\par
01146             \}\par
01147 \par
01148             {\cf19 if}( curCost<minCostInc)\par
01149             \{\par
01150               minCostInc = curCost;\par
01151               finalChange = curChange;\par
01152               minPos = uiBlkPos;\par
01153             \}\par
01154           \}\par
01155 \par
01156           {\cf19 if}(piDstCoeff[minPos] == entropyCodingMaximum || piDstCoeff[minPos] == entropyCodingMinimum)\par
01157           \{\par
01158             finalChange = -1;\par
01159           \}\par
01160 \par
01161           {\cf19 if}(plSrcCoeff[minPos]>=0)\par
01162           \{\par
01163             piDstCoeff[minPos] += finalChange ;\par
01164           \}\par
01165           {\cf19 else}\par
01166           \{\par
01167             piDstCoeff[minPos] -= finalChange ;\par
01168           \}\par
01169         \}\par
01170       \}\par
01171 \par
01172       {\cf19 if}(lastCG==1)\par
01173       \{\par
01174         lastCG=0 ;\par
01175       \}\par
01176     \}\par
01177   \}\par
01178 \}\par
