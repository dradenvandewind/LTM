01631 {\cf18 void} QuantRDOQ::xDequantSample(TCoeff& pRes, TCoeff& coeff, {\cf17 const} TrQuantParams& trQuantParams)\par
01632 \{\par
01633   {\cf20 // xDequant}\par
01634   {\cf19 if} (trQuantParams.rightShift > 0)\par
01635   \{\par
01636     {\cf17 const} Intermediate_Int qAdd = Intermediate_Int(1) << (trQuantParams.rightShift - 1);\par
01637     pRes = TCoeff((Intermediate_Int(coeff) * trQuantParams.qScale + qAdd) >> trQuantParams.rightShift);\par
01638   \}\par
01639   {\cf19 else}\par
01640   \{\par
01641     pRes = TCoeff((Intermediate_Int(coeff) * trQuantParams.qScale) << -trQuantParams.rightShift);\par
01642   \}\par
01643 \}\par
