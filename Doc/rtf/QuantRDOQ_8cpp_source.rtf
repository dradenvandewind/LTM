01348       costSigSubBlock[cctx.subSetId()] = xGetRateSigCoeffGroup( fracBitsSigGroup, 0 );\par
01349       cctx.increaseNumCtxBins(rdStats.iNumSbbCtxBins); {\cf20 // skip sub-block}\par
01350     \}\par
01351     {\cf19 else} {\cf19 if}( sbId != sbNum - 1 || anySigCG )\par
01352     \{\par
