01424   {\cf17 const} uint32_t maxNumCoeff = rect.area();\par
01425 \par
01426   CHECK(compID >= MAX_NUM_TBLOCKS, {\cf22 "Invalid component ID"});\par
01427 \par
01428   {\cf18 int} scalingListType = getScalingListType(tu.cu->predMode, compID);\par
01429   CHECK(scalingListType >= SCALING_LIST_NUM, {\cf22 "Invalid scaling list"});\par
01430 \par
01431   {\cf17 const} TCoeff *srcCoeff = coeffs.buf;\par
01432   TCoeff *dstCoeff = tu.getCoeffs(compID).buf;\par
01433 \par
01434   {\cf18 double} *costCoeff = m_pdCostCoeff;\par
01435   {\cf18 double} *costSig = m_pdCostSig;\par
01436   {\cf18 double} *costCoeff0 = m_pdCostCoeff0;\par
01437 \par
01438   memset(m_pdCostCoeff, 0, {\cf17 sizeof}({\cf18 double}) *  maxNumCoeff);\par
01439   memset(m_pdCostSig, 0, {\cf17 sizeof}({\cf18 double}) *  maxNumCoeff);\par
01440   memset(m_fullCoeff, 0, {\cf17 sizeof}(TCoeff) * maxNumCoeff);\par
01441 \par
01442   m_bdpcm = dirMode;\par
01443 \par
01444   {\cf17 const} {\cf18 bool}   needsSqrt2Scale = TU::needsSqrt2Scale(tu, compID);  {\cf20 // should always be false - transform-skipped blocks don't require sqrt(2) compensation.}\par
01445   {\cf17 const} {\cf18 bool}   isTransformSkip = (tu.mtsIdx[compID] == MTS_SKIP);\par
01446   {\cf17 const} {\cf18 int}    qBits = QUANT_SHIFT + qp.per(isTransformSkip) + (isTransformSkip? 0 : transformShift) + ( needsSqrt2Scale ? -1 : 0);  {\cf20 // Right shift of non-RDOQ quantizer;  level = (coeff*uiQ + offset)>>q_bits}\par
01447   {\cf17 const} {\cf18 int}    quantisationCoefficient = g_quantScales[needsSqrt2Scale ? 1 : 0][qp.rem(isTransformSkip)];\par
01448   {\cf17 const} {\cf18 double} errorScale = xGetErrScaleCoeff(TU::needsSqrt2Scale(tu, compID), width, height, qp.rem(isTransformSkip), maxLog2TrDynamicRange, channelBitDepth, isTransformSkip);\par
01449   TrQuantParams trQuantParams;\par
01450   trQuantParams.rightShift = (IQUANT_SHIFT - ((isTransformSkip ? 0 : transformShift) + qp.per(isTransformSkip)));\par
01451   trQuantParams.qScale = g_invQuantScales[needsSqrt2Scale ? 1 : 0][qp.rem(isTransformSkip)];\par
01452 \par
01453   {\cf17 const} TCoeff entropyCodingMaximum = (1 << maxLog2TrDynamicRange) - 1;\par
01454 \par
01455   uint32_t coeffLevels[3];\par
01456   {\cf18 double}   coeffLevelError[4];\par
01457 \par
01458   CoeffCodingContext cctx(tu, compID, tu.cs->slice->getSignDataHidingEnabledFlag());\par
01459   {\cf17 const} {\cf18 int} sbSizeM1 = (1 << cctx.log2CGSize()) - 1;\par
01460   {\cf18 double}    baseCost = 0;\par
01461   uint32_t  goRiceParam = 0;\par
01462 \par
01463   {\cf18 double} *costSigSubBlock = m_pdCostCoeffGroupSig;\par
01464   memset(costSigSubBlock, 0, (maxNumCoeff >> cctx.log2CGSize()) * {\cf17 sizeof}({\cf18 double}));\par
01465 \par
01466   {\cf17 const} {\cf18 int} sbNum = width * height >> cctx.log2CGSize();\par
01467   {\cf18 int} scanPos;\par
01468   coeffGroupRDStats rdStats;\par
01469 \par
01470   {\cf18 bool} anySigCG = {\cf17 false};\par
01471 \par
01472   {\cf18 int} maxCtxBins = (cctx.maxNumCoeff() * 7) >> 2;\par
01473   cctx.setNumCtxBins(maxCtxBins);\par
01474 \par
01475   {\cf19 for} ({\cf18 int} sbId = 0; sbId < sbNum; sbId++)\par
01476   \{\par
01477     cctx.initSubblock(sbId);\par
01478 \par
01479     {\cf18 int} noCoeffCoded = 0;\par
01480     baseCost = 0.0;\par
01481     memset(&rdStats, 0, {\cf17 sizeof}(coeffGroupRDStats));\par
01482     rdStats.iNumSbbCtxBins = 0;\par
01483 \par
01484     {\cf19 for} ({\cf18 int} scanPosInSB = 0; scanPosInSB <= sbSizeM1; scanPosInSB++)\par
01485     \{\par
01486       {\cf18 int} lastPosCoded = sbSizeM1;\par
01487       scanPos = cctx.minSubPos() + scanPosInSB;\par
01488       {\cf20 //===== quantization =====}\par
01489       uint32_t blkPos = cctx.blockPos(scanPos);\par
01490 \par
01491       {\cf17 const} {\cf18 int} posX = cctx.posX(scanPos);\par
01492       {\cf17 const} {\cf18 int} posY = cctx.posY(scanPos);\par
01493       {\cf17 const} {\cf18 int} posS = (1 == dirMode) ? posX : posY;\par
01494       {\cf17 const} {\cf18 int} posNb = (1 == dirMode) ? (posX - 1) + posY * coeffs.stride : posX + (posY - 1) * coeffs.stride;\par
01495       TCoeff predCoeff = (0 != posS) ? m_fullCoeff[posNb] : 0;\par
01496 \par
01497       {\cf20 // set coeff}\par
01498       {\cf17 const} int64_t          tmpLevel = int64_t(abs(srcCoeff[blkPos] - predCoeff)) * quantisationCoefficient;\par
01499       {\cf17 const} Intermediate_Int levelDouble = (Intermediate_Int)std::min<int64_t>(tmpLevel, std::numeric_limits<Intermediate_Int>::max() - (Intermediate_Int(1) << (qBits - 1)));\par
01500       uint32_t roundAbsLevel = std::min<uint32_t>(uint32_t(entropyCodingMaximum), uint32_t((levelDouble + (Intermediate_Int(1) << (qBits - 1))) >> qBits));\par
01501       uint32_t minAbsLevel = (roundAbsLevel > 1 ? roundAbsLevel - 1 : 1);\par
01502 \par
01503       m_testedLevels = 0;\par
01504       coeffLevels[m_testedLevels++] = roundAbsLevel;\par
01505 \par
01506       {\cf19 if} (minAbsLevel != roundAbsLevel)\par
01507         coeffLevels[m_testedLevels++] = minAbsLevel;\par
01508 \par
01509       {\cf18 double} dErr = double(levelDouble);\par
01510       coeffLevelError[0]  = dErr * dErr * errorScale;\par
01511 \par
01512       costCoeff0[scanPos] = coeffLevelError[0];\par
01513       blockUncodedCost   += costCoeff0[scanPos];\par
01514       dstCoeff[blkPos]    = coeffLevels[0];\par
01515 \par
01516       {\cf20 //===== coefficient level estimation =====}\par
01517       {\cf18 unsigned}    ctxIdSig = cctx.sigCtxIdAbsTS(scanPos, dstCoeff);\par
01518       uint32_t    cLevel;\par
01519       {\cf17 const} BinFracBits fracBitsPar = fracBits.getFracBitsArray(cctx.parityCtxIdAbsTS());\par
01520 \par
01521       goRiceParam = cctx.templateAbsSumTS(scanPos, dstCoeff);\par
01522       {\cf18 unsigned} ctxIdSign = cctx.signCtxIdAbsTS(scanPos, dstCoeff, dirMode);\par
01523       {\cf17 const} BinFracBits fracBitsSign = fracBits.getFracBitsArray(ctxIdSign);\par
01524       {\cf17 const} uint8_t     sign = srcCoeff[blkPos] - predCoeff < 0 ? 1 : 0;\par
01525       {\cf18 unsigned} gt1CtxId = cctx.lrg1CtxIdAbsTS(scanPos, dstCoeff, dirMode);\par
01526       {\cf17 const} BinFracBits fracBitsGr1 = fracBits.getFracBitsArray(gt1CtxId);\par
01527 \par
01528       DTRACE_COND((dstCoeff[blkPos] != 0), g_trace_ctx, D_RDOQ_MORE, {\cf22 " uiCtxSig=%d"}, ctxIdSig);\par
01529 \par
01530       {\cf17 const} BinFracBits fracBitsSig = fracBits.getFracBitsArray(ctxIdSig);\par
01531       {\cf18 bool} lastCoeff = {\cf17 false}; {\cf20 //}\par
01532       {\cf19 if} (scanPosInSB == lastPosCoded && noCoeffCoded == 0)\par
01533       \{\par
01534         lastCoeff = {\cf17 true};\par
01535       \}\par
01536       {\cf18 int} rightPixel, belowPixel;\par
01537       cctx.neighTS(rightPixel, belowPixel, scanPos, dstCoeff);\par
01538       {\cf18 int} numUsedCtxBins = 0;\par
01539       cLevel = xGetCodedLevelTSPred(costCoeff[scanPos], costCoeff0[scanPos], costSig[scanPos], levelDouble, qBits, errorScale, coeffLevels, coeffLevelError,\par
01540         &fracBitsSig, fracBitsPar, cctx, fracBits, fracBitsSign, fracBitsGr1, sign, rightPixel, belowPixel, goRiceParam, lastCoeff, extendedPrecision, maxLog2TrDynamicRange, numUsedCtxBins);\par
01541       cctx.decimateNumCtxBins(numUsedCtxBins);\par
01542       rdStats.iNumSbbCtxBins += numUsedCtxBins;\par
01543       {\cf19 if} (cLevel > 0)\par
01544       \{\par
01545         noCoeffCoded++;\par
01546       \}\par
01547       dstCoeff[blkPos] = cLevel;\par
01548 \par
01549       {\cf19 if} (sign)\par
01550       \{\par
01551         dstCoeff[blkPos] = -dstCoeff[blkPos];\par
01552       \}\par
01553       xDequantSample( m_fullCoeff[blkPos], dstCoeff[blkPos], trQuantParams );\par
01554       m_fullCoeff[blkPos] += predCoeff;\par
01555 \par
01556       baseCost += costCoeff[scanPos];\par
01557       rdStats.d64SigCost += costSig[scanPos];\par
01558 \par
01559       {\cf19 if} (dstCoeff[blkPos])\par
01560       \{\par
01561         cctx.setSigGroup();\par
01562         rdStats.d64CodedLevelandDist += costCoeff[scanPos] - costSig[scanPos];\par
01563         rdStats.d64UncodedDist += costCoeff0[scanPos];\par
01564       \}\par
01565     \} {\cf20 //end for (iScanPosinCG)}\par
01566 \par
01567     {\cf19 if} (!cctx.isSigGroup())\par
01568     \{\par
01569       {\cf17 const} BinFracBits fracBitsSigGroup = fracBits.getFracBitsArray(cctx.sigGroupCtxId({\cf17 true}));\par
01570       baseCost += xGetRateSigCoeffGroup(fracBitsSigGroup, 0) - rdStats.d64SigCost;\par
01571       costSigSubBlock[cctx.subSetId()] = xGetRateSigCoeffGroup(fracBitsSigGroup, 0);\par
01572       cctx.increaseNumCtxBins(rdStats.iNumSbbCtxBins); {\cf20 // skip sub-block}\par
01573     \}\par
01574     {\cf19 else} {\cf19 if} (sbId != sbNum - 1 || anySigCG)\par
01575     \{\par
01576       {\cf20 // rd-cost if SigCoeffGroupFlag = 0, initialization}\par
01577       {\cf18 double} costZeroSB = baseCost;\par
01578 \par
01579       {\cf17 const} BinFracBits fracBitsSigGroup = fracBits.getFracBitsArray(cctx.sigGroupCtxId({\cf17 true}));\par
01580 \par
01581       baseCost += xGetRateSigCoeffGroup(fracBitsSigGroup, 1);\par
01582       costZeroSB += xGetRateSigCoeffGroup(fracBitsSigGroup, 0);\par
01583       costSigSubBlock[cctx.subSetId()] = xGetRateSigCoeffGroup(fracBitsSigGroup, 1);\par
01584 \par
01585       costZeroSB += rdStats.d64UncodedDist;         {\cf20 // distortion for resetting non-zero levels to zero levels}\par
01586       costZeroSB -= rdStats.d64CodedLevelandDist;   {\cf20 // distortion and level cost for keeping all non-zero levels}\par
01587       costZeroSB -= rdStats.d64SigCost;             {\cf20 // sig cost for all coeffs, including zero levels and non-zerl levels}\par
01588 \par
01589       {\cf19 if} (costZeroSB < baseCost)\par
01590       \{\par
01591         cctx.resetSigGroup();\par
01592         baseCost = costZeroSB;\par
01593         costSigSubBlock[cctx.subSetId()] = xGetRateSigCoeffGroup(fracBitsSigGroup, 0);\par
01594         cctx.increaseNumCtxBins(rdStats.iNumSbbCtxBins); {\cf20 // skip sub-block}\par
01595 \par
01596         {\cf19 for} ({\cf18 int} scanPosInSB = 0; scanPosInSB <= sbSizeM1; scanPosInSB++)\par
01597         \{\par
01598           scanPos = cctx.minSubPos() + scanPosInSB;\par
01599           uint32_t blkPos = cctx.blockPos(scanPos);\par
01600 \par
01601           {\cf17 const} {\cf18 int} posX = cctx.posX(scanPos);\par
01602           {\cf17 const} {\cf18 int} posY = cctx.posY(scanPos);\par
01603           {\cf17 const} {\cf18 int} posS = (1 == dirMode) ? posX : posY;\par
01604           {\cf17 const} {\cf18 int} posNb = (1 == dirMode) ? (posX - 1) + posY * coeffs.stride : posX + (posY - 1) * coeffs.stride;\par
01605           m_fullCoeff[scanPos] = (0 != posS) ? m_fullCoeff[posNb] : 0;\par
01606 \par
01607           {\cf19 if} (dstCoeff[blkPos])\par
01608           \{\par
01609             dstCoeff[blkPos] = 0;\par
01610             costCoeff[scanPos] = costCoeff0[scanPos];\par
01611             costSig[scanPos] = 0;\par
01612           \}\par
01613         \}\par
01614       \}\par
01615       {\cf19 else}\par
01616       \{\par
01617         anySigCG = {\cf17 true};\par
01618       \}\par
01619     \}\par
01620   \}\par
01621 \par
01622   {\cf20 //===== estimate last position =====}\par
01623   {\cf19 for} ({\cf18 int} scanPos = 0; scanPos < maxNumCoeff; scanPos++)\par
01624   \{\par
01625     {\cf18 int} blkPos = cctx.blockPos(scanPos);\par
01626     TCoeff level = dstCoeff[blkPos];\par
01627     absSum += abs(level);\par
01628   \}\par
01629 \}\par
