00372 {\cf18 double} QuantRDOQ::xGetErrScaleCoeff({\cf17 const} {\cf18 bool} needsSqrt2, SizeType width, SizeType height, {\cf18 int} qp, {\cf17 const} {\cf18 int} maxLog2TrDynamicRange, {\cf17 const} {\cf18 int} channelBitDepth, {\cf18 bool} bTransformSkip={\cf17 false})\par
00373 \{\par
00374   {\cf17 const} {\cf18 int} iTransformShift = bTransformSkip ? 0 : getTransformShift(channelBitDepth, Size(width, height), maxLog2TrDynamicRange);\par
00375   {\cf18 double}    dErrScale = (double)(1 << SCALE_BITS);                                {\cf20 // Compensate for scaling of bitcount in Lagrange cost function}\par
00376   {\cf18 double}    dTransShift = (double)iTransformShift + (needsSqrt2 ? -0.5 : 0.0);\par
00377   dErrScale = dErrScale * pow(2.0, (-2.0*dTransShift));                     {\cf20 // Compensate for scaling through forward transform}\par
00378   {\cf17 const} {\cf18 int}  QStep = g_quantScales[needsSqrt2 ? 1 : 0][qp];\par
00379   {\cf18 double}    finalErrScale = dErrScale / QStep / QStep / (1 << (DISTORTION_PRECISION_ADJUSTMENT(channelBitDepth) << 1));\par
00380   {\cf19 return}    finalErrScale;\par
00381 \}\par
