00570 {\cf18 void} QuantRDOQ::xRateDistOptQuant(TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &pSrc, TCoeff &uiAbsSum, {\cf17 const} QpParam &cQP, {\cf17 const} Ctx &ctx)\par
00571 \{\par
