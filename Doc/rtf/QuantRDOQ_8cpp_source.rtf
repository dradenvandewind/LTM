01315       \{\par
01316         lastCoeff = {\cf17 true};\par
01317       \}\par
01318       {\cf18 int} numUsedCtxBins = 0;\par
01319       cLevel = xGetCodedLevelTSPred(costCoeff[scanPos], costCoeff0[scanPos], costSig[scanPos], levelDouble, qBits, errorScale, coeffLevels, coeffLevelError,\par
