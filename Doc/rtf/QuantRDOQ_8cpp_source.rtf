01180 {\cf18 void} QuantRDOQ::xRateDistOptQuantTS( TransformUnit &tu, {\cf17 const} ComponentID &compID, {\cf17 const} CCoeffBuf &coeffs, TCoeff &absSum, {\cf17 const} QpParam &qp, {\cf17 const} Ctx &ctx )\par
