00392 {\cf18 void} QuantRDOQ::xSetErrScaleCoeff( uint32_t list, uint32_t sizeX, uint32_t sizeY, {\cf18 int} qp, {\cf17 const} {\cf18 int} maxLog2TrDynamicRange[MAX_NUM_CHANNEL_TYPE], {\cf17 const} BitDepths &bitDepths )\par
00393 \{\par
00394   {\cf17 const} {\cf18 int} width = g_scalingListSizeX[sizeX];\par
00395   {\cf17 const} {\cf18 int} height = g_scalingListSizeX[sizeY];\par
00396   {\cf17 const} ChannelType channelType = ( ( list == 0 ) || ( list == MAX_NUM_COMPONENT ) ) ? CHANNEL_TYPE_LUMA : CHANNEL_TYPE_CHROMA;\par
00397   {\cf17 const} {\cf18 int} channelBitDepth = bitDepths.recon[channelType];\par
00398   {\cf17 const} {\cf18 int} iTransformShift = getTransformShift( channelBitDepth, Size( g_scalingListSizeX[sizeX], g_scalingListSizeX[sizeY] ), maxLog2TrDynamicRange[channelType] );  {\cf20 // Represents scaling through forward transform}\par
00399 \par
00400   uint32_t i, uiMaxNumCoeff = width * height;\par
00401   {\cf18 int} *piQuantcoeff;\par
00402   {\cf18 double} *pdErrScale;\par
00403   piQuantcoeff = getQuantCoeff( list, qp, sizeX, sizeY );\par
00404   pdErrScale   = xGetErrScaleCoeffSL( list, sizeX, sizeY, qp);\par
00405 \par
00406   {\cf18 double} dErrScale = (double)( 1 << SCALE_BITS );                                {\cf20 // Compensate for scaling of bitcount in Lagrange cost function}\par
00407 \par
00408   {\cf17 const} {\cf18 bool} needsSqrt2 = ((floorLog2(width) + floorLog2(height)) & 1) == 1;\par
00409   {\cf18 double} dTransShift = (double)iTransformShift + ( needsSqrt2 ? -0.5 : 0.0 );\par
00410   dErrScale = dErrScale*pow( 2.0, ( -2.0*dTransShift ) );                     {\cf20 // Compensate for scaling through forward transform}\par
00411 \par
00412   {\cf19 for}( i = 0; i < uiMaxNumCoeff; i++ )\par
00413   \{\par
00414     pdErrScale[i] = dErrScale / piQuantcoeff[i] / piQuantcoeff[i]\par
00415                     / (1 << (DISTORTION_PRECISION_ADJUSTMENT(bitDepths.recon[channelType]) << 1));\par
00416   \}\par
00417 \par
00418   {\cf18 int} QStep = g_quantScales[needsSqrt2][qp];\par
00419 \par
00420   xGetErrScaleCoeffNoScalingList(list, sizeX, sizeY, qp) =\par
00421     dErrScale / QStep / QStep / (1 << (DISTORTION_PRECISION_ADJUSTMENT(bitDepths.recon[channelType]) << 1));\par
00422 \}\par
