01310       {\cf17 const} BinFracBits fracBitsGr1 = fracBits.getFracBitsArray(gt1CtxId);\par
01311 \par
01312       {\cf17 const} BinFracBits fracBitsSig = fracBits.getFracBitsArray( ctxIdSig );\par
01313       {\cf18 bool} lastCoeff = {\cf17 false}; {\cf20 //}\par
