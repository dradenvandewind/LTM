01265 \par
01266       {\cf20 // set coeff}\par
01267       {\cf17 const} int64_t          tmpLevel    = int64_t( abs( srcCoeff[blkPos] ) ) * quantisationCoefficient;\par
01268       {\cf17 const} Intermediate_Int levelDouble = (Intermediate_Int)std::min<int64_t>( tmpLevel, std::numeric_limits<Intermediate_Int>::max() - ( Intermediate_Int( 1 ) << ( qBits - 1 ) ) );\par
01269 \par
01270       uint32_t roundAbsLevel = std::min<uint32_t>(uint32_t(entropyCodingMaximum), uint32_t((levelDouble + (Intermediate_Int(1) << (qBits - 1))) >> qBits));\par
01271       uint32_t minAbsLevel = (roundAbsLevel > 1 ? roundAbsLevel - 1 : 1);\par
01272 \par
01273       uint32_t downAbsLevel = std::min<uint32_t>(uint32_t(entropyCodingMaximum), uint32_t(levelDouble >> qBits));\par
01274       uint32_t upAbsLevel = std::min<uint32_t>(uint32_t(entropyCodingMaximum), downAbsLevel + 1);\par
01275 \par
01276       m_testedLevels = 0;\par
01277       coeffLevels[m_testedLevels++] = roundAbsLevel;\par
