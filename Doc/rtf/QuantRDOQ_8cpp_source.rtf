00173 {\cf17 inline} {\cf18 int} QuantRDOQ::xGetICRate( {\cf17 const} uint32_t         uiAbsLevel,\par
00174                                   {\cf17 const} BinFracBits& fracBitsPar,\par
00175                                   {\cf17 const} BinFracBits& fracBitsGt1,\par
00176                                   {\cf17 const} BinFracBits& fracBitsGt2,\par
00177                                   {\cf17 const} {\cf18 int}          remRegBins,\par
00178                                   {\cf18 unsigned}           goRiceZero,\par
00179                                   {\cf17 const} uint16_t       ui16AbsGoRice,\par
