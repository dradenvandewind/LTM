01360       costSigSubBlock[ cctx.subSetId() ] = xGetRateSigCoeffGroup( fracBitsSigGroup, 1 );\par
01361 \par
01362       costZeroSB += rdStats.d64UncodedDist;         {\cf20 // distortion for resetting non-zero levels to zero levels}\par
01363       costZeroSB -= rdStats.d64CodedLevelandDist;   {\cf20 // distortion and level cost for keeping all non-zero levels}\par
01364       costZeroSB -= rdStats.d64SigCost;             {\cf20 // sig cost for all coeffs, including zero levels and non-zerl levels}\par
01365 \par
01366       {\cf19 if}( costZeroSB < baseCost )\par
01367       \{\par
01368         cctx.resetSigGroup();\par
01369         baseCost = costZeroSB;\par
01370         costSigSubBlock[ cctx.subSetId() ] = xGetRateSigCoeffGroup( fracBitsSigGroup, 0 );\par
01371         cctx.increaseNumCtxBins(rdStats.iNumSbbCtxBins); {\cf20 // skip sub-block}\par
01372         {\cf19 for}( {\cf18 int} scanPosInSB = 0; scanPosInSB <= sbSizeM1; scanPosInSB++ )\par
01373         \{\par
01374           scanPos = cctx.minSubPos() + scanPosInSB;\par
01375           uint32_t blkPos = cctx.blockPos( scanPos );\par
01376 \par
01377           {\cf19 if}( dstCoeff[ blkPos ] )\par
01378           \{\par
01379             dstCoeff[ blkPos ] = 0;\par
01380             costCoeff[ scanPos ] = costCoeff0[ scanPos ];\par
01381             costSig[ scanPos] = 0;\par
01382           \}\par
01383         \}\par
01384       \}\par
01385       {\cf19 else}\par
01386       \{\par
01387         anySigCG = {\cf17 true};\par
01388       \}\par
01389     \}\par
01390   \}\par
01391 \par
01392   {\cf20 //===== estimate last position =====}\par
01393   {\cf19 for}( {\cf18 int} scanPos = 0; scanPos < maxNumCoeff; scanPos++ )\par
01394   \{\par
01395     {\cf18 int} blkPos = cctx.blockPos( scanPos );\par
01396     TCoeff level = dstCoeff[ blkPos ];\par
