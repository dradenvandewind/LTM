00102 {\cf17 inline} uint32_t QuantRDOQ::xGetCodedLevel( {\cf18 double}&            rd64CodedCost,\par
00103                                        {\cf18 double}&            rd64CodedCost0,\par
00104                                        {\cf18 double}&            rd64CodedCostSig,\par
00105                                        Intermediate_Int   lLevelDouble,\par
00106                                        uint32_t               uiMaxAbsLevel,\par
00107                                        {\cf17 const} BinFracBits* fracBitsSig,\par
00108                                        {\cf17 const} BinFracBits& fracBitsPar,\par
00109                                        {\cf17 const} BinFracBits& fracBitsGt1,\par
00110                                        {\cf17 const} BinFracBits& fracBitsGt2,\par
00111                                        {\cf17 const} {\cf18 int}          remRegBins,\par
00112                                        {\cf18 unsigned}           goRiceZero,\par
00113                                        uint16_t             ui16AbsGoRice,\par
00114                                        {\cf18 int}                iQBits,\par
00115                                        {\cf18 double}             errorScale,\par
00116                                        {\cf18 bool}               bLast,\par
00117                                        {\cf18 bool}               useLimitedPrefixLength,\par
00118                                        {\cf17 const} {\cf18 int}          maxLog2TrDynamicRange\par
00119                                      ){\cf17  const}\par
00120 {\cf17 }\{\par
00121   {\cf18 double} dCurrCostSig   = 0;\par
00122   uint32_t   uiBestAbsLevel = 0;\par
00123 \par
00124   {\cf19 if}( !bLast && uiMaxAbsLevel < 3 )\par
00125   \{\par
00126     rd64CodedCostSig    = xGetRateSigCoef( *fracBitsSig, 0 );\par
00127     rd64CodedCost       = rd64CodedCost0 + rd64CodedCostSig;\par
00128     {\cf19 if}( uiMaxAbsLevel == 0 )\par
00129     \{\par
00130       {\cf19 return} uiBestAbsLevel;\par
00131     \}\par
00132   \}\par
00133   {\cf19 else}\par
00134   \{\par
00135     rd64CodedCost       = MAX_DOUBLE;\par
00136   \}\par
00137 \par
00138   {\cf19 if}( !bLast )\par
00139   \{\par
00140     dCurrCostSig        = xGetRateSigCoef( *fracBitsSig, 1 );\par
00141   \}\par
00142 \par
00143   uint32_t uiMinAbsLevel    = ( uiMaxAbsLevel > 1 ? uiMaxAbsLevel - 1 : 1 );\par
00144   {\cf19 for}( {\cf18 int} uiAbsLevel  = uiMaxAbsLevel; uiAbsLevel >= uiMinAbsLevel ; uiAbsLevel-- )\par
00145   \{\par
00146     {\cf18 double} dErr         = double( lLevelDouble  - ( Intermediate_Int(uiAbsLevel) << iQBits ) );\par
00147 \par
00148     {\cf18 double} dCurrCost    = dErr * dErr * errorScale + xGetICost( xGetICRate( uiAbsLevel, fracBitsPar, fracBitsGt1, fracBitsGt2, remRegBins, goRiceZero, ui16AbsGoRice, {\cf17 true}, maxLog2TrDynamicRange ) );\par
00149     dCurrCost          += dCurrCostSig;\par
00150 \par
00151     {\cf19 if}( dCurrCost < rd64CodedCost )\par
00152     \{\par
00153       uiBestAbsLevel    = uiAbsLevel;\par
00154       rd64CodedCost     = dCurrCost;\par
00155       rd64CodedCostSig  = dCurrCostSig;\par
00156     \}\par
00157   \}\par
00158 \par
00159   {\cf19 return} uiBestAbsLevel;\par
00160 \}\par
