01355 \par
01356       {\cf17 const} BinFracBits fracBitsSigGroup = fracBits.getFracBitsArray( cctx.sigGroupCtxId( {\cf17 true} ) );\par
01357 \par
01358       baseCost   += xGetRateSigCoeffGroup( fracBitsSigGroup, 1 );\par
