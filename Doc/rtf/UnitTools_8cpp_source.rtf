01852       \}\par
01853     \}\par
01854   \}\par
01855 \par
01856   {\cf19 for}( {\cf18 int} i = 0; i < pInfo->numCand; i++ )\par
01857   \{\par
01858     pInfo->mvCand[i].roundTransPrecInternal2Amvr(pu.cu->imv);\par
01859   \}\par
01860 \par
01861   {\cf19 if}( pInfo->numCand == 2 )\par
01862   \{\par
01863     {\cf19 if}( pInfo->mvCand[0] == pInfo->mvCand[1] )\par
01864     \{\par
01865       pInfo->numCand = 1;\par
01866     \}\par
01867   \}\par
01868 \par
01869   {\cf19 if} (cs.picHeader->getEnableTMVPFlag() && pInfo->numCand < AMVP_MAX_NUM_CANDS && (pu.lumaSize().width + pu.lumaSize().height > 12))\par
01870   \{\par
01871     {\cf20 // Get Temporal Motion Predictor}\par
01872     {\cf17 const} {\cf18 int} refIdx_Col = refIdx;\par
01873 \par
01874     Position posRB = pu.Y().bottomRight().offset(-3, -3);\par
01875 \par
01876     {\cf17 const} PreCalcValues& pcv = *cs.pcv;\par
01877 \par
01878     Position posC0;\par
01879     {\cf18 bool} C0Avail = {\cf17 false};\par
01880     Position posC1 = pu.Y().center();\par
01881     Mv cColMv;\par
01882 \par
01883     {\cf18 bool} boundaryCond = ((posRB.x + pcv.minCUWidth) < pcv.lumaWidth) && ((posRB.y + pcv.minCUHeight) < pcv.lumaHeight);\par
01884     {\cf17 const} SubPic &curSubPic = pu.cs->slice->getPPS()->getSubPicFromPos(pu.lumaPos());\par
01885     {\cf19 if} (curSubPic.getTreatedAsPicFlag())\par
01886     \{\par
01887       boundaryCond = ((posRB.x + pcv.minCUWidth) <= curSubPic.getSubPicRight() &&\par
01888                       (posRB.y + pcv.minCUHeight) <= curSubPic.getSubPicBottom());\par
01889     \}\par
01890     {\cf19 if} (boundaryCond)\par
01891     \{\par
01892       {\cf18 int} posYInCtu = posRB.y & pcv.maxCUHeightMask;\par
01893       {\cf19 if} (posYInCtu + 4 < pcv.maxCUHeight)\par
01894       \{\par
01895         posC0 = posRB.offset(4, 4);\par
01896         C0Avail = {\cf17 true};\par
01897       \}\par
01898     \}\par
01899     {\cf19 if} ( ( C0Avail && getColocatedMVP( pu, eRefPicList, posC0, cColMv, refIdx_Col, {\cf17 false} ) ) || getColocatedMVP( pu, eRefPicList, posC1, cColMv, refIdx_Col, {\cf17 false} ) )\par
01900     \{\par
01901       cColMv.roundTransPrecInternal2Amvr(pu.cu->imv);\par
01902       pInfo->mvCand[pInfo->numCand++] = cColMv;\par
01903     \}\par
01904   \}\par
01905 \par
01906   {\cf19 if} (pInfo->numCand < AMVP_MAX_NUM_CANDS)\par
01907   \{\par
01908     {\cf17 const} {\cf18 int} currRefPOC = cs.slice->getRefPic(eRefPicList, refIdx)->getPOC();\par
01909     addAMVPHMVPCand(pu, eRefPicList, currRefPOC, *pInfo);\par
01910   \}\par
01911 \par
01912   {\cf19 if} (pInfo->numCand > AMVP_MAX_NUM_CANDS)\par
