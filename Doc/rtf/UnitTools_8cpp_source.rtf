01839   \}\par
01840 \par
01841   {\cf20 // Above predictor search}\par
01842   \{\par
01843     {\cf18 bool} bAdded = addMVPCandUnscaled( pu, eRefPicList, refIdx, posRT, MD_ABOVE_RIGHT, *pInfo );\par
01844 \par
