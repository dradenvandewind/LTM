01667 {\cf18 void} PU::getIbcMVPsEncOnly(PredictionUnit &pu, Mv* mvPred, {\cf18 int}& nbPred)\par
01668 \{\par
01669   {\cf17 const} PreCalcValues   &pcv = *pu.cs->pcv;\par
01670   {\cf17 const} {\cf18 int}  cuWidth = pu.blocks[COMPONENT_Y].width;\par
01671   {\cf17 const} {\cf18 int}  cuHeight = pu.blocks[COMPONENT_Y].height;\par
01672   {\cf17 const} {\cf18 int}  log2UnitWidth = floorLog2(pcv.minCUWidth);\par
01673   {\cf17 const} {\cf18 int}  log2UnitHeight = floorLog2(pcv.minCUHeight);\par
01674   {\cf17 const} {\cf18 int}  totalAboveUnits = (cuWidth >> log2UnitWidth) + 1;\par
01675   {\cf17 const} {\cf18 int}  totalLeftUnits = (cuHeight >> log2UnitHeight) + 1;\par
01676 \par
01677   nbPred = 0;\par
01678   Position posLT = pu.Y().topLeft();\par
01679 \par
01680   {\cf20 // above-left}\par
01681   {\cf17 const} PredictionUnit *aboveLeftPU = pu.cs->getPURestricted(posLT.offset(-1, -1), pu, CHANNEL_TYPE_LUMA);\par
01682   {\cf19 if} (aboveLeftPU && CU::isIBC(*aboveLeftPU->cu))\par
01683   \{\par
01684     {\cf19 if} (isAddNeighborMv(aboveLeftPU->bv, mvPred, nbPred))\par
01685     \{\par
01686       mvPred[nbPred++] = aboveLeftPU->bv;\par
01687     \}\par
01688   \}\par
01689 \par
01690   {\cf20 // above neighbors}\par
01691   {\cf19 for} (uint32_t dx = 0; dx < totalAboveUnits && nbPred < IBC_NUM_CANDIDATES; dx++)\par
01692   \{\par
01693     {\cf17 const} PredictionUnit* tmpPU = pu.cs->getPURestricted(posLT.offset((dx << log2UnitWidth), -1), pu, CHANNEL_TYPE_LUMA);\par
01694     {\cf19 if} (tmpPU && CU::isIBC(*tmpPU->cu))\par
01695     \{\par
01696       {\cf19 if} (isAddNeighborMv(tmpPU->bv, mvPred, nbPred))\par
01697       \{\par
01698         mvPred[nbPred++] = tmpPU->bv;\par
01699       \}\par
01700     \}\par
01701   \}\par
01702 \par
01703   {\cf20 // left neighbors}\par
01704   {\cf19 for} (uint32_t dy = 0; dy < totalLeftUnits && nbPred < IBC_NUM_CANDIDATES; dy++)\par
01705   \{\par
01706     {\cf17 const} PredictionUnit* tmpPU = pu.cs->getPURestricted(posLT.offset(-1, (dy << log2UnitHeight)), pu, CHANNEL_TYPE_LUMA);\par
01707     {\cf19 if} (tmpPU && CU::isIBC(*tmpPU->cu))\par
01708     \{\par
01709       {\cf19 if} (isAddNeighborMv(tmpPU->bv, mvPred, nbPred))\par
01710       \{\par
01711         mvPred[nbPred++] = tmpPU->bv;\par
01712       \}\par
01713     \}\par
01714   \}\par
01715 \par
01716   {\cf18 size_t} numAvaiCandInLUT = pu.cs->motionLut.lutIbc.size();\par
01717   {\cf19 for} (uint32_t cand = 0; cand < numAvaiCandInLUT && nbPred < IBC_NUM_CANDIDATES; cand++)\par
01718   \{\par
01719     MotionInfo neibMi = pu.cs->motionLut.lutIbc[cand];\par
01720     {\cf19 if} (isAddNeighborMv(neibMi.bv, mvPred, nbPred))\par
01721     \{\par
01722       mvPred[nbPred++] = neibMi.bv;\par
01723     \}\par
01724   \}\par
01725 \par
01726   {\cf18 bool} isBvCandDerived[IBC_NUM_CANDIDATES];\par
01727   ::memset(isBvCandDerived, {\cf17 false}, IBC_NUM_CANDIDATES);\par
01728 \par
01729   {\cf18 int} curNbPred = nbPred;\par
01730   {\cf19 if} (curNbPred < IBC_NUM_CANDIDATES)\par
01731   \{\par
01732     {\cf19 do}\par
01733     \{\par
01734       curNbPred = nbPred;\par
01735       {\cf19 for} (uint32_t idx = 0; idx < curNbPred && nbPred < IBC_NUM_CANDIDATES; idx++)\par
01736       \{\par
01737         {\cf19 if} (!isBvCandDerived[idx])\par
01738         \{\par
01739           Mv derivedBv;\par
01740           {\cf19 if} (getDerivedBV(pu, mvPred[idx], derivedBv))\par
01741           \{\par
01742             {\cf19 if} (isAddNeighborMv(derivedBv, mvPred, nbPred))\par
01743             \{\par
01744               mvPred[nbPred++] = derivedBv;\par
01745             \}\par
01746           \}\par
01747           isBvCandDerived[idx] = {\cf17 true};\par
01748         \}\par
01749       \}\par
01750     \} {\cf19 while} (nbPred > curNbPred && nbPred < IBC_NUM_CANDIDATES);\par
01751   \}\par
01752 \}\par
