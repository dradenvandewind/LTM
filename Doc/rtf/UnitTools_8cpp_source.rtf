02635         {\cf19 return};\par
02636       \}\par
02637     \}\par
02638   \}\par
02639 \par
02640   {\cf19 if} ( slice.getSPS()->getUseAffine() )\par
02641   \{\par
02643     {\cf17 const} PredictionUnit* npu[5];\par
02644     {\cf18 int} numAffNeighLeft = getAvailableAffineNeighboursForLeftPredictor( pu, npu );\par
