01996 {\cf18 void} PU::xInheritedAffineMv( {\cf17 const} PredictionUnit &pu, {\cf17 const} PredictionUnit* puNeighbour, RefPicList eRefPicList, Mv rcMv[3] )\par
01997 \{\par
01998   {\cf18 int} posNeiX = puNeighbour->Y().pos().x;\par
01999   {\cf18 int} posNeiY = puNeighbour->Y().pos().y;\par
02000   {\cf18 int} posCurX = pu.Y().pos().x;\par
02001   {\cf18 int} posCurY = pu.Y().pos().y;\par
02002 \par
02003   {\cf18 int} neiW = puNeighbour->Y().width;\par
02004   {\cf18 int} curW = pu.Y().width;\par
02005   {\cf18 int} neiH = puNeighbour->Y().height;\par
02006   {\cf18 int} curH = pu.Y().height;\par
02007 \par
02008   Mv mvLT, mvRT, mvLB;\par
02009   mvLT = puNeighbour->mvAffi[eRefPicList][0];\par
02010   mvRT = puNeighbour->mvAffi[eRefPicList][1];\par
02011   mvLB = puNeighbour->mvAffi[eRefPicList][2];\par
02012 \par
02013   {\cf18 bool} isTopCtuBoundary = {\cf17 false};\par
02014   {\cf19 if} ( (posNeiY + neiH) % pu.cs->sps->getCTUSize() == 0 && (posNeiY + neiH) == posCurY )\par
02015   \{\par
02016     {\cf20 // use bottom-left and bottom-right sub-block MVs for inheritance}\par
02017     {\cf17 const} Position posRB = puNeighbour->Y().bottomRight();\par
02018     {\cf17 const} Position posLB = puNeighbour->Y().bottomLeft();\par
02019     mvLT = puNeighbour->getMotionInfo( posLB ).mv[eRefPicList];\par
02020     mvRT = puNeighbour->getMotionInfo( posRB ).mv[eRefPicList];\par
02021     posNeiY += neiH;\par
02022     isTopCtuBoundary = {\cf17 true};\par
02023   \}\par
02024 \par
02025   {\cf18 int} shift = MAX_CU_DEPTH;\par
02026   {\cf18 int} iDMvHorX, iDMvHorY, iDMvVerX, iDMvVerY;\par
02027 \par
02028   iDMvHorX = (mvRT - mvLT).getHor() << (shift - floorLog2(neiW));\par
02029   iDMvHorY = (mvRT - mvLT).getVer() << (shift - floorLog2(neiW));\par
02030   {\cf19 if} ( puNeighbour->cu->affineType == AFFINEMODEL_6PARAM && !isTopCtuBoundary )\par
02031   \{\par
02032     iDMvVerX = (mvLB - mvLT).getHor() << (shift - floorLog2(neiH));\par
02033     iDMvVerY = (mvLB - mvLT).getVer() << (shift - floorLog2(neiH));\par
02034   \}\par
02035   {\cf19 else}\par
02036   \{\par
02037     iDMvVerX = -iDMvHorY;\par
02038     iDMvVerY = iDMvHorX;\par
02039   \}\par
02040 \par
02041   {\cf18 int} iMvScaleHor = mvLT.getHor() << shift;\par
02042   {\cf18 int} iMvScaleVer = mvLT.getVer() << shift;\par
02043   {\cf18 int} horTmp, verTmp;\par
02044 \par
02045   {\cf20 // v0}\par
02046   horTmp = iMvScaleHor + iDMvHorX * (posCurX - posNeiX) + iDMvVerX * (posCurY - posNeiY);\par
02047   verTmp = iMvScaleVer + iDMvHorY * (posCurX - posNeiX) + iDMvVerY * (posCurY - posNeiY);\par
02048   roundAffineMv( horTmp, verTmp, shift );\par
02049   rcMv[0].hor = horTmp;\par
02050   rcMv[0].ver = verTmp;\par
02051   rcMv[0].clipToStorageBitDepth();\par
02052 \par
02053   {\cf20 // v1}\par
02054   horTmp = iMvScaleHor + iDMvHorX * (posCurX + curW - posNeiX) + iDMvVerX * (posCurY - posNeiY);\par
02055   verTmp = iMvScaleVer + iDMvHorY * (posCurX + curW - posNeiX) + iDMvVerY * (posCurY - posNeiY);\par
02056   roundAffineMv( horTmp, verTmp, shift );\par
02057   rcMv[1].hor = horTmp;\par
02058   rcMv[1].ver = verTmp;\par
02059   rcMv[1].clipToStorageBitDepth();\par
02060 \par
02061   {\cf20 // v2}\par
02062   {\cf19 if} ( pu.cu->affineType == AFFINEMODEL_6PARAM )\par
02063   \{\par
02064     horTmp = iMvScaleHor + iDMvHorX * (posCurX - posNeiX) + iDMvVerX * (posCurY + curH - posNeiY);\par
02065     verTmp = iMvScaleVer + iDMvHorY * (posCurX - posNeiX) + iDMvVerY * (posCurY + curH - posNeiY);\par
02066     roundAffineMv( horTmp, verTmp, shift );\par
02067     rcMv[2].hor = horTmp;\par
02068     rcMv[2].ver = verTmp;\par
02069     rcMv[2].clipToStorageBitDepth();\par
02070   \}\par
02071 \}\par
02072 \par
