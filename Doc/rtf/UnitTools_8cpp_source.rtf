02627         {\cf19 return};\par
02628       \}\par
02629 \par
02630       affMrgCtx.numValidMergeCand++;\par
02631 \par
02632       {\cf20 // early termination}\par
02633       {\cf19 if} ( affMrgCtx.numValidMergeCand == maxNumAffineMergeCand )\par
