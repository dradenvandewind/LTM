00791 {\cf18 int} PU::getWideAngle( {\cf17 const} TransformUnit &tu, {\cf17 const} uint32_t dirMode, {\cf17 const} ComponentID compID )\par
00792 \{\par
00793   {\cf20 //This function returns a wide angle index taking into account that the values 0 and 1 are reserved }\par
00794   {\cf20 //for Planar and DC respectively, as defined in the Spec. Text.}\par
00795   {\cf19 if}( dirMode < 2 )\par
00796   \{\par
00797     {\cf19 return} ( {\cf18 int} ) dirMode;\par
00798   \}\par
00799 \par
00800   {\cf17 const} CompArea&  area         = tu.cu->ispMode && isLuma(compID) ? tu.cu->blocks[compID] : tu.blocks[ compID ];\par
00801   {\cf18 int}              width        = area.width;\par
00802   {\cf18 int}              height       = area.height;\par
00803   {\cf18 int}              modeShift[ ] = \{ 0, 6, 10, 12, 14, 15 \};\par
00804   {\cf18 int}              deltaSize    = abs( floorLog2( width ) - floorLog2( height ) );\par
00805   {\cf18 int}              predMode     = dirMode;\par
00806 \par
00807   {\cf19 if}( width > height && dirMode < 2 + modeShift[ deltaSize ] )\par
00808   \{\par
00809     predMode += ( VDIA_IDX - 1 );\par
00810   \}\par
00811   {\cf19 else} {\cf19 if}( height > width && predMode > VDIA_IDX - modeShift[ deltaSize ] )\par
00812   \{\par
00813     predMode -= ( VDIA_IDX + 1 );\par
00814   \}\par
00815 \par
00816   {\cf19 return} predMode;\par
00817 \}\par
00818 \par
00819 {\cf18 bool} PU::addMergeHMVPCand({\cf17 const} CodingStructure &cs, MergeCtx &mrgCtx, {\cf17 const} {\cf18 int} &mrgCandIdx,\par
00820                           {\cf17 const} uint32_t maxNumMergeCandMin1, {\cf18 int} &cnt, {\cf17 const} {\cf18 bool} isAvailableA1,\par
00821                           {\cf17 const} MotionInfo miLeft, {\cf17 const} {\cf18 bool} isAvailableB1, {\cf17 const} MotionInfo miAbove,\par
00822                           {\cf17 const} {\cf18 bool} ibcFlag, {\cf17 const} {\cf18 bool} isGt4x4)\par
00823 \{\par
00824   {\cf17 const} Slice& slice = *cs.slice;\par
00825   MotionInfo miNeighbor;\par
00826 \par
00827   {\cf17 auto} &lut = ibcFlag ? cs.motionLut.lutIbc : cs.motionLut.lut;\par
00828   {\cf18 int} num_avai_candInLUT = (int)lut.size();\par
00829 \par
00830   {\cf19 for} ({\cf18 int} mrgIdx = 1; mrgIdx <= num_avai_candInLUT; mrgIdx++)\par
00831   \{\par
00832     miNeighbor = lut[num_avai_candInLUT - mrgIdx];\par
00833 \par
00834     {\cf19 if} ( mrgIdx > 2 || ((mrgIdx > 1 || !isGt4x4) && ibcFlag)\par
00835       || ((!isAvailableA1 || (miLeft != miNeighbor)) && (!isAvailableB1 || (miAbove != miNeighbor))) )\par
00836     \{\par
00837       mrgCtx.interDirNeighbours[cnt] = miNeighbor.interDir;\par
00838       mrgCtx.useAltHpelIf      [cnt] = !ibcFlag && miNeighbor.useAltHpelIf;\par
00839       mrgCtx.BcwIdx            [cnt] = (miNeighbor.interDir == 3) ? miNeighbor.BcwIdx : BCW_DEFAULT;\par
00840 \par
00841       mrgCtx.mvFieldNeighbours[cnt << 1].setMvField(miNeighbor.mv[0], miNeighbor.refIdx[0]);\par
00842       {\cf19 if} (slice.isInterB())\par
00843       \{\par
00844         mrgCtx.mvFieldNeighbours[(cnt << 1) + 1].setMvField(miNeighbor.mv[1], miNeighbor.refIdx[1]);\par
00845       \}\par
00846 \par
00847       {\cf19 if} (mrgCandIdx == cnt)\par
00848       \{\par
00849         {\cf19 return} {\cf17 true};\par
00850       \}\par
00851       cnt ++;\par
00852 \par
00853       {\cf19 if} (cnt  == maxNumMergeCandMin1)\par
00854       \{\par
00855         {\cf19 break};\par
00856       \}\par
00857     \}\par
00858   \}\par
00859 \par
00860   {\cf19 if} (cnt < maxNumMergeCandMin1)\par
00861   \{\par
00862     mrgCtx.useAltHpelIf[cnt] = {\cf17 false};\par
00863   \}\par
00864 \par
00865   {\cf19 return} {\cf17 false};\par
00866 \}\par
00867 \par
00868 {\cf18 void} PU::getIBCMergeCandidates({\cf17 const} PredictionUnit &pu, MergeCtx& mrgCtx, {\cf17 const} {\cf18 int}& mrgCandIdx)\par
00869 \{\par
00870   {\cf17 const} CodingStructure &cs = *pu.cs;\par
00871   {\cf17 const} uint32_t maxNumMergeCand = pu.cs->sps->getMaxNumIBCMergeCand();\par
00872   {\cf19 for} (uint32_t ui = 0; ui < maxNumMergeCand; ++ui)\par
00873   \{\par
00874     mrgCtx.BcwIdx[ui] = BCW_DEFAULT;\par
00875     mrgCtx.interDirNeighbours[ui] = 0;\par
00876     mrgCtx.mrgTypeNeighbours[ui] = MRG_TYPE_IBC;\par
00877     mrgCtx.mvFieldNeighbours[ui * 2].refIdx = NOT_VALID;\par
00878     mrgCtx.mvFieldNeighbours[ui * 2 + 1].refIdx = NOT_VALID;\par
00879     mrgCtx.useAltHpelIf[ui] = {\cf17 false};\par
00880   \}\par
00881 \par
00882   mrgCtx.numValidMergeCand = maxNumMergeCand;\par
00883   {\cf20 // compute the location of the current PU}\par
00884 \par
00885   {\cf18 int} cnt = 0;\par
00886 \par
00887   {\cf17 const} Position posRT = pu.Y().topRight();\par
00888   {\cf17 const} Position posLB = pu.Y().bottomLeft();\par
00889 \par
00890   MotionInfo miAbove, miLeft, miAboveLeft, miAboveRight, miBelowLeft;\par
00891 \par
00892   {\cf20 //left}\par
00893   {\cf17 const} PredictionUnit* puLeft = cs.getPURestricted(posLB.offset(-1, 0), pu, pu.chType);\par
00894   {\cf18 bool} isGt4x4 = pu.lwidth() * pu.lheight() > 16;\par
00895   {\cf17 const} {\cf18 bool} isAvailableA1 = puLeft && pu.cu != puLeft->cu && CU::isIBC(*puLeft->cu);\par
00896   {\cf19 if} (isGt4x4 && isAvailableA1)\par
00897   \{\par
00898     miLeft = puLeft->getMotionInfo(posLB.offset(-1, 0));\par
00899 \par
00900     {\cf20 // get Inter Dir}\par
00901     mrgCtx.interDirNeighbours[cnt] = miLeft.interDir;\par
00902     {\cf20 // get Mv from Left}\par
00903     mrgCtx.mvFieldNeighbours[cnt << 1].setMvField(miLeft.mv[0], miLeft.refIdx[0]);\par
00904     {\cf19 if} (mrgCandIdx == cnt)\par
00905     \{\par
00906       {\cf19 return};\par
00907     \}\par
00908     cnt++;\par
00909   \}\par
00910 \par
00911   {\cf20 // early termination}\par
00912   {\cf19 if} (cnt == maxNumMergeCand)\par
00913   \{\par
00914     {\cf19 return};\par
00915   \}\par
00916 \par
00917   {\cf20 // above}\par
00918   {\cf17 const} PredictionUnit *puAbove = cs.getPURestricted(posRT.offset(0, -1), pu, pu.chType);\par
00919   {\cf18 bool} isAvailableB1 = puAbove && pu.cu != puAbove->cu && CU::isIBC(*puAbove->cu);\par
00920   {\cf19 if} (isGt4x4 && isAvailableB1)\par
00921   \{\par
00922     miAbove = puAbove->getMotionInfo(posRT.offset(0, -1));\par
00923 \par
00924     {\cf19 if} (!isAvailableA1 || (miAbove != miLeft))\par
00925     \{\par
00926       {\cf20 // get Inter Dir}\par
00927       mrgCtx.interDirNeighbours[cnt] = miAbove.interDir;\par
00928       {\cf20 // get Mv from Above}\par
00929       mrgCtx.mvFieldNeighbours[cnt << 1].setMvField(miAbove.mv[0], miAbove.refIdx[0]);\par
00930       {\cf19 if} (mrgCandIdx == cnt)\par
00931       \{\par
00932         {\cf19 return};\par
00933       \}\par
00934 \par
00935       cnt++;\par
00936     \}\par
00937   \}\par
00938 \par
00939   {\cf20 // early termination}\par
00940   {\cf19 if} (cnt == maxNumMergeCand)\par
00941   \{\par
00942     {\cf19 return};\par
00943   \}\par
00944 \par
00945   {\cf19 if} (cnt != maxNumMergeCand)\par
00946   \{\par
00947     {\cf18 bool} bFound = addMergeHMVPCand(cs, mrgCtx, mrgCandIdx, maxNumMergeCand, cnt, isAvailableA1, miLeft, isAvailableB1,\par
00948                                    miAbove, {\cf17 true}, isGt4x4);\par
00949 \par
00950     {\cf19 if} (bFound)\par
00951     \{\par
00952       {\cf19 return};\par
00953     \}\par
00954   \}\par
00955 \par
00956     {\cf19 while} (cnt < maxNumMergeCand)\par
00957     \{\par
00958       mrgCtx.mvFieldNeighbours[cnt * 2].setMvField(Mv(0, 0), MAX_NUM_REF);\par
