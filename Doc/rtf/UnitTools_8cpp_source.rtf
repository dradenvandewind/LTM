00563 \par
00564 {\cf18 int} PU::getIntraMPMs( {\cf17 const} PredictionUnit &pu, {\cf18 unsigned}* mpm, {\cf17 const} ChannelType &channelType {\cf20 /*= CHANNEL_TYPE_LUMA*/} )\par
00565 \{\par
00566   {\cf17 const} {\cf18 int} numMPMs = NUM_MOST_PROBABLE_MODES;\par
00567   \{\par
00568     CHECK(channelType != CHANNEL_TYPE_LUMA, {\cf22 "Not harmonized yet"});\par
00569     {\cf18 int} numCand      = -1;\par
00570     {\cf18 int} leftIntraDir = PLANAR_IDX, aboveIntraDir = PLANAR_IDX;\par
00571 \par
00572     {\cf17 const} CompArea &area = pu.block(getFirstComponentOfChannel(channelType));\par
00573     {\cf17 const} Position posRT = area.topRight();\par
00574     {\cf17 const} Position posLB = area.bottomLeft();\par
00575 \par
00576     {\cf20 // Get intra direction of left PU}\par
00577     {\cf17 const} PredictionUnit *puLeft = pu.cs->getPURestricted(posLB.offset(-1, 0), pu, channelType);\par
00578     {\cf19 if} (puLeft && CU::isIntra(*puLeft->cu))\par
00579     \{\par
00580       leftIntraDir = PU::getIntraDirLuma( *puLeft );\par
00581     \}\par
00582 \par
00583     {\cf20 // Get intra direction of above PU}\par
00584     {\cf17 const} PredictionUnit *puAbove = pu.cs->getPURestricted(posRT.offset(0, -1), pu, channelType);\par
00585     {\cf19 if} (puAbove && CU::isIntra(*puAbove->cu) && CU::isSameCtu(*pu.cu, *puAbove->cu))\par
00586     \{\par
00587       aboveIntraDir = PU::getIntraDirLuma( *puAbove );\par
00588     \}\par
00589 \par
00590     CHECK(2 >= numMPMs, {\cf22 "Invalid number of most probable modes"});\par
00591 \par
00592     {\cf17 const} {\cf18 int} offset = (int)NUM_LUMA_MODE - 6;\par
00593     {\cf17 const} {\cf18 int} mod = offset + 3;\par
00594 \par
00595     mpm[0] = PLANAR_IDX;\par
00596     mpm[1] = DC_IDX;\par
00597     mpm[2] = VER_IDX;\par
00598     mpm[3] = HOR_IDX;\par
00599     mpm[4] = VER_IDX - 4;\par
00600     mpm[5] = VER_IDX + 4;\par
00601 \par
00602     {\cf19 if} (leftIntraDir == aboveIntraDir)\par
00603     \{\par
00604       numCand = 1;\par
00605       {\cf19 if} (leftIntraDir > DC_IDX)\par
00606       \{\par
00607         mpm[0] = PLANAR_IDX;\par
00608         mpm[1] = leftIntraDir;\par
00609         mpm[2] = ((leftIntraDir + offset) % mod) + 2;\par
00610         mpm[3] = ((leftIntraDir - 1) % mod) + 2;\par
00611         mpm[4] = ((leftIntraDir + offset - 1) % mod) + 2;\par
00612         mpm[5] = (leftIntraDir % mod) + 2;\par
00613       \}\par
00614     \}\par
00615     {\cf19 else}   {\cf20 // L!=A}\par
00616     \{\par
00617       numCand            = 2;\par
00618       {\cf18 int} maxCandModeIdx = mpm[0] > mpm[1] ? 0 : 1;\par
00619 \par
00620       {\cf19 if} ((leftIntraDir > DC_IDX) && (aboveIntraDir > DC_IDX))\par
00621       \{\par
00622         mpm[0]             = PLANAR_IDX;\par
00623         mpm[1]             = leftIntraDir;\par
00624         mpm[2]             = aboveIntraDir;\par
00625         maxCandModeIdx     = mpm[1] > mpm[2] ? 1 : 2;\par
00626         {\cf18 int} minCandModeIdx = mpm[1] > mpm[2] ? 2 : 1;\par
00627         {\cf19 if} (mpm[maxCandModeIdx] - mpm[minCandModeIdx] == 1)\par
00628         \{\par
00629           mpm[3] = ((mpm[minCandModeIdx] + offset) % mod) + 2;\par
00630           mpm[4] = ((mpm[maxCandModeIdx] - 1) % mod) + 2;\par
00631           mpm[5] = ((mpm[minCandModeIdx] + offset - 1) % mod) + 2;\par
00632         \}\par
00633         {\cf19 else} {\cf19 if} (mpm[maxCandModeIdx] - mpm[minCandModeIdx] >= 62)\par
00634         \{\par
00635           mpm[3] = ((mpm[minCandModeIdx] - 1) % mod) + 2;\par
00636           mpm[4] = ((mpm[maxCandModeIdx] + offset) % mod) + 2;\par
00637           mpm[5] = (mpm[minCandModeIdx] % mod) + 2;\par
00638         \}\par
00639         {\cf19 else} {\cf19 if} (mpm[maxCandModeIdx] - mpm[minCandModeIdx] == 2)\par
00640         \{\par
00641           mpm[3] = ((mpm[minCandModeIdx] - 1) % mod) + 2;\par
00642           mpm[4] = ((mpm[minCandModeIdx] + offset) % mod) + 2;\par
00643           mpm[5] = ((mpm[maxCandModeIdx] - 1) % mod) + 2;\par
00644         \}\par
00645         {\cf19 else}\par
00646         \{\par
00647           mpm[3] = ((mpm[minCandModeIdx] + offset) % mod) + 2;\par
00648           mpm[4] = ((mpm[minCandModeIdx] - 1) % mod) + 2;\par
00649           mpm[5] = ((mpm[maxCandModeIdx] + offset) % mod) + 2;\par
00650         \}\par
00651       \}\par
00652       {\cf19 else} {\cf19 if} (leftIntraDir + aboveIntraDir >= 2)\par
00653       \{\par
00654         mpm[0]         = PLANAR_IDX;\par
00655         mpm[1]         = (leftIntraDir < aboveIntraDir) ? aboveIntraDir : leftIntraDir;\par
00656         maxCandModeIdx = 1;\par
00657         mpm[2]         = ((mpm[maxCandModeIdx] + offset) % mod) + 2;\par
00658         mpm[3]         = ((mpm[maxCandModeIdx] - 1) % mod) + 2;\par
00659         mpm[4]         = ((mpm[maxCandModeIdx] + offset - 1) % mod) + 2;\par
00660         mpm[5]         = (mpm[maxCandModeIdx] % mod) + 2;\par
00661       \}\par
00662     \}\par
00663     {\cf19 for} ({\cf18 int} i = 0; i < numMPMs; i++)\par
00664     \{\par
00665       CHECK(mpm[i] >= NUM_LUMA_MODE, {\cf22 "Invalid MPM"});\par
00666     \}\par
00667     CHECK(numCand == 0, {\cf22 "No candidates found"});\par
00668     {\cf19 return} numCand;\par
00669   \}\par
00670 \}\par
