02869 {\cf18 void} PU::setAllAffineMv(PredictionUnit& pu, Mv affLT, Mv affRT, Mv affLB, RefPicList eRefList, {\cf18 bool} clipCPMVs)\par
02870 \{\par
02871   {\cf18 int} width  = pu.Y().width;\par
02872   {\cf18 int} shift = MAX_CU_DEPTH;\par
02873   {\cf19 if} (clipCPMVs)\par
02874   \{\par
02875     affLT.mvCliptoStorageBitDepth();\par
02876     affRT.mvCliptoStorageBitDepth();\par
02877     {\cf19 if} (pu.cu->affineType == AFFINEMODEL_6PARAM)\par
02878     \{\par
02879       affLB.mvCliptoStorageBitDepth();\par
02880     \}\par
02881   \}\par
02882   {\cf18 int} deltaMvHorX, deltaMvHorY, deltaMvVerX, deltaMvVerY;\par
02883   deltaMvHorX = (affRT - affLT).getHor() << (shift - floorLog2(width));\par
02884   deltaMvHorY = (affRT - affLT).getVer() << (shift - floorLog2(width));\par
02885   {\cf18 int} height = pu.Y().height;\par
02886   {\cf19 if} ( pu.cu->affineType == AFFINEMODEL_6PARAM )\par
02887   \{\par
02888     deltaMvVerX = (affLB - affLT).getHor() << (shift - floorLog2(height));\par
02889     deltaMvVerY = (affLB - affLT).getVer() << (shift - floorLog2(height));\par
02890   \}\par
02891   {\cf19 else}\par
02892   \{\par
02893     deltaMvVerX = -deltaMvHorY;\par
02894     deltaMvVerY = deltaMvHorX;\par
02895   \}\par
02896 \par
02897   {\cf18 int} mvScaleHor = affLT.getHor() << shift;\par
02898   {\cf18 int} mvScaleVer = affLT.getVer() << shift;\par
02899 \par
02900   {\cf18 int} blockWidth = AFFINE_MIN_BLOCK_SIZE;\par
02901   {\cf18 int} blockHeight = AFFINE_MIN_BLOCK_SIZE;\par
02902   {\cf17 const} {\cf18 int} halfBW = blockWidth >> 1;\par
02903   {\cf17 const} {\cf18 int} halfBH = blockHeight >> 1;\par
02904 \par
02905   MotionBuf mb = pu.getMotionBuf();\par
02906   {\cf18 int} mvScaleTmpHor, mvScaleTmpVer;\par
02907   {\cf17 const} {\cf18 bool} subblkMVSpreadOverLimit = InterPrediction::isSubblockVectorSpreadOverLimit( deltaMvHorX, deltaMvHorY, deltaMvVerX, deltaMvVerY, pu.interDir );\par
02908   {\cf19 for} ( {\cf18 int} h = 0; h < pu.Y().height; h += blockHeight )\par
02909   \{\par
02910     {\cf19 for} ( {\cf18 int} w = 0; w < pu.Y().width; w += blockWidth )\par
02911     \{\par
02912       {\cf19 if} ( !subblkMVSpreadOverLimit )\par
02913       \{\par
02914         mvScaleTmpHor = mvScaleHor + deltaMvHorX * (halfBW + w) + deltaMvVerX * (halfBH + h);\par
02915         mvScaleTmpVer = mvScaleVer + deltaMvHorY * (halfBW + w) + deltaMvVerY * (halfBH + h);\par
02916       \}\par
02917       {\cf19 else}\par
02918       \{\par
02919         mvScaleTmpHor = mvScaleHor + deltaMvHorX * ( pu.Y().width >> 1 ) + deltaMvVerX * ( pu.Y().height >> 1 );\par
02920         mvScaleTmpVer = mvScaleVer + deltaMvHorY * ( pu.Y().width >> 1 ) + deltaMvVerY * ( pu.Y().height >> 1 );\par
02921       \}\par
02922       roundAffineMv( mvScaleTmpHor, mvScaleTmpVer, shift );\par
02923       Mv curMv(mvScaleTmpHor, mvScaleTmpVer);\par
02924       curMv.clipToStorageBitDepth();\par
02925 \par
02926       {\cf19 for} ( {\cf18 int} y = (h >> MIN_CU_LOG2); y < ((h + blockHeight) >> MIN_CU_LOG2); y++ )\par
02927       \{\par
02928         {\cf19 for} ( {\cf18 int} x = (w >> MIN_CU_LOG2); x < ((w + blockWidth) >> MIN_CU_LOG2); x++ )\par
02929         \{\par
02930           mb.at(x, y).mv[eRefList] = curMv;\par
02931         \}\par
02932       \}\par
02933     \}\par
02934   \}\par
02935 \par
02936   pu.mvAffi[eRefList][0] = affLT;\par
02937   pu.mvAffi[eRefList][1] = affRT;\par
02938   pu.mvAffi[eRefList][2] = affLB;\par
02939 \}\par
