03345 {\cf18 void} PU::spanGeoMotionInfo( PredictionUnit &pu, MergeCtx &geoMrgCtx, {\cf17 const} uint8_t splitDir, {\cf17 const} uint8_t candIdx0, {\cf17 const} uint8_t candIdx1)\par
03346 \{\par
03347   pu.geoSplitDir  = splitDir;\par
03348   pu.geoMergeIdx0 = candIdx0;\par
03349   pu.geoMergeIdx1 = candIdx1;\par
03350   MotionBuf mb = pu.getMotionBuf();\par
03351 \par
03352   MotionInfo biMv;\par
03353   biMv.isInter  = {\cf17 true};\par
03354   biMv.sliceIdx = pu.cs->slice->getIndependentSliceIdx();\par
03355 \par
03356   {\cf19 if}( geoMrgCtx.interDirNeighbours[candIdx0] == 1 && geoMrgCtx.interDirNeighbours[candIdx1] == 2 )\par
03357   \{\par
03358     biMv.interDir  = 3;\par
03359     biMv.mv[0]     = geoMrgCtx.mvFieldNeighbours[ candIdx0 << 1     ].mv;\par
03360     biMv.mv[1]     = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].mv;\par
03361     biMv.refIdx[0] = geoMrgCtx.mvFieldNeighbours[ candIdx0 << 1     ].refIdx;\par
03362     biMv.refIdx[1] = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].refIdx;\par
03363   \}\par
03364   {\cf19 else} {\cf19 if}( geoMrgCtx.interDirNeighbours[candIdx0] == 2 && geoMrgCtx.interDirNeighbours[candIdx1] == 1 )\par
03365   \{\par
03366     biMv.interDir  = 3;\par
03367     biMv.mv[0]     = geoMrgCtx.mvFieldNeighbours[ candIdx1 << 1     ].mv;\par
03368     biMv.mv[1]     = geoMrgCtx.mvFieldNeighbours[(candIdx0 << 1) + 1].mv;\par
03369     biMv.refIdx[0] = geoMrgCtx.mvFieldNeighbours[ candIdx1 << 1     ].refIdx;\par
03370     biMv.refIdx[1] = geoMrgCtx.mvFieldNeighbours[(candIdx0 << 1) + 1].refIdx;\par
03371   \}\par
03372   {\cf19 else} {\cf19 if}( geoMrgCtx.interDirNeighbours[candIdx0] == 1 && geoMrgCtx.interDirNeighbours[candIdx1] == 1 )\par
03373   \{\par
03374     biMv.interDir = 1;\par
03375     biMv.mv[0] = geoMrgCtx.mvFieldNeighbours[candIdx1 << 1].mv;\par
03376     biMv.mv[1] = Mv(0, 0);\par
03377     biMv.refIdx[0] = geoMrgCtx.mvFieldNeighbours[candIdx1 << 1].refIdx;\par
03378     biMv.refIdx[1] = -1;\par
03379   \}\par
03380   {\cf19 else} {\cf19 if}( geoMrgCtx.interDirNeighbours[candIdx0] == 2 && geoMrgCtx.interDirNeighbours[candIdx1] == 2 )\par
03381   \{\par
03382     biMv.interDir = 2;\par
03383     biMv.mv[0] = Mv(0, 0);\par
03384     biMv.mv[1] = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].mv;\par
03385     biMv.refIdx[0] = -1;\par
03386     biMv.refIdx[1] = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].refIdx;\par
03387   \}\par
03388 \par
03389   int16_t angle = g_GeoParams[splitDir][0];\par
03390   {\cf18 int} tpmMask = 0;\par
03391   {\cf18 int} lookUpY = 0, motionIdx = 0;\par
03392   {\cf18 bool} isFlip = angle >= 13 && angle <= 27;\par
03393   {\cf18 int} distanceIdx = g_GeoParams[splitDir][1];\par
03394   {\cf18 int} distanceX = angle;\par
03395   {\cf18 int} distanceY = (distanceX + (GEO_NUM_ANGLES >> 2)) % GEO_NUM_ANGLES;\par
03396   {\cf18 int} offsetX = (-(int)pu.lwidth()) >> 1;\par
03397   {\cf18 int} offsetY = (-(int)pu.lheight()) >> 1;\par
03398   {\cf19 if} (distanceIdx > 0)\par
03399   \{\par
03400     {\cf19 if} (angle % 16 == 8 || (angle % 16 != 0 && pu.lheight() >= pu.lwidth()))\par
03401     \{\par
03402       offsetY += angle < 16 ? ((distanceIdx * pu.lheight()) >> 3) : -(int)((distanceIdx * pu.lheight()) >> 3);\par
03403     \}\par
03404     {\cf19 else}\par
03405     \{\par
03406       offsetX += angle < 16 ? ((distanceIdx * pu.lwidth()) >> 3) : -(int)((distanceIdx * pu.lwidth()) >> 3);\par
03407     \}\par
03408   \}\par
03409   {\cf19 for} ({\cf18 int} y = 0; y < mb.height; y++)\par
03410   \{\par
03411     lookUpY = (((4 * y + offsetY) << 1) + 5) * g_Dis[distanceY];\par
03412     {\cf19 for} ({\cf18 int} x = 0; x < mb.width; x++)\par
03413     \{\par
03414       motionIdx = (((4 * x + offsetX) << 1) + 5) * g_Dis[distanceX] + lookUpY;\par
03415       tpmMask = abs(motionIdx) < 32 ? 2 : (motionIdx <= 0 ? (1 - isFlip) : isFlip);\par
03416       {\cf19 if} (tpmMask == 2)\par
03417       \{\par
03418         mb.at(x, y).isInter = {\cf17 true};\par
03419         mb.at(x, y).interDir = biMv.interDir;\par
03420         mb.at(x, y).refIdx[0] = biMv.refIdx[0];\par
03421         mb.at(x, y).refIdx[1] = biMv.refIdx[1];\par
03422         mb.at(x, y).mv[0] = biMv.mv[0];\par
03423         mb.at(x, y).mv[1] = biMv.mv[1];\par
03424         mb.at(x, y).sliceIdx = biMv.sliceIdx;\par
03425       \}\par
03426       {\cf19 else} {\cf19 if} (tpmMask == 0)\par
03427       \{\par
03428         mb.at(x, y).isInter = {\cf17 true};\par
03429         mb.at(x, y).interDir = geoMrgCtx.interDirNeighbours[candIdx0];\par
03430         mb.at(x, y).refIdx[0] = geoMrgCtx.mvFieldNeighbours[candIdx0 << 1].refIdx;\par
03431         mb.at(x, y).refIdx[1] = geoMrgCtx.mvFieldNeighbours[(candIdx0 << 1) + 1].refIdx;\par
03432         mb.at(x, y).mv[0] = geoMrgCtx.mvFieldNeighbours[candIdx0 << 1].mv;\par
03433         mb.at(x, y).mv[1] = geoMrgCtx.mvFieldNeighbours[(candIdx0 << 1) + 1].mv;\par
03434         mb.at(x, y).sliceIdx = biMv.sliceIdx;\par
03435       \}\par
03436       {\cf19 else}\par
03437       \{\par
03438         mb.at(x, y).isInter = {\cf17 true};\par
03439         mb.at(x, y).interDir = geoMrgCtx.interDirNeighbours[candIdx1];\par
03440         mb.at(x, y).refIdx[0] = geoMrgCtx.mvFieldNeighbours[candIdx1 << 1].refIdx;\par
03441         mb.at(x, y).refIdx[1] = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].refIdx;\par
03442         mb.at(x, y).mv[0] = geoMrgCtx.mvFieldNeighbours[candIdx1 << 1].mv;\par
03443         mb.at(x, y).mv[1] = geoMrgCtx.mvFieldNeighbours[(candIdx1 << 1) + 1].mv;\par
03444         mb.at(x, y).sliceIdx = biMv.sliceIdx;\par
03445       \}\par
03446     \}\par
03447   \}\par
03448 \}\par
