02597       miLeft = puLeft->getMotionInfo( posCurLB.offset( -1, 0 ) );\par
02598       {\cf20 // get Inter Dir}\par
02599       mrgCtx.interDirNeighbours[pos] = miLeft.interDir;\par
02600 \par
