03611 uint8_t CU::numSbtModeRdo( uint8_t sbtAllowed )\par
03612 \{\par
03613   uint8_t num = 0;\par
03614   uint8_t sum = 0;\par
03615   num = targetSbtAllowed( SBT_VER_HALF, sbtAllowed ) + targetSbtAllowed( SBT_HOR_HALF, sbtAllowed );\par
03616   sum += std::min( SBT_NUM_RDO, ( num << 1 ) );\par
03617   num = targetSbtAllowed( SBT_VER_QUAD, sbtAllowed ) + targetSbtAllowed( SBT_HOR_QUAD, sbtAllowed );\par
03618   sum += std::min( SBT_NUM_RDO, ( num << 1 ) );\par
03619   {\cf19 return} sum;\par
03620 \}\par
