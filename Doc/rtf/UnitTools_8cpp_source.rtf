00059 {\cf18 bool} CS::isDualITree( {\cf17 const} CodingStructure &cs )\par
00060 \{\par
00061   {\cf19 return} cs.slice->isIntra() && !cs.pcv->ISingleTree;\par
00062 \}\par
00063 \par
00064 UnitArea CS::getArea( {\cf17 const} CodingStructure &cs, {\cf17 const} UnitArea &area, {\cf17 const} ChannelType chType )\par
00065 \{\par
00066   {\cf19 return} isDualITree( cs ) || cs.treeType != TREE_D ? area.singleChan( chType ) : area;\par
00067 \}\par
00068 \par
00069 {\cf18 void} CS::setRefinedMotionField(CodingStructure &cs)\par
00070 \{\par
00071   {\cf19 for} (CodingUnit *cu : cs.cus)\par
00072   \{\par
00073     {\cf19 for} ({\cf17 auto} &pu : CU::traversePUs(*cu))\par
00074     \{\par
00075       PredictionUnit subPu = pu;\par
00076       {\cf18 int} dx, dy, x, y, num = 0;\par
00077       dy = std::min<int>(pu.lumaSize().height, DMVR_SUBCU_HEIGHT);\par
00078       dx = std::min<int>(pu.lumaSize().width, DMVR_SUBCU_WIDTH);\par
00079       Position puPos = pu.lumaPos();\par
00080       {\cf19 if} (PU::checkDMVRCondition(pu))\par
00081       \{\par
00082         {\cf19 for} (y = puPos.y; y < (puPos.y + pu.lumaSize().height); y = y + dy)\par
00083         \{\par
00084           {\cf19 for} (x = puPos.x; x < (puPos.x + pu.lumaSize().width); x = x + dx)\par
00085           \{\par
00086             subPu.UnitArea::operator=(UnitArea(pu.chromaFormat, Area(x, y, dx, dy)));\par
00087             subPu.mv[0] = pu.mv[0];\par
00088             subPu.mv[1] = pu.mv[1];\par
00089             subPu.mv[REF_PIC_LIST_0] += pu.mvdL0SubPu[num];\par
00090             subPu.mv[REF_PIC_LIST_1] -= pu.mvdL0SubPu[num];\par
00091             subPu.mv[REF_PIC_LIST_0].clipToStorageBitDepth();\par
00092             subPu.mv[REF_PIC_LIST_1].clipToStorageBitDepth();\par
00093             pu.mvdL0SubPu[num].setZero();\par
00094             num++;\par
00095             PU::spanMotionInfo(subPu);\par
00096           \}\par
00097         \}\par
00098       \}\par
00099     \}\par
00100   \}\par
00101 \}\par
00102 {\cf20 // CU tools}\par
00103 \par
00104 {\cf18 bool} CU::getRprScaling( {\cf17 const} SPS* sps, {\cf17 const} PPS* curPPS, Picture* refPic, {\cf18 int}& xScale, {\cf18 int}& yScale )\par
00105 \{\par
00106   {\cf17 const} Window& curScalingWindow = curPPS->getScalingWindow();\par
00107   {\cf18 int} curPicWidth = curPPS->getPicWidthInLumaSamples()   - SPS::getWinUnitX( sps->getChromaFormatIdc() ) * (curScalingWindow.getWindowLeftOffset() + curScalingWindow.getWindowRightOffset());\par
00108   {\cf18 int} curPicHeight = curPPS->getPicHeightInLumaSamples() - SPS::getWinUnitY( sps->getChromaFormatIdc() ) * (curScalingWindow.getWindowTopOffset()  + curScalingWindow.getWindowBottomOffset());\par
00109 \par
00110   {\cf17 const} Window& refScalingWindow = refPic->getScalingWindow();\par
00111   {\cf18 int} refPicWidth = refPic->getPicWidthInLumaSamples()   - SPS::getWinUnitX( sps->getChromaFormatIdc() ) * (refScalingWindow.getWindowLeftOffset() + refScalingWindow.getWindowRightOffset());\par
00112   {\cf18 int} refPicHeight = refPic->getPicHeightInLumaSamples() - SPS::getWinUnitY( sps->getChromaFormatIdc() ) * (refScalingWindow.getWindowTopOffset()  + refScalingWindow.getWindowBottomOffset());\par
00113 \par
00114   xScale = ( ( refPicWidth << SCALE_RATIO_BITS ) + ( curPicWidth >> 1 ) ) / curPicWidth;\par
00115   yScale = ( ( refPicHeight << SCALE_RATIO_BITS ) + ( curPicHeight >> 1 ) ) / curPicHeight;\par
00116 \par
00117   {\cf18 int} curSeqMaxPicWidthY = sps->getMaxPicWidthInLumaSamples();                  {\cf20 // sps_pic_width_max_in_luma_samples}\par
00118   {\cf18 int} curSeqMaxPicHeightY = sps->getMaxPicHeightInLumaSamples();                {\cf20 // sps_pic_height_max_in_luma_samples}\par
00119   {\cf18 int} curPicWidthY = curPPS->getPicWidthInLumaSamples();                        {\cf20 // pps_pic_width_in_luma_samples}\par
00120   {\cf18 int} curPicHeightY = curPPS->getPicHeightInLumaSamples();                      {\cf20 // pps_pic_height_in_luma_samples}\par
00121   {\cf18 int} max8MinCbSizeY = std::max(({\cf18 int})8, (1<<sps->getLog2MinCodingBlockSize())); {\cf20 // Max(8, MinCbSizeY)}\par
00122 \par
00123   CHECK((curPicWidth * curSeqMaxPicWidthY) < refPicWidth * (curPicWidthY - max8MinCbSizeY), {\cf22 "(curPicWidth * curSeqMaxPicWidthY) should be greater than or equal to refPicWidth * (curPicWidthY - max8MinCbSizeY))"});\par
00124   CHECK((curPicHeight * curSeqMaxPicHeightY) < refPicHeight * (curPicHeightY - max8MinCbSizeY), {\cf22 "(curPicHeight * curSeqMaxPicHeightY) should be greater than or equal to refPicHeight * (curPicHeightY - max8MinCbSizeY))"});\par
00125 \par
00126   CHECK(curPicWidth * 2 < refPicWidth, {\cf22 "curPicWidth * 2 shall be greater than or equal to refPicWidth"});\par
00127   CHECK(curPicHeight * 2 < refPicHeight, {\cf22 "curPicHeight * 2 shall be greater than or equal to refPicHeight"});\par
00128   CHECK(curPicWidth > refPicWidth * 8, {\cf22 "curPicWidth shall be less than or equal to refPicWidth * 8"});\par
00129   CHECK(curPicHeight > refPicHeight * 8, {\cf22 "curPicHeight shall be less than or equal to refPicHeight * 8"});\par
00130 \par
00131   {\cf18 int} subWidthC = SPS::getWinUnitX(sps->getChromaFormatIdc());\par
00132   {\cf18 int} subHeightC = SPS::getWinUnitY(sps->getChromaFormatIdc());\par
00133 \par
00134   CHECK(subWidthC * curScalingWindow.getWindowLeftOffset() < (-curPicWidthY) * 15, {\cf22 "The value of SubWidthC * pps_scaling_win_left_offset shall be greater than or equal to -pps_pic_width_in_luma_samples * 15"});\par
00135   CHECK(subWidthC * curScalingWindow.getWindowLeftOffset() >= curPicWidthY, {\cf22 "The value of SubWidthC * pps_scaling_win_left_offset shall be less than pps_pic_width_in_luma_samples"});\par
00136   CHECK(subWidthC * curScalingWindow.getWindowRightOffset() < (-curPicWidthY) * 15, {\cf22 "The value of SubWidthC * pps_scaling_win_right_offset shall be greater than or equal to -pps_pic_width_in_luma_samples * 15"});\par
00137   CHECK(subWidthC * curScalingWindow.getWindowRightOffset() >= curPicWidthY, {\cf22 "The value of SubWidthC * pps_scaling_win_right_offset shall be less than pps_pic_width_in_luma_samples"});\par
00138 \par
00139   CHECK(subHeightC * curScalingWindow.getWindowTopOffset() < (-curPicHeightY) * 15, {\cf22 "The value of SubHeightC * pps_scaling_win_top_offset shall be greater than or equal to -pps_pic_height_in_luma_samples * 15"});\par
00140   CHECK(subHeightC * curScalingWindow.getWindowTopOffset() >= curPicHeightY, {\cf22 "The value of SubHeightC * pps_scaling_win_top_offset shall be less than pps_pic_height_in_luma_samples"});\par
00141   CHECK(subHeightC * curScalingWindow.getWindowBottomOffset() < (-curPicHeightY) * 15, {\cf22 "The value of SubHeightC *pps_scaling_win_bottom_offset shall be greater than or equal to -pps_pic_height_in_luma_samples * 15"});\par
00142   CHECK(subHeightC * curScalingWindow.getWindowBottomOffset() >= curPicHeightY, {\cf22 "The value of SubHeightC *pps_scaling_win_bottom_offset shall be less than pps_pic_height_in_luma_samples"});\par
00143 \par
00144   CHECK(subWidthC * (curScalingWindow.getWindowLeftOffset() + curScalingWindow.getWindowRightOffset()) < (-curPicWidthY) * 15, {\cf22 "The value of SubWidthC * ( pps_scaling_win_left_offset + pps_scaling_win_right_offset ) shall be greater than or equal to -pps_pic_width_in_luma_samples * 15"});\par
00145   CHECK(subWidthC * (curScalingWindow.getWindowLeftOffset() + curScalingWindow.getWindowRightOffset()) >= curPicWidthY, {\cf22 "The value of SubWidthC * ( pps_scaling_win_left_offset + pps_scaling_win_right_offset ) shall be less than pps_pic_width_in_luma_samples"});\par
00146   CHECK(subHeightC * (curScalingWindow.getWindowTopOffset() + curScalingWindow.getWindowBottomOffset()) < (-curPicHeightY) * 15, {\cf22 "The value of SubHeightC * ( pps_scaling_win_top_offset + pps_scaling_win_bottom_offset ) shall be greater than or equal to -pps_pic_height_in_luma_samples * 15"});\par
00147   CHECK(subHeightC * (curScalingWindow.getWindowTopOffset() + curScalingWindow.getWindowBottomOffset()) >= curPicHeightY, {\cf22 "The value of SubHeightC * ( pps_scaling_win_top_offset + pps_scaling_win_bottom_offset ) shall be less than pps_pic_height_in_luma_samples"});\par
00148 \par
00149   {\cf19 return} refPic->isRefScaled( curPPS );\par
00150 \}\par
