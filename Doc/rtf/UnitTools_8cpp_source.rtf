03121 {\cf18 void} PU::spanMotionInfo( PredictionUnit &pu, {\cf17 const} MergeCtx &mrgCtx )\par
03122 \{\par
03123   MotionBuf mb = pu.getMotionBuf();\par
03124 \par
03125   {\cf19 if} (!pu.mergeFlag || pu.mergeType == MRG_TYPE_DEFAULT_N || pu.mergeType == MRG_TYPE_IBC)\par
03126   \{\par
03127     MotionInfo mi;\par
03128 \par
03129     mi.isInter = !CU::isIntra(*pu.cu);\par
03130     mi.isIBCmot = CU::isIBC(*pu.cu);\par
03131     mi.sliceIdx = pu.cu->slice->getIndependentSliceIdx();\par
03132 \par
03133     {\cf19 if}( mi.isInter )\par
03134     \{\par
03135       mi.interDir = pu.interDir;\par
03136       mi.useAltHpelIf = pu.cu->imv == IMV_HPEL;\par
03137 \par
03138       {\cf19 for}( {\cf18 int} i = 0; i < NUM_REF_PIC_LIST_01; i++ )\par
03139       \{\par
03140         mi.mv[i]     = pu.mv[i];\par
03141         mi.refIdx[i] = pu.refIdx[i];\par
03142       \}\par
03143       {\cf19 if} (mi.isIBCmot)\par
03144       \{\par
03145         mi.bv = pu.bv;\par
03146       \}\par
03147     \}\par
03148 \par
03149     {\cf19 if}( pu.cu->affine )\par
03150     \{\par
03151       {\cf19 for}( {\cf18 int} y = 0; y < mb.height; y++ )\par
03152       \{\par
03153         {\cf19 for}( {\cf18 int} x = 0; x < mb.width; x++ )\par
03154         \{\par
03155           MotionInfo &dest = mb.at( x, y );\par
03156           dest.isInter  = mi.isInter;\par
03157           dest.isIBCmot = {\cf17 false};\par
03158           dest.interDir = mi.interDir;\par
03159           dest.sliceIdx = mi.sliceIdx;\par
03160           {\cf19 for}( {\cf18 int} i = 0; i < NUM_REF_PIC_LIST_01; i++ )\par
03161           \{\par
03162             {\cf19 if}( mi.refIdx[i] == -1 )\par
03163             \{\par
03164               dest.mv[i] = Mv();\par
03165             \}\par
