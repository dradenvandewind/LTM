03755 uint8_t CU::deriveBcwIdx( uint8_t bcwLO, uint8_t bcwL1 )\par
03756 \{\par
03757   {\cf19 if}( bcwLO == bcwL1 )\par
03758   \{\par
03759     {\cf19 return} bcwLO;\par
03760   \}\par
03761   {\cf17 const} int8_t w0 = getBcwWeight(bcwLO, REF_PIC_LIST_0);\par
03762   {\cf17 const} int8_t w1 = getBcwWeight(bcwL1, REF_PIC_LIST_1);\par
03763   {\cf17 const} int8_t th = g_BcwWeightBase >> 1;\par
03764   {\cf17 const} int8_t off = 1;\par
03765 \par
03766   {\cf19 if}( w0 == w1 || (w0 < (th - off) && w1 < (th - off)) || (w0 >(th + off) && w1 >(th + off)) )\par
03767   \{\par
03768     {\cf19 return} BCW_DEFAULT;\par
03769   \}\par
03770   {\cf19 else}\par
03771   \{\par
03772     {\cf19 if}( w0 > w1 )\par
03773     \{\par
03774       {\cf19 return} ( w0 >= th ? bcwLO : bcwL1 );\par
03775     \}\par
03776     {\cf19 else}\par
03777     \{\par
03778       {\cf19 return} ( w1 >= th ? bcwL1 : bcwLO );\par
03779     \}\par
03780   \}\par
03781 \}\par
