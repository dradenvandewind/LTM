02941 {\cf18 void} clipColPos({\cf18 int}& posX, {\cf18 int}& posY, {\cf17 const} PredictionUnit& pu)\par
02942 \{\par
02943   Position puPos = pu.lumaPos();\par
02944   {\cf18 int} log2CtuSize = floorLog2(pu.cs->sps->getCTUSize());\par
02945   {\cf18 int} ctuX = ((puPos.x >> log2CtuSize) << log2CtuSize);\par
02946   {\cf18 int} ctuY = ((puPos.y >> log2CtuSize) << log2CtuSize);\par
02947   {\cf18 int} horMax;\par
02948   {\cf17 const} SubPic &curSubPic = pu.cu->slice->getPPS()->getSubPicFromPos(puPos);\par
02949   {\cf19 if} (curSubPic.getTreatedAsPicFlag())\par
02950   \{\par
02951     horMax = std::min(({\cf18 int})curSubPic.getSubPicRight(), ctuX + ({\cf18 int})pu.cs->sps->getCTUSize() + 3);\par
02952   \}\par
02953   {\cf19 else}\par
02954   \{\par
02955     horMax = std::min(({\cf18 int})pu.cs->pps->getPicWidthInLumaSamples() - 1, ctuX + ({\cf18 int})pu.cs->sps->getCTUSize() + 3);\par
02956   \}\par
02957   {\cf18 int} horMin = std::max(({\cf18 int})0, ctuX);\par
02958   {\cf18 int} verMax = std::min( ({\cf18 int})pu.cs->pps->getPicHeightInLumaSamples() - 1, ctuY + ({\cf18 int})pu.cs->sps->getCTUSize() - 1 );\par
02959   {\cf18 int} verMin = std::max(({\cf18 int})0, ctuY);\par
02960 \par
02961   posX = std::min(horMax, std::max(horMin, posX));\par
02962   posY = std::min(verMax, std::max(verMin, posY));\par
02963 \}\par
02964 \par
02965 {\cf18 bool} PU::getInterMergeSubPuMvpCand({\cf17 const} PredictionUnit &pu, MergeCtx& mrgCtx, {\cf18 bool}& LICFlag, {\cf17 const} {\cf18 int} count\par
02966   , {\cf18 int} mmvdList\par
02967 )\par
02968 \{\par
02969   {\cf17 const} Slice   &slice = *pu.cs->slice;\par
02970   {\cf17 const} {\cf18 unsigned} scale = 4 * std::max<int>(1, 4 * AMVP_DECIMATION_FACTOR / 4);\par
02971   {\cf17 const} {\cf18 unsigned} mask = ~(scale - 1);\par
02972 \par
02973   {\cf17 const} Picture *pColPic = slice.getRefPic(RefPicList(slice.isInterB() ? 1 - slice.getColFromL0Flag() : 0), slice.getColRefIdx());\par
02974   Mv cTMv;\par
02975 \par
02976   {\cf19 if} ( count )\par
02977   \{\par
02978     {\cf19 if} ( (mrgCtx.interDirNeighbours[0] & (1 << REF_PIC_LIST_0)) && slice.getRefPic( REF_PIC_LIST_0, mrgCtx.mvFieldNeighbours[REF_PIC_LIST_0].refIdx ) == pColPic )\par
02979     \{\par
02980       cTMv = mrgCtx.mvFieldNeighbours[REF_PIC_LIST_0].mv;\par
02981     \}\par
02982     {\cf19 else} {\cf19 if} ( slice.isInterB() && (mrgCtx.interDirNeighbours[0] & (1 << REF_PIC_LIST_1)) && slice.getRefPic( REF_PIC_LIST_1, mrgCtx.mvFieldNeighbours[REF_PIC_LIST_1].refIdx ) == pColPic )\par
02983     \{\par
02984       cTMv = mrgCtx.mvFieldNeighbours[REF_PIC_LIST_1].mv;\par
02985     \}\par
02986   \}\par
02987 \par
02991 \par
02992   Mv cTempVector = cTMv;\par
02993   {\cf18 bool}  tempLICFlag = {\cf17 false};\par
02994 \par
02995   {\cf20 // compute the location of the current PU}\par
02996   Position puPos = pu.lumaPos();\par
02997   Size puSize = pu.lumaSize();\par
02998   {\cf18 int} numPartLine = std::max(puSize.width >> ATMVP_SUB_BLOCK_SIZE, 1u);\par
02999   {\cf18 int} numPartCol = std::max(puSize.height >> ATMVP_SUB_BLOCK_SIZE, 1u);\par
03000   {\cf18 int} puHeight = numPartCol == 1 ? puSize.height : 1 << ATMVP_SUB_BLOCK_SIZE;\par
03001   {\cf18 int} puWidth = numPartLine == 1 ? puSize.width : 1 << ATMVP_SUB_BLOCK_SIZE;\par
03002 \par
03003   Mv cColMv;\par
03004   {\cf18 int} refIdx = 0;\par
03005   {\cf20 // use coldir.}\par
03006   {\cf18 bool}     bBSlice = slice.isInterB();\par
03007 \par
03008   Position centerPos;\par
03009 \par
03010   {\cf18 bool} found = {\cf17 false};\par
03011   cTempVector = cTMv;\par
03012 \par
03013   cTempVector.changePrecision(MV_PRECISION_SIXTEENTH, MV_PRECISION_INT);\par
03014   {\cf18 int} tempX = cTempVector.getHor();\par
03015   {\cf18 int} tempY = cTempVector.getVer();\par
03016 \par
03017   centerPos.x = puPos.x + (puSize.width >> 1) + tempX;\par
03018   centerPos.y = puPos.y + (puSize.height >> 1) + tempY;\par
03019 \par
03020   clipColPos(centerPos.x, centerPos.y, pu);\par
03021 \par
03022   centerPos = Position\{ PosType(centerPos.x & mask), PosType(centerPos.y & mask) \};\par
03023 \par
03024   {\cf20 // derivation of center motion parameters from the collocated CU}\par
03025   {\cf17 const} MotionInfo &mi = pColPic->cs->getMotionInfo(centerPos);\par
03026 \par
03027   {\cf19 if} (mi.isInter && mi.isIBCmot == {\cf17 false})\par
03028   \{\par
03029     mrgCtx.interDirNeighbours[count] = 0;\par
03030 \par
03031     {\cf19 for} ({\cf18 unsigned} currRefListId = 0; currRefListId < (bBSlice ? 2 : 1); currRefListId++)\par
03032     \{\par
03033       RefPicList  currRefPicList = RefPicList(currRefListId);\par
03034 \par
03035       {\cf19 if} (getColocatedMVP(pu, currRefPicList, centerPos, cColMv, refIdx, {\cf17 true}))\par
03036       \{\par
03037         {\cf20 // set as default, for further motion vector field spanning}\par
03038         mrgCtx.mvFieldNeighbours[(count << 1) + currRefListId].setMvField(cColMv, 0);\par
03039         mrgCtx.interDirNeighbours[count] |= (1 << currRefListId);\par
03040         LICFlag = tempLICFlag;\par
03041         mrgCtx.BcwIdx[count] = BCW_DEFAULT;\par
03042         found = {\cf17 true};\par
03043       \}\par
03044       {\cf19 else}\par
03045       \{\par
03046         mrgCtx.mvFieldNeighbours[(count << 1) + currRefListId].setMvField(Mv(), NOT_VALID);\par
03047         mrgCtx.interDirNeighbours[count] &= ~(1 << currRefListId);\par
03048       \}\par
03049     \}\par
03050   \}\par
03051 \par
03052   {\cf19 if} (!found)\par
03053   \{\par
03054     {\cf19 return} {\cf17 false};\par
03055   \}\par
03056   {\cf19 if} (mmvdList != 1)\par
03057   \{\par
03058     {\cf18 int} xOff = (puWidth >> 1) + tempX;\par
03059     {\cf18 int} yOff = (puHeight >> 1) + tempY;\par
03060 \par
03061     MotionBuf &mb = mrgCtx.subPuMvpMiBuf;\par
03062 \par
03063     {\cf17 const} {\cf18 bool} isBiPred = isBipredRestriction(pu);\par
03064 \par
03065     {\cf19 for} ({\cf18 int} y = puPos.y; y < puPos.y + puSize.height; y += puHeight)\par
03066     \{\par
03067       {\cf19 for} ({\cf18 int} x = puPos.x; x < puPos.x + puSize.width; x += puWidth)\par
03068       \{\par
03069         Position colPos\{ x + xOff, y + yOff \};\par
03070 \par
03071         clipColPos(colPos.x, colPos.y, pu);\par
03072 \par
03073         colPos = Position\{ PosType(colPos.x & mask), PosType(colPos.y & mask) \};\par
03074 \par
03075         {\cf17 const} MotionInfo &colMi = pColPic->cs->getMotionInfo(colPos);\par
03076 \par
03077         MotionInfo mi;\par
03078 \par
03079         found       = {\cf17 false};\par
03080         mi.isInter  = {\cf17 true};\par
03081         mi.sliceIdx = slice.getIndependentSliceIdx();\par
03082         mi.isIBCmot = {\cf17 false};\par
03083         {\cf19 if} (colMi.isInter && colMi.isIBCmot == {\cf17 false})\par
03084         \{\par
03085           {\cf19 for} ({\cf18 unsigned} currRefListId = 0; currRefListId < (bBSlice ? 2 : 1); currRefListId++)\par
03086           \{\par
03087             RefPicList currRefPicList = RefPicList(currRefListId);\par
03088             {\cf19 if} (getColocatedMVP(pu, currRefPicList, colPos, cColMv, refIdx, {\cf17 true}))\par
03089             \{\par
03090               mi.refIdx[currRefListId] = 0;\par
03091               mi.mv[currRefListId]     = cColMv;\par
03092               found                    = {\cf17 true};\par
03093             \}\par
03094           \}\par
03095         \}\par
03096         {\cf19 if} (!found)\par
03097         \{\par
03098           mi.mv[0]     = mrgCtx.mvFieldNeighbours[(count << 1) + 0].mv;\par
03099           mi.mv[1]     = mrgCtx.mvFieldNeighbours[(count << 1) + 1].mv;\par
03100           mi.refIdx[0] = mrgCtx.mvFieldNeighbours[(count << 1) + 0].refIdx;\par
03101           mi.refIdx[1] = mrgCtx.mvFieldNeighbours[(count << 1) + 1].refIdx;\par
03102         \}\par
03103 \par
03104         mi.interDir = (mi.refIdx[0] != -1 ? 1 : 0) + (mi.refIdx[1] != -1 ? 2 : 0);\par
03105 \par
03106         {\cf19 if} (isBiPred && mi.interDir == 3)\par
03107         \{\par
03108           mi.interDir  = 1;\par
03109           mi.mv[1]     = Mv();\par
03110           mi.refIdx[1] = NOT_VALID;\par
03111         \}\par
03112 \par
03113         mb.subBuf(g_miScaling.scale(Position\{ x, y \} - pu.lumaPos()), g_miScaling.scale(Size(puWidth, puHeight)))\par
03114           .fill(mi);\par
03115       \}\par
03116     \}\par
03117   \}\par
03118   {\cf19 return} {\cf17 true};\par
03119 \}\par
