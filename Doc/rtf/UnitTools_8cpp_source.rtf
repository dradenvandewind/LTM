02607       \}\par
02608       pos++;\par
02609     \}\par
02610 \par
02611     mrgCtx.numValidMergeCand = pos;\par
02612 \par
02613     isAvailableSubPu = getInterMergeSubPuMvpCand(pu, mrgCtx, tmpLICFlag, pos, 0);\par
02614     {\cf19 if} ( isAvailableSubPu )\par
02615     \{\par
02616       {\cf19 for} ( {\cf18 int} mvNum = 0; mvNum < 3; mvNum++ )\par
02617       \{\par
02618         affMrgCtx.mvFieldNeighbours[(affMrgCtx.numValidMergeCand << 1) + 0][mvNum].setMvField( mrgCtx.mvFieldNeighbours[(pos << 1) + 0].mv, mrgCtx.mvFieldNeighbours[(pos << 1) + 0].refIdx );\par
02619         affMrgCtx.mvFieldNeighbours[(affMrgCtx.numValidMergeCand << 1) + 1][mvNum].setMvField( mrgCtx.mvFieldNeighbours[(pos << 1) + 1].mv, mrgCtx.mvFieldNeighbours[(pos << 1) + 1].refIdx );\par
02620       \}\par
02621       affMrgCtx.interDirNeighbours[affMrgCtx.numValidMergeCand] = mrgCtx.interDirNeighbours[pos];\par
02622 \par
02623       affMrgCtx.affineType[affMrgCtx.numValidMergeCand] = AFFINE_MODEL_NUM;\par
02624       affMrgCtx.mergeType[affMrgCtx.numValidMergeCand] = MRG_TYPE_SUBPU_ATMVP;\par
02625       {\cf19 if} ( affMrgCtx.numValidMergeCand == mrgCandIdx )\par
