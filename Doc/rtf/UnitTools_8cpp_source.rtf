01929 {\cf18 bool} PU::addAffineMVPCandUnscaled( {\cf17 const} PredictionUnit &pu, {\cf17 const} RefPicList &refPicList, {\cf17 const} {\cf18 int} &refIdx, {\cf17 const} Position &pos, {\cf17 const} MvpDir &dir, AffineAMVPInfo &affiAMVPInfo )\par
01930 \{\par
01931   CodingStructure &cs = *pu.cs;\par
01932   {\cf17 const} PredictionUnit *neibPU = NULL;\par
01933   Position neibPos;\par
01934 \par
01935   {\cf19 switch} ( dir )\par
01936   \{\par
01937   {\cf19 case} MD_LEFT:\par
01938     neibPos = pos.offset( -1, 0 );\par
01939     {\cf19 break};\par
01940   {\cf19 case} MD_ABOVE:\par
01941     neibPos = pos.offset( 0, -1 );\par
01942     {\cf19 break};\par
01943   {\cf19 case} MD_ABOVE_RIGHT:\par
01944     neibPos = pos.offset( 1, -1 );\par
01945     {\cf19 break};\par
01946   {\cf19 case} MD_BELOW_LEFT:\par
01947     neibPos = pos.offset( -1, 1 );\par
01948     {\cf19 break};\par
01949   {\cf19 case} MD_ABOVE_LEFT:\par
01950     neibPos = pos.offset( -1, -1 );\par
01951     {\cf19 break};\par
01952   {\cf19 default}:\par
01953     {\cf19 break};\par
01954   \}\par
01955 \par
01956   neibPU = cs.getPURestricted( neibPos, pu, pu.chType );\par
01957 \par
01958   {\cf19 if} (neibPU == NULL || !CU::isInter(*neibPU->cu) || !neibPU->cu->affine || neibPU->mergeType != MRG_TYPE_DEFAULT_N)\par
01959   \{\par
01960     {\cf19 return} {\cf17 false};\par
01961   \}\par
