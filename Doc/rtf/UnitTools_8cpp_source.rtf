01502 {\cf18 bool} PU::getColocatedMVP({\cf17 const} PredictionUnit &pu, {\cf17 const} RefPicList &eRefPicList, {\cf17 const} Position &_pos, Mv& rcMv, {\cf17 const} {\cf18 int} &refIdx, {\cf18 bool} sbFlag)\par
01503 \{\par
01504   {\cf20 // don't perform MV compression when generally disabled or subPuMvp is used}\par
01505   {\cf17 const} {\cf18 unsigned} scale = 4 * std::max<int>(1, 4 * AMVP_DECIMATION_FACTOR / 4);\par
01506   {\cf17 const} {\cf18 unsigned} mask  = ~( scale - 1 );\par
01507 \par
01508   {\cf17 const} Position pos = Position\{ PosType( _pos.x & mask ), PosType( _pos.y & mask ) \};\par
01509 \par
01510   {\cf17 const} Slice &slice = *pu.cs->slice;\par
01511 \par
01512   {\cf20 // use coldir.}\par
01513   {\cf17 const} Picture* {\cf17 const} pColPic = slice.getRefPic(RefPicList(slice.isInterB() ? 1 - slice.getColFromL0Flag() : 0), slice.getColRefIdx());\par
01514 \par
01515   {\cf19 if}( !pColPic )\par
01516   \{\par
01517     {\cf19 return} {\cf17 false};\par
01518   \}\par
01519 \par
01520   {\cf20 // Check the position of colocated block is within a subpicture}\par
01521   {\cf17 const} SubPic &curSubPic = pu.cs->slice->getPPS()->getSubPicFromPos(pu.lumaPos());\par
01522   {\cf19 if} (curSubPic.getTreatedAsPicFlag())\par
01523   \{\par
01524     {\cf19 if} (!curSubPic.isContainingPos(pos))\par
01525     \{\par
01526       {\cf19 return} {\cf17 false};\par
01527     \}\par
01528   \}\par
01529   RefPicList eColRefPicList = slice.getCheckLDC() ? eRefPicList : RefPicList(slice.getColFromL0Flag());\par
01530 \par
01531   {\cf17 const} MotionInfo& mi = pColPic->cs->getMotionInfo( pos );\par
01532 \par
01533   {\cf19 if}( !mi.isInter )\par
01534   \{\par
01535     {\cf19 return} {\cf17 false};\par
01536   \}\par
01537   {\cf19 if} (mi.isIBCmot)\par
01538   \{\par
01539     {\cf19 return} {\cf17 false};\par
01540   \}\par
01541   {\cf19 if} (CU::isIBC(*pu.cu))\par
01542   \{\par
01543     {\cf19 return} {\cf17 false};\par
01544   \}\par
01545   {\cf18 int} iColRefIdx = mi.refIdx[eColRefPicList];\par
01546 \par
01547   {\cf19 if} (sbFlag && !slice.getCheckLDC())\par
01548   \{\par
01549     eColRefPicList = eRefPicList;\par
01550     iColRefIdx = mi.refIdx[eColRefPicList];\par
01551     {\cf19 if} (iColRefIdx < 0)\par
01552     \{\par
01553       {\cf19 return} {\cf17 false};\par
01554     \}\par
01555   \}\par
01556   {\cf19 else}\par
01557   \{\par
01558     {\cf19 if} (iColRefIdx < 0)\par
01559     \{\par
01560       eColRefPicList = RefPicList(1 - eColRefPicList);\par
01561       iColRefIdx = mi.refIdx[eColRefPicList];\par
01562 \par
01563       {\cf19 if} (iColRefIdx < 0)\par
01564       \{\par
01565         {\cf19 return} {\cf17 false};\par
01566       \}\par
01567     \}\par
01568   \}\par
01569 \par
01570   {\cf17 const} Slice *pColSlice = {\cf17 nullptr};\par
01571 \par
01572   {\cf19 for}( {\cf17 const} {\cf17 auto} s : pColPic->slices )\par
01573   \{\par
01574     {\cf19 if}( s->getIndependentSliceIdx() == mi.sliceIdx )\par
01575     \{\par
01576       pColSlice = s;\par
01577       {\cf19 break};\par
01578     \}\par
01579   \}\par
01580 \par
01581   CHECK( pColSlice == {\cf17 nullptr}, {\cf22 "Slice segment not found"} );\par
01582 \par
01583   {\cf17 const} Slice &colSlice = *pColSlice;\par
01584 \par
01585   {\cf17 const} {\cf18 bool} bIsCurrRefLongTerm = slice.getRefPic(eRefPicList, refIdx)->longTerm;\par
01586   {\cf17 const} {\cf18 bool} bIsColRefLongTerm  = colSlice.getIsUsedAsLongTerm(eColRefPicList, iColRefIdx);\par
01587 \par
01588   {\cf19 if} (bIsCurrRefLongTerm != bIsColRefLongTerm)\par
01589   \{\par
01590     {\cf19 return} {\cf17 false};\par
01591   \}\par
01592 \par
01593 \par
01594   {\cf20 // Scale the vector.}\par
01595   Mv cColMv = mi.mv[eColRefPicList];\par
01596   cColMv.setHor(roundMvComp(cColMv.getHor()));\par
01597   cColMv.setVer(roundMvComp(cColMv.getVer()));\par
01598 \par
01599   {\cf19 if} (bIsCurrRefLongTerm {\cf20 /*|| bIsColRefLongTerm*/})\par
01600   \{\par
01601     rcMv = cColMv;\par
01602     rcMv.clipToStorageBitDepth();\par
01603   \}\par
01604   {\cf19 else}\par
01605   \{\par
01606     {\cf17 const} {\cf18 int} currPOC    = slice.getPOC();\par
01607     {\cf17 const} {\cf18 int} colPOC     = colSlice.getPOC();\par
01608     {\cf17 const} {\cf18 int} colRefPOC  = colSlice.getRefPOC(eColRefPicList, iColRefIdx);\par
01609     {\cf17 const} {\cf18 int} currRefPOC = slice.getRefPic(eRefPicList, refIdx)->getPOC();\par
01610     {\cf17 const} {\cf18 int} distscale  = xGetDistScaleFactor(currPOC, currRefPOC, colPOC, colRefPOC);\par
01611 \par
01612     {\cf19 if} (distscale == 4096)\par
01613     \{\par
01614       rcMv = cColMv;\par
01615       rcMv.clipToStorageBitDepth();\par
01616     \}\par
01617     {\cf19 else}\par
01618     \{\par
01619       rcMv = cColMv.scaleMv(distscale);\par
01620     \}\par
01621   \}\par
01622 \par
01623   {\cf19 return} {\cf17 true};\par
01624 \}\par
