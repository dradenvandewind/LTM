02650       {\cf17 const} PredictionUnit* puNeigh = npu[idx];\par
02651       pu.cu->affineType = puNeigh->cu->affineType;\par
02652       {\cf19 if} ( puNeigh->interDir != 2 )\par
02653       \{\par
02654         xInheritedAffineMv( pu, puNeigh, REF_PIC_LIST_0, cMv[0] );\par
02655       \}\par
02656       {\cf19 if} ( slice.isInterB() )\par
02657       \{\par
