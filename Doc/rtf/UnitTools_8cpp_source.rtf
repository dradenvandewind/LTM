02074 {\cf18 void} PU::fillAffineMvpCand(PredictionUnit &pu, {\cf17 const} RefPicList &eRefPicList, {\cf17 const} {\cf18 int} &refIdx, AffineAMVPInfo &affiAMVPInfo)\par
02075 \{\par
02076   affiAMVPInfo.numCand = 0;\par
02077 \par
02078   {\cf19 if} (refIdx < 0)\par
02079   \{\par
02080     {\cf19 return};\par
02081   \}\par
02082 \par
02083   {\cf20 // insert inherited affine candidates}\par
02084   Mv outputAffineMv[3];\par
02085   Position posLT = pu.Y().topLeft();\par
02086   Position posRT = pu.Y().topRight();\par
02087   Position posLB = pu.Y().bottomLeft();\par
02088 \par
02089   {\cf20 // check left neighbor}\par
02090   {\cf19 if} ( !addAffineMVPCandUnscaled( pu, eRefPicList, refIdx, posLB, MD_BELOW_LEFT, affiAMVPInfo ) )\par
02091   \{\par
02092     addAffineMVPCandUnscaled( pu, eRefPicList, refIdx, posLB, MD_LEFT, affiAMVPInfo );\par
02093   \}\par
02094 \par
02095   {\cf20 // check above neighbor}\par
02096   {\cf19 if} ( !addAffineMVPCandUnscaled( pu, eRefPicList, refIdx, posRT, MD_ABOVE_RIGHT, affiAMVPInfo ) )\par
02097   \{\par
02098     {\cf19 if} ( !addAffineMVPCandUnscaled( pu, eRefPicList, refIdx, posRT, MD_ABOVE, affiAMVPInfo ) )\par
02099     \{\par
02100       addAffineMVPCandUnscaled( pu, eRefPicList, refIdx, posLT, MD_ABOVE_LEFT, affiAMVPInfo );\par
02101     \}\par
02102   \}\par
02103 \par
02104   {\cf19 if} ( affiAMVPInfo.numCand >= AMVP_MAX_NUM_CANDS )\par
02105   \{\par
02106     {\cf19 for} ({\cf18 int} i = 0; i < affiAMVPInfo.numCand; i++)\par
02107     \{\par
02108       affiAMVPInfo.mvCandLT[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02109       affiAMVPInfo.mvCandRT[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02110       affiAMVPInfo.mvCandLB[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02111     \}\par
02112     {\cf19 return};\par
02113   \}\par
02114 \par
02115   {\cf20 // insert constructed affine candidates}\par
02116   {\cf18 int} cornerMVPattern = 0;\par
02117 \par
02118   {\cf20 //-------------------  V0 (START) -------------------//}\par
02119   AMVPInfo amvpInfo0;\par
02120   amvpInfo0.numCand = 0;\par
02121 \par
02122   {\cf20 // A->C: Above Left, Above, Left}\par
02123   addMVPCandUnscaled( pu, eRefPicList, refIdx, posLT, MD_ABOVE_LEFT, amvpInfo0 );\par
02124   {\cf19 if} ( amvpInfo0.numCand < 1 )\par
02125   \{\par
02126     addMVPCandUnscaled( pu, eRefPicList, refIdx, posLT, MD_ABOVE, amvpInfo0 );\par
02127   \}\par
02128   {\cf19 if} ( amvpInfo0.numCand < 1 )\par
02129   \{\par
02130     addMVPCandUnscaled( pu, eRefPicList, refIdx, posLT, MD_LEFT, amvpInfo0 );\par
02131   \}\par
02132   cornerMVPattern = cornerMVPattern | amvpInfo0.numCand;\par
02133 \par
02134   {\cf20 //-------------------  V1 (START) -------------------//}\par
02135   AMVPInfo amvpInfo1;\par
02136   amvpInfo1.numCand = 0;\par
02137 \par
02138   {\cf20 // D->E: Above, Above Right}\par
02139   addMVPCandUnscaled( pu, eRefPicList, refIdx, posRT, MD_ABOVE, amvpInfo1 );\par
02140   {\cf19 if} ( amvpInfo1.numCand < 1 )\par
02141   \{\par
02142     addMVPCandUnscaled( pu, eRefPicList, refIdx, posRT, MD_ABOVE_RIGHT, amvpInfo1 );\par
02143   \}\par
02144   cornerMVPattern = cornerMVPattern | (amvpInfo1.numCand << 1);\par
02145 \par
02146   {\cf20 //-------------------  V2 (START) -------------------//}\par
02147   AMVPInfo amvpInfo2;\par
02148   amvpInfo2.numCand = 0;\par
02149 \par
02150   {\cf20 // F->G: Left, Below Left}\par
02151   addMVPCandUnscaled( pu, eRefPicList, refIdx, posLB, MD_LEFT, amvpInfo2 );\par
02152   {\cf19 if} ( amvpInfo2.numCand < 1 )\par
02153   \{\par
02154     addMVPCandUnscaled( pu, eRefPicList, refIdx, posLB, MD_BELOW_LEFT, amvpInfo2 );\par
02155   \}\par
02156   cornerMVPattern = cornerMVPattern | (amvpInfo2.numCand << 2);\par
02157 \par
02158   outputAffineMv[0] = amvpInfo0.mvCand[0];\par
02159   outputAffineMv[1] = amvpInfo1.mvCand[0];\par
02160   outputAffineMv[2] = amvpInfo2.mvCand[0];\par
02161 \par
02162   outputAffineMv[0].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02163   outputAffineMv[1].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02164   outputAffineMv[2].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02165 \par
02166   {\cf19 if} ( cornerMVPattern == 7 || (cornerMVPattern == 3 && pu.cu->affineType == AFFINEMODEL_4PARAM) )\par
02167   \{\par
02168     affiAMVPInfo.mvCandLT[affiAMVPInfo.numCand] = outputAffineMv[0];\par
02169     affiAMVPInfo.mvCandRT[affiAMVPInfo.numCand] = outputAffineMv[1];\par
02170     affiAMVPInfo.mvCandLB[affiAMVPInfo.numCand] = outputAffineMv[2];\par
02171     affiAMVPInfo.numCand++;\par
02172   \}\par
02173 \par
02174   {\cf19 if} ( affiAMVPInfo.numCand < 2 )\par
02175   \{\par
02176     {\cf20 // check corner MVs}\par
02177     {\cf19 for} ( {\cf18 int} i = 2; i >= 0 && affiAMVPInfo.numCand < AMVP_MAX_NUM_CANDS; i-- )\par
02178     \{\par
02179       {\cf19 if} ( cornerMVPattern & (1 << i) ) {\cf20 // MV i exist}\par
02180       \{\par
02181         affiAMVPInfo.mvCandLT[affiAMVPInfo.numCand] = outputAffineMv[i];\par
02182         affiAMVPInfo.mvCandRT[affiAMVPInfo.numCand] = outputAffineMv[i];\par
02183         affiAMVPInfo.mvCandLB[affiAMVPInfo.numCand] = outputAffineMv[i];\par
02184         affiAMVPInfo.numCand++;\par
02185       \}\par
02186     \}\par
02187 \par
02188     {\cf20 // Get Temporal Motion Predictor}\par
02189     {\cf19 if} ( affiAMVPInfo.numCand < 2 && pu.cs->picHeader->getEnableTMVPFlag() )\par
02190     \{\par
02191       {\cf17 const} {\cf18 int} refIdxCol = refIdx;\par
02192 \par
02193       Position posRB = pu.Y().bottomRight().offset( -3, -3 );\par
02194 \par
02195       {\cf17 const} PreCalcValues& pcv = *pu.cs->pcv;\par
02196 \par
02197       Position posC0;\par
02198       {\cf18 bool} C0Avail = {\cf17 false};\par
02199       Position posC1 = pu.Y().center();\par
02200       Mv cColMv;\par
02201       {\cf18 bool} boundaryCond = ((posRB.x + pcv.minCUWidth) < pcv.lumaWidth) && ((posRB.y + pcv.minCUHeight) < pcv.lumaHeight);\par
02202       {\cf17 const} SubPic &curSubPic = pu.cs->slice->getPPS()->getSubPicFromPos(pu.lumaPos());\par
02203       {\cf19 if} (curSubPic.getTreatedAsPicFlag())\par
02204       \{\par
02205         boundaryCond = ((posRB.x + pcv.minCUWidth) <= curSubPic.getSubPicRight() &&\par
02206           (posRB.y + pcv.minCUHeight) <= curSubPic.getSubPicBottom());\par
02207       \}\par
02208       {\cf19 if} (boundaryCond)\par
02209       \{\par
02210         {\cf18 int} posYInCtu = posRB.y & pcv.maxCUHeightMask;\par
02211         {\cf19 if} (posYInCtu + 4 < pcv.maxCUHeight)\par
02212         \{\par
02213           posC0 = posRB.offset(4, 4);\par
02214           C0Avail = {\cf17 true};\par
02215         \}\par
02216       \}\par
02217       {\cf19 if} ( ( C0Avail && getColocatedMVP( pu, eRefPicList, posC0, cColMv, refIdxCol, {\cf17 false} ) ) || getColocatedMVP( pu, eRefPicList, posC1, cColMv, refIdxCol, {\cf17 false} ) )\par
02218       \{\par
02219         cColMv.roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02220         affiAMVPInfo.mvCandLT[affiAMVPInfo.numCand] = cColMv;\par
02221         affiAMVPInfo.mvCandRT[affiAMVPInfo.numCand] = cColMv;\par
02222         affiAMVPInfo.mvCandLB[affiAMVPInfo.numCand] = cColMv;\par
02223         affiAMVPInfo.numCand++;\par
02224       \}\par
02225     \}\par
02226 \par
02227     {\cf19 if} ( affiAMVPInfo.numCand < 2 )\par
02228     \{\par
02229       {\cf20 // add zero MV}\par
02230       {\cf19 for} ( {\cf18 int} i = affiAMVPInfo.numCand; i < AMVP_MAX_NUM_CANDS; i++ )\par
02231       \{\par
02232         affiAMVPInfo.mvCandLT[affiAMVPInfo.numCand].setZero();\par
02233         affiAMVPInfo.mvCandRT[affiAMVPInfo.numCand].setZero();\par
02234         affiAMVPInfo.mvCandLB[affiAMVPInfo.numCand].setZero();\par
02235         affiAMVPInfo.numCand++;\par
02236       \}\par
02237     \}\par
02238   \}\par
02239 \par
02240   {\cf19 for} ({\cf18 int} i = 0; i < affiAMVPInfo.numCand; i++)\par
02241   \{\par
02242     affiAMVPInfo.mvCandLT[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02243     affiAMVPInfo.mvCandRT[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02244     affiAMVPInfo.mvCandLB[i].roundAffinePrecInternal2Amvr(pu.cu->imv);\par
02245   \}\par
02246 \}\par
