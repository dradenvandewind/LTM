01407 \par
01408   {\cf19 if} (iDiffPocD == iDiffPocB)\par
01409   \{\par
01410     {\cf19 return} 4096;\par
01411   \}\par
01412   {\cf19 else}\par
01413   \{\par
01414     {\cf18 int} iTDB = Clip3(-128, 127, iDiffPocB);\par
01415     {\cf18 int} iTDD = Clip3(-128, 127, iDiffPocD);\par
01416     {\cf18 int} iX = (0x4000 + abs(iTDD / 2)) / iTDD;\par
01417     {\cf18 int} iScale = Clip3(-4096, 4095, (iTDB * iX + 32) >> 6);\par
01418     {\cf19 return} iScale;\par
01419   \}\par
01420 \}\par
01421 \par
01422 {\cf18 int} convertMvFixedToFloat(int32_t val)\par
01423 \{\par
01424   {\cf18 int} sign  = val >> 31;\par
01425   {\cf18 int} scale = floorLog2((val ^ sign) | MV_MANTISSA_UPPER_LIMIT) - (MV_MANTISSA_BITCOUNT - 1);\par
01426 \par
01427   {\cf18 int} exponent;\par
01428   {\cf18 int} mantissa;\par
01429   {\cf19 if} (scale >= 0)\par
01430   \{\par
01431     {\cf18 int} round = (1 << scale) >> 1;\par
01432     {\cf18 int} n     = (val + round) >> scale;\par
01433     exponent  = scale + ((n ^ sign) >> (MV_MANTISSA_BITCOUNT - 1));\par
01434     mantissa  = (n & MV_MANTISSA_UPPER_LIMIT) | (sign << (MV_MANTISSA_BITCOUNT - 1));\par
01435   \}\par
01436   {\cf19 else}\par
01437   \{\par
01438     exponent = 0;\par
01439     mantissa = val;\par
01440   \}\par
01441 \par
01442   {\cf19 return} exponent | (mantissa << MV_EXPONENT_BITCOUNT);\par
01443 \}\par
01444 \par
01445 {\cf18 int} convertMvFloatToFixed({\cf18 int} val)\par
01446 \{\par
01447   {\cf18 int} exponent = val & MV_EXPONENT_MASK;\par
01448   {\cf18 int} mantissa = val >> MV_EXPONENT_BITCOUNT;\par
01449   {\cf19 return} exponent == 0 ? mantissa : (mantissa ^ MV_MANTISSA_LIMIT) << (exponent - 1);\par
01450 \}\par
01451 \par
01452 {\cf18 int} roundMvComp({\cf18 int} x)\par
01453 \{\par
01454   {\cf19 return} convertMvFloatToFixed(convertMvFixedToFloat(x));\par
01455 \}\par
