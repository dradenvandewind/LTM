00498   uint32_t splitDimensionSize, nonSplitDimensionSize, partitionSize, divShift = 2;\par
00499 \par
00500   {\cf19 if}( divideTuInRows )\par
00501   \{\par
00502     splitDimensionSize    = height;\par
00503     nonSplitDimensionSize = width;\par
00504   \}\par
00505   {\cf19 else}\par
00506   \{\par
00507     splitDimensionSize    = width;\par
00508     nonSplitDimensionSize = height;\par
00509   \}\par
00510 \par
00511   {\cf17 const} {\cf18 int} minNumberOfSamplesPerCu = 1 << ( ( floorLog2(MIN_TB_SIZEY) << 1 ) );\par
00512   {\cf17 const} {\cf18 int} factorToMinSamples = nonSplitDimensionSize < minNumberOfSamplesPerCu ? minNumberOfSamplesPerCu >> floorLog2(nonSplitDimensionSize) : 1;\par
00513   partitionSize = ( splitDimensionSize >> divShift ) < factorToMinSamples ? factorToMinSamples : ( splitDimensionSize >> divShift );\par
00514 \par
00515   CHECK( floorLog2(partitionSize) + floorLog2(nonSplitDimensionSize) < floorLog2(minNumberOfSamplesPerCu), {\cf22 "A partition has less than the minimum amount of samples!"} );\par
00516   {\cf19 return} partitionSize;\par
00517 \}\par
