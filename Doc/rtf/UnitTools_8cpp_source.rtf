00302 {\cf18 int} CU::predictQP( {\cf17 const} CodingUnit& cu, {\cf17 const} {\cf18 int} prevQP )\par
00303 \{\par
00304   {\cf17 const} CodingStructure &cs = *cu.cs;\par
00305 \par
00306   uint32_t  ctuRsAddr       = getCtuAddr( cu );\par
00307   uint32_t  ctuXPosInCtus   = ctuRsAddr % cs.pcv->widthInCtus;\par
00308   uint32_t  tileColIdx      = cu.slice->getPPS()->ctuToTileCol( ctuXPosInCtus );\par
00309   uint32_t  tileXPosInCtus  = cu.slice->getPPS()->getTileColumnBd( tileColIdx );\par
00310   {\cf19 if}( ctuXPosInCtus == tileXPosInCtus &&\par
00311       !( cu.blocks[cu.chType].x & ( cs.pcv->maxCUWidthMask  >> getChannelTypeScaleX( cu.chType, cu.chromaFormat ) ) ) &&\par
00312       !( cu.blocks[cu.chType].y & ( cs.pcv->maxCUHeightMask >> getChannelTypeScaleY( cu.chType, cu.chromaFormat ) ) ) &&\par
00313       ( cs.getCU( cu.blocks[cu.chType].pos().offset( 0, -1 ), cu.chType) != NULL ) &&\par
00314       CU::isSameSliceAndTile( *cs.getCU( cu.blocks[cu.chType].pos().offset( 0, -1 ), cu.chType), cu ) )\par
00315   \{\par
00316     {\cf19 return} ( ( cs.getCU( cu.blocks[cu.chType].pos().offset( 0, -1 ), cu.chType ) )->qp );\par
00317   \}\par
00318   {\cf19 else}\par
00319   \{\par
00320     {\cf17 const} {\cf18 int} a = ( cu.blocks[cu.chType].y & ( cs.pcv->maxCUHeightMask >> getChannelTypeScaleY( cu.chType, cu.chromaFormat ) ) ) ? ( cs.getCU(cu.blocks[cu.chType].pos().offset( 0, -1 ), cu.chType))->qp : prevQP;\par
00321     {\cf17 const} {\cf18 int} b = ( cu.blocks[cu.chType].x & ( cs.pcv->maxCUWidthMask  >> getChannelTypeScaleX( cu.chType, cu.chromaFormat ) ) ) ? ( cs.getCU(cu.blocks[cu.chType].pos().offset( -1, 0 ), cu.chType))->qp : prevQP;\par
00322 \par
00323     {\cf19 return} ( a + b + 1 ) >> 1;\par
00324   \}\par
00325 \}\par
