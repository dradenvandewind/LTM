02594     {\cf17 const} {\cf18 bool} isAvailableA1 = puLeft && isDiffMER(pu.lumaPos(), posCurLB.offset(-1, 0), plevel) && pu.cu != puLeft->cu && CU::isInter( *puLeft->cu );\par
02595     {\cf19 if} ( isAvailableA1 )\par
