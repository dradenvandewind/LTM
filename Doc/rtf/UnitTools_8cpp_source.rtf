02680       {\cf19 if} ( affMrgCtx.numValidMergeCand == maxNumAffineMergeCand )\par
02681       \{\par
02682         {\cf19 return};\par
02683       \}\par
02684     \}\par
02686 \par
02688     \{\par
02689       MotionInfo mi[4];\par
02690       {\cf18 bool} isAvailable[4] = \{ {\cf17 false} \};\par
02691 \par
02692       int8_t neighBcw[2] = \{ BCW_DEFAULT, BCW_DEFAULT \};\par
02693       {\cf20 // control point: LT B2->B3->A2}\par
02694       {\cf17 const} Position posLT[3] = \{ pu.Y().topLeft().offset( -1, -1 ), pu.Y().topLeft().offset( 0, -1 ), pu.Y().topLeft().offset( -1, 0 ) \};\par
02695       {\cf19 for} ( {\cf18 int} i = 0; i < 3; i++ )\par
02696       \{\par
02697         {\cf17 const} Position pos = posLT[i];\par
02698         {\cf17 const} PredictionUnit* puNeigh = cs.getPURestricted( pos, pu, pu.chType );\par
02699 \par
02700         {\cf19 if} (puNeigh && CU::isInter(*puNeigh->cu) && PU::isDiffMER(pu.lumaPos(), pos, plevel))\par
02701         \{\par
02702           isAvailable[0] = {\cf17 true};\par
02703           mi[0] = puNeigh->getMotionInfo( pos );\par
02704           neighBcw[0] = puNeigh->cu->BcwIdx;\par
02705           {\cf19 break};\par
02706         \}\par
02707       \}\par
02708 \par
02709       {\cf20 // control point: RT B1->B0}\par
02710       {\cf17 const} Position posRT[2] = \{ pu.Y().topRight().offset( 0, -1 ), pu.Y().topRight().offset( 1, -1 ) \};\par
02711       {\cf19 for} ( {\cf18 int} i = 0; i < 2; i++ )\par
02712       \{\par
02713         {\cf17 const} Position pos = posRT[i];\par
02714         {\cf17 const} PredictionUnit* puNeigh = cs.getPURestricted( pos, pu, pu.chType );\par
02715 \par
02716         {\cf19 if} (puNeigh && CU::isInter(*puNeigh->cu) && PU::isDiffMER(pu.lumaPos(), pos, plevel))\par
02717         \{\par
02718           isAvailable[1] = {\cf17 true};\par
02719           mi[1] = puNeigh->getMotionInfo( pos );\par
02720           neighBcw[1] = puNeigh->cu->BcwIdx;\par
