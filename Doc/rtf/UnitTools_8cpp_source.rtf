00152 {\cf18 void} CU::checkConformanceILRP(Slice *slice)\par
00153 \{\par
00154   {\cf17 const} {\cf18 int} numRefList = slice->isInterB() ? 2 : 1;\par
00155 \par
00156   {\cf18 int} currentSubPicIdx = NOT_VALID;\par
00157 \par
00158   {\cf20 // derive sub-picture index for the current slice}\par
00159   {\cf19 for}( {\cf18 int} subPicIdx = 0; subPicIdx < slice->getPic()->cs->sps->getNumSubPics(); subPicIdx++ )\par
00160   \{\par
00161     {\cf19 if}( slice->getPic()->cs->pps->getSubPic( subPicIdx ).getSubPicID() == slice->getSliceSubPicId() )\par
00162     \{\par
00163       currentSubPicIdx = subPicIdx;\par
00164       {\cf19 break};\par
00165     \}\par
00166   \}\par
00167 \par
00168   CHECK( currentSubPicIdx == NOT_VALID, {\cf22 "Sub-picture was not found"} );\par
00169 \par
00170   {\cf19 if}( !slice->getPic()->cs->sps->getSubPicTreatedAsPicFlag( currentSubPicIdx ) )\par
00171   \{\par
00172     {\cf19 return};\par
00173   \}\par
00174 \par
00175   {\cf20 //constraint 1: The picture referred to by each active entry in RefPicList[ 0 ] or RefPicList[ 1 ] has the same subpicture layout as the current picture }\par
00176   {\cf18 bool} isAllRefSameSubpicLayout = {\cf17 true};\par
00177   {\cf19 for} ({\cf18 int} refList = 0; refList < numRefList; refList++) {\cf20 // loop over l0 and l1}\par
00178   \{\par
00179     RefPicList  eRefPicList = (refList ? REF_PIC_LIST_1 : REF_PIC_LIST_0);\par
00180 \par
00181     {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < slice->getNumRefIdx(eRefPicList); refIdx++)\par
00182     \{\par
00183       {\cf17 const} Picture* refPic = slice->getRefPic( eRefPicList, refIdx );\par
00184 \par
00185       {\cf19 if}( refPic->subPictures.size() != slice->getPic()->cs->pps->getNumSubPics() )\par
00186       \{\par
00187         isAllRefSameSubpicLayout = {\cf17 false};\par
00188         refList = numRefList;\par
00189         {\cf19 break};\par
00190       \}\par
00191       {\cf19 else}\par
00192       \{\par
00193         {\cf19 for}( {\cf18 int} i = 0; i < refPic->subPictures.size(); i++ )\par
00194         \{\par
00195           {\cf17 const} SubPic& refSubPic = refPic->subPictures[i];\par
00196           {\cf17 const} SubPic& curSubPic = slice->getPic()->cs->pps->getSubPic( i );\par
00197 \par
00198           {\cf19 if}( refSubPic.getSubPicWidthInCTUs() != curSubPic.getSubPicWidthInCTUs()\par
00199             || refSubPic.getSubPicHeightInCTUs() != curSubPic.getSubPicHeightInCTUs()\par
00200             || refSubPic.getSubPicCtuTopLeftX() != curSubPic.getSubPicCtuTopLeftX()\par
00201             || refSubPic.getSubPicCtuTopLeftY() != curSubPic.getSubPicCtuTopLeftY()\par
00202             || ( refPic->layerId != slice->getPic()->layerId && refSubPic.getSubPicID() != curSubPic.getSubPicID() )\par
00203             || refSubPic.getTreatedAsPicFlag() != curSubPic.getTreatedAsPicFlag())\par
00204           \{\par
00205             isAllRefSameSubpicLayout = {\cf17 false};\par
00206             refIdx = slice->getNumRefIdx(eRefPicList);\par
00207             refList = numRefList;\par
00208             {\cf19 break};\par
00209           \}\par
00210         \}\par
00211 \par
00212         {\cf20 // A picture with different sub-picture ID of the collocated sub-picture cannot be used as an active reference picture in the same layer}\par
00213         {\cf19 if}( refPic->layerId == slice->getPic()->layerId )\par
00214         \{\par
00215           isAllRefSameSubpicLayout = isAllRefSameSubpicLayout && refPic->subPictures[currentSubPicIdx].getSubPicID() == slice->getSliceSubPicId();\par
00216         \}\par
00217       \}\par
00218     \}\par
00219   \}\par
00220 \par
00221   {\cf20 //constraint 2: The picture referred to by each active entry in RefPicList[ 0 ] or RefPicList[ 1 ] is an ILRP for which the value of sps_num_subpics_minus1 is equal to 0}\par
00222   {\cf19 if} (!isAllRefSameSubpicLayout)\par
00223   \{\par
00224     {\cf19 for} ({\cf18 int} refList = 0; refList < numRefList; refList++) {\cf20 // loop over l0 and l1}\par
00225     \{\par
00226       RefPicList  eRefPicList = (refList ? REF_PIC_LIST_1 : REF_PIC_LIST_0);\par
00227       {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < slice->getNumRefIdx(eRefPicList); refIdx++)\par
00228       \{\par
00229         {\cf17 const} Picture* refPic = slice->getRefPic( eRefPicList, refIdx );\par
00230         CHECK( refPic->layerId == slice->getPic()->layerId || refPic->subPictures.size() > 1, {\cf22 "The inter-layer reference shall contain a single subpicture or have same subpicture layout with the current picture"} );\par
00231       \}\par
00232     \}\par
00233   \}\par
00234 \par
00235   {\cf19 return};\par
00236 \}\par
