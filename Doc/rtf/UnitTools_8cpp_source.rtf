01813 {\cf18 void} PU::fillMvpCand(PredictionUnit &pu, {\cf17 const} RefPicList &eRefPicList, {\cf17 const} {\cf18 int} &refIdx, AMVPInfo &amvpInfo)\par
01814 \{\par
