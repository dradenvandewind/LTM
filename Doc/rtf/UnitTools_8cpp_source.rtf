02355 {\cf18 void} PU::getAffineControlPointCand({\cf17 const} PredictionUnit &pu, MotionInfo mi[4], {\cf18 bool} isAvailable[4], {\cf18 int} verIdx[4], int8_t bcwIdx, {\cf18 int} modelIdx, {\cf18 int} verNum, AffineMergeCtx& affMrgType)\par
02356 \{\par
02357   {\cf18 int} cuW = pu.Y().width;\par
02358   {\cf18 int} cuH = pu.Y().height;\par
02359   {\cf18 int} vx, vy;\par
02360   {\cf18 int} shift = MAX_CU_DEPTH;\par
02361   {\cf18 int} shiftHtoW = shift + floorLog2(cuW) - floorLog2(cuH);\par
02362 \par
02363   {\cf20 // motion info}\par
02364   Mv cMv[2][4];\par
02365   {\cf18 int} refIdx[2] = \{ -1, -1 \};\par
02366   {\cf18 int} dir = 0;\par
02367   EAffineModel curType = (verNum == 2) ? AFFINEMODEL_4PARAM : AFFINEMODEL_6PARAM;\par
02368 \par
02369   {\cf19 if} ( verNum == 2 )\par
02370   \{\par
02371     {\cf18 int} idx0 = verIdx[0], idx1 = verIdx[1];\par
02372     {\cf19 if} ( !isAvailable[idx0] || !isAvailable[idx1] )\par
02373     \{\par
02374       {\cf19 return};\par
02375     \}\par
02376 \par
02377     {\cf19 for} ( {\cf18 int} l = 0; l < 2; l++ )\par
02378     \{\par
02379       {\cf19 if} ( mi[idx0].refIdx[l] >= 0 && mi[idx1].refIdx[l] >= 0 )\par
02380       \{\par
02381         {\cf20 // check same refidx and different mv}\par
02382         {\cf19 if} ( mi[idx0].refIdx[l] == mi[idx1].refIdx[l])\par
02383         \{\par
02384           dir |= (l + 1);\par
02385           refIdx[l] = mi[idx0].refIdx[l];\par
02386         \}\par
02387       \}\par
02388     \}\par
02389 \par
02390   \}\par
02391   {\cf19 else} {\cf19 if} ( verNum == 3 )\par
02392   \{\par
02393     {\cf18 int} idx0 = verIdx[0], idx1 = verIdx[1], idx2 = verIdx[2];\par
02394     {\cf19 if} ( !isAvailable[idx0] || !isAvailable[idx1] || !isAvailable[idx2] )\par
02395     \{\par
02396       {\cf19 return};\par
02397     \}\par
02398 \par
02399     {\cf19 for} ( {\cf18 int} l = 0; l < 2; l++ )\par
02400     \{\par
02401       {\cf19 if} ( mi[idx0].refIdx[l] >= 0 && mi[idx1].refIdx[l] >= 0 && mi[idx2].refIdx[l] >= 0 )\par
02402       \{\par
02403         {\cf20 // check same refidx and different mv}\par
02404         {\cf19 if} ( mi[idx0].refIdx[l] == mi[idx1].refIdx[l] && mi[idx0].refIdx[l] == mi[idx2].refIdx[l])\par
02405         \{\par
02406           dir |= (l + 1);\par
02407           refIdx[l] = mi[idx0].refIdx[l];\par
02408         \}\par
02409       \}\par
02410     \}\par
02411 \par
02412   \}\par
02413 \par
02414   {\cf19 if} ( dir == 0 )\par
02415   \{\par
02416     {\cf19 return};\par
02417   \}\par
02418 \par
02419   {\cf19 for} ( {\cf18 int} l = 0; l < 2; l++ )\par
02420   \{\par
02421     {\cf19 if} ( dir & (l + 1) )\par
02422     \{\par
02423       {\cf19 for} ( {\cf18 int} i = 0; i < verNum; i++ )\par
02424       \{\par
02425         cMv[l][verIdx[i]] = mi[verIdx[i]].mv[l];\par
02426       \}\par
02427 \par
02428       {\cf20 // convert to LT, RT[, [LB]]}\par
02429       {\cf19 switch} ( modelIdx )\par
02430       \{\par
02431       {\cf19 case} 0: {\cf20 // 0 : LT, RT, LB}\par
02432         {\cf19 break};\par
02433 \par
02434       {\cf19 case} 1: {\cf20 // 1 : LT, RT, RB}\par
02435         cMv[l][2].hor = cMv[l][3].hor + cMv[l][0].hor - cMv[l][1].hor;\par
02436         cMv[l][2].ver = cMv[l][3].ver + cMv[l][0].ver - cMv[l][1].ver;\par
02437         cMv[l][2].clipToStorageBitDepth();\par
02438         {\cf19 break};\par
02439 \par
02440       {\cf19 case} 2: {\cf20 // 2 : LT, LB, RB}\par
02441         cMv[l][1].hor = cMv[l][3].hor + cMv[l][0].hor - cMv[l][2].hor;\par
02442         cMv[l][1].ver = cMv[l][3].ver + cMv[l][0].ver - cMv[l][2].ver;\par
02443         cMv[l][1].clipToStorageBitDepth();\par
02444         {\cf19 break};\par
02445 \par
02446       {\cf19 case} 3: {\cf20 // 3 : RT, LB, RB}\par
02447         cMv[l][0].hor = cMv[l][1].hor + cMv[l][2].hor - cMv[l][3].hor;\par
02448         cMv[l][0].ver = cMv[l][1].ver + cMv[l][2].ver - cMv[l][3].ver;\par
02449         cMv[l][0].clipToStorageBitDepth();\par
02450         {\cf19 break};\par
02451 \par
02452       {\cf19 case} 4: {\cf20 // 4 : LT, RT}\par
02453         {\cf19 break};\par
02454 \par
02455       {\cf19 case} 5: {\cf20 // 5 : LT, LB}\par
02456         vx = (cMv[l][0].hor << shift) + ((cMv[l][2].ver - cMv[l][0].ver) << shiftHtoW);\par
02457         vy = (cMv[l][0].ver << shift) - ((cMv[l][2].hor - cMv[l][0].hor) << shiftHtoW);\par
02458         roundAffineMv( vx, vy, shift );\par
02459         cMv[l][1].set( vx, vy );\par
02460         cMv[l][1].clipToStorageBitDepth();\par
02461         {\cf19 break};\par
02462 \par
02463       {\cf19 default}:\par
02464         CHECK( 1, {\cf22 "Invalid model index!\\n"} );\par
02465         {\cf19 break};\par
02466       \}\par
02467     \}\par
02468     {\cf19 else}\par
02469     \{\par
02470       {\cf19 for} ( {\cf18 int} i = 0; i < 4; i++ )\par
02471       \{\par
02472         cMv[l][i].hor = 0;\par
02473         cMv[l][i].ver = 0;\par
02474       \}\par
02475     \}\par
02476   \}\par
02477 \par
02478   {\cf19 for} ( {\cf18 int} i = 0; i < 3; i++ )\par
02479   \{\par
02480     affMrgType.mvFieldNeighbours[(affMrgType.numValidMergeCand << 1) + 0][i].mv = cMv[0][i];\par
02481     affMrgType.mvFieldNeighbours[(affMrgType.numValidMergeCand << 1) + 0][i].refIdx = refIdx[0];\par
02482 \par
02483     affMrgType.mvFieldNeighbours[(affMrgType.numValidMergeCand << 1) + 1][i].mv = cMv[1][i];\par
02484     affMrgType.mvFieldNeighbours[(affMrgType.numValidMergeCand << 1) + 1][i].refIdx = refIdx[1];\par
02485   \}\par
02486   affMrgType.interDirNeighbours[affMrgType.numValidMergeCand] = dir;\par
02487   affMrgType.affineType[affMrgType.numValidMergeCand] = curType;\par
02488   affMrgType.BcwIdx[affMrgType.numValidMergeCand] = (dir == 3) ? bcwIdx : BCW_DEFAULT;\par
02489   affMrgType.numValidMergeCand++;\par
02490 \par
02491   {\cf19 return};\par
02492 \}\par
