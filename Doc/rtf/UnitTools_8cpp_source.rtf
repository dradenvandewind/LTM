02553 {\cf18 void} PU::getAffineMergeCand( {\cf17 const} PredictionUnit &pu, AffineMergeCtx& affMrgCtx, {\cf17 const} {\cf18 int} mrgCandIdx )\par
02554 \{\par
02555   {\cf17 const} CodingStructure &cs = *pu.cs;\par
