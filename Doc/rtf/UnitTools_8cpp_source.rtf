01914     pInfo->numCand = AMVP_MAX_NUM_CANDS;\par
01915   \}\par
01916 \par
01917   {\cf19 while} (pInfo->numCand < AMVP_MAX_NUM_CANDS)\par
01918   \{\par
01919     pInfo->mvCand[pInfo->numCand] = Mv( 0, 0 );\par
01920     pInfo->numCand++;\par
01921   \}\par
01922 \par
01923   {\cf19 for} (Mv &mv : pInfo->mvCand)\par
