02724 \par
02725       {\cf20 // control point: LB A1->A0}\par
02726       {\cf17 const} Position posLB[2] = \{ pu.Y().bottomLeft().offset( -1, 0 ), pu.Y().bottomLeft().offset( -1, 1 ) \};\par
02727       {\cf19 for} ( {\cf18 int} i = 0; i < 2; i++ )\par
02728       \{\par
02729         {\cf17 const} Position pos = posLB[i];\par
02730         {\cf17 const} PredictionUnit* puNeigh = cs.getPURestricted( pos, pu, pu.chType );\par
02731 \par
02732         {\cf19 if} (puNeigh && CU::isInter(*puNeigh->cu) && PU::isDiffMER(pu.lumaPos(), pos, plevel))\par
02733         \{\par
02734           isAvailable[2] = {\cf17 true};\par
02735           mi[2] = puNeigh->getMotionInfo( pos );\par
02736           {\cf19 break};\par
02737         \}\par
02738       \}\par
02739 \par
02740       {\cf20 // control point: RB}\par
02741       {\cf19 if} ( slice.getPicHeader()->getEnableTMVPFlag() )\par
02742       \{\par
02743         {\cf20 //>> MTK colocated-RightBottom}\par
02744         {\cf20 // offset the pos to be sure to "point" to the same position the uiAbsPartIdx would've pointed to}\par
02745         Position posRB = pu.Y().bottomRight().offset( -3, -3 );\par
02746 \par
02747         {\cf17 const} PreCalcValues& pcv = *cs.pcv;\par
02748         Position posC0;\par
02749         {\cf18 bool} C0Avail = {\cf17 false};\par
02750 \par
02751         {\cf18 bool} boundaryCond = ((posRB.x + pcv.minCUWidth) < pcv.lumaWidth) && ((posRB.y + pcv.minCUHeight) < pcv.lumaHeight);\par
02752         {\cf17 const} SubPic &curSubPic = pu.cs->slice->getPPS()->getSubPicFromPos(pu.lumaPos());\par
02753         {\cf19 if} (curSubPic.getTreatedAsPicFlag())\par
02754         \{\par
02755           boundaryCond = ((posRB.x + pcv.minCUWidth) <= curSubPic.getSubPicRight() &&\par
02756             (posRB.y + pcv.minCUHeight) <= curSubPic.getSubPicBottom());\par
02757         \}\par
02758         {\cf19 if} (boundaryCond)\par
02759         \{\par
02760           {\cf18 int} posYInCtu = posRB.y & pcv.maxCUHeightMask;\par
02761           {\cf19 if} (posYInCtu + 4 < pcv.maxCUHeight)\par
02762           \{\par
02763             posC0 = posRB.offset(4, 4);\par
02764             C0Avail = {\cf17 true};\par
02765           \}\par
02766         \}\par
02767 \par
02768         Mv        cColMv;\par
02769         {\cf18 int}       refIdx = 0;\par
02770         {\cf18 bool}      bExistMV = C0Avail && getColocatedMVP( pu, REF_PIC_LIST_0, posC0, cColMv, refIdx, {\cf17 false} );\par
02771         {\cf19 if} ( bExistMV )\par
02772         \{\par
02773           mi[3].mv[0] = cColMv;\par
02774           mi[3].refIdx[0] = refIdx;\par
02775           mi[3].interDir = 1;\par
02776           isAvailable[3] = {\cf17 true};\par
02777         \}\par
02778 \par
02779         {\cf19 if} ( slice.isInterB() )\par
02780         \{\par
02781           bExistMV = C0Avail && getColocatedMVP( pu, REF_PIC_LIST_1, posC0, cColMv, refIdx, {\cf17 false} );\par
02782           {\cf19 if} ( bExistMV )\par
02783           \{\par
02784             mi[3].mv[1] = cColMv;\par
02785             mi[3].refIdx[1] = refIdx;\par
02786             mi[3].interDir |= 2;\par
02787             isAvailable[3] = {\cf17 true};\par
02788           \}\par
02789         \}\par
02790       \}\par
02791 \par
02792       {\cf20 //-------------------  insert model  -------------------//}\par
02793       {\cf18 int} order[6] = \{ 0, 1, 2, 3, 4, 5 \};\par
02794       {\cf18 int} modelNum = 6;\par
02795       {\cf18 int} model[6][4] = \{\par
02796         \{ 0, 1, 2 \},          {\cf20 // 0:  LT, RT, LB}\par
02797         \{ 0, 1, 3 \},          {\cf20 // 1:  LT, RT, RB}\par
02798         \{ 0, 2, 3 \},          {\cf20 // 2:  LT, LB, RB}\par
02799         \{ 1, 2, 3 \},          {\cf20 // 3:  RT, LB, RB}\par
02800         \{ 0, 1 \},             {\cf20 // 4:  LT, RT}\par
02801         \{ 0, 2 \},             {\cf20 // 5:  LT, LB}\par
02802       \};\par
02803 \par
02804       {\cf18 int} verNum[6] = \{ 3, 3, 3, 3, 2, 2 \};\par
02805       {\cf18 int} startIdx = pu.cs->sps->getUseAffineType() ? 0 : 4;\par
02806       {\cf19 for} ( {\cf18 int} idx = startIdx; idx < modelNum; idx++ )\par
02807       \{\par
02808         {\cf18 int} modelIdx = order[idx];\par
02809         getAffineControlPointCand(pu, mi, isAvailable, model[modelIdx], ((modelIdx == 3) ? neighBcw[1] : neighBcw[0]), modelIdx, verNum[modelIdx], affMrgCtx);\par
02810         {\cf19 if} ( affMrgCtx.numValidMergeCand != 0 && affMrgCtx.numValidMergeCand - 1 == mrgCandIdx )\par
02811         \{\par
02812           {\cf19 return};\par
02813         \}\par
02814 \par
02815         {\cf20 // early termination}\par
02816         {\cf19 if} ( affMrgCtx.numValidMergeCand == maxNumAffineMergeCand )\par
02817         \{\par
02818           {\cf19 return};\par
02819         \}\par
02820       \}\par
02821     \}\par
02823   \}\par
02824 \par
02826   {\cf18 int} cnt = affMrgCtx.numValidMergeCand;\par
02827   {\cf19 while} ( cnt < maxNumAffineMergeCand )\par
02828   \{\par
02829     {\cf19 for} ( {\cf18 int} mvNum = 0; mvNum < 3; mvNum++ )\par
02830     \{\par
02831       affMrgCtx.mvFieldNeighbours[(cnt << 1) + 0][mvNum].setMvField( Mv( 0, 0 ), 0 );\par
02832     \}\par
02833     affMrgCtx.interDirNeighbours[cnt] = 1;\par
02834 \par
02835     {\cf19 if} ( slice.isInterB() )\par
02836     \{\par
02837       {\cf19 for} ( {\cf18 int} mvNum = 0; mvNum < 3; mvNum++ )\par
02838       \{\par
02839         affMrgCtx.mvFieldNeighbours[(cnt << 1) + 1][mvNum].setMvField( Mv( 0, 0 ), 0 );\par
02840       \}\par
02841       affMrgCtx.interDirNeighbours[cnt] = 3;\par
02842     \}\par
02843     affMrgCtx.affineType[cnt] = AFFINEMODEL_4PARAM;\par
02844 \par
02845     {\cf19 if} ( cnt == mrgCandIdx )\par
02846     \{\par
02847       {\cf19 return};\par
02848     \}\par
02849     cnt++;\par
02850     affMrgCtx.numValidMergeCand++;\par
02851   \}\par
02852 \}\par
