03597 uint8_t CU::targetSbtAllowed( uint8_t sbtIdx, uint8_t sbtAllowed )\par
03598 \{\par
03599   uint8_t val = 0;\par
03600   {\cf19 switch}( sbtIdx )\par
03601   \{\par
03602   {\cf19 case} SBT_VER_HALF: val = ( ( sbtAllowed >> SBT_VER_HALF ) & 0x1 ); {\cf19 break};\par
03603   {\cf19 case} SBT_HOR_HALF: val = ( ( sbtAllowed >> SBT_HOR_HALF ) & 0x1 ); {\cf19 break};\par
03604   {\cf19 case} SBT_VER_QUAD: val = ( ( sbtAllowed >> SBT_VER_QUAD ) & 0x1 ); {\cf19 break};\par
03605   {\cf19 case} SBT_HOR_QUAD: val = ( ( sbtAllowed >> SBT_HOR_QUAD ) & 0x1 ); {\cf19 break};\par
03606   {\cf19 default}:           CHECK( 1, {\cf22 "unknown SBT type"} );\par
03607   \}\par
03608   {\cf19 return} val;\par
03609 \}\par
