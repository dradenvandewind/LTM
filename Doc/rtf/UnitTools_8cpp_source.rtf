03288 {\cf18 void} PU::getGeoMergeCandidates( {\cf17 const} PredictionUnit &pu, MergeCtx& geoMrgCtx )\par
03289 \{\par
03290   MergeCtx tmpMergeCtx;\par
03291 \par
03292   {\cf17 const} uint32_t maxNumMergeCand = pu.cs->sps->getMaxNumMergeCand();\par
03293   geoMrgCtx.numValidMergeCand = 0;\par
03294 \par
03295   {\cf19 for} (int32_t i = 0; i < GEO_MAX_NUM_UNI_CANDS; i++)\par
03296   \{\par
03297     geoMrgCtx.BcwIdx[i] = BCW_DEFAULT;\par
03298     geoMrgCtx.interDirNeighbours[i] = 0;\par
03299     geoMrgCtx.mrgTypeNeighbours[i] = MRG_TYPE_DEFAULT_N;\par
03300     geoMrgCtx.mvFieldNeighbours[(i << 1)].refIdx = NOT_VALID;\par
03301     geoMrgCtx.mvFieldNeighbours[(i << 1) + 1].refIdx = NOT_VALID;\par
03302     geoMrgCtx.mvFieldNeighbours[(i << 1)].mv = Mv();\par
03303     geoMrgCtx.mvFieldNeighbours[(i << 1) + 1].mv = Mv();\par
03304     geoMrgCtx.useAltHpelIf[i] = {\cf17 false};\par
03305   \}\par
03306 \par
03307   PU::getInterMergeCandidates(pu, tmpMergeCtx, 0);\par
03308 \par
03309   {\cf19 for} (int32_t i = 0; i < maxNumMergeCand; i++)\par
03310   \{\par
03311     {\cf18 int} parity = i & 1;\par
03312     {\cf19 if}( tmpMergeCtx.interDirNeighbours[i] & (0x01 + parity) )\par
03313     \{\par
03314       geoMrgCtx.interDirNeighbours[geoMrgCtx.numValidMergeCand] = 1 + parity;\par
03315       geoMrgCtx.mrgTypeNeighbours[geoMrgCtx.numValidMergeCand] = MRG_TYPE_DEFAULT_N;\par
03316       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + !parity].mv = Mv(0, 0);\par
03317       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + parity].mv = tmpMergeCtx.mvFieldNeighbours[(i << 1) + parity].mv;\par
03318       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + !parity].refIdx = -1;\par
03319       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + parity].refIdx = tmpMergeCtx.mvFieldNeighbours[(i << 1) + parity].refIdx;\par
03320       geoMrgCtx.numValidMergeCand++;\par
03321       {\cf19 if} (geoMrgCtx.numValidMergeCand == GEO_MAX_NUM_UNI_CANDS)\par
03322       \{\par
03323         {\cf19 return};\par
03324       \}\par
03325       {\cf19 continue};\par
03326     \}\par
03327 \par
03328     {\cf19 if} (tmpMergeCtx.interDirNeighbours[i] & (0x02 - parity))\par
03329     \{\par
03330       geoMrgCtx.interDirNeighbours[geoMrgCtx.numValidMergeCand] = 2 - parity;\par
03331       geoMrgCtx.mrgTypeNeighbours[geoMrgCtx.numValidMergeCand] = MRG_TYPE_DEFAULT_N;\par
03332       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + !parity].mv = tmpMergeCtx.mvFieldNeighbours[(i << 1) + !parity].mv;\par
03333       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + parity].mv = Mv(0, 0);\par
03334       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + !parity].refIdx = tmpMergeCtx.mvFieldNeighbours[(i << 1) + !parity].refIdx;\par
03335       geoMrgCtx.mvFieldNeighbours[(geoMrgCtx.numValidMergeCand << 1) + parity].refIdx = -1;\par
03336       geoMrgCtx.numValidMergeCand++;\par
03337       {\cf19 if} (geoMrgCtx.numValidMergeCand == GEO_MAX_NUM_UNI_CANDS)\par
03338       \{\par
03339         {\cf19 return};\par
03340       \}\par
03341     \}\par
03342   \}\par
03343 \}\par
