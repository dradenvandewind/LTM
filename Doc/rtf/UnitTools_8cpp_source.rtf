02574   affMrgCtx.maxNumMergeCand = maxNumAffineMergeCand;\par
02575 \par
02576   {\cf18 bool} sbTmvpEnableFlag = slice.getSPS()->getSbTMVPEnabledFlag()\par
02577                           && !(slice.getPOC() == slice.getRefPic(REF_PIC_LIST_0, 0)->getPOC() && slice.isIRAP());\par
02578   {\cf18 bool} isAvailableSubPu = {\cf17 false};\par
02579   {\cf19 if} (sbTmvpEnableFlag && slice.getPicHeader()->getEnableTMVPFlag())\par
02580   \{\par
02581     MergeCtx mrgCtx = *affMrgCtx.mrgCtx;\par
02582     {\cf18 bool} tmpLICFlag = {\cf17 false};\par
02583 \par
02584     CHECK( mrgCtx.subPuMvpMiBuf.area() == 0 || !mrgCtx.subPuMvpMiBuf.buf, {\cf22 "Buffer not initialized"} );\par
02585     mrgCtx.subPuMvpMiBuf.fill( MotionInfo() );\par
02586 \par
02587     {\cf18 int} pos = 0;\par
02588     {\cf20 // Get spatial MV}\par
