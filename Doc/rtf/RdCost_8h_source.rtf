00303   {\cf17 static} uint32_t    xGetExpGolombNumberOfBits( {\cf18 int} iVal )\par
00304   \{\par
00305     CHECKD( iVal == std::numeric_limits<int>::min(), {\cf22 "Wrong value"} );\par
00306     {\cf18 unsigned} uiLength2 = 1, uiTemp2 = ( iVal <= 0 ) ? ( {\cf18 unsigned}( -iVal ) << 1 ) + 1 : unsigned( iVal << 1 );\par
00307 \par
00308     {\cf19 while}( uiTemp2 > MAX_CU_SIZE )\par
00309     \{\par
00310       uiLength2 += ( MAX_CU_DEPTH << 1 );\par
00311       uiTemp2  >>=   MAX_CU_DEPTH;\par
00312     \}\par
00313 \par
00314     {\cf19 return} uiLength2 + ( floorLog2(uiTemp2) << 1 );\par
00315   \}\par
