00205   {\cf17 inline} Distortion getBvCostMultiplePreds({\cf18 int} x, {\cf18 int} y, {\cf18 bool} useIMV)\par
00206   \{\par
00207     {\cf19 return} Distortion(m_dCost * getBitsMultiplePreds(x, y, useIMV));\par
00208   \}\par
00209 \par
00210   {\cf18 unsigned} {\cf18 int}    getBitsMultiplePreds({\cf18 int} x, {\cf18 int} y, {\cf18 bool} useIMV)\par
00211   \{\par
00212     {\cf18 int} rmvH[2];\par
00213     {\cf18 int} rmvV[2];\par
00214     rmvH[0] = x - m_bvPredictors[0].getHor();\par
00215     rmvH[1] = x - m_bvPredictors[1].getHor();\par
00216 \par
00217     rmvV[0] = y - m_bvPredictors[0].getVer();\par
00218     rmvV[1] = y - m_bvPredictors[1].getVer();\par
00219     {\cf18 int} absCand[2];\par
00220     absCand[0] = abs(rmvH[0]) + abs(rmvV[0]);\par
00221     absCand[1] = abs(rmvH[1]) + abs(rmvV[1]);\par
00222 \par
00223     {\cf18 int} rmvHQP[2];\par
00224     {\cf18 int} rmvVQP[2];\par
00225     {\cf19 if} (x % 4 == 0 && y % 4 == 0 && useIMV)\par
00226     \{\par
00227       {\cf18 int} imvShift = 2;\par
00228       {\cf18 int} offset = 1 << (imvShift - 1);\par
00229 \par
00230       rmvHQP[0] = (x >> 2) - ((m_bvPredictors[0].getHor() + offset) >> 2);\par
00231       rmvHQP[1] = (x >> 2) - ((m_bvPredictors[1].getHor() + offset) >> 2);\par
00232       rmvVQP[0] = (y >> 2) - ((m_bvPredictors[0].getVer() + offset) >> 2);\par
00233       rmvVQP[1] = (y >> 2) - ((m_bvPredictors[1].getVer() + offset) >> 2);\par
00234 \par
00235       {\cf18 int} absCandQP[2];\par
00236       absCandQP[0] = abs(rmvHQP[0]) + abs(rmvVQP[0]);\par
00237       absCandQP[1] = abs(rmvHQP[1]) + abs(rmvVQP[1]);\par
00238       {\cf18 unsigned} {\cf18 int} candBits0QP, candBits1QP;\par
00239       {\cf19 if} (absCand[0] < absCand[1])\par
00240       \{\par
00241         {\cf18 unsigned} {\cf18 int} candBits0 = getIComponentBits(rmvH[0]) + getIComponentBits(rmvV[0]);\par
00242         {\cf19 if} (absCandQP[0] < absCandQP[1])\par
00243         \{\par
00244           candBits0QP = getIComponentBits(rmvHQP[0]) + getIComponentBits(rmvVQP[0]);\par
00245           {\cf19 return} candBits0QP <candBits0 ? candBits0QP : candBits0;\par
00246         \}\par
00247         {\cf19 else}\par
00248         \{\par
00249           candBits1QP = getIComponentBits(rmvHQP[1]) + getIComponentBits(rmvVQP[1]);\par
00250           {\cf19 return} candBits1QP < candBits0 ? candBits1QP : candBits0;\par
00251         \}\par
00252       \}\par
00253       {\cf19 else}\par
00254       \{\par
00255         {\cf18 unsigned} {\cf18 int} candBits1 = getIComponentBits(rmvH[1]) + getIComponentBits(rmvV[1]);\par
00256         {\cf19 if} (absCandQP[0] < absCandQP[1])\par
00257         \{\par
00258           candBits0QP = getIComponentBits(rmvHQP[0]) + getIComponentBits(rmvVQP[0]);\par
00259           {\cf19 return} candBits0QP < candBits1 ? candBits0QP : candBits1;\par
00260         \}\par
00261         {\cf19 else}\par
00262         \{\par
00263           candBits1QP = getIComponentBits(rmvHQP[1]) + getIComponentBits(rmvVQP[1]);\par
00264           {\cf19 return} candBits1QP < candBits1 ? candBits1QP : candBits1;\par
00265         \}\par
00266       \}\par
00267     \}\par
00268     {\cf19 else}\par
00269 \par
00270     \{\par
00271       {\cf19 if} (absCand[0] < absCand[1])\par
00272       \{\par
00273         {\cf19 return} getIComponentBits(rmvH[0]) + getIComponentBits(rmvV[0]);\par
00274       \}\par
00275       {\cf19 else}\par
00276       \{\par
00277         {\cf19 return} getIComponentBits(rmvH[1]) + getIComponentBits(rmvV[1]);\par
00278       \}\par
00279     \}\par
00280   \}\par
00281 \par
00282   {\cf18 unsigned} {\cf18 int} getIComponentBits({\cf18 int} val)\par
00283   \{\par
00284     {\cf19 if} (!val) {\cf19 return} 1;\par
00285 \par
00286     {\cf18 unsigned} {\cf18 int} length = 1;\par
00287     {\cf18 unsigned} {\cf18 int} temp = (val <= 0) ? (-val << 1) + 1 : (val << 1);\par
00288 \par
00289     {\cf19 while} (1 != temp)\par
00290     \{\par
00291       temp >>= 1;\par
00292       length += 2;\par
00293     \}\par
00294 \par
00295     {\cf19 return} length;\par
00296   \}\par
