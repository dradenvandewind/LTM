00295 {\cf18 void} SampleAdaptiveOffset::offsetBlock({\cf17 const} {\cf18 int} channelBitDepth, {\cf17 const} ClpRng& clpRng, {\cf18 int} typeIdx, {\cf18 int}* offset\par
00296                                           , {\cf17 const} Pel* srcBlk, Pel* resBlk, {\cf18 int} srcStride, {\cf18 int} resStride,  {\cf18 int} width, {\cf18 int} height\par
00297                                           , {\cf18 bool} isLeftAvail,  {\cf18 bool} isRightAvail, {\cf18 bool} isAboveAvail, {\cf18 bool} isBelowAvail, {\cf18 bool} isAboveLeftAvail, {\cf18 bool} isAboveRightAvail, {\cf18 bool} isBelowLeftAvail, {\cf18 bool} isBelowRightAvail\par
00298                                           , {\cf18 bool} isCtuCrossedByVirtualBoundaries, {\cf18 int} horVirBndryPos[], {\cf18 int} verVirBndryPos[], {\cf18 int} numHorVirBndry, {\cf18 int} numVerVirBndry\par
00299   )\par
00300 \{\par
00301   {\cf18 int} x,y, startX, startY, endX, endY, edgeType;\par
00302   {\cf18 int} firstLineStartX, firstLineEndX, lastLineStartX, lastLineEndX;\par
00303   int8_t signLeft, signRight, signDown;\par
00304 \par
00305   {\cf17 const} Pel* srcLine = srcBlk;\par
00306         Pel* resLine = resBlk;\par
00307 \par
00308   {\cf19 switch}(typeIdx)\par
00309   \{\par
00310   {\cf19 case} SAO_TYPE_EO_0:\par
00311     \{\par
00312       offset += 2;\par
00313       startX = isLeftAvail ? 0 : 1;\par
00314       endX   = isRightAvail ? width : (width -1);\par
00315       {\cf19 for} (y=0; y< height; y++)\par
00316       \{\par
00317         signLeft = (int8_t)sgn(srcLine[startX] - srcLine[startX-1]);\par
00318         {\cf19 for} (x=startX; x< endX; x++)\par
00319         \{\par
00320           signRight = (int8_t)sgn(srcLine[x] - srcLine[x+1]);\par
00321           {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, y, numVerVirBndry, 0, verVirBndryPos, horVirBndryPos))\par
00322           \{\par
00323             signLeft = -signRight;\par
00324             {\cf19 continue};\par
00325           \}\par
00326           edgeType =  signRight + signLeft;\par
00327           signLeft  = -signRight;\par
00328 \par
00329           resLine[x] = ClipPel<int>( srcLine[x] + offset[edgeType], clpRng);\par
00330         \}\par
00331         srcLine  += srcStride;\par
00332         resLine += resStride;\par
00333       \}\par
00334 \par
00335     \}\par
00336     {\cf19 break};\par
00337   {\cf19 case} SAO_TYPE_EO_90:\par
00338     \{\par
00339       offset += 2;\par
00340       int8_t *signUpLine = &m_signLineBuf1[0];\par
00341 \par
00342       startY = isAboveAvail ? 0 : 1;\par
00343       endY   = isBelowAvail ? height : height-1;\par
00344       {\cf19 if} (!isAboveAvail)\par
00345       \{\par
00346         srcLine += srcStride;\par
00347         resLine += resStride;\par
00348       \}\par
00349 \par
00350       {\cf17 const} Pel* srcLineAbove= srcLine- srcStride;\par
00351       {\cf19 for} (x=0; x< width; x++)\par
00352       \{\par
00353         signUpLine[x] = (int8_t)sgn(srcLine[x] - srcLineAbove[x]);\par
00354       \}\par
00355 \par
00356       {\cf17 const} Pel* srcLineBelow;\par
00357       {\cf19 for} (y=startY; y<endY; y++)\par
00358       \{\par
00359         srcLineBelow= srcLine+ srcStride;\par
00360 \par
00361         {\cf19 for} (x=0; x< width; x++)\par
00362         \{\par
00363           signDown  = (int8_t)sgn(srcLine[x] - srcLineBelow[x]);\par
00364           {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, y, 0, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00365           \{\par
00366             signUpLine[x] = -signDown;\par
00367             {\cf19 continue};\par
00368           \}\par
00369           edgeType = signDown + signUpLine[x];\par
00370           signUpLine[x]= -signDown;\par
00371 \par
00372           resLine[x] = ClipPel<int>(srcLine[x] + offset[edgeType], clpRng);\par
00373         \}\par
00374         srcLine += srcStride;\par
00375         resLine += resStride;\par
00376       \}\par
00377 \par
00378     \}\par
00379     {\cf19 break};\par
00380   {\cf19 case} SAO_TYPE_EO_135:\par
00381     \{\par
00382       offset += 2;\par
00383       int8_t *signUpLine, *signDownLine, *signTmpLine;\par
00384 \par
00385       signUpLine  = &m_signLineBuf1[0];\par
00386       signDownLine= &m_signLineBuf2[0];\par
00387 \par
00388       startX = isLeftAvail ? 0 : 1 ;\par
00389       endX   = isRightAvail ? width : (width-1);\par
00390 \par
00391       {\cf20 //prepare 2nd line's upper sign}\par
00392       {\cf17 const} Pel* srcLineBelow= srcLine+ srcStride;\par
00393       {\cf19 for} (x=startX; x< endX+1; x++)\par
00394       \{\par
00395         signUpLine[x] = (int8_t)sgn(srcLineBelow[x] - srcLine[x- 1]);\par
00396       \}\par
00397 \par
00398       {\cf20 //1st line}\par
00399       {\cf17 const} Pel* srcLineAbove= srcLine- srcStride;\par
00400       firstLineStartX = isAboveLeftAvail ? 0 : 1;\par
00401       firstLineEndX   = isAboveAvail? endX: 1;\par
00402       {\cf19 for}(x= firstLineStartX; x< firstLineEndX; x++)\par
00403       \{\par
00404         {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, 0, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00405         \{\par
00406           {\cf19 continue};\par
00407         \}\par
00408         edgeType  =  sgn(srcLine[x] - srcLineAbove[x- 1]) - signUpLine[x+1];\par
00409 \par
00410         resLine[x] = ClipPel<int>( srcLine[x] + offset[edgeType], clpRng);\par
00411       \}\par
00412       srcLine  += srcStride;\par
00413       resLine  += resStride;\par
00414 \par
00415 \par
00416       {\cf20 //middle lines}\par
00417       {\cf19 for} (y= 1; y< height-1; y++)\par
00418       \{\par
00419         srcLineBelow= srcLine+ srcStride;\par
00420 \par
00421         {\cf19 for} (x=startX; x<endX; x++)\par
00422         \{\par
00423           signDown =  (int8_t)sgn(srcLine[x] - srcLineBelow[x+ 1]);\par
00424           {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, y, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00425           \{\par
00426             signDownLine[x + 1] = -signDown;\par
00427             {\cf19 continue};\par
00428           \}\par
00429           edgeType =  signDown + signUpLine[x];\par
00430           resLine[x] = ClipPel<int>( srcLine[x] + offset[edgeType], clpRng);\par
00431 \par
00432           signDownLine[x+1] = -signDown;\par
00433         \}\par
00434         signDownLine[startX] = (int8_t)sgn(srcLineBelow[startX] - srcLine[startX-1]);\par
00435 \par
00436         signTmpLine  = signUpLine;\par
00437         signUpLine   = signDownLine;\par
00438         signDownLine = signTmpLine;\par
00439 \par
00440         srcLine += srcStride;\par
00441         resLine += resStride;\par
00442       \}\par
00443 \par
00444       {\cf20 //last line}\par
00445       srcLineBelow= srcLine+ srcStride;\par
00446       lastLineStartX = isBelowAvail ? startX : (width -1);\par
00447       lastLineEndX   = isBelowRightAvail ? width : (width -1);\par
00448       {\cf19 for}(x= lastLineStartX; x< lastLineEndX; x++)\par
00449       \{\par
00450         {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, height - 1, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00451         \{\par
00452           {\cf19 continue};\par
00453         \}\par
00454         edgeType =  sgn(srcLine[x] - srcLineBelow[x+ 1]) + signUpLine[x];\par
00455         resLine[x] = ClipPel<int>( srcLine[x] + offset[edgeType], clpRng);\par
00456 \par
00457       \}\par
00458     \}\par
00459     {\cf19 break};\par
00460   {\cf19 case} SAO_TYPE_EO_45:\par
00461     \{\par
00462       offset += 2;\par
00463       int8_t *signUpLine = &m_signLineBuf1[1];\par
00464 \par
00465       startX = isLeftAvail ? 0 : 1;\par
00466       endX   = isRightAvail ? width : (width -1);\par
00467 \par
00468       {\cf20 //prepare 2nd line upper sign}\par
00469       {\cf17 const} Pel* srcLineBelow= srcLine+ srcStride;\par
00470       {\cf19 for} (x=startX-1; x< endX; x++)\par
00471       \{\par
00472         signUpLine[x] = (int8_t)sgn(srcLineBelow[x] - srcLine[x+1]);\par
00473       \}\par
00474 \par
00475 \par
00476       {\cf20 //first line}\par
00477       {\cf17 const} Pel* srcLineAbove= srcLine- srcStride;\par
00478       firstLineStartX = isAboveAvail ? startX : (width -1 );\par
00479       firstLineEndX   = isAboveRightAvail ? width : (width-1);\par
00480       {\cf19 for}(x= firstLineStartX; x< firstLineEndX; x++)\par
00481       \{\par
00482         {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, 0, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00483         \{\par
00484           {\cf19 continue};\par
00485         \}\par
00486         edgeType = sgn(srcLine[x] - srcLineAbove[x+1]) -signUpLine[x-1];\par
00487         resLine[x] = ClipPel<int>(srcLine[x] + offset[edgeType], clpRng);\par
00488       \}\par
00489       srcLine += srcStride;\par
00490       resLine += resStride;\par
00491 \par
00492       {\cf20 //middle lines}\par
00493       {\cf19 for} (y= 1; y< height-1; y++)\par
00494       \{\par
00495         srcLineBelow= srcLine+ srcStride;\par
00496 \par
00497         {\cf19 for}(x= startX; x< endX; x++)\par
00498         \{\par
00499           signDown =  (int8_t)sgn(srcLine[x] - srcLineBelow[x-1]);\par
00500           {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, y, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00501           \{\par
00502             signUpLine[x - 1] = -signDown;\par
00503             {\cf19 continue};\par
00504           \}\par
00505           edgeType =  signDown + signUpLine[x];\par
00506           resLine[x] = ClipPel<int>(srcLine[x] + offset[edgeType], clpRng);\par
00507           signUpLine[x-1] = -signDown;\par
00508         \}\par
00509         signUpLine[endX-1] = (int8_t)sgn(srcLineBelow[endX-1] - srcLine[endX]);\par
00510         srcLine  += srcStride;\par
00511         resLine += resStride;\par
00512       \}\par
00513 \par
00514       {\cf20 //last line}\par
00515       srcLineBelow= srcLine+ srcStride;\par
00516       lastLineStartX = isBelowLeftAvail ? 0 : 1;\par
00517       lastLineEndX   = isBelowAvail ? endX : 1;\par
00518       {\cf19 for}(x= lastLineStartX; x< lastLineEndX; x++)\par
00519       \{\par
00520         {\cf19 if} (isCtuCrossedByVirtualBoundaries && isProcessDisabled(x, height - 1, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos))\par
00521         \{\par
00522           {\cf19 continue};\par
00523         \}\par
00524         edgeType = sgn(srcLine[x] - srcLineBelow[x-1]) + signUpLine[x];\par
00525         resLine[x] = ClipPel<int>(srcLine[x] + offset[edgeType], clpRng);\par
00526 \par
00527       \}\par
00528     \}\par
00529     {\cf19 break};\par
00530   {\cf19 case} SAO_TYPE_BO:\par
00531     \{\par
00532       {\cf17 const} {\cf18 int} shiftBits = channelBitDepth - NUM_SAO_BO_CLASSES_LOG2;\par
00533       {\cf19 for} (y=0; y< height; y++)\par
00534       \{\par
00535         {\cf19 for} (x=0; x< width; x++)\par
00536         \{\par
00537           resLine[x] = ClipPel<int>(srcLine[x] + offset[srcLine[x] >> shiftBits], clpRng );\par
00538         \}\par
00539         srcLine += srcStride;\par
00540         resLine += resStride;\par
00541       \}\par
00542     \}\par
00543     {\cf19 break};\par
00544   {\cf19 default}:\par
00545     \{\par
00546       THROW({\cf22 "Not a supported SAO types\\n"});\par
00547     \}\par
00548   \}\par
00549 \}\par
