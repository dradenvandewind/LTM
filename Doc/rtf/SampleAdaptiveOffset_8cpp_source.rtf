00150 {\cf18 void} SampleAdaptiveOffset::invertQuantOffsets(ComponentID compIdx, {\cf18 int} typeIdc, {\cf18 int} typeAuxInfo, {\cf18 int}* dstOffsets, {\cf18 int}* srcOffsets)\par
00151 \{\par
00152   {\cf18 int} codedOffset[MAX_NUM_SAO_CLASSES];\par
00153 \par
00154   ::memcpy(codedOffset, srcOffsets, {\cf17 sizeof}({\cf18 int})*MAX_NUM_SAO_CLASSES);\par
00155   ::memset(dstOffsets, 0, {\cf17 sizeof}({\cf18 int})*MAX_NUM_SAO_CLASSES);\par
00156 \par
00157   {\cf19 if}(typeIdc == SAO_TYPE_START_BO)\par
00158   \{\par
00159     {\cf19 for}({\cf18 int} i=0; i< 4; i++)\par
00160     \{\par
00161       dstOffsets[(typeAuxInfo+ i)%NUM_SAO_BO_CLASSES] = codedOffset[(typeAuxInfo+ i)%NUM_SAO_BO_CLASSES]*(1<<m_offsetStepLog2[compIdx]);\par
00162     \}\par
00163   \}\par
00164   {\cf19 else} {\cf20 //EO}\par
00165   \{\par
00166     {\cf19 for}({\cf18 int} i=0; i< NUM_SAO_EO_CLASSES; i++)\par
00167     \{\par
00168       dstOffsets[i] = codedOffset[i] *(1<<m_offsetStepLog2[compIdx]);\par
00169     \}\par
00170     CHECK(dstOffsets[SAO_CLASS_EO_PLAIN] != 0, {\cf22 "EO offset is not '0'"}); {\cf20 //keep EO plain offset as zero}\par
00171   \}\par
00172 \par
00173 \}\par
