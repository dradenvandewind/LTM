00643   m_tempBuf.copyFrom( rec );\par
00644 \par
00645   {\cf18 int} ctuRsAddr = 0;\par
00646   {\cf19 for}( uint32_t yPos = 0; yPos < pcv.lumaHeight; yPos += pcv.maxCUHeight )\par
00647   \{\par
00648     {\cf19 for}( uint32_t xPos = 0; xPos < pcv.lumaWidth; xPos += pcv.maxCUWidth )\par
00649     \{\par
00650       {\cf17 const} uint32_t width  = (xPos + pcv.maxCUWidth  > pcv.lumaWidth)  ? (pcv.lumaWidth - xPos)  : pcv.maxCUWidth;\par
00651       {\cf17 const} uint32_t height = (yPos + pcv.maxCUHeight > pcv.lumaHeight) ? (pcv.lumaHeight - yPos) : pcv.maxCUHeight;\par
00652       {\cf17 const} UnitArea area( cs.area.chromaFormat, Area(xPos , yPos, width, height) );\par
00653 \par
00654       offsetCTU( area, m_tempBuf, rec, cs.picture->getSAO()[ctuRsAddr], cs);\par
00655       ctuRsAddr++;\par
00656     \}\par
00657   \}\par
00658 \par
00659   DTRACE_UPDATE(g_trace_ctx, (std::make_pair({\cf22 "poc"}, cs.slice->getPOC())));\par
00660   DTRACE_PIC_COMP(D_REC_CB_LUMA_SAO, cs, cs.getRecoBuf(), COMPONENT_Y);\par
00661   DTRACE_PIC_COMP(D_REC_CB_CHROMA_SAO, cs, cs.getRecoBuf(), COMPONENT_Cb);\par
00662   DTRACE_PIC_COMP(D_REC_CB_CHROMA_SAO, cs, cs.getRecoBuf(), COMPONENT_Cr);\par
00663 \par
00664   DTRACE    ( g_trace_ctx, D_CRC, {\cf22 "SAO"} );\par
00665   DTRACE_CRC( g_trace_ctx, D_CRC, cs, cs.getRecoBuf() );\par
00666 \par
00667 \}\par
