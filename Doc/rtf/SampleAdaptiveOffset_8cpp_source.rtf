00747 {\cf18 bool} SampleAdaptiveOffset::isCrossedByVirtualBoundaries({\cf17 const} {\cf18 int} xPos, {\cf17 const} {\cf18 int} yPos, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height, {\cf18 int}& numHorVirBndry, {\cf18 int}& numVerVirBndry, {\cf18 int} horVirBndryPos[], {\cf18 int} verVirBndryPos[], {\cf17 const} PicHeader* picHeader )\par
00748 \{\par
00749   numHorVirBndry = 0; numVerVirBndry = 0;\par
00750   {\cf19 if}( picHeader->getVirtualBoundariesPresentFlag() )\par
00751   \{\par
00752     {\cf19 for} ({\cf18 int} i = 0; i < picHeader->getNumHorVirtualBoundaries(); i++)\par
00753     \{\par
00754      {\cf19 if} (yPos <= picHeader->getVirtualBoundariesPosY(i) && picHeader->getVirtualBoundariesPosY(i) <= yPos + height)\par
00755       \{\par
00756         horVirBndryPos[numHorVirBndry++] = picHeader->getVirtualBoundariesPosY(i);\par
00757       \}\par
00758     \}\par
00759     {\cf19 for} ({\cf18 int} i = 0; i < picHeader->getNumVerVirtualBoundaries(); i++)\par
00760     \{\par
00761       {\cf19 if} (xPos <= picHeader->getVirtualBoundariesPosX(i) && picHeader->getVirtualBoundariesPosX(i) <= xPos + width)\par
00762       \{\par
00763         verVirBndryPos[numVerVirBndry++] = picHeader->getVirtualBoundariesPosX(i);\par
00764       \}\par
00765     \}\par
00766   \}\par
00767   {\cf19 return} numHorVirBndry > 0 || numVerVirBndry > 0 ;\par
00768 \}\par
