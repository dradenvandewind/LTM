00129 {\cf18 void} SampleAdaptiveOffset::create( {\cf18 int} picWidth, {\cf18 int} picHeight, ChromaFormat format, uint32_t maxCUWidth, uint32_t maxCUHeight, uint32_t maxCUDepth, uint32_t lumaBitShift, uint32_t chromaBitShift )\par
00130 \{\par
