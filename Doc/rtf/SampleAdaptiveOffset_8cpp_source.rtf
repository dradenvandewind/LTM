00132   UnitArea picArea(format, Area(0, 0, picWidth, picHeight));\par
00133 \par
00134   m_tempBuf.destroy();\par
00135   m_tempBuf.create( picArea );\par
00136 \par
00137   {\cf20 //bit-depth related}\par
00138   {\cf19 for}({\cf18 int} compIdx = 0; compIdx < MAX_NUM_COMPONENT; compIdx++)\par
00139   \{\par
00140     m_offsetStepLog2  [compIdx] = isLuma(ComponentID(compIdx))? lumaBitShift : chromaBitShift;\par
00141   \}\par
00142   m_numberOfComponents = getNumberValidComponents(format);\par
00143 \}\par
