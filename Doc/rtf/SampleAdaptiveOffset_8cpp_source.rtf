00175 {\cf18 int} SampleAdaptiveOffset::getMergeList(CodingStructure& cs, {\cf18 int} ctuRsAddr, SAOBlkParam* blkParams, SAOBlkParam* mergeList[NUM_SAO_MERGE_TYPES])\par
00176 \{\par
00177   {\cf17 const} PreCalcValues& pcv = *cs.pcv;\par
00178 \par
00179   {\cf18 int} ctuX = ctuRsAddr % pcv.widthInCtus;\par
00180   {\cf18 int} ctuY = ctuRsAddr / pcv.widthInCtus;\par
00181   {\cf17 const} CodingUnit& cu = *cs.getCU(Position(ctuX*pcv.maxCUWidth, ctuY*pcv.maxCUHeight), CH_L);\par
00182   {\cf18 int} mergedCTUPos;\par
00183   {\cf18 int} numValidMergeCandidates = 0;\par
00184 \par
00185   {\cf19 for}({\cf18 int} mergeType=0; mergeType< NUM_SAO_MERGE_TYPES; mergeType++)\par
00186   \{\par
00187     SAOBlkParam* mergeCandidate = NULL;\par
00188 \par
00189     {\cf19 switch}(mergeType)\par
00190     \{\par
00191     {\cf19 case} SAO_MERGE_ABOVE:\par
00192       \{\par
00193         {\cf19 if}(ctuY > 0)\par
00194         \{\par
00195           mergedCTUPos = ctuRsAddr- pcv.widthInCtus;\par
00196           {\cf19 if}(cs.getCURestricted(Position(ctuX*pcv.maxCUWidth, (ctuY-1)*pcv.maxCUHeight), cu, cu.chType))\par
00197           \{\par
00198             mergeCandidate = &(blkParams[mergedCTUPos]);\par
00199           \}\par
00200         \}\par
00201       \}\par
00202       {\cf19 break};\par
00203     {\cf19 case} SAO_MERGE_LEFT:\par
00204       \{\par
00205         {\cf19 if}(ctuX > 0)\par
00206         \{\par
00207           mergedCTUPos = ctuRsAddr- 1;\par
00208           {\cf19 if}(cs.getCURestricted(Position((ctuX-1)*pcv.maxCUWidth, ctuY*pcv.maxCUHeight), cu, cu.chType))\par
00209           \{\par
00210             mergeCandidate = &(blkParams[mergedCTUPos]);\par
00211           \}\par
00212         \}\par
00213       \}\par
00214       {\cf19 break};\par
00215     {\cf19 default}:\par
00216       \{\par
00217         THROW({\cf22 "not a supported merge type"});\par
00218       \}\par
00219     \}\par
00220 \par
00221     mergeList[mergeType]=mergeCandidate;\par
00222     {\cf19 if} (mergeCandidate != NULL)\par
00223     \{\par
00224       numValidMergeCandidates++;\par
00225     \}\par
00226   \}\par
00227 \par
00228   {\cf19 return} numValidMergeCandidates;\par
00229 \}\par
