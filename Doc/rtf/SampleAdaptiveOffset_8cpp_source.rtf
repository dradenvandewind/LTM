00670 {\cf18 void} SampleAdaptiveOffset::deriveLoopFilterBoundaryAvailibility(CodingStructure& cs, {\cf17 const} Position &pos,\par
00671   {\cf18 bool}& isLeftAvail,\par
00672   {\cf18 bool}& isRightAvail,\par
00673   {\cf18 bool}& isAboveAvail,\par
00674   {\cf18 bool}& isBelowAvail,\par
00675   {\cf18 bool}& isAboveLeftAvail,\par
00676   {\cf18 bool}& isAboveRightAvail,\par
00677   {\cf18 bool}& isBelowLeftAvail,\par
00678   {\cf18 bool}& isBelowRightAvail\par
00679   ){\cf17  const}\par
00680 {\cf17 }\{\par
00681   {\cf17 const} {\cf18 int} width = cs.pcv->maxCUWidth;\par
00682   {\cf17 const} {\cf18 int} height = cs.pcv->maxCUHeight;\par
00683   {\cf17 const} CodingUnit* cuCurr = cs.getCU(pos, CH_L);\par
00684   {\cf17 const} CodingUnit* cuLeft = cs.getCU(pos.offset(-width, 0), CH_L);\par
00685   {\cf17 const} CodingUnit* cuRight = cs.getCU(pos.offset(width, 0), CH_L);\par
00686   {\cf17 const} CodingUnit* cuAbove = cs.getCU(pos.offset(0, -height), CH_L);\par
00687   {\cf17 const} CodingUnit* cuBelow = cs.getCU(pos.offset(0, height), CH_L);\par
00688   {\cf17 const} CodingUnit* cuAboveLeft = cs.getCU(pos.offset(-width, -height), CH_L);\par
00689   {\cf17 const} CodingUnit* cuAboveRight = cs.getCU(pos.offset(width, -height), CH_L);\par
00690   {\cf17 const} CodingUnit* cuBelowLeft = cs.getCU(pos.offset(-width, height), CH_L);\par
00691   {\cf17 const} CodingUnit* cuBelowRight = cs.getCU(pos.offset(width, height), CH_L);\par
00692 \par
00693   {\cf20 // check cross slice flags}\par
00694   {\cf17 const} {\cf18 bool} isLoopFilterAcrossSlicePPS = cs.pps->getLoopFilterAcrossSlicesEnabledFlag();\par
00695   {\cf19 if} (!isLoopFilterAcrossSlicePPS)\par
00696   \{\par
00697     isLeftAvail       = (cuLeft == NULL)       ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuLeft);\par
00698     isAboveAvail      = (cuAbove == NULL)      ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuAbove);\par
00699     isRightAvail      = (cuRight == NULL)      ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuRight);\par
00700     isBelowAvail      = (cuBelow == NULL)      ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuBelow);\par
00701     isAboveLeftAvail  = (cuAboveLeft == NULL)  ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuAboveLeft);\par
00702     isAboveRightAvail = (cuAboveRight == NULL) ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuAboveRight);\par
00703     isBelowLeftAvail  = (cuBelowLeft == NULL)  ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuBelowLeft);\par
00704     isBelowRightAvail = (cuBelowRight == NULL) ? {\cf17 false} : CU::isSameSlice(*cuCurr, *cuBelowRight);\par
00705   \}\par
00706   {\cf19 else}\par
00707   \{\par
00708     isLeftAvail       = (cuLeft != NULL);\par
00709     isAboveAvail      = (cuAbove != NULL);\par
00710     isRightAvail      = (cuRight != NULL);\par
00711     isBelowAvail      = (cuBelow != NULL);\par
00712     isAboveLeftAvail  = (cuAboveLeft != NULL);\par
00713     isAboveRightAvail = (cuAboveRight != NULL);\par
00714     isBelowLeftAvail  = (cuBelowLeft != NULL);\par
00715     isBelowRightAvail = (cuBelowRight != NULL);\par
00716   \}\par
00717 \par
00718   {\cf20 // check cross tile flags}\par
00719   {\cf17 const} {\cf18 bool} isLoopFilterAcrossTilePPS = cs.pps->getLoopFilterAcrossTilesEnabledFlag();\par
00720   {\cf19 if} (!isLoopFilterAcrossTilePPS)\par
00721   \{\par
00722     isLeftAvail       = (!isLeftAvail)       ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuLeft);\par
00723     isAboveAvail      = (!isAboveAvail)      ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuAbove);\par
00724     isRightAvail      = (!isRightAvail)      ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuRight);\par
00725     isBelowAvail      = (!isBelowAvail)      ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuBelow);\par
00726     isAboveLeftAvail  = (!isAboveLeftAvail)  ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuAboveLeft);\par
00727     isAboveRightAvail = (!isAboveRightAvail) ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuAboveRight);\par
00728     isBelowLeftAvail  = (!isBelowLeftAvail)  ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuBelowLeft);\par
00729     isBelowRightAvail = (!isBelowRightAvail) ? {\cf17 false} : CU::isSameTile(*cuCurr, *cuBelowRight);\par
00730   \}\par
00731 \par
00732   {\cf20 // check cross subpic flags}\par
00733   {\cf17 const} SubPic& curSubPic = cs.pps->getSubPicFromCU(*cuCurr);\par
00734   {\cf19 if} (!curSubPic.getloopFilterAcrossEnabledFlag())\par
00735   \{\par
00736     isLeftAvail       = (!isLeftAvail)       ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuLeft);\par
00737     isAboveAvail      = (!isAboveAvail)      ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuAbove);\par
00738     isRightAvail      = (!isRightAvail)      ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuRight);\par
00739     isBelowAvail      = (!isBelowAvail)      ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuBelow);\par
00740     isAboveLeftAvail  = (!isAboveLeftAvail)  ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuAboveLeft);\par
00741     isAboveRightAvail = (!isAboveRightAvail) ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuAboveRight);\par
00742     isBelowLeftAvail  = (!isBelowLeftAvail)  ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuBelowLeft);\par
00743     isBelowRightAvail = (!isBelowRightAvail) ? {\cf17 false} : CU::isSameSubPic(*cuCurr, *cuBelowRight);\par
00744   \}\par
00745 \}\par
