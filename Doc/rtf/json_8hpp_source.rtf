19785                 {\cf20 // note erase performs range check}\par
19786                 parent.erase({\cf17 static_cast<}size_type{\cf17 >}(json_pointer::array_index(last_path)));\par
19787             \}\par
19788         \};\par
19789 \par
19790         {\cf20 // type check: top level value must be an array}\par
19791         {\cf19 if} (JSON_UNLIKELY(not json_patch.is_array()))\par
19792         \{\par
19793             JSON_THROW(parse_error::create(104, 0, {\cf22 "JSON patch must be an array of objects"}));\par
19794         \}\par
19795 \par
19796         {\cf20 // iterate and apply the operations}\par
19797         {\cf19 for} ({\cf17 const} {\cf17 auto}& val : json_patch)\par
19798         \{\par
19799             {\cf20 // wrapper to get a value for an operation}\par
19800             {\cf17 const} {\cf17 auto} get_value = [&val]({\cf17 const} std::string & op,\par
19801                                           {\cf17 const} std::string & member,\par
19802                                           {\cf18 bool} string_type) -> basic_json &\par
19803             \{\par
19804                 {\cf20 // find value}\par
19805                 {\cf17 auto} it = val.m_value.object->find(member);\par
19806 \par
19807                 {\cf20 // context-sensitive error message}\par
19808                 {\cf17 const} {\cf17 auto} error_msg = (op == {\cf22 "op"}) ? {\cf22 "operation"} : {\cf22 "operation '"} + op + {\cf22 "'"};\par
19809 \par
19810                 {\cf20 // check if desired value is present}\par
19811                 {\cf19 if} (JSON_UNLIKELY(it == val.m_value.object->end()))\par
19812                 \{\par
19813                     JSON_THROW(parse_error::create(105, 0, error_msg + {\cf22 " must have member '"} + member + {\cf22 "'"}));\par
19814                 \}\par
19815 \par
19816                 {\cf20 // check if result is of type string}\par
19817                 {\cf19 if} (JSON_UNLIKELY(string_type and not it->second.is_string()))\par
19818                 \{\par
19819                     JSON_THROW(parse_error::create(105, 0, error_msg + {\cf22 " must have string member '"} + member + {\cf22 "'"}));\par
19820                 \}\par
19821 \par
19822                 {\cf20 // no error: return value}\par
19823                 {\cf19 return} it->second;\par
19824             \};\par
19825 \par
19826             {\cf20 // type check: every element of the array must be an object}\par
19827             {\cf19 if} (JSON_UNLIKELY(not val.is_object()))\par
19828             \{\par
19829                 JSON_THROW(parse_error::create(104, 0, {\cf22 "JSON patch must be an array of objects"}));\par
19830             \}\par
19831 \par
19832             {\cf20 // collect mandatory members}\par
19833             {\cf17 const} std::string op = get_value({\cf22 "op"}, {\cf22 "op"}, {\cf17 true});\par
19834             {\cf17 const} std::string path = get_value(op, {\cf22 "path"}, {\cf17 true});\par
19835             json_pointer ptr(path);\par
19836 \par
19837             {\cf19 switch} (get_op(op))\par
19838             \{\par
19839                 {\cf19 case} patch_operations::add:\par
19840                 \{\par
19841                     operation_add(ptr, get_value({\cf22 "add"}, {\cf22 "value"}, {\cf17 false}));\par
19842                     {\cf19 break};\par
19843                 \}\par
19844 \par
19845                 {\cf19 case} patch_operations::remove:\par
19846                 \{\par
19847                     operation_remove(ptr);\par
19848                     {\cf19 break};\par
19849                 \}\par
19850 \par
19851                 {\cf19 case} patch_operations::replace:\par
19852                 \{\par
19853                     {\cf20 // the "path" location must exist - use at()}\par
19854                     result.at(ptr) = get_value({\cf22 "replace"}, {\cf22 "value"}, {\cf17 false});\par
19855                     {\cf19 break};\par
19856                 \}\par
19857 \par
19858                 {\cf19 case} patch_operations::move:\par
19859                 \{\par
19860                     {\cf17 const} std::string from_path = get_value({\cf22 "move"}, {\cf22 "from"}, {\cf17 true});\par
19861                     json_pointer from_ptr(from_path);\par
19862 \par
19863                     {\cf20 // the "from" location must exist - use at()}\par
19864                     basic_json v = result.at(from_ptr);\par
19865 \par
19866                     {\cf20 // The move operation is functionally identical to a}\par
19867                     {\cf20 // "remove" operation on the "from" location, followed}\par
19868                     {\cf20 // immediately by an "add" operation at the target}\par
19869                     {\cf20 // location with the value that was just removed.}\par
19870                     operation_remove(from_ptr);\par
19871                     operation_add(ptr, v);\par
19872                     {\cf19 break};\par
19873                 \}\par
19874 \par
19875                 {\cf19 case} patch_operations::copy:\par
19876                 \{\par
19877                     {\cf17 const} std::string from_path = get_value({\cf22 "copy"}, {\cf22 "from"}, {\cf17 true});\par
19878                     {\cf17 const} json_pointer from_ptr(from_path);\par
19879 \par
19880                     {\cf20 // the "from" location must exist - use at()}\par
19881                     basic_json v = result.at(from_ptr);\par
19882 \par
19883                     {\cf20 // The copy is functionally identical to an "add"}\par
19884                     {\cf20 // operation at the target location using the value}\par
19885                     {\cf20 // specified in the "from" member.}\par
19886                     operation_add(ptr, v);\par
19887                     {\cf19 break};\par
19888                 \}\par
19889 \par
19890                 {\cf19 case} patch_operations::test:\par
19891                 \{\par
19892                     {\cf18 bool} success = {\cf17 false};\par
19893                     JSON_TRY\par
19894                     \{\par
19895                         {\cf20 // check if "value" matches the one at "path"}\par
19896                         {\cf20 // the "path" location must exist - use at()}\par
19897                         success = (result.at(ptr) == get_value({\cf22 "test"}, {\cf22 "value"}, {\cf17 false}));\par
19898                     \}\par
19899                     JSON_INTERNAL_CATCH (out_of_range&)\par
19900                     \{\par
19901                         {\cf20 // ignore out of range errors: success remains false}\par
19902                     \}\par
19903 \par
19904                     {\cf20 // throw an exception if test fails}\par
19905                     {\cf19 if} (JSON_UNLIKELY(not success))\par
19906                     \{\par
19907                         JSON_THROW(other_error::create(501, {\cf22 "unsuccessful: "} + val.dump()));\par
19908                     \}\par
19909 \par
19910                     {\cf19 break};\par
19911                 \}\par
19912 \par
19913                 {\cf19 case} patch_operations::invalid:\par
19914                 \{\par
19915                     {\cf20 // op must be "add", "remove", "replace", "move", "copy", or}\par
19916                     {\cf20 // "test"}\par
19917                     JSON_THROW(parse_error::create(105, 0, {\cf22 "operation value '"} + op + {\cf22 "' is invalid"}));\par
19918                 \}\par
19919             \}\par
19920         \}\par
19921 \par
19922         {\cf19 return} result;\par
19923     \}\par
