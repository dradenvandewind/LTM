07907     {\cf18 bool} get_ubjson_value({\cf17 const} {\cf18 int} prefix)\par
07908     \{\par
07909         {\cf19 switch} (prefix)\par
07910         \{\par
07911             {\cf19 case} std::char_traits<char>::eof():  {\cf20 // EOF}\par
07912                 return unexpect_eof(input_format_t::ubjson, {\cf22 "value"});\par
07913 \par
07914             {\cf19 case} {\cf23 'T'}:  {\cf20 // true}\par
07915                 {\cf19 return} sax->boolean({\cf17 true});\par
07916             {\cf19 case} {\cf23 'F'}:  {\cf20 // false}\par
07917                 {\cf19 return} sax->boolean({\cf17 false});\par
07918 \par
07919             {\cf19 case} {\cf23 'Z'}:  {\cf20 // null}\par
07920                 {\cf19 return} sax->null();\par
07921 \par
07922             {\cf19 case} {\cf23 'U'}:\par
07923             \{\par
07924                 uint8_t number;\par
07925                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_unsigned(number);\par
07926             \}\par
07927 \par
07928             {\cf19 case} {\cf23 'i'}:\par
07929             \{\par
07930                 int8_t number;\par
07931                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_integer(number);\par
07932             \}\par
07933 \par
07934             {\cf19 case} {\cf23 'I'}:\par
07935             \{\par
07936                 int16_t number;\par
07937                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_integer(number);\par
07938             \}\par
07939 \par
07940             {\cf19 case} {\cf23 'l'}:\par
07941             \{\par
07942                 int32_t number;\par
07943                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_integer(number);\par
07944             \}\par
07945 \par
07946             {\cf19 case} {\cf23 'L'}:\par
07947             \{\par
07948                 int64_t number;\par
07949                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_integer(number);\par
07950             \}\par
07951 \par
07952             {\cf19 case} {\cf23 'd'}:\par
07953             \{\par
07954                 {\cf18 float} number;\par
07955                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_float({\cf17 static_cast<}number_float_t{\cf17 >}(number), {\cf22 ""});\par
07956             \}\par
07957 \par
07958             {\cf19 case} {\cf23 'D'}:\par
07959             \{\par
07960                 {\cf18 double} number;\par
07961                 {\cf19 return} get_number(input_format_t::ubjson, number) and sax->number_float({\cf17 static_cast<}number_float_t{\cf17 >}(number), {\cf22 ""});\par
07962             \}\par
07963 \par
07964             {\cf19 case} {\cf23 'C'}:  {\cf20 // char}\par
07965             \{\par
07966                 get();\par
07967                 {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(input_format_t::ubjson, {\cf22 "char"})))\par
07968                 \{\par
07969                     {\cf19 return} {\cf17 false};\par
07970                 \}\par
07971                 {\cf19 if} (JSON_UNLIKELY(current > 127))\par
07972                 \{\par
07973                     {\cf17 auto} last_token = get_token_string();\par
07974                     {\cf19 return} sax->parse_error(chars_read, last_token, parse_error::create(113, chars_read, exception_message(input_format_t::ubjson, {\cf22 "byte after 'C' must be in range 0x00..0x7F; last byte: 0x"} + last_token, {\cf22 "char"})));\par
07975                 \}\par
07976                 string_t s(1, {\cf17 static_cast<}{\cf18 char}{\cf17 >}(current));\par
07977                 {\cf19 return} sax->string(s);\par
07978             \}\par
07979 \par
07980             {\cf19 case} {\cf23 'S'}:  {\cf20 // string}\par
07981             \{\par
07982                 string_t s;\par
07983                 {\cf19 return} get_ubjson_string(s) and sax->string(s);\par
07984             \}\par
07985 \par
07986             {\cf19 case} {\cf23 '['}:  {\cf20 // array}\par
07987                 {\cf19 return} get_ubjson_array();\par
07988 \par
07989             {\cf19 case} {\cf23 '\{'}:  {\cf20 // object}\par
07990                 {\cf19 return} get_ubjson_object();\par
07991 \par
07992             {\cf19 default}: {\cf20 // anything else}\par
07993             \{\par
07994                 {\cf17 auto} last_token = get_token_string();\par
07995                 {\cf19 return} sax->parse_error(chars_read, last_token, parse_error::create(112, chars_read, exception_message(input_format_t::ubjson, {\cf22 "invalid byte: 0x"} + last_token, {\cf22 "value"})));\par
07996             \}\par
07997         \}\par
07998     \}\par
