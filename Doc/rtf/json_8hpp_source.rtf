08226     {\cf17 template}<{\cf17 typename} NumberType>\par
08227     {\cf18 bool} get_string({\cf17 const} input_format_t format,\par
08228                     {\cf17 const} NumberType len,\par
08229                     string_t& result)\par
08230     \{\par
08231         {\cf18 bool} success = {\cf17 true};\par
08232         std::generate_n(std::back_inserter(result), len, [{\cf17 this}, &success, &format]()\par
08233         \{\par
08234             get();\par
08235             {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(format, {\cf22 "string"})))\par
08236             \{\par
08237                 success = {\cf17 false};\par
08238             \}\par
08239             {\cf19 return} {\cf17 static_cast<}{\cf18 char}{\cf17 >}(current);\par
08240         \});\par
08241         {\cf19 return} success;\par
08242     \}\par
