08170     {\cf20 /*}\par
08171 {\cf20     @brief read a number from the input}\par
08172 {\cf20 }\par
08173 {\cf20     @tparam NumberType the type of the number}\par
08174 {\cf20     @param[in] format   the current format (for diagnostics)}\par
08175 {\cf20     @param[out] result  number of type @a NumberType}\par
08176 {\cf20 }\par
08177 {\cf20     @return whether conversion completed}\par
08178 {\cf20 }\par
08179 {\cf20     @note This function needs to respect the system's endianess, because}\par
08180 {\cf20           bytes in CBOR, MessagePack, and UBJSON are stored in network order}\par
08181 {\cf20           (big endian) and therefore need reordering on little endian systems.}\par
08182 {\cf20     */}\par
08183     {\cf17 template}<{\cf17 typename} NumberType, {\cf18 bool} InputIsLittleEndian = false>\par
08184     {\cf18 bool} get_number({\cf17 const} input_format_t format, NumberType& result)\par
08185     \{\par
08186         {\cf20 // step 1: read input into array with system's byte order}\par
08187         std::array<uint8_t, {\cf17 sizeof}(NumberType)> vec;\par
08188         {\cf19 for} (std::size_t i = 0; i < {\cf17 sizeof}(NumberType); ++i)\par
08189         \{\par
08190             get();\par
08191             {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(format, {\cf22 "number"})))\par
08192             \{\par
08193                 {\cf19 return} {\cf17 false};\par
08194             \}\par
08195 \par
08196             {\cf20 // reverse byte order prior to conversion if necessary}\par
08197             {\cf19 if} (is_little_endian && !InputIsLittleEndian)\par
08198             \{\par
08199                 vec[{\cf17 sizeof}(NumberType) - i - 1] = {\cf17 static_cast<}uint8_t{\cf17 >}(current);\par
08200             \}\par
08201             {\cf19 else}\par
08202             \{\par
08203                 vec[i] = {\cf17 static_cast<}uint8_t{\cf17 >}(current); {\cf20 // LCOV_EXCL_LINE}\par
08204             \}\par
08205         \}\par
08206 \par
08207         {\cf20 // step 2: convert array into number of type T and return}\par
08208         std::memcpy(&result, vec.data(), {\cf17 sizeof}(NumberType));\par
08209         {\cf19 return} {\cf17 true};\par
08210     \}\par
