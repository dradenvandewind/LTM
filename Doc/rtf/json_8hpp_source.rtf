08275     std::string exception_message({\cf17 const} input_format_t format,\par
08276                                   {\cf17 const} std::string& detail,\par
08277                                   {\cf17 const} std::string& context){\cf17  const}\par
08278 {\cf17     }\{\par
08279         std::string error_msg = {\cf22 "syntax error while parsing "};\par
08280 \par
08281         {\cf19 switch} (format)\par
08282         \{\par
08283             {\cf19 case} input_format_t::cbor:\par
08284                 error_msg += {\cf22 "CBOR"};\par
08285                 {\cf19 break};\par
08286 \par
08287             {\cf19 case} input_format_t::msgpack:\par
08288                 error_msg += {\cf22 "MessagePack"};\par
08289                 {\cf19 break};\par
08290 \par
08291             {\cf19 case} input_format_t::ubjson:\par
08292                 error_msg += {\cf22 "UBJSON"};\par
08293                 {\cf19 break};\par
08294 \par
08295             {\cf19 case} input_format_t::bson:\par
08296                 error_msg += {\cf22 "BSON"};\par
08297                 {\cf19 break};\par
08298 \par
08299             {\cf20 // LCOV_EXCL_START}\par
08300             {\cf19 default}:\par
08301                 assert({\cf17 false});\par
08302                 {\cf20 // LCOV_EXCL_STOP}\par
08303         \}\par
08304 \par
08305         {\cf19 return} error_msg + {\cf22 " "} + context + {\cf22 ": "} + detail;\par
08306     \}\par
