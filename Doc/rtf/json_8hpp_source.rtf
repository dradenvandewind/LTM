08086                     \{\par
08087                         {\cf19 return} {\cf17 false};\par
08088                     \}\par
08089                     {\cf19 if} (JSON_UNLIKELY(not get_ubjson_value(size_and_type.second)))\par
08090                     \{\par
08091                         {\cf19 return} {\cf17 false};\par
08092                     \}\par
08093                     key.clear();\par
08094                 \}\par
08095             \}\par
08096             {\cf19 else}\par
08097             \{\par
08098                 {\cf19 for} (std::size_t i = 0; i < size_and_type.first; ++i)\par
08099                 \{\par
08100                     {\cf19 if} (JSON_UNLIKELY(not get_ubjson_string(key) or not sax->key(key)))\par
08101                     \{\par
08102                         {\cf19 return} {\cf17 false};\par
08103                     \}\par
08104                     {\cf19 if} (JSON_UNLIKELY(not parse_ubjson_internal()))\par
08105                     \{\par
08106                         {\cf19 return} {\cf17 false};\par
08107                     \}\par
08108                     key.clear();\par
08109                 \}\par
08110             \}\par
08111         \}\par
08112         {\cf19 else}\par
08113         \{\par
08114             {\cf19 if} (JSON_UNLIKELY(not sax->start_object(std::size_t(-1))))\par
08115             \{\par
08116                 {\cf19 return} {\cf17 false};\par
08117             \}\par
08118 \par
08119             {\cf19 while} (current != {\cf23 '\}'})\par
08120             \{\par
