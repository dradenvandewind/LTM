05278     \{\par
05279         std::string error_msg = {\cf22 "syntax error "};\par
05280 \par
05281         {\cf19 if} (not context.empty())\par
05282         \{\par
05283             error_msg += {\cf22 "while parsing "} + context + {\cf22 " "};\par
05284         \}\par
05285 \par
05286         error_msg += {\cf22 "- "};\par
05287 \par
05288         {\cf19 if} (last_token == token_type::parse_error)\par
05289         \{\par
05290             error_msg += std::string(m_lexer.get_error_message()) + {\cf22 "; last read: '"} +\par
05291                          m_lexer.get_token_string() + {\cf22 "'"};\par
05292         \}\par
05293         {\cf19 else}\par
05294         \{\par
05295             error_msg += {\cf22 "unexpected "} + std::string(lexer_t::token_type_name(last_token));\par
05296         \}\par
05297 \par
05298         {\cf19 if} (expected != token_type::uninitialized)\par
05299         \{\par
05300             error_msg += {\cf22 "; expected "} + std::string(lexer_t::token_type_name(expected));\par
05301         \}\par
05302 \par
05303         {\cf19 return} error_msg;\par
