04906                                 m_lexer.get_token_string(),\par
04907                                 parse_error::create(101, m_lexer.get_position(),\par
04908                                                     exception_message(token_type::end_of_input, {\cf22 "value"})));\par
04909             \}\par
04910 \par
04911             {\cf20 // in case of an error, return discarded value}\par
04912             {\cf19 if} (sdp.is_errored())\par
04913             \{\par
04914                 result = value_t::discarded;\par
04915                 {\cf19 return};\par
04916             \}\par
04917 \par
04918             {\cf20 // set top-level value to null if it was discarded by the callback}\par
04919             {\cf20 // function}\par
04920             {\cf19 if} (result.is_discarded())\par
04921             \{\par
04922                 result = {\cf17 nullptr};\par
04923             \}\par
04924         \}\par
04925         {\cf19 else}\par
04926         \{\par
04927             json_sax_dom_parser<BasicJsonType> sdp(result, allow_exceptions);\par
04928             sax_parse_internal(&sdp);\par
04929             result.assert_invariant();\par
04930 \par
04931             {\cf20 // in strict mode, input must be completely read}\par
04932             {\cf19 if} (strict and (get_token() != token_type::end_of_input))\par
04933             \{\par
04934                 sdp.parse_error(m_lexer.get_position(),\par
04935                                 m_lexer.get_token_string(),\par
04936                                 parse_error::create(101, m_lexer.get_position(),\par
04937                                                     exception_message(token_type::end_of_input, {\cf22 "value"})));\par
04938             \}\par
04939 \par
04940             {\cf20 // in case of an error, return discarded value}\par
04941             {\cf19 if} (sdp.is_errored())\par
04942             \{\par
04943                 result = value_t::discarded;\par
04944                 {\cf19 return};\par
04945             \}\par
04946         \}\par
