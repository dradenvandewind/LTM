02178 {\cf17 template}<{\cf17 typename} W{\cf18 id}eStringType, {\cf18 size_t} T>\par
02179 {\cf17 struct }wide_string_input_helper\par
02180 \{\par
02181     {\cf20 // UTF-32}\par
02182     {\cf17 static} {\cf18 void} fill_buffer({\cf17 const} WideStringType& str, {\cf18 size_t}& current_wchar, std::array<std::char_traits<char>::int_type, 4>& utf8_bytes, {\cf18 size_t}& utf8_bytes_index, {\cf18 size_t}& utf8_bytes_filled)\par
02183     \{\par
02184         utf8_bytes_index = 0;\par
02185 \par
02186         {\cf19 if} (current_wchar == str.size())\par
02187         \{\par
02188             utf8_bytes[0] = std::char_traits<char>::eof();\par
02189             utf8_bytes_filled = 1;\par
02190         \}\par
02191         {\cf19 else}\par
02192         \{\par
02193             {\cf20 // get the current character}\par
02194             {\cf17 const} {\cf17 auto} wc = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(str[current_wchar++]);\par
02195 \par
02196             {\cf20 // UTF-32 to UTF-8 encoding}\par
02197             {\cf19 if} (wc < 0x80)\par
02198             \{\par
02199                 utf8_bytes[0] = wc;\par
02200                 utf8_bytes_filled = 1;\par
02201             \}\par
02202             {\cf19 else} {\cf19 if} (wc <= 0x7FF)\par
02203             \{\par
02204                 utf8_bytes[0] = 0xC0 | ((wc >> 6) & 0x1F);\par
02205                 utf8_bytes[1] = 0x80 | (wc & 0x3F);\par
02206                 utf8_bytes_filled = 2;\par
02207             \}\par
02208             {\cf19 else} {\cf19 if} (wc <= 0xFFFF)\par
02209             \{\par
02210                 utf8_bytes[0] = 0xE0 | ((wc >> 12) & 0x0F);\par
02211                 utf8_bytes[1] = 0x80 | ((wc >> 6) & 0x3F);\par
02212                 utf8_bytes[2] = 0x80 | (wc & 0x3F);\par
02213                 utf8_bytes_filled = 3;\par
02214             \}\par
02215             {\cf19 else} {\cf19 if} (wc <= 0x10FFFF)\par
02216             \{\par
02217                 utf8_bytes[0] = 0xF0 | ((wc >> 18) & 0x07);\par
02218                 utf8_bytes[1] = 0x80 | ((wc >> 12) & 0x3F);\par
02219                 utf8_bytes[2] = 0x80 | ((wc >> 6) & 0x3F);\par
02220                 utf8_bytes[3] = 0x80 | (wc & 0x3F);\par
02221                 utf8_bytes_filled = 4;\par
02222             \}\par
02223             {\cf19 else}\par
02224             \{\par
02225                 {\cf20 // unknown character}\par
02226                 utf8_bytes[0] = wc;\par
02227                 utf8_bytes_filled = 1;\par
02228             \}\par
02229         \}\par
02230     \}\par
02231 \};\par
