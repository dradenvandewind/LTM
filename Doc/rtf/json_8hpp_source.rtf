10225 {\cf17 inline} {\cf18 void} grisu2_round({\cf18 char}* buf, {\cf18 int} len, uint64_t dist, uint64_t delta,\par
10226                          uint64_t rest, uint64_t ten_k)\par
10227 \{\par
10228     assert(len >= 1);\par
10229     assert(dist <= delta);\par
10230     assert(rest <= delta);\par
10231     assert(ten_k > 0);\par
10232 \par
10233     {\cf20 //               <--------------------------- delta ---->}\par
10234     {\cf20 //                                  <---- dist --------->}\par
10235     {\cf20 // --------------[------------------+-------------------]--------------}\par
10236     {\cf20 //               M-                 w                   M+}\par
10237     {\cf20 //}\par
10238     {\cf20 //                                  ten_k}\par
10239     {\cf20 //                                <------>}\par
10240     {\cf20 //                                       <---- rest ---->}\par
10241     {\cf20 // --------------[------------------+----+--------------]--------------}\par
10242     {\cf20 //                                  w    V}\par
10243     {\cf20 //                                       = buf * 10^k}\par
10244     {\cf20 //}\par
10245     {\cf20 // ten_k represents a unit-in-the-last-place in the decimal representation}\par
10246     {\cf20 // stored in buf.}\par
10247     {\cf20 // Decrement buf by ten_k while this takes buf closer to w.}\par
10248 \par
10249     {\cf20 // The tests are written in this order to avoid overflow in unsigned}\par
10250     {\cf20 // integer arithmetic.}\par
10251 \par
10252     {\cf19 while} (rest < dist\par
10253             and delta - rest >= ten_k\par
10254             and (rest + ten_k < dist or dist - rest > rest + ten_k - dist))\par
10255     \{\par
10256         assert(buf[len - 1] != {\cf23 '0'});\par
10257         buf[len - 1]--;\par
10258         rest += ten_k;\par
10259     \}\par
10260 \}\par
