09734 {\cf17 struct }diyfp {\cf20 // f * 2^e}\par
09735 \{\par
09736     {\cf17 static} {\cf17 constexpr} {\cf18 int} kPrecision = 64; {\cf20 // = q}\par
09737 \par
09738     uint64_t f = 0;\par
09739     {\cf18 int} e = 0;\par
09740 \par
09741     {\cf17 constexpr} diyfp(uint64_t f_, {\cf18 int} e_) noexcept : f(f_), e(e_) \{\}\par
09742 \par
09747     {\cf17 static} diyfp sub({\cf17 const} diyfp& x, {\cf17 const} diyfp& y) {\cf17 noexcept}\par
09748     \{\par
09749         assert(x.e == y.e);\par
09750         assert(x.f >= y.f);\par
09751 \par
09752         {\cf19 return} \{x.f - y.f, x.e\};\par
09753     \}\par
09754 \par
09759     {\cf17 static} diyfp mul({\cf17 const} diyfp& x, {\cf17 const} diyfp& y) {\cf17 noexcept}\par
09760     \{\par
09761         {\cf17 static_assert}(kPrecision == 64, {\cf22 "internal error"});\par
09762 \par
09763         {\cf20 // Computes:}\par
09764         {\cf20 //  f = round((x.f * y.f) / 2^q)}\par
09765         {\cf20 //  e = x.e + y.e + q}\par
09766 \par
09767         {\cf20 // Emulate the 64-bit * 64-bit multiplication:}\par
09768         {\cf20 //}\par
09769         {\cf20 // p = u * v}\par
09770         {\cf20 //   = (u_lo + 2^32 u_hi) (v_lo + 2^32 v_hi)}\par
09771         {\cf20 //   = (u_lo v_lo         ) + 2^32 ((u_lo v_hi         ) + (u_hi v_lo         )) + 2^64 (u_hi v_hi         )}\par
09772         {\cf20 //   = (p0                ) + 2^32 ((p1                ) + (p2                )) + 2^64 (p3                )}\par
09773         {\cf20 //   = (p0_lo + 2^32 p0_hi) + 2^32 ((p1_lo + 2^32 p1_hi) + (p2_lo + 2^32 p2_hi)) + 2^64 (p3                )}\par
09774         {\cf20 //   = (p0_lo             ) + 2^32 (p0_hi + p1_lo + p2_lo                      ) + 2^64 (p1_hi + p2_hi + p3)}\par
09775         {\cf20 //   = (p0_lo             ) + 2^32 (Q                                          ) + 2^64 (H                 )}\par
09776         {\cf20 //   = (p0_lo             ) + 2^32 (Q_lo + 2^32 Q_hi                           ) + 2^64 (H                 )}\par
09777         {\cf20 //}\par
09778         {\cf20 // (Since Q might be larger than 2^32 - 1)}\par
09779         {\cf20 //}\par
09780         {\cf20 //   = (p0_lo + 2^32 Q_lo) + 2^64 (Q_hi + H)}\par
09781         {\cf20 //}\par
09782         {\cf20 // (Q_hi + H does not overflow a 64-bit int)}\par
09783         {\cf20 //}\par
09784         {\cf20 //   = p_lo + 2^64 p_hi}\par
09785 \par
09786         {\cf17 const} uint64_t u_lo = x.f & 0xFFFFFFFF;\par
09787         {\cf17 const} uint64_t u_hi = x.f >> 32;\par
09788         {\cf17 const} uint64_t v_lo = y.f & 0xFFFFFFFF;\par
09789         {\cf17 const} uint64_t v_hi = y.f >> 32;\par
09790 \par
09791         {\cf17 const} uint64_t p0 = u_lo * v_lo;\par
09792         {\cf17 const} uint64_t p1 = u_lo * v_hi;\par
09793         {\cf17 const} uint64_t p2 = u_hi * v_lo;\par
09794         {\cf17 const} uint64_t p3 = u_hi * v_hi;\par
09795 \par
09796         {\cf17 const} uint64_t p0_hi = p0 >> 32;\par
09797         {\cf17 const} uint64_t p1_lo = p1 & 0xFFFFFFFF;\par
09798         {\cf17 const} uint64_t p1_hi = p1 >> 32;\par
09799         {\cf17 const} uint64_t p2_lo = p2 & 0xFFFFFFFF;\par
09800         {\cf17 const} uint64_t p2_hi = p2 >> 32;\par
09801 \par
09802         uint64_t Q = p0_hi + p1_lo + p2_lo;\par
09803 \par
09804         {\cf20 // The full product might now be computed as}\par
09805         {\cf20 //}\par
09806         {\cf20 // p_hi = p3 + p2_hi + p1_hi + (Q >> 32)}\par
09807         {\cf20 // p_lo = p0_lo + (Q << 32)}\par
09808         {\cf20 //}\par
09809         {\cf20 // But in this particular case here, the full p_lo is not required.}\par
09810         {\cf20 // Effectively we only need to add the highest bit in p_lo to p_hi (and}\par
09811         {\cf20 // Q_hi + 1 does not overflow).}\par
09812 \par
09813         Q += uint64_t\{1\} << (64 - 32 - 1); {\cf20 // round, ties up}\par
09814 \par
09815         {\cf17 const} uint64_t h = p3 + p2_hi + p1_hi + (Q >> 32);\par
09816 \par
09817         {\cf19 return} \{h, x.e + y.e + 64\};\par
09818     \}\par
09819 \par
09824     {\cf17 static} diyfp normalize(diyfp x) {\cf17 noexcept}\par
09825     \{\par
09826         assert(x.f != 0);\par
09827 \par
09828         {\cf19 while} ((x.f >> 63) == 0)\par
09829         \{\par
09830             x.f <<= 1;\par
09831             x.e--;\par
09832         \}\par
09833 \par
09834         {\cf19 return} x;\par
09835     \}\par
09836 \par
09841     {\cf17 static} diyfp normalize_to({\cf17 const} diyfp& x, {\cf17 const} {\cf18 int} target_exponent) {\cf17 noexcept}\par
09842     \{\par
09843         {\cf17 const} {\cf18 int} delta = x.e - target_exponent;\par
09844 \par
09845         assert(delta >= 0);\par
09846         assert(((x.f << delta) >> delta) == x.f);\par
09847 \par
09848         {\cf19 return} \{x.f << delta, target_exponent\};\par
09849     \}\par
09850 \};\par
