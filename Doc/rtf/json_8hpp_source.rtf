20147                 \}\par
20148                 {\cf19 else}\par
20149                 \{\par
20150                     operator[](it.key()).merge_patch(it.value());\par
20151                 \}\par
20152             \}\par
20153         \}\par
20154         {\cf19 else}\par
20155         \{\par
20156             *{\cf17 this} = apply_patch;\par
20157         \}\par
20158     \}\par
