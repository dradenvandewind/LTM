03684     {\cf20 /*}\par
03685 {\cf20     @brief get next character from the input}\par
03686 {\cf20 }\par
03687 {\cf20     This function provides the interface to the used input adapter. It does}\par
03688 {\cf20     not throw in case the input reached EOF, but returns a}\par
03689 {\cf20     `std::char_traits<char>::eof()` in that case.  Stores the scanned characters}\par
03690 {\cf20     for use in error messages.}\par
03691 {\cf20 }\par
03692 {\cf20     @return character read from the input}\par
03693 {\cf20     */}\par
03694     std::char_traits<char>::int_type get()\par
03695     \{\par
03696         ++position.chars_read_total;\par
03697         ++position.chars_read_current_line;\par
03698 \par
03699         {\cf19 if} (next_unget)\par
03700         \{\par
03701             {\cf20 // just reset the next_unget variable and work with current}\par
03702             next_unget = {\cf17 false};\par
03703         \}\par
03704         {\cf19 else}\par
03705         \{\par
03706             current = ia->get_character();\par
03707         \}\par
03708 \par
03709         {\cf19 if} (JSON_LIKELY(current != std::char_traits<char>::eof()))\par
03710         \{\par
03711             token_string.push_back(std::char_traits<char>::to_char_type(current));\par
03712         \}\par
03713 \par
03714         {\cf19 if} (current == {\cf23 '\\n'})\par
03715         \{\par
03716             ++position.lines_read;\par
03717             ++position.chars_read_current_line = 0;\par
03718         \}\par
03719 \par
03720         {\cf19 return} current;\par
03721     \}\par
03722 \par
03731     {\cf18 void} unget()\par
03732     \{\par
03733         next_unget = {\cf17 true};\par
03734 \par
03735         --position.chars_read_total;\par
03736 \par
03737         {\cf20 // in case we "unget" a newline, we have to also decrement the lines_read}\par
03738         {\cf19 if} (position.chars_read_current_line == 0)\par
03739         \{\par
03740             {\cf19 if} (position.lines_read > 0)\par
03741             \{\par
03742                 --position.lines_read;\par
03743             \}\par
03744         \}\par
03745         {\cf19 else}\par
03746         \{\par
03747             --position.chars_read_current_line;\par
03748         \}\par
03749 \par
03750         {\cf19 if} (JSON_LIKELY(current != std::char_traits<char>::eof()))\par
03751         \{\par
03752             assert(token_string.size() != 0);\par
03753             token_string.pop_back();\par
03754         \}\par
03755     \}\par
