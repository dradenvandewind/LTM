19739                             {\cf19 if} (JSON_UNLIKELY({\cf17 static_cast<}size_type{\cf17 >}(idx) > parent.size()))\par
19740                             \{\par
19741                                 {\cf20 // avoid undefined behavior}\par
19742                                 JSON_THROW(out_of_range::create(401, {\cf22 "array index "} + std::to_string(idx) + {\cf22 " is out of range"}));\par
19743                             \}\par
19744 \par
19745                             {\cf20 // default case: insert add offset}\par
19746                             parent.insert(parent.begin() + {\cf17 static_cast<}difference_type{\cf17 >}(idx), val);\par
19747                         \}\par
19748                         {\cf19 break};\par
