03515 \par
03516 scan_number_exponent:\par
03517         {\cf20 // we just parsed an exponent}\par
03518         number_type = token_type::value_float;\par
03519         {\cf19 switch} (get())\par
03520         \{\par
03521             {\cf19 case} {\cf23 '+'}:\par
03522             {\cf19 case} {\cf23 '-'}:\par
03523             \{\par
03524                 add(current);\par
03525                 {\cf19 goto} scan_number_sign;\par
03526             \}\par
03527 \par
03528             {\cf19 case} {\cf23 '0'}:\par
03529             {\cf19 case} {\cf23 '1'}:\par
03530             {\cf19 case} {\cf23 '2'}:\par
03531             {\cf19 case} {\cf23 '3'}:\par
03532             {\cf19 case} {\cf23 '4'}:\par
03533             {\cf19 case} {\cf23 '5'}:\par
03534             {\cf19 case} {\cf23 '6'}:\par
03535             {\cf19 case} {\cf23 '7'}:\par
03536             {\cf19 case} {\cf23 '8'}:\par
03537             {\cf19 case} {\cf23 '9'}:\par
03538             \{\par
03539                 add(current);\par
