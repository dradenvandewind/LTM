19671             \{\par
19672                 {\cf19 return} patch_operations::add;\par
19673             \}\par
19674             {\cf19 if} (op == {\cf22 "remove"})\par
19675             \{\par
19676                 {\cf19 return} patch_operations::remove;\par
19677             \}\par
19678             {\cf19 if} (op == {\cf22 "replace"})\par
19679             \{\par
19680                 {\cf19 return} patch_operations::replace;\par
