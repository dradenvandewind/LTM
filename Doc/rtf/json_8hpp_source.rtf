09852 {\cf17 struct }boundaries\par
09853 \{\par
09854     diyfp w;\par
09855     diyfp minus;\par
09856     diyfp plus;\par
09857 \};\par
09858 \par
09865 {\cf17 template} <{\cf17 typename} FloatType>\par
09866 boundaries compute_boundaries(FloatType value)\par
09867 \{\par
09868     assert(std::isfinite(value));\par
09869     assert(value > 0);\par
09870 \par
09871     {\cf20 // Convert the IEEE representation into a diyfp.}\par
09872     {\cf20 //}\par
09873     {\cf20 // If v is denormal:}\par
09874     {\cf20 //      value = 0.F * 2^(1 - bias) = (          F) * 2^(1 - bias - (p-1))}\par
09875     {\cf20 // If v is normalized:}\par
09876     {\cf20 //      value = 1.F * 2^(E - bias) = (2^(p-1) + F) * 2^(E - bias - (p-1))}\par
09877 \par
09878     {\cf17 static_assert}(std::numeric_limits<FloatType>::is_iec559,\par
09879                   {\cf22 "internal error: dtoa_short requires an IEEE-754 floating-point implementation"});\par
09880 \par
09881     {\cf17 constexpr} {\cf18 int}      kPrecision = std::numeric_limits<FloatType>::digits; {\cf20 // = p (includes the hidden bit)}\par
09882     {\cf17 constexpr} {\cf18 int}      kBias      = std::numeric_limits<FloatType>::max_exponent - 1 + (kPrecision - 1);\par
09883     {\cf17 constexpr} {\cf18 int}      kMinExp    = 1 - kBias;\par
09884     {\cf17 constexpr} uint64_t kHiddenBit = uint64_t\{1\} << (kPrecision - 1); {\cf20 // = 2^(p-1)}\par
09885 \par
09886     {\cf17 using }bits_type = {\cf17 typename} std::conditional< kPrecision == 24, uint32_t, uint64_t >::type;\par
09887 \par
09888     {\cf17 const} uint64_t bits = reinterpret_bits<bits_type>(value);\par
09889     {\cf17 const} uint64_t E = bits >> (kPrecision - 1);\par
09890     {\cf17 const} uint64_t F = bits & (kHiddenBit - 1);\par
09891 \par
09892     {\cf17 const} {\cf18 bool} is_denormal = (E == 0);\par
09893     {\cf17 const} diyfp v = is_denormal\par
09894                     ? diyfp(F, kMinExp)\par
09895                     : diyfp(F + kHiddenBit, {\cf17 static_cast<}{\cf18 int}{\cf17 >}(E) - kBias);\par
09896 \par
09897     {\cf20 // Compute the boundaries m- and m+ of the floating-point value}\par
09898     {\cf20 // v = f * 2^e.}\par
09899     {\cf20 //}\par
09900     {\cf20 // Determine v- and v+, the floating-point predecessor and successor if v,}\par
09901     {\cf20 // respectively.}\par
09902     {\cf20 //}\par
09903     {\cf20 //      v- = v - 2^e        if f != 2^(p-1) or e == e_min                (A)}\par
09904     {\cf20 //         = v - 2^(e-1)    if f == 2^(p-1) and e > e_min                (B)}\par
09905     {\cf20 //}\par
09906     {\cf20 //      v+ = v + 2^e}\par
09907     {\cf20 //}\par
09908     {\cf20 // Let m- = (v- + v) / 2 and m+ = (v + v+) / 2. All real numbers _strictly_}\par
09909     {\cf20 // between m- and m+ round to v, regardless of how the input rounding}\par
09910     {\cf20 // algorithm breaks ties.}\par
09911     {\cf20 //}\par
09912     {\cf20 //      ---+-------------+-------------+-------------+-------------+---  (A)}\par
09913     {\cf20 //         v-            m-            v             m+            v+}\par
09914     {\cf20 //}\par
09915     {\cf20 //      -----------------+------+------+-------------+-------------+---  (B)}\par
09916     {\cf20 //                       v-     m-     v             m+            v+}\par
09917 \par
09918     {\cf17 const} {\cf18 bool} lower_boundary_is_closer = (F == 0 and E > 1);\par
09919     {\cf17 const} diyfp m_plus = diyfp(2 * v.f + 1, v.e - 1);\par
09920     {\cf17 const} diyfp m_minus = lower_boundary_is_closer\par
09921                           ? diyfp(4 * v.f - 1, v.e - 2)  {\cf20 // (B)}\par
09922                           : diyfp(2 * v.f - 1, v.e - 1); {\cf20 // (A)}\par
09923 \par
09924     {\cf20 // Determine the normalized w+ = m+.}\par
09925     {\cf17 const} diyfp w_plus = diyfp::normalize(m_plus);\par
09926 \par
09927     {\cf20 // Determine w- = m- such that e_(w-) = e_(w+).}\par
09928     {\cf17 const} diyfp w_minus = diyfp::normalize_to(m_minus, w_plus.e);\par
09929 \par
09930     {\cf19 return} \{diyfp::normalize(v), w_minus, w_plus\};\par
09931 \}\par
09932 \par
09933 {\cf20 // Given normalized diyfp w, Grisu needs to find a (normalized) cached}\par
09934 {\cf20 // power-of-ten c, such that the exponent of the product c * w = f * 2^e lies}\par
09935 {\cf20 // within a certain range [alpha, gamma] (Definition 3.2 from [1])}\par
09936 {\cf20 //}\par
09937 {\cf20 //      alpha <= e = e_c + e_w + q <= gamma}\par
09938 {\cf20 //}\par
09939 {\cf20 // or}\par
09940 {\cf20 //}\par
09941 {\cf20 //      f_c * f_w * 2^alpha <= f_c 2^(e_c) * f_w 2^(e_w) * 2^q}\par
09942 {\cf20 //                          <= f_c * f_w * 2^gamma}\par
09943 {\cf20 //}\par
09944 {\cf20 // Since c and w are normalized, i.e. 2^(q-1) <= f < 2^q, this implies}\par
09945 {\cf20 //}\par
09946 {\cf20 //      2^(q-1) * 2^(q-1) * 2^alpha <= c * w * 2^q < 2^q * 2^q * 2^gamma}\par
09947 {\cf20 //}\par
09948 {\cf20 // or}\par
09949 {\cf20 //}\par
09950 {\cf20 //      2^(q - 2 + alpha) <= c * w < 2^(q + gamma)}\par
09951 {\cf20 //}\par
09952 {\cf20 // The choice of (alpha,gamma) determines the size of the table and the form of}\par
09953 {\cf20 // the digit generation procedure. Using (alpha,gamma)=(-60,-32) works out well}\par
09954 {\cf20 // in practice:}\par
09955 {\cf20 //}\par
09956 {\cf20 // The idea is to cut the number c * w = f * 2^e into two parts, which can be}\par
09957 {\cf20 // processed independently: An integral part p1, and a fractional part p2:}\par
09958 {\cf20 //}\par
09959 {\cf20 //      f * 2^e = ( (f div 2^-e) * 2^-e + (f mod 2^-e) ) * 2^e}\par
09960 {\cf20 //              = (f div 2^-e) + (f mod 2^-e) * 2^e}\par
09961 {\cf20 //              = p1 + p2 * 2^e}\par
09962 {\cf20 //}\par
09963 {\cf20 // The conversion of p1 into decimal form requires a series of divisions and}\par
09964 {\cf20 // modulos by (a power of) 10. These operations are faster for 32-bit than for}\par
09965 {\cf20 // 64-bit integers, so p1 should ideally fit into a 32-bit integer. This can be}\par
09966 {\cf20 // achieved by choosing}\par
09967 {\cf20 //}\par
09968 {\cf20 //      -e >= 32   or   e <= -32 := gamma}\par
09969 {\cf20 //}\par
09970 {\cf20 // In order to convert the fractional part}\par
09971 {\cf20 //}\par
09972 {\cf20 //      p2 * 2^e = p2 / 2^-e = d[-1] / 10^1 + d[-2] / 10^2 + ...}\par
09973 {\cf20 //}\par
09974 {\cf20 // into decimal form, the fraction is repeatedly multiplied by 10 and the digits}\par
09975 {\cf20 // d[-i] are extracted in order:}\par
09976 {\cf20 //}\par
09977 {\cf20 //      (10 * p2) div 2^-e = d[-1]}\par
09978 {\cf20 //      (10 * p2) mod 2^-e = d[-2] / 10^1 + ...}\par
09979 {\cf20 //}\par
09980 {\cf20 // The multiplication by 10 must not overflow. It is sufficient to choose}\par
09981 {\cf20 //}\par
09982 {\cf20 //      10 * p2 < 16 * p2 = 2^4 * p2 <= 2^64.}\par
09983 {\cf20 //}\par
09984 {\cf20 // Since p2 = f mod 2^-e < 2^-e,}\par
09985 {\cf20 //}\par
09986 {\cf20 //      -e <= 60   or   e >= -60 := alpha}\par
09987 \par
09988 {\cf17 constexpr} {\cf18 int} kAlpha = -60;\par
09989 {\cf17 constexpr} {\cf18 int} kGamma = -32;\par
09990 \par
09991 {\cf17 struct }cached_power {\cf20 // c = f * 2^e ~= 10^k}\par
09992 \{\par
09993     uint64_t f;\par
09994     {\cf18 int} e;\par
09995     {\cf18 int} k;\par
09996 \};\par
09997 \par
