07821                 \{\par
07822                     {\cf19 return} {\cf17 false};\par
07823                 \}\par
07824                 result = {\cf17 static_cast<}std::size_t{\cf17 >}(number);\par
07825                 {\cf19 return} {\cf17 true};\par
07826             \}\par
07827 \par
07828             {\cf19 case} {\cf23 'l'}:\par
07829             \{\par
07830                 int32_t number;\par
07831                 {\cf19 if} (JSON_UNLIKELY(not get_number(input_format_t::ubjson, number)))\par
07832                 \{\par
