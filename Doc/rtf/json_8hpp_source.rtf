04980     {\cf17 template} <{\cf17 typename} SAX>\par
04981     {\cf18 bool} sax_parse_internal(SAX* sax)\par
04982     \{\par
04983         {\cf20 // stack to remember the hierarchy of structured values we are parsing}\par
04984         {\cf20 // true = array; false = object}\par
04985         std::vector<bool> states;\par
04986         {\cf20 // value to avoid a goto (see comment where set to true)}\par
04987         {\cf18 bool} skip_to_state_evaluation = {\cf17 false};\par
04988 \par
04989         {\cf19 while} ({\cf17 true})\par
04990         \{\par
04991             {\cf19 if} (not skip_to_state_evaluation)\par
04992             \{\par
04993                 {\cf20 // invariant: get_token() was called before each iteration}\par
04994                 {\cf19 switch} (last_token)\par
04995                 \{\par
04996                     {\cf19 case} token_type::begin_object:\par
04997                     \{\par
04998                         {\cf19 if} (JSON_UNLIKELY(not sax->start_object(std::size_t(-1))))\par
04999                         \{\par
05000                             {\cf19 return} {\cf17 false};\par
05001                         \}\par
05002 \par
05003                         {\cf20 // closing \} -> we are done}\par
05004                         {\cf19 if} (get_token() == token_type::end_object)\par
05005                         \{\par
05006                             {\cf19 if} (JSON_UNLIKELY(not sax->end_object()))\par
05007                             \{\par
05008                                 {\cf19 return} {\cf17 false};\par
05009                             \}\par
05010                             {\cf19 break};\par
05011                         \}\par
05012 \par
05013                         {\cf20 // parse key}\par
05014                         {\cf19 if} (JSON_UNLIKELY(last_token != token_type::value_string))\par
05015                         \{\par
05016                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05017                                                     m_lexer.get_token_string(),\par
05018                                                     parse_error::create(101, m_lexer.get_position(),\par
05019                                                             exception_message(token_type::value_string, {\cf22 "object key"})));\par
05020                         \}\par
05021                         {\cf19 if} (JSON_UNLIKELY(not sax->key(m_lexer.get_string())))\par
05022                         \{\par
05023                             {\cf19 return} {\cf17 false};\par
05024                         \}\par
05025 \par
05026                         {\cf20 // parse separator (:)}\par
05027                         {\cf19 if} (JSON_UNLIKELY(get_token() != token_type::name_separator))\par
05028                         \{\par
05029                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05030                                                     m_lexer.get_token_string(),\par
05031                                                     parse_error::create(101, m_lexer.get_position(),\par
05032                                                             exception_message(token_type::name_separator, {\cf22 "object separator"})));\par
05033                         \}\par
05034 \par
05035                         {\cf20 // remember we are now inside an object}\par
05036                         states.push_back({\cf17 false});\par
05037 \par
05038                         {\cf20 // parse values}\par
05039                         get_token();\par
05040                         {\cf19 continue};\par
05041                     \}\par
05042 \par
05043                     {\cf19 case} token_type::begin_array:\par
05044                     \{\par
05045                         {\cf19 if} (JSON_UNLIKELY(not sax->start_array(std::size_t(-1))))\par
05046                         \{\par
05047                             {\cf19 return} {\cf17 false};\par
05048                         \}\par
05049 \par
05050                         {\cf20 // closing ] -> we are done}\par
05051                         {\cf19 if} (get_token() == token_type::end_array)\par
05052                         \{\par
05053                             {\cf19 if} (JSON_UNLIKELY(not sax->end_array()))\par
05054                             \{\par
05055                                 {\cf19 return} {\cf17 false};\par
05056                             \}\par
05057                             {\cf19 break};\par
05058                         \}\par
05059 \par
05060                         {\cf20 // remember we are now inside an array}\par
05061                         states.push_back({\cf17 true});\par
05062 \par
05063                         {\cf20 // parse values (no need to call get_token)}\par
05064                         {\cf19 continue};\par
05065                     \}\par
05066 \par
05067                     {\cf19 case} token_type::value_float:\par
05068                     \{\par
05069                         {\cf17 const} {\cf17 auto} res = m_lexer.get_number_float();\par
05070 \par
05071                         {\cf19 if} (JSON_UNLIKELY(not std::isfinite(res)))\par
05072                         \{\par
05073                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05074                                                     m_lexer.get_token_string(),\par
05075                                                     out_of_range::create(406, {\cf22 "number overflow parsing '"} + m_lexer.get_token_string() + {\cf22 "'"}));\par
05076                         \}\par
05077                         {\cf19 else}\par
05078                         \{\par
05079                             {\cf19 if} (JSON_UNLIKELY(not sax->number_float(res, m_lexer.get_string())))\par
05080                             \{\par
05081                                 {\cf19 return} {\cf17 false};\par
05082                             \}\par
05083                             {\cf19 break};\par
05084                         \}\par
05085                     \}\par
05086 \par
05087                     {\cf19 case} token_type::literal_false:\par
05088                     \{\par
05089                         {\cf19 if} (JSON_UNLIKELY(not sax->boolean({\cf17 false})))\par
05090                         \{\par
05091                             {\cf19 return} {\cf17 false};\par
05092                         \}\par
05093                         {\cf19 break};\par
05094                     \}\par
05095 \par
05096                     {\cf19 case} token_type::literal_null:\par
05097                     \{\par
05098                         {\cf19 if} (JSON_UNLIKELY(not sax->null()))\par
05099                         \{\par
05100                             {\cf19 return} {\cf17 false};\par
05101                         \}\par
05102                         {\cf19 break};\par
05103                     \}\par
05104 \par
05105                     {\cf19 case} token_type::literal_true:\par
05106                     \{\par
05107                         {\cf19 if} (JSON_UNLIKELY(not sax->boolean({\cf17 true})))\par
05108                         \{\par
05109                             {\cf19 return} {\cf17 false};\par
05110                         \}\par
05111                         {\cf19 break};\par
05112                     \}\par
05113 \par
05114                     {\cf19 case} token_type::value_integer:\par
05115                     \{\par
05116                         {\cf19 if} (JSON_UNLIKELY(not sax->number_integer(m_lexer.get_number_integer())))\par
05117                         \{\par
05118                             {\cf19 return} {\cf17 false};\par
05119                         \}\par
05120                         {\cf19 break};\par
05121                     \}\par
05122 \par
05123                     {\cf19 case} token_type::value_string:\par
05124                     \{\par
05125                         {\cf19 if} (JSON_UNLIKELY(not sax->string(m_lexer.get_string())))\par
05126                         \{\par
05127                             {\cf19 return} {\cf17 false};\par
05128                         \}\par
05129                         {\cf19 break};\par
05130                     \}\par
05131 \par
05132                     {\cf19 case} token_type::value_unsigned:\par
05133                     \{\par
05134                         {\cf19 if} (JSON_UNLIKELY(not sax->number_unsigned(m_lexer.get_number_unsigned())))\par
05135                         \{\par
05136                             {\cf19 return} {\cf17 false};\par
05137                         \}\par
05138                         {\cf19 break};\par
05139                     \}\par
05140 \par
05141                     {\cf19 case} token_type::parse_error:\par
05142                     \{\par
05143                         {\cf20 // using "uninitialized" to avoid "expected" message}\par
05144                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05145                                                 m_lexer.get_token_string(),\par
05146                                                 parse_error::create(101, m_lexer.get_position(),\par
05147                                                         exception_message(token_type::uninitialized, {\cf22 "value"})));\par
05148                     \}\par
05149 \par
05150                     {\cf19 default}: {\cf20 // the last token was unexpected}\par
05151                     \{\par
05152                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05153                                                 m_lexer.get_token_string(),\par
05154                                                 parse_error::create(101, m_lexer.get_position(),\par
05155                                                         exception_message(token_type::literal_or_value, {\cf22 "value"})));\par
05156                     \}\par
05157                 \}\par
05158             \}\par
05159             {\cf19 else}\par
05160             \{\par
05161                 skip_to_state_evaluation = {\cf17 false};\par
05162             \}\par
05163 \par
05164             {\cf20 // we reached this line after we successfully parsed a value}\par
05165             {\cf19 if} (states.empty())\par
05166             \{\par
05167                 {\cf20 // empty stack: we reached the end of the hierarchy: done}\par
05168                 {\cf19 return} {\cf17 true};\par
05169             \}\par
05170             {\cf19 else}\par
05171             \{\par
05172                 {\cf19 if} (states.back())  {\cf20 // array}\par
05173                 \{\par
05174                     {\cf20 // comma -> next value}\par
05175                     {\cf19 if} (get_token() == token_type::value_separator)\par
05176                     \{\par
05177                         {\cf20 // parse a new value}\par
05178                         get_token();\par
05179                         {\cf19 continue};\par
05180                     \}\par
05181 \par
05182                     {\cf20 // closing ]}\par
05183                     {\cf19 if} (JSON_LIKELY(last_token == token_type::end_array))\par
05184                     \{\par
05185                         {\cf19 if} (JSON_UNLIKELY(not sax->end_array()))\par
05186                         \{\par
05187                             {\cf19 return} {\cf17 false};\par
05188                         \}\par
05189 \par
05190                         {\cf20 // We are done with this array. Before we can parse a}\par
05191                         {\cf20 // new value, we need to evaluate the new state first.}\par
05192                         {\cf20 // By setting skip_to_state_evaluation to false, we}\par
05193                         {\cf20 // are effectively jumping to the beginning of this if.}\par
05194                         assert(not states.empty());\par
05195                         states.pop_back();\par
05196                         skip_to_state_evaluation = {\cf17 true};\par
05197                         {\cf19 continue};\par
05198                     \}\par
05199                     {\cf19 else}\par
05200                     \{\par
05201                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05202                                                 m_lexer.get_token_string(),\par
05203                                                 parse_error::create(101, m_lexer.get_position(),\par
05204                                                         exception_message(token_type::end_array, {\cf22 "array"})));\par
05205                     \}\par
05206                 \}\par
05207                 {\cf19 else}  {\cf20 // object}\par
05208                 \{\par
05209                     {\cf20 // comma -> next value}\par
05210                     {\cf19 if} (get_token() == token_type::value_separator)\par
05211                     \{\par
05212                         {\cf20 // parse key}\par
05213                         {\cf19 if} (JSON_UNLIKELY(get_token() != token_type::value_string))\par
05214                         \{\par
05215                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05216                                                     m_lexer.get_token_string(),\par
05217                                                     parse_error::create(101, m_lexer.get_position(),\par
05218                                                             exception_message(token_type::value_string, {\cf22 "object key"})));\par
05219                         \}\par
05220                         {\cf19 else}\par
05221                         \{\par
05222                             {\cf19 if} (JSON_UNLIKELY(not sax->key(m_lexer.get_string())))\par
05223                             \{\par
05224                                 {\cf19 return} {\cf17 false};\par
05225                             \}\par
05226                         \}\par
05227 \par
05228                         {\cf20 // parse separator (:)}\par
05229                         {\cf19 if} (JSON_UNLIKELY(get_token() != token_type::name_separator))\par
05230                         \{\par
05231                             {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05232                                                     m_lexer.get_token_string(),\par
05233                                                     parse_error::create(101, m_lexer.get_position(),\par
05234                                                             exception_message(token_type::name_separator, {\cf22 "object separator"})));\par
05235                         \}\par
05236 \par
05237                         {\cf20 // parse values}\par
05238                         get_token();\par
05239                         {\cf19 continue};\par
05240                     \}\par
05241 \par
05242                     {\cf20 // closing \}}\par
05243                     {\cf19 if} (JSON_LIKELY(last_token == token_type::end_object))\par
05244                     \{\par
05245                         {\cf19 if} (JSON_UNLIKELY(not sax->end_object()))\par
05246                         \{\par
05247                             {\cf19 return} {\cf17 false};\par
05248                         \}\par
05249 \par
05250                         {\cf20 // We are done with this object. Before we can parse a}\par
05251                         {\cf20 // new value, we need to evaluate the new state first.}\par
05252                         {\cf20 // By setting skip_to_state_evaluation to false, we}\par
05253                         {\cf20 // are effectively jumping to the beginning of this if.}\par
05254                         assert(not states.empty());\par
05255                         states.pop_back();\par
05256                         skip_to_state_evaluation = {\cf17 true};\par
05257                         {\cf19 continue};\par
05258                     \}\par
05259                     {\cf19 else}\par
05260                     \{\par
05261                         {\cf19 return} sax->parse_error(m_lexer.get_position(),\par
05262                                                 m_lexer.get_token_string(),\par
05263                                                 parse_error::create(101, m_lexer.get_position(),\par
05264                                                         exception_message(token_type::end_object, {\cf22 "object"})));\par
05265                     \}\par
05266                 \}\par
05267             \}\par
05268         \}\par
05269     \}\par
