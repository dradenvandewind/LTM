03600 scan_number_done:\par
03601         {\cf20 // unget the character after the number (we only read it to know that}\par
03602         {\cf20 // we are done scanning a number)}\par
03603         unget();\par
03604 \par
03605         {\cf18 char}* endptr = {\cf17 nullptr};\par
03606         errno = 0;\par
03607 \par
03608         {\cf20 // try to parse integers first and fall back to floats}\par
03609         {\cf19 if} (number_type == token_type::value_unsigned)\par
03610         \{\par
03611             {\cf17 const} {\cf17 auto} x = std::strtoull(token_buffer.data(), &endptr, 10);\par
03612 \par
03613             {\cf20 // we checked the number format before}\par
03614             assert(endptr == token_buffer.data() + token_buffer.size());\par
03615 \par
03616             {\cf19 if} (errno == 0)\par
03617             \{\par
03618                 value_unsigned = {\cf17 static_cast<}number_unsigned_t{\cf17 >}(x);\par
03619                 {\cf19 if} (value_unsigned == x)\par
03620                 \{\par
03621                     {\cf19 return} token_type::value_unsigned;\par
03622                 \}\par
03623             \}\par
03624         \}\par
03625         {\cf19 else} {\cf19 if} (number_type == token_type::value_integer)\par
03626         \{\par
03627             {\cf17 const} {\cf17 auto} x = std::strtoll(token_buffer.data(), &endptr, 10);\par
03628 \par
03629             {\cf20 // we checked the number format before}\par
03630             assert(endptr == token_buffer.data() + token_buffer.size());\par
03631 \par
03632             {\cf19 if} (errno == 0)\par
03633             \{\par
03634                 value_integer = {\cf17 static_cast<}number_integer_t{\cf17 >}(x);\par
03635                 {\cf19 if} (value_integer == x)\par
03636                 \{\par
03637                     {\cf19 return} token_type::value_integer;\par
03638                 \}\par
03639             \}\par
03640         \}\par
03641 \par
03642         {\cf20 // this code is reached if we parse a floating-point number or if an}\par
03643         {\cf20 // integer conversion above failed}\par
03644         strtof(value_float, token_buffer.data(), &endptr);\par
03645 \par
03646         {\cf20 // we checked the number format before}\par
03647         assert(endptr == token_buffer.data() + token_buffer.size());\par
03648 \par
03649         {\cf19 return} token_type::value_float;\par
03650     \}\par
