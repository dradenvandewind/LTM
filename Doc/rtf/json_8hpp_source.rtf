07868     {\cf18 bool} get_ubjson_size_type(std::pair<std::size_t, int>& result)\par
07869     \{\par
07870         result.first = string_t::npos; {\cf20 // size}\par
07871         result.second = 0; {\cf20 // type}\par
07872 \par
07873         get_ignore_noop();\par
07874 \par
07875         {\cf19 if} (current == {\cf23 '$'})\par
07876         \{\par
07877             result.second = get();  {\cf20 // must not ignore 'N', because 'N' maybe the type}\par
07878             {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(input_format_t::ubjson, {\cf22 "type"})))\par
07879             \{\par
07880                 {\cf19 return} {\cf17 false};\par
07881             \}\par
07882 \par
07883             get_ignore_noop();\par
07884             {\cf19 if} (JSON_UNLIKELY(current != {\cf23 '#'}))\par
07885             \{\par
07886                 {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(input_format_t::ubjson, {\cf22 "value"})))\par
07887                 \{\par
07888                     {\cf19 return} {\cf17 false};\par
07889                 \}\par
07890                 {\cf17 auto} last_token = get_token_string();\par
07891                 {\cf19 return} sax->parse_error(chars_read, last_token, parse_error::create(112, chars_read, exception_message(input_format_t::ubjson, {\cf22 "expected '#' after type information; last byte: 0x"} + last_token, {\cf22 "size"})));\par
07892             \}\par
07893 \par
07894             {\cf19 return} get_ubjson_size_value(result.first);\par
07895         \}\par
07896         {\cf19 else} {\cf19 if} (current == {\cf23 '#'})\par
07897         \{\par
07898             {\cf19 return} get_ubjson_size_value(result.first);\par
07899         \}\par
07900         {\cf19 return} {\cf17 true};\par
07901     \}\par
