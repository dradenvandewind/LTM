09591     {\cf20 /*}\par
09592 {\cf20     @brief write a number to output input}\par
09593 {\cf20     @param[in] n number of type @a NumberType}\par
09594 {\cf20     @tparam NumberType the type of the number}\par
09595 {\cf20     @tparam OutputIsLittleEndian Set to true if output data is}\par
09596 {\cf20                                  required to be little endian}\par
09597 {\cf20 }\par
