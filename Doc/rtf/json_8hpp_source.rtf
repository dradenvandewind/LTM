03657     token_type scan_literal({\cf17 const} {\cf18 char}* literal_text, {\cf17 const} std::size_t length,\par
03658                             token_type return_type)\par
03659     \{\par
03660         assert(current == literal_text[0]);\par
03661         {\cf19 for} (std::size_t i = 1; i < length; ++i)\par
03662         \{\par
03663             {\cf19 if} (JSON_UNLIKELY(get() != literal_text[i]))\par
03664             \{\par
03665                 error_message = {\cf22 "invalid literal"};\par
03666                 {\cf19 return} token_type::parse_error;\par
03667             \}\par
03668         \}\par
03669         {\cf19 return} return_type;\par
03670     \}\par
