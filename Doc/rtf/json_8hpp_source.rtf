19698         {\cf20 // wrapper for "add" operation; add value at ptr}\par
19699         {\cf17 const} {\cf17 auto} operation_add = [&result](json_pointer & ptr, basic_json val)\par
19700         \{\par
19701             {\cf20 // adding to the root of the target document means replacing it}\par
19702             {\cf19 if} (ptr.is_root())\par
19703             \{\par
19704                 result = val;\par
19705             \}\par
19706             {\cf19 else}\par
19707             \{\par
19708                 {\cf20 // make sure the top element of the pointer exists}\par
19709                 json_pointer top_pointer = ptr.top();\par
19710                 {\cf19 if} (top_pointer != ptr)\par
19711                 \{\par
19712                     result.at(top_pointer);\par
19713                 \}\par
19714 \par
19715                 {\cf20 // get reference to parent of JSON pointer ptr}\par
19716                 {\cf17 const} {\cf17 auto} last_path = ptr.pop_back();\par
19717                 basic_json& parent = result[ptr];\par
