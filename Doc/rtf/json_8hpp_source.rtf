19750 \par
19751                     {\cf20 // LCOV_EXCL_START}\par
19752                     {\cf19 default}:\par
19753                     \{\par
19754                         {\cf20 // if there exists a parent it cannot be primitive}\par
19755                         assert({\cf17 false});\par
19756                     \}\par
19757                         {\cf20 // LCOV_EXCL_STOP}\par
19758                 \}\par
19759             \}\par
19760         \};\par
19761 \par
19762         {\cf20 // wrapper for "remove" operation; remove value at ptr}\par
19763         {\cf17 const} {\cf17 auto} operation_remove = [&result](json_pointer & ptr)\par
19764         \{\par
19765             {\cf20 // get reference to parent of JSON pointer ptr}\par
