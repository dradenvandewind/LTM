09506     CharType ubjson_prefix({\cf17 const} BasicJsonType& j) {\cf17 const} {\cf17 noexcept}\par
09507     \{\par
09508         {\cf19 switch} (j.type())\par
09509         \{\par
09510             {\cf19 case} value_t::null:\par
09511                 {\cf19 return} {\cf23 'Z'};\par
09512 \par
09513             {\cf19 case} value_t::boolean:\par
09514                 {\cf19 return} j.m_value.boolean ? {\cf23 'T'} : {\cf23 'F'};\par
09515 \par
09516             {\cf19 case} value_t::number_integer:\par
09517             \{\par
09518                 {\cf19 if} ((std::numeric_limits<int8_t>::min)() <= j.m_value.number_integer and j.m_value.number_integer <= (std::numeric_limits<int8_t>::max)())\par
09519                 \{\par
09520                     {\cf19 return} {\cf23 'i'};\par
09521                 \}\par
09522                 {\cf19 if} ((std::numeric_limits<uint8_t>::min)() <= j.m_value.number_integer and j.m_value.number_integer <= (std::numeric_limits<uint8_t>::max)())\par
09523                 \{\par
09524                     {\cf19 return} {\cf23 'U'};\par
09525                 \}\par
09526                 {\cf19 if} ((std::numeric_limits<int16_t>::min)() <= j.m_value.number_integer and j.m_value.number_integer <= (std::numeric_limits<int16_t>::max)())\par
09527                 \{\par
09528                     {\cf19 return} {\cf23 'I'};\par
09529                 \}\par
09530                 {\cf19 if} ((std::numeric_limits<int32_t>::min)() <= j.m_value.number_integer and j.m_value.number_integer <= (std::numeric_limits<int32_t>::max)())\par
09531                 \{\par
09532                     {\cf19 return} {\cf23 'l'};\par
09533                 \}\par
09534                 {\cf20 // no check and assume int64_t (see note above)}\par
09535                 {\cf19 return} {\cf23 'L'};\par
09536             \}\par
09537 \par
09538             {\cf19 case} value_t::number_unsigned:\par
09539             \{\par
09540                 {\cf19 if} (j.m_value.number_unsigned <= (std::numeric_limits<int8_t>::max)())\par
09541                 \{\par
09542                     {\cf19 return} {\cf23 'i'};\par
09543                 \}\par
09544                 {\cf19 if} (j.m_value.number_unsigned <= (std::numeric_limits<uint8_t>::max)())\par
09545                 \{\par
09546                     {\cf19 return} {\cf23 'U'};\par
09547                 \}\par
09548                 {\cf19 if} (j.m_value.number_unsigned <= (std::numeric_limits<int16_t>::max)())\par
09549                 \{\par
09550                     {\cf19 return} {\cf23 'I'};\par
09551                 \}\par
09552                 {\cf19 if} (j.m_value.number_unsigned <= (std::numeric_limits<int32_t>::max)())\par
09553                 \{\par
09554                     {\cf19 return} {\cf23 'l'};\par
09555                 \}\par
09556                 {\cf20 // no check and assume int64_t (see note above)}\par
09557                 {\cf19 return} {\cf23 'L'};\par
09558             \}\par
09559 \par
09560             {\cf19 case} value_t::number_float:\par
09561                 {\cf19 return} get_ubjson_float_prefix(j.m_value.number_float);\par
09562 \par
09563             {\cf19 case} value_t::string:\par
09564                 {\cf19 return} {\cf23 'S'};\par
09565 \par
09566             {\cf19 case} value_t::array:\par
09567                 {\cf19 return} {\cf23 '['};\par
09568 \par
09569             {\cf19 case} value_t::object:\par
09570                 {\cf19 return} {\cf23 '\{'};\par
09571 \par
09572             {\cf19 default}:  {\cf20 // discarded values}\par
09573                 {\cf19 return} {\cf23 'N'};\par
09574         \}\par
09575     \}\par
