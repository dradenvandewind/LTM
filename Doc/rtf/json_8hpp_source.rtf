10266 {\cf17 inline} {\cf18 void} grisu2_digit_gen({\cf18 char}* buffer, {\cf18 int}& length, {\cf18 int}& decimal_exponent,\par
10267                              diyfp M_minus, diyfp w, diyfp M_plus)\par
10268 \{\par
10269     {\cf17 static_assert}(kAlpha >= -60, {\cf22 "internal error"});\par
10270     {\cf17 static_assert}(kGamma <= -32, {\cf22 "internal error"});\par
10271 \par
10272     {\cf20 // Generates the digits (and the exponent) of a decimal floating-point}\par
10273     {\cf20 // number V = buffer * 10^decimal_exponent in the range [M-, M+]. The diyfp's}\par
10274     {\cf20 // w, M- and M+ share the same exponent e, which satisfies alpha <= e <= gamma.}\par
10275     {\cf20 //}\par
10276     {\cf20 //               <--------------------------- delta ---->}\par
10277     {\cf20 //                                  <---- dist --------->}\par
10278     {\cf20 // --------------[------------------+-------------------]--------------}\par
10279     {\cf20 //               M-                 w                   M+}\par
10280     {\cf20 //}\par
10281     {\cf20 // Grisu2 generates the digits of M+ from left to right and stops as soon as}\par
10282     {\cf20 // V is in [M-,M+].}\par
10283 \par
10284     assert(M_plus.e >= kAlpha);\par
10285     assert(M_plus.e <= kGamma);\par
10286 \par
10287     uint64_t delta = diyfp::sub(M_plus, M_minus).f; {\cf20 // (significand of (M+ - M-), implicit exponent is e)}\par
10288     uint64_t dist  = diyfp::sub(M_plus, w      ).f; {\cf20 // (significand of (M+ - w ), implicit exponent is e)}\par
10289 \par
10290     {\cf20 // Split M+ = f * 2^e into two parts p1 and p2 (note: e < 0):}\par
10291     {\cf20 //}\par
10292     {\cf20 //      M+ = f * 2^e}\par
10293     {\cf20 //         = ((f div 2^-e) * 2^-e + (f mod 2^-e)) * 2^e}\par
10294     {\cf20 //         = ((p1        ) * 2^-e + (p2        )) * 2^e}\par
10295     {\cf20 //         = p1 + p2 * 2^e}\par
10296 \par
10297     {\cf17 const} diyfp one(uint64_t\{1\} << -M_plus.e, M_plus.e);\par
10298 \par
10299     {\cf17 auto} p1 = {\cf17 static_cast<}uint32_t{\cf17 >}(M_plus.f >> -one.e); {\cf20 // p1 = f div 2^-e (Since -e >= 32, p1 fits into a 32-bit int.)}\par
10300     uint64_t p2 = M_plus.f & (one.f - 1);                    {\cf20 // p2 = f mod 2^-e}\par
10301 \par
10302     {\cf20 // 1)}\par
10303     {\cf20 //}\par
10304     {\cf20 // Generate the digits of the integral part p1 = d[n-1]...d[1]d[0]}\par
10305 \par
10306     assert(p1 > 0);\par
10307 \par
10308     uint32_t pow10;\par
10309     {\cf17 const} {\cf18 int} k = find_largest_pow10(p1, pow10);\par
10310 \par
10311     {\cf20 //      10^(k-1) <= p1 < 10^k, pow10 = 10^(k-1)}\par
10312     {\cf20 //}\par
10313     {\cf20 //      p1 = (p1 div 10^(k-1)) * 10^(k-1) + (p1 mod 10^(k-1))}\par
10314     {\cf20 //         = (d[k-1]         ) * 10^(k-1) + (p1 mod 10^(k-1))}\par
10315     {\cf20 //}\par
10316     {\cf20 //      M+ = p1                                             + p2 * 2^e}\par
10317     {\cf20 //         = d[k-1] * 10^(k-1) + (p1 mod 10^(k-1))          + p2 * 2^e}\par
10318     {\cf20 //         = d[k-1] * 10^(k-1) + ((p1 mod 10^(k-1)) * 2^-e + p2) * 2^e}\par
10319     {\cf20 //         = d[k-1] * 10^(k-1) + (                         rest) * 2^e}\par
10320     {\cf20 //}\par
10321     {\cf20 // Now generate the digits d[n] of p1 from left to right (n = k-1,...,0)}\par
10322     {\cf20 //}\par
10323     {\cf20 //      p1 = d[k-1]...d[n] * 10^n + d[n-1]...d[0]}\par
10324     {\cf20 //}\par
10325     {\cf20 // but stop as soon as}\par
10326     {\cf20 //}\par
10327     {\cf20 //      rest * 2^e = (d[n-1]...d[0] * 2^-e + p2) * 2^e <= delta * 2^e}\par
10328 \par
10329     {\cf18 int} n = k;\par
10330     {\cf19 while} (n > 0)\par
10331     \{\par
10332         {\cf20 // Invariants:}\par
10333         {\cf20 //      M+ = buffer * 10^n + (p1 + p2 * 2^e)    (buffer = 0 for n = k)}\par
10334         {\cf20 //      pow10 = 10^(n-1) <= p1 < 10^n}\par
10335         {\cf20 //}\par
10336         {\cf17 const} uint32_t d = p1 / pow10;  {\cf20 // d = p1 div 10^(n-1)}\par
10337         {\cf17 const} uint32_t r = p1 % pow10;  {\cf20 // r = p1 mod 10^(n-1)}\par
10338         {\cf20 //}\par
10339         {\cf20 //      M+ = buffer * 10^n + (d * 10^(n-1) + r) + p2 * 2^e}\par
10340         {\cf20 //         = (buffer * 10 + d) * 10^(n-1) + (r + p2 * 2^e)}\par
10341         {\cf20 //}\par
10342         assert(d <= 9);\par
10343         buffer[length++] = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + d); {\cf20 // buffer := buffer * 10 + d}\par
10344         {\cf20 //}\par
10345         {\cf20 //      M+ = buffer * 10^(n-1) + (r + p2 * 2^e)}\par
10346         {\cf20 //}\par
10347         p1 = r;\par
10348         n--;\par
10349         {\cf20 //}\par
10350         {\cf20 //      M+ = buffer * 10^n + (p1 + p2 * 2^e)}\par
10351         {\cf20 //      pow10 = 10^n}\par
10352         {\cf20 //}\par
10353 \par
10354         {\cf20 // Now check if enough digits have been generated.}\par
10355         {\cf20 // Compute}\par
10356         {\cf20 //}\par
10357         {\cf20 //      p1 + p2 * 2^e = (p1 * 2^-e + p2) * 2^e = rest * 2^e}\par
10358         {\cf20 //}\par
10359         {\cf20 // Note:}\par
10360         {\cf20 // Since rest and delta share the same exponent e, it suffices to}\par
10361         {\cf20 // compare the significands.}\par
10362         {\cf17 const} uint64_t rest = (uint64_t\{p1\} << -one.e) + p2;\par
10363         {\cf19 if} (rest <= delta)\par
10364         \{\par
10365             {\cf20 // V = buffer * 10^n, with M- <= V <= M+.}\par
10366 \par
10367             decimal_exponent += n;\par
10368 \par
10369             {\cf20 // We may now just stop. But instead look if the buffer could be}\par
10370             {\cf20 // decremented to bring V closer to w.}\par
10371             {\cf20 //}\par
10372             {\cf20 // pow10 = 10^n is now 1 ulp in the decimal representation V.}\par
10373             {\cf20 // The rounding procedure works with diyfp's with an implicit}\par
10374             {\cf20 // exponent of e.}\par
10375             {\cf20 //}\par
10376             {\cf20 //      10^n = (10^n * 2^-e) * 2^e = ulp * 2^e}\par
10377             {\cf20 //}\par
10378             {\cf17 const} uint64_t ten_n = uint64_t\{pow10\} << -one.e;\par
10379             grisu2_round(buffer, length, dist, delta, rest, ten_n);\par
10380 \par
10381             {\cf19 return};\par
10382         \}\par
10383 \par
10384         pow10 /= 10;\par
10385         {\cf20 //}\par
10386         {\cf20 //      pow10 = 10^(n-1) <= p1 < 10^n}\par
10387         {\cf20 // Invariants restored.}\par
10388     \}\par
10389 \par
10390     {\cf20 // 2)}\par
10391     {\cf20 //}\par
10392     {\cf20 // The digits of the integral part have been generated:}\par
10393     {\cf20 //}\par
10394     {\cf20 //      M+ = d[k-1]...d[1]d[0] + p2 * 2^e}\par
10395     {\cf20 //         = buffer            + p2 * 2^e}\par
10396     {\cf20 //}\par
10397     {\cf20 // Now generate the digits of the fractional part p2 * 2^e.}\par
10398     {\cf20 //}\par
10399     {\cf20 // Note:}\par
10400     {\cf20 // No decimal point is generated: the exponent is adjusted instead.}\par
10401     {\cf20 //}\par
10402     {\cf20 // p2 actually represents the fraction}\par
10403     {\cf20 //}\par
10404     {\cf20 //      p2 * 2^e}\par
10405     {\cf20 //          = p2 / 2^-e}\par
10406     {\cf20 //          = d[-1] / 10^1 + d[-2] / 10^2 + ...}\par
10407     {\cf20 //}\par
10408     {\cf20 // Now generate the digits d[-m] of p1 from left to right (m = 1,2,...)}\par
10409     {\cf20 //}\par
10410     {\cf20 //      p2 * 2^e = d[-1]d[-2]...d[-m] * 10^-m}\par
10411     {\cf20 //                      + 10^-m * (d[-m-1] / 10^1 + d[-m-2] / 10^2 + ...)}\par
10412     {\cf20 //}\par
10413     {\cf20 // using}\par
10414     {\cf20 //}\par
10415     {\cf20 //      10^m * p2 = ((10^m * p2) div 2^-e) * 2^-e + ((10^m * p2) mod 2^-e)}\par
10416     {\cf20 //                = (                   d) * 2^-e + (                   r)}\par
10417     {\cf20 //}\par
10418     {\cf20 // or}\par
10419     {\cf20 //      10^m * p2 * 2^e = d + r * 2^e}\par
10420     {\cf20 //}\par
10421     {\cf20 // i.e.}\par
10422     {\cf20 //}\par
10423     {\cf20 //      M+ = buffer + p2 * 2^e}\par
10424     {\cf20 //         = buffer + 10^-m * (d + r * 2^e)}\par
10425     {\cf20 //         = (buffer * 10^m + d) * 10^-m + 10^-m * r * 2^e}\par
10426     {\cf20 //}\par
10427     {\cf20 // and stop as soon as 10^-m * r * 2^e <= delta * 2^e}\par
10428 \par
10429     assert(p2 > delta);\par
10430 \par
10431     {\cf18 int} m = 0;\par
10432     {\cf19 for} (;;)\par
10433     \{\par
10434         {\cf20 // Invariant:}\par
10435         {\cf20 //      M+ = buffer * 10^-m + 10^-m * (d[-m-1] / 10 + d[-m-2] / 10^2 + ...) * 2^e}\par
10436         {\cf20 //         = buffer * 10^-m + 10^-m * (p2                                 ) * 2^e}\par
10437         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * (10 * p2)                   ) * 2^e}\par
10438         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * ((10*p2 div 2^-e) * 2^-e + (10*p2 mod 2^-e)) * 2^e}\par
10439         {\cf20 //}\par
10440         assert(p2 <= UINT64_MAX / 10);\par
10441         p2 *= 10;\par
10442         {\cf17 const} uint64_t d = p2 >> -one.e;     {\cf20 // d = (10 * p2) div 2^-e}\par
10443         {\cf17 const} uint64_t r = p2 & (one.f - 1); {\cf20 // r = (10 * p2) mod 2^-e}\par
10444         {\cf20 //}\par
10445         {\cf20 //      M+ = buffer * 10^-m + 10^-m * (1/10 * (d * 2^-e + r) * 2^e}\par
10446         {\cf20 //         = buffer * 10^-m + 10^-m * (1/10 * (d + r * 2^e))}\par
10447         {\cf20 //         = (buffer * 10 + d) * 10^(-m-1) + 10^(-m-1) * r * 2^e}\par
10448         {\cf20 //}\par
10449         assert(d <= 9);\par
10450         buffer[length++] = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + d); {\cf20 // buffer := buffer * 10 + d}\par
10451         {\cf20 //}\par
10452         {\cf20 //      M+ = buffer * 10^(-m-1) + 10^(-m-1) * r * 2^e}\par
10453         {\cf20 //}\par
10454         p2 = r;\par
10455         m++;\par
10456         {\cf20 //}\par
10457         {\cf20 //      M+ = buffer * 10^-m + 10^-m * p2 * 2^e}\par
10458         {\cf20 // Invariant restored.}\par
10459 \par
10460         {\cf20 // Check if enough digits have been generated.}\par
10461         {\cf20 //}\par
10462         {\cf20 //      10^-m * p2 * 2^e <= delta * 2^e}\par
10463         {\cf20 //              p2 * 2^e <= 10^m * delta * 2^e}\par
10464         {\cf20 //                    p2 <= 10^m * delta}\par
10465         delta *= 10;\par
10466         dist  *= 10;\par
10467         {\cf19 if} (p2 <= delta)\par
10468         \{\par
10469             {\cf19 break};\par
10470         \}\par
10471     \}\par
10472 \par
10473     {\cf20 // V = buffer * 10^-m, with M- <= V <= M+.}\par
10474 \par
10475     decimal_exponent -= m;\par
10476 \par
10477     {\cf20 // 1 ulp in the decimal representation is now 10^-m.}\par
10478     {\cf20 // Since delta and dist are now scaled by 10^m, we need to do the}\par
10479     {\cf20 // same with ulp in order to keep the units in sync.}\par
10480     {\cf20 //}\par
10481     {\cf20 //      10^m * 10^-m = 1 = 2^-e * 2^e = ten_m * 2^e}\par
10482     {\cf20 //}\par
10483     {\cf17 const} uint64_t ten_m = one.f;\par
10484     grisu2_round(buffer, length, dist, delta, p2, ten_m);\par
10485 \par
10486     {\cf20 // By construction this algorithm generates the shortest possible decimal}\par
10487     {\cf20 // number (Loitsch, Theorem 6.2) which rounds back to w.}\par
10488     {\cf20 // For an input number of precision p, at least}\par
10489     {\cf20 //}\par
10490     {\cf20 //      N = 1 + ceil(p * log_10(2))}\par
10491     {\cf20 //}\par
10492     {\cf20 // decimal digits are sufficient to identify all binary floating-point}\par
10493     {\cf20 // numbers (Matula, "In-and-Out conversions").}\par
10494     {\cf20 // This implies that the algorithm does not produce more than N decimal}\par
10495     {\cf20 // digits.}\par
10496     {\cf20 //}\par
10497     {\cf20 //      N = 17 for p = 53 (IEEE double precision)}\par
10498     {\cf20 //      N = 9  for p = 24 (IEEE single precision)}\par
10499 \}\par
