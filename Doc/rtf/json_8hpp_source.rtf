10653 {\cf17 inline} {\cf18 char}* format_buffer({\cf18 char}* buf, {\cf18 int} len, {\cf18 int} decimal_exponent,\par
10654                            {\cf18 int} min_exp, {\cf18 int} max_exp)\par
10655 \{\par
10656     assert(min_exp < 0);\par
10657     assert(max_exp > 0);\par
10658 \par
10659     {\cf17 const} {\cf18 int} k = len;\par
10660     {\cf17 const} {\cf18 int} n = len + decimal_exponent;\par
10661 \par
10662     {\cf20 // v = buf * 10^(n-k)}\par
10663     {\cf20 // k is the length of the buffer (number of decimal digits)}\par
10664     {\cf20 // n is the position of the decimal point relative to the start of the buffer.}\par
10665 \par
10666     {\cf19 if} (k <= n and n <= max_exp)\par
10667     \{\par
10668         {\cf20 // digits[000]}\par
10669         {\cf20 // len <= max_exp + 2}\par
10670 \par
10671         std::memset(buf + k, {\cf23 '0'}, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(n - k));\par
10672         {\cf20 // Make it look like a floating-point number (#362, #378)}\par
10673         buf[n + 0] = {\cf23 '.'};\par
10674         buf[n + 1] = {\cf23 '0'};\par
10675         {\cf19 return} buf + (n + 2);\par
10676     \}\par
10677 \par
10678     {\cf19 if} (0 < n and n <= max_exp)\par
10679     \{\par
10680         {\cf20 // dig.its}\par
10681         {\cf20 // len <= max_digits10 + 1}\par
10682 \par
10683         assert(k > n);\par
10684 \par
10685         std::memmove(buf + (n + 1), buf + n, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k - n));\par
10686         buf[n] = {\cf23 '.'};\par
10687         {\cf19 return} buf + (k + 1);\par
10688     \}\par
10689 \par
10690     {\cf19 if} (min_exp < n and n <= 0)\par
10691     \{\par
10692         {\cf20 // 0.[000]digits}\par
10693         {\cf20 // len <= 2 + (-min_exp - 1) + max_digits10}\par
10694 \par
10695         std::memmove(buf + (2 + -n), buf, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k));\par
10696         buf[0] = {\cf23 '0'};\par
10697         buf[1] = {\cf23 '.'};\par
10698         std::memset(buf + 2, {\cf23 '0'}, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(-n));\par
10699         {\cf19 return} buf + (2 + (-n) + k);\par
10700     \}\par
10701 \par
10702     {\cf19 if} (k == 1)\par
10703     \{\par
10704         {\cf20 // dE+123}\par
10705         {\cf20 // len <= 1 + 5}\par
10706 \par
10707         buf += 1;\par
10708     \}\par
10709     {\cf19 else}\par
10710     \{\par
10711         {\cf20 // d.igitsE+123}\par
10712         {\cf20 // len <= max_digits10 + 1 + 5}\par
10713 \par
10714         std::memmove(buf + 2, buf + 1, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(k - 1));\par
10715         buf[1] = {\cf23 '.'};\par
10716         buf += 1 + k;\par
10717     \}\par
10718 \par
10719     *buf++ = {\cf23 'e'};\par
10720     {\cf19 return} append_exponent(buf, n - 1);\par
10721 \}\par
10722 \par
10723 \} {\cf20 // namespace dtoa_impl}\par
