08003     {\cf18 bool} get_ubjson_array()\par
08004     \{\par
08005         std::pair<std::size_t, int> size_and_type;\par
08006         {\cf19 if} (JSON_UNLIKELY(not get_ubjson_size_type(size_and_type)))\par
08007         \{\par
08008             {\cf19 return} {\cf17 false};\par
08009         \}\par
08010 \par
08011         {\cf19 if} (size_and_type.first != string_t::npos)\par
08012         \{\par
08013             {\cf19 if} (JSON_UNLIKELY(not sax->start_array(size_and_type.first)))\par
08014             \{\par
08015                 {\cf19 return} {\cf17 false};\par
08016             \}\par
08017 \par
08018             {\cf19 if} (size_and_type.second != 0)\par
08019             \{\par
08020                 {\cf19 if} (size_and_type.second != {\cf23 'N'})\par
08021                 \{\par
08022                     {\cf19 for} (std::size_t i = 0; i < size_and_type.first; ++i)\par
08023                     \{\par
08024                         {\cf19 if} (JSON_UNLIKELY(not get_ubjson_value(size_and_type.second)))\par
08025                         \{\par
08026                             {\cf19 return} {\cf17 false};\par
08027                         \}\par
08028                     \}\par
08029                 \}\par
08030             \}\par
08031             {\cf19 else}\par
08032             \{\par
08033                 {\cf19 for} (std::size_t i = 0; i < size_and_type.first; ++i)\par
08034                 \{\par
08035                     {\cf19 if} (JSON_UNLIKELY(not parse_ubjson_internal()))\par
08036                     \{\par
08037                         {\cf19 return} {\cf17 false};\par
08038                     \}\par
08039                 \}\par
08040             \}\par
08041         \}\par
08042         {\cf19 else}\par
08043         \{\par
08044             {\cf19 if} (JSON_UNLIKELY(not sax->start_array(std::size_t(-1))))\par
08045             \{\par
08046                 {\cf19 return} {\cf17 false};\par
08047             \}\par
08048 \par
08049             {\cf19 while} (current != {\cf23 ']'})\par
08050             \{\par
08051                 {\cf19 if} (JSON_UNLIKELY(not parse_ubjson_internal({\cf17 false})))\par
08052                 \{\par
08053                     {\cf19 return} {\cf17 false};\par
08054                 \}\par
08055                 get_ignore_noop();\par
08056             \}\par
08057         \}\par
08058 \par
08059         {\cf19 return} sax->end_array();\par
08060     \}\par
08061 \par
08065     {\cf18 bool} get_ubjson_object()\par
08066     \{\par
08067         std::pair<std::size_t, int> size_and_type;\par
08068         {\cf19 if} (JSON_UNLIKELY(not get_ubjson_size_type(size_and_type)))\par
08069         \{\par
08070             {\cf19 return} {\cf17 false};\par
08071         \}\par
08072 \par
08073         string_t key;\par
08074         {\cf19 if} (size_and_type.first != string_t::npos)\par
08075         \{\par
