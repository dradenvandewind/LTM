08372     {\cf18 void} write_bson({\cf17 const} BasicJsonType& j)\par
08373     \{\par
08374         {\cf19 switch} (j.type())\par
08375         \{\par
08376             {\cf19 case} value_t::object:\par
08377             \{\par
08378                 write_bson_object(*j.m_value.object);\par
08379                 {\cf19 break};\par
08380             \}\par
08381 \par
08382             {\cf19 default}:\par
08383             \{\par
08384                 JSON_THROW(type_error::create(317, {\cf22 "to serialize to BSON, top-level type must be object, but is "} + std::string(j.type_name())));\par
08385             \}\par
08386         \}\par
