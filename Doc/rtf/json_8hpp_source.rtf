06405                    {\cf17 const} {\cf18 bool} strict = {\cf17 true})\par
06406     \{\par
06407         sax = sax_;\par
06408         {\cf18 bool} result = {\cf17 false};\par
06409 \par
06410         {\cf19 switch} (format)\par
06411         \{\par
06412             {\cf19 case} input_format_t::bson:\par
06413                 result = parse_bson_internal();\par
06414                 {\cf19 break};\par
06415 \par
06416             {\cf19 case} input_format_t::cbor:\par
06417                 result = parse_cbor_internal();\par
06418                 {\cf19 break};\par
06419 \par
06420             {\cf19 case} input_format_t::msgpack:\par
06421                 result = parse_msgpack_internal();\par
06422                 {\cf19 break};\par
06423 \par
06424             {\cf19 case} input_format_t::ubjson:\par
06425                 result = parse_ubjson_internal();\par
06426                 {\cf19 break};\par
06427 \par
06428             {\cf20 // LCOV_EXCL_START}\par
06429             {\cf19 default}:\par
06430                 assert({\cf17 false});\par
06431                 {\cf20 // LCOV_EXCL_STOP}\par
06432         \}\par
06433 \par
06434         {\cf20 // strict mode: next byte must be EOF}\par
06435         {\cf19 if} (result and strict)\par
06436         \{\par
06437             {\cf19 if} (format == input_format_t::ubjson)\par
06438             \{\par
06439                 get_ignore_noop();\par
06440             \}\par
06441             {\cf19 else}\par
06442             \{\par
06443                 get();\par
06444             \}\par
06445 \par
06446             {\cf19 if} (JSON_UNLIKELY(current != std::char_traits<char>::eof()))\par
06447             \{\par
06448                 {\cf19 return} sax->parse_error(chars_read, get_token_string(),\par
06449                                         parse_error::create(110, chars_read, exception_message(format, {\cf22 "expected end of input; last byte: 0x"} + get_token_string(), {\cf22 "value"})));\par
06450             \}\par
06451         \}\par
06452 \par
06453         {\cf19 return} result;\par
06454     \}\par
06455 \par
06463     {\cf17 static} {\cf17 constexpr} {\cf18 bool} little_endianess({\cf18 int} num = 1) noexcept\par
06464     \{\par
06465         {\cf19 return} (*{\cf17 reinterpret_cast<}{\cf18 char}*{\cf17 >}(&num) == 1);\par
06466     \}\par
