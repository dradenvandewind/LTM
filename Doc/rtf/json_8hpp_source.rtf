20134     {\cf18 void} merge_patch({\cf17 const} basic_json& apply_patch)\par
20135     \{\par
20136         {\cf19 if} (apply_patch.is_object())\par
20137         \{\par
20138             {\cf19 if} (not is_object())\par
20139             \{\par
20140                 *{\cf17 this} = object();\par
20141             \}\par
