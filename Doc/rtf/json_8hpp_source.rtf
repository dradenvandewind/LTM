09445                  not std::is_floating_point<NumberType>::value, {\cf18 int}>::type = 0>\par
09446     {\cf18 void} write_number_with_ubjson_prefix({\cf17 const} NumberType n,\par
09447                                          {\cf17 const} {\cf18 bool} add_prefix)\par
09448     \{\par
09449         {\cf19 if} ((std::numeric_limits<int8_t>::min)() <= n and n <= (std::numeric_limits<int8_t>::max)())\par
09450         \{\par
09451             {\cf19 if} (add_prefix)\par
09452             \{\par
09453                 oa->write_character(to_char_type({\cf23 'i'}));  {\cf20 // int8}\par
09454             \}\par
09455             write_number({\cf17 static_cast<}int8_t{\cf17 >}(n));\par
09456         \}\par
09457         {\cf19 else} {\cf19 if} ({\cf17 static_cast<}int64_t{\cf17 >}((std::numeric_limits<uint8_t>::min)()) <= n and n <= {\cf17 static_cast<}int64_t{\cf17 >}((std::numeric_limits<uint8_t>::max)()))\par
09458         \{\par
09459             {\cf19 if} (add_prefix)\par
09460             \{\par
09461                 oa->write_character(to_char_type({\cf23 'U'}));  {\cf20 // uint8}\par
09462             \}\par
09463             write_number({\cf17 static_cast<}uint8_t{\cf17 >}(n));\par
09464         \}\par
09465         {\cf19 else} {\cf19 if} ((std::numeric_limits<int16_t>::min)() <= n and n <= (std::numeric_limits<int16_t>::max)())\par
09466         \{\par
09467             {\cf19 if} (add_prefix)\par
09468             \{\par
09469                 oa->write_character(to_char_type({\cf23 'I'}));  {\cf20 // int16}\par
09470             \}\par
09471             write_number({\cf17 static_cast<}int16_t{\cf17 >}(n));\par
09472         \}\par
09473         {\cf19 else} {\cf19 if} ((std::numeric_limits<int32_t>::min)() <= n and n <= (std::numeric_limits<int32_t>::max)())\par
09474         \{\par
09475             {\cf19 if} (add_prefix)\par
09476             \{\par
09477                 oa->write_character(to_char_type({\cf23 'l'}));  {\cf20 // int32}\par
09478             \}\par
09479             write_number({\cf17 static_cast<}int32_t{\cf17 >}(n));\par
09480         \}\par
09481         {\cf19 else} {\cf19 if} ((std::numeric_limits<int64_t>::min)() <= n and n <= (std::numeric_limits<int64_t>::max)())\par
09482         \{\par
09483             {\cf19 if} (add_prefix)\par
09484             \{\par
09485                 oa->write_character(to_char_type({\cf23 'L'}));  {\cf20 // int64}\par
09486             \}\par
09487             write_number({\cf17 static_cast<}int64_t{\cf17 >}(n));\par
09488         \}\par
09489         {\cf20 // LCOV_EXCL_START}\par
09490         {\cf19 else}\par
09491         \{\par
09492             JSON_THROW(out_of_range::create(407, {\cf22 "integer number "} + std::to_string(n) + {\cf22 " cannot be represented by UBJSON as it does not fit int64"}));\par
09493         \}\par
09494         {\cf20 // LCOV_EXCL_STOP}\par
