19958     {\cf17 static} basic_json diff({\cf17 const} basic_json& source, {\cf17 const} basic_json& target,\par
19959                            {\cf17 const} std::string& path = {\cf22 ""})\par
19960     \{\par
19961         {\cf20 // the patch}\par
19962         basic_json result(value_t::array);\par
19963 \par
19964         {\cf20 // if the values are the same, return empty patch}\par
19965         {\cf19 if} (source == target)\par
19966         \{\par
19967             {\cf19 return} result;\par
19968         \}\par
19969 \par
19970         {\cf19 if} (source.type() != target.type())\par
19971         \{\par
19972             {\cf20 // different types: replace value}\par
19973             result.push_back(\par
19974             \{\par
19975                 \{{\cf22 "op"}, {\cf22 "replace"}\}, \{{\cf22 "path"}, path\}, \{{\cf22 "value"}, target\}\par
19976             \});\par
19977         \}\par
19978         {\cf19 else}\par
19979         \{\par
19980             {\cf19 switch} (source.type())\par
19981             \{\par
19982                 {\cf19 case} value_t::array:\par
19983                 \{\par
19984                     {\cf20 // first pass: traverse common elements}\par
19985                     std::size_t i = 0;\par
19986                     {\cf19 while} (i < source.size() and i < target.size())\par
19987                     \{\par
19988                         {\cf20 // recursive call to compare array values at index i}\par
19989                         {\cf17 auto} temp_diff = diff(source[i], target[i], path + {\cf22 "/"} + std::to_string(i));\par
19990                         result.insert(result.end(), temp_diff.begin(), temp_diff.end());\par
19991                         ++i;\par
19992                     \}\par
19993 \par
19994                     {\cf20 // i now reached the end of at least one array}\par
19995                     {\cf20 // in a second pass, traverse the remaining elements}\par
19996 \par
19997                     {\cf20 // remove my remaining elements}\par
19998                     {\cf17 const} {\cf17 auto} end_index = {\cf17 static_cast<}difference_type{\cf17 >}(result.size());\par
19999                     {\cf19 while} (i < source.size())\par
20000                     \{\par
20001                         {\cf20 // add operations in reverse order to avoid invalid}\par
20002                         {\cf20 // indices}\par
20003                         result.insert(result.begin() + end_index, object(\par
20004                         \{\par
20005                             \{{\cf22 "op"}, {\cf22 "remove"}\},\par
20006                             \{{\cf22 "path"}, path + {\cf22 "/"} + std::to_string(i)\}\par
20007                         \}));\par
20008                         ++i;\par
20009                     \}\par
20010 \par
20011                     {\cf20 // add other remaining elements}\par
20012                     {\cf19 while} (i < target.size())\par
20013                     \{\par
20014                         result.push_back(\par
20015                         \{\par
20016                             \{{\cf22 "op"}, {\cf22 "add"}\},\par
20017                             \{{\cf22 "path"}, path + {\cf22 "/"} + std::to_string(i)\},\par
20018                             \{{\cf22 "value"}, target[i]\}\par
20019                         \});\par
20020                         ++i;\par
20021                     \}\par
20022 \par
20023                     {\cf19 break};\par
20024                 \}\par
20025 \par
20026                 {\cf19 case} value_t::object:\par
20027                 \{\par
20028                     {\cf20 // first pass: traverse this object's elements}\par
20029                     {\cf19 for} ({\cf17 auto} it = source.cbegin(); it != source.cend(); ++it)\par
20030                     \{\par
20031                         {\cf20 // escape the key name to be used in a JSON patch}\par
20032                         {\cf17 const} {\cf17 auto} key = json_pointer::escape(it.key());\par
20033 \par
20034                         {\cf19 if} (target.find(it.key()) != target.end())\par
20035                         \{\par
20036                             {\cf20 // recursive call to compare object values at key it}\par
20037                             {\cf17 auto} temp_diff = diff(it.value(), target[it.key()], path + {\cf22 "/"} + key);\par
20038                             result.insert(result.end(), temp_diff.begin(), temp_diff.end());\par
20039                         \}\par
20040                         {\cf19 else}\par
20041                         \{\par
20042                             {\cf20 // found a key that is not in o -> remove it}\par
20043                             result.push_back({\cf18 object}(\par
20044                             \{\par
20045                                 \{{\cf22 "op"}, {\cf22 "remove"}\}, \{{\cf22 "path"}, path + {\cf22 "/"} + key\}\par
20046                             \}));\par
20047                         \}\par
20048                     \}\par
20049 \par
20050                     {\cf20 // second pass: traverse other object's elements}\par
20051                     {\cf19 for} ({\cf17 auto} it = target.cbegin(); it != target.cend(); ++it)\par
20052                     \{\par
20053                         {\cf19 if} (source.find(it.key()) == source.end())\par
20054                         \{\par
20055                             {\cf20 // found a key that is not in this -> add it}\par
20056                             {\cf17 const} {\cf17 auto} key = json_pointer::escape(it.key());\par
20057                             result.push_back(\par
20058                             \{\par
20059                                 \{{\cf22 "op"}, {\cf22 "add"}\}, \{{\cf22 "path"}, path + {\cf22 "/"} + key\},\par
20060                                 \{{\cf22 "value"}, it.value()\}\par
20061                             \});\par
20062                         \}\par
20063                     \}\par
20064 \par
20065                     {\cf19 break};\par
20066                 \}\par
20067 \par
20068                 {\cf19 default}:\par
20069                 \{\par
20070                     {\cf20 // both primitive type: replace value}\par
20071                     result.push_back(\par
20072                     \{\par
20073                         \{{\cf22 "op"}, {\cf22 "replace"}\}, \{{\cf22 "path"}, path\}, \{{\cf22 "value"}, target\}\par
20074                     \});\par
20075                     {\cf19 break};\par
20076                 \}\par
20077             \}\par
20078         \}\par
20079 \par
20080         {\cf19 return} result;\par
20081     \}\par
