10735 {\cf17 template} <{\cf17 typename} FloatType>\par
10736 {\cf18 char}* to_chars({\cf18 char}* first, {\cf17 const} {\cf18 char}* last, FloatType value)\par
10737 \{\par
10738     {\cf17 static_cast<}{\cf18 void}{\cf17 >}(last); {\cf20 // maybe unused - fix warning}\par
10739     assert(std::isfinite(value));\par
10740 \par
10741     {\cf20 // Use signbit(value) instead of (value < 0) since signbit works for -0.}\par
10742     {\cf19 if} (std::signbit(value))\par
10743     \{\par
10744         value = -value;\par
10745         *first++ = {\cf23 '-'};\par
10746     \}\par
10747 \par
10748     {\cf19 if} (value == 0) {\cf20 // +-0}\par
10749     \{\par
10750         *first++ = {\cf23 '0'};\par
10751         {\cf20 // Make it look like a floating-point number (#362, #378)}\par
10752         *first++ = {\cf23 '.'};\par
10753         *first++ = {\cf23 '0'};\par
10754         {\cf19 return} first;\par
10755     \}\par
10756 \par
10757     assert(last - first >= std::numeric_limits<FloatType>::max_digits10);\par
10758 \par
10759     {\cf20 // Compute v = buffer * 10^decimal_exponent.}\par
10760     {\cf20 // The decimal digits are stored in the buffer, which needs to be interpreted}\par
10761     {\cf20 // as an unsigned decimal integer.}\par
10762     {\cf20 // len is the length of the buffer, i.e. the number of decimal digits.}\par
10763     {\cf18 int} len = 0;\par
10764     {\cf18 int} decimal_exponent = 0;\par
10765     dtoa_impl::grisu2(first, len, decimal_exponent, value);\par
10766 \par
10767     assert(len <= std::numeric_limits<FloatType>::max_digits10);\par
10768 \par
10769     {\cf20 // Format the buffer like printf("%.*g", prec, value)}\par
10770     {\cf17 constexpr} {\cf18 int} kMinExp = -4;\par
10771     {\cf20 // Use digits10 here to increase compatibility with version 2.}\par
10772     {\cf17 constexpr} {\cf18 int} kMaxExp = std::numeric_limits<FloatType>::digits10;\par
10773 \par
10774     assert(last - first >= kMaxExp + 2);\par
10775     assert(last - first >= 2 + (-kMinExp - 1) + std::numeric_limits<FloatType>::max_digits10);\par
10776     assert(last - first >= std::numeric_limits<FloatType>::max_digits10 + 6);\par
10777 \par
10778     {\cf19 return} dtoa_impl::format_buffer(first, len, decimal_exponent, kMinExp, kMaxExp);\par
10779 \}\par
10780 \par
