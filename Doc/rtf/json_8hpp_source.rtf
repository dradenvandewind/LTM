10006 \{\par
10007     {\cf20 // Now}\par
10008     {\cf20 //}\par
10009     {\cf20 //      alpha <= e_c + e + q <= gamma                                    (1)}\par
10010     {\cf20 //      ==> f_c * 2^alpha <= c * 2^e * 2^q}\par
10011     {\cf20 //}\par
10012     {\cf20 // and since the c's are normalized, 2^(q-1) <= f_c,}\par
10013     {\cf20 //}\par
10014     {\cf20 //      ==> 2^(q - 1 + alpha) <= c * 2^(e + q)}\par
10015     {\cf20 //      ==> 2^(alpha - e - 1) <= c}\par
10016     {\cf20 //}\par
10017     {\cf20 // If c were an exakt power of ten, i.e. c = 10^k, one may determine k as}\par
10018     {\cf20 //}\par
10019     {\cf20 //      k = ceil( log_10( 2^(alpha - e - 1) ) )}\par
10020     {\cf20 //        = ceil( (alpha - e - 1) * log_10(2) )}\par
10021     {\cf20 //}\par
10022     {\cf20 // From the paper:}\par
10023     {\cf20 // "In theory the result of the procedure could be wrong since c is rounded,}\par
10024     {\cf20 //  and the computation itself is approximated [...]. In practice, however,}\par
10025     {\cf20 //  this simple function is sufficient."}\par
