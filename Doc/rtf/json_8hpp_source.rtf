01606 {\cf17 template}<{\cf17 typename} IteratorType> {\cf17 class }iteration_proxy\par
01607 \{\par
01608   {\cf17 private}:\par
01610     {\cf17 class }iteration_proxy_internal\par
01611     \{\par
01612       {\cf17 public}:\par
01613         {\cf17 using }difference_type = std::ptrdiff_t;\par
01614         {\cf17 using }value_type = iteration_proxy_internal;\par
01615         {\cf17 using }pointer = iteration_proxy_internal*;\par
01616         {\cf17 using }reference = iteration_proxy_internal&;\par
01617         {\cf17 using }iterator_category = std::input_iterator_tag;\par
01618 \par
01619       {\cf17 private}:\par
01621         IteratorType anchor;\par
01623         std::size_t array_index = 0;\par
01625         {\cf17 mutable} std::size_t array_index_last = 0;\par
01627         {\cf17 mutable} std::string array_index_str = {\cf22 "0"};\par
01629         {\cf17 const} std::string empty_str = {\cf22 ""};\par
01630 \par
01631       {\cf17 public}:\par
01632         {\cf17 explicit} iteration_proxy_internal(IteratorType it) noexcept : anchor(it) \{\}\par
01633 \par
01635         iteration_proxy_internal& operator*()\par
01636         \{\par
01637             {\cf19 return} *{\cf17 this};\par
01638         \}\par
01639 \par
01641         iteration_proxy_internal& operator++()\par
01642         \{\par
01643             ++anchor;\par
01644             ++array_index;\par
01645 \par
01646             {\cf19 return} *{\cf17 this};\par
01647         \}\par
01648 \par
01650         {\cf18 bool} operator==({\cf17 const} iteration_proxy_internal& o) {\cf17 const} {\cf17 noexcept}\par
01651         \{\par
01652             {\cf19 return} anchor == o.anchor;\par
01653         \}\par
01654 \par
01656         {\cf18 bool} operator!=({\cf17 const} iteration_proxy_internal& o) {\cf17 const} {\cf17 noexcept}\par
01657         \{\par
01658             {\cf19 return} anchor != o.anchor;\par
01659         \}\par
01660 \par
01662         {\cf17 const} std::string& key(){\cf17  const}\par
01663 {\cf17         }\{\par
01664             assert(anchor.m_object != {\cf17 nullptr});\par
01665 \par
01666             {\cf19 switch} (anchor.m_object->type())\par
01667             \{\par
01668                 {\cf20 // use integer array index as key}\par
01669                 {\cf19 case} value_t::array:\par
01670                 \{\par
01671                     {\cf19 if} (array_index != array_index_last)\par
01672                     \{\par
01673                         array_index_str = std::to_string(array_index);\par
01674                         array_index_last = array_index;\par
01675                     \}\par
01676                     {\cf19 return} array_index_str;\par
01677                 \}\par
01678 \par
01679                 {\cf20 // use key from the object}\par
01680                 {\cf19 case} value_t::object:\par
01681                     {\cf19 return} anchor.key();\par
01682 \par
01683                 {\cf20 // use an empty key for all primitive types}\par
01684                 {\cf19 default}:\par
01685                     {\cf19 return} empty_str;\par
01686             \}\par
01687         \}\par
01688 \par
01690         {\cf17 typename} IteratorType::reference value(){\cf17  const}\par
01691 {\cf17         }\{\par
01692             {\cf19 return} anchor.value();\par
01693         \}\par
01694     \};\par
01695 \par
01697     {\cf17 typename} IteratorType::reference container;\par
01698 \par
01699   {\cf17 public}:\par
01701     {\cf17 explicit} iteration_proxy({\cf17 typename} IteratorType::reference cont) noexcept\par
01702         : container(cont) \{\}\par
01703 \par
01705     iteration_proxy_internal begin() noexcept\par
01706     \{\par
01707         {\cf19 return} iteration_proxy_internal(container.begin());\par
01708     \}\par
01709 \par
01711     iteration_proxy_internal end() noexcept\par
01712     \{\par
01713         {\cf19 return} iteration_proxy_internal(container.end());\par
01714     \}\par
01715 \};\par
