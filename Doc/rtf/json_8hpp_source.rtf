06477     {\cf18 bool} parse_bson_internal()\par
06478     \{\par
06479         std::int32_t document_size;\par
06480         get_number<std::int32_t, true>(input_format_t::bson, document_size);\par
06481 \par
06482         {\cf19 if} (JSON_UNLIKELY(not sax->start_object(std::size_t(-1))))\par
06483         \{\par
06484             {\cf19 return} {\cf17 false};\par
06485         \}\par
06486 \par
06487         {\cf19 if} (JSON_UNLIKELY(not parse_bson_element_list({\cf20 /*is_array*/}{\cf17 false})))\par
06488         \{\par
06489             {\cf19 return} {\cf17 false};\par
06490         \}\par
06491 \par
06492         {\cf19 return} sax->end_object();\par
06493     \}\par
06494 \par
06502     {\cf18 bool} get_bson_cstr(string_t& result)\par
06503     \{\par
06504         {\cf17 auto} out = std::back_inserter(result);\par
06505         {\cf19 while} ({\cf17 true})\par
06506         \{\par
06507             get();\par
06508             {\cf19 if} (JSON_UNLIKELY(not unexpect_eof(input_format_t::bson, {\cf22 "cstring"})))\par
06509             \{\par
06510                 {\cf19 return} {\cf17 false};\par
06511             \}\par
06512             {\cf19 if} (current == 0x00)\par
06513             \{\par
06514                 {\cf19 return} {\cf17 true};\par
06515             \}\par
06516             *out++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}(current);\par
06517         \}\par
06518 \par
