03541             \}\par
03542 \par
03543             {\cf19 default}:\par
03544             \{\par
03545                 error_message =\par
03546                     {\cf22 "invalid number; expected '+', '-', or digit after exponent"};\par
03547                 {\cf19 return} token_type::parse_error;\par
03548             \}\par
03549         \}\par
03550 \par
03551 scan_number_sign:\par
03552         {\cf20 // we just parsed an exponent sign}\par
03553         {\cf19 switch} (get())\par
03554         \{\par
03555             {\cf19 case} {\cf23 '0'}:\par
03556             {\cf19 case} {\cf23 '1'}:\par
03557             {\cf19 case} {\cf23 '2'}:\par
03558             {\cf19 case} {\cf23 '3'}:\par
03559             {\cf19 case} {\cf23 '4'}:\par
03560             {\cf19 case} {\cf23 '5'}:\par
03561             {\cf19 case} {\cf23 '6'}:\par
03562             {\cf19 case} {\cf23 '7'}:\par
03563             {\cf19 case} {\cf23 '8'}:\par
03564             {\cf19 case} {\cf23 '9'}:\par
03565             \{\par
03566                 add(current);\par
03567                 {\cf19 goto} scan_number_any2;\par
03568             \}\par
03569 \par
03570             {\cf19 default}:\par
03571             \{\par
03572                 error_message = {\cf22 "invalid number; expected digit after exponent sign"};\par
03573                 {\cf19 return} token_type::parse_error;\par
03574             \}\par
03575         \}\par
03576 \par
03577 scan_number_any2:\par
03578         {\cf20 // we just parsed a number after the exponent or exponent sign}\par
03579         {\cf19 switch} (get())\par
03580         \{\par
03581             {\cf19 case} {\cf23 '0'}:\par
03582             {\cf19 case} {\cf23 '1'}:\par
03583             {\cf19 case} {\cf23 '2'}:\par
03584             {\cf19 case} {\cf23 '3'}:\par
03585             {\cf19 case} {\cf23 '4'}:\par
03586             {\cf19 case} {\cf23 '5'}:\par
03587             {\cf19 case} {\cf23 '6'}:\par
03588             {\cf19 case} {\cf23 '7'}:\par
03589             {\cf19 case} {\cf23 '8'}:\par
03590             {\cf19 case} {\cf23 '9'}:\par
03591             \{\par
03592                 add(current);\par
03593                 {\cf19 goto} scan_number_any2;\par
03594             \}\par
03595 \par
03596             {\cf19 default}:\par
03597                 {\cf19 goto} scan_number_done;\par
03598         \}\par
