08262     std::string get_token_string(){\cf17  const}\par
08263 {\cf17     }\{\par
08264         {\cf18 char} cr[3];\par
08265         (std::snprintf)(cr, 3, {\cf22 "%.2hhX"}, {\cf17 static_cast<}{\cf18 unsigned} {\cf18 char}{\cf17 >}(current));\par
08266         {\cf19 return} std::string\{cr\};\par
08267     \}\par
