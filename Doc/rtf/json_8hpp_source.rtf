08388 \par
08392     {\cf18 void} write_cbor({\cf17 const} BasicJsonType& j)\par
08393     \{\par
08394         {\cf19 switch} (j.type())\par
08395         \{\par
08396             {\cf19 case} value_t::null:\par
08397             \{\par
08398                 oa->write_character(to_char_type(0xF6));\par
08399                 {\cf19 break};\par
08400             \}\par
08401 \par
08402             {\cf19 case} value_t::boolean:\par
08403             \{\par
08404                 oa->write_character(j.m_value.boolean\par
08405                                     ? to_char_type(0xF5)\par
08406                                     : to_char_type(0xF4));\par
08407                 {\cf19 break};\par
08408             \}\par
08409 \par
08410             {\cf19 case} value_t::number_integer:\par
08411             \{\par
08412                 {\cf19 if} (j.m_value.number_integer >= 0)\par
08413                 \{\par
08414                     {\cf20 // CBOR does not differentiate between positive signed}\par
08415                     {\cf20 // integers and unsigned integers. Therefore, we used the}\par
08416                     {\cf20 // code from the value_t::number_unsigned case here.}\par
08417                     {\cf19 if} (j.m_value.number_integer <= 0x17)\par
