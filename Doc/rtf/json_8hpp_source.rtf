10506 {\cf17 inline} {\cf18 void} grisu2({\cf18 char}* buf, {\cf18 int}& len, {\cf18 int}& decimal_exponent,\par
10507                    diyfp m_minus, diyfp v, diyfp m_plus)\par
10508 \{\par
10509     assert(m_plus.e == m_minus.e);\par
10510     assert(m_plus.e == v.e);\par
10511 \par
10512     {\cf20 //  --------(-----------------------+-----------------------)--------    (A)}\par
10513     {\cf20 //          m-                      v                       m+}\par
10514     {\cf20 //}\par
10515     {\cf20 //  --------------------(-----------+-----------------------)--------    (B)}\par
10516     {\cf20 //                      m-          v                       m+}\par
10517     {\cf20 //}\par
10518     {\cf20 // First scale v (and m- and m+) such that the exponent is in the range}\par
10519     {\cf20 // [alpha, gamma].}\par
10520 \par
10521     {\cf17 const} cached_power cached = get_cached_power_for_binary_exponent(m_plus.e);\par
10522 \par
10523     {\cf17 const} diyfp c_minus_k(cached.f, cached.e); {\cf20 // = c ~= 10^-k}\par
10524 \par
10525     {\cf20 // The exponent of the products is = v.e + c_minus_k.e + q and is in the range [alpha,gamma]}\par
10526     {\cf17 const} diyfp w       = diyfp::mul(v,       c_minus_k);\par
10527     {\cf17 const} diyfp w_minus = diyfp::mul(m_minus, c_minus_k);\par
10528     {\cf17 const} diyfp w_plus  = diyfp::mul(m_plus,  c_minus_k);\par
10529 \par
10530     {\cf20 //  ----(---+---)---------------(---+---)---------------(---+---)----}\par
10531     {\cf20 //          w-                      w                       w+}\par
10532     {\cf20 //          = c*m-                  = c*v                   = c*m+}\par
10533     {\cf20 //}\par
10534     {\cf20 // diyfp::mul rounds its result and c_minus_k is approximated too. w, w- and}\par
10535     {\cf20 // w+ are now off by a small amount.}\par
10536     {\cf20 // In fact:}\par
10537     {\cf20 //}\par
10538     {\cf20 //      w - v * 10^k < 1 ulp}\par
10539     {\cf20 //}\par
10540     {\cf20 // To account for this inaccuracy, add resp. subtract 1 ulp.}\par
10541     {\cf20 //}\par
10542     {\cf20 //  --------+---[---------------(---+---)---------------]---+--------}\par
10543     {\cf20 //          w-  M-                  w                   M+  w+}\par
10544     {\cf20 //}\par
10545     {\cf20 // Now any number in [M-, M+] (bounds included) will round to w when input,}\par
10546     {\cf20 // regardless of how the input rounding algorithm breaks ties.}\par
10547     {\cf20 //}\par
10548     {\cf20 // And digit_gen generates the shortest possible such number in [M-, M+].}\par
10549     {\cf20 // Note that this does not mean that Grisu2 always generates the shortest}\par
10550     {\cf20 // possible number in the interval (m-, m+).}\par
10551     {\cf17 const} diyfp M_minus(w_minus.f + 1, w_minus.e);\par
10552     {\cf17 const} diyfp M_plus (w_plus.f  - 1, w_plus.e );\par
10553 \par
10554     decimal_exponent = -cached.k; {\cf20 // = -(-k) = k}\par
10555 \par
10556     grisu2_digit_gen(buf, len, decimal_exponent, M_minus, w, M_plus);\par
10557 \}\par
10558 \par
10564 {\cf17 template} <{\cf17 typename} FloatType>\par
10565 {\cf18 void} grisu2({\cf18 char}* buf, {\cf18 int}& len, {\cf18 int}& decimal_exponent, FloatType value)\par
10566 \{\par
10567     {\cf17 static_assert}(diyfp::kPrecision >= std::numeric_limits<FloatType>::digits + 3,\par
10568                   {\cf22 "internal error: not enough precision"});\par
10569 \par
10570     assert(std::isfinite(value));\par
10571     assert(value > 0);\par
10572 \par
10573     {\cf20 // If the neighbors (and boundaries) of 'value' are always computed for double-precision}\par
10574     {\cf20 // numbers, all float's can be recovered using strtod (and strtof). However, the resulting}\par
10575     {\cf20 // decimal representations are not exactly "short".}\par
10576     {\cf20 //}\par
10577     {\cf20 // The documentation for 'std::to_chars' (https://en.cppreference.com/w/cpp/utility/to_chars)}\par
10578     {\cf20 // says "value is converted to a string as if by std::sprintf in the default ("C") locale"}\par
10579     {\cf20 // and since sprintf promotes float's to double's, I think this is exactly what 'std::to_chars'}\par
10580     {\cf20 // does.}\par
10581     {\cf20 // On the other hand, the documentation for 'std::to_chars' requires that "parsing the}\par
10582     {\cf20 // representation using the corresponding std::from_chars function recovers value exactly". That}\par
10583     {\cf20 // indicates that single precision floating-point numbers should be recovered using}\par
10584     {\cf20 // 'std::strtof'.}\par
10585     {\cf20 //}\par
10586     {\cf20 // NB: If the neighbors are computed for single-precision numbers, there is a single float}\par
10587     {\cf20 //     (7.0385307e-26f) which can't be recovered using strtod. The resulting double precision}\par
10588     {\cf20 //     value is off by 1 ulp.}\par
10589 {\cf21 #if 0}\par
10590     {\cf17 const} boundaries w = compute_boundaries({\cf17 static_cast<}{\cf18 double}{\cf17 >}(value));\par
10591 {\cf21 #else}\par
10592     {\cf17 const} boundaries w = compute_boundaries(value);\par
10593 {\cf21 #endif}\par
10594 \par
10595     grisu2(buf, len, decimal_exponent, w.minus, w.w, w.plus);\par
10596 \}\par
10597 \par
10603 {\cf17 inline} {\cf18 char}* append_exponent({\cf18 char}* buf, {\cf18 int} e)\par
10604 \{\par
10605     assert(e > -1000);\par
10606     assert(e <  1000);\par
10607 \par
10608     {\cf19 if} (e < 0)\par
10609     \{\par
10610         e = -e;\par
10611         *buf++ = {\cf23 '-'};\par
10612     \}\par
10613     {\cf19 else}\par
10614     \{\par
10615         *buf++ = {\cf23 '+'};\par
10616     \}\par
10617 \par
10618     {\cf17 auto} k = {\cf17 static_cast<}uint32_t{\cf17 >}(e);\par
10619     {\cf19 if} (k < 10)\par
10620     \{\par
10621         {\cf20 // Always print at least two digits in the exponent.}\par
10622         {\cf20 // This is for compatibility with printf("%g").}\par
10623         *buf++ = {\cf23 '0'};\par
10624         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
10625     \}\par
10626     {\cf19 else} {\cf19 if} (k < 100)\par
10627     \{\par
10628         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 10);\par
10629         k %= 10;\par
10630         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
10631     \}\par
10632     {\cf19 else}\par
10633     \{\par
10634         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 100);\par
10635         k %= 100;\par
10636         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k / 10);\par
10637         k %= 10;\par
10638         *buf++ = {\cf17 static_cast<}{\cf18 char}{\cf17 >}({\cf23 '0'} + k);\par
10639     \}\par
10640 \par
10641     {\cf19 return} buf;\par
10642 \}\par
