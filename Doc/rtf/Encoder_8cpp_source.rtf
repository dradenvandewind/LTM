00984 {\cf20 // Encode one enhancement frame, given source image, downsampled source, and the decoded base image}\par
00985 {\cf20 //}\par
00986 Packet Encoder::encode(std::vector<std::unique_ptr<Image>> &src_image, {\cf17 const} Image &intermediate_src_image,\par
00987                        {\cf17 const} Image &base_prediction_image, BaseFrameType frame_type, {\cf18 bool} is_idr, {\cf18 int} gop_frame_num,\par
00988                        {\cf17 const} std::string &output_file) \{\par
00989 \par
00990     {\cf19 if} (dithering_.getInitialised() == {\cf17 false}) \{\par
00991         INFO({\cf22 "Dither init %4d bitdepth %d"}, configuration_.picture_configuration.dithering_strength,\par
00992              configuration_.global_configuration.enhancement_depth);\par
00993         dithering_.make_buffer(configuration_.picture_configuration.dithering_strength,\par
00994                                configuration_.global_configuration.enhancement_depth,\par
00995                                configuration_.picture_configuration.dithering_type == Dithering_UniformFixed ? {\cf17 true} : {\cf17 false});\par
00996         dithering_.setInitialised({\cf17 true});\par
00997     \}\par
00998 \par
00999     Surface symbols[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS];\par
01000 \par
01001     {\cf18 unsigned} frame = (unsigned)(intermediate_src_image.timestamp());\par
01002 \par
01003     {\cf20 // Figure out whether data should be sent}\par
01004     {\cf19 if} (configuration_.picture_configuration.step_width_loq[LOQ_LEVEL_1] >= MAX_STEP_WIDTH &&\par
01005         configuration_.picture_configuration.step_width_loq[LOQ_LEVEL_2] >= MAX_STEP_WIDTH) \{\par
01006         {\cf19 if} (!configuration_.global_configuration.temporal_enabled)\par
01007             configuration_.picture_configuration.enhancement_enabled = {\cf17 false};\par
01008         {\cf19 else} \{\par
01009             {\cf19 if} ((frame_type == BaseFrame_Intra || frame_type == BaseFrame_IDR) &&\par
01010                 encoder_configuration_.temporal_cq_sw_multiplier != 1000)\par
01011                 configuration_.picture_configuration.enhancement_enabled = {\cf17 true};\par
01012             {\cf19 else}\par
01013                 configuration_.picture_configuration.enhancement_enabled = {\cf17 false};\par
01014         \}\par
01015     \} {\cf19 else}\par
01016         configuration_.picture_configuration.enhancement_enabled = {\cf17 true};\par
01017 \par
01018     {\cf19 if} (frame_type == BaseFrame_Intra || frame_type == BaseFrame_IDR) \{\par
01019         configuration_.picture_configuration.coding_type = CodingType_IDR;\par
01020         update_picture_configuration_in_loop();\par
01021     \} {\cf19 else} \{\par
01022         configuration_.picture_configuration.coding_type = CodingType_NonIDR;\par
01023         update_picture_configuration_in_loop();\par
01024     \}\par
01025 \par
01026     {\cf20 // For each plane}\par
01027     {\cf20 //}\par
01028     Surface base_reco[MAX_NUM_PLANES];\par
01029     Surface full_reco[MAX_NUM_PLANES];\par
01030     Surface outp_reco[MAX_NUM_PLANES];\par
01031 \par
01032     {\cf20 // Needed to randomly generate user data (part of CE)}\par
01033     {\cf19 if} (configuration_.global_configuration.user_data_enabled) \{\par
01034         {\cf19 if} (encoder_configuration_.user_data_method == UserDataMethod_Random)\par
01035             Random().srand(({\cf18 unsigned})std::time({\cf17 nullptr}));\par
01036         {\cf19 else} {\cf19 if} (encoder_configuration_.user_data_method == UserDataMethod_FixedRandom)\par
01037             Random().srand(45721);\par
01038     \}\par
01039 \par
01040     configuration_.picture_configuration.temporal_refresh = {\cf17 false};\par
01041 \par
01042     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < src_image[0]->description().num_planes(); ++plane) \{\par
01043         {\cf17 const} {\cf18 bool} enhancement_enabled = configuration_.picture_configuration.enhancement_enabled &&\par
01044                                          plane < configuration_.global_configuration.num_processed_planes;\par
01045 \par
01047         Surface base_image;\par
01048         {\cf18 unsigned} base_bit_depth = configuration_.global_configuration.base_depth;\par
01049         {\cf19 if} (configuration_.global_configuration.enhancement_depth > configuration_.global_configuration.base_depth &&\par
01050             configuration_.global_configuration.level1_depth_flag) \{\par
01051             base_image =\par
01052                 ConvertBitShift().process(base_prediction_image.plane(plane), configuration_.global_configuration.base_depth,\par
01053                                           configuration_.global_configuration.enhancement_depth);\par
01054             base_bit_depth = configuration_.global_configuration.enhancement_depth;\par
01055         \} {\cf19 else} \{\par
01056             base_image = base_prediction_image.plane(plane);\par
01057         \}\par
01058 \par
01059         {\cf17 const} Surface src = ConvertToInternal().process(src_image[0]->plane(plane), src_image[0]->description().bit_depth());\par
01060         {\cf17 const} Surface intermediate_src =\par
01061             ConvertToInternal().process(intermediate_src_image.plane(plane), intermediate_src_image.description().bit_depth());\par
01062         {\cf17 const} Surface base_decoded = ConvertToInternal().process(base_image, base_bit_depth);\par
01063         Surface temporal_mask;\par
01064 \par
01065         {\cf20 // Work out quantization matrix for each LoQ}\par
01066         {\cf19 for} ({\cf18 unsigned} loq = 0l; loq < MAX_NUM_LOQS; ++loq) \{\par
01067             {\cf17 const} {\cf18 bool} horizontal_only = (configuration_.global_configuration.scaling_mode[loq] == ScalingMode_1D ? true : {\cf17 false});\par
01068             {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
01069                 quant_matrix_coeffs_[plane][loq][layer] =\par
01070                     find_quant_matrix_coeff(configuration_.picture_configuration, num_residual_layers(), horizontal_only, loq,\par
01071                                             layer, is_idr, quant_matrix_coeffs_[plane][loq][layer]);\par
01072             \}\par
01073         \}\par
01074 \par
01078 \par
01080         {\cf20 //}\par
01081         Surface base_prediction;\par
01082         {\cf19 switch} (configuration_.global_configuration.scaling_mode[LOQ_LEVEL_1]) \{\par
01083         {\cf19 case} ScalingMode_1D:\par
01084             base_prediction = Upsampling_1D().process(base_decoded, configuration_.global_configuration.upsample,\par
01085                                                       configuration_.global_configuration.upsampling_coefficients);\par
01086             {\cf19 if} (configuration_.global_configuration.predicted_residual_enabled) \{\par
01087                 base_prediction = PredictedResidualAdjust_1D().process(base_decoded, base_prediction,\par
01088                                                                        PredictedResidualSum_1D().process(base_prediction));\par
01089             \}\par
01090             base_decoded.dump(format({\cf22 "enc_base_deco_P%1d"}, plane));\par
01091             {\cf19 break};\par
01092         {\cf19 case} ScalingMode_2D:\par
01093             base_prediction = Upsampling().process(base_decoded, configuration_.global_configuration.upsample,\par
01094                                                    configuration_.global_configuration.upsampling_coefficients);\par
01095             {\cf19 if} (configuration_.global_configuration.predicted_residual_enabled) \{\par
01096                 base_prediction = PredictedResidualAdjust().process(base_decoded, base_prediction,\par
01097                                                                     PredictedResidualSum().process(base_prediction));\par
01098             \}\par
01099             base_decoded.dump(format({\cf22 "enc_base_deco_P%1d"}, plane));\par
01100             {\cf19 break};\par
01101         {\cf19 case} ScalingMode_None:\par
01102             base_prediction = base_decoded;\par
01103             {\cf19 break};\par
01104         {\cf19 default}:\par
01105             CHECK(0);\par
01106         \}\par
01107 \par
01108         base_prediction.dump(format({\cf22 "enc_base_pred_P%1d"}, plane));\par
01109 \par
01113 \par
01114         {\cf19 if} (enhancement_enabled) \{\par
01115             {\cf20 // Enhancement}\par
01116             Surface base_residuals = Subtract().process(intermediate_src, base_prediction);\par
01117 \par
01118             base_residuals.dump(format({\cf22 "enc_base_resi_inpu_P%1d"}, plane));\par
01119 \par
01120             {\cf20 // Apply residual map}\par
01121             {\cf19 if} (encoder_configuration_.temporal_use_priority_map_sl_1 &&\par
01122                 (encoder_configuration_.encoding_mode != EncodingMode::ENCODE_NONE) && (plane == 0)) \{\par
01123                 {\cf20 // std::cout << "==> ENCODER::Going to use priority map" << std::endl;}\par
01124 {\cf21 #if defined PRIORITY_TEST}\par
01125                 {\cf17 const} {\cf18 unsigned} priority_tile_x = 8u;\par
01126                 {\cf17 const} {\cf18 unsigned} priority_tile_y = 8u;\par
01127                 {\cf17 const} {\cf17 auto} priority_map_loq1 = PriorityMap().process(intermediate_src_image.plane(0), priority_tile_x,\par
01128                                                                      priority_tile_y, KillingFunction::THRESHOLD_CUTOFF);\par
01129 \par
01130                 Surface selected_base_residuals = ApplyPreprocessedMap().process(base_residuals, priority_map_loq1);\par
01131 \par
01132                 encode_residuals(plane, LOQ_LEVEL_1, selected_base_residuals, symbols[plane][LOQ_LEVEL_1],\par
01133                                  Temporal_SWM::SWM_Disabled, encoder_configuration_.encoding_mode, Surface(), Surface(),\par
01134                                  encoder_configuration_.priority_type_sl_1);\par
01135 \par
01136                 {\cf17 constexpr} {\cf18 bool} record_priority_map = {\cf17 false};\par
01137                 {\cf19 if} (record_priority_map) \{\par
01138                     {\cf20 // Dump priority map to file}\par
01139                     {\cf17 const} {\cf17 auto} priority_map_loq1_vis = PriorityMapVis().process(priority_map_loq1);\par
01140 \par
01141                     {\cf17 const} {\cf17 auto} surface_dump_flag = Surface::get_dump_surfaces();\par
01142                     Surface::set_dump_surfaces({\cf17 true});\par
01143                     priority_map_loq1_vis.dump(format({\cf22 "recorded_priority_map"}));\par
01144                     Surface::set_dump_surfaces(surface_dump_flag);\par
01145                 \}\par
01146 {\cf21 #endif }{\cf20 // defined PRIORITY_TEST}\par
01147 {\cf21 #if defined PRIORITY_RESI_SL1 || defined PRIORITY_COEF}\par
01148                 Surface priority_mean = PriorityMap().ComputeMeanValue(intermediate_src);\par
01149                 Surface priority_type = PriorityMap().ComputeContrastTexture(intermediate_src, priority_mean);\par
01150                 priority_type.dump(format({\cf22 "priority_map_layer1"}));\par
01151 {\cf21 #endif }{\cf20 // defined PRIORITY_RESI || defined PRIORITY_COEF}\par
01152 \par
01153 {\cf21 #if defined PRIORITY_RESI_SL1 }{\cf20 // NEED REVISITATION FOR SL-1 TO INCLUDE ADDITIONAL PM TYPE AND MODE}\par
01154                 Surface priority_residuals = PriorityMap().ApplyPriorityResiduals(\par
01155                     base_residuals, priority_type, configuration_.picture_configuration.step_width_loq[1]);\par
01156                 encode_residuals(plane, LOQ_LEVEL_1, priority_residuals, symbols[plane][LOQ_LEVEL_1], Temporal_SWM::SWM_Disabled,\par
01157                                  encoder_configuration_.encoding_mode, Surface(), Surface(),\par
01158                                  encoder_configuration_.priority_type_sl_1, {\cf17 true});\par
01159 {\cf21 #endif }{\cf20 // defined PRIORITY_RESI}\par
01160 {\cf21 #if defined PRIORITY_COEF}\par
01161                 encode_residuals(plane, LOQ_LEVEL_1, base_residuals, symbols[plane][LOQ_LEVEL_1], Temporal_SWM::SWM_Disabled,\par
01162                                  encoder_configuration_.encoding_mode, Surface(), priority_type,\par
01163                                  encoder_configuration_.priority_type_sl_1, {\cf17 true});\par
01164 {\cf21 #endif        }{\cf20 // defined PRIORITY_COEF}\par
01165             \} {\cf20 // if plane == 0}\par
01166             {\cf19 else} \{\par
01167                 encode_residuals(plane, LOQ_LEVEL_1, base_residuals, symbols[plane][LOQ_LEVEL_1], Temporal_SWM::SWM_Disabled,\par
01168                                  EncodingMode::ENCODE_ALL, Surface(), Surface(), encoder_configuration_.priority_type_sl_1, {\cf17 true});\par
01169             \}\par
01170 \par
01171             {\cf20 // Reconstruct base}\par
01172             {\cf20 //}\par
01173             Surface base_residuals_recon =\par
01174                 decode_residuals(plane, LOQ_LEVEL_1, symbols[plane][LOQ_LEVEL_1], Temporal_SWM::SWM_Disabled, Surface());\par
01175 \par
01176             base_residuals_recon.dump(format({\cf22 "enc_base_resi_reco_P%1d"}, plane));\par
01177 \par
