00313 {\cf18 void} Encoder::update_sequence_configuration({\cf17 const} Parameters &p, {\cf17 const} Parameters &d, {\cf17 const} ImageDescription &image_description) \{\par
00314     {\cf20 // Signalled}\par
00315     {\cf20 // clang-format off}\par
00316     configuration_.sequence_configuration.profile_idc = p[{\cf22 "profile_idc"}].get_enum<Profile>(Profile_Auto);\par
00317     configuration_.sequence_configuration.level_idc = p[{\cf22 "level_idc"}].get<{\cf18 unsigned}>(0);\par
00318     configuration_.sequence_configuration.sublevel_idc = p[{\cf22 "sublevel_idc"}].get<{\cf18 unsigned}>(1);\par
00319     configuration_.sequence_configuration.conformance_window = p[{\cf22 "conformance_window"}].get<{\cf18 bool}>({\cf17 false});\par
00320     configuration_.sequence_configuration.extended_profile_idc = p[{\cf22 "extended_profile_idc"}].get<{\cf18 unsigned}>(0);\par
00321     configuration_.sequence_configuration.extended_level_idc = p[{\cf22 "extended_level_idc"}].get<{\cf18 unsigned}>(0);\par
00322     configuration_.sequence_configuration.conf_win_left_offset = p[{\cf22 "conf_win_left_offset"}].get<{\cf18 unsigned}>(0);\par
00323     configuration_.sequence_configuration.conf_win_right_offset = p[{\cf22 "conf_win_right_offset"}].get<{\cf18 unsigned}>(0);\par
00324     configuration_.sequence_configuration.conf_win_top_offset = p[{\cf22 "conf_win_top_offset"}].get<{\cf18 unsigned}>(0);\par
00325     configuration_.sequence_configuration.conf_win_bottom_offset = p[{\cf22 "conf_win_bottom_offset"}].get<{\cf18 unsigned}>(0);\par
00326     {\cf20 // clang-format on}\par
00327 \par
00328     {\cf20 // Check for correct profile and level}\par
00329     {\cf19 if} (configuration_.sequence_configuration.profile_idc == Profile_Auto) \{\par
00330         {\cf19 if} (image_description.colourspace() == Colourspace_YUV422 || image_description.colourspace() == Colourspace_YUV444) \{\par
00331             configuration_.sequence_configuration.profile_idc = Profile_Main444;\par
00332             INFO({\cf22 "Using Main 4:4:4 Profile with chroma_format_idc %u."}, ({\cf18 unsigned})image_description.colourspace());\par
00333         \} {\cf19 else} \{\par
00334             configuration_.sequence_configuration.profile_idc = Profile_Main;\par
00335             INFO({\cf22 "Using Main Profile with chroma_format_idc %u."}, ({\cf18 unsigned})image_description.colourspace());\par
00336         \}\par
00337     \} {\cf19 else} {\cf19 if} (configuration_.sequence_configuration.profile_idc == Profile_Main &&\par
00338                (image_description.colourspace() == Colourspace_YUV422 || image_description.colourspace() == Colourspace_YUV444))\par
00339         ERR({\cf22 "Colourspace not supported with selected profile (see Annex A.3)"});\par
00340     {\cf17 const} {\cf18 unsigned} fps = p[{\cf22 "fps"}].get<{\cf18 unsigned}>(50);\par
00341     {\cf17 const} {\cf18 unsigned} {\cf18 long} output_sample_rate =\par
00342         configuration_.global_configuration.resolution_width * configuration_.global_configuration.resolution_height * fps;\par
00343     {\cf19 if} (configuration_.sequence_configuration.level_idc == 0) \{\par
00344         {\cf20 // Choose minimum level automatically}\par
00345         {\cf19 if} (output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_1)\par
00346             configuration_.sequence_configuration.level_idc = 1;\par
00347         {\cf19 else} {\cf19 if} (output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_2)\par
00348             configuration_.sequence_configuration.level_idc = 2;\par
00349         {\cf19 else} {\cf19 if} (output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_3)\par
00350             configuration_.sequence_configuration.level_idc = 3;\par
00351         {\cf19 else} {\cf19 if} (output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_4)\par
00352             configuration_.sequence_configuration.level_idc = 4;\par
00353         {\cf19 else}\par
00354             ERR({\cf22 "Cannot detect level automatically. Output sample rate not supported by any level. (see Annex A.4)"});\par
00355         INFO({\cf22 "Using Level %u.%u"}, configuration_.sequence_configuration.level_idc,\par
00356              configuration_.sequence_configuration.sublevel_idc);\par
00357     \} {\cf19 else} \{\par
00358         {\cf19 switch} (configuration_.sequence_configuration.level_idc) \{\par
00359         {\cf19 case} 1:\par
00360             CHECK(output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_1);\par
00361             {\cf19 break};\par
00362         {\cf19 case} 2:\par
00363             CHECK(output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_2);\par
00364             {\cf19 break};\par
00365         {\cf19 case} 3:\par
00366             CHECK(output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_3);\par
00367             {\cf19 break};\par
00368         {\cf19 case} 4:\par
00369             CHECK(output_sample_rate <= MAX_OUTPUT_RATE_LEVEL_4);\par
00370             {\cf19 break};\par
00371         {\cf19 default}:\par
00372             ERR({\cf22 "Not a supported Level (see Annex A.4)"});\par
00373         \}\par
00374     \}\par
00375 \par
00376     {\cf19 if} (configuration_.global_configuration.resolution_width != image_description.width() ||\par
00377         configuration_.global_configuration.resolution_height != image_description.height()) \{\par
00378         INFO({\cf22 "Resolution has been adjusted from %ux%u to %ux%u to conform."}, image_description.width(), image_description.height(),\par
00379              configuration_.global_configuration.resolution_width, configuration_.global_configuration.resolution_height);\par
00380         configuration_.sequence_configuration.conformance_window = {\cf17 true};\par
00381         configuration_.sequence_configuration.conf_win_right_offset =\par
00382             (configuration_.global_configuration.resolution_width - image_description.width()) / 2;\par
00383         configuration_.sequence_configuration.conf_win_bottom_offset =\par
00384             (configuration_.global_configuration.resolution_height - image_description.height()) / 2;\par
00385     \}\par
00386 \}\par
