00102 Encoder::Encoder({\cf17 const} ImageDescription &image_description, {\cf17 const} Parameters &parameters) \{\par
00103     memset(&encoder_configuration_, 0, {\cf17 sizeof}(encoder_configuration_));\par
00104     memset(&configuration_, 0, {\cf17 sizeof}(configuration_));\par
00105 \par
00106     {\cf20 // Build default parameters}\par
00107     {\cf17 auto} pb = Parameters::build();\par
00108     Parameters defaults = parameter_defaults_global(parameters);\par
00109 \par
00110     {\cf20 // Set base QP param as calculated before....}\par
00111     encoder_configuration_.base_qp = parameters[{\cf22 "qp"}].get<{\cf18 unsigned}>(defaults);\par
00112 \par
00113     update_global_configuration(parameters, defaults, image_description);\par
00114 \par
00115     {\cf20 // Build image descriptions}\par
00116     src_image_description_ = image_description;\par
00117     base_image_description_ = ImageDescription(image_description.format(), dimensions_.base_width(), dimensions_.base_height())\par
00118                                   .with_depth(configuration_.global_configuration.base_depth);\par
00119     intermediate_image_description_ = ImageDescription(\par
00120         configuration_.global_configuration.level1_depth_flag ? src_image_description_.format() : base_image_description_.format(),\par
00121         dimensions_.intermediate_width(), dimensions_.intermediate_height());\par
00122 \par
00123     enhancement_image_description_ =\par
00124         ImageDescription(image_description.format(), dimensions_.conformant_width(), dimensions_.conformant_height());\par
00125 \}\par
00126 \par
00127 {\cf18 void} Encoder::initialise_config({\cf17 const} Parameters &parameters, std::vector<std::unique_ptr<Image>> &src_image) \{\par
00128     {\cf20 // Build default parameters}\par
00129     {\cf17 auto} pb = Parameters::build();\par
00130     Parameters defaults = parameter_defaults_picture(parameters, src_image, encoder_configuration_.base_qp);\par
00131 \par
00132     {\cf20 // Update Transform Type}\par
00133     {\cf19 if} (!defaults[{\cf22 "encoding_transform_type"}].empty()) \{\par
00134         {\cf19 if} (defaults[{\cf22 "encoding_transform_type"}].get<std::string>() == {\cf22 "dd"}) \{\par
00135             configuration_.global_configuration.transform_block_size = 2;\par
00136             configuration_.global_configuration.num_residual_layers = 4;\par
00137 \par
00138             {\cf20 // Update image descriptions (conformance window might change with new transform)}\par
00139             dimensions_.set(configuration_, src_image_description_.width(), src_image_description_.height());\par
00140             configuration_.global_configuration.resolution_width = dimensions_.conformant_width();\par
00141             configuration_.global_configuration.resolution_height = dimensions_.conformant_height();\par
00142             base_image_description_ = base_image_description_.with_size(dimensions_.base_width(), dimensions_.base_height());\par
00143             intermediate_image_description_ =\par
00144                 intermediate_image_description_.with_size(dimensions_.intermediate_width(), dimensions_.intermediate_height());\par
00145             enhancement_image_description_ =\par
00146                 enhancement_image_description_.with_size(dimensions_.conformant_width(), dimensions_.conformant_height());\par
00147 \par
00148         \} {\cf19 else} {\cf19 if} (defaults[{\cf22 "encoding_transform_type"}].get<std::string>() == {\cf22 "dds"}) \{\par
00149             configuration_.global_configuration.transform_block_size = 4;\par
