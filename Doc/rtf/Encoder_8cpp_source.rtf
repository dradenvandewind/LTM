00951 {\cf17 static} {\cf18 unsigned} syntax_blocks_mask(BaseFrameType frame_type, {\cf18 bool} encoded_data_present, {\cf18 bool} tiled, {\cf18 bool} additional_info_present) \{\par
00952     SyntaxBlocks data\{\};\par
00953 \par
00954     {\cf19 if} (encoded_data_present)\par
00955         data = tiled ? SyntaxBlock_EncodedData : SyntaxBlock_EncodedData_Tiled;\par
00956 \par
00957     {\cf19 switch} (frame_type) \{\par
00958     {\cf19 case} BaseFrame_IDR:\par
00959     {\cf19 case} BaseFrame_Intra:\par
00960         {\cf19 if} (additional_info_present)\par
00961             {\cf19 return} SyntaxBlock_Global | SyntaxBlock_Picture | SyntaxBlock_Sequence | SyntaxBlock_Additional_Info | data;\par
00962         {\cf19 else}\par
00963             {\cf19 return} SyntaxBlock_Global | SyntaxBlock_Picture | SyntaxBlock_Sequence | data;\par
00964 \par
00965     {\cf19 case} BaseFrame_Inter:\par
00966     {\cf19 case} BaseFrame_Pred:\par
00967     {\cf19 case} BaseFrame_Bidi:\par
00968         {\cf19 return} SyntaxBlock_Picture | data;\par
00969     \}\par
00970 \par
00971     {\cf19 return} 0;\par
00972 \}\par
