00783             PriorityMap().ApplyPriorityCoefficients(\par
00784                 coefficients[0].width(), coefficients[0].height(), configuration_.global_configuration.transform_block_size, loq,\par
00785                 coefficients, priority_debug, priority_type, pixel_sad, configuration_.picture_configuration.step_width_loq[loq],\par
00786                 priority_mb_type, mode);\par
00787         \} {\cf19 else} \{\par
00788             {\cf19 for} ({\cf18 unsigned} i = 0; i < configuration_.global_configuration.num_residual_layers; i++) \{\par
00789                 {\cf17 const} {\cf17 auto} coef = coefficients[i].view_as<int16_t>();\par
00790                 priority_debug[i] = Surface::build_from<int16_t>()\par
00791                                         .generate(coefficients[i].width(), coefficients[i].height(),\par
00792                                                   [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{ {\cf19 return} coef.read(x, y); \})\par
00793                                         .finish();\par
00794             \}\par
00795         \}\par
00796 \par
00797         Surface syms_anchor[MAX_NUM_LAYERS], syms_no_sad[MAX_NUM_LAYERS];\par
00798 \par
00799         {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00800             Surface syms_a, syms_b;\par
00801             {\cf19 if} (passes == 1) \{\par
00802                 syms_a = Quantize().process(priority_coefficients[layer], dirq_step_width[layer][0], dirq_deadzone[layer][0],\par
00803                                             pixel_sad, transform_block_size(), 5u);\par
00804                 syms_b = Quantize().process(priority_debug[layer], dirq_step_width[layer][0], dirq_deadzone[layer][0], pixel_sad,\par
00805                                             transform_block_size(), 5u);\par
00806             \} {\cf19 else} \{\par
00807                 syms_a = Quantize_SWM().process(priority_coefficients[layer], transform_block_size(), dirq_step_width[layer],\par
00808                                                 dirq_deadzone[layer], temporal_mask, pixel_sad, 5u);\par
00809                 syms_b = Quantize_SWM().process(priority_debug[layer], transform_block_size(), dirq_step_width[layer],\par
00810                                                 dirq_deadzone[layer], temporal_mask, pixel_sad, 5u);\par
00811             \}\par
00812             syms_anchor[layer] = syms_a;\par
00813             syms_no_sad[layer] = syms_b;\par
00814         \}\par
00815 \par
00816         {\cf17 const} Surface static_residuals_debug =\par
00817             Surface::build_from<int16_t>()\par
00818                 .generate(residuals.width(), residuals.height(),\par
00819                           [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{\par
00820                               const unsigned layer =\par
00821                                   (x % transform_block_size() + transform_block_size() * (y % transform_block_size()));\par
00822                               const auto syms_anchor_view = syms_anchor[layer].view_as<int16_t>();\par
00823                               const auto syms_view = symbols[layer].view_as<int16_t>();\par
00824                               const auto syms_no_sad_view = syms_no_sad[layer].view_as<int16_t>();\par
00825 \par
00826                               if (syms_no_sad_view.read(x / transform_block_size(), y / transform_block_size()) !=\par
00827                                   syms_anchor_view.read(x / transform_block_size(), y / transform_block_size()))\par
00828                                   return 20000;\par
00829                               else if (syms_anchor_view.read(x / transform_block_size(), y / transform_block_size()) !=\par
00830                                        syms_view.read(x / transform_block_size(), y / transform_block_size()))\par
00831                                   return -20000;\par
00832                               else\par
00833                                   return 0;\par
00834                           \})\par
00835                 .finish();\par
00836         static_residuals_debug.dump(format({\cf22 "enc_full_coeff_SAD_changes_P%1d"}, plane));\par
00837     \}\par
00838 \}\par
00839 \par
00840 Surface Encoder::decode_residuals({\cf18 unsigned} plane, {\cf18 unsigned} loq, {\cf17 const} Surface symbols[MAX_NUM_LAYERS], Temporal_SWM temp_type,\par
00841                                   {\cf17 const} Surface &temporal_mask){\cf17  const }\{\par
00842 \par
00843     Surface coefficients[MAX_NUM_LAYERS] = \{\};\par
00844     int32_t dirq_step_width[MAX_NUM_LAYERS][2] = \{\};\par
00845     int32_t invq_step_width[MAX_NUM_LAYERS][2] = \{\};\par
00846     int32_t invq_offset[MAX_NUM_LAYERS][2] = \{\};\par
00847     int32_t invq_deadzone[MAX_NUM_LAYERS][2] = \{\};\par
00848     {\cf17 const} {\cf18 bool} horizontal_only = (configuration_.global_configuration.scaling_mode[loq] == ScalingMode_1D ? true : {\cf17 false});\par
00849 \par
00850     {\cf20 // Apply temporal step width modifier, if required}\par
00851     {\cf18 unsigned} passes = 1;\par
00852     \{\par
00853         int16_t step_width[2];\par
00854         int16_t calculated_step_width = configuration_.picture_configuration.step_width_loq[loq];\par
00855         {\cf19 if} (loq == LOQ_LEVEL_2 && plane > 0) \{\par
00856             calculated_step_width =\par
00857                 clamp((int16_t)((calculated_step_width * configuration_.global_configuration.chroma_step_width_multiplier) >> 6),\par
00858                       (int16_t)MIN_STEP_WIDTH, (int16_t)MAX_STEP_WIDTH);\par
00859         \}\par
00860         {\cf19 if} (loq == LOQ_LEVEL_2) \{\par
00861             {\cf19 switch} (temp_type) \{\par
00862             {\cf19 case} Temporal_SWM::SWM_Disabled:\par
00863                 step_width[0] = calculated_step_width;\par
00864                 {\cf19 break};\par
00865             {\cf19 case} Temporal_SWM::SWM_Active:\par
00866                 step_width[0] =\par
00867                     clamp((int16_t)(calculated_step_width *\par
00868                                     (1 - clamp((({\cf18 float})configuration_.global_configuration.temporal_step_width_modifier / ({\cf18 float})255),\par
00869                                                ({\cf18 float})0, ({\cf18 float})0.5))),\par
00870                           (int16_t)MIN_STEP_WIDTH, (int16_t)MAX_STEP_WIDTH);\par
00871                 {\cf19 break};\par
00872             {\cf19 case} Temporal_SWM::SWM_Dependent:\par
00873                 step_width[0] =\par
00874                     clamp((int16_t)(calculated_step_width *\par
00875                                     (1 - clamp((({\cf18 float})configuration_.global_configuration.temporal_step_width_modifier / ({\cf18 float})255),\par
00876                                                ({\cf18 float})0, ({\cf18 float})0.5))),\par
00877                           (int16_t)MIN_STEP_WIDTH, (int16_t)MAX_STEP_WIDTH);\par
00878                 step_width[1] = calculated_step_width;\par
00879                 passes = 2;\par
00880                 {\cf19 break};\par
00881             {\cf19 default}:\par
00882                 {\cf19 break};\par
00883             \}\par
00884         \} {\cf19 else} \{\par
00885             step_width[0] = calculated_step_width;\par
00886         \}\par
00887 \par
00888         {\cf19 for} ({\cf18 unsigned} pass = 0; pass < passes; pass++) \{\par
00889             {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00890                 dirq_step_width[layer][pass] = find_dirq_step_width(step_width[pass], quant_matrix_coeffs_[plane][loq][layer]);\par
00891                 invq_offset[layer][pass] =\par
00892                     find_invq_offset(configuration_.picture_configuration, step_width[pass], dirq_step_width[layer][pass]);\par
00893 \par
00894                 invq_step_width[layer][pass] =\par
00895                     find_invq_step_width(configuration_.picture_configuration, dirq_step_width[layer][pass], invq_offset[layer][pass]);\par
00896 \par
00897                 invq_deadzone[layer][pass] = find_layer_deadzone(step_width[pass], invq_step_width[layer][pass]);\par
00898             \}\par
00899         \}\par
00900     \}\par
00901 \par
00902     {\cf20 // Dequantize}\par
00903     {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00904         Surface syms;\par
00905         {\cf19 if} (is_user_data_layer(loq, layer))\par
00906             syms = UserDataClear().process(symbols[layer], configuration_.global_configuration.user_data_enabled);\par
00907         {\cf19 else}\par
00908             syms = symbols[layer];\par
00909 \par
00910         {\cf19 if} (passes == 1) \{\par
00911             coefficients[layer] = InverseQuantize().process(\par
00912                 syms, invq_step_width[layer][0],\par
00913                 find_invq_applied_offset(configuration_.picture_configuration, invq_offset[layer][0], invq_deadzone[layer][0]));\par
00914         \} {\cf19 else} \{\par
00915             int32_t invq_applied_offset[2] = \{\par
00916                 find_invq_applied_offset(configuration_.picture_configuration, invq_offset[layer][0], invq_deadzone[layer][0]),\par
00917                 find_invq_applied_offset(configuration_.picture_configuration, invq_offset[layer][1], invq_deadzone[layer][1])\};\par
00918 \par
00919             coefficients[layer] = InverseQuantize_SWM().process(symbols[layer], transform_block_size(), invq_step_width[layer],\par
00920                                                                 invq_applied_offset, temporal_mask);\par
00921         \}\par
00922     \}\par
00923 \par
00924     Surface residuals;\par
00925 \par
00926     {\cf19 if} (!horizontal_only) \{\par
00927         {\cf20 // Inverse Transform Horizontal and Vertical}\par
00928         {\cf20 //}\par
00929         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00930             residuals = InverseTransformDDS().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00931                                                       coefficients);\par
00932         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00933             residuals = InverseTransformDD().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00934                                                      coefficients);\par
00935     \} {\cf19 else} \{\par
00936         {\cf20 // Inverse Transform Horizontal only}\par
00937         {\cf20 //}\par
00938         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00939             residuals = InverseTransformDDS_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00940                                                          coefficients);\par
00941         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00942             residuals = InverseTransformDD_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00943                                                         coefficients);\par
00944     \}\par
00945 \par
00946     {\cf19 return} residuals;\par
00947 \}\par
