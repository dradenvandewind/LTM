00056 {\cf17 def }parse_vooya_filename(name):\par
00057     {\cf22 """}\par
00058 {\cf22     Extract vooya-ish image metadata from filename in form suitable for use as encoder parameters.}\par
00059 {\cf22     """}\par
00060     params = \{\}\par
00061     {\cf19 for} p {\cf19 in} name.split({\cf22 "_"}):\par
00062         {\cf19 for} n,r {\cf19 in} IMAGE_NAME_PARAMS:\par
00063             m = r.match(p)\par
00064             {\cf19 if} m:\par
00065                 params[n] = m.group(1)\par
00066 \par
00067     {\cf19 if} {\cf22 'bit_depth'} {\cf19 in} params:\par
00068         {\cf19 if} {\cf22 'format'} {\cf19 not} {\cf19 in} params:\par
00069             params[{\cf22 'format'}] = {\cf22 "420p"}\par
00070         params[{\cf22 'format'}] += params.pop({\cf22 'bit_depth'})\par
00071 \par
00072     {\cf19 if} {\cf22 'format'} {\cf19 in} params {\cf19 and} params[{\cf22 'format'}].startswith({\cf22 '4'}):\par
00073         params[{\cf22 'format'}] = {\cf22 'yuv'} + params[{\cf22 'format'}]\par
00074 \par
00075     {\cf19 if} {\cf22 'width'} {\cf19 in} params:\par
00076         params[{\cf22 'width'}] = int(params[{\cf22 'width'}])\par
00077     {\cf19 if} {\cf22 'height'} {\cf19 in} params:\par
00078         params[{\cf22 'height'}] = int(params[{\cf22 'height'}])\par
00079     {\cf19 if} {\cf22 'fps'} {\cf19 in} params:\par
00080         params[{\cf22 'fps'}] = int(params[{\cf22 'fps'}])\par
00081 \par
00082     {\cf19 return} params\par
