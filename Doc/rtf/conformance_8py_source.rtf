00127 {\cf17 def }run_subprocess(title, args, logfile, scriptfile, show_progress):\par
00128     {\cf22 """Run a comamnd as a subprocess - report progress and capture output (both stderr and stdout) to a log file."""}\par
00129 \par
00130     {\cf17 with} open(logfile, {\cf22 "wt"}) {\cf17 as} log:\par
00131         sys.stderr.write(f{\cf22 "    \{title\}: Start\\r"})\par
00132         {\cf19 if} show_progress {\cf19 and} show_progress.lower() != {\cf22 "none"}:\par
00133             sys.stderr.write({\cf22 "\\r"})\par
00134         {\cf19 else}:\par
00135             sys.stderr.write({\cf22 "\\n"})\par
00136 \par
00137         print({\cf22 " "}.join(args), file=log)\par
00138 \par
00139         {\cf17 with} subprocess.Popen(args, bufsize=1, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\par
00140                               universal_newlines={\cf17 True}) {\cf17 as} p:\par
00141             {\cf19 for} n,l {\cf19 in} enumerate(p.stdout):\par
