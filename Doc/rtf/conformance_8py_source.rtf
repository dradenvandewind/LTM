00089         {\cf19 if} line[:6] == {\cf22 "[MD5Y "}:\par
00090             frame_data = [poc, width, height]\par
00091             frame_data.append(line[6:38])\par
00092             frame_data.append(line[46:78])\par
00093             frame_data.append(line[86:118])\par
00094             data.append(frame_data)\par
00095             poc += 1\par
00096 \par
