00547   {\cf17 const} Pel* piCur   = rcDtParam.cur.buf;\par
00548   {\cf18 int}  iRows         = rcDtParam.org.height;\par
00549   {\cf18 int}  iSubShift     = rcDtParam.subShift;\par
00550   {\cf18 int}  iSubStep      = ( 1 << iSubShift );\par
00551   {\cf18 int}  iStrideCur    = rcDtParam.cur.stride * iSubStep;\par
00552   {\cf18 int}  iStrideOrg    = rcDtParam.org.stride * iSubStep;\par
00553 \par
00554   Distortion uiSum = 0;\par
00555 \par
00556   {\cf19 for}( ; iRows != 0; iRows -= iSubStep )\par
00557   \{\par
00558     uiSum += abs( piOrg[0] - piCur[0] );\par
00559     uiSum += abs( piOrg[1] - piCur[1] );\par
00560     uiSum += abs( piOrg[2] - piCur[2] );\par
00561     uiSum += abs( piOrg[3] - piCur[3] );\par
00562 \par
00563     piOrg += iStrideOrg;\par
00564     piCur += iStrideCur;\par
00565   \}\par
