03516 Distortion RdCost::xGetSADwMask( {\cf17 const} DistParam& rcDtParam )\par
03517 \{\par
03518   {\cf19 if} ( rcDtParam.applyWeight )\par
03519   \{\par
03520     {\cf19 return} RdCostWeightPrediction::xGetSADw( rcDtParam );\par
03521   \}\par
03522 \par
03523   {\cf17 const} Pel* org           = rcDtParam.org.buf;\par
03524   {\cf17 const} Pel* cur           = rcDtParam.cur.buf;\par
03525   {\cf17 const} Pel* mask          = rcDtParam.mask;\par
03526   {\cf17 const} {\cf18 int}  cols           = rcDtParam.org.width;\par
03527   {\cf18 int}        rows           = rcDtParam.org.height;\par
03528   {\cf17 const} {\cf18 int}  subShift       = rcDtParam.subShift;\par
03529   {\cf17 const} {\cf18 int}  subStep        = ( 1 << subShift);\par
03530   {\cf17 const} {\cf18 int}  strideCur      = rcDtParam.cur.stride * subStep;\par
03531   {\cf17 const} {\cf18 int}  strideOrg      = rcDtParam.org.stride * subStep;\par
03532   {\cf17 const} {\cf18 int}  strideMask     = rcDtParam.maskStride * subStep;\par
03533   {\cf17 const} {\cf18 int}  stepX = rcDtParam.stepX;\par
03534   {\cf17 const} {\cf18 int}  strideMask2 = rcDtParam.maskStride2;\par
03535   {\cf17 const} uint32_t distortionShift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth);\par
03536 \par
03537   Distortion sum = 0;\par
03538   {\cf19 for} (; rows != 0; rows -= subStep)\par
03539   \{\par
03540     {\cf19 for} ({\cf18 int} n = 0; n < cols; n++)\par
03541     \{\par
03542       sum += abs(org[n] - cur[n]) * *mask;\par
03543       mask += stepX;\par
03544     \}\par
03545     org += strideOrg;\par
03546     cur += strideCur;\par
03547     mask += strideMask;\par
03548     mask += strideMask2;\par
03549   \}\par
03550   sum <<= subShift;\par
03551   {\cf19 return} (sum >> distortionShift );\par
03552 \}\par
03554 \par
03555 \} {\cf20 // namespace vtm}\par
