00064 {\cf21 #if WCG_EXT}\par
00065 {\cf18 double} RdCost::calcRdCost( uint64_t fracBits, Distortion distortion, {\cf18 bool} useUnadjustedLambda )\par
00066 {\cf21 #else}\par
00067 {\cf18 double} RdCost::calcRdCost( uint64_t fracBits, Distortion distortion )\par
00068 {\cf21 #endif}\par
00069 \{\par
00070   {\cf19 if} (m_costMode == COST_LOSSLESS_CODING && 0 != distortion && m_isLosslessRDCost)\par
00071   \{\par
00072     {\cf19 return} MAX_DOUBLE;\par
00073   \}\par
00074 {\cf21 #if WCG_EXT}\par
00075   {\cf19 return} ( useUnadjustedLambda ? m_DistScaleUnadjusted : m_DistScale ) * {\cf18 double}( distortion ) + double( fracBits );\par
00076 {\cf21 #else}\par
00077   {\cf19 return} m_DistScale * double( distortion ) + double( fracBits );\par
00078 {\cf21 #endif}\par
00079 \}\par
00080 \par
00081 {\cf18 void} RdCost::setLambda( {\cf18 double} dLambda, {\cf17 const} BitDepths &bitDepths )\par
00082 \{\par
00083   m_dLambda             = dLambda;\par
00084   m_DistScale           = double(1<<SCALE_BITS) / m_dLambda;\par
00085   m_dLambdaMotionSAD    = sqrt(m_dLambda);\par
00086 \}\par
00087 \par
00088 {\cf18 void} RdCost::lambdaAdjustColorTrans({\cf18 bool} forward, ComponentID componentID, {\cf18 bool} applyChromaScale, {\cf18 int}* resScaleInv)\par
00089 \{\par
00090   {\cf19 if} (m_resetStore)\par
00091   \{\par
00092     {\cf19 for} (uint8_t component = 0; component < MAX_NUM_COMPONENT; component++)\par
00093     \{\par
00094       ComponentID compID = (ComponentID)component;\par
00095       {\cf18 int}       delta_QP = DELTA_QP_ACT[compID];\par
00096       {\cf18 double} lamdbaAdjustRate = pow(2.0, delta_QP / 3.0);\par
00097 \par
00098       m_lambdaStore[0][component] = m_dLambda;\par
00099       m_DistScaleStore[0][component] = m_DistScale;\par
00100 \par
00101       m_lambdaStore[1][component] = m_dLambda * lamdbaAdjustRate;\par
00102       m_DistScaleStore[1][component] = double(1 << SCALE_BITS) / m_lambdaStore[1][component];\par
00103     \}\par
00104     m_resetStore = {\cf17 false};\par
00105   \}\par
00106 \par
00107   {\cf19 if} (forward)\par
00108   \{\par
00109     CHECK(m_pairCheck == 1, {\cf22 "lambda has been already adjusted"});\par
00110     m_pairCheck = 1;\par
00111   \}\par
00112   {\cf19 else}\par
00113   \{\par
00114     CHECK(m_pairCheck == 0, {\cf22 "lambda has not been adjusted"});\par
00115     m_pairCheck = 0;\par
00116   \}\par
00117 \par
00118   m_dLambda = m_lambdaStore[m_pairCheck][componentID];\par
00119   m_DistScale = m_DistScaleStore[m_pairCheck][componentID];\par
00120   {\cf19 if} (applyChromaScale)\par
00121   \{\par
00122     CHECK(m_pairCheck == 0 || componentID == COMPONENT_Y, {\cf22 "wrong lambda adjustment for CS"});\par
00123     {\cf18 double} cResScale = (double)(1 << CSCALE_FP_PREC) / (double)(*resScaleInv);\par
00124     m_dLambda = m_dLambda / (cResScale*cResScale);\par
00125     m_DistScale = double(1 << SCALE_BITS) / m_dLambda;\par
00126   \}\par
00127   {\cf19 if} (m_pairCheck == 0)\par
00128   \{\par
00129     CHECK(m_DistScale != m_DistScaleUnadjusted, {\cf22 "lambda should be adjusted to the original value"});\par
00130   \}\par
00131 \}\par
