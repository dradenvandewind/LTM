03058 Distortion RdCost::getWeightedMSE({\cf18 int} compIdx, {\cf17 const} Pel org, {\cf17 const} Pel cur, {\cf17 const} uint32_t uiShift, {\cf17 const} Pel orgLuma)\par
03059 \{\par
03060   Distortion distortionVal = 0;\par
03061   Intermediate_Int iTemp = org - cur;\par
03062   CHECK( org<0, {\cf22 ""});\par
03063 \par
03064   {\cf19 if} (compIdx == COMPONENT_Y)\par
03065   \{\par
03066     CHECK(org != orgLuma, {\cf22 ""});\par
03067   \}\par
03068   {\cf20 // use luma to get weight}\par
03069   {\cf18 double} weight = 1.0;\par
03070   {\cf19 if} (m_signalType == RESHAPE_SIGNAL_SDR || m_signalType == RESHAPE_SIGNAL_HLG)\par
03071   \{\par
03072     {\cf19 if} (compIdx == COMPONENT_Y)\par
03073     \{\par
03074       weight = m_reshapeLumaLevelToWeightPLUT[orgLuma];\par
03075     \}\par
03076     {\cf19 else}\par
03077     \{\par
03078       weight = m_chromaWeight;\par
03079     \}\par
03080   \}\par
03081   {\cf19 else}\par
03082   \{\par
03083     weight = m_reshapeLumaLevelToWeightPLUT[orgLuma];\par
03084   \}\par
03085   int64_t fixedPTweight = (int64_t)(weight * ({\cf18 double})(1 << 16));\par
03086   Intermediate_Int mse = Intermediate_Int((fixedPTweight*(iTemp*iTemp) + (1 << 15)) >> 16);\par
03087   distortionVal = Distortion( mse >> uiShift);\par
03088   {\cf19 return} distortionVal;\par
03089 \}\par
