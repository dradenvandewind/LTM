00247 {\cf18 void} RdCost::setDistParam( DistParam &rcDP, {\cf17 const} CPelBuf &org, {\cf17 const} Pel* piRefY, {\cf18 int} iRefStride, {\cf18 int} bitDepth, ComponentID compID, {\cf18 int} subShiftMode, {\cf18 int} step, {\cf18 bool} useHadamard )\par
00248 \{\par
00249   rcDP.bitDepth   = bitDepth;\par
00250   rcDP.compID     = compID;\par
00251 \par
00252   {\cf20 // set Original & Curr Pointer / Stride}\par
00253   rcDP.org        = org;\par
00254 \par
00255   rcDP.cur.buf    = piRefY;\par
00256   rcDP.cur.stride = iRefStride;\par
00257 \par
00258   {\cf20 // set Block Width / Height}\par
00259   rcDP.cur.width    = org.width;\par
00260   rcDP.cur.height   = org.height;\par
00261   rcDP.step         = step;\par
00262   rcDP.maximumDistortionForEarlyExit = std::numeric_limits<Distortion>::max();\par
00263 \par
00264   {\cf18 int} DFOffset = ( rcDP.useMR ? DF_MRSAD - DF_SAD : 0 );\par
00265   {\cf19 if}( !useHadamard )\par
00266   \{\par
00267     {\cf19 if}( org.width == 12 )\par
00268     \{\par
00269       rcDP.distFunc = m_afpDistortFunc[ DF_SAD12 + DFOffset ];\par
00270     \}\par
00271     {\cf19 else} {\cf19 if}( org.width == 24 )\par
00272     \{\par
00273       rcDP.distFunc = m_afpDistortFunc[ DF_SAD24 + DFOffset ];\par
00274     \}\par
00275     {\cf19 else} {\cf19 if}( org.width == 48 )\par
00276     \{\par
00277       rcDP.distFunc = m_afpDistortFunc[ DF_SAD48 + DFOffset ];\par
00278     \}\par
00279     {\cf19 else} {\cf19 if}( isPowerOf2( org.width ) )\par
00280     \{\par
00281       rcDP.distFunc = m_afpDistortFunc[ DF_SAD + DFOffset + floorLog2( org.width ) ];\par
00282     \}\par
00283     {\cf19 else}\par
00284     \{\par
00285       rcDP.distFunc = m_afpDistortFunc[ DF_SAD + DFOffset ];\par
00286     \}\par
00287   \}\par
00288   {\cf19 else} {\cf19 if}( isPowerOf2( org.width ) )\par
00289   \{\par
00290     rcDP.distFunc = m_afpDistortFunc[ DF_HAD + DFOffset + floorLog2( org.width ) ];\par
00291   \}\par
