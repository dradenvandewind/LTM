02955 {\cf18 void} RdCost::initLumaLevelToWeightTable()\par
02956 \{\par
02957   {\cf19 for} ({\cf18 int} i = 0; i < LUMA_LEVEL_TO_DQP_LUT_MAXSIZE; i++)\par
02958   \{\par
02959     {\cf18 double} x = i;\par
02960     {\cf18 double} y;\par
02961 \par
02962     y = 0.015 * x - 1.5\par
02963         - 6;   {\cf20 // this is the Equation used to derive the luma qp LUT for HDR in MPEG HDR anchor3.2 (JCTCX-X1020)}\par
02964     y = y < -3 ? -3 : (y > 6 ? 6 : y);\par
02965 \par
02966     m_lumaLevelToWeightPLUT[i] = pow(2.0, y / 3.0);      {\cf20 // or power(10, dQp/10)      they are almost equal}\par
02967   \}\par
02968 \}\par
02969 \par
02970 {\cf18 void} RdCost::initLumaLevelToWeightTableReshape()\par
02971 \{\par
02972   {\cf18 int} lutSize = 1 << m_lumaBD;\par
02973   {\cf19 if} (m_reshapeLumaLevelToWeightPLUT.empty())\par
02974   \{\par
02975     m_reshapeLumaLevelToWeightPLUT.resize(lutSize, 1.0);\par
02976   \}\par
02977   {\cf19 if} (m_lumaLevelToWeightPLUT.empty())\par
02978   \{\par
02979     m_lumaLevelToWeightPLUT.resize(lutSize, 1.0);\par
02980   \}\par
02981   {\cf19 if} (m_signalType == RESHAPE_SIGNAL_PQ)\par
02982   \{\par
02983     {\cf19 for} ({\cf18 int} i = 0; i < (1 << m_lumaBD); i++)\par
02984     \{\par
02985       {\cf18 double} x = m_lumaBD < 10 ? i << (10 - m_lumaBD) : m_lumaBD > 10 ? i >> (m_lumaBD - 10) : i;\par
02986       {\cf18 double} y;\par
02987       y = 0.015*x - 1.5 - 6;\par
02988       y = y < -3 ? -3 : (y > 6 ? 6 : y);\par
02989       m_reshapeLumaLevelToWeightPLUT[i] = pow(2.0, y / 3.0);\par
02990       m_lumaLevelToWeightPLUT[i] = m_reshapeLumaLevelToWeightPLUT[i];\par
02991     \}\par
02992   \}\par
02993 \}\par
