02272 Distortion RdCost::xCalcHADs8x8( {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
02273 \{\par
02274   {\cf18 int} k, i, j, jj;\par
02275   Distortion sad = 0;\par
02276   TCoeff diff[64], m1[8][8], m2[8][8], m3[8][8];\par
02277   CHECK( iStep != 1, {\cf22 "Invalid step"} );\par
02278   {\cf19 for}( k = 0; k < 64; k += 8 )\par
02279   \{\par
02280     diff[k+0] = piOrg[0] - piCur[0];\par
02281     diff[k+1] = piOrg[1] - piCur[1];\par
02282     diff[k+2] = piOrg[2] - piCur[2];\par
02283     diff[k+3] = piOrg[3] - piCur[3];\par
02284     diff[k+4] = piOrg[4] - piCur[4];\par
02285     diff[k+5] = piOrg[5] - piCur[5];\par
02286     diff[k+6] = piOrg[6] - piCur[6];\par
02287     diff[k+7] = piOrg[7] - piCur[7];\par
02288 \par
02289     piCur += iStrideCur;\par
02290     piOrg += iStrideOrg;\par
02291   \}\par
02292 \par
02293   {\cf20 //horizontal}\par
02294   {\cf19 for} (j=0; j < 8; j++)\par
02295   \{\par
02296     jj = j << 3;\par
02297     m2[j][0] = diff[jj  ] + diff[jj+4];\par
02298     m2[j][1] = diff[jj+1] + diff[jj+5];\par
02299     m2[j][2] = diff[jj+2] + diff[jj+6];\par
02300     m2[j][3] = diff[jj+3] + diff[jj+7];\par
02301     m2[j][4] = diff[jj  ] - diff[jj+4];\par
02302     m2[j][5] = diff[jj+1] - diff[jj+5];\par
02303     m2[j][6] = diff[jj+2] - diff[jj+6];\par
02304     m2[j][7] = diff[jj+3] - diff[jj+7];\par
02305 \par
02306     m1[j][0] = m2[j][0] + m2[j][2];\par
02307     m1[j][1] = m2[j][1] + m2[j][3];\par
02308     m1[j][2] = m2[j][0] - m2[j][2];\par
02309     m1[j][3] = m2[j][1] - m2[j][3];\par
02310     m1[j][4] = m2[j][4] + m2[j][6];\par
02311     m1[j][5] = m2[j][5] + m2[j][7];\par
02312     m1[j][6] = m2[j][4] - m2[j][6];\par
02313     m1[j][7] = m2[j][5] - m2[j][7];\par
02314 \par
02315     m2[j][0] = m1[j][0] + m1[j][1];\par
02316     m2[j][1] = m1[j][0] - m1[j][1];\par
02317     m2[j][2] = m1[j][2] + m1[j][3];\par
02318     m2[j][3] = m1[j][2] - m1[j][3];\par
02319     m2[j][4] = m1[j][4] + m1[j][5];\par
02320     m2[j][5] = m1[j][4] - m1[j][5];\par
02321     m2[j][6] = m1[j][6] + m1[j][7];\par
02322     m2[j][7] = m1[j][6] - m1[j][7];\par
02323   \}\par
02324 \par
02325   {\cf20 //vertical}\par
02326   {\cf19 for} (i=0; i < 8; i++)\par
02327   \{\par
02328     m3[0][i] = m2[0][i] + m2[4][i];\par
02329     m3[1][i] = m2[1][i] + m2[5][i];\par
02330     m3[2][i] = m2[2][i] + m2[6][i];\par
02331     m3[3][i] = m2[3][i] + m2[7][i];\par
02332     m3[4][i] = m2[0][i] - m2[4][i];\par
02333     m3[5][i] = m2[1][i] - m2[5][i];\par
02334     m3[6][i] = m2[2][i] - m2[6][i];\par
02335     m3[7][i] = m2[3][i] - m2[7][i];\par
02336 \par
02337     m1[0][i] = m3[0][i] + m3[2][i];\par
02338     m1[1][i] = m3[1][i] + m3[3][i];\par
02339     m1[2][i] = m3[0][i] - m3[2][i];\par
02340     m1[3][i] = m3[1][i] - m3[3][i];\par
02341     m1[4][i] = m3[4][i] + m3[6][i];\par
02342     m1[5][i] = m3[5][i] + m3[7][i];\par
02343     m1[6][i] = m3[4][i] - m3[6][i];\par
02344     m1[7][i] = m3[5][i] - m3[7][i];\par
02345 \par
02346     m2[0][i] = m1[0][i] + m1[1][i];\par
02347     m2[1][i] = m1[0][i] - m1[1][i];\par
02348     m2[2][i] = m1[2][i] + m1[3][i];\par
02349     m2[3][i] = m1[2][i] - m1[3][i];\par
02350     m2[4][i] = m1[4][i] + m1[5][i];\par
02351     m2[5][i] = m1[4][i] - m1[5][i];\par
02352     m2[6][i] = m1[6][i] + m1[7][i];\par
02353     m2[7][i] = m1[6][i] - m1[7][i];\par
02354   \}\par
02355 \par
02356   {\cf19 for} (i = 0; i < 8; i++)\par
02357   \{\par
02358     {\cf19 for} (j = 0; j < 8; j++)\par
02359     \{\par
02360       sad += abs(m2[i][j]);\par
02361     \}\par
02362   \}\par
02363 \par
02364 {\cf21 #if JVET_R0164_MEAN_SCALED_SATD}\par
02365   sad -= abs(m2[0][0]);\par
02366   sad += abs(m2[0][0]) >> 2;\par
02367 {\cf21 #endif}\par
02368   sad  = ((sad+2)>>2);\par
02369 \par
02370   {\cf19 return} sad;\par
02371 \}\par
