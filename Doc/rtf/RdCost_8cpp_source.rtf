03011 {\cf18 void} RdCost::updateReshapeLumaLevelToWeightTable(SliceReshapeInfo &sliceReshape, Pel *wtTable, {\cf18 double} cwt)\par
03012 \{\par
03013   {\cf19 if} (m_signalType == RESHAPE_SIGNAL_SDR || m_signalType == RESHAPE_SIGNAL_HLG)\par
03014   \{\par
03015     {\cf19 if} (sliceReshape.getSliceReshapeModelPresentFlag())\par
03016     \{\par
03017       {\cf18 double} wBin = 1.0;\par
03018       {\cf18 double} weight = 1.0;\par
03019       {\cf18 int} histLens = (1 << m_lumaBD) / PIC_CODE_CW_BINS;\par
03020 \par
03021       {\cf19 for} ({\cf18 int} i = 0; i < PIC_CODE_CW_BINS; i++)\par
03022       \{\par
03023         {\cf19 if} ((i < sliceReshape.reshaperModelMinBinIdx) || (i > sliceReshape.reshaperModelMaxBinIdx))\par
03024         \{\par
03025           weight = 1.0;\par
03026         \}\par
03027         {\cf19 else}\par
03028         \{\par
03029           {\cf19 if} (sliceReshape.reshaperModelBinCWDelta[i] == 1 || (sliceReshape.reshaperModelBinCWDelta[i] == -1 * histLens))\par
03030           \{\par
03031             weight = wBin;\par
03032           \}\par
03033           {\cf19 else}\par
03034           \{\par
03035             weight = (double)wtTable[i] / ({\cf18 double})histLens;\par
03036             weight = weight*weight;\par
03037           \}\par
03038         \}\par
03039         {\cf19 for} ({\cf18 int} j = 0; j < histLens; j++)\par
03040         \{\par
03041           {\cf18 int} ii = i*histLens + j;\par
03042           m_reshapeLumaLevelToWeightPLUT[ii] = weight;\par
03043         \}\par
03044       \}\par
03045       m_chromaWeight = cwt;\par
03046     \}\par
03047     {\cf19 else}\par
03048     \{\par
03049       THROW({\cf22 "updateReshapeLumaLevelToWeightTable ERROR!!"});\par
03050     \}\par
03051   \}\par
03052   {\cf19 else}\par
03053   \{\par
03054     THROW({\cf22 "updateReshapeLumaLevelToWeightTable not support other signal types!!"});\par
03055   \}\par
03056 \}\par
