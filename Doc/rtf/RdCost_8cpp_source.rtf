00303     \{\par
00304       rcDP.subShift = 4;\par
00305     \}\par
00306     {\cf19 else} {\cf19 if}( rcDP.org.height > 16 && ( rcDP.org.height & 7 ) == 0 )\par
00307     \{\par
00308       rcDP.subShift = 3;\par
00309     \}\par
00310     {\cf19 else} {\cf19 if}( rcDP.org.height > 8 && ( rcDP.org.height & 3 ) == 0 )\par
00311     \{\par
00312       rcDP.subShift = 2;\par
00313     \}\par
00314     {\cf19 else} {\cf19 if}( ( rcDP.org.height & 1 ) == 0 )\par
00315     \{\par
00316       rcDP.subShift = 1;\par
00317     \}\par
00318   \}\par
00319   {\cf19 else} {\cf19 if}( subShiftMode == 2 )\par
00320   \{\par
00321     {\cf19 if}( rcDP.org.height > 8 && rcDP.org.width <= 64 )\par
00322     \{\par
00323       rcDP.subShift = 1;\par
00324     \}\par
00325   \}\par
00326   {\cf19 else} {\cf19 if}( subShiftMode == 3 )\par
00327   \{\par
00328     {\cf19 if} (rcDP.org.height > 8 )\par
00329     \{\par
00330       rcDP.subShift = 1;\par
00331     \}\par
00332   \}\par
