02171 Distortion RdCost::xCalcHADs4x4( {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
02172 \{\par
02173   {\cf18 int} k;\par
02174   Distortion satd = 0;\par
02175   TCoeff diff[16], m[16], d[16];\par
02176 \par
02177   CHECK( iStep != 1, {\cf22 "Invalid step"} );\par
02178   {\cf19 for}( k = 0; k < 16; k+=4 )\par
02179   \{\par
02180     diff[k+0] = piOrg[0] - piCur[0];\par
02181     diff[k+1] = piOrg[1] - piCur[1];\par
02182     diff[k+2] = piOrg[2] - piCur[2];\par
02183     diff[k+3] = piOrg[3] - piCur[3];\par
02184 \par
02185     piCur += iStrideCur;\par
02186     piOrg += iStrideOrg;\par
02187   \}\par
02188 \par
02189   {\cf20 /*===== hadamard transform =====*/}\par
02190   m[ 0] = diff[ 0] + diff[12];\par
02191   m[ 1] = diff[ 1] + diff[13];\par
02192   m[ 2] = diff[ 2] + diff[14];\par
02193   m[ 3] = diff[ 3] + diff[15];\par
02194   m[ 4] = diff[ 4] + diff[ 8];\par
02195   m[ 5] = diff[ 5] + diff[ 9];\par
02196   m[ 6] = diff[ 6] + diff[10];\par
02197   m[ 7] = diff[ 7] + diff[11];\par
02198   m[ 8] = diff[ 4] - diff[ 8];\par
02199   m[ 9] = diff[ 5] - diff[ 9];\par
02200   m[10] = diff[ 6] - diff[10];\par
02201   m[11] = diff[ 7] - diff[11];\par
02202   m[12] = diff[ 0] - diff[12];\par
02203   m[13] = diff[ 1] - diff[13];\par
02204   m[14] = diff[ 2] - diff[14];\par
02205   m[15] = diff[ 3] - diff[15];\par
02206 \par
02207   d[ 0] = m[ 0] + m[ 4];\par
02208   d[ 1] = m[ 1] + m[ 5];\par
02209   d[ 2] = m[ 2] + m[ 6];\par
02210   d[ 3] = m[ 3] + m[ 7];\par
02211   d[ 4] = m[ 8] + m[12];\par
02212   d[ 5] = m[ 9] + m[13];\par
02213   d[ 6] = m[10] + m[14];\par
02214   d[ 7] = m[11] + m[15];\par
02215   d[ 8] = m[ 0] - m[ 4];\par
02216   d[ 9] = m[ 1] - m[ 5];\par
02217   d[10] = m[ 2] - m[ 6];\par
02218   d[11] = m[ 3] - m[ 7];\par
02219   d[12] = m[12] - m[ 8];\par
02220   d[13] = m[13] - m[ 9];\par
02221   d[14] = m[14] - m[10];\par
02222   d[15] = m[15] - m[11];\par
02223 \par
02224   m[ 0] = d[ 0] + d[ 3];\par
02225   m[ 1] = d[ 1] + d[ 2];\par
02226   m[ 2] = d[ 1] - d[ 2];\par
02227   m[ 3] = d[ 0] - d[ 3];\par
02228   m[ 4] = d[ 4] + d[ 7];\par
02229   m[ 5] = d[ 5] + d[ 6];\par
02230   m[ 6] = d[ 5] - d[ 6];\par
02231   m[ 7] = d[ 4] - d[ 7];\par
02232   m[ 8] = d[ 8] + d[11];\par
02233   m[ 9] = d[ 9] + d[10];\par
02234   m[10] = d[ 9] - d[10];\par
02235   m[11] = d[ 8] - d[11];\par
02236   m[12] = d[12] + d[15];\par
02237   m[13] = d[13] + d[14];\par
02238   m[14] = d[13] - d[14];\par
02239   m[15] = d[12] - d[15];\par
02240 \par
02241   d[ 0] = m[ 0] + m[ 1];\par
02242   d[ 1] = m[ 0] - m[ 1];\par
02243   d[ 2] = m[ 2] + m[ 3];\par
02244   d[ 3] = m[ 3] - m[ 2];\par
02245   d[ 4] = m[ 4] + m[ 5];\par
02246   d[ 5] = m[ 4] - m[ 5];\par
02247   d[ 6] = m[ 6] + m[ 7];\par
02248   d[ 7] = m[ 7] - m[ 6];\par
02249   d[ 8] = m[ 8] + m[ 9];\par
02250   d[ 9] = m[ 8] - m[ 9];\par
02251   d[10] = m[10] + m[11];\par
02252   d[11] = m[11] - m[10];\par
02253   d[12] = m[12] + m[13];\par
02254   d[13] = m[12] - m[13];\par
02255   d[14] = m[14] + m[15];\par
02256   d[15] = m[15] - m[14];\par
02257 \par
02258   {\cf19 for} (k=0; k<16; ++k)\par
02259   \{\par
02260     satd += abs(d[k]);\par
02261   \}\par
02262 \par
02263 {\cf21 #if JVET_R0164_MEAN_SCALED_SATD}\par
02264   satd -= abs(d[0]);\par
02265   satd += abs(d[0]) >> 2;\par
02266 {\cf21 #endif}\par
02267   satd  = ((satd+1)>>1);\par
02268 \par
02269   {\cf19 return} satd;\par
02270 \}\par
