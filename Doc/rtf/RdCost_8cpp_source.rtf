00476 Distortion RdCost::xGetSAD_full( {\cf17 const} DistParam& rcDtParam )\par
00477 \{\par
00478   CHECK( rcDtParam.applyWeight, {\cf22 "Cannot apply weight when using full-bit SAD!"} );\par
00479   {\cf17 const} Pel* piOrg = rcDtParam.org.buf;\par
00480   {\cf17 const} Pel* piCur = rcDtParam.cur.buf;\par
00481   {\cf18 int}  height      = rcDtParam.org.height;\par
00482   {\cf18 int}  width       = rcDtParam.org.width;\par
00483   {\cf18 int}  iSubShift   = rcDtParam.subShift;\par
00484   {\cf18 int}  iSubStep    = ( 1 << iSubShift );\par
00485   {\cf18 int}  iStrideCur  = rcDtParam.cur.stride * iSubStep;\par
00486   {\cf18 int}  iStrideOrg  = rcDtParam.org.stride * iSubStep;\par
00487 \par
00488   Distortion uiSum = 0;\par
00489 \par
00490 {\cf21 #define SAD_OP( ADDR ) uiSum += abs( piOrg[ADDR] - piCur[ADDR] );}\par
00491 {\cf21 #define SAD_INC piOrg += iStrideOrg; piCur += iStrideCur;}\par
00492 \par
00493   SIZE_AWARE_PER_EL_OP( SAD_OP, SAD_INC )\par
00494 \par
00495 {\cf21 #undef SAD_OP}\par
00496 {\cf21 #undef SAD_INC}\par
00497 \par
00498   uiSum <<= iSubShift;\par
00499   {\cf19 return} uiSum;\par
00500 \}\par
00501 \par
00502 Distortion RdCost::xGetSAD( {\cf17 const} DistParam& rcDtParam )\par
00503 \{\par
00504   {\cf19 if} ( rcDtParam.applyWeight )\par
00505   \{\par
00506     {\cf19 return} RdCostWeightPrediction::xGetSADw( rcDtParam );\par
00507   \}\par
00508 \par
00509   {\cf17 const} Pel* piOrg           = rcDtParam.org.buf;\par
00510   {\cf17 const} Pel* piCur           = rcDtParam.cur.buf;\par
00511   {\cf17 const} {\cf18 int}  iCols           = rcDtParam.org.width;\par
00512         {\cf18 int}  iRows           = rcDtParam.org.height;\par
00513   {\cf17 const} {\cf18 int}  iSubShift       = rcDtParam.subShift;\par
00514   {\cf17 const} {\cf18 int}  iSubStep        = ( 1 << iSubShift );\par
00515   {\cf17 const} {\cf18 int}  iStrideCur      = rcDtParam.cur.stride * iSubStep;\par
00516   {\cf17 const} {\cf18 int}  iStrideOrg      = rcDtParam.org.stride * iSubStep;\par
00517   {\cf17 const} uint32_t distortionShift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth);\par
00518 \par
00519   Distortion uiSum = 0;\par
00520 \par
00521   {\cf19 for}( ; iRows != 0; iRows -= iSubStep )\par
00522   \{\par
00523     {\cf19 for} ({\cf18 int} n = 0; n < iCols; n++ )\par
00524     \{\par
00525       uiSum += abs( piOrg[n] - piCur[n] );\par
00526     \}\par
00527     {\cf19 if} (rcDtParam.maximumDistortionForEarlyExit < ( uiSum >> distortionShift ))\par
00528     \{\par
00529       {\cf19 return} ( uiSum >> distortionShift );\par
00530     \}\par
00531     piOrg += iStrideOrg;\par
00532     piCur += iStrideCur;\par
00533   \}\par
00534 \par
00535   uiSum <<= iSubShift;\par
00536   {\cf19 return} ( uiSum >> distortionShift );\par
00537 \}\par
