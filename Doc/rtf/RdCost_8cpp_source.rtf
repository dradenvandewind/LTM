03491 {\cf18 void} RdCost::setDistParam( DistParam &rcDP, {\cf17 const} CPelBuf &org, {\cf17 const} Pel* piRefY, {\cf18 int} iRefStride, {\cf17 const} Pel* mask, {\cf18 int} iMaskStride, {\cf18 int} stepX, {\cf18 int} iMaskStride2, {\cf18 int} bitDepth, ComponentID compID)\par
03492 \{\par
03493   rcDP.bitDepth     = bitDepth;\par
03494   rcDP.compID       = compID;\par
03495 \par
03496   {\cf20 // set Original & Curr Pointer / Stride}\par
03497   rcDP.org          = org;\par
03498   rcDP.cur.buf      = piRefY;\par
03499   rcDP.cur.stride   = iRefStride;\par
03500 \par
03501   {\cf20 // set Mask}\par
03502   rcDP.mask         = mask;\par
03503   rcDP.maskStride   = iMaskStride;\par
03504   rcDP.stepX = stepX;\par
03505   rcDP.maskStride2 = iMaskStride2;\par
03506 \par
03507   {\cf20 // set Block Width / Height}\par
03508   rcDP.cur.width    = org.width;\par
03509   rcDP.cur.height   = org.height;\par
03510   rcDP.maximumDistortionForEarlyExit = std::numeric_limits<Distortion>::max();\par
03511 \par
