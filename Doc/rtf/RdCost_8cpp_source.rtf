02824 Distortion RdCost::xGetHADs( {\cf17 const} DistParam &rcDtParam )\par
02825 \{\par
02826   {\cf19 if}( rcDtParam.applyWeight )\par
02827   \{\par
02828     {\cf19 return} RdCostWeightPrediction::xGetHADsw( rcDtParam );\par
02829   \}\par
02830   {\cf17 const} Pel* piOrg = rcDtParam.org.buf;\par
02831   {\cf17 const} Pel* piCur = rcDtParam.cur.buf;\par
02832   {\cf17 const} {\cf18 int}  iRows = rcDtParam.org.height;\par
02833   {\cf17 const} {\cf18 int}  iCols = rcDtParam.org.width;\par
02834   {\cf17 const} {\cf18 int}  iStrideCur = rcDtParam.cur.stride;\par
02835   {\cf17 const} {\cf18 int}  iStrideOrg = rcDtParam.org.stride;\par
02836   {\cf17 const} {\cf18 int}  iStep = rcDtParam.step;\par
02837 \par
02838   {\cf18 int}  x = 0, y = 0;\par
02839 \par
02840   Distortion uiSum = 0;\par
02841 \par
02842   {\cf19 if}( iCols > iRows && ( iRows & 7 ) == 0 && ( iCols & 15 ) == 0 )\par
02843   \{\par
02844     {\cf19 for}( y = 0; y < iRows; y += 8 )\par
02845     \{\par
02846       {\cf19 for}( x = 0; x < iCols; x += 16 )\par
02847       \{\par
02848         uiSum += xCalcHADs16x8( &piOrg[x], &piCur[x], iStrideOrg, iStrideCur );\par
02849       \}\par
02850       piOrg += iStrideOrg * 8;\par
02851       piCur += iStrideCur * 8;\par
02852     \}\par
02853   \}\par
02854   {\cf19 else} {\cf19 if}( iCols < iRows && ( iCols & 7 ) == 0 && ( iRows & 15 ) == 0 )\par
02855   \{\par
02856     {\cf19 for}( y = 0; y < iRows; y += 16 )\par
02857     \{\par
02858       {\cf19 for}( x = 0; x < iCols; x += 8 )\par
02859       \{\par
02860         uiSum += xCalcHADs8x16( &piOrg[x], &piCur[x], iStrideOrg, iStrideCur );\par
02861       \}\par
02862       piOrg += iStrideOrg * 16;\par
02863       piCur += iStrideCur * 16;\par
02864     \}\par
02865   \}\par
02866   {\cf19 else} {\cf19 if}( iCols > iRows && ( iRows & 3 ) == 0 && ( iCols & 7 ) == 0 )\par
02867   \{\par
02868     {\cf19 for}( y = 0; y < iRows; y += 4 )\par
02869     \{\par
02870       {\cf19 for}( x = 0; x < iCols; x += 8 )\par
02871       \{\par
02872         uiSum += xCalcHADs8x4( &piOrg[x], &piCur[x], iStrideOrg, iStrideCur );\par
02873       \}\par
02874       piOrg += iStrideOrg * 4;\par
02875       piCur += iStrideCur * 4;\par
02876     \}\par
02877   \}\par
02878   {\cf19 else} {\cf19 if}( iCols < iRows && ( iCols & 3 ) == 0 && ( iRows & 7 ) == 0 )\par
02879   \{\par
02880     {\cf19 for}( y = 0; y < iRows; y += 8 )\par
02881     \{\par
02882       {\cf19 for}( x = 0; x < iCols; x += 4 )\par
02883       \{\par
02884         uiSum += xCalcHADs4x8( &piOrg[x], &piCur[x], iStrideOrg, iStrideCur );\par
02885       \}\par
02886       piOrg += iStrideOrg * 8;\par
02887       piCur += iStrideCur * 8;\par
02888     \}\par
02889   \}\par
02890   {\cf19 else} {\cf19 if}( ( iRows % 8 == 0 ) && ( iCols % 8 == 0 ) )\par
02891   \{\par
02892     {\cf18 int}  iOffsetOrg = iStrideOrg << 3;\par
02893     {\cf18 int}  iOffsetCur = iStrideCur << 3;\par
02894     {\cf19 for}( y = 0; y < iRows; y += 8 )\par
02895     \{\par
02896       {\cf19 for}( x = 0; x < iCols; x += 8 )\par
02897       \{\par
02898         uiSum += xCalcHADs8x8( &piOrg[x], &piCur[x*iStep], iStrideOrg, iStrideCur, iStep );\par
02899       \}\par
02900       piOrg += iOffsetOrg;\par
02901       piCur += iOffsetCur;\par
02902     \}\par
02903   \}\par
02904   {\cf19 else} {\cf19 if}( ( iRows % 4 == 0 ) && ( iCols % 4 == 0 ) )\par
02905   \{\par
02906     {\cf18 int}  iOffsetOrg = iStrideOrg << 2;\par
02907     {\cf18 int}  iOffsetCur = iStrideCur << 2;\par
02908 \par
02909     {\cf19 for}( y = 0; y < iRows; y += 4 )\par
02910     \{\par
02911       {\cf19 for}( x = 0; x < iCols; x += 4 )\par
02912       \{\par
02913         uiSum += xCalcHADs4x4( &piOrg[x], &piCur[x*iStep], iStrideOrg, iStrideCur, iStep );\par
02914       \}\par
02915       piOrg += iOffsetOrg;\par
02916       piCur += iOffsetCur;\par
02917     \}\par
02918   \}\par
02919   {\cf19 else} {\cf19 if}( ( iRows % 2 == 0 ) && ( iCols % 2 == 0 ) )\par
02920   \{\par
02921     {\cf18 int}  iOffsetOrg = iStrideOrg << 1;\par
02922     {\cf18 int}  iOffsetCur = iStrideCur << 1;\par
02923     {\cf19 for}( y = 0; y < iRows; y += 2 )\par
02924     \{\par
02925       {\cf19 for}( x = 0; x < iCols; x += 2 )\par
02926       \{\par
02927         uiSum += xCalcHADs2x2( &piOrg[x], &piCur[x*iStep], iStrideOrg, iStrideCur, iStep );\par
02928       \}\par
02929       piOrg += iOffsetOrg;\par
02930       piCur += iOffsetCur;\par
02931     \}\par
02932   \}\par
02933   {\cf19 else}\par
02934   \{\par
02935     THROW( {\cf22 "Invalid size"} );\par
02936   \}\par
02937 \par
02938   {\cf19 return} (uiSum >> DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth));\par
02939 \}\par
