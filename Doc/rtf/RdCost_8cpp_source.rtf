00580   {\cf18 int}  iRows            = rcDtParam.org.height;\par
00581   {\cf18 int}  iSubShift        = rcDtParam.subShift;\par
00582   {\cf18 int}  iSubStep         = ( 1 << iSubShift );\par
00583   {\cf18 int}  iStrideCur       = rcDtParam.cur.stride * iSubStep;\par
00584   {\cf18 int}  iStrideOrg       = rcDtParam.org.stride * iSubStep;\par
00585 \par
00586   Distortion uiSum = 0;\par
00587 \par
00588   {\cf19 for}( ; iRows != 0; iRows-=iSubStep )\par
00589   \{\par
00590     uiSum += abs( piOrg[0] - piCur[0] );\par
00591     uiSum += abs( piOrg[1] - piCur[1] );\par
00592     uiSum += abs( piOrg[2] - piCur[2] );\par
00593     uiSum += abs( piOrg[3] - piCur[3] );\par
