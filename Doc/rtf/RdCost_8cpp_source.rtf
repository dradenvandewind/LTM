00571 Distortion RdCost::xGetSAD8( {\cf17 const} DistParam& rcDtParam )\par
00572 \{\par
00573   {\cf19 if} ( rcDtParam.applyWeight )\par
00574   \{\par
00575     {\cf19 return} RdCostWeightPrediction::xGetSADw( rcDtParam );\par
00576   \}\par
