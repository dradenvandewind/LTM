02145 Distortion RdCost::xCalcHADs2x2( {\cf17 const} Pel *piOrg, {\cf17 const} Pel *piCur, {\cf18 int} iStrideOrg, {\cf18 int} iStrideCur, {\cf18 int} iStep )\par
02146 \{\par
02147   Distortion satd = 0;\par
02148   TCoeff diff[4], m[4];\par
02149   CHECK( iStep != 1, {\cf22 "Invalid step"} );\par
02150   diff[0] = piOrg[0             ] - piCur[0];\par
02151   diff[1] = piOrg[1             ] - piCur[1];\par
02152   diff[2] = piOrg[iStrideOrg    ] - piCur[0 + iStrideCur];\par
02153   diff[3] = piOrg[iStrideOrg + 1] - piCur[1 + iStrideCur];\par
02154   m[0] = diff[0] + diff[2];\par
02155   m[1] = diff[1] + diff[3];\par
02156   m[2] = diff[0] - diff[2];\par
02157   m[3] = diff[1] - diff[3];\par
02158 \par
02159 {\cf21 #if JVET_R0164_MEAN_SCALED_SATD}\par
02160   satd += abs(m[0] + m[1]) >> 2;\par
02161 {\cf21 #else}\par
02162   satd += abs(m[0] + m[1]);\par
02163 {\cf21 #endif}\par
02164   satd += abs(m[0] - m[1]);\par
02165   satd += abs(m[2] + m[3]);\par
02166   satd += abs(m[2] - m[3]);\par
02167 \par
02168   {\cf19 return} satd;\par
02169 \}\par
