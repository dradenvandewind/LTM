02817   sad += abs(m2[0][0]) >> 2;\par
02818 {\cf21 #endif}\par
02819   sad  = ( int ) ( sad / sqrt( 4.0 * 8 ) * 2 );\par
02820 \par
02821   {\cf19 return} sad;\par
02822 \}\par
