00202 {\cf18 void} Context::flush() \{\par
00203 \par
00204     {\cf20 // Poke bitstream into our JM hooks}\par
00205     inject_annex_b_bitstream(base_bitstream_.data(), ({\cf18 unsigned})base_bitstream_.size());\par
00206 \par
00207     InputParameters input_parameters;\par
00208     memset(&input_parameters, 0, {\cf17 sizeof}(input_parameters));\par
00209     strcpy(input_parameters.infile, {\cf22 ""});\par
00210     strcpy(input_parameters.outfile, {\cf22 ""});\par
00211     strcpy(input_parameters.reffile, {\cf22 ""});\par
00212 \par
00213     {\cf17 const} {\cf18 char} *{\cf17 const} decoder_args[] = \{{\cf22 "ldecod"}\};\par
00214     ParseCommand(&input_parameters, ARRAY_SIZE(decoder_args), ({\cf18 char} **)decoder_args);\par
00215 \par
00216     {\cf20 // Open decoder}\par
00217     {\cf19 if} (OpenDecoder(&input_parameters) != DEC_OPEN_NOERR) \{\par
00218         ERR({\cf22 "Cannot open base decoder"});\par
00219     \}\par
00220 \par
00221     p_Dec->p_Vid->p_out = -2;\par
00222 \par
00223     {\cf20 // Run decoder}\par
00224     {\cf20 //}\par
00225     DecodedPicList *pDecPicList = 0;\par
00226     {\cf18 int} frame_count = 0;\par
00227 \par
00228     {\cf18 int} r = 0;\par
00229     {\cf19 do} \{\par
00230         r = DecodeOneFrame(&pDecPicList);\par
00231 \par
00232         {\cf19 if} (r == DEC_EOS || r == DEC_SUCCEED) \{\par
00233             decode_enhanced_frames(pDecPicList, {\cf17 false});\par
00234             frame_count++;\par
00235         \} {\cf19 else} \{\par
00236             ERR({\cf22 "Error in decoding process: 0x%x"}, r);\par
00237         \}\par
00238     \} {\cf19 while} ((r == DEC_SUCCEED) && ((p_Dec->p_Inp->iDecFrmNum == 0) || (frame_count < p_Dec->p_Inp->iDecFrmNum)));\par
00239 \par
00240     FinitDecoder(&pDecPicList);\par
00241 \par
00242     {\cf20 // Write last frame}\par
00243     decode_enhanced_frames(pDecPicList, {\cf17 true});\par
00244 \par
00245     CloseDecoder();\par
00246 \}\par
