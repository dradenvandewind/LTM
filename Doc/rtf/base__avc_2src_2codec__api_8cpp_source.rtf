00094 \par
00095 {\cf20 // Push encoded data into decoder}\par
00096 {\cf20 //}\par
00097 {\cf20 // To avoid messing with JM any more than necessary, this cheats a bit and saves the entire input bitstream}\par
00098 {\cf20 // until EOS, then starts the JM decoder with the whole stream.}\par
00099 {\cf20 //}\par
00100 {\cf17 static} int32_t push_packet(CodecContext c, {\cf17 const} uint8_t *data, {\cf18 size_t} length, CodecMetadata metadata, int8_t eos,\par
00101                            CodecError *error) \{\par
00102     Context *context = (Context *)c;\par
00103     {\cf19 if} (error)\par
00104         *error = 0;\par
00105 \par
00106     {\cf19 switch} (context->state_) \{\par
00107     {\cf19 case} StatePushing:\par
00108         {\cf19 if} (!eos) \{\par
00109             CHECK(data);\par
00110             CHECK(length >= 3);\par
00111             {\cf20 // Fixup NALU start code - if first is 3 bytes, make it 4}\par
00112             {\cf19 if} (data[0] == {\cf23 '\\0'} && data[1] == {\cf23 '\\0'} && data[2] == {\cf23 '\\1'}) \{\par
00113                 {\cf18 char} {\cf17 const} zero = {\cf23 '\\0'};\par
00114                 context->base_bitstream_.push_back(0);\par
00115             \}\par
00116 \par
00117             {\cf20 // Accumulate AUs into a temporary buffer}\par
00118             context->base_bitstream_.insert(context->base_bitstream_.end(), data, data + length);\par
00119         \} {\cf19 else} \{\par
00121             context->state_ = StateDecoding;\par
00122         \}\par
00123         {\cf19 return} 0;\par
00124 \par
00125     {\cf19 default}:\par
00126         ERR({\cf22 "Unexpected decoder state"});\par
00127     \}\par
00128 \par
00129     {\cf19 return} 0;\par
00130 \}\par
