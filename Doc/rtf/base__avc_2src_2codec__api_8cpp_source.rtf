00132 {\cf17 static} {\cf18 bool} extract_image(DecodedPicList *pic, CodecImage *codec_image) \{\par
00133 \par
00134     {\cf20 // Is there a picture?}\par
00135     {\cf19 if} (!pic || !pic->pY || !pic->pU || !pic->pV) \{\par
00136         {\cf19 return} {\cf17 false};\par
00137     \}\par
00138 \par
00139     {\cf19 if} (!pic->bValid) \{\par
00140         INFO({\cf22 "Picture not marked valid?"});\par
00141         {\cf19 return} {\cf17 false};\par
00142     \}\par
00143 \par
00144     CHECK(codec_image);\par
00145     codec_image->bpp = ((pic->iBitDepth + 7) >> 3);\par
00146     codec_image->width_y = pic->iWidth;\par
00147     codec_image->height_y = pic->iHeight;\par
00148     codec_image->stride_y = pic->iYBufStride;\par
00149 \par
00150     codec_image->width_uv = (pic->iYUVFormat != YUV444) ? (pic->iWidth / 2) : pic->iWidth;\par
00151     codec_image->height_uv = (pic->iYUVFormat == YUV420) ? (pic->iHeight / 2) : pic->iHeight;\par
00152     codec_image->stride_uv = pic->iUVBufStride;\par
00153 \par
00154     codec_image->data_y = pic->pY;\par
00155     codec_image->data_u = pic->pU;\par
00156     codec_image->data_v = pic->pV;\par
00157 \par
00158     {\cf19 return} {\cf17 true};\par
00159 \}\par
