00083 {\cf17 static} int32_t create_context(CodecContext *cp, {\cf17 const} {\cf18 char} *json_configuration, CodecError *error) \{\par
00084     {\cf19 if} (error)\par
00085         *error = 0;\par
00086 \par
00087     Context *context = {\cf17 new} Context();\par
00088     context->configuration_ = json_configuration;\par
00089     context->state_ = StatePushing;\par
00090     *cp = ({\cf18 void} *)context;\par
00091 \par
