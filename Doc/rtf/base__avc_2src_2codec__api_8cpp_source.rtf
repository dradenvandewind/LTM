00161 {\cf17 static} int32_t pull_image(CodecContext c, CodecImage *image, CodecMetadata *metadata, int8_t *eos, CodecError *error) \{\par
00162     Context *context = (Context *)c;\par
00163     {\cf19 if} (error)\par
00164         *error = 0;\par
00165 \par
00166     {\cf19 switch} (context->state_) \{\par
00167     {\cf19 case} StatePushing:\par
00168         {\cf20 // Still accumulating input stream}\par
00169         *eos = 0;\par
00170         {\cf19 return} 0;\par
00171 \par
00172     {\cf19 case} StateDecoding:\par
00173         context->decoder_thread_ = std::thread([context] \{\par
00174             context->flush();\par
00175             context->decoded_images_.push({\cf17 nullptr});\par
00176         \});\par
00177 \par
00178         context->state_ = StateFlushing;\par
00179         {\cf20 /* Fall through */}\par
00180 \par
00181     {\cf19 case} StateFlushing:\par
00182         context->decoded_images_.pop(context->decoded_image_);\par
00183         {\cf19 if} (context->decoded_image_) \{\par
00184             *image = context->decoded_image_->image_;\par
00185             *eos = 0;\par
00186             {\cf19 return} 1;\par
00187         \} {\cf19 else} \{\par
00188             {\cf19 if} (context->decoder_thread_.joinable())\par
00189                 context->decoder_thread_.join();\par
00190             *eos = 1;\par
00191             {\cf19 return} 0;\par
00192         \}\par
00193     {\cf19 default}:\par
00194         ERR({\cf22 "Unexpected decoder state"});\par
00195     \}\par
00196 \par
00197     {\cf19 return} 0;\par
00198 \}\par
