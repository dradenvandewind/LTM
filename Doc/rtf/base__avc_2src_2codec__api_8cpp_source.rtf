00250 {\cf18 void} Context::decode_enhanced_frames(DecodedPicList *pic, {\cf18 bool} all_frames) \{\par
00251     {\cf20 // Check picture and plane pointers - valid flag seems to be wrong sometimes!?}\par
00252     {\cf19 if} (!pic || !pic->pY || !pic->pU || !pic->pV) \{\par
00253         {\cf19 return};\par
00254     \}\par
00255 \par
00256     {\cf19 if} (!pic->bValid) \{\par
00257         INFO({\cf22 "Picture not marked valid?"});\par
00258     \}\par
00259 \par
00260     {\cf19 do} \{\par
00261         {\cf17 auto} output_image = std::shared_ptr<DecodedImage>({\cf17 new} DecodedImage());\par
00262 \par
00263         output_image->image_.bpp = ((pic->iBitDepth + 7) >> 3);\par
00264         output_image->image_.width_y = pic->iWidth;\par
00265         output_image->image_.height_y = pic->iHeight;\par
00266         output_image->image_.stride_y = pic->iYBufStride;\par
00267 \par
00268         output_image->image_.width_uv = (pic->iYUVFormat != YUV444) ? (pic->iWidth / 2) : pic->iWidth;\par
00269         output_image->image_.height_uv = (pic->iYUVFormat == YUV420) ? (pic->iHeight / 2) : pic->iHeight;\par
00270         output_image->image_.stride_uv = pic->iUVBufStride;\par
00271 \par
00272         {\cf17 const} {\cf18 size_t} plane_size_y = output_image->image_.height_y * output_image->image_.stride_y;\par
00273         {\cf17 const} {\cf18 size_t} plane_size_uv = output_image->image_.height_uv * output_image->image_.stride_uv;\par
00274 \par
00275         output_image->buffer_.reserve(plane_size_y + 2 * plane_size_uv);\par
00276 \par
00277         memcpy(output_image->buffer_.data(), pic->pY, plane_size_y);\par
00278         memcpy(output_image->buffer_.data() + plane_size_y, pic->pU, plane_size_uv);\par
00279         memcpy(output_image->buffer_.data() + plane_size_y + plane_size_uv, pic->pV, plane_size_uv);\par
00280 \par
00281         output_image->image_.data_y = output_image->buffer_.data();\par
00282         output_image->image_.data_u = output_image->image_.data_y + plane_size_y;\par
00283         output_image->image_.data_v = output_image->image_.data_u + plane_size_uv;\par
00284 \par
00285         decoded_images_.push(output_image);\par
00286         {\cf20 // Mark as used and move to next}\par
00287         pic->bValid = 0;\par
00288         pic = pic->pNext;\par
00289     \} {\cf19 while} (pic != NULL && pic->bValid && all_frames);\par
00290 \}\par
