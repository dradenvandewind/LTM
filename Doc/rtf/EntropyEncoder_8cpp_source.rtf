00450 {\cf17 public}:\par
00451     EntropyModelSizes() \{\}\par
00452 \par
00453     {\cf18 void} encode_size(uint16_t value);\par
00454     {\cf18 void} encode_size_delta(int32_t value);\par
00455     EncodedChunk finish();\par
00456 \par
00457 {\cf17 private}:\par
00458     {\cf18 void} encode_symbol(State state, {\cf18 unsigned} symbol);\par
00459 \par
00460     HuffmanEncoderBuilder huffman_state_[STATE_COUNT];\par
00461 \par
00462     {\cf17 struct }RleSymbol \{\par
00463         RleSymbol() = {\cf19 default};\par
