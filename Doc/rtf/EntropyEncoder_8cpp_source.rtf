00522 EncodedChunk EntropyEncoderSizes::process({\cf17 const} Surface &surface, {\cf17 const} std::vector<bool> entropy_enabled, {\cf17 const} {\cf18 unsigned} tile_idx,\par
00523                                           CompressionType compression_type) \{\par
00524     {\cf17 auto} view = surface.view_as<uint16_t>();\par
00525     {\cf17 const} {\cf18 unsigned} width = view.width();\par
00526     {\cf17 const} {\cf18 unsigned} height = view.height();\par
00527 \par
00528     EntropyModelSizes models;\par
00529 \par
00530     {\cf19 if} (compression_type == CompressionType_Prefix) \{\par
00531         {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
00532             {\cf19 for} ({\cf18 unsigned} x = 0; x < width; ++x) \{\par
00533                 {\cf19 if} (entropy_enabled[tile_idx + x]) \{\par
00534                     {\cf17 const} uint16_t v = view.read(x, y);\par
00535                     CHECK(v != 0);\par
00536                     models.encode_size(v);\par
00537                 \}\par
00538             \}\par
00539         \}\par
00540     \} {\cf19 else} \{\par
00541         uint16_t p = 0;\par
00542         {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
00543             {\cf19 for} ({\cf18 unsigned} x = 0; x < width; ++x) \{\par
00544                 {\cf19 if} (entropy_enabled[tile_idx + x]) \{\par
00545                     {\cf17 const} uint16_t v = view.read(x, y);\par
00546                     CHECK(v != 0);\par
00547                     models.encode_size_delta(v - p);\par
00548                     p = v;\par
00549                 \}\par
00550             \}\par
00551         \}\par
00552     \}\par
00553 \par
00554     {\cf19 return} models.finish();\par
00555 \}\par
