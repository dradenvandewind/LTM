00052 {\cf20 //}\par
00053 {\cf17 class }EntropyModelResiduals \{\par
00054     {\cf20 // State of the residual RLE modelling - used to select between 3 huffman trees}\par
00055     {\cf17 enum} State \{ STATE_LSB, STATE_MSB, STATE_ZERO, STATE_COUNT \};\par
00056 \par
00057 {\cf17 public}:\par
00058     EntropyModelResiduals() \{\}\par
00059 \par
00060     {\cf18 void} encode_high_count(State state, {\cf18 unsigned} symbol);\par
00061     {\cf18 void} encode_run(int16_t residual, {\cf18 unsigned} zeros);\par
00062     EncodedChunk finish();\par
00063 \par
00064 {\cf17 private}:\par
00065     {\cf18 void} encode_symbol(State state, {\cf18 unsigned} symbol);\par
00066 \par
00067     HuffmanEncoderBuilder huffman_state_[STATE_COUNT];\par
00068 \par
00069     {\cf17 struct }RleSymbol \{\par
00070         RleSymbol() = {\cf19 default};\par
00071         RleSymbol(State st, uint8_t sy) : state(st), symbol(sy) \{\}\par
00072         State state = STATE_LSB;\par
00073         uint8_t symbol = 0;\par
00074     \};\par
00075 \par
00076     std::vector<RleSymbol> rle_symbols_;\par
00077 \};\par
00078 \par
00079 {\cf18 void} EntropyModelResiduals::encode_symbol(State state, {\cf18 unsigned} symbol) \{\par
00080     rle_symbols_.emplace_back(state, symbol);\par
00081     huffman_state_[state].add_symbol(symbol, 1);\par
00082 \}\par
00083 \par
00084 {\cf18 void} EntropyModelResiduals::encode_high_count(State s, {\cf18 unsigned} c) \{\par
00085     {\cf19 if} (c > 0x7f)\par
00086         encode_high_count(s, c >> 7);\par
00087     encode_symbol(s, (c & 0x7f) | 0x80);\par
00088 \}\par
00089 \par
00090 {\cf18 void} EntropyModelResiduals::encode_run(int16_t residual, {\cf18 unsigned} zeros) \{\par
00091     {\cf20 // Is there a run?}\par
00092     {\cf17 const} uint16_t zeros_bit = (zeros > 0) ? 0x80 : 0;\par
00093 \par
00094     {\cf20 // Encode value}\par
00095     {\cf19 if} (residual >= -32 && residual < 32) \{\par
00096         encode_symbol(STATE_LSB, (residual * 2 + 0x40) | zeros_bit);\par
00097     \} {\cf19 else} \{\par
00098         {\cf17 const} uint16_t clamped_residual = std::min(std::max(residual + 0x2000, 0), 0x3fff) << 1;\par
00099         encode_symbol(STATE_LSB, (clamped_residual & 0xfe) | 0x01);\par
00100         encode_symbol(STATE_MSB, ((clamped_residual >> 8) & 0x7f) | zeros_bit);\par
00101     \}\par
00102 \par
00103     {\cf20 // Add any required run symbols}\par
00104     {\cf20 // LSByte first}\par
00105 {\cf20     /***}\par
00106 {\cf20     while (zeros) \{}\par
00107 {\cf20         const uint8_t low_bits = zeros & 0x7f;}\par
00108 {\cf20         zeros >>= 7;}\par
00109 {\cf20 }\par
00110 {\cf20         if (zeros)}\par
00111 {\cf20             encode_symbol(STATE_ZERO, low_bits | 0x80);}\par
00112 {\cf20         else}\par
00113 {\cf20             encode_symbol(STATE_ZERO, low_bits);}\par
00114 {\cf20     \}}\par
00115 {\cf20     ***/}\par
00116     {\cf20 // MSByte first}\par
00117     {\cf20 /***/}\par
00118     {\cf19 if} (zeros_bit) \{\par
00119         {\cf19 if} (zeros > 0x7f)\par
00120             encode_high_count(STATE_ZERO, zeros >> 7);\par
00121         encode_symbol(STATE_ZERO, zeros & 0x7f);\par
00122     \}\par
00123     {\cf20 /***/}\par
00124 \}\par
00125 \par
00126 EncodedChunk EntropyModelResiduals::finish() \{\par
00127     {\cf20 // Generate huffman encoders}\par
00128     std::vector<HuffmanEncoder> huffman_encoders;\par
00129 \par
00130     BitstreamPacker raw_packer;\par
00131     BitstreamPacker huffman_packer;\par
00132 \par
00133     {\cf20 // Finialise huffman encoders state}\par
00134     {\cf19 for} ({\cf18 unsigned} h = 0; h < STATE_COUNT; ++h) \{\par
00135         huffman_encoders.emplace_back(huffman_state_[h].finish());\par
00136         huffman_encoders.back().write_codes(huffman_packer);\par
00137     \}\par
00138 \par
00139     {\cf20 // Code symbols both ways: raw vs. prefix}\par
00140     {\cf19 for} ({\cf17 const} {\cf17 auto} s : rle_symbols_) \{\par
00141         raw_packer.u(8, s.symbol);\par
00142         huffman_encoders[s.state].write_symbol(huffman_packer, s.symbol);\par
00143     \}\par
00144 \par
00145     {\cf19 return} EncodedChunk(raw_packer.finish(), huffman_packer.finish());\par
00146 \}\par
00147 \par
00148 EncodedChunk EntropyEncoderResiduals::process({\cf17 const} Surface &surface) \{\par
00149     {\cf17 auto} view = surface.view_as<int16_t>();\par
00150     {\cf17 const} {\cf18 unsigned} width = view.width();\par
00151     {\cf17 const} {\cf18 unsigned} height = view.height();\par
00152 \par
00153     EntropyModelResiduals models;\par
00154 \par
00155     int16_t residual = 0;\par
00156     {\cf18 unsigned} zeros = 0;\par
00157 \par
00158     {\cf18 bool} has_entropy = {\cf17 false};\par
00159 \par
00160     {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
