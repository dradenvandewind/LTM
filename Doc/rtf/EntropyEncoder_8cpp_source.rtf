00334 EncodedChunk EntropyEncoderTemporal::process({\cf17 const} Surface &surface, {\cf18 unsigned} transform_block_size, {\cf18 bool} use_reduced_signalling) \{\par
00335     {\cf17 auto} view = surface.view_as<uint8_t>();\par
00336     {\cf17 const} {\cf18 unsigned} width = view.width();\par
00337     {\cf17 const} {\cf18 unsigned} height = view.height();\par
00338 \par
00339     EntropyModelRleFlag models;\par
00340 \par
00341     {\cf20 // Divisor for block->tiles}\par
00342     {\cf17 const} {\cf18 unsigned} d = 32 / transform_block_size;\par
00343 \par
00344     {\cf20 // RLE state}\par
00345     {\cf18 bool} start = 0;\par
00346     {\cf18 bool} value = 0;\par
00347     {\cf18 unsigned} count = 0;\par
00348 \par
00349     {\cf18 bool} has_entropy = {\cf17 false};\par
00350 \par
00351     {\cf20 // For each tile (including any part tiles) ...}\par
00352     {\cf19 for} ({\cf18 unsigned} ty = 0; ty < height; ty += d) \{\par
00353         {\cf19 for} ({\cf18 unsigned} tx = 0; tx < width; tx += d) \{\par
00354 \par
00355             {\cf18 bool} intra_tile = {\cf17 false};\par
00356 \par
00357             {\cf20 // For each transform in tile ...}\par
00358             {\cf19 for} ({\cf18 unsigned} y = ty; y < std::min(ty + d, height); ++y) \{\par
00359                 {\cf19 for} ({\cf18 unsigned} x = tx; x < std::min(tx + d, width); ++x) \{\par
00360                     {\cf17 const} {\cf18 bool} first_transform_in_tile = (tx == x) && (ty == y);\par
00361                     {\cf17 const} {\cf18 bool} v = (view.read(x, y) == TemporalType::TEMPORAL_INTR) ? 1 : 0;\par
00362 \par
00363                     {\cf20 // Record if there is any data in surface}\par
00364                     {\cf19 if} (v)\par
00365                         has_entropy = {\cf17 true};\par
00366 \par
00367                     {\cf20 // Record intra flag for whole tile}\par
00368                     {\cf19 if} (use_reduced_signalling && first_transform_in_tile && v != 0)\par
00369                         intra_tile = {\cf17 true};\par
00370 \par
00371                     {\cf20 // Reduced signalling - don't encode rest of tile if first is intra}\par
00372                     {\cf19 if} (!first_transform_in_tile && use_reduced_signalling && intra_tile)\par
00373                         {\cf19 continue};\par
00374 \par
00375                     {\cf19 if} (x == 0 && y == 0) \{\par
00376                         {\cf20 // Special case - store first symbol}\par
00377                         start = value = v;\par
00378                         count = 1;\par
00379                     \} {\cf19 else} {\cf19 if} (v == value) \{\par
00380                         {\cf20 // Extend run}\par
00381                         ++count;\par
00382                     \} {\cf19 else} \{\par
00383                         {\cf20 // Encode run}\par
00384                         models.encode_run(value, count);\par
00385                         value = v;\par
00386                         count = 1;\par
00387                     \}\par
00388                 \}\par
00389             \}\par
00390         \}\par
00391     \}\par
00392 \par
00393     {\cf20 // Emit last run}\par
00394     models.encode_run(value, count);\par
00395 \par
00396     {\cf19 if} (has_entropy)\par
00397         {\cf19 return} models.finish(start);\par
00398     {\cf19 else}\par
00399         {\cf19 return} EncodedChunk();\par
00400 \}\par
