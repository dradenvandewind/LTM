00472 {\cf18 void} EntropyModelSizes::encode_symbol(State state, {\cf18 unsigned} symbol) \{\par
00473     rle_symbols_.emplace_back(state, symbol);\par
00474     huffman_state_[state].add_symbol(symbol, 1);\par
00475 \}\par
00476 \par
00477 {\cf18 void} EntropyModelSizes::encode_size(uint16_t value) \{\par
00478     CHECK(value <= 32767);\par
00479 \par
00480     {\cf19 if} (value < 0x80) \{\par
00481         encode_symbol(STATE_LSB, (value * 2) | 0x00);\par
00482     \} {\cf19 else} \{\par
00483         encode_symbol(STATE_LSB, ((value & 0x7f) * 2) | 0x01);\par
00484         encode_symbol(STATE_MSB, value >> 7);\par
00485     \}\par
00486 \}\par
00487 \par
00488 {\cf18 void} EntropyModelSizes::encode_size_delta(int32_t value) \{\par
00489     CHECK(value >= -16384 && value <= 16383);\par
00490 \par
00491     {\cf20 // Decoder will sign extend}\par
00492     {\cf19 if} (value >= -64 && value <= 63) \{\par
00493         encode_symbol(STATE_LSB, ((value * 2) | 0x00) & 0xff);\par
00494     \} {\cf19 else} \{\par
00495         encode_symbol(STATE_LSB, ((value & 0x7f) * 2) | 0x01);\par
00496         encode_symbol(STATE_MSB, (value >> 7) & 0xff);\par
00497     \}\par
00498 \}\par
