00259 {\cf20 // Encode a mask of 0,1 runs using two models}\par
00260 {\cf20 //}\par
00261 {\cf17 class }EntropyModelRleFlag \{\par
00262     {\cf20 // State of the RLE parser - used to select between 2 huffman trees (0.., 1..)}\par
00263     {\cf17 enum} State \{ STATE_ZERO_RUN, STATE_ONE_RUN, STATE_COUNT \};\par
00264 \par
00265 {\cf17 public}:\par
00266     EntropyModelRleFlag() \{\}\par
00267 \par
00268     {\cf18 void} encode_high_count(State s, {\cf18 unsigned} c);\par
00269     {\cf18 void} encode_run({\cf18 bool} value, {\cf18 unsigned} count);\par
00270     EncodedChunk finish({\cf18 bool} start_value);\par
00271 \par
00272 {\cf17 private}:\par
00273     {\cf18 void} encode_symbol(State state, {\cf18 unsigned} symbol);\par
00274 \par
00275     HuffmanEncoderBuilder huffman_state_[STATE_COUNT];\par
00276 \par
00277     {\cf17 struct }RleSymbol \{\par
00278         RleSymbol() = {\cf19 default};\par
00279         RleSymbol(State st, uint8_t sy) : state(st), symbol(sy) \{\}\par
00280         State state = STATE_ZERO_RUN;\par
00281         uint8_t symbol = 0;\par
00282     \};\par
00283 \par
00284     std::vector<RleSymbol> rle_symbols_;\par
00285 \};\par
00286 \par
00287 {\cf18 void} EntropyModelRleFlag::encode_symbol(State state, {\cf18 unsigned} symbol) \{\par
00288     rle_symbols_.emplace_back(state, symbol);\par
00289     huffman_state_[state].add_symbol(symbol, 1);\par
00290 \}\par
00291 \par
00292 {\cf18 void} EntropyModelRleFlag::encode_high_count(State s, {\cf18 unsigned} c) \{\par
00293     {\cf19 if} (c > 0x7f)\par
00294         encode_high_count(s, c >> 7);\par
00295     encode_symbol(s, (c & 0x7f) | 0x80);\par
00296 \}\par
00297 \par
00298 {\cf18 void} EntropyModelRleFlag::encode_run({\cf18 bool} value, {\cf18 unsigned} count) \{\par
00299 \par
00300     {\cf17 const} State s = value ? STATE_ONE_RUN : STATE_ZERO_RUN;\par
00301 \par
00302     {\cf19 if} (count > 0x7f)\par
00303         encode_high_count(s, count >> 7);\par
00304     encode_symbol(s, count & 0x7f);\par
00305 \}\par
00306 \par
00307 EncodedChunk EntropyModelRleFlag::finish({\cf18 bool} start_value) \{\par
00308 \par
00309     {\cf20 // Generate huffman encoders}\par
00310     std::vector<HuffmanEncoder> huffman_encoders;\par
00311 \par
00312     BitstreamPacker raw_packer;\par
00313     BitstreamPacker huffman_packer;\par
00314 \par
00315     {\cf20 // Finialise huffman encoders state}\par
00316     {\cf19 for} ({\cf18 unsigned} h = 0; h < STATE_COUNT; ++h) \{\par
00317         huffman_encoders.emplace_back(huffman_state_[h].finish());\par
00318         huffman_encoders.back().write_codes(huffman_packer);\par
00319     \}\par
00320 \par
00321     {\cf20 // Add starting value to each bitstream}\par
00322     raw_packer.u(8, start_value ? 1 : 0);\par
00323     huffman_packer.u(8, start_value ? 1 : 0);\par
00324 \par
00325     {\cf20 // Code symbols both ways: raw vs. prefix}\par
00326     {\cf19 for} ({\cf17 const} {\cf17 auto} s : rle_symbols_) \{\par
00327         raw_packer.u(8, s.symbol);\par
00328         huffman_encoders[s.state].write_symbol(huffman_packer, s.symbol);\par
00329     \}\par
00330 \par
00331     {\cf19 return} EncodedChunk(raw_packer.finish(), huffman_packer.finish());\par
00332 \}\par
