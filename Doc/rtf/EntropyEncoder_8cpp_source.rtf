00505     BitstreamPacker huffman_packer;\par
00506 \par
00507     {\cf20 // Finialise huffman encoders state}\par
00508     {\cf19 for} ({\cf18 unsigned} h = 0; h < STATE_COUNT; ++h) \{\par
00509         huffman_encoders.emplace_back(huffman_state_[h].finish());\par
00510         huffman_encoders.back().write_codes(huffman_packer);\par
00511     \}\par
00512 \par
00513     {\cf20 // Code symbols both ways: raw vs. prefix}\par
00514     {\cf19 for} ({\cf17 const} {\cf17 auto} s : rle_symbols_) \{\par
00515         raw_packer.u(8, s.symbol);\par
00516         huffman_encoders[s.state].write_symbol(huffman_packer, s.symbol);\par
00517     \}\par
00518 \par
00519     {\cf19 return} EncodedChunk(raw_packer.finish(), huffman_packer.finish());\par
00520 \}\par
