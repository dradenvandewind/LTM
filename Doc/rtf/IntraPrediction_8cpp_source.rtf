01327 {\cf20 // LumaRecPixels}\par
01328 {\cf18 void} IntraPrediction::xGetLumaRecPixels({\cf17 const} PredictionUnit &pu, CompArea chromaArea)\par
01329 \{\par
01330   {\cf18 int} iDstStride = 0;\par
01331   Pel* pDst0 = 0;\par
01332   {\cf18 int} curChromaMode = pu.intraDir[1];\par
01333   {\cf19 if} ((curChromaMode == MDLM_L_IDX) || (curChromaMode == MDLM_T_IDX))\par
01334   \{\par
01335     iDstStride = 2 * MAX_CU_SIZE + 1;\par
01336     pDst0 = m_pMdlmTemp + iDstStride + 1;\par
01337   \}\par
01338   {\cf19 else}\par
01339   \{\par
01340     iDstStride = MAX_CU_SIZE + 1;\par
01341     pDst0 = m_piTemp + iDstStride + 1; {\cf20 //MMLM_SAMPLE_NEIGHBOR_LINES;}\par
01342   \}\par
01343   {\cf20 //assert 420 chroma subsampling}\par
01344   CompArea lumaArea = CompArea( COMPONENT_Y, pu.chromaFormat, chromaArea.lumaPos(), recalcSize( pu.chromaFormat, CHANNEL_TYPE_CHROMA, CHANNEL_TYPE_LUMA, chromaArea.size() ) );{\cf20 //needed for correct pos/size (4x4 Tus)}\par
01345 \par
01346   CHECK(lumaArea.width == chromaArea.width && CHROMA_444 != pu.chromaFormat, {\cf22 ""});\par
01347   CHECK(lumaArea.height == chromaArea.height && CHROMA_444 != pu.chromaFormat && CHROMA_422 != pu.chromaFormat, {\cf22 ""});\par
01348 \par
01349   {\cf17 const} SizeType uiCWidth = chromaArea.width;\par
01350   {\cf17 const} SizeType uiCHeight = chromaArea.height;\par
01351 \par
01352   {\cf17 const} CPelBuf Src = pu.cs->picture->getRecoBuf( lumaArea );\par
01353   Pel {\cf17 const}* pRecSrc0   = Src.bufAt( 0, 0 );\par
01354   {\cf18 int} iRecStride        = Src.stride;\par
01355   {\cf18 int} logSubWidthC  = getChannelTypeScaleX(CHANNEL_TYPE_CHROMA, pu.chromaFormat);\par
01356   {\cf18 int} logSubHeightC = getChannelTypeScaleY(CHANNEL_TYPE_CHROMA, pu.chromaFormat);\par
01357 \par
01358   {\cf18 int} iRecStride2       = iRecStride << logSubHeightC;\par
01359 \par
01360   {\cf17 const} CodingUnit& lumaCU = isChroma( pu.chType ) ? *pu.cs->picture->cs->getCU( lumaArea.pos(), CH_L ) : *pu.cu;\par
01361   {\cf17 const} CodingUnit&     cu = *pu.cu;\par
01362 \par
01363   {\cf17 const} CompArea& area = isChroma( pu.chType ) ? chromaArea : lumaArea;\par
01364 \par
01365   {\cf17 const} uint32_t uiTuWidth  = area.width;\par
01366   {\cf17 const} uint32_t uiTuHeight = area.height;\par
01367 \par
01368   {\cf18 int} iBaseUnitSize = ( 1 << MIN_CU_LOG2 );\par
01369 \par
01370   {\cf17 const} {\cf18 int}  iUnitWidth       = iBaseUnitSize >> getComponentScaleX( area.compID, area.chromaFormat );\par
01371   {\cf17 const} {\cf18 int}  iUnitHeight = iBaseUnitSize >> getComponentScaleY(area.compID, area.chromaFormat);\par
01372 \par
01373   {\cf17 const} {\cf18 int}  iTUWidthInUnits = uiTuWidth / iUnitWidth;\par
01374   {\cf17 const} {\cf18 int}  iTUHeightInUnits = uiTuHeight / iUnitHeight;\par
01375   {\cf17 const} {\cf18 int}  iAboveUnits      = iTUWidthInUnits;\par
01376   {\cf17 const} {\cf18 int}  iLeftUnits       = iTUHeightInUnits;\par
01377   {\cf17 const} {\cf18 int}  chromaUnitWidth = iBaseUnitSize >> getComponentScaleX(COMPONENT_Cb, area.chromaFormat);\par
01378   {\cf17 const} {\cf18 int}  chromaUnitHeight = iBaseUnitSize >> getComponentScaleY(COMPONENT_Cb, area.chromaFormat);\par
01379   {\cf17 const} {\cf18 int}  topTemplateSampNum = 2 * uiCWidth; {\cf20 // for MDLM, the number of template samples is 2W or 2H.}\par
01380   {\cf17 const} {\cf18 int}  leftTemplateSampNum = 2 * uiCHeight;\par
01381   assert(m_topRefLength >= topTemplateSampNum);\par
01382   assert(m_leftRefLength >= leftTemplateSampNum);\par
01383   {\cf17 const} {\cf18 int}  totalAboveUnits = (topTemplateSampNum + (chromaUnitWidth - 1)) / chromaUnitWidth;\par
01384   {\cf17 const} {\cf18 int}  totalLeftUnits = (leftTemplateSampNum + (chromaUnitHeight - 1)) / chromaUnitHeight;\par
01385   {\cf17 const} {\cf18 int}  totalUnits = totalLeftUnits + totalAboveUnits + 1;\par
01386   {\cf17 const} {\cf18 int}  aboveRightUnits = totalAboveUnits - iAboveUnits;\par
01387   {\cf17 const} {\cf18 int}  leftBelowUnits = totalLeftUnits - iLeftUnits;\par
01388 \par
01389   {\cf18 int} avaiAboveRightUnits = 0;\par
01390   {\cf18 int} avaiLeftBelowUnits = 0;\par
01391   {\cf18 bool}  bNeighborFlags[4 * MAX_NUM_PART_IDXS_IN_CTU_WIDTH + 1];\par
01392   memset(bNeighborFlags, 0, totalUnits);\par
01393   {\cf18 bool} aboveIsAvailable, leftIsAvailable;\par
01394 \par
01395   {\cf18 int} availlableUnit = isLeftAvailable(isChroma(pu.chType) ? cu : lumaCU, toChannelType(area.compID), area.pos(),\par
01396                                        iLeftUnits, iUnitHeight, (bNeighborFlags + iLeftUnits + leftBelowUnits - 1));\par
01397 \par
01398   leftIsAvailable = availlableUnit == iTUHeightInUnits;\par
01399 \par
01400   availlableUnit = isAboveAvailable(isChroma(pu.chType) ? cu : lumaCU, toChannelType(area.compID), area.pos(),\par
01401                                     iAboveUnits, iUnitWidth, (bNeighborFlags + iLeftUnits + leftBelowUnits + 1));\par
01402 \par
01403   aboveIsAvailable = availlableUnit == iTUWidthInUnits;\par
01404 \par
01405   {\cf19 if} (leftIsAvailable)   {\cf20 // if left is not available, then the below left is not available}\par
01406   \{\par
01407     avaiLeftBelowUnits = isBelowLeftAvailable(isChroma(pu.chType) ? cu : lumaCU, toChannelType(area.compID), area.bottomLeftComp(area.compID), leftBelowUnits, iUnitHeight, (bNeighborFlags + leftBelowUnits - 1));\par
01408   \}\par
01409 \par
01410   {\cf19 if} (aboveIsAvailable)   {\cf20 // if above is not available, then  the above right is not available.}\par
01411   \{\par
01412     avaiAboveRightUnits = isAboveRightAvailable(isChroma(pu.chType) ? cu : lumaCU, toChannelType(area.compID), area.topRightComp(area.compID), aboveRightUnits, iUnitWidth, (bNeighborFlags + iLeftUnits + leftBelowUnits + iAboveUnits + 1));\par
01413   \}\par
01414 \par
01415   Pel*       pDst  = {\cf17 nullptr};\par
01416   Pel {\cf17 const}* piSrc = {\cf17 nullptr};\par
01417 \par
01418   {\cf18 bool} isFirstRowOfCtu = (lumaArea.y & ((pu.cs->sps)->getCTUSize() - 1)) == 0;\par
01419 \par
01420   {\cf19 if} (aboveIsAvailable)\par
01421   \{\par
01422     pDst  = pDst0    - iDstStride;\par
01423     {\cf18 int} addedAboveRight = 0;\par
01424     {\cf19 if} ((curChromaMode == MDLM_L_IDX) || (curChromaMode == MDLM_T_IDX))\par
01425     \{\par
01426       addedAboveRight = avaiAboveRightUnits*chromaUnitWidth;\par
01427     \}\par
01428     {\cf19 for} ({\cf18 int} i = 0; i < uiCWidth + addedAboveRight; i++)\par
01429     \{\par
01430       {\cf17 const} {\cf18 bool} leftPadding = i == 0 && !leftIsAvailable;\par
01431       {\cf19 if} (pu.chromaFormat == CHROMA_444)\par
01432       \{\par
01433         piSrc = pRecSrc0 - iRecStride;\par
01434         pDst[i] = piSrc[i];\par
01435       \}\par
01436       {\cf19 else} {\cf19 if} (isFirstRowOfCtu)\par
01437       \{\par
01438         piSrc   = pRecSrc0 - iRecStride;\par
01439         pDst[i] = (piSrc[2 * i] * 2 + piSrc[2 * i - (leftPadding ? 0 : 1)] + piSrc[2 * i + 1] + 2) >> 2;\par
01440       \}\par
01441       {\cf19 else} {\cf19 if} (pu.chromaFormat == CHROMA_422)\par
01442       \{\par
01443         piSrc = pRecSrc0 - iRecStride2;\par
01444 \par
01445         {\cf18 int} s = 2;\par
01446         s += piSrc[2 * i] * 2;\par
01447         s += piSrc[2 * i - (leftPadding ? 0 : 1)];\par
01448         s += piSrc[2 * i + 1];\par
01449         pDst[i] = s >> 2;\par
01450       \}\par
01451       {\cf19 else} {\cf19 if} (pu.cs->sps->getCclmCollocatedChromaFlag())\par
01452       \{\par
01453         piSrc = pRecSrc0 - iRecStride2;\par
01454 \par
01455         {\cf18 int} s = 4;\par
01456         s += piSrc[2 * i - iRecStride];\par
01457         s += piSrc[2 * i] * 4;\par
01458         s += piSrc[2 * i - (leftPadding ? 0 : 1)];\par
01459         s += piSrc[2 * i + 1];\par
01460         s += piSrc[2 * i + iRecStride];\par
01461         pDst[i] = s >> 3;\par
01462       \}\par
01463       {\cf19 else}\par
01464       \{\par
01465         piSrc = pRecSrc0 - iRecStride2;\par
01466         {\cf18 int} s = 4;\par
01467         s += piSrc[2 * i] * 2;\par
01468         s += piSrc[2 * i + 1];\par
01469         s += piSrc[2 * i - (leftPadding ? 0 : 1)];\par
01470         s += piSrc[2 * i + iRecStride] * 2;\par
01471         s += piSrc[2 * i + 1 + iRecStride];\par
01472         s += piSrc[2 * i + iRecStride - (leftPadding ? 0 : 1)];\par
01473         pDst[i] = s >> 3;\par
01474       \}\par
01475     \}\par
01476   \}\par
01477 \par
01478   {\cf19 if} (leftIsAvailable)\par
01479   \{\par
01480     pDst  = pDst0    - 1;\par
01481     piSrc = pRecSrc0 - 1 - logSubWidthC;\par
01482 \par
01483     {\cf18 int} addedLeftBelow = 0;\par
01484     {\cf19 if} ((curChromaMode == MDLM_L_IDX) || (curChromaMode == MDLM_T_IDX))\par
01485     \{\par
01486       addedLeftBelow = avaiLeftBelowUnits*chromaUnitHeight;\par
01487     \}\par
01488 \par
01489     {\cf19 for} ({\cf18 int} j = 0; j < uiCHeight + addedLeftBelow; j++)\par
01490     \{\par
01491       {\cf19 if} (pu.chromaFormat == CHROMA_444)\par
01492       \{\par
01493         pDst[0] = piSrc[0];\par
01494       \}\par
01495       {\cf19 else} {\cf19 if} (pu.chromaFormat == CHROMA_422)\par
01496       \{\par
01497         {\cf18 int} s = 2;\par
01498         s += piSrc[0] * 2;\par
01499         s += piSrc[-1];\par
01500         s += piSrc[1];\par
01501         pDst[0] = s >> 2;\par
01502       \}\par
01503       {\cf19 else} {\cf19 if} (pu.cs->sps->getCclmCollocatedChromaFlag())\par
01504       \{\par
01505         {\cf17 const} {\cf18 bool} abovePadding = j == 0 && !aboveIsAvailable;\par
01506 \par
01507         {\cf18 int} s = 4;\par
01508         s += piSrc[-(abovePadding ? 0 : iRecStride)];\par
01509         s += piSrc[0] * 4;\par
01510         s += piSrc[-1];\par
01511         s += piSrc[1];\par
01512         s += piSrc[iRecStride];\par
01513         pDst[0] = s >> 3;\par
01514       \}\par
01515       {\cf19 else}\par
01516       \{\par
01517         {\cf18 int} s = 4;\par
01518         s += piSrc[0] * 2;\par
01519         s += piSrc[1];\par
01520         s += piSrc[-1];\par
01521         s += piSrc[iRecStride] * 2;\par
01522         s += piSrc[iRecStride + 1];\par
01523         s += piSrc[iRecStride - 1];\par
01524         pDst[0] = s >> 3;\par
01525       \}\par
01526 \par
01527       piSrc += iRecStride2;\par
01528       pDst  += iDstStride;\par
01529     \}\par
01530   \}\par
01531 \par
01532   {\cf20 // inner part from reconstructed picture buffer}\par
01533   {\cf19 for}( {\cf18 int} j = 0; j < uiCHeight; j++ )\par
01534   \{\par
01535     {\cf19 for}( {\cf18 int} i = 0; i < uiCWidth; i++ )\par
01536     \{\par
01537       {\cf19 if} (pu.chromaFormat == CHROMA_444)\par
01538       \{\par
01539         pDst0[i] = pRecSrc0[i];\par
01540       \}\par
01541       {\cf19 else} {\cf19 if} (pu.chromaFormat == CHROMA_422)\par
01542       \{\par
01543         {\cf17 const} {\cf18 bool} leftPadding  = i == 0 && !leftIsAvailable;\par
01544 \par
01545         {\cf18 int} s = 2;\par
01546         s += pRecSrc0[2 * i] * 2;\par
01547         s += pRecSrc0[2 * i - (leftPadding ? 0 : 1)];\par
01548         s += pRecSrc0[2 * i + 1];\par
01549         pDst0[i] = s >> 2;\par
01550       \}\par
01551       {\cf19 else} {\cf19 if} (pu.cs->sps->getCclmCollocatedChromaFlag())\par
01552       \{\par
01553         {\cf17 const} {\cf18 bool} leftPadding  = i == 0 && !leftIsAvailable;\par
01554         {\cf17 const} {\cf18 bool} abovePadding = j == 0 && !aboveIsAvailable;\par
01555 \par
01556         {\cf18 int} s = 4;\par
01557         s += pRecSrc0[2 * i - (abovePadding ? 0 : iRecStride)];\par
01558         s += pRecSrc0[2 * i] * 4;\par
01559         s += pRecSrc0[2 * i - (leftPadding ? 0 : 1)];\par
01560         s += pRecSrc0[2 * i + 1];\par
01561         s += pRecSrc0[2 * i + iRecStride];\par
01562         pDst0[i] = s >> 3;\par
01563       \}\par
01564       {\cf19 else}\par
01565       \{\par
01566         CHECK(pu.chromaFormat != CHROMA_420, {\cf22 "Chroma format must be 4:2:0 for vertical filtering"});\par
01567         {\cf17 const} {\cf18 bool} leftPadding = i == 0 && !leftIsAvailable;\par
01568 \par
01569         {\cf18 int} s = 4;\par
01570         s += pRecSrc0[2 * i] * 2;\par
01571         s += pRecSrc0[2 * i + 1];\par
01572         s += pRecSrc0[2 * i - (leftPadding ? 0 : 1)];\par
01573         s += pRecSrc0[2 * i + iRecStride] * 2;\par
01574         s += pRecSrc0[2 * i + 1 + iRecStride];\par
01575         s += pRecSrc0[2 * i + iRecStride - (leftPadding ? 0 : 1)];\par
01576         pDst0[i] = s >> 3;\par
01577       \}\par
01578     \}\par
01579 \par
01580     pDst0    += iDstStride;\par
01581     pRecSrc0 += iRecStride2;\par
01582   \}\par
01583 \}\par
01584 {\cf18 void} IntraPrediction::xGetLMParameters({\cf17 const} PredictionUnit &pu, {\cf17 const} ComponentID compID,\par
01585                                               {\cf17 const} CompArea &chromaArea,\par
01586                                               {\cf18 int} &a, {\cf18 int} &b, {\cf18 int} &iShift)\par
01587 \{\par
01588   CHECK(compID == COMPONENT_Y, {\cf22 ""});\par
01589 \par
01590   {\cf17 const} SizeType cWidth  = chromaArea.width;\par
01591   {\cf17 const} SizeType cHeight = chromaArea.height;\par
01592 \par
01593   {\cf17 const} Position posLT = chromaArea;\par
01594 \par
01595   CodingStructure & cs = *(pu.cs);\par
01596   {\cf17 const} CodingUnit &cu = *(pu.cu);\par
01597 \par
01598   {\cf17 const} SPS &        sps           = *cs.sps;\par
01599   {\cf17 const} uint32_t     tuWidth     = chromaArea.width;\par
01600   {\cf17 const} uint32_t     tuHeight    = chromaArea.height;\par
01601   {\cf17 const} ChromaFormat nChromaFormat = sps.getChromaFormatIdc();\par
01602 \par
01603   {\cf17 const} {\cf18 int} baseUnitSize = 1 << MIN_CU_LOG2;\par
01604   {\cf17 const} {\cf18 int} unitWidth    = baseUnitSize >> getComponentScaleX(chromaArea.compID, nChromaFormat);\par
01605   {\cf17 const} {\cf18 int} unitHeight   = baseUnitSize >> getComponentScaleY(chromaArea.compID, nChromaFormat);\par
01606 \par
01607   {\cf17 const} {\cf18 int} tuWidthInUnits  = tuWidth / unitWidth;\par
01608   {\cf17 const} {\cf18 int} tuHeightInUnits = tuHeight / unitHeight;\par
01609   {\cf17 const} {\cf18 int} aboveUnits      = tuWidthInUnits;\par
01610   {\cf17 const} {\cf18 int} leftUnits       = tuHeightInUnits;\par
01611   {\cf18 int} topTemplateSampNum = 2 * cWidth; {\cf20 // for MDLM, the template sample number is 2W or 2H;}\par
01612   {\cf18 int} leftTemplateSampNum = 2 * cHeight;\par
01613   assert(m_topRefLength >= topTemplateSampNum);\par
01614   assert(m_leftRefLength >= leftTemplateSampNum);\par
01615   {\cf18 int} totalAboveUnits = (topTemplateSampNum + (unitWidth - 1)) / unitWidth;\par
01616   {\cf18 int} totalLeftUnits = (leftTemplateSampNum + (unitHeight - 1)) / unitHeight;\par
01617   {\cf18 int} totalUnits = totalLeftUnits + totalAboveUnits + 1;\par
01618   {\cf18 int} aboveRightUnits = totalAboveUnits - aboveUnits;\par
01619   {\cf18 int} leftBelowUnits = totalLeftUnits - leftUnits;\par
01620   {\cf18 int} avaiAboveRightUnits = 0;\par
01621   {\cf18 int} avaiLeftBelowUnits = 0;\par
01622   {\cf18 int} avaiAboveUnits = 0;\par
01623   {\cf18 int} avaiLeftUnits = 0;\par
01624 \par
01625   {\cf18 int} curChromaMode = pu.intraDir[1];\par
01626   {\cf18 bool} neighborFlags[4 * MAX_NUM_PART_IDXS_IN_CTU_WIDTH + 1];\par
01627   memset(neighborFlags, 0, totalUnits);\par
01628 \par
01629   {\cf18 bool} aboveAvailable, leftAvailable;\par
01630 \par
01631   {\cf18 int} availableUnit =\par
01632     isAboveAvailable(cu, CHANNEL_TYPE_CHROMA, posLT, aboveUnits, unitWidth,\par
01633     (neighborFlags + leftUnits + leftBelowUnits + 1));\par
01634   aboveAvailable = availableUnit == tuWidthInUnits;\par
01635 \par
01636   availableUnit =\par
01637     isLeftAvailable(cu, CHANNEL_TYPE_CHROMA, posLT, leftUnits, unitHeight,\par
01638     (neighborFlags + leftUnits + leftBelowUnits - 1));\par
01639   leftAvailable = availableUnit == tuHeightInUnits;\par
01640   {\cf19 if} (leftAvailable) {\cf20 // if left is not available, then the below left is not available}\par
01641   \{\par
01642     avaiLeftUnits = tuHeightInUnits;\par
01643     avaiLeftBelowUnits = isBelowLeftAvailable(cu, CHANNEL_TYPE_CHROMA, chromaArea.bottomLeftComp(chromaArea.compID), leftBelowUnits, unitHeight, (neighborFlags + leftBelowUnits - 1));\par
01644   \}\par
01645   {\cf19 if} (aboveAvailable) {\cf20 // if above is not available, then  the above right is not available.}\par
01646   \{\par
01647     avaiAboveUnits = tuWidthInUnits;\par
01648     avaiAboveRightUnits = isAboveRightAvailable(cu, CHANNEL_TYPE_CHROMA, chromaArea.topRightComp(chromaArea.compID), aboveRightUnits, unitWidth, (neighborFlags + leftUnits + leftBelowUnits + aboveUnits + 1));\par
01649   \}\par
01650   Pel *srcColor0, *curChroma0;\par
01651   {\cf18 int} srcStride;\par
01652 \par
01653   PelBuf temp;\par
01654   {\cf19 if} ((curChromaMode == MDLM_L_IDX) || (curChromaMode == MDLM_T_IDX))\par
01655   \{\par
01656     srcStride = 2 * MAX_CU_SIZE + 1;\par
01657     temp = PelBuf(m_pMdlmTemp + srcStride + 1, srcStride, Size(chromaArea));\par
01658   \}\par
01659   {\cf19 else}\par
01660   \{\par
01661     srcStride = MAX_CU_SIZE + 1;\par
01662     temp        = PelBuf(m_piTemp + srcStride + 1, srcStride, Size(chromaArea));\par
01663   \}\par
01664   srcColor0 = temp.bufAt(0, 0);\par
01665   curChroma0 = getPredictorPtr(compID);\par
01666 \par
01667   {\cf18 unsigned} internalBitDepth = sps.getBitDepth(CHANNEL_TYPE_CHROMA);\par
01668 \par
01669   {\cf18 int} minLuma[2] = \{  MAX_INT, 0 \};\par
01670   {\cf18 int} maxLuma[2] = \{ -MAX_INT, 0 \};\par
01671 \par
01672   Pel *src = srcColor0 - srcStride;\par
01673   {\cf18 int} actualTopTemplateSampNum = 0;\par
01674   {\cf18 int} actualLeftTemplateSampNum = 0;\par
01675   {\cf19 if} (curChromaMode == MDLM_T_IDX)\par
01676   \{\par
01677     leftAvailable = 0;\par
01678     avaiAboveRightUnits = avaiAboveRightUnits > (cHeight/unitWidth) ?  cHeight/unitWidth : avaiAboveRightUnits;\par
01679     actualTopTemplateSampNum = unitWidth*(avaiAboveUnits + avaiAboveRightUnits);\par
01680   \}\par
01681   {\cf19 else} {\cf19 if} (curChromaMode == MDLM_L_IDX)\par
01682   \{\par
01683     aboveAvailable = 0;\par
01684     avaiLeftBelowUnits = avaiLeftBelowUnits > (cWidth/unitHeight) ? cWidth/unitHeight : avaiLeftBelowUnits;\par
01685     actualLeftTemplateSampNum = unitHeight*(avaiLeftUnits + avaiLeftBelowUnits);\par
01686   \}\par
01687   {\cf19 else} {\cf19 if} (curChromaMode == LM_CHROMA_IDX)\par
01688   \{\par
01689     actualTopTemplateSampNum = cWidth;\par
01690     actualLeftTemplateSampNum = cHeight;\par
01691   \}\par
01692   {\cf18 int} startPos[2]; {\cf20 //0:Above, 1: Left}\par
01693   {\cf18 int} pickStep[2];\par
01694 \par
01695   {\cf18 int} aboveIs4 = leftAvailable  ? 0 : 1;\par
01696   {\cf18 int} leftIs4 =  aboveAvailable ? 0 : 1;\par
01697 \par
01698   startPos[0] = actualTopTemplateSampNum >> (2 + aboveIs4);\par
01699   pickStep[0] = std::max(1, actualTopTemplateSampNum >> (1 + aboveIs4));\par
01700 \par
01701   startPos[1] = actualLeftTemplateSampNum >> (2 + leftIs4);\par
01702   pickStep[1] = std::max(1, actualLeftTemplateSampNum >> (1 + leftIs4));\par
01703 \par
01704   Pel selectLumaPix[4] = \{ 0, 0, 0, 0 \};\par
01705   Pel selectChromaPix[4] = \{ 0, 0, 0, 0 \};\par
01706 \par
01707   {\cf18 int} cntT, cntL;\par
01708   cntT = cntL = 0;\par
01709   {\cf18 int} cnt = 0;\par
01710   {\cf19 if} (aboveAvailable)\par
01711   \{\par
01712     cntT = std::min(actualTopTemplateSampNum, (1 + aboveIs4) << 1);\par
01713     src = srcColor0 - srcStride;\par
01714     {\cf17 const} Pel *cur = curChroma0 + 1;\par
01715     {\cf19 for} ({\cf18 int} pos = startPos[0]; cnt < cntT; pos += pickStep[0], cnt++)\par
01716     \{\par
01717       selectLumaPix[cnt] = src[pos];\par
01718       selectChromaPix[cnt] = cur[pos];\par
01719     \}\par
01720   \}\par
01721 \par
01722   {\cf19 if} (leftAvailable)\par
01723   \{\par
01724     cntL = std::min(actualLeftTemplateSampNum, ( 1 + leftIs4 ) << 1 );\par
01725     src = srcColor0 - 1;\par
01726     {\cf17 const} Pel *cur = curChroma0 + m_refBufferStride[compID] + 1;\par
01727     {\cf19 for} ({\cf18 int} pos = startPos[1], cnt = 0; cnt < cntL; pos += pickStep[1], cnt++)\par
01728     \{\par
01729       selectLumaPix[cnt + cntT] = src[pos * srcStride];\par
01730       selectChromaPix[cnt + cntT] = cur[pos];\par
01731     \}\par
01732   \}\par
01733   cnt = cntL + cntT;\par
01734 \par
01735   {\cf19 if} (cnt == 2)\par
01736   \{\par
01737     selectLumaPix[3] = selectLumaPix[0]; selectChromaPix[3] = selectChromaPix[0];\par
01738     selectLumaPix[2] = selectLumaPix[1]; selectChromaPix[2] = selectChromaPix[1];\par
01739     selectLumaPix[0] = selectLumaPix[1]; selectChromaPix[0] = selectChromaPix[1];\par
01740     selectLumaPix[1] = selectLumaPix[3]; selectChromaPix[1] = selectChromaPix[3];\par
01741   \}\par
01742 \par
01743   {\cf18 int} minGrpIdx[2] = \{ 0, 2 \};\par
01744   {\cf18 int} maxGrpIdx[2] = \{ 1, 3 \};\par
01745   {\cf18 int} *tmpMinGrp = minGrpIdx;\par
01746   {\cf18 int} *tmpMaxGrp = maxGrpIdx;\par
01747   {\cf19 if} (selectLumaPix[tmpMinGrp[0]] > selectLumaPix[tmpMinGrp[1]])\par
01748   \{\par
01749     std::swap(tmpMinGrp[0], tmpMinGrp[1]);\par
01750   \}\par
01751   {\cf19 if} (selectLumaPix[tmpMaxGrp[0]] > selectLumaPix[tmpMaxGrp[1]])\par
01752   \{\par
01753     std::swap(tmpMaxGrp[0], tmpMaxGrp[1]);\par
01754   \}\par
01755   {\cf19 if} (selectLumaPix[tmpMinGrp[0]] > selectLumaPix[tmpMaxGrp[1]])\par
01756   \{\par
01757     std::swap(tmpMinGrp, tmpMaxGrp);\par
01758   \}\par
01759   {\cf19 if} (selectLumaPix[tmpMinGrp[1]] > selectLumaPix[tmpMaxGrp[0]])\par
01760   \{\par
01761     std::swap(tmpMinGrp[1], tmpMaxGrp[0]);\par
01762   \}\par
01763 \par
01764   minLuma[0] = (selectLumaPix[tmpMinGrp[0]] + selectLumaPix[tmpMinGrp[1]] + 1 )>>1;\par
01765   minLuma[1] = (selectChromaPix[tmpMinGrp[0]] + selectChromaPix[tmpMinGrp[1]] + 1) >> 1;\par
01766   maxLuma[0] = (selectLumaPix[tmpMaxGrp[0]] + selectLumaPix[tmpMaxGrp[1]] + 1 )>>1;\par
01767   maxLuma[1] = (selectChromaPix[tmpMaxGrp[0]] + selectChromaPix[tmpMaxGrp[1]] + 1) >> 1;\par
01768 \par
01769   {\cf19 if} (leftAvailable || aboveAvailable)\par
01770   \{\par
01771     {\cf18 int} diff = maxLuma[0] - minLuma[0];\par
01772     {\cf19 if} (diff > 0)\par
01773     \{\par
01774       {\cf18 int} diffC = maxLuma[1] - minLuma[1];\par
01775       {\cf18 int} x = floorLog2( diff );\par
01776       {\cf17 static} {\cf17 const} uint8_t DivSigTable[1 << 4] = \{\par
01777         {\cf20 // 4bit significands - 8 ( MSB is omitted )}\par
01778         0,  7,  6,  5,  5,  4,  4,  3,  3,  2,  2,  1,  1,  1,  1,  0\par
01779       \};\par
01780       {\cf18 int} normDiff = (diff << 4 >> x) & 15;\par
01781       {\cf18 int} v = DivSigTable[normDiff] | 8;\par
01782       x += normDiff != 0;\par
01783 \par
01784       {\cf18 int} y = floorLog2( abs( diffC ) ) + 1;\par
01785       {\cf18 int} add = 1 << y >> 1;\par
01786       a = (diffC * v + add) >> y;\par
01787       iShift = 3 + x - y;\par
01788       {\cf19 if} ( iShift < 1 )\par
01789       \{\par
01790         iShift = 1;\par
01791         a = ( (a == 0)? 0: (a < 0)? -15 : 15 );   {\cf20 // a=Sign(a)*15}\par
01792       \}\par
01793       b = minLuma[1] - ((a * minLuma[0]) >> iShift);\par
01794     \}\par
01795     {\cf19 else}\par
01796     \{\par
01797       a = 0;\par
01798       b = minLuma[1];\par
01799       iShift = 0;\par
01800     \}\par
01801   \}\par
01802   {\cf19 else}\par
01803   \{\par
01804     a = 0;\par
01805 \par
01806     b = 1 << (internalBitDepth - 1);\par
01807 \par
01808     iShift = 0;\par
01809   \}\par
01810 \}\par
