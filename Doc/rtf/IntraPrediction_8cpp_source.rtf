00291 {\cf20 //NOTE: Bit-Limit - 24-bit source}\par
00292 {\cf18 void} IntraPrediction::xPredIntraPlanar( {\cf17 const} CPelBuf &pSrc, PelBuf &pDst )\par
00293 \{\par
00294   {\cf17 const} uint32_t width  = pDst.width;\par
00295   {\cf17 const} uint32_t height = pDst.height;\par
00296 \par
00297   {\cf17 const} uint32_t log2W = floorLog2( width );\par
00298   {\cf17 const} uint32_t log2H = floorLog2( height );\par
00299 \par
00300   {\cf18 int} leftColumn[MAX_CU_SIZE + 1], topRow[MAX_CU_SIZE + 1], bottomRow[MAX_CU_SIZE], rightColumn[MAX_CU_SIZE];\par
00301   {\cf17 const} uint32_t offset = 1 << (log2W + log2H);\par
00302 \par
00303   {\cf20 // Get left and above reference column and row}\par
00304   CHECK(width > MAX_CU_SIZE, {\cf22 "width greater than limit"});\par
00305   {\cf19 for}( {\cf18 int} k = 0; k < width + 1; k++ )\par
00306   \{\par
00307     topRow[k] = pSrc.at( k + 1, 0 );\par
00308   \}\par
00309 \par
00310   CHECK(height > MAX_CU_SIZE, {\cf22 "height greater than limit"});\par
00311   {\cf19 for}( {\cf18 int} k = 0; k < height + 1; k++ )\par
00312   \{\par
00313     leftColumn[k] = pSrc.at(k + 1, 1);\par
00314   \}\par
00315 \par
00316   {\cf20 // Prepare intermediate variables used in interpolation}\par
00317   {\cf18 int} bottomLeft = leftColumn[height];\par
00318   {\cf18 int} topRight = topRow[width];\par
00319 \par
00320   {\cf19 for}( {\cf18 int} k = 0; k < width; k++ )\par
00321   \{\par
00322     bottomRow[k] = bottomLeft - topRow[k];\par
00323     topRow[k]    = topRow[k] << log2H;\par
00324   \}\par
00325 \par
00326   {\cf19 for}( {\cf18 int} k = 0; k < height; k++ )\par
00327   \{\par
00328     rightColumn[k] = topRight - leftColumn[k];\par
00329     leftColumn[k]  = leftColumn[k] << log2W;\par
00330   \}\par
00331 \par
00332   {\cf17 const} uint32_t finalShift = 1 + log2W + log2H;\par
00333   {\cf17 const} uint32_t stride     = pDst.stride;\par
00334   Pel*       pred       = pDst.buf;\par
00335   {\cf19 for}( {\cf18 int} y = 0; y < height; y++, pred += stride )\par
00336   \{\par
00337     {\cf18 int} horPred = leftColumn[y];\par
00338 \par
00339     {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00340     \{\par
00341       horPred += rightColumn[y];\par
00342       topRow[x] += bottomRow[x];\par
00343 \par
00344       {\cf18 int} vertPred = topRow[x];\par
00345       pred[x]      = ( ( horPred << log2H ) + ( vertPred << log2W ) + offset ) >> finalShift;\par
00346     \}\par
00347   \}\par
00348 \}\par
