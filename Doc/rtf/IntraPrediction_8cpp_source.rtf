00150 {\cf20 // Function for calculating DC value of the reference samples used in Intra prediction}\par
00151 {\cf20 //NOTE: Bit-Limit - 25-bit source}\par
00152 Pel IntraPrediction::xGetPredValDc( {\cf17 const} CPelBuf &pSrc, {\cf17 const} Size &dstSize )\par
00153 \{\par
00154   CHECK( dstSize.width == 0 || dstSize.height == 0, {\cf22 "Empty area provided"} );\par
00155 \par
00156   {\cf18 int} idx, sum = 0;\par
00157   Pel dcVal;\par
00158   {\cf17 const} {\cf18 int} width  = dstSize.width;\par
00159   {\cf17 const} {\cf18 int} height = dstSize.height;\par
00160   {\cf17 const} {\cf17 auto} denom     = (width == height) ? (width << 1) : std::max(width,height);\par
00161   {\cf17 const} {\cf17 auto} divShift  = floorLog2(denom);\par
00162   {\cf17 const} {\cf17 auto} divOffset = (denom >> 1);\par
00163 \par
00164   {\cf19 if} ( width >= height )\par
00165   \{\par
00166     {\cf19 for}( idx = 0; idx < width; idx++ )\par
00167     \{\par
00168       sum += pSrc.at(m_ipaParam.multiRefIndex + 1 + idx, 0);\par
00169     \}\par
00170   \}\par
00171   {\cf19 if} ( width <= height )\par
00172   \{\par
00173     {\cf19 for}( idx = 0; idx < height; idx++ )\par
00174     \{\par
00175       sum += pSrc.at(m_ipaParam.multiRefIndex + 1 + idx, 1);\par
00176     \}\par
00177   \}\par
00178 \par
00179   dcVal = (sum + divOffset) >> divShift;\par
00180   {\cf19 return} dcVal;\par
00181 \}\par
00182 \par
00183 {\cf18 int} IntraPrediction::getModifiedWideAngle( {\cf18 int} width, {\cf18 int} height, {\cf18 int} predMode )\par
00184 \{\par
00185   {\cf20 //The function returns a 'modified' wide angle index, given that it is not necessary }\par
00186   {\cf20 //in this software implementation to reserve the values 0 and 1 for Planar and DC to generate the prediction signal.}\par
00187   {\cf20 //It should only be used to obtain the intraPredAngle parameter.}\par
00188   {\cf20 //To simply obtain the wide angle index, the function PU::getWideAngle should be used instead.}\par
00189   {\cf19 if} ( predMode > DC_IDX && predMode <= VDIA_IDX )\par
00190   \{\par
00191     {\cf18 int} modeShift[] = \{ 0, 6, 10, 12, 14, 15 \};\par
00192     {\cf18 int} deltaSize = abs(floorLog2(width) - floorLog2(height));\par
00193     {\cf19 if} (width > height && predMode < 2 + modeShift[deltaSize])\par
00194     \{\par
00195       predMode += (VDIA_IDX - 1);\par
00196     \}\par
00197     {\cf19 else} {\cf19 if} (height > width && predMode > VDIA_IDX - modeShift[deltaSize])\par
00198     \{\par
00199       predMode -= (VDIA_IDX - 1); \par
00200     \}\par
00201   \}\par
00202   {\cf19 return} predMode;\par
00203 \}\par
