00683 {\cf18 void} IntraPrediction::geneWeightedPred({\cf17 const} ComponentID compId, PelBuf &pred, {\cf17 const} PredictionUnit &pu, Pel *srcBuf)\par
00684 \{\par
00685   {\cf17 const} {\cf18 int}            width = pred.width;\par
00686   CHECK(width == 2, {\cf22 "Width of 2 is not supported"});\par
00687   {\cf17 const} {\cf18 int}            height = pred.height;\par
00688   {\cf17 const} {\cf18 int}            srcStride = width;\par
00689   {\cf17 const} {\cf18 int}            dstStride = pred.stride;\par
00690 \par
00691   Pel*                 dstBuf = pred.buf;\par
00692   {\cf18 int} wIntra, wMerge;\par
00693 \par
00694   {\cf17 const} Position posBL = pu.Y().bottomLeft();\par
00695   {\cf17 const} Position posTR = pu.Y().topRight();\par
00696   {\cf17 const} PredictionUnit *neigh0 = pu.cs->getPURestricted(posBL.offset(-1, 0), pu, CHANNEL_TYPE_LUMA);\par
00697   {\cf17 const} PredictionUnit *neigh1 = pu.cs->getPURestricted(posTR.offset(0, -1), pu, CHANNEL_TYPE_LUMA);\par
00698   {\cf18 bool} isNeigh0Intra = neigh0 && (CU::isIntra(*neigh0->cu));\par
00699   {\cf18 bool} isNeigh1Intra = neigh1 && (CU::isIntra(*neigh1->cu));\par
00700 \par
00701   {\cf19 if} (isNeigh0Intra && isNeigh1Intra)\par
00702   \{\par
00703     wIntra = 3; wMerge = 1;\par
00704   \}\par
00705   {\cf19 else}\par
00706   \{\par
00707     {\cf19 if} (!isNeigh0Intra && !isNeigh1Intra)\par
00708     \{\par
00709       wIntra = 1; wMerge = 3;\par
00710     \}\par
00711     {\cf19 else}\par
00712     \{\par
00713       wIntra = 2; wMerge = 2;\par
00714     \}\par
00715   \}\par
00716   {\cf19 for} ({\cf18 int} y = 0; y < height; y++)\par
00717   \{\par
00718     {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00719     \{\par
00720       dstBuf[y*dstStride + x] = (wMerge * dstBuf[y*dstStride + x] + wIntra * srcBuf[y*srcStride + x] + 2) >> 2;\par
00721     \}\par
00722   \}\par
00723 \}\par
