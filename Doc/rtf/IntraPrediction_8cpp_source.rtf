00738 {\cf18 void} IntraPrediction::geneIntrainterPred({\cf17 const} CodingUnit &cu)\par
00739 \{\par
00740   {\cf19 if} (!cu.firstPU->ciipFlag)\par
00741   \{\par
00742     {\cf19 return};\par
00743   \}\par
00744 \par
00745   {\cf17 const} PredictionUnit* pu = cu.firstPU;\par
00746 \par
00747   initIntraPatternChType(cu, pu->Y());\par
00748   predIntraAng(COMPONENT_Y, cu.cs->getPredBuf(*pu).Y(), *pu);\par
00749   {\cf18 int} maxCompID = 1;\par
00750   {\cf19 if} (isChromaEnabled(pu->chromaFormat))\par
