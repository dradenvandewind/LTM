01826 {\cf18 void} IntraPrediction::predIntraMip( {\cf17 const} ComponentID compId, PelBuf &piPred, {\cf17 const} PredictionUnit &pu )\par
01827 \{\par
01828   CHECK( piPred.width > MIP_MAX_WIDTH || piPred.height > MIP_MAX_HEIGHT, {\cf22 "Error: block size not supported for MIP"} );\par
01829   CHECK( piPred.width != (1 << floorLog2(piPred.width)) || piPred.height != (1 << floorLog2(piPred.height)), {\cf22 "Error: expecting blocks of size 2^M x 2^N"} );\par
01830 \par
01831   {\cf20 // generate mode-specific prediction}\par
01832   uint32_t modeIdx       = MAX_NUM_MIP_MODE;\par
01833   {\cf18 bool}     transposeFlag = {\cf17 false};\par
01834   {\cf19 if} (compId == COMPONENT_Y)\par
01835   \{\par
01836     modeIdx       = pu.intraDir[CHANNEL_TYPE_LUMA];\par
01837     transposeFlag = pu.mipTransposedFlag;\par
01838   \}\par
01839   {\cf19 else}\par
01840   \{\par
01841     {\cf17 const} PredictionUnit &coLocatedLumaPU = PU::getCoLocatedLumaPU(pu);\par
01842 \par
01843     CHECK(pu.intraDir[CHANNEL_TYPE_CHROMA] != DM_CHROMA_IDX, {\cf22 "Error: MIP is only supported for chroma with DM_CHROMA."});\par
01844     CHECK(!coLocatedLumaPU.cu->mipFlag, {\cf22 "Error: Co-located luma CU should use MIP."});\par
01845 \par
01846     modeIdx       = coLocatedLumaPU.intraDir[CHANNEL_TYPE_LUMA];\par
01847     transposeFlag = coLocatedLumaPU.mipTransposedFlag;\par
01848   \}\par
01849   {\cf17 const} {\cf18 int} bitDepth = pu.cu->slice->getSPS()->getBitDepth(toChannelType(compId));\par
01850 \par
01851   CHECK(modeIdx >= getNumModesMip(piPred), {\cf22 "Error: Wrong MIP mode index"});\par
01852 \par
01853   static_vector<int, MIP_MAX_WIDTH* MIP_MAX_HEIGHT> predMip( piPred.width * piPred.height );\par
01854   m_matrixIntraPred.predBlock(predMip.data(), modeIdx, transposeFlag, bitDepth, compId);\par
01855 \par
01856   {\cf19 for}( {\cf18 int} y = 0; y < piPred.height; y++ )\par
01857   \{\par
01858     {\cf19 for}( {\cf18 int} x = 0; x < piPred.width; x++ )\par
01859     \{\par
01860       piPred.at( x, y ) = Pel(predMip[y * piPred.width + x]);\par
01861     \}\par
01862   \}\par
01863 \}\par
