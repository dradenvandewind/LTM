01865 {\cf18 void} IntraPrediction::reorderPLT(CodingStructure& cs, Partitioner& partitioner, ComponentID compBegin, uint32_t numComp)\par
01866 \{\par
01867   CodingUnit &cu = *cs.getCU(partitioner.chType);\par
01868 \par
01869   uint8_t        reusePLTSizetmp = 0;\par
01870   uint8_t        pltSizetmp = 0;\par
01871   Pel            curPLTtmp[MAX_NUM_COMPONENT][MAXPLTSIZE];\par
01872   {\cf18 bool}           curPLTpred[MAXPLTPREDSIZE];\par
01873 \par
01874   {\cf19 for} ({\cf18 int} idx = 0; idx < MAXPLTPREDSIZE; idx++)\par
01875   \{\par
01876     curPLTpred[idx] = {\cf17 false};\par
01877     cu.reuseflag[compBegin][idx] = {\cf17 false};\par
01878   \}\par
01879   {\cf19 for} ({\cf18 int} idx = 0; idx < MAXPLTSIZE; idx++)\par
01880   \{\par
01881     curPLTpred[idx] = {\cf17 false};\par
01882   \}\par
01883 \par
01884   {\cf19 for} ({\cf18 int} predidx = 0; predidx < cs.prevPLT.curPLTSize[compBegin]; predidx++)\par
01885   \{\par
01886     {\cf18 bool} match = {\cf17 false};\par
01887     {\cf18 int} curidx = 0;\par
01888 \par
01889     {\cf19 for} (curidx = 0; curidx < cu.curPLTSize[compBegin]; curidx++)\par
01890     \{\par
01891       {\cf19 if}( curPLTpred[curidx] )\par
01892       \{\par
01893         {\cf19 continue};\par
01894       \}\par
01895       {\cf18 bool} matchTmp = {\cf17 true};\par
01896       {\cf19 for} ({\cf18 int} comp = compBegin; comp < (compBegin + numComp); comp++)\par
01897       \{\par
01898         matchTmp = matchTmp && (cu.curPLT[comp][curidx] == cs.prevPLT.curPLT[comp][predidx]);\par
01899       \}\par
01900       {\cf19 if} (matchTmp)\par
01901       \{\par
01902         match = {\cf17 true};\par
01903         {\cf19 break};\par
01904       \}\par
01905     \}\par
