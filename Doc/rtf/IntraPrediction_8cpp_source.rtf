00356 {\cf20 // Function for initialization of intra prediction parameters}\par
00357 {\cf18 void} IntraPrediction::initPredIntraParams({\cf17 const} PredictionUnit & pu, {\cf17 const} CompArea area, {\cf17 const} SPS& sps)\par
00358 \{\par
00359   {\cf17 const} ComponentID compId = area.compID;\par
00360   {\cf17 const} ChannelType chType = toChannelType(compId);\par
00361 \par
00362   {\cf17 const} {\cf18 bool}        useISP = NOT_INTRA_SUBPARTITIONS != pu.cu->ispMode && isLuma( chType );\par
00363 \par
00364   {\cf17 const} Size   cuSize    = Size( pu.cu->blocks[compId].width, pu.cu->blocks[compId].height );\par
00365   {\cf17 const} Size   puSize    = Size( area.width, area.height );\par
00366   {\cf17 const} Size&  blockSize = useISP ? cuSize : puSize;\par
00367   {\cf17 const} {\cf18 int}      dirMode = PU::getFinalIntraMode(pu, chType);\par
00368   {\cf17 const} {\cf18 int}     predMode = getModifiedWideAngle( blockSize.width, blockSize.height, dirMode );\par
00369 \par
00370   m_ipaParam.isModeVer            = predMode >= DIA_IDX;\par
00371   m_ipaParam.multiRefIndex        = isLuma (chType) ? pu.multiRefIdx : 0 ;\par
00372   m_ipaParam.refFilterFlag        = {\cf17 false};\par
00373   m_ipaParam.interpolationFlag    = {\cf17 false};\par
00374   m_ipaParam.applyPDPC            = (puSize.width >= MIN_TB_SIZEY && puSize.height >= MIN_TB_SIZEY) && m_ipaParam.multiRefIndex == 0;\par
00375 \par
00376   {\cf17 const} {\cf18 int}    intraPredAngleMode = (m_ipaParam.isModeVer) ? predMode - VER_IDX : -(predMode - HOR_IDX);\par
00377 \par
00378 \par
00379   {\cf18 int} absAng = 0;\par
00380   {\cf19 if} (dirMode > DC_IDX && dirMode < NUM_LUMA_MODE) {\cf20 // intraPredAngle for directional modes}\par
00381   \{\par
00382     {\cf17 static} {\cf17 const} {\cf18 int} angTable[32]    = \{ 0,    1,    2,    3,    4,    6,     8,   10,   12,   14,   16,   18,   20,   23,   26,   29,   32,   35,   39,  45,  51,  57,  64,  73,  86, 102, 128, 171, 256, 341, 512, 1024 \};\par
00383     {\cf17 static} {\cf17 const} {\cf18 int} invAngTable[32] = \{\par
00384       0,   16384, 8192, 5461, 4096, 2731, 2048, 1638, 1365, 1170, 1024, 910, 819, 712, 630, 565,\par
00385       512, 468,   420,  364,  321,  287,  256,  224,  191,  161,  128,  96,  64,  48,  32,  16\par
00386     \};   {\cf20 // (512 * 32) / Angle}\par
00387 \par
00388     {\cf17 const} {\cf18 int}     absAngMode         = abs(intraPredAngleMode);\par
00389     {\cf17 const} {\cf18 int}     signAng            = intraPredAngleMode < 0 ? -1 : 1;\par
00390                   absAng             = angTable  [absAngMode];\par
00391 \par
00392     m_ipaParam.absInvAngle           = invAngTable[absAngMode];\par
00393     m_ipaParam.intraPredAngle        = signAng * absAng;\par
00394     {\cf19 if} (intraPredAngleMode < 0)\par
00395     \{\par
00396       m_ipaParam.applyPDPC = {\cf17 false};\par
00397     \}\par
00398     {\cf19 else} {\cf19 if} (intraPredAngleMode > 0)\par
00399     \{\par
00400       {\cf17 const} {\cf18 int} sideSize = m_ipaParam.isModeVer ? puSize.height : puSize.width;\par
00401       {\cf17 const} {\cf18 int} maxScale = 2;\par
00402 \par
00403       m_ipaParam.angularScale = std::min(maxScale, floorLog2(sideSize) - (floorLog2(3 * m_ipaParam.absInvAngle - 2) - 8));\par
00404       m_ipaParam.applyPDPC &= m_ipaParam.angularScale >= 0;\par
00405     \}\par
00406   \}\par
00407 \par
00408   {\cf20 // high level conditions and DC intra prediction}\par
00409   {\cf19 if}(   sps.getSpsRangeExtension().getIntraSmoothingDisabledFlag()\par
00410     || !isLuma( chType )\par
00411     || useISP\par
00412     || PU::isMIP( pu, chType )\par
00413     || m_ipaParam.multiRefIndex\par
00414     || DC_IDX == dirMode\par
00415     )\par
00416   \{\par
00417   \}\par
00418   {\cf19 else} {\cf19 if} ((isLuma(chType) && pu.cu->bdpcmMode) || (!isLuma(chType) && pu.cu->bdpcmModeChroma)) {\cf20 // BDPCM}\par
00419   \{\par
00420     m_ipaParam.refFilterFlag = {\cf17 false};\par
00421   \}\par
00422   {\cf19 else} {\cf19 if} (dirMode == PLANAR_IDX) {\cf20 // Planar intra prediction}\par
00423   \{\par
00424     m_ipaParam.refFilterFlag = puSize.width * puSize.height > 32 ? true : {\cf17 false};\par
00425   \}\par
00426   {\cf19 else} {\cf19 if} (!useISP){\cf20 // HOR, VER and angular modes (MDIS)}\par
00427   \{\par
00428     {\cf18 bool} filterFlag = {\cf17 false};\par
00429     \{\par
00430       {\cf17 const} {\cf18 int} diff = std::min<int>( abs( predMode - HOR_IDX ), abs( predMode - VER_IDX ) );\par
00431       {\cf17 const} {\cf18 int} log2Size = ((floorLog2(puSize.width) + floorLog2(puSize.height)) >> 1);\par
00432       CHECK( log2Size >= MAX_INTRA_FILTER_DEPTHS, {\cf22 "Size not supported"} );\par
00433       filterFlag = (diff > m_aucIntraFilter[log2Size]);\par
00434     \}\par
00435 \par
00436     {\cf20 // Selelection of either ([1 2 1] / 4 ) refrence filter OR Gaussian 4-tap interpolation filter}\par
00437     {\cf19 if} (filterFlag)\par
00438     \{\par
00439       {\cf17 const} {\cf18 bool} isRefFilter       =  isIntegerSlope(absAng);\par
00440       CHECK( puSize.width * puSize.height <= 32, {\cf22 "DCT-IF interpolation filter is always used for 4x4, 4x8, and 8x4 luma CB"} );\par
00441       m_ipaParam.refFilterFlag     =  isRefFilter;\par
00442       m_ipaParam.interpolationFlag = !isRefFilter;\par
00443     \}\par
00444   \}\par
00445 \}\par
00446 \par
00447 \par
00458 {\cf20 //NOTE: Bit-Limit - 25-bit source}\par
00459 \par
00460 {\cf18 void} IntraPrediction::xPredIntraAng( {\cf17 const} CPelBuf &pSrc, PelBuf &pDst, {\cf17 const} ChannelType channelType, {\cf17 const} ClpRng& clpRng)\par
00461 \{\par
00462   {\cf18 int} width =int(pDst.width);\par
00463   {\cf18 int} height=int(pDst.height);\par
00464 \par
00465   {\cf17 const} {\cf18 bool} bIsModeVer     = m_ipaParam.isModeVer;\par
00466   {\cf17 const} {\cf18 int}  multiRefIdx    = m_ipaParam.multiRefIndex;\par
00467   {\cf17 const} {\cf18 int}  intraPredAngle = m_ipaParam.intraPredAngle;\par
00468   {\cf17 const} {\cf18 int}  absInvAngle    = m_ipaParam.absInvAngle;\par
00469 \par
00470   Pel* refMain;\par
00471   Pel* refSide;\par
00472 \par
00473   Pel  refAbove[2 * MAX_CU_SIZE + 3 + 33 * MAX_REF_LINE_IDX];\par
00474   Pel  refLeft [2 * MAX_CU_SIZE + 3 + 33 * MAX_REF_LINE_IDX];\par
00475 \par
00476   {\cf20 // Initialize the Main and Left reference array.}\par
00477   {\cf19 if} (intraPredAngle < 0)\par
00478   \{\par
00479     {\cf19 for} ({\cf18 int} x = 0; x <= width + 1 + multiRefIdx; x++)\par
00480     \{\par
00481       refAbove[x + height] = pSrc.at(x, 0);\par
00482     \}\par
00483     {\cf19 for} ({\cf18 int} y = 0; y <= height + 1 + multiRefIdx; y++)\par
00484     \{\par
00485       refLeft[y + width] = pSrc.at(y, 1);\par
00486     \}\par
00487     refMain = bIsModeVer ? refAbove + height : refLeft + width;\par
00488     refSide = bIsModeVer ? refLeft + width : refAbove + height;\par
00489 \par
00490     {\cf20 // Extend the Main reference to the left.}\par
00491     {\cf18 int} sizeSide = bIsModeVer ? height : width;\par
00492     {\cf19 for} ({\cf18 int} k = -sizeSide; k <= -1; k++)\par
00493     \{\par
00494       refMain[k] = refSide[std::min((-k * absInvAngle + 256) >> 9, sizeSide)];\par
00495     \}\par
00496   \}\par
00497   {\cf19 else}\par
00498   \{\par
00499     {\cf19 for} ({\cf18 int} x = 0; x <= m_topRefLength + multiRefIdx; x++)\par
00500     \{\par
00501       refAbove[x] = pSrc.at(x, 0);\par
00502     \}\par
00503     {\cf19 for} ({\cf18 int} y = 0; y <= m_leftRefLength + multiRefIdx; y++)\par
00504     \{\par
00505       refLeft[y] = pSrc.at(y, 1);\par
00506     \}\par
00507 \par
00508     refMain = bIsModeVer ? refAbove : refLeft;\par
00509     refSide = bIsModeVer ? refLeft : refAbove;\par
00510 \par
00511     {\cf20 // Extend main reference to right using replication}\par
00512     {\cf17 const} {\cf18 int} log2Ratio = floorLog2(width) - floorLog2(height);\par
00513     {\cf17 const} {\cf18 int} s         = std::max<int>(0, bIsModeVer ? log2Ratio : -log2Ratio);\par
00514     {\cf17 const} {\cf18 int} maxIndex  = (multiRefIdx << s) + 2;\par
00515     {\cf17 const} {\cf18 int} refLength = bIsModeVer ? m_topRefLength : m_leftRefLength;\par
00516     {\cf17 const} Pel val       = refMain[refLength + multiRefIdx];\par
00517     {\cf19 for} ({\cf18 int} z = 1; z <= maxIndex; z++)\par
00518     \{\par
00519       refMain[refLength + multiRefIdx + z] = val;\par
00520     \}\par
00521   \}\par
00522 \par
00523   {\cf20 // swap width/height if we are doing a horizontal mode:}\par
00524   {\cf19 if} (!bIsModeVer)\par
00525   \{\par
00526     std::swap(width, height);\par
00527   \}\par
00528   Pel       tempArray[MAX_CU_SIZE * MAX_CU_SIZE];\par
00529   {\cf17 const} {\cf18 int} dstStride = bIsModeVer ? pDst.stride : width;\par
00530   Pel *     pDstBuf   = bIsModeVer ? pDst.buf : tempArray;\par
00531 \par
00532   {\cf20 // compensate for line offset in reference line buffers}\par
00533   refMain += multiRefIdx;\par
00534   refSide += multiRefIdx;\par
00535 \par
00536   Pel *pDsty = pDstBuf;\par
00537 \par
00538   {\cf19 if}( intraPredAngle == 0 )  {\cf20 // pure vertical or pure horizontal}\par
00539   \{\par
00540     {\cf19 for}( {\cf18 int} y = 0; y < height; y++ )\par
00541     \{\par
00542       {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00543       \{\par
00544         pDsty[x] = refMain[x + 1];\par
00545       \}\par
00546 \par
00547       {\cf19 if} (m_ipaParam.applyPDPC)\par
00548       \{\par
00549         {\cf17 const} {\cf18 int} scale   = (floorLog2(width) + floorLog2(height) - 2) >> 2;\par
00550         {\cf17 const} Pel topLeft = refMain[0];\par
00551         {\cf17 const} Pel left    = refSide[1 + y];\par
00552         {\cf19 for} ({\cf18 int} x = 0; x < std::min(3 << scale, width); x++)\par
00553         \{\par
00554           {\cf17 const} {\cf18 int} wL  = 32 >> (2 * x >> scale);\par
00555           {\cf17 const} Pel val = pDsty[x];\par
00556           pDsty[x]      = ClipPel(val + ((wL * (left - topLeft) + 32) >> 6), clpRng);\par
00557         \}\par
00558       \}\par
00559 \par
00560       pDsty += dstStride;\par
00561     \}\par
00562   \}\par
00563   {\cf19 else}\par
00564   \{\par
00565     {\cf19 for} ({\cf18 int} y = 0, deltaPos = intraPredAngle * (1 + multiRefIdx); y<height; y++, deltaPos += intraPredAngle, pDsty += dstStride)\par
00566     \{\par
00567       {\cf17 const} {\cf18 int} deltaInt   = deltaPos >> 5;\par
00568       {\cf17 const} {\cf18 int} deltaFract = deltaPos & 31;\par
00569 \par
00570       {\cf19 if} ( !isIntegerSlope( abs(intraPredAngle) ) )\par
00571       \{\par
00572         {\cf19 if}( isLuma(channelType) )\par
00573         \{\par
00574           {\cf17 const} {\cf18 bool} useCubicFilter = !m_ipaParam.interpolationFlag;\par
00575 \par
00576           {\cf17 const} TFilterCoeff        intraSmoothingFilter[4] = \{TFilterCoeff(16 - (deltaFract >> 1)), TFilterCoeff(32 - (deltaFract >> 1)), TFilterCoeff(16 + (deltaFract >> 1)), TFilterCoeff(deltaFract >> 1)\};\par
00577           {\cf17 const} TFilterCoeff* {\cf17 const} f                       = (useCubicFilter) ? InterpolationFilter::getChromaFilterTable(deltaFract) : intraSmoothingFilter;\par
00578 \par
00579           {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00580           \{\par
00581             Pel p[4];\par
00582 \par
00583             p[0] = refMain[deltaInt + x];\par
00584             p[1] = refMain[deltaInt + x + 1];\par
00585             p[2] = refMain[deltaInt + x + 2];\par
00586             p[3] = refMain[deltaInt + x + 3];\par
00587 \par
00588             Pel val = (f[0] * p[0] + f[1] * p[1] + f[2] * p[2] + f[3] * p[3] + 32) >> 6;\par
00589 \par
00590             pDsty[x] = ClipPel(val, clpRng);   {\cf20 // always clip even though not always needed}\par
00591           \}\par
00592         \}\par
00593         {\cf19 else}\par
00594         \{\par
00595           {\cf20 // Do linear filtering}\par
00596           {\cf19 for} ({\cf18 int} x = 0; x < width; x++)\par
00597           \{\par
00598             Pel p[2];\par
00599 \par
00600             p[0] = refMain[deltaInt + x + 1];\par
00601             p[1] = refMain[deltaInt + x + 2];\par
00602 \par
00603             pDsty[x] = p[0] + ((deltaFract * (p[1] - p[0]) + 16) >> 5);\par
00604           \}\par
00605         \}\par
00606       \}\par
00607       {\cf19 else}\par
00608       \{\par
00609         {\cf20 // Just copy the integer samples}\par
00610         {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00611         \{\par
00612           pDsty[x] = refMain[x + deltaInt + 1];\par
00613         \}\par
00614       \}\par
00615       {\cf19 if} (m_ipaParam.applyPDPC)\par
00616       \{\par
00617         {\cf17 const} {\cf18 int} scale       = m_ipaParam.angularScale;\par
00618         {\cf18 int}       invAngleSum = 256;\par
00619 \par
00620         {\cf19 for} ({\cf18 int} x = 0; x < std::min(3 << scale, width); x++)\par
00621         \{\par
00622           invAngleSum += absInvAngle;\par
00623 \par
00624           {\cf18 int} wL   = 32 >> (2 * x >> scale);\par
00625           Pel left = refSide[y + (invAngleSum >> 9) + 1];\par
00626           pDsty[x] = pDsty[x] + ((wL * (left - pDsty[x]) + 32) >> 6);\par
00627         \}\par
00628       \}\par
00629     \}\par
00630   \}\par
00631 \par
00632   {\cf20 // Flip the block if this is the horizontal mode}\par
00633   {\cf19 if}( !bIsModeVer )\par
00634   \{\par
00635     {\cf19 for}( {\cf18 int} y = 0; y < height; y++ )\par
00636     \{\par
00637       {\cf19 for}( {\cf18 int} x = 0; x < width; x++ )\par
00638       \{\par
00639         pDst.at( y, x ) = pDstBuf[x];\par
00640       \}\par
00641       pDstBuf += dstStride;\par
00642     \}\par
00643   \}\par
00644 \}\par
00645 \par
00646 {\cf18 void} IntraPrediction::xPredIntraBDPCM({\cf17 const} CPelBuf &pSrc, PelBuf &pDst, {\cf17 const} uint32_t dirMode, {\cf17 const} ClpRng& clpRng )\par
00647 \{\par
00648   {\cf17 const} {\cf18 int} wdt = pDst.width;\par
00649   {\cf17 const} {\cf18 int} hgt = pDst.height;\par
00650 \par
00651   {\cf17 const} {\cf18 int} strideP = pDst.stride;\par
00652   {\cf17 const} {\cf18 int} strideS = pSrc.stride;\par
00653 \par
00654   CHECK( !( dirMode == 1 || dirMode == 2 ), {\cf22 "Incorrect BDPCM mode parameter."} );\par
00655 \par
00656   Pel* pred = &pDst.buf[0];\par
00657   {\cf19 if}( dirMode == 1 )\par
00658   \{\par
00659     Pel  val;\par
00660     {\cf19 for}( {\cf18 int} y = 0; y < hgt; y++ )\par
00661     \{\par
00662       val = pSrc.buf[(y + 1) + strideS];\par
00663       {\cf19 for}( {\cf18 int} x = 0; x < wdt; x++ )\par
00664       \{\par
00665         pred[x] = val;\par
00666       \}\par
00667       pred += strideP;\par
00668     \}\par
00669   \}\par
00670   {\cf19 else}\par
00671   \{\par
00672     {\cf19 for}( {\cf18 int} y = 0; y < hgt; y++ )\par
00673     \{\par
00674       {\cf19 for}( {\cf18 int} x = 0; x < wdt; x++ )\par
00675       \{\par
00676         pred[x] = pSrc.buf[x + 1];\par
00677       \}\par
00678       pred += strideP;\par
00679     \}\par
00680   \}\par
00681 \}\par
