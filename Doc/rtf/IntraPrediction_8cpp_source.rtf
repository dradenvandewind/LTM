00725 {\cf18 void} IntraPrediction::switchBuffer({\cf17 const} PredictionUnit &pu, ComponentID compID, PelBuf srcBuff, Pel *dst)\par
00726 \{\par
00727   Pel  *src = srcBuff.bufAt(0, 0);\par
00728   {\cf18 int} compWidth = compID == COMPONENT_Y ? pu.Y().width : pu.Cb().width;\par
00729   {\cf18 int} compHeight = compID == COMPONENT_Y ? pu.Y().height : pu.Cb().height;\par
00730   {\cf19 for} ({\cf18 int} i = 0; i < compHeight; i++)\par
00731   \{\par
00732     memcpy(dst, src, compWidth * {\cf17 sizeof}(Pel));\par
00733     src += srcBuff.stride;\par
00734     dst += compWidth;\par
00735   \}\par
00736 \}\par
