00780 {\cf18 void} IntraPrediction::initIntraPatternChType({\cf17 const} CodingUnit &cu, {\cf17 const} CompArea &area, {\cf17 const} {\cf18 bool} forceRefFilterFlag)\par
00781 \{\par
00782   CHECK(area.width == 2, {\cf22 "Width of 2 is not supported"});\par
00783   {\cf17 const} CodingStructure& cs   = *cu.cs;\par
00784 \par
00785   {\cf19 if} (!forceRefFilterFlag)\par
00786   \{\par
00787     initPredIntraParams(*cu.firstPU, area, *cs.sps);\par
00788   \}\par
00789 \par
00790   Pel *refBufUnfiltered = m_refBuffer[area.compID][PRED_BUF_UNFILTERED];\par
00791   Pel *refBufFiltered   = m_refBuffer[area.compID][PRED_BUF_FILTERED];\par
00792 \par
00793   setReferenceArrayLengths( area );\par
00794 \par
00795   {\cf20 // ----- Step 1: unfiltered reference samples -----}\par
00796   xFillReferenceSamples( cs.picture->getRecoBuf( area ), refBufUnfiltered, area, cu );\par
00797   {\cf20 // ----- Step 2: filtered reference samples -----}\par
00798   {\cf19 if}( m_ipaParam.refFilterFlag || forceRefFilterFlag )\par
00799   \{\par
00800     xFilterReferenceSamples( refBufUnfiltered, refBufFiltered, area, *cs.sps, cu.firstPU->multiRefIdx );\par
00801   \}\par
00802 \}\par
00803 \par
00804 {\cf18 void} IntraPrediction::initIntraPatternChTypeISP({\cf17 const} CodingUnit& cu, {\cf17 const} CompArea& area, PelBuf& recBuf, {\cf17 const} {\cf18 bool} forceRefFilterFlag)\par
00805 \{\par
00806   {\cf17 const} CodingStructure& cs = *cu.cs;\par
00807 \par
00808   {\cf19 if} (!forceRefFilterFlag)\par
00809   \{\par
00810     initPredIntraParams(*cu.firstPU, area, *cs.sps);\par
00811   \}\par
00812 \par
00813   {\cf17 const} Position posLT = area;\par
00814   {\cf18 bool}           isLeftAvail  = (cs.getCURestricted(posLT.offset(-1, 0), cu, CHANNEL_TYPE_LUMA) != NULL) && cs.isDecomp(posLT.offset(-1, 0), CHANNEL_TYPE_LUMA);\par
00815   {\cf18 bool}           isAboveAvail = (cs.getCURestricted(posLT.offset(0, -1), cu, CHANNEL_TYPE_LUMA) != NULL) && cs.isDecomp(posLT.offset(0, -1), CHANNEL_TYPE_LUMA);\par
00816   {\cf20 // ----- Step 1: unfiltered reference samples -----}\par
00817   {\cf19 if} (cu.blocks[area.compID].x == area.x && cu.blocks[area.compID].y == area.y)\par
00818   \{\par
00819     Pel *refBufUnfiltered = m_refBuffer[area.compID][PRED_BUF_UNFILTERED];\par
00820     {\cf20 // With the first subpartition all the CU reference samples are fetched at once in a single call to xFillReferenceSamples}\par
00821     {\cf19 if} (cu.ispMode == HOR_INTRA_SUBPARTITIONS)\par
00822     \{\par
00823       m_leftRefLength = cu.Y().height << 1;\par
00824       m_topRefLength = cu.Y().width + area.width;\par
00825     \}\par
00826     {\cf19 else} {\cf20 //if (cu.ispMode == VER_INTRA_SUBPARTITIONS)}\par
00827     \{\par
00828       m_leftRefLength = cu.Y().height + area.height;\par
00829       m_topRefLength = cu.Y().width << 1;\par
00830     \}\par
00831 \par
00832 \par
00833     xFillReferenceSamples(cs.picture->getRecoBuf(cu.Y()), refBufUnfiltered, cu.Y(), cu);\par
00834 \par
00835     {\cf20 // After having retrieved all the CU reference samples, the number of reference samples is now adjusted for the current subpartition}\par
00836     m_topRefLength = cu.blocks[area.compID].width + area.width;\par
00837     m_leftRefLength = cu.blocks[area.compID].height + area.height;\par
00838   \}\par
00839   {\cf19 else}\par
00840   \{\par
00841     m_topRefLength = cu.blocks[area.compID].width + area.width;\par
00842     m_leftRefLength = cu.blocks[area.compID].height + area.height;\par
00843 \par
00844     {\cf17 const} {\cf18 int} predSizeHor = m_topRefLength;\par
00845     {\cf17 const} {\cf18 int} predSizeVer = m_leftRefLength;\par
00846     {\cf19 if} (cu.ispMode == HOR_INTRA_SUBPARTITIONS)\par
00847     \{\par
00848       Pel* src = recBuf.bufAt(0, -1);\par
00849       Pel *ref = m_refBuffer[area.compID][PRED_BUF_UNFILTERED] + m_refBufferStride[area.compID];\par
00850       {\cf19 if} (isLeftAvail)\par
00851       \{\par
00852         {\cf19 for} ({\cf18 int} i = 0; i <= 2 * cu.blocks[area.compID].height - area.height; i++)\par
00853         \{\par
00854           ref[i] = ref[i + area.height];\par
00855         \}\par
00856       \}\par
00857       {\cf19 else}\par
00858       \{\par
00859         {\cf19 for} ({\cf18 int} i = 0; i <= predSizeVer; i++)\par
00860         \{\par
00861           ref[i] = src[0];\par
00862         \}\par
00863       \}\par
00864       Pel *dst = m_refBuffer[area.compID][PRED_BUF_UNFILTERED] + 1;\par
00865       dst[-1]  = ref[0];\par
00866       {\cf19 for} ({\cf18 int} i = 0; i < area.width; i++)\par
00867       \{\par
00868         dst[i] = src[i];\par
00869       \}\par
00870       Pel sample = src[area.width - 1];\par
00871       dst += area.width;\par
00872       {\cf19 for} ({\cf18 int} i = 0; i < predSizeHor - area.width; i++)\par
00873       \{\par
00874         dst[i] = sample;\par
00875       \}\par
00876     \}\par
00877     {\cf19 else}\par
00878     \{\par
00879       Pel* src = recBuf.bufAt(-1, 0);\par
00880       Pel *ref = m_refBuffer[area.compID][PRED_BUF_UNFILTERED];\par
00881       {\cf19 if} (isAboveAvail)\par
00882       \{\par
00883         {\cf19 for} ({\cf18 int} i = 0; i <= 2 * cu.blocks[area.compID].width - area.width; i++)\par
00884         \{\par
00885           ref[i] = ref[i + area.width];\par
00886         \}\par
00887       \}\par
00888       {\cf19 else}\par
00889       \{\par
00890         {\cf19 for} ({\cf18 int} i = 0; i <= predSizeHor; i++)\par
00891         \{\par
00892           ref[i] = src[0];\par
00893         \}\par
00894       \}\par
00895       Pel *dst = m_refBuffer[area.compID][PRED_BUF_UNFILTERED] + m_refBufferStride[area.compID] + 1;\par
00896       dst[-1]  = ref[0];\par
00897       {\cf19 for} ({\cf18 int} i = 0; i < area.height; i++)\par
00898       \{\par
00899         *dst = *src;\par
00900         src += recBuf.stride;\par
00901         dst++;\par
00902       \}\par
00903       Pel sample = src[-recBuf.stride];\par
00904       {\cf19 for} ({\cf18 int} i = 0; i < predSizeVer - area.height; i++)\par
00905       \{\par
00906         *dst = sample;\par
00907         dst++;\par
00908       \}\par
00909     \}\par
00910   \}\par
00911   {\cf20 // ----- Step 2: filtered reference samples -----}\par
00912   {\cf19 if} (m_ipaParam.refFilterFlag || forceRefFilterFlag)\par
00913   \{\par
00914     Pel *refBufUnfiltered = m_refBuffer[area.compID][PRED_BUF_UNFILTERED];\par
00915     Pel *refBufFiltered   = m_refBuffer[area.compID][PRED_BUF_FILTERED];\par
00916     xFilterReferenceSamples(refBufUnfiltered, refBufFiltered, area, *cs.sps, cu.firstPU->multiRefIdx);\par
00917   \}\par
00918 \}\par
00919 \par
00920 \par
00921 {\cf18 void} IntraPrediction::xFillReferenceSamples( {\cf17 const} CPelBuf &recoBuf, Pel* refBufUnfiltered, {\cf17 const} CompArea &area, {\cf17 const} CodingUnit &cu )\par
00922 \{\par
00923   {\cf17 const} ChannelType      chType = toChannelType( area.compID );\par
00924   {\cf17 const} CodingStructure &cs     = *cu.cs;\par
00925   {\cf17 const} SPS             &sps    = *cs.sps;\par
00926   {\cf17 const} PreCalcValues   &pcv    = *cs.pcv;\par
00927 \par
00928   {\cf17 const} {\cf18 int} multiRefIdx         = (area.compID == COMPONENT_Y) ? cu.firstPU->multiRefIdx : 0;\par
00929 \par
00930   {\cf17 const} {\cf18 int}  tuWidth            = area.width;\par
00931   {\cf17 const} {\cf18 int}  tuHeight           = area.height;\par
00932   {\cf17 const} {\cf18 int}  predSize           = m_topRefLength;\par
00933   {\cf17 const} {\cf18 int}  predHSize          = m_leftRefLength;\par
00934   {\cf17 const} {\cf18 int} predStride = predSize + 1 + multiRefIdx;\par
00935   m_refBufferStride[area.compID] = predStride;\par
00936 \par
00937   {\cf17 const} {\cf18 bool} noShift            = pcv.noChroma2x2 && area.width == 4; {\cf20 // don't shift on the lowest level (chroma not-split)}\par
00938   {\cf17 const} {\cf18 int}  unitWidth          = tuWidth  <= 2 && cu.ispMode && isLuma(area.compID) ? tuWidth  : pcv.minCUWidth  >> (noShift ? 0 : getComponentScaleX(area.compID, sps.getChromaFormatIdc()));\par
00939   {\cf17 const} {\cf18 int}  unitHeight         = tuHeight <= 2 && cu.ispMode && isLuma(area.compID) ? tuHeight : pcv.minCUHeight >> (noShift ? 0 : getComponentScaleY(area.compID, sps.getChromaFormatIdc()));\par
00940 \par
00941   {\cf17 const} {\cf18 int}  totalAboveUnits    = (predSize + (unitWidth - 1)) / unitWidth;\par
00942   {\cf17 const} {\cf18 int}  totalLeftUnits     = (predHSize + (unitHeight - 1)) / unitHeight;\par
00943   {\cf17 const} {\cf18 int}  totalUnits         = totalAboveUnits + totalLeftUnits + 1; {\cf20 //+1 for top-left}\par
00944   {\cf17 const} {\cf18 int}  numAboveUnits      = std::max<int>( tuWidth / unitWidth, 1 );\par
00945   {\cf17 const} {\cf18 int}  numLeftUnits       = std::max<int>( tuHeight / unitHeight, 1 );\par
00946   {\cf17 const} {\cf18 int}  numAboveRightUnits = totalAboveUnits - numAboveUnits;\par
00947   {\cf17 const} {\cf18 int}  numLeftBelowUnits  = totalLeftUnits - numLeftUnits;\par
00948 \par
00949   CHECK( numAboveUnits <= 0 || numLeftUnits <= 0 || numAboveRightUnits <= 0 || numLeftBelowUnits <= 0, {\cf22 "Size not supported"} );\par
00950 \par
00951   {\cf20 // ----- Step 1: analyze neighborhood -----}\par
00952   {\cf17 const} Position posLT          = area;\par
00953   {\cf17 const} Position posRT          = area.topRight();\par
00954   {\cf17 const} Position posLB          = area.bottomLeft();\par
00955 \par
00956   {\cf18 bool}  neighborFlags[4 * MAX_NUM_PART_IDXS_IN_CTU_WIDTH + 1];\par
00957   {\cf18 int}   numIntraNeighbor = 0;\par
00958 \par
00959   memset( neighborFlags, 0, totalUnits );\par
00960 \par
00961   neighborFlags[totalLeftUnits] = isAboveLeftAvailable( cu, chType, posLT );\par
00962   numIntraNeighbor += neighborFlags[totalLeftUnits] ? 1 : 0;\par
00963   numIntraNeighbor += isAboveAvailable     ( cu, chType, posLT, numAboveUnits,      unitWidth,  (neighborFlags + totalLeftUnits + 1) );\par
00964   numIntraNeighbor += isAboveRightAvailable( cu, chType, posRT, numAboveRightUnits, unitWidth,  (neighborFlags + totalLeftUnits + 1 + numAboveUnits) );\par
00965   numIntraNeighbor += isLeftAvailable      ( cu, chType, posLT, numLeftUnits,       unitHeight, (neighborFlags + totalLeftUnits - 1) );\par
00966   numIntraNeighbor += isBelowLeftAvailable ( cu, chType, posLB, numLeftBelowUnits,  unitHeight, (neighborFlags + totalLeftUnits - 1 - numLeftUnits) );\par
00967 \par
00968   {\cf20 // ----- Step 2: fill reference samples (depending on neighborhood) -----}\par
00969 \par
00970   {\cf17 const} Pel*  srcBuf    = recoBuf.buf;\par
00971   {\cf17 const} {\cf18 int}   srcStride = recoBuf.stride;\par
00972         Pel*  ptrDst    = refBufUnfiltered;\par
00973   {\cf17 const} Pel*  ptrSrc;\par
00974   {\cf17 const} Pel   valueDC   = 1 << (sps.getBitDepth( chType ) - 1);\par
00975 \par
00976   {\cf19 if}( numIntraNeighbor == 0 )\par
00977   \{\par
00978     {\cf20 // Fill border with DC value}\par
00979     {\cf19 for} ({\cf18 int} j = 0; j <= predSize + multiRefIdx; j++)\par
00980     \{\par
00981       ptrDst[j] = valueDC;\par
00982     \}\par
00983     {\cf19 for} ({\cf18 int} i = 0; i <= predHSize + multiRefIdx; i++)\par
00984     \{\par
00985       ptrDst[i + predStride] = valueDC;\par
00986     \}\par
00987   \}\par
00988   {\cf19 else} {\cf19 if}( numIntraNeighbor == totalUnits )\par
00989   \{\par
00990     {\cf20 // Fill top-left border and top and top right with rec. samples}\par
00991     ptrSrc = srcBuf - (1 + multiRefIdx) * srcStride - (1 + multiRefIdx);\par
00992     {\cf19 for} ({\cf18 int} j = 0; j <= predSize + multiRefIdx; j++)\par
00993     \{\par
00994       ptrDst[j] = ptrSrc[j];\par
00995     \}\par
00996     {\cf19 for} ({\cf18 int} i = 0; i <= predHSize + multiRefIdx; i++)\par
00997     \{\par
00998       ptrDst[i + predStride] = ptrSrc[i * srcStride];\par
00999     \}\par
01000   \}\par
01001   {\cf19 else} {\cf20 // reference samples are partially available}\par
01002   \{\par
01003     {\cf20 // Fill top-left sample(s) if available}\par
01004     ptrSrc = srcBuf - (1 + multiRefIdx) * srcStride - (1 + multiRefIdx);\par
01005     ptrDst = refBufUnfiltered;\par
01006     {\cf19 if} (neighborFlags[totalLeftUnits])\par
01007     \{\par
01008       ptrDst[0] = ptrSrc[0];\par
01009       ptrDst[predStride] = ptrSrc[0];\par
01010       {\cf19 for} ({\cf18 int} i = 1; i <= multiRefIdx; i++)\par
01011       \{\par
01012         ptrDst[i] = ptrSrc[i];\par
01013         ptrDst[i + predStride] = ptrSrc[i * srcStride];\par
01014       \}\par
01015     \}\par
01016 \par
01017     {\cf20 // Fill left & below-left samples if available (downwards)}\par
01018     ptrSrc += (1 + multiRefIdx) * srcStride;\par
01019     ptrDst += (1 + multiRefIdx) + predStride;\par
01020     {\cf19 for} ({\cf18 int} unitIdx = totalLeftUnits - 1; unitIdx > 0; unitIdx--)\par
01021     \{\par
01022       {\cf19 if} (neighborFlags[unitIdx])\par
01023       \{\par
01024         {\cf19 for} ({\cf18 int} i = 0; i < unitHeight; i++)\par
01025         \{\par
01026           ptrDst[i] = ptrSrc[i * srcStride];\par
01027         \}\par
01028       \}\par
01029       ptrSrc += unitHeight * srcStride;\par
01030       ptrDst += unitHeight;\par
01031     \}\par
01032     {\cf20 // Fill last below-left sample(s)}\par
01033     {\cf19 if} (neighborFlags[0])\par
01034     \{\par
01035       {\cf18 int} lastSample = (predHSize % unitHeight == 0) ? unitHeight : predHSize % unitHeight;\par
01036       {\cf19 for} ({\cf18 int} i = 0; i < lastSample; i++)\par
01037       \{\par
01038         ptrDst[i] = ptrSrc[i * srcStride];\par
01039       \}\par
01040     \}\par
01041 \par
01042     {\cf20 // Fill above & above-right samples if available (left-to-right)}\par
01043     ptrSrc = srcBuf - srcStride * (1 + multiRefIdx);\par
01044     ptrDst = refBufUnfiltered + 1 + multiRefIdx;\par
01045     {\cf19 for} ({\cf18 int} unitIdx = totalLeftUnits + 1; unitIdx < totalUnits - 1; unitIdx++)\par
01046     \{\par
01047       {\cf19 if} (neighborFlags[unitIdx])\par
01048       \{\par
01049         {\cf19 for} ({\cf18 int} j = 0; j < unitWidth; j++)\par
01050         \{\par
01051           ptrDst[j] = ptrSrc[j];\par
01052         \}\par
01053       \}\par
01054       ptrSrc += unitWidth;\par
01055       ptrDst += unitWidth;\par
01056     \}\par
01057     {\cf20 // Fill last above-right sample(s)}\par
01058     {\cf19 if} (neighborFlags[totalUnits - 1])\par
01059     \{\par
01060       {\cf18 int} lastSample = (predSize % unitWidth == 0) ? unitWidth : predSize % unitWidth;\par
01061       {\cf19 for} ({\cf18 int} j = 0; j < lastSample; j++)\par
01062       \{\par
01063         ptrDst[j] = ptrSrc[j];\par
01064       \}\par
01065     \}\par
01066 \par
01067     {\cf20 // pad from first available down to the last below-left}\par
01068     ptrDst = refBufUnfiltered;\par
01069     {\cf18 int} lastAvailUnit = 0;\par
01070     {\cf19 if} (!neighborFlags[0])\par
01071     \{\par
01072       {\cf18 int} firstAvailUnit = 1;\par
01073       {\cf19 while} (firstAvailUnit < totalUnits && !neighborFlags[firstAvailUnit])\par
01074       \{\par
01075         firstAvailUnit++;\par
01076       \}\par
01077 \par
01078       {\cf20 // first available sample}\par
01079       {\cf18 int} firstAvailRow = -1;\par
01080       {\cf18 int} firstAvailCol = 0;\par
01081       {\cf19 if} (firstAvailUnit < totalLeftUnits)\par
01082       \{\par
01083         firstAvailRow = (totalLeftUnits - firstAvailUnit) * unitHeight + multiRefIdx;\par
01084       \}\par
01085       {\cf19 else} {\cf19 if} (firstAvailUnit == totalLeftUnits)\par
01086       \{\par
01087         firstAvailRow = multiRefIdx;\par
01088       \}\par
01089       {\cf19 else}\par
01090       \{\par
01091         firstAvailCol = (firstAvailUnit - totalLeftUnits - 1) * unitWidth + 1 + multiRefIdx;\par
01092       \}\par
01093       {\cf17 const} Pel firstAvailSample = ptrDst[firstAvailRow < 0 ? firstAvailCol : firstAvailRow + predStride];\par
01094 \par
01095       {\cf20 // last sample below-left (n.a.)}\par
01096       {\cf18 int} lastRow = predHSize + multiRefIdx;\par
01097 \par
01098       {\cf20 // fill left column}\par
01099       {\cf19 for} ({\cf18 int} i = lastRow; i > firstAvailRow; i--)\par
01100       \{\par
01101         ptrDst[i + predStride] = firstAvailSample;\par
01102       \}\par
01103       {\cf20 // fill top row}\par
01104       {\cf19 if} (firstAvailCol > 0)\par
01105       \{\par
01106         {\cf19 for} ({\cf18 int} j = 0; j < firstAvailCol; j++)\par
01107         \{\par
01108           ptrDst[j] = firstAvailSample;\par
01109         \}\par
01110       \}\par
01111       lastAvailUnit = firstAvailUnit;\par
01112     \}\par
01113 \par
01114     {\cf20 // pad all other reference samples.}\par
01115     {\cf18 int} currUnit = lastAvailUnit + 1;\par
01116     {\cf19 while} (currUnit < totalUnits)\par
01117     \{\par
01118       {\cf19 if} (!neighborFlags[currUnit]) {\cf20 // samples not available}\par
01119       \{\par
01120         {\cf20 // last available sample}\par
01121         {\cf18 int} lastAvailRow = -1;\par
01122         {\cf18 int} lastAvailCol = 0;\par
01123         {\cf19 if} (lastAvailUnit < totalLeftUnits)\par
01124         \{\par
01125           lastAvailRow = (totalLeftUnits - lastAvailUnit - 1) * unitHeight + multiRefIdx + 1;\par
01126         \}\par
01127         {\cf19 else} {\cf19 if} (lastAvailUnit == totalLeftUnits)\par
01128         \{\par
01129           lastAvailCol = multiRefIdx;\par
01130         \}\par
01131         {\cf19 else}\par
01132         \{\par
01133           lastAvailCol = (lastAvailUnit - totalLeftUnits) * unitWidth + multiRefIdx;\par
01134         \}\par
01135         {\cf17 const} Pel lastAvailSample = ptrDst[lastAvailRow < 0 ? lastAvailCol : lastAvailRow + predStride];\par
01136 \par
01137         {\cf20 // fill current unit with last available sample}\par
01138         {\cf19 if} (currUnit < totalLeftUnits)\par
01139         \{\par
01140           {\cf19 for} ({\cf18 int} i = lastAvailRow - 1; i >= lastAvailRow - unitHeight; i--)\par
01141           \{\par
01142             ptrDst[i + predStride] = lastAvailSample;\par
01143           \}\par
01144         \}\par
01145         {\cf19 else} {\cf19 if} (currUnit == totalLeftUnits)\par
01146         \{\par
01147           {\cf19 for} ({\cf18 int} i = 0; i < multiRefIdx + 1; i++)\par
01148           \{\par
01149             ptrDst[i + predStride] = lastAvailSample;\par
01150           \}\par
01151           {\cf19 for} ({\cf18 int} j = 0; j < multiRefIdx + 1; j++)\par
01152           \{\par
01153             ptrDst[j] = lastAvailSample;\par
01154           \}\par
01155         \}\par
01156         {\cf19 else}\par
01157         \{\par
01158           {\cf18 int} numSamplesInUnit = (currUnit == totalUnits - 1) ? ((predSize % unitWidth == 0) ? unitWidth : predSize % unitWidth) : unitWidth;\par
01159           {\cf19 for} ({\cf18 int} j = lastAvailCol + 1; j <= lastAvailCol + numSamplesInUnit; j++)\par
01160           \{\par
01161             ptrDst[j] = lastAvailSample;\par
01162           \}\par
01163         \}\par
01164       \}\par
01165       lastAvailUnit = currUnit;\par
01166       currUnit++;\par
01167     \}\par
01168   \}\par
01169 \}\par
01170 \par
01171 {\cf18 void} IntraPrediction::xFilterReferenceSamples({\cf17 const} Pel *refBufUnfiltered, Pel *refBufFiltered, {\cf17 const} CompArea &area,\par
01172                                               {\cf17 const} SPS &sps, {\cf18 int} multiRefIdx)\par
01173 \{\par
01174   {\cf19 if} (area.compID != COMPONENT_Y)\par
01175   \{\par
01176     multiRefIdx = 0;\par
01177   \}\par
01178   {\cf17 const} {\cf18 int} predSize = m_topRefLength + multiRefIdx;\par
01179   {\cf17 const} {\cf18 int} predHSize = m_leftRefLength + multiRefIdx;\par
01180   {\cf17 const} {\cf18 size_t} predStride = m_refBufferStride[area.compID];\par
01181 \par
01182   {\cf17 const} Pel topLeft =\par
01183     (refBufUnfiltered[0] + refBufUnfiltered[1] + refBufUnfiltered[predStride] + refBufUnfiltered[predStride + 1] + 2)\par
01184     >> 2;\par
01185 \par
01186   refBufFiltered[0] = topLeft;\par
01187 \par
01188   {\cf19 for} ({\cf18 int} i = 1; i < predSize; i++)\par
01189   \{\par
01190     refBufFiltered[i] = (refBufUnfiltered[i - 1] + 2 * refBufUnfiltered[i] + refBufUnfiltered[i + 1] + 2) >> 2;\par
01191   \}\par
01192   refBufFiltered[predSize] = refBufUnfiltered[predSize];\par
01193 \par
01194   refBufFiltered += predStride;\par
01195   refBufUnfiltered += predStride;\par
01196 \par
01197   refBufFiltered[0] = topLeft;\par
01198 \par
01199   {\cf19 for} ({\cf18 int} i = 1; i < predHSize; i++)\par
01200   \{\par
01201     refBufFiltered[i] = (refBufUnfiltered[i - 1] + 2 * refBufUnfiltered[i] + refBufUnfiltered[i + 1] + 2) >> 2;\par
01202   \}\par
01203   refBufFiltered[predHSize] = refBufUnfiltered[predHSize];\par
01204 \}\par
