00215 {\cf18 void} IntraPrediction::predIntraAng( {\cf17 const} ComponentID compId, PelBuf &piPred, {\cf17 const} PredictionUnit &pu)\par
00216 \{\par
00217   {\cf17 const} ComponentID    compID       = MAP_CHROMA( compId );\par
00218   {\cf17 const} ChannelType    channelType  = toChannelType( compID );\par
00219   {\cf17 const} {\cf18 int}            iWidth       = piPred.width;\par
00220   {\cf17 const} {\cf18 int}            iHeight      = piPred.height;\par
00221   CHECK(iWidth == 2, {\cf22 "Width of 2 is not supported"});\par
00222   CHECK(PU::isMIP(pu, toChannelType(compId)), {\cf22 "We should not get here for MIP."});\par
00223   {\cf17 const} uint32_t       uiDirMode    = isLuma( compId ) && pu.cu->bdpcmMode ? BDPCM_IDX : !isLuma(compId) && pu.cu->bdpcmModeChroma ? BDPCM_IDX : PU::getFinalIntraMode(pu, channelType);\par
00224 \par
00225   CHECK( floorLog2(iWidth) < 2 && pu.cs->pcv->noChroma2x2, {\cf22 "Size not allowed"} );\par
00226   CHECK( floorLog2(iWidth) > 7, {\cf22 "Size not allowed"} );\par
00227 \par
00228   {\cf17 const} {\cf18 int} srcStride  = m_refBufferStride[compID];\par
00229   {\cf17 const} {\cf18 int} srcHStride = 2;\par
00230 \par
00231   {\cf17 const} CPelBuf & srcBuf = CPelBuf(getPredictorPtr(compID), srcStride, srcHStride);\par
00232   {\cf17 const} ClpRng& clpRng(pu.cu->cs->slice->clpRng(compID));\par
00233 \par
00234   {\cf19 switch} (uiDirMode)\par
00235   \{\par
00236     {\cf19 case}(PLANAR_IDX): xPredIntraPlanar(srcBuf, piPred); {\cf19 break};\par
00237     {\cf19 case}(DC_IDX):     xPredIntraDc(srcBuf, piPred, channelType, {\cf17 false}); {\cf19 break};\par
00238     {\cf19 case}(BDPCM_IDX):  xPredIntraBDPCM(srcBuf, piPred, isLuma(compID) ? pu.cu->bdpcmMode : pu.cu->bdpcmModeChroma, clpRng); {\cf19 break};\par
00239     {\cf19 default}:          xPredIntraAng(srcBuf, piPred, channelType, clpRng); {\cf19 break};\par
00240   \}\par
00241 \par
00242   {\cf19 if} (m_ipaParam.applyPDPC)\par
00243   \{\par
00244     PelBuf dstBuf = piPred;\par
00245     {\cf17 const} {\cf18 int} scale = ((floorLog2(iWidth) - 2 + floorLog2(iHeight) - 2 + 2) >> 2);\par
00246     CHECK(scale < 0 || scale > 31, {\cf22 "PDPC: scale < 0 || scale > 31"});\par
00247 \par
00248     {\cf19 if} (uiDirMode == PLANAR_IDX || uiDirMode == DC_IDX)\par
00249     \{\par
00250       {\cf19 for} ({\cf18 int} y = 0; y < iHeight; y++)\par
00251       \{\par
00252         {\cf17 const} {\cf18 int} wT   = 32 >> std::min(31, ((y << 1) >> scale));\par
00253         {\cf17 const} Pel left = srcBuf.at(y + 1, 1);\par
00254         {\cf19 for} ({\cf18 int} x = 0; x < iWidth; x++)\par
00255         \{\par
00256           {\cf17 const} {\cf18 int} wL    = 32 >> std::min(31, ((x << 1) >> scale));\par
00257           {\cf17 const} Pel top   = srcBuf.at(x + 1, 0);\par
00258           {\cf17 const} Pel val   = dstBuf.at(x, y);\par
00259           dstBuf.at(x, y) = val + ((wL * (left - val) + wT * (top - val) + 32) >> 6);\par
00260         \}\par
00261       \}\par
00262     \}\par
00263   \}\par
00264 \}\par
00265 \par
00266 {\cf18 void} IntraPrediction::predIntraChromaLM({\cf17 const} ComponentID compID, PelBuf &piPred, {\cf17 const} PredictionUnit &pu, {\cf17 const} CompArea& chromaArea, {\cf18 int} intraDir)\par
00267 \{\par
00268   {\cf18 int}  iLumaStride = 0;\par
00269   PelBuf Temp;\par
00270   {\cf19 if} ((intraDir == MDLM_L_IDX) || (intraDir == MDLM_T_IDX))\par
00271   \{\par
00272     iLumaStride = 2 * MAX_CU_SIZE + 1;\par
00273     Temp = PelBuf(m_pMdlmTemp + iLumaStride + 1, iLumaStride, Size(chromaArea));\par
00274   \}\par
00275   {\cf19 else}\par
00276   \{\par
00277     iLumaStride = MAX_CU_SIZE + 1;\par
00278     Temp = PelBuf(m_piTemp + iLumaStride + 1, iLumaStride, Size(chromaArea));\par
00279   \}\par
00280   {\cf18 int} a, b, iShift;\par
00281   xGetLMParameters(pu, compID, chromaArea, a, b, iShift);\par
00282 \par
00284   piPred.copyFrom(Temp);\par
00285   piPred.linearTransform(a, iShift, b, {\cf17 true}, pu.cs->slice->clpRng(compID));\par
00286 \}\par
