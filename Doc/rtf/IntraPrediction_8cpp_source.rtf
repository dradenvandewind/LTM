00758       initIntraPatternChType(cu, pu->Cr());\par
00759       predIntraAng(COMPONENT_Cr, cu.cs->getPredBuf(*pu).Cr(), *pu);\par
00760     \}\par
00761   \}\par
00762   {\cf19 for} ({\cf18 int} currCompID = 0; currCompID < maxCompID; currCompID++)\par
