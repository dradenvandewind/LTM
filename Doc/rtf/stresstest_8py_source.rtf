00156 {\cf17 def }run_subprocess(title, args, logfile, scriptfile, show_progress):\par
00157     {\cf22 """Run a comamnd as a subprocess - report progress and capture output (both stderr and stdout) to a log file."""}\par
00158 \par
00159     {\cf17 with} open(logfile, {\cf22 "wt"}) {\cf17 as} log:\par
00160         sys.stderr.write(f{\cf22 "    \{title\}: Start\\r"})\par
00161         {\cf19 if} show_progress:\par
00162             sys.stderr.write({\cf22 "\\r"})\par
00163         {\cf19 else}:\par
00164             sys.stderr.write({\cf22 "\\n"})\par
00165 \par
00166         print({\cf22 " "}.join(args), file=log)\par
00167 \par
00168         {\cf17 with} subprocess.Popen(args, bufsize=1, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\par
00169                               universal_newlines={\cf17 True}) {\cf17 as} p:\par
00170             {\cf19 for} n,l {\cf19 in} enumerate(p.stdout):\par
00171                 {\cf20 # Progress}\par
00172                 {\cf19 if} show_progress == {\cf22 "spinner"}:\par
00173                     progress_indicator = {\cf22 "|/-\\\\|/-\\\\"}[n % 8]\par
00174                     sys.stderr.write(f{\cf22 "    \{title\}: \{progress_indicator\}      \\r"})\par
00175                 {\cf19 elif} show_progress == {\cf22 "verbose"}:\par
00176                     sys.stderr.write(l)\par
00177                 {\cf20 # Log file}\par
00178                 print(l.strip(), file=log)\par
00179 \par
00180             {\cf19 if} p.wait() != 0:\par
00181                 sys.stderr.write(f{\cf22 "    \{title\}: FAILED\\n"})\par
00182                 {\cf19 return} {\cf17 False}\par
00183 \par
00184     sys.stderr.write(f{\cf22 "    \{title\}: OK\\n"})\par
00185 \par
00186     {\cf20 # Write scripts}\par
00187     {\cf19 if} scriptfile:\par
00188         {\cf17 with} open(scriptfile + {\cf22 ".sh"}, {\cf22 "wt"}) {\cf17 as} f:\par
00189             f.write({\cf22 "#!/bin/bash\\n"})\par
00190             f.write({\cf22 "$\{LTM_PATH\}"} + os.path.basename(args[0]) + {\cf22 " "} + {\cf22 " "}.join(args[1:]))\par
00191             f.write({\cf22 "\\n"})\par
00192 \par
00193         {\cf17 with} open(scriptfile + {\cf22 ".bat"}, {\cf22 "wt"}) {\cf17 as} f:\par
00194             f.write({\cf22 "@echo off\\n"})\par
00195             f.write({\cf22 "%LTM_PATH%"} + os.path.basename(args[0]) + {\cf22 ".exe "} + {\cf22 " "}.join(args[1:]))\par
00196             f.write({\cf22 "\\n"})\par
00197 \par
00198     {\cf19 return} {\cf17 True}\par
