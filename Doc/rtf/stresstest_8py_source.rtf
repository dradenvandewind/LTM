00131 {\cf17 def }create_txt_file(width, height, output, description):\par
00132     sample_rate = width * height * 50\par
00133     {\cf19 if} sample_rate <= 29410000:\par
00134         level = 1\par
00135     {\cf19 elif} sample_rate <= 124560000:\par
00136         level = 2\par
00137     {\cf19 elif} sample_rate <= 527650000:\par
00138         level = 3\par
00139     {\cf19 else}:\par
00140         level = 4\par
00141     lines = [\par
