00392 {\cf17 def }run_tests(args):\par
00393     {\cf22 """Read a JSON array and run test described by each entry."""}\par
00394 \par
00395     fails = 0\par
00396 \par
00397     {\cf20 # Load tests}\par
00398     {\cf17 with} open(args.test_file) {\cf17 as} f:\par
00399         tests = json.load(f)\par
00400 \par
00401     {\cf19 if} type(tests) != list:\par
00402         print({\cf22 "Top level of tests JSON must be an array."}, file=sys.stderr)\par
00403         {\cf19 return} 1\par
00404 \par
00405     default_parameters = json.loads(args.parameters)\par
00406 \par
00407     {\cf19 if} args.sets:\par
00408         test_set = set(args.sets.split({\cf22 ','}))\par
00409     {\cf19 else}:\par
00410         test_set = set()\par
00411 \par
00412     \par
00413     test_jobs = []\par
00414     {\cf19 for} n,test {\cf19 in} enumerate(tests):\par
00415 \par
00416         {\cf20 # Single test}\par
00417         {\cf19 if} args.single {\cf19 and} test[{\cf22 'name'}] != args.single:\par
00418             {\cf19 continue}\par
00419 \par
00420         {\cf20 # Sets of tests}\par
00421         {\cf19 if} test_set:\par
00422             {\cf19 if} {\cf22 'sets'} {\cf19 not} {\cf19 in} test {\cf19 or} test_set.isdisjoint(set(test[{\cf22 'sets'}])):\par
00423                 {\cf19 continue}\par
00424 \par
00425         test_jobs.append(\{\par
00426             {\cf22 'number'}:n,\par
00427             {\cf22 'test'}:test,\par
00428             {\cf22 'encoder'}:os.path.abspath(args.encoder),\par
00429             {\cf22 'decoder'}:os.path.abspath(args.decoder),\par
00430             {\cf22 'input_dir'}:args.input_dir,\par
00431             {\cf22 'base_dir'}:args.base_dir,\par
00432             {\cf22 'default_parameters'}:default_parameters,\par
00433             {\cf22 'label'}:args.label,\par
00434             {\cf22 'update_checksums'}:args.updated_checksums != {\cf22 ""},\par
00435             {\cf22 'show_progress'}: args.progress,\par
00436             {\cf22 'decode_only'}: args.decode_only\})\par
00437 \par
00438     \par
00439     {\cf19 if} args.parallel == {\cf22 "0"}:\par
00440         print(f{\cf22 "Running \{len(test_jobs)\} tests"}, file=sys.stderr)\par
00441         {\cf20 # Run jobs serially in process}\par
00442         {\cf19 for} j {\cf19 in} test_jobs:\par
00443             ok = test_encode_decode(**j)\par
00444             {\cf19 if} {\cf19 not} ok:\par
00445                 fails += 1\par
00446     {\cf19 else}:\par
00447         print(f{\cf22 "Running \{len(test_jobs)\} tests using \{args.parallel\} workers"}, file=sys.stderr)\par
00448         {\cf20 # Run jobs in parallel in seperate processes}\par
00449         {\cf17 with} concurrent.futures.ProcessPoolExecutor(max_workers=int(args.parallel)) {\cf17 as} executor:\par
00450             {\cf19 for} ok,n,updated_test {\cf19 in} executor.map(run_test, test_jobs):\par
00451                 {\cf19 if} {\cf19 not} ok:\par
00452                     fails += 1\par
00453                 {\cf19 if} ok {\cf19 and} args.updated_checksums:\par
00454                     {\cf20 # Collect updated data from subprocess}\par
00455                     tests[n] = updated_test\par
00456 \par
00457     {\cf19 if} fails != 0:\par
00458         print(f{\cf22 "Tests failed: \{fails\}"}, file=sys.stderr)\par
00459 \par
00460     \par
00461     {\cf19 if} args.updated_checksums:\par
00462         {\cf17 with} open(args.updated_checksums, {\cf22 "wt"}) {\cf17 as} f:\par
00463             json.dump(tests, f, indent=4)\par
00464 \par
00465     {\cf19 return} fails\par
