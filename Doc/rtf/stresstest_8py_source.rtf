\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 {\cf20 #!/usr/bin/env python3.7}\par
00002 {\cf20 #}\par
00003 {\cf20 # encodertest.py [--encoder=<encoder>]}\par
00004 {\cf20 #                [--decoder=<decoder>]}\par
00005 {\cf20 #                [--test_file=<tests-json>]}\par
00006 {\cf20 #                [--checksums_file=<checksums-json>]}\par
00007 {\cf20 #                [--label=<label>]}\par
00008 {\cf20 #                [--input_dir=<dir>]}\par
00009 {\cf20 #                [--base_dir=<dir>]}\par
00010 {\cf20 #                [--progress=none|spinner|verbose]}\par
00011 {\cf20 #                [--sets=<string>,..]}\par
00012 {\cf20 #                [--single=<string>]}\par
00013 {\cf20 #                [--parallel=<number>]}\par
00014 {\cf20 #                [--generate_checksums_file=<file>]}\par
00015 {\cf20 #}\par
00016 {\cf20 # JSON schema:}\par
00017 {\cf20 #}\par
00018 {\cf20 # [ // Array of tests}\par
00019 {\cf20 #   \{}\par
00020 {\cf20 #       "description" : <string>  // optional, human readable description}\par
00021 {\cf20 #       "name" : <string>         // identifier used to identity directory and files generated by test}\par
00022 {\cf20 #       "include-parameters" : <filename> // optional, start with parameters in named file then apply 'paramaters'}\par
00023 {\cf20 #       "parameters" : \{ ... \}    // json dictionary of codec parameters}\par
00024 {\cf20 #       "sets" : [ <strings> ]    // optional, list  of sets that include this test - controller by  command line --sets=...}\par
00025 {\cf20 #       "generate_base" : <bool>  // optional, control whether base+ercon should be encoded for this test, overriding command line}\par
00026 {\cf20 #   \}}\par
00027 {\cf20 #    ...}\par
00028 {\cf20 # ]}\par
00029 {\cf20 #}\par
00030 {\cf20 # NB: Some parameters are treated specially:}\par
00031 {\cf20 #}\par
00032 {\cf20 #   - input_file: width, height, fps, bit_depth and format are extracted from filename if present (but are overridden by expicit params)}\par
00033 {\cf20 #}\par
00034 {\cf20 #   - input_file, base,  base_recon: Input directory is prepended}\par
00035 {\cf20 #}\par
00036 {\cf17 import} json\par
00037 {\cf17 import} csv\par
00038 {\cf17 import} xxhash,hashlib\par
00039 {\cf17 import} os, os.path\par
00040 {\cf17 import} re\par
00041 {\cf17 import} subprocess\par
00042 {\cf17 import} sys\par
00043 {\cf17 import} concurrent.futures\par
00044 \par
00045 {\cf17 def }platform_exe(path, name):\par
00046     {\cf22 """Given a directory and an executable file name, return platform specifix path."""}\par
00047     exesuffix = \{{\cf22 "win32"}:{\cf22 ".exe"},{\cf22 "linux"}:{\cf22 ""}\}\par
00048     {\cf19 return} os.path.join(path, name+exesuffix.get(sys.platform,{\cf22 ""}))\par
00049 \par
00050 \par
00051 {\cf17 def }prefix_path(d, f):\par
00052     {\cf19 if} {\cf19 not} os.path.isabs(v):\par
00053         {\cf19 return} os.path.join(d, f)\par
00054     {\cf19 else}:\par
00055         {\cf19 return} f\par
00056 \par
00057 {\cf17 def }hash(filename, blocksize=65536):\par
00058     {\cf22 """}\par
00059 {\cf22     Compute hash of named file.}\par
00060 {\cf22     """}\par
00061     hash = xxhash.xxh3_64()\par
00062     {\cf17 with} open(filename, {\cf22 "rb"}) {\cf17 as} f:\par
00063         {\cf19 for} block {\cf19 in} iter({\cf17 lambda}: f.read(blocksize), b{\cf22 ""}):\par
00064             hash.update(block)\par
00065     {\cf19 return} hash.hexdigest()\par
00066 \par
00067 {\cf17 def }hash_md5(filename, blocksize=65536):\par
00068     {\cf22 """}\par
00069 {\cf22     Compute md5 hash of named file.}\par
00070 {\cf22     """}\par
00071     hash = hashlib.md5()\par
00072     {\cf17 with} open(filename, {\cf22 "rb"}) {\cf17 as} f:\par
00073         {\cf19 for} block {\cf19 in} iter({\cf17 lambda}: f.read(blocksize), b{\cf22 ""}):\par
00074             hash.update(block)\par
00075     {\cf19 return} hash.hexdigest()\par
00076 \par
00077 IMAGE_NAME_PARAMS = [\par
00078     ({\cf22 "width"}, re.compile({\cf22 "([0-9]+)x[0-9]+"})),\par
00079     ({\cf22 "height"}, re.compile({\cf22 "[0-9]+x([0-9]+)"})),\par
00080     ({\cf22 "fps"}, re.compile({\cf22 "([0-9]+)(fps|hz)"})),\par
00081     ({\cf22 "bit_depth"}, re.compile({\cf22 "([0-9]+)(bits?|bpp)"})),\par
00082     ({\cf22 "format"}, re.compile({\cf22 "^(420p|422p|yuv|yuyv|y|)$"}))\par
00083 ]\par
00084 \par
00085 {\cf17 def }parse_vooya_filename(name):\par
00086     {\cf22 """}\par
00087 {\cf22     Extract vooya-ish image metadata from filename in form suitable for use as encoder parameters.}\par
00088 {\cf22     """}\par
00089     params = \{\}\par
00090     {\cf19 for} p {\cf19 in} name.split({\cf22 "_"}):\par
00091         {\cf19 for} n,r {\cf19 in} IMAGE_NAME_PARAMS:\par
00092             m = r.match(p)\par
00093             {\cf19 if} m:\par
00094                 params[n] = m.group(1)\par
00095 \par
00096     {\cf19 if} {\cf22 'bit_depth'} {\cf19 in} params:\par
00097         {\cf19 if} {\cf22 'format'} {\cf19 not} {\cf19 in} params:\par
00098             params[{\cf22 'format'}] = {\cf22 "420p"}\par
00099         params[{\cf22 'format'}] += params.pop({\cf22 'bit_depth'})\par
00100 \par
00101     {\cf19 if} {\cf22 'format'} {\cf19 in} params {\cf19 and} params[{\cf22 'format'}].startswith({\cf22 '4'}):\par
00102         params[{\cf22 'format'}] = {\cf22 'yuv'} + params[{\cf22 'format'}]\par
00103 \par
00104     {\cf19 if} {\cf22 'width'} {\cf19 in} params:\par
00105         params[{\cf22 'width'}] = int(params[{\cf22 'width'}])\par
00106     {\cf19 if} {\cf22 'height'} {\cf19 in} params:\par
00107         params[{\cf22 'height'}] = int(params[{\cf22 'height'}])\par
00108     {\cf19 if} {\cf22 'fps'} {\cf19 in} params:\par
00109         params[{\cf22 'fps'}] = int(params[{\cf22 'fps'}])\par
00110 \par
00111     {\cf19 return} params\par
00112 \par
00113 {\cf17 def }create_opl_file(width, height, output):\par
00114     data = []\par
00115     log = open(f{\cf22 "\{output\}_encoder.log"}, {\cf22 "r"})\par
00116     poc = 0\par
00117     {\cf19 for} line {\cf19 in} log:\par
00118         {\cf19 if} line[:6] == {\cf22 "[MD5Y "}:\par
00119             frame_data = [poc, width, height]\par
00120             frame_data.append(line[6:38])\par
00121             frame_data.append(line[46:78])\par
00122             frame_data.append(line[86:118])\par
00123             data.append(frame_data)\par
00124             poc += 1\par
00125 \par
00126     {\cf17 with} open(f{\cf22 "\{output\}.opl"}, {\cf22 'w'}, newline={\cf22 ''}) {\cf17 as} csvfile:\par
00127         writer = csv.writer(csvfile)\par
00128         writer.writerow([{\cf22 "PicOrderCntVal"}, {\cf22 "pic_width_max"}, {\cf22 "pic_height_max"}, {\cf22 "md5_y"}, {\cf22 "md5_u"}, {\cf22 "md5_v"}])\par
00129         writer.writerows(data)\par
