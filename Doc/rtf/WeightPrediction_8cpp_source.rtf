00371 {\cf18 void}  WeightPrediction::xWeightedPredictionUni({\cf17 const} PredictionUnit       &pu,\par
00372                                                {\cf17 const} CPelUnitBuf          &pcYuvSrc,\par
00373                                                {\cf17 const} RefPicList           &eRefPicList,\par
00374                                                      PelUnitBuf           &pcYuvPred,\par
00375                                                {\cf17 const} {\cf18 int}                   iRefIdx_input{\cf20 /* = -1*/},\par
00376                                                {\cf17 const} ComponentID           maxNumComp\par
00377                                               , {\cf18 bool}                       lumaOnly\par
00378                                               , {\cf18 bool}                       chromaOnly\par
00379 )\par
00380 \{\par
00381   WPScalingParam  *pwp, *pwpTmp;\par
00382 \par
00383   {\cf18 int} iRefIdx = iRefIdx_input;\par
00384   {\cf19 if} (iRefIdx < 0)\par
00385   \{\par
00386     iRefIdx = pu.refIdx[eRefPicList];\par
00387   \}\par
00388 \par
00389   CHECK(iRefIdx < 0, {\cf22 "Negative reference picture list index"});\par
00390 \par
00391   {\cf19 if} (eRefPicList == REF_PIC_LIST_0)\par
00392   \{\par
00393     getWpScaling(pu.cs->slice, iRefIdx, -1, pwp, pwpTmp, maxNumComp);\par
00394   \}\par
00395   {\cf19 else}\par
00396   \{\par
00397     getWpScaling(pu.cs->slice, -1, iRefIdx, pwpTmp, pwp, maxNumComp);\par
00398   \}\par
00399   addWeightUni(pcYuvSrc, pu.cu->slice->clpRngs(), pwp, pcYuvPred, maxNumComp, lumaOnly, chromaOnly);\par
