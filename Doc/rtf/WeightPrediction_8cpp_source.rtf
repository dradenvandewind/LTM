00047 {\cf17 static} {\cf17 inline} Pel weightBidir( {\cf18 int} w0, Pel P0, {\cf18 int} w1, Pel P1, {\cf18 int} round, {\cf18 int} shift, {\cf18 int} offset, {\cf17 const} ClpRng& clpRng)\par
00048 \{\par
00049   {\cf19 return} ClipPel( ( (w0*(P0 + IF_INTERNAL_OFFS) + w1*(P1 + IF_INTERNAL_OFFS) + round + (offset << (shift-1))) >> shift ), clpRng );\par
00050 \}\par
00051 \par
00052 {\cf17 static} {\cf17 inline} Pel weightUnidir( {\cf18 int} w0, Pel P0, {\cf18 int} round, {\cf18 int} shift, {\cf18 int} offset, {\cf17 const} ClpRng& clpRng)\par
00053 \{\par
00054   {\cf19 return} ClipPel( ( (w0*(P0 + IF_INTERNAL_OFFS) + round) >> shift ) + offset, clpRng );\par
00055 \}\par
00056 \par
00057 {\cf17 static} {\cf17 inline} Pel noWeightUnidir( Pel P0, {\cf18 int} round, {\cf18 int} shift, {\cf18 int} offset, {\cf17 const} ClpRng& clpRng)\par
00058 \{\par
00059   {\cf19 return} ClipPel( ( ((P0 + IF_INTERNAL_OFFS) + round) >> shift ) + offset, clpRng );\par
00060 \}\par
00061 \par
