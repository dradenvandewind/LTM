00146 {\cf18 void} WeightPrediction::addWeightBi({\cf17 const} CPelUnitBuf          &pcYuvSrc0,\par
00147                                    {\cf17 const} CPelUnitBuf          &pcYuvSrc1,\par
00148                                    {\cf17 const} ClpRngs              &clpRngs,\par
00149                                    {\cf17 const} WPScalingParam *{\cf17 const} wp0,\par
00150                                    {\cf17 const} WPScalingParam *{\cf17 const} wp1,\par
00151                                          PelUnitBuf           &rpcYuvDst,\par
00152                                    {\cf17 const} {\cf18 bool}                  bRoundLuma {\cf20 /*= true*/},\par
00153                                    {\cf17 const} ComponentID           maxNumComp\par
00154                                   , {\cf18 bool}                       lumaOnly\par
00155                                   , {\cf18 bool}                       chromaOnly\par
00156 )\par
00157 \{\par
00158   {\cf17 const} {\cf18 bool} enableRounding[MAX_NUM_COMPONENT] = \{ bRoundLuma, {\cf17 true}, {\cf17 true} \};\par
00159 \par
00160   {\cf17 const} uint32_t numValidComponent = ({\cf17 const} uint32_t)pcYuvSrc0.bufs.size();\par
00161 \par
00162   CHECK( lumaOnly && chromaOnly, {\cf22 "Not allowed to have both lumaOnly and chromaOnly selected"} );\par
00163   {\cf18 int} firstComponent = chromaOnly ? 1 : 0;\par
00164   {\cf18 int} lastComponent = lumaOnly ? 0 : maxNumComp;\par
00165   {\cf19 for} ({\cf18 int} componentIndex = firstComponent; componentIndex < numValidComponent && componentIndex <= lastComponent; componentIndex++)\par
00166   \{\par
00167     {\cf17 const} ComponentID compID = ComponentID(componentIndex);\par
00168 \par
00169     {\cf17 const} Pel* pSrc0 = pcYuvSrc0.bufs[compID].buf;\par
00170     {\cf17 const} Pel* pSrc1 = pcYuvSrc1.bufs[compID].buf;\par
00171           Pel* pDst  = rpcYuvDst.bufs[compID].buf;\par
00172 \par
00173     {\cf20 // Luma : --------------------------------------------}\par
00174     {\cf17 const} ClpRng& clpRng = clpRngs.comp[compID];\par
00175     {\cf17 const} {\cf18 int}  w0       = wp0[compID].w;\par
00176     {\cf17 const} {\cf18 int}  offset   = wp0[compID].offset;\par
00177     {\cf17 const} {\cf18 int}  clipBD   = clpRng.bd;\par
00178     {\cf17 const} {\cf18 int} shiftNum = IF_INTERNAL_FRAC_BITS(clipBD);\par
00179     {\cf17 const} {\cf18 int}  shift    = wp0[compID].shift + shiftNum;\par
00180     {\cf17 const} {\cf18 int}  round    = (enableRounding[compID] && (shift > 0)) ? (1 << (shift - 1)) : 0;\par
00181     {\cf17 const} {\cf18 int}  w1       = wp1[compID].w;\par
00182     {\cf17 const} {\cf18 int}  iHeight  = rpcYuvDst.bufs[compID].height;\par
00183     {\cf17 const} {\cf18 int}  iWidth   = rpcYuvDst.bufs[compID].width;\par
00184 \par
00185     {\cf17 const} uint32_t iSrc0Stride = pcYuvSrc0.bufs[compID].stride;\par
00186     {\cf17 const} uint32_t iSrc1Stride = pcYuvSrc1.bufs[compID].stride;\par
00187     {\cf17 const} uint32_t iDstStride =  rpcYuvDst.bufs[compID].stride;\par
00188 \par
00189     {\cf19 for} ({\cf18 int} y = iHeight - 1; y >= 0; y--)\par
00190     \{\par
00191       {\cf20 // do it in batches of 4 (partial unroll)}\par
00192       {\cf18 int} x = iWidth - 1;\par
00193 \par
00194       {\cf19 for} (; x >= 3; )\par
00195       \{\par
00196         pDst[x] = weightBidir(w0, pSrc0[x], w1, pSrc1[x], round, shift, offset, clpRng ); x--;\par
00197         pDst[x] = weightBidir(w0, pSrc0[x], w1, pSrc1[x], round, shift, offset, clpRng ); x--;\par
00198         pDst[x] = weightBidir(w0, pSrc0[x], w1, pSrc1[x], round, shift, offset, clpRng ); x--;\par
00199         pDst[x] = weightBidir(w0, pSrc0[x], w1, pSrc1[x], round, shift, offset, clpRng ); x--;\par
00200       \}\par
00201       {\cf19 for} (; x >= 0; x--)\par
00202       \{\par
00203         pDst[x] = weightBidir(w0, pSrc0[x], w1, pSrc1[x], round, shift, offset, clpRng );\par
00204       \}\par
00205 \par
00206       pSrc0 += iSrc0Stride;\par
00207       pSrc1 += iSrc1Stride;\par
00208       pDst += iDstStride;\par
00209     \} {\cf20 // y loop}\par
00210   \} {\cf20 // compID loop}\par
00211 \}\par
