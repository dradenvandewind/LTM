00076 {\cf18 void} WeightPrediction::getWpScaling(Slice *pcSlice, {\cf17 const} {\cf18 int} &iRefIdx0, {\cf17 const} {\cf18 int} &iRefIdx1, WPScalingParam *&wp0,\par
00077                                     WPScalingParam *&wp1, {\cf17 const} ComponentID maxNumComp)\par
00078 \{\par
00079   CHECK(iRefIdx0 < 0 && iRefIdx1 < 0, {\cf22 "Both picture reference list indizes smaller than '0'"});\par
00080 \par
00081   {\cf17 const} {\cf18 bool} wpBiPred        = pcSlice->getPPS()->getWPBiPred();\par
00082   {\cf17 const} {\cf18 bool} bBiPred         = (iRefIdx0 >= 0 && iRefIdx1 >= 0);\par
00083   {\cf17 const} {\cf18 bool} bUniPred        = !bBiPred;\par
00084 \par
00085   {\cf19 if} (bUniPred || wpBiPred)\par
00086   \{\par
00087     {\cf20 // explicit --------------------}\par
00088     wp0 = pcSlice->getWpScaling(REF_PIC_LIST_0, iRefIdx0);\par
00089     wp1 = pcSlice->getWpScaling(REF_PIC_LIST_1, iRefIdx1);\par
00090   \}\par
00091   {\cf19 else}\par
00092   \{\par
00093     THROW( {\cf22 "Unsupported WP configuration"} );\par
00094   \}\par
00095 \par
00096   {\cf19 if} (iRefIdx0 < 0)\par
00097   \{\par
00098     wp0 = {\cf17 nullptr};\par
00099   \}\par
00100   {\cf19 if} (iRefIdx1 < 0)\par
00101   \{\par
00102     wp1 = {\cf17 nullptr};\par
00103   \}\par
00104 \par
00105   {\cf17 const} uint32_t numValidComponent = getNumberValidComponents(pcSlice->getSPS()->getChromaFormatIdc());\par
00106   {\cf17 const} {\cf18 bool} bUseHighPrecisionPredictionWeighting = pcSlice->getSPS()->getSpsRangeExtension().getHighPrecisionOffsetsEnabledFlag();\par
00107 \par
00108   {\cf19 if} (bBiPred)\par
00109   \{\par
00110     {\cf20 // Bi-predictive case}\par
00111     {\cf19 for} ({\cf18 int} yuv = 0; yuv < numValidComponent && yuv <= maxNumComp; yuv++)\par
00112     \{\par
00113       {\cf17 const} {\cf18 int} bitDepth = pcSlice->getSPS()->getBitDepth(toChannelType(ComponentID(yuv)));\par
00114       {\cf17 const} {\cf18 int} offsetScalingFactor = bUseHighPrecisionPredictionWeighting ? 1 : (1 << (bitDepth - 8));\par
00115 \par
00116       wp0[yuv].w      = wp0[yuv].codedWeight;\par
00117       wp1[yuv].w      = wp1[yuv].codedWeight;\par
00118       wp0[yuv].o      = wp0[yuv].codedOffset * offsetScalingFactor;\par
00119       wp1[yuv].o      = wp1[yuv].codedOffset * offsetScalingFactor;\par
00120       wp0[yuv].offset = wp0[yuv].o + wp1[yuv].o;\par
00121       wp0[yuv].shift  = wp0[yuv].log2WeightDenom + 1;\par
00122       wp0[yuv].round  = (1 << wp0[yuv].log2WeightDenom);\par
00123       wp1[yuv].offset = wp0[yuv].offset;\par
00124       wp1[yuv].shift = wp0[yuv].shift;\par
00125       wp1[yuv].round = wp0[yuv].round;\par
00126     \}\par
00127   \}\par
00128   {\cf19 else}\par
00129   \{\par
00130     {\cf20 // UniPred}\par
00131     WPScalingParam *{\cf17 const} pwp = (iRefIdx0 >= 0) ? wp0 : wp1;\par
00132 \par
00133     {\cf19 for} ({\cf18 int} yuv = 0; yuv < numValidComponent && yuv <= maxNumComp; yuv++)\par
00134     \{\par
00135       {\cf17 const} {\cf18 int} bitDepth            = pcSlice->getSPS()->getBitDepth(toChannelType(ComponentID(yuv)));\par
00136       {\cf17 const} {\cf18 int} offsetScalingFactor = bUseHighPrecisionPredictionWeighting ? 1 : (1 << (bitDepth - 8));\par
00137 \par
00138       pwp[yuv].w      = pwp[yuv].codedWeight;\par
00139       pwp[yuv].offset = pwp[yuv].codedOffset * offsetScalingFactor;\par
00140       pwp[yuv].shift  = pwp[yuv].log2WeightDenom;\par
00141       pwp[yuv].round  = (pwp[yuv].log2WeightDenom >= 1) ? (1 << (pwp[yuv].log2WeightDenom - 1)) : (0);\par
00142     \}\par
00143   \}\par
