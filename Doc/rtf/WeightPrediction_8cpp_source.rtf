00402 {\cf18 void}  WeightPrediction::xWeightedPredictionBi({\cf17 const} PredictionUnit       &pu,\par
00403                                               {\cf17 const} CPelUnitBuf          &pcYuvSrc0,\par
00404                                               {\cf17 const} CPelUnitBuf          &pcYuvSrc1,\par
00405                                                     PelUnitBuf           &rpcYuvDst,\par
00406                                               {\cf17 const} ComponentID           maxNumComp\par
00407                                               , {\cf18 bool}                      lumaOnly\par
00408                                               , {\cf18 bool}                      chromaOnly\par
00409 )\par
00410 \{\par
00411   {\cf17 const} {\cf18 int} iRefIdx0 = pu.refIdx[0];\par
00412   {\cf17 const} {\cf18 int} iRefIdx1 = pu.refIdx[1];\par
00413   WPScalingParam  *pwp0;\par
00414   WPScalingParam  *pwp1;\par
00415 \par
00416   CHECK( !pu.cs->pps->getWPBiPred(), {\cf22 "Weighted Bi-prediction disabled"} );\par
00417 \par
00418   {\cf19 if} (iRefIdx0 < 0 && iRefIdx1 < 0) {\cf19 return};\par
00419 \par
00420   getWpScaling(pu.cu->slice, iRefIdx0, iRefIdx1, pwp0, pwp1, maxNumComp);\par
00421 \par
00422   {\cf19 if} (iRefIdx0 >= 0 && iRefIdx1 >= 0)\par
00423   \{\par
00424     addWeightBi(pcYuvSrc0, pcYuvSrc1, pu.cu->slice->clpRngs(), pwp0, pwp1, rpcYuvDst, {\cf17 true}, maxNumComp, lumaOnly, chromaOnly);\par
00425   \}\par
00426   {\cf19 else} {\cf19 if} (iRefIdx0 >= 0 && iRefIdx1 < 0)\par
00427   \{\par
00428     addWeightUni(pcYuvSrc0, pu.cu->slice->clpRngs(), pwp0, rpcYuvDst, maxNumComp, lumaOnly, chromaOnly);\par
00429   \}\par
00430   {\cf19 else} {\cf19 if} (iRefIdx0 < 0 && iRefIdx1 >= 0)\par
00431   \{\par
00432     addWeightUni(pcYuvSrc1, pu.cu->slice->clpRngs(), pwp1, rpcYuvDst, maxNumComp, lumaOnly, chromaOnly);\par
00433   \}\par
00434   {\cf19 else}\par
00435   \{\par
00436     THROW( {\cf22 "Both reference picture list indizes are negative"} );\par
00437   \}\par
00438 \}\par
