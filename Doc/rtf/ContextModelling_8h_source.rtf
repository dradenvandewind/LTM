00167   {\cf18 unsigned} templateAbsSum( {\cf18 int} scanPos, {\cf17 const} TCoeff* coeff, {\cf18 int} baseLevel )\par
00168   \{\par
00169     {\cf17 const} uint32_t  posY  = m_scan[scanPos].y;\par
00170     {\cf17 const} uint32_t  posX  = m_scan[scanPos].x;\par
00171     {\cf17 const} TCoeff*   pData = coeff + posX + posY * m_width;\par
00172     TCoeff          sum   = 0;\par
00173     {\cf19 if} (posX < m_width - 1)\par
00174     \{\par
00175       sum += abs(pData[1]);\par
00176       {\cf19 if} (posX < m_width - 2)\par
00177       \{\par
00178         sum += abs(pData[2]);\par
00179       \}\par
00180       {\cf19 if} (posY < m_height - 1)\par
00181       \{\par
00182         sum += abs(pData[m_width + 1]);\par
00183       \}\par
00184     \}\par
00185     {\cf19 if} (posY < m_height - 1)\par
00186     \{\par
00187       sum += abs(pData[m_width]);\par
00188       {\cf19 if} (posY < m_height - 2)\par
00189       \{\par
00190         sum += abs(pData[m_width << 1]);\par
00191       \}\par
00192     \}\par
00193     {\cf19 return} unsigned(std::max<TCoeff>(std::min<TCoeff>(sum - 5 * baseLevel, 31), 0));\par
00194   \}\par
