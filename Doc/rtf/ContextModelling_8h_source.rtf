00308   {\cf18 int} deriveModCoeff({\cf18 int} rightPixel, {\cf18 int} belowPixel, TCoeff absCoeff, {\cf18 int} bdpcm = 0)\par
00309   \{\par
00310 \par
00311     {\cf19 if} (absCoeff == 0)\par
00312       {\cf19 return} 0;\par
00313     {\cf18 int} pred1, absBelow = abs(belowPixel), absRight = abs(rightPixel);\par
00314 \par
00315     {\cf18 int} absCoeffMod = int(absCoeff);\par
00316 \par
00317     {\cf19 if} (bdpcm == 0)\par
00318     \{\par
00319       pred1 = std::max(absBelow, absRight);\par
00320 \par
00321       {\cf19 if} (absCoeffMod == pred1)\par
00322       \{\par
00323         absCoeffMod = 1;\par
00324       \}\par
00325       {\cf19 else}\par
00326       \{\par
00327         absCoeffMod = absCoeffMod < pred1 ? absCoeffMod + 1 : absCoeffMod;\par
00328       \}\par
00329     \}\par
00330 \par
00331     {\cf19 return}(absCoeffMod);\par
00332   \}\par
00333 \par
00334   TCoeff decDeriveModCoeff({\cf18 int} rightPixel, {\cf18 int} belowPixel, TCoeff absCoeff)\par
00335   \{\par
00336 \par
00337     {\cf19 if} (absCoeff == 0)\par
00338       {\cf19 return} 0;\par
00339 \par
00340     {\cf18 int} pred1, absBelow = abs(belowPixel), absRight = abs(rightPixel);\par
00341     pred1 = std::max(absBelow, absRight);\par
00342 \par
00343     TCoeff absCoeffMod;\par
00344 \par
00345     {\cf19 if} (absCoeff == 1 && pred1 > 0)\par
00346     \{\par
00347       absCoeffMod = pred1;\par
00348     \}\par
00349     {\cf19 else}\par
00350     \{\par
00351       absCoeffMod = absCoeff - (absCoeff <= pred1);\par
00352     \}\par
00353     {\cf19 return}(absCoeffMod);\par
00354   \}\par
