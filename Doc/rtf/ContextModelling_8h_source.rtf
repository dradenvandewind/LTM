00109   {\cf18 unsigned} sigCtxIdAbs( {\cf18 int} scanPos, {\cf17 const} TCoeff* coeff, {\cf17 const} {\cf18 int} state )\par
00110   \{\par
00111     {\cf17 const} uint32_t posY      = m_scan[scanPos].y;\par
00112     {\cf17 const} uint32_t posX      = m_scan[scanPos].x;\par
00113     {\cf17 const} TCoeff* pData     = coeff + posX + posY * m_width;\par
00114     {\cf17 const} {\cf18 int}     diag      = posX + posY;\par
00115     {\cf18 int}           numPos    = 0;\par
00116     TCoeff        sumAbs    = 0;\par
00117 {\cf21 #define UPDATE(x) \{TCoeff a=abs(x);sumAbs+=std::min(4+(a&1),a);numPos+=int(!!a);\}}\par
00118     {\cf19 if}( posX < m_width-1 )\par
00119     \{\par
00120       UPDATE( pData[1] );\par
00121       {\cf19 if}( posX < m_width-2 )\par
00122       \{\par
00123         UPDATE( pData[2] );\par
00124       \}\par
00125       {\cf19 if}( posY < m_height-1 )\par
00126       \{\par
00127         UPDATE( pData[m_width+1] );\par
00128       \}\par
00129     \}\par
00130     {\cf19 if}( posY < m_height-1 )\par
00131     \{\par
00132       UPDATE( pData[m_width] );\par
00133       {\cf19 if}( posY < m_height-2 )\par
00134       \{\par
00135         UPDATE( pData[m_width<<1] );\par
00136       \}\par
00137     \}\par
00138 {\cf21 #undef UPDATE}\par
00139 \par
00140 \par
00141     {\cf18 int} ctxOfs = int(std::min<TCoeff>((sumAbs+1)>>1, 3)) + ( diag < 2 ? 4 : 0 );\par
00142 \par
00143     {\cf19 if}( m_chType == CHANNEL_TYPE_LUMA )\par
00144     \{\par
00145       ctxOfs += diag < 5 ? 4 : 0;\par
00146     \}\par
00147 \par
00148     m_tmplCpDiag = diag;\par
00149     m_tmplCpSum1 = sumAbs - numPos;\par
00150     {\cf19 return} m_sigFlagCtxSet[std::max( 0, state-1 )]( ctxOfs );\par
00151   \}\par
00152 \par
00153   uint8_t ctxOffsetAbs()\par
00154   \{\par
00155     {\cf18 int} offset = 0;\par
00156     {\cf19 if}( m_tmplCpDiag != -1 )\par
00157     \{\par
00158       offset  = int(std::min<TCoeff>( m_tmplCpSum1, 4 )) + 1;\par
00159       offset += ( !m_tmplCpDiag ? ( m_chType == CHANNEL_TYPE_LUMA ? 15 : 5 ) : m_chType == CHANNEL_TYPE_LUMA ? m_tmplCpDiag < 3 ? 10 : ( m_tmplCpDiag < 10 ? 5 : 0 ) : 0 );\par
00160     \}\par
00161     {\cf19 return} uint8_t(offset);\par
00162   \}\par
00163 \par
00164   {\cf18 unsigned} parityCtxIdAbs   ( uint8_t offset ){\cf17   const }\{ {\cf19 return} m_parFlagCtxSet   ( offset ); \}\par
