00253   {\cf18 unsigned} signCtxIdAbsTS({\cf18 int} scanPos, {\cf17 const} TCoeff* coeff, {\cf18 int} bdpcm)\par
00254   \{\par
00255     {\cf17 const} uint32_t  posY = m_scan[scanPos].y;\par
00256     {\cf17 const} uint32_t  posX = m_scan[scanPos].x;\par
00257     {\cf17 const} TCoeff*   pData = coeff + posX + posY * m_width;\par
00258 \par
00259     {\cf18 int} rightSign = 0, belowSign = 0;\par
00260     {\cf18 unsigned} signCtx = 0;\par
00261 \par
00262     {\cf19 if} (posX > 0)\par
00263     \{\par
00264       rightSign = sgn(pData[-1]);\par
00265     \}\par
00266     {\cf19 if} (posY > 0)\par
00267     \{\par
00268       belowSign = sgn(pData[-({\cf18 int})m_width]);\par
00269     \}\par
00270 \par
00271     {\cf19 if} ((rightSign == 0 && belowSign == 0) || ((rightSign*belowSign) < 0))\par
00272     \{\par
00273       signCtx = 0;\par
00274     \}\par
00275     {\cf19 else} {\cf19 if} (rightSign >= 0 && belowSign >= 0)\par
00276     \{\par
00277       signCtx = 1;\par
00278     \}\par
00279     {\cf19 else}\par
00280     \{\par
00281       signCtx = 2;\par
00282     \}\par
00283     {\cf19 if} (bdpcm)\par
00284     \{\par
00285       signCtx += 3;\par
00286     \}\par
00287     {\cf19 return} m_tsSignFlagCtxSet(signCtx);\par
00288   \}\par
