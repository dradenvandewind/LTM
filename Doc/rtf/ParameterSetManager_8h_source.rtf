00042 {\cf17 namespace }vtm \{\par
00043 \par
00044 {\cf18 void} calculateParameterSetChangedFlag({\cf18 bool} &bChanged, {\cf17 const} std::vector<uint8_t> *pOldData, {\cf17 const} std::vector<uint8_t> *pNewData);\par
00045 \par
00046 {\cf17 template} <{\cf17 class} T> {\cf17 class }ParameterSetMap\par
00047 \{\par
00048 {\cf17 public}:\par
00049   {\cf17 template} <{\cf17 class} Tm>\par
00050   {\cf17 struct }MapData\par
00051   \{\par
00052     {\cf18 bool}                  bChanged;\par
00053     std::vector<uint8_t>   *pNaluData; {\cf20 // Can be null}\par
00054     Tm*                   parameterSet;\par
00055   \};\par
00056 \par
00057   ParameterSetMap({\cf18 int} maxId)\par
00058   :m_maxId (maxId)\par
00059   ,m_lastActiveParameterSet(NULL)\par
00060   \{\par
00061     m_activePsId.clear();\par
00062   \}\par
00063 \par
00064   ~ParameterSetMap()\par
00065   \{\par
00066     {\cf19 for} ({\cf17 typename} std::map<{\cf18 int},MapData<T> >::iterator i = m_paramsetMap.begin(); i!= m_paramsetMap.end(); i++)\par
00067     \{\par
00068       {\cf17 delete} (*i).second.pNaluData;\par
00069       {\cf17 delete} (*i).second.parameterSet;\par
00070     \}\par
00071     {\cf17 delete} m_lastActiveParameterSet; m_lastActiveParameterSet = NULL;\par
00072   \}\par
00073 \par
00074   T *allocatePS({\cf17 const} {\cf18 int} psId)\par
00075   \{\par
00076     CHECK( psId >= m_maxId, {\cf22 "Invalid PS id"} );\par
00077     {\cf19 if} ( m_paramsetMap.find(psId) == m_paramsetMap.end() )\par
00078     \{\par
00079       m_paramsetMap[psId].bChanged = {\cf17 true};\par
00080       m_paramsetMap[psId].pNaluData=0;\par
00081       m_paramsetMap[psId].parameterSet = {\cf17 new} T;\par
00082       setID(m_paramsetMap[psId].parameterSet, psId);\par
00083     \}\par
00084     {\cf19 return} m_paramsetMap[psId].parameterSet;\par
00085   \}\par
00086 \par
00087   {\cf18 void} clearMap()\par
00088   \{\par
00089     m_paramsetMap.clear();\par
00090   \}\par
00091   {\cf18 void} storePS( {\cf18 int} psId, T *ps )\par
00092   \{\par
00093     CHECK( psId >= m_maxId, {\cf22 "Invalid PS id"} );\par
00094     {\cf19 if}( m_paramsetMap.find( psId ) != m_paramsetMap.end() )\par
00095     \{\par
00096       {\cf17 delete} m_paramsetMap[psId].parameterSet;\par
00097     \}\par
00098     m_paramsetMap[psId].parameterSet = ps;\par
00099     m_paramsetMap[psId].bChanged = {\cf17 true};\par
00100   \}\par
00101   {\cf18 void} storePS({\cf18 int} psId, T *ps, {\cf17 const} std::vector<uint8_t> *pNaluData)\par
00102   \{\par
00103     CHECK( psId >= m_maxId, {\cf22 "Invalid PS id"} );\par
00104     {\cf19 if} ( m_paramsetMap.find(psId) != m_paramsetMap.end() )\par
00105     \{\par
00106       MapData<T> &mapData=m_paramsetMap[psId];\par
00107 \par
00108       {\cf20 // work out changed flag}\par
00109       calculateParameterSetChangedFlag(mapData.bChanged, mapData.pNaluData, pNaluData);\par
00110 \par
00111       {\cf19 if}( ! mapData.bChanged )\par
00112       \{\par
00113         {\cf20 // just keep the old one}\par
00114         {\cf17 delete} ps;\par
00115         {\cf19 return};\par
00116       \}\par
00117 \par
00118       {\cf19 if} (find(m_activePsId.begin(), m_activePsId.end(), psId) != m_activePsId.end())\par
00119       \{\par
00120         std::swap( m_paramsetMap[psId].parameterSet, m_lastActiveParameterSet );\par
00121       \}\par
00122       {\cf17 delete} m_paramsetMap[psId].pNaluData;\par
00123       {\cf17 delete} m_paramsetMap[psId].parameterSet;\par
00124 \par
00125       m_paramsetMap[psId].parameterSet = ps;\par
00126     \}\par
00127     {\cf19 else}\par
00128     \{\par
00129       m_paramsetMap[psId].parameterSet = ps;\par
00130       m_paramsetMap[psId].bChanged = {\cf17 false};\par
00131     \}\par
00132     {\cf19 if} (pNaluData != 0)\par
00133     \{\par
00134       m_paramsetMap[psId].pNaluData={\cf17 new} std::vector<uint8_t>;\par
00135       *(m_paramsetMap[psId].pNaluData) = *pNaluData;\par
00136     \}\par
00137     {\cf19 else}\par
00138     \{\par
00139       m_paramsetMap[psId].pNaluData=0;\par
00140     \}\par
00141   \}\par
00142 \par
00143   {\cf18 void} checkAuApsContent( APS *aps, std::vector<int>& accessUnitApsNals )\par
00144   \{\par
00145     {\cf18 int} apsId = ( aps->getAPSId() << NUM_APS_TYPE_LEN ) + aps->getAPSType();\par
00146 \par
00147     {\cf19 if}( std::find( accessUnitApsNals.begin(), accessUnitApsNals.end(), apsId ) != accessUnitApsNals.end() )\par
00148     \{\par
00149       CHECK( m_paramsetMap.find( apsId ) == m_paramsetMap.end(), {\cf22 "APS does not exist"} );\par
00150       APS* existedAPS = m_paramsetMap[apsId].parameterSet;\par
00151       {\cf18 bool} sameNalUnitType = aps->getHasPrefixNalUnitType() == existedAPS->getHasPrefixNalUnitType();\par
00152       {\cf18 bool} samePU = aps->getLayerId() == existedAPS->getLayerId();\par
00153       {\cf19 if}( aps->getAPSType() == LMCS_APS )\par
00154       \{\par
00155         CHECK( samePU && sameNalUnitType && aps->getReshaperAPSInfo() != existedAPS->getReshaperAPSInfo(), {\cf22 "All APS NAL units with a particular value of nal_unit_type, a particular value of aps_adaptation_parameter_set_id, and a particular value of aps_params_type within a PU shall have the same content"} );\par
00156       \}\par
00157       {\cf19 else} {\cf19 if}( aps->getAPSType() == ALF_APS )\par
00158       \{\par
00159         CHECK( samePU && sameNalUnitType && aps->getAlfAPSParam() != existedAPS->getAlfAPSParam(), {\cf22 "All APS NAL units with a particular value of nal_unit_type, a particular value of aps_adaptation_parameter_set_id, and a particular value of aps_params_type within a PU shall have the same content"} );\par
00160       \}\par
00161       {\cf19 else} {\cf19 if}( aps->getAPSType() == SCALING_LIST_APS )\par
00162       \{\par
00163         CHECK( samePU && sameNalUnitType && aps->getScalingList() != existedAPS->getScalingList(), {\cf22 "All APS NAL units with a particular value of nal_unit_type, a particular value of aps_adaptation_parameter_set_id, and a particular value of aps_params_type within a PU shall have the same content"} );\par
00164       \}\par
00165       {\cf19 else}\par
00166       \{\par
00167         CHECK( {\cf17 true}, {\cf22 "Wrong APS type"} );\par
00168       \}\par
00169     \}\par
00170     {\cf19 else}\par
00171     \{\par
00172       accessUnitApsNals.push_back( apsId );\par
00173     \}\par
00174   \}\par
