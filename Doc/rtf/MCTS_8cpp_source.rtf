00081 {\cf18 void} MCTSHelper::clipMvToArea( Mv& rcMv, {\cf17 const} Area& block, {\cf17 const} Area& clipArea, {\cf17 const} SPS& sps, {\cf17 const} {\cf18 int} mvFracBits )\par
00082 \{\par
00083   {\cf17 const} {\cf18 int} iHorMax = ( clipArea.x + clipArea.width - (int)block.x - ({\cf18 int})block.width ) << mvFracBits;\par
00084   {\cf17 const} {\cf18 int} iHorMin = ( clipArea.x - (int)block.x ) << mvFracBits;\par
00085 \par
00086   {\cf17 const} {\cf18 int} iVerMax = ( clipArea.y + clipArea.height - (int)block.y - ({\cf18 int})block.height ) << mvFracBits;\par
00087   {\cf17 const} {\cf18 int} iVerMin = ( clipArea.y - (int)block.y ) << mvFracBits;\par
00088 \par
00089   rcMv.setHor( Clip3( iHorMin, iHorMax, rcMv.getHor() ) );\par
00090   rcMv.setVer( Clip3( iVerMin, iVerMax, rcMv.getVer() ) );\par
00091 \}\par
00092 \par
00093 Area MCTSHelper::getTileArea( {\cf17 const} CodingStructure* cs, {\cf17 const} {\cf18 int} ctuAddr )\par
00094 \{\par
00095   {\cf17 const} PPS *pps = cs->pps;\par
00096   {\cf17 const} {\cf18 int}  maxCUWidth  = cs->pcv->maxCUWidth;\par
00097   {\cf17 const} {\cf18 int}  maxCUHeight = cs->pcv->maxCUHeight;\par
00098 \par
00099   {\cf17 const} uint32_t tileIdx = pps->getTileIdx( (uint32_t)ctuAddr );\par
00100   {\cf17 const} uint32_t tileX = tileIdx % pps->getNumTileColumns();\par
00101   {\cf17 const} uint32_t tileY = tileIdx / pps->getNumTileColumns();\par
00102 \par
00103   {\cf17 const} {\cf18 int} tileWidthtInCtus = pps->getTileColumnWidth( tileX );\par
00104   {\cf17 const} {\cf18 int} tileHeightInCtus = pps->getTileRowHeight  ( tileY );\par
00105   {\cf17 const} {\cf18 int} tileXPosInCtus   = pps->getTileColumnBd( tileX );\par
00106   {\cf17 const} {\cf18 int} tileYPosInCtus   = pps->getTileRowBd( tileY );\par
00107 \par
00108   {\cf17 const} {\cf18 int} tileLeftTopPelPosX = maxCUWidth * tileXPosInCtus;\par
00109   {\cf17 const} {\cf18 int} tileLeftTopPelPosY = maxCUHeight * tileYPosInCtus;\par
00110   {\cf17 const} {\cf18 int} tileRightBottomPelPosX = std::min<int>( ( ( tileWidthtInCtus + tileXPosInCtus ) * maxCUWidth ), ({\cf18 int})cs->picture->lwidth() ) - 1;\par
00111   {\cf17 const} {\cf18 int} tileRightBottomPelPosY = std::min<int>( ( ( tileHeightInCtus + tileYPosInCtus ) * maxCUHeight ), ({\cf18 int})cs->picture->lheight() ) - 1;\par
00112 \par
00113   {\cf19 return} Area( tileLeftTopPelPosX, tileLeftTopPelPosY, tileRightBottomPelPosX - tileLeftTopPelPosX + 1, tileRightBottomPelPosY - tileLeftTopPelPosY + 1 );\par
00114 \}\par
00115 \par
00116 {\cf18 bool} MCTSHelper::isRefBlockAtRestrictedTileBoundary( {\cf17 const} PredictionUnit &pu )\par
00117 \{\par
00118   {\cf17 const} Area& tileArea = pu.cs->picture->mctsInfo.getTileArea();\par
00119   {\cf17 const} {\cf18 int} mvPrecBits = MV_FRACTIONAL_BITS_INTERNAL;\par
00120 \par
00121   {\cf19 for}( {\cf18 int} refList = 0; refList < NUM_REF_PIC_LIST_01; refList++ )\par
00122   \{\par
00123     {\cf19 if}( pu.refIdx[refList] >= 0 )\par
00124     \{\par
00125       {\cf17 const} Mv& mv = pu.mv[refList];\par
00126       Area targetBlock( pu.Y().offset( mv.getHor() >> mvPrecBits, mv.getVer() >> mvPrecBits ), pu.Y().size() );\par
00127       {\cf20 // NOTE: at boundary take sub-pel filter samples into account}\par
00128       {\cf19 if}(\par
00129         targetBlock.x < tileArea.x + 3 ||\par
00130         targetBlock.y < tileArea.y + 3 ||\par
00131         targetBlock.bottomRight().x > tileArea.bottomRight().x - 4 ||\par
00132         targetBlock.bottomRight().y > tileArea.bottomRight().y - 4 )\par
00133       \{\par
00134         {\cf19 return} {\cf17 true};\par
00135       \}\par
00136     \}\par
00137   \}\par
00138   {\cf19 return} {\cf17 false};\par
00139 \}\par
00140 \par
00141 {\cf17 static} {\cf18 void} getMotInfoBlockPartPos( {\cf17 const} PredictionUnit& pu, {\cf18 int} xOff, {\cf18 int} yOff, {\cf17 const} Mv& mv, {\cf18 int}& ruiPredXLeft, {\cf18 int}& ruiPredYTop, {\cf18 int}& ruiPredXRight, {\cf18 int}& ruiPredYBottom )\par
00142 \{\par
00143   {\cf17 const} {\cf18 int} mvFracBits = MV_FRACTIONAL_BITS_INTERNAL;\par
00144 \par
00145   ruiPredXLeft   = ( mv.getHor() >> mvFracBits ) + pu.lx() + xOff;\par
00146   ruiPredYTop    = ( mv.getVer() >> mvFracBits ) + pu.ly() + yOff;\par
00147   ruiPredXRight  = ruiPredXLeft + ( 1 << g_miScaling.posx ) - 1;\par
00148   ruiPredYBottom = ruiPredYTop + ( 1 << g_miScaling.posy ) - 1;\par
00149 \}\par
00150 \par
00151 {\cf17 static} {\cf18 bool} checkMVRange( {\cf17 const} Mv& mv, {\cf17 const} Area& tileArea, {\cf18 int} predXLeft, {\cf18 int} predXRight, {\cf18 int} predYTop, {\cf18 int} predYBottom, ChromaFormat chromaFormat, {\cf18 bool} isLuma, {\cf18 bool} msgFlag )\par
00152 \{\par
00153   {\cf20 // Filter length of sub-sample generation filter to be considered}\par
00154   {\cf18 int} sampleOffsetLT, sampleOffsetRB, fracDiv;\par
00155 \par
00156   {\cf19 if}( isLuma )\par
00157   \{\par
00158     sampleOffsetLT = 3;\par
00159     sampleOffsetRB = 4;\par
00160     fracDiv = 1 << MV_FRACTIONAL_BITS_INTERNAL;\par
00161   \}\par
00162   {\cf19 else}\par
00163   \{\par
00164     sampleOffsetLT = 2; {\cf20 //1; // 2 in luma coordinates!}\par
00165     sampleOffsetRB = 3; {\cf20 //2; // 3 in luma coordinates!}\par
00166     fracDiv = 1 << ( MV_FRACTIONAL_BITS_INTERNAL + 1 );\par
00167   \}\par
00168 \par
00169   {\cf17 const} {\cf18 int} leftTopPelPosX = tileArea.topLeft().x;\par
00170   {\cf17 const} {\cf18 int} leftTopPelPosY = tileArea.topLeft().y;\par
00171   {\cf17 const} {\cf18 int} rightBottomPelPosX = tileArea.bottomRight().x;\par
00172   {\cf17 const} {\cf18 int} rightBottomPelPosY = tileArea.bottomRight().y;\par
00173 \par
00174   {\cf17 const} {\cf18 bool} isFullPelHor = ( mv.getHor() % fracDiv == 0 );\par
00175   {\cf17 const} {\cf18 bool} isFullPelVer = ( mv.getVer() % fracDiv == 0 );\par
00176 \par
00177   {\cf17 const} {\cf18 int} rangeXLeft   = leftTopPelPosX + ( isFullPelHor ? 0 : sampleOffsetLT );\par
00178   {\cf17 const} {\cf18 int} rangeYTop    = leftTopPelPosY + ( isFullPelVer ? 0 : sampleOffsetLT );\par
00179   {\cf17 const} {\cf18 int} rangeXRight  = rightBottomPelPosX - ( isFullPelHor ? 0 : sampleOffsetRB );\par
00180   {\cf17 const} {\cf18 int} rangeYBottom = rightBottomPelPosY - ( isFullPelVer ? 0 : sampleOffsetRB );\par
00181 \par
00182   {\cf19 if}( !( predXLeft >= rangeXLeft && predXLeft <= rangeXRight ) || !( predXRight >= rangeXLeft && predXRight <= rangeXRight ) )\par
00183   \{\par
00184     {\cf19 if}( msgFlag )\par
00185     \{\par
00186       msg( WARNING, {\cf22 "%s: pu motion vector across tile boundaries MV(%d,%d) RangeLR(%d,%d) PredLR(%d,%d)\\n"}, (isLuma ? {\cf22 "LUMA"}: {\cf22 "CHROMA"}), mv.getHor(), mv.getVer(), rangeXLeft, rangeXRight, predXLeft, predXRight );\par
00187     \}\par
00188     {\cf19 return} {\cf17 false};\par
00189   \}\par
00190   {\cf19 else} {\cf19 if}( !( predYTop >= rangeYTop && predYTop <= rangeYBottom ) || !( predYBottom >= rangeYTop && predYBottom <= rangeYBottom ) )\par
00191   \{\par
00192     {\cf19 if}( msgFlag )\par
00193     \{\par
00194       msg( WARNING, {\cf22 "%s: pu motion vector across tile boundaries MV(%d,%d) RangeTB(%d,%d) PredTB(%d,%d)\\n"}, (isLuma ? {\cf22 "LUMA"} : {\cf22 "CHROMA"}), mv.getHor(), mv.getVer(), rangeYTop, rangeYBottom, predYTop, predYBottom );\par
00195     \}\par
00196     {\cf19 return} {\cf17 false};\par
00197   \}\par
00198 \par
00199   {\cf19 return} {\cf17 true};\par
00200 \}\par
00201 \par
00202 {\cf18 bool} MCTSHelper::checkMvBufferForMCTSConstraint( {\cf17 const} PredictionUnit &pu, {\cf18 bool} msgFlag )\par
00203 \{\par
00204   {\cf17 const} Area& tileArea = pu.cs->picture->mctsInfo.getTileArea();\par
00205   {\cf17 const} ChromaFormat chromaFormat = pu.cs->sps->getChromaFormatIdc();\par
00206 \par
00207   CMotionBuf mb = pu.getMotionBuf();\par
00208 \par
00209   {\cf17 const} {\cf18 int} blkW = 1 << ( g_miScaling.posx );\par
00210   {\cf17 const} {\cf18 int} blkH = 1 << ( g_miScaling.posy );\par
00211 \par
00212   {\cf19 for}( {\cf18 int} y = 0; y < mb.height; y++ )\par
00213   \{\par
00214     {\cf19 for}( {\cf18 int} x = 0; x < mb.width; x++ )\par
00215     \{\par
00216       {\cf17 const} MotionInfo &mi = mb.at( x, y );\par
00217       {\cf18 int} xOff = x << g_miScaling.posx;\par
00218       {\cf18 int} yOff = y << g_miScaling.posy;\par
00219 \par
00220       {\cf19 for}( {\cf18 int} refList = 0; refList < NUM_REF_PIC_LIST_01; refList++ )\par
00221       \{\par
00222         {\cf19 if}( pu.refIdx[refList] >= 0 || mi.refIdx[refList] >= 0 )\par
00223         \{\par
00224           {\cf17 const} Mv& mv = mi.mv[refList];\par
00225           {\cf18 int} predXLeft, predYTop, predXRight, predYBottom;\par
00226           getMotInfoBlockPartPos( pu, xOff, yOff, mv, predXLeft, predYTop, predXRight, predYBottom );\par
00227           {\cf19 if}( !checkMVRange( mv, tileArea, predXLeft, predXRight, predYTop, predYBottom, chromaFormat, {\cf17 true}, msgFlag ) )\par
00228           \{\par
00229             {\cf19 return} {\cf17 false};\par
00230           \}\par
00231 \par
00232           {\cf20 // Chroma}\par
00233           {\cf19 if}( !pu.cu->affine )\par
00234           \{\par
00235             {\cf19 if}( !checkMVRange( mv, tileArea, predXLeft, predXRight, predYTop, predYBottom, chromaFormat, {\cf17 false}, msgFlag ) )\par
00236             \{\par
00237               {\cf19 return} {\cf17 false};\par
00238             \}\par
00239           \}\par
00240           {\cf19 else}\par
00241           \{\par
00242             {\cf19 if}( x % 2 == 0 && y % 2 == 0 )\par
00243             \{\par
00244               {\cf17 const} MotionInfo &miA = mi;\par
00245               {\cf17 const} MotionInfo &miB = mb.at( x + 1, y + 1 );\par
00246               Mv mvAff = miA.mv[refList] + miB.mv[refList];\par
00247               roundAffineMv( mvAff.hor, mvAff.ver, 1 );\par
00248               getMotInfoBlockPartPos( pu, xOff, yOff, mvAff, predXLeft, predYTop, predXRight, predYBottom );\par
00249               {\cf19 if}( !checkMVRange( mvAff, tileArea, predXLeft, predXRight + blkW, predYTop, predYBottom + blkH, chromaFormat, {\cf17 false}, msgFlag ) )\par
00250               \{\par
00251                 {\cf19 return} {\cf17 false};\par
00252               \}\par
00253             \}\par
00254           \}\par
00255         \}\par
00256       \}\par
00257     \}\par
00258   \}\par
00259 \par
00260   {\cf19 return} {\cf17 true};\par
00261 \}\par
00262 {\cf18 bool} MCTSHelper::checkMvIsNotInRestrictedArea( {\cf17 const} PredictionUnit &pu, {\cf17 const} Mv& mv, {\cf17 const} Area& restrArea, {\cf17 const} MvPrecision mvPrec )\par
00263 \{\par
00264   CHECKD( mvPrec < MV_PRECISION_INT, {\cf22 "Wrong MV precision!"} );\par
00265   Mv testMv = mv;\par
00266   testMv >>= mvPrec - MV_PRECISION_INT;\par
00267   Area targetArea = pu.Y();\par
00268   targetArea.repositionTo( targetArea.offset( testMv.getHor(), testMv.getVer() ) );\par
00269   {\cf19 if}( !restrArea.contains( targetArea ) )\par
00270   \{\par
00271     {\cf20 // Skip this pos}\par
00272     {\cf19 return} {\cf17 false};\par
00273   \}\par
00274   {\cf19 return} {\cf17 true};\par
00275 \}\par
00276 {\cf18 bool} MCTSHelper::checkMvForMCTSConstraint( {\cf17 const} PredictionUnit &pu, {\cf17 const} Mv& mv, {\cf17 const} MvPrecision mvPrec )\par
00277 \{\par
00278   {\cf19 return} checkMvIsNotInRestrictedArea( pu, mv, pu.cs->picture->mctsInfo.getTileAreaSubPelRestricted( pu ), mvPrec );\par
00279 \}\par
00280 \par
