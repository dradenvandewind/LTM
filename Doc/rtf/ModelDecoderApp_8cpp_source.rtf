00230 \par
00231     {\cf20 // Input}\par
00232     {\cf20 //}\par
00233     ESFile es_file;\par
00234     {\cf19 if} (!es_file.Open(input_es, file_base)) \{\par
00235         ERR({\cf22 "Cannot open file: %s\\n"}, input_es.c_str());\par
00236     \}\par
