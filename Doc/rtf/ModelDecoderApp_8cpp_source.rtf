00310 \par
00311     {\cf17 const} {\cf18 float} finish = (float)(system_timestamp() / 1000000.0);\par
00312     INFO({\cf22 "-- Finished: %.3f"}, finish);\par
00313     INFO({\cf22 "-- FPS: %.3f"}, ({\cf18 float})count / (finish - start));\par
00314 \par
00315     base_video_decoder->StatisticsComputation();\par
00316 \par
00317 {\cf21 #if BITSTREAM_DEBUG}\par
00318     goStat.Dump();\par
