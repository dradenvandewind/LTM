00333     decoder_.initialize_decode(Packet::build().contents(enhancement_data, ({\cf18 unsigned})enhancement_data_size).finish(), symbols);\par
00334     {\cf17 const} SignaledConfiguration configuration = decoder_.get_configuration();\par
00335     decoder_.set_idr(is_lcevc_idr);\par
00336 \par
