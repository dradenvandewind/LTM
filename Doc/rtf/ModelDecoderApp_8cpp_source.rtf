00241     {\cf20 // additional Input for PSNR}\par
00242     unique_ptr<YUVReader> yuv_reader(CreateYUVReader(input_yuv, 60));\par
00243 \par
00244     {\cf20 // Create Base Video Decpder}\par
00245     DecoderApp app(*yuv_writer, *yuv_reader);\par
00246     std::unique_ptr<BaseVideoDecoder> base_video_decoder(\par
00247         CreateBaseVideoDecoder(app, base_video_type, encapsulation, base_external, base_yuv, keep_base));\par
00248 \par
00249     app.report_ = report;\par
00250     app.dithering_switch_ = dithering_switch;\par
00251     app.dithering_fixed_ = dithering_fixed;\par
00252     app.apply_enhancement_ = apply_enhancement;\par
00253 \par
00254     {\cf17 const} {\cf18 float} start = (float)(system_timestamp() / 1000000.0);\par
00255     INFO({\cf22 "-- Starting: %.3f"}, start);\par
00256 \par
00257     base_video_decoder->start();\par
00258 \par
00259 {\cf21 #if BITSTREAM_DEBUG}\par
00260     goStat.Reset();\par
00261     goBits = fopen({\cf22 "BitstreamDec.txt"}, {\cf22 "w"});\par
00262 {\cf21 #endif}\par
00263 \par
00264     ESFile::AccessUnit au;\par
00265 \par
00266     clock_t EnhaClock0;\par
00267     EnhaClock0 = clock();\par
00268     INFO({\cf22 "**** Enh. start %16d"}, EnhaClock0);\par
00269 \par
00270     {\cf18 unsigned} count = 0;\par
00271     {\cf19 while} (count < limit) \{\par
00272         ESFile::Result rc = ESFile::EndOfFile;\par
00273 \par
00274         {\cf19 try} \{\par
00275             rc = es_file.NextAccessUnit(au);\par
00276         \} {\cf19 catch} ({\cf17 const} runtime_error &e) \{\par
