00342             {\cf20 // Figure out output size after conformance window}\par
00343             Dimensions dimensions = decoder_.get_dimensions();\par
00344             {\cf17 const} {\cf18 unsigned} cw = dimensions.crop_unit_width(0), ch = dimensions.crop_unit_height(0);\par
00345             width -= (configuration.sequence_configuration.conf_win_left_offset * cw +\par
00346                       configuration.sequence_configuration.conf_win_right_offset * cw);\par
00347             height -= (configuration.sequence_configuration.conf_win_top_offset * ch +\par
00348                        configuration.sequence_configuration.conf_win_bottom_offset * ch);\par
