00625   \{\par
00626     CHECK(width != (height << 1) && (width << 1) != height, {\cf22 "Wrong"})\par
00627     {\cf18 bool} isHorizontal = width == (height << 1) ? {\cf17 true} : {\cf17 false};\par
00628     length = 2 * {\cf17 sizeof}(uint32_t);\par
00629     srcIdx = 1 - srcIdx;\par
