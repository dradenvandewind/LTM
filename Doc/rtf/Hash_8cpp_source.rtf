00134   \{\par
00135     {\cf19 for} ({\cf18 int} k = 0; k < 5; k++)\par
00136     \{\par
00137       hashPic[k] = {\cf17 new} uint16_t[picWidth*picHeight];\par
00138     \}\par
00139   \}\par
00140   {\cf19 if} (m_lookupTable)\par
00141   \{\par
00142     {\cf19 return};\par
