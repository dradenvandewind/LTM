00555 \par
00556   uint32_t* hashValueBuffer[2][2];\par
00557   {\cf19 for} ({\cf18 int} i = 0; i < 2; i++)\par
00558   \{\par
00559     {\cf19 for} ({\cf18 int} j = 0; j < 2; j++)\par
00560     \{\par
00561       hashValueBuffer[i][j] = {\cf17 new} uint32_t[block2x2Num];\par
00562     \}\par
00563   \}\par
00564 \par
00565   {\cf20 //2x2 subblock hash values in current CU}\par
00566   {\cf18 int} subBlockInWidth = (width >> 1);\par
00567   {\cf18 int} subBlockInHeight = (height >> 1);\par
00568   {\cf19 for} ({\cf18 int} yPos = 0; yPos < height; yPos += 2)\par
00569   \{\par
00570     {\cf19 for} ({\cf18 int} xPos = 0; xPos < width; xPos += 2)\par
00571     \{\par
00572       {\cf18 int} pos = (yPos >> 1)*subBlockInWidth + (xPos >> 1);\par
00573       TComHash::getPixelsIn1DCharArrayByBlock2x2(curPicBuf, p, xStart + xPos, yStart + yPos, bitDepths, includeChroma);\par
00574 \par
00575       hashValueBuffer[0][0][pos] = TComHash::getCRCValue1(p, length * {\cf17 sizeof}({\cf18 unsigned} {\cf18 char}));\par
00576       hashValueBuffer[1][0][pos] = TComHash::getCRCValue2(p, length * {\cf17 sizeof}({\cf18 unsigned} {\cf18 char}));\par
