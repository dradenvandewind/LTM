00176 {\cf18 void} TComHash::addToTable(uint32_t hashValue, {\cf17 const} BlockHash& blockHash)\par
00177 \{\par
00178   {\cf19 if} (m_lookupTable[hashValue] == NULL)\par
00179   \{\par
00180     m_lookupTable[hashValue] = {\cf17 new} std::vector<BlockHash>;\par
00181     m_lookupTable[hashValue]->push_back(blockHash);\par
