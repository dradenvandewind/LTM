00535 {\cf18 bool} TComHash::getBlockHashValue({\cf17 const} PelUnitBuf &curPicBuf, {\cf18 int} width, {\cf18 int} height, {\cf18 int} xStart, {\cf18 int} yStart, {\cf17 const} BitDepths bitDepths, uint32_t& hashValue1, uint32_t& hashValue2)\par
00536 \{\par
00537   {\cf18 int} addValue = m_blockSizeToIndex[width][height];\par
00538 \par
00539   CHECK(addValue < 0, {\cf22 "Wrong"})\par
00540   addValue <<= m_CRCBits;\par
00541   {\cf18 int} crcMask = 1 << m_CRCBits;\par
00542   crcMask -= 1;\par
00543   {\cf18 int} length = 4;\par
00544   {\cf18 bool} includeChroma = {\cf17 false};\par
00545   {\cf19 if} ((curPicBuf).chromaFormat == CHROMA_444)\par
00546   \{\par
