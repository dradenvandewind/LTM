00599       \{\par
00600         {\cf18 int} srcPos = (yPos << 1)*srcSubBlockInWidth + (xPos << 1);\par
00601 \par
00602         toHash[0] = hashValueBuffer[0][srcIdx][srcPos];\par
00603         toHash[1] = hashValueBuffer[0][srcIdx][srcPos + 1];\par
