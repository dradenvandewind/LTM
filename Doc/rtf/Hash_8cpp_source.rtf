00276 {\cf18 void} TComHash::generateBlockHashValue({\cf18 int} picWidth, {\cf18 int} picHeight, {\cf18 int} width, {\cf18 int} height, uint32_t* srcPicBlockHash[2], uint32_t* dstPicBlockHash[2], {\cf18 bool}* srcPicBlockSameInfo[3], {\cf18 bool}* dstPicBlockSameInfo[3])\par
00277 \{\par
