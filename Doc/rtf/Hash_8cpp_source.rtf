00608 \par
00609         toHash[0] = hashValueBuffer[1][srcIdx][srcPos];\par
00610         toHash[1] = hashValueBuffer[1][srcIdx][srcPos + 1];\par
00611         toHash[2] = hashValueBuffer[1][srcIdx][srcPos + srcSubBlockInWidth];\par
00612         toHash[3] = hashValueBuffer[1][srcIdx][srcPos + srcSubBlockInWidth + 1];\par
00613         hashValueBuffer[1][dstIdx][dstPos] = TComHash::getCRCValue2(({\cf18 unsigned} {\cf18 char}*)toHash, length);\par
00614 \par
