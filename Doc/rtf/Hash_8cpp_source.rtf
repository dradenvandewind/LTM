00052 TCRCCalculatorLight::TCRCCalculatorLight(uint32_t bits, uint32_t truncPoly)\par
00053 \{\par
00054   m_remainder = 0;\par
00055   m_bits = bits;\par
00056   m_truncPoly = truncPoly;\par
00057   m_finalResultMask = (1 << bits) - 1;\par
