00634       toHash[1] = hashValueBuffer[0][srcIdx][1];\par
00635 \par
00636       hashValueBuffer[0][dstIdx][0] = TComHash::getCRCValue1(({\cf18 unsigned} {\cf18 char}*)toHash, length);\par
00637 \par
00638       toHash[0] = hashValueBuffer[1][srcIdx][0];\par
00639       toHash[1] = hashValueBuffer[1][srcIdx][1];\par
00640       hashValueBuffer[1][dstIdx][0] = TComHash::getCRCValue2(({\cf18 unsigned} {\cf18 char}*)toHash, length);\par
00641     \}\par
00642     {\cf19 else}\par
00643     \{\par
