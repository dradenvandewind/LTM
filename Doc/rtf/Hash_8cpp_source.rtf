00144   {\cf18 int} maxAddr = 1 << (m_CRCBits + m_blockSizeBits);\par
00145   m_lookupTable = {\cf17 new} std::vector<BlockHash>*[maxAddr];\par
00146   memset(m_lookupTable, 0, {\cf17 sizeof}(std::vector<BlockHash>*) * maxAddr);\par
00147   tableHasContent = {\cf17 false};\par
00148 \}\par
