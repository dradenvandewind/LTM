00067 {\cf18 void} TCRCCalculatorLight::xInitTable()\par
00068 \{\par
00069   {\cf17 const} uint32_t highBit = 1 << (m_bits - 1);\par
00070   {\cf17 const} uint32_t byteHighBit = 1 << (8 - 1);\par
00071 \par
00072   {\cf19 for} (uint32_t value = 0; value < 256; value++)\par
00073   \{\par
00074     uint32_t remainder = 0;\par
00075     {\cf19 for} ({\cf18 unsigned} {\cf18 char} mask = byteHighBit; mask != 0; mask >>= 1)\par
00076     \{\par
00077       {\cf19 if} (value & mask)\par
00078       \{\par
00079         remainder ^= highBit;\par
00080       \}\par
00081 \par
00082       {\cf19 if} (remainder & highBit)\par
00083       \{\par
00084         remainder <<= 1;\par
00085         remainder ^= m_truncPoly;\par
00086       \}\par
00087       {\cf19 else}\par
00088       \{\par
00089         remainder <<= 1;\par
00090       \}\par
00091     \}\par
00092 \par
00093     m_table[value] = remainder;\par
00094   \}\par
00095 \}\par
00096 \par
00097 {\cf18 void} TCRCCalculatorLight::processData({\cf18 unsigned} {\cf18 char}* curData, uint32_t dataLength)\par
00098 \{\par
00099   {\cf19 for} (uint32_t i = 0; i < dataLength; i++)\par
00100   \{\par
00101     {\cf18 unsigned} {\cf18 char} index = (m_remainder >> (m_bits - 8)) ^ curData[i];\par
00102     m_remainder <<= 8;\par
00103     m_remainder ^= m_table[index];\par
00104   \}\par
00105 \}\par
