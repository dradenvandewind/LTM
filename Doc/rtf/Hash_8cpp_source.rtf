00370 {\cf18 void} TComHash::getPixelsIn1DCharArrayByBlock2x2({\cf17 const} PelUnitBuf &curPicBuf, {\cf18 unsigned} {\cf18 char}* pixelsIn1D, {\cf18 int} xStart, {\cf18 int} yStart, {\cf17 const} BitDepths& bitDepths, {\cf18 bool} includeAllComponent)\par
00371 \{\par
