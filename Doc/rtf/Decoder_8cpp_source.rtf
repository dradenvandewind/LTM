00082 {\cf20 // Size of transform block}\par
00083 {\cf20 //}\par
00084 {\cf18 unsigned} Decoder::transform_block_size(){\cf17  const }\{ {\cf19 return} configuration_.global_configuration.transform_block_size; \}\par
00085 \par
00086 {\cf18 unsigned} Decoder::num_residual_layers(){\cf17  const }\{ {\cf19 return} configuration_.global_configuration.num_residual_layers; \}\par
00087 \par
