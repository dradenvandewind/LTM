00361 Image Decoder::decode({\cf17 const} Image &ext_base, Surface (&symbols)[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS],\par
00362                       {\cf17 const} Image &src_image, {\cf18 bool} report, {\cf18 bool} dithering_switch, {\cf18 bool} dithering_fixed, {\cf18 bool} apply_enhancement) \{\par
00363 \par
00364     CHECK(configuration_.global_configuration.transform_block_size == 4 ||\par
00365           configuration_.global_configuration.transform_block_size == 2);\par
00366 \par
00367     {\cf19 if} (dithering_.getInitialised() == {\cf17 false}) \{\par
00368         INFO({\cf22 "Dither init %4d  bitdepth %d"}, configuration_.picture_configuration.dithering_strength,\par
00369              configuration_.global_configuration.enhancement_depth);\par
00370         dithering_.make_buffer(configuration_.picture_configuration.dithering_strength,\par
00371                                configuration_.global_configuration.enhancement_depth, dithering_fixed);\par
00372         dithering_.setInitialised({\cf17 true});\par
00373     \}\par
00374 \par
00375     {\cf17 const} {\cf18 bool} is_idr = configuration_.picture_configuration.coding_type == CodingType::CodingType_IDR;\par
00376 \par
00377     {\cf20 // Verify dimensions of base image}\par
00378     CHECK(ext_base.description().width() == dimensions_.base_width());\par
00379     CHECK(ext_base.description().height() == dimensions_.base_height());\par
00380 \par
00381     {\cf20 // Process each plane...}\par
00382     {\cf20 //}\par
00383     Surface base_reco[MAX_NUM_PLANES];\par
00384     Surface full_reco[MAX_NUM_PLANES];\par
00385     Surface outp_reco[MAX_NUM_PLANES];\par
00386 \par
00387     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < ext_base.description().num_planes(); ++plane) \{\par
00388         {\cf17 const} {\cf18 bool} enhancement_enabled = configuration_.picture_configuration.enhancement_enabled &&\par
00389                                          plane < configuration_.global_configuration.num_processed_planes;\par
00390 \par
00391         {\cf20 // Convert between base and enhancement bit depth}\par
00392         Surface base_plane;\par
00393         {\cf18 unsigned} base_bit_depth = configuration_.global_configuration.base_depth;\par
00394         {\cf19 if} (configuration_.global_configuration.enhancement_depth > configuration_.global_configuration.base_depth &&\par
00395             configuration_.global_configuration.level1_depth_flag) \{\par
00396             base_plane = ConvertBitShift().process(ext_base.plane(plane), configuration_.global_configuration.base_depth,\par
00397                                                    configuration_.global_configuration.enhancement_depth);\par
00398             base_bit_depth = configuration_.global_configuration.enhancement_depth;\par
00399         \}\par
00400 \par
00401         {\cf20 // Base + Correction}\par
00402         base_plane = ConvertToInternal().process(\par
00403             base_bit_depth == configuration_.global_configuration.base_depth ? ext_base.plane(plane) : base_plane, base_bit_depth);\par
00404 \par
00406         {\cf20 //}\par
00407         Surface base_upsampled;\par
00408         {\cf19 switch} (configuration_.global_configuration.scaling_mode[LOQ_LEVEL_1]) \{\par
00409         {\cf19 case} ScalingMode_1D:\par
00410             base_upsampled = Upsampling_1D().process(base_plane, configuration_.global_configuration.upsample,\par
00411                                                      configuration_.global_configuration.upsampling_coefficients);\par
00412             {\cf19 if} (configuration_.global_configuration.predicted_residual_enabled) \{\par
00413                 base_upsampled = PredictedResidualAdjust_1D().process(base_plane, base_upsampled,\par
00414                                                                       PredictedResidualSum_1D().process(base_upsampled));\par
00415             \}\par
00416             base_plane.dump(format({\cf22 "dec_base_deco_P%1d"}, plane));\par
00417             {\cf19 break};\par
00418         {\cf19 case} ScalingMode_2D:\par
00419             base_upsampled = Upsampling().process(base_plane, configuration_.global_configuration.upsample,\par
00420                                                   configuration_.global_configuration.upsampling_coefficients);\par
00421             {\cf19 if} (configuration_.global_configuration.predicted_residual_enabled) \{\par
00422                 base_upsampled =\par
00423                     PredictedResidualAdjust().process(base_plane, base_upsampled, PredictedResidualSum().process(base_upsampled));\par
00424             \}\par
00425             base_plane.dump(format({\cf22 "dec_base_deco_P%1d"}, plane));\par
00426             {\cf19 break};\par
00427         {\cf19 case} ScalingMode_None:\par
00428             base_upsampled = base_plane;\par
00429             {\cf19 break};\par
00430         {\cf19 default}:\par
00431             CHECK(0);\par
00432         \}\par
00433 \par
00434         base_upsampled.dump(format({\cf22 "dec_base_pred_P%1d"}, plane));\par
00435 \par
00436         {\cf20 // Work out quantization matrix for each LoQ}\par
00437         {\cf19 for} ({\cf18 unsigned} loq = 0; loq < MAX_NUM_LOQS; ++loq) \{\par
00438             {\cf17 const} {\cf18 bool} horizontal_only = (configuration_.global_configuration.scaling_mode[loq] == ScalingMode_1D ? true : {\cf17 false});\par
00439             {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00440                 quant_matrix_coeffs_[plane][loq][layer] =\par
