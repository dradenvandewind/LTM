00313 {\cf18 void} Decoder::initialize_decode({\cf17 const} Packet &enhancement_data, Surface (&symbols)[MAX_NUM_PLANES][MAX_NUM_LOQS][MAX_NUM_LAYERS]) \{\par
00314     {\cf20 // Parse the bitstream -- XXX check for seeing blocks in correct order}\par
00315     {\cf20 // Deserializer will popluate configuration_ and symbols during parsing}\par
00316 \par
00317     {\cf20 // Initialize quantization matrix}\par
00318     std::fill_n(&quant_matrix_coeffs_[0][0][0], MAX_NUM_PLANES * MAX_NUM_LOQS * MAX_NUM_LAYERS, -1);\par
00319 \par
00320     Deserializer deserializer(enhancement_data, configuration_, symbols);\par
00321 \par
00322     {\cf19 while} (deserializer.has_more()) \{\par
00323         {\cf17 const} {\cf18 unsigned} block = deserializer.parse_block();\par
00324 \par
00325         {\cf20 // Has there been a new global config?}\par
00326         {\cf19 if} (block == SyntaxBlock_Global) \{\par
00327             {\cf20 // Resize surfaces}\par
00328             dimensions_.set(configuration_, configuration_.global_configuration.resolution_width,\par
00329                             configuration_.global_configuration.resolution_height);\par
00330 \par
00331             {\cf20 // Copy coordinates and sizes into layer surface info}\par
00332             {\cf19 for} ({\cf18 unsigned} plane = 0; plane < configuration_.global_configuration.num_image_planes; ++plane) \{\par
00333                 {\cf19 for} ({\cf18 unsigned} loq = 0; loq < 2; ++loq) \{\par
00334                     {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00335                         configuration_.surface_configuration[plane][loq][layer].width = dimensions_.layer_width(plane, loq);\par
00336                         configuration_.surface_configuration[plane][loq][layer].height = dimensions_.layer_height(plane, loq);\par
00337                     \}\par
00338                 \}\par
00339                 {\cf20 // Is there a temporal layer?}\par
00340                 {\cf19 if} (configuration_.global_configuration.temporal_enabled &&\par
00341                     plane < configuration_.global_configuration.num_processed_planes) \{\par
00342 \par
00343                     configuration_.surface_configuration[plane][LOQ_LEVEL_2][num_residual_layers()].width =\par
00344                         dimensions_.layer_width(plane, LOQ_LEVEL_2);\par
00345                     configuration_.surface_configuration[plane][LOQ_LEVEL_2][num_residual_layers()].height =\par
00346                         dimensions_.layer_height(plane, LOQ_LEVEL_2);\par
00347 \par
00348                     {\cf19 if} (temporal_buffer_[plane].empty() ||\par
00349                         dimensions_.plane_width(plane, LOQ_LEVEL_2) != temporal_buffer_[plane].width() ||\par
00350                         dimensions_.plane_height(plane, LOQ_LEVEL_2) != temporal_buffer_[plane].height())\par
00351                         temporal_buffer_[plane] =\par
00352                             Surface::build_from<int16_t>()\par
00353                                 .reserve(dimensions_.plane_width(plane, LOQ_LEVEL_2), dimensions_.plane_height(plane, LOQ_LEVEL_2))\par
00354                                 .finish();\par
00355                 \}\par
00356             \}\par
00357         \}\par
00358     \}\par
00359 \}\par
