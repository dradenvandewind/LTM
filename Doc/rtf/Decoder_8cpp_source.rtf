00510 \par
00511     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < ext_base.description().num_planes(); ++plane) \{\par
00512         {\cf17 const} {\cf18 bool} enhancement_enabled = configuration_.picture_configuration.enhancement_enabled &&\par
00513                                          plane < configuration_.global_configuration.num_processed_planes;\par
00514 \par
00516         {\cf20 //}\par
00517         {\cf19 if} (enhancement_enabled && apply_enhancement) \{\par
00518             {\cf20 // Enhacement residuals}\par
00519             Surface temporal_mask;\par
00520             Surface residuals = decode_residuals(plane, LOQ_LEVEL_2, temporal_mask, symbols[plane][LOQ_LEVEL_2]);\par
00521             residuals.dump(format({\cf22 "dec_full_resi_reco_P%1d"}, plane));\par
00522 \par
00523             {\cf19 if} (configuration_.global_configuration.temporal_enabled) \{\par
00524                 {\cf20 // Apply temporal map (intra / pred)}\par
00525                 CHECK(!temporal_mask.empty());\par
00526                 {\cf19 if} (temporal_buffer_[plane].empty()) \{\par
00527                     temporal_buffer_[plane] = Surface::build_from<int16_t>()\par
00528                                                   .generate(upsampled_planes[plane].width(), upsampled_planes[plane].height(),\par
00529                                                             [&]({\cf18 unsigned} x, {\cf18 unsigned} y) -> int16_t \{ {\cf19 return} 0; \})\par
00530                                                   .finish();\par
00531                 \}\par
00532                 temporal_buffer_[plane] =\par
00533                     ApplyTemporalMap().process(temporal_buffer_[plane], temporal_mask, transform_block_size());\par
00534 {\cf21 #if defined __OPT_INPLACE__}\par
00535                 \{\par
00536                     {\cf17 auto} viewa = temporal_buffer_[plane].view_as<int16_t>();\par
00537                     {\cf17 auto} viewb = residuals.view_as<int16_t>();\par
00538                     {\cf17 const} int16_t *__restrict psrcb = viewb.data(0, 0);\par
00539                     int16_t *__restrict pdst = (int16_t *)viewa.data(0, 0);\par
00540                     {\cf19 for} ({\cf18 unsigned} y = 0; y < temporal_buffer_[plane].height() * temporal_buffer_[plane].width(); ++y) \{\par
00541                         *pdst++ += (*psrcb++);\par
00542                     \}\par
00543                 \}\par
00544 {\cf21 #else}\par
00545                 temporal_buffer_[plane] = Add().process(temporal_buffer_[plane], residuals);\par
00546 {\cf21 #endif}\par
00547                 temporal_buffer_[plane].dump(format({\cf22 "dec_full_temp_buff_P%1d"}, plane));\par
00548                 temporal_mask.dump(format({\cf22 "dec_full_temp_mask_P%1d"}, plane));\par
00549 \par
00550 {\cf21 #if defined __OPT_INPLACE__}\par
00551                 \{\par
00552                     {\cf17 auto} viewa = upsampled_planes[plane].view_as<int16_t>();\par
00553                     {\cf17 auto} viewb = temporal_buffer_[plane].view_as<int16_t>();\par
00554                     {\cf17 const} int16_t *__restrict psrcb = viewb.data(0, 0);\par
00555                     int16_t *__restrict pdst = (int16_t *)viewa.data(0, 0);\par
00556                     {\cf19 for} ({\cf18 unsigned} y = 0; y < upsampled_planes[plane].height() * upsampled_planes[plane].width(); ++y) \{\par
