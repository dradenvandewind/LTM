00476         \} {\cf19 else} \{\par
00477             base_reco[plane] = base_upsampled;\par
00478         \}\par
00479     \}\par
00480 \par
00482     {\cf20 //}\par
00483     Surface upsampled_planes[MAX_NUM_PLANES];\par
00484     {\cf19 for} ({\cf18 unsigned} plane = 0; plane < ext_base.description().num_planes(); ++plane) \{\par
00485         {\cf19 switch} (configuration_.global_configuration.scaling_mode[LOQ_LEVEL_2]) \{\par
00486         {\cf19 case} ScalingMode_1D:\par
