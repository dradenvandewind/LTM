00090 {\cf20 // Does this layer has user_data embedded?}\par
00091 {\cf20 //}\par
00092 {\cf18 bool} Decoder::is_user_data_layer({\cf18 unsigned} loq, {\cf18 unsigned} layer){\cf17  const }\{\par
00093     {\cf19 if} (loq == LOQ_LEVEL_1 && configuration_.global_configuration.user_data_enabled != UserData_None) \{\par
00094         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00095             {\cf19 return} (layer == 5);\par
00096         {\cf19 else}\par
00097             {\cf19 return} (layer == 1);\par
00098     \}\par
00099     {\cf19 return} {\cf17 false};\par
00100 \}\par
00101 \par
00102 {\cf20 // Derive and return temporal mask}\par
00103 {\cf20 //}\par
00104 Surface Decoder::get_temporal_mask(Surface temporal_symbols) \{\par
00105     {\cf19 if} (!configuration_.global_configuration.temporal_enabled)\par
00106         {\cf19 return} Surface();\par
00107     {\cf19 else} {\cf19 if} (configuration_.picture_configuration.temporal_signalling_present)\par
00108         {\cf19 return} temporal_symbols;\par
00109     {\cf19 else} {\cf19 if} (configuration_.picture_configuration.temporal_refresh)\par
00110         {\cf19 return} Surface::build_from<uint8_t>()\par
00111             .fill(TEMPORAL_INTR, configuration_.global_configuration.resolution_width / transform_block_size(),\par
00112                   configuration_.global_configuration.resolution_height / transform_block_size())\par
00113             .finish();\par
00114     {\cf19 else}\par
00115         {\cf19 return} Surface::build_from<uint8_t>()\par
00116             .fill(TEMPORAL_PRED, configuration_.global_configuration.resolution_width / transform_block_size(),\par
00117                   configuration_.global_configuration.resolution_height / transform_block_size())\par
00118             .finish();\par
00119 \}\par
