00121 {\cf20 // Decode residuals of an enhancement sub-layer}\par
00122 {\cf20 //}\par
00123 Surface Decoder::decode_residuals({\cf18 unsigned} plane, {\cf18 unsigned} loq, Surface &temporal_mask, Surface symbols[MAX_NUM_LAYERS]) \{\par
00124 {\cf21 #if defined __OPT_INPLACE__}\par
00125 {\cf21 #else}\par
00126     Surface coefficients[MAX_NUM_LAYERS];\par
00127 {\cf21 #endif}\par
00128     int32_t dirq_step_width[MAX_NUM_LAYERS][2];\par
00129     int32_t invq_step_width[MAX_NUM_LAYERS][2];\par
00130     int32_t invq_offset[MAX_NUM_LAYERS][2];\par
00131     int32_t invq_deadzone[MAX_NUM_LAYERS][2];\par
00132     int32_t invq_applied_offset[MAX_NUM_LAYERS][2];\par
00133     {\cf17 const} {\cf18 bool} horizontal_only = (configuration_.global_configuration.scaling_mode[loq] == ScalingMode_1D ? true : {\cf17 false});\par
00134     {\cf18 unsigned} passes = 1;\par
00135 \par
00136     {\cf20 // Get temporal mask}\par
00137     {\cf19 if} (loq == LOQ_LEVEL_2 && configuration_.global_configuration.temporal_enabled) \{\par
00138         temporal_mask = get_temporal_mask(symbols[num_residual_layers()]);\par
00139     \}\par
00140 \par
00141     {\cf20 // Apply temporal step width modifier, if required}\par
00142     \{\par
00143         int16_t step_width[2];\par
00144         int16_t calculated_step_width = configuration_.picture_configuration.step_width_loq[loq];\par
00145 \par
00146         {\cf19 if} (loq == LOQ_LEVEL_2 && plane > 0) \{\par
00147             calculated_step_width =\par
00148                 clamp((int16_t)((calculated_step_width * configuration_.global_configuration.chroma_step_width_multiplier) >> 6),\par
00149                       (int16_t)MIN_STEP_WIDTH, (int16_t)MAX_STEP_WIDTH);\par
00150         \}\par
00151 \par
00152         {\cf19 if} (loq == LOQ_LEVEL_2 && configuration_.global_configuration.temporal_enabled &&\par
00153             !configuration_.picture_configuration.temporal_refresh) \{\par
00154             step_width[0] =\par
00155                 clamp((int16_t)(calculated_step_width *\par
00156                                 (1 - clamp((({\cf18 float})configuration_.global_configuration.temporal_step_width_modifier / ({\cf18 float})255),\par
00157                                            ({\cf18 float})0, ({\cf18 float})0.5))),\par
00158                       (int16_t)MIN_STEP_WIDTH, (int16_t)MAX_STEP_WIDTH);\par
00159             step_width[1] = calculated_step_width;\par
00160             passes = 2;\par
00161         \} {\cf19 else} \{\par
00162             step_width[0] = calculated_step_width;\par
00163         \}\par
00164 \par
00165         {\cf19 for} ({\cf18 unsigned} pass = 0; pass < passes; pass++) \{\par
00166             {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00167                 dirq_step_width[layer][pass] = find_dirq_step_width(step_width[pass], quant_matrix_coeffs_[plane][loq][layer]);\par
00168                 invq_offset[layer][pass] =\par
00169                     find_invq_offset(configuration_.picture_configuration, step_width[pass], dirq_step_width[layer][pass]);\par
00170                 invq_step_width[layer][pass] = find_invq_step_width(configuration_.picture_configuration,\par
00171                                                                     dirq_step_width[layer][pass], invq_offset[layer][pass]);\par
00172                 invq_deadzone[layer][pass] = find_layer_deadzone(step_width[pass], invq_step_width[layer][pass]);\par
00173                 invq_applied_offset[layer][pass] = find_invq_applied_offset(configuration_.picture_configuration,\par
00174                                                                             invq_offset[layer][pass], invq_deadzone[layer][pass]);\par
00175             \}\par
00176         \}\par
00177     \}\par
00178 \par
00179     {\cf19 for} ({\cf18 unsigned} layer = 0; layer < num_residual_layers(); ++layer) \{\par
00180 {\cf21 #if defined __OPT_INPLACE__}\par
00181         {\cf17 auto} view = symbols[layer].view_as<int16_t>();\par
00182         {\cf20 // Extract UserData if it is embedded in the coefficients}\par
00183         {\cf19 if} (is_user_data_layer(loq, layer)) \{\par
00184             {\cf18 unsigned} size;\par
00185             {\cf19 switch} (configuration_.global_configuration.user_data_enabled) \{\par
00186             {\cf19 case} lctm::UserData_2bits:\par
00187                 size = 2;\par
00188                 {\cf19 break};\par
00189             {\cf19 case} lctm::UserData_6bits:\par
00190                 size = 6;\par
00191                 {\cf19 break};\par
00192             {\cf19 default}:\par
00193                 CHECK(0);\par
00194                 {\cf19 break};\par
00195             \}\par
00196 \par
00197             \{\par
00198 {\cf21 #if USER_DATA_EXTRACTION}\par
00199                 FILE *file = fopen({\cf22 "userdata_dec.bin"}, {\cf22 "ab"});\par
00200 {\cf21 #endif}\par
00201                 int16_t *__restrict pview = (int16_t *)view.data(0, 0);\par
00202                 {\cf19 for} ({\cf18 unsigned} y = 0; y < view.height() * view.width(); ++y) \{\par
00203                     uint16_t value = *pview;\par
00204 {\cf21 #if USER_DATA_EXTRACTION}\par
00205                     {\cf18 unsigned} {\cf18 char} data = value & (size == 6 ? 0x3f : 0x03);\par
00206                     fwrite(&data, 1, 1, file);\par
00207 {\cf21 #endif}\par
00208                     value >>= size;\par
00209                     {\cf18 bool} sign = (value & 0x01) == 0x00 ? {\cf17 false} : true;\par
00210                     value >>= 1;\par
00211                     *pview++ = (int16_t)(sign ? (-value) : (value));\par
00212                 \}\par
00213 {\cf21 #if USER_DATA_EXTRACTION}\par
00214                 fclose(file);\par
00215 {\cf21 #endif}\par
00216             \}\par
00217         \}\par
00218 {\cf21 #else}\par
00219         Surface syms;\par
00220         {\cf20 // Extract UserData if it is embedded in the coefficients}\par
00221         {\cf19 if} (is_user_data_layer(loq, layer)) \{\par
00222             syms = UserDataClear().process(symbols[layer], configuration_.global_configuration.user_data_enabled);\par
00223         \} {\cf19 else} \{\par
00224             syms = symbols[layer];\par
00225         \}\par
00226 {\cf21 #endif}\par
00227 \par
00228         {\cf20 // Dequantize}\par
00229         {\cf19 if} (passes == 1) \{\par
00230 {\cf21 #if defined __OPT_INPLACE__}\par
00231             \{\par
00232                 int16_t *__restrict pview = (int16_t *)view.data(0, 0);\par
00233                 {\cf19 for} ({\cf18 unsigned} y = 0; y < view.height() * view.width(); ++y) \{\par
00234                     int16_t coef = *pview;\par
00235                     int32_t res = (coef * invq_step_width[layer][0]) +\par
00236                                   (coef > 0 ? invq_applied_offset[layer][0] : (coef < 0 ? -invq_applied_offset[layer][0] : 0));\par
00237                     *pview++ = clamp_int16(res);\par
00238                 \}\par
00239             \}\par
00240 {\cf21 #else}\par
00241             coefficients[layer] = InverseQuantize().process(syms, invq_step_width[layer][0], invq_applied_offset[layer][0]);\par
00242 {\cf21 #endif}\par
00243         \} {\cf19 else} \{\par
00244 {\cf21 #if defined __OPT_INPLACE__}\par
00245             \{\par
00246                 {\cf17 auto} mask = temporal_mask.view_as<uint8_t>();\par
00247                 int16_t *__restrict pview = (int16_t *)view.data(0, 0);\par
00248                 {\cf19 for} ({\cf18 unsigned} y = 0; y < view.height(); ++y) \{\par
00249                     {\cf19 for} ({\cf18 unsigned} x = 0; x < view.width(); ++x) \{\par
00250                         {\cf18 unsigned} sw_index = (mask.read(x, y) == TEMPORAL_PRED) ? 0 : 1;\par
00251                         int16_t coef = *pview;\par
00252 \par
00253                         *pview++ = clamp_int16(coef * invq_step_width[layer][sw_index] +\par
00254                                                (coef > 0 ? invq_applied_offset[layer][sw_index]\par
00255                                                          : (coef < 0 ? -invq_applied_offset[layer][sw_index] : 0)));\par
00256                     \}\par
00257                 \}\par
00258             \}\par
00259 {\cf21 #else}\par
00260             coefficients[layer] = InverseQuantize_SWM().process(syms, transform_block_size(), invq_step_width[layer],\par
00261                                                                 invq_applied_offset[layer], temporal_mask);\par
00262 {\cf21 #endif}\par
00263         \}\par
00264     \}\par
00265 \par
00266     Surface residuals;\par
00267 \par
00268 {\cf21 #if defined __OPT_INPLACE__}\par
00269     {\cf19 if} (!horizontal_only) \{\par
00270         {\cf20 // Inverse Transform Horizontal and Vertical}\par
00271         {\cf20 //}\par
00272         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00273             residuals =\par
00274                 InverseTransformDDS().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq), symbols);\par
00275         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00276             residuals =\par
00277                 InverseTransformDD().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq), symbols);\par
00278     \} {\cf19 else} \{\par
00279         {\cf20 // Inverse Transform Horizontal only}\par
00280         {\cf20 //}\par
00281         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00282             residuals = InverseTransformDDS_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00283                                                          symbols);\par
00284         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00285             residuals =\par
00286                 InverseTransformDD_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq), symbols);\par
00287     \}\par
00288 {\cf21 #else}\par
00289     {\cf19 if} (!horizontal_only) \{\par
00290         {\cf20 // Inverse Transform Horizontal and Vertical}\par
00291         {\cf20 //}\par
00292         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00293             residuals = InverseTransformDDS().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00294                                                       coefficients);\par
00295         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00296             residuals = InverseTransformDD().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00297                                                      coefficients);\par
00298     \} {\cf19 else} \{\par
00299         {\cf20 // Inverse Transform Horizontal only}\par
00300         {\cf20 //}\par
00301         {\cf19 if} (configuration_.global_configuration.transform_block_size == 4)\par
00302             residuals = InverseTransformDDS_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00303                                                          coefficients);\par
00304         {\cf19 else} {\cf19 if} (configuration_.global_configuration.transform_block_size == 2)\par
00305             residuals = InverseTransformDD_1D().process(dimensions_.plane_width(plane, loq), dimensions_.plane_height(plane, loq),\par
00306                                                         coefficients);\par
00307     \}\par
00308 {\cf21 #endif}\par
00309 \par
00310     {\cf19 return} residuals;\par
00311 \}\par
