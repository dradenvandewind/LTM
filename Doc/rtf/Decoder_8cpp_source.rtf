00496                                                            configuration_.global_configuration.upsampling_coefficients);\par
00497             {\cf19 if} (configuration_.global_configuration.predicted_residual_enabled) \{\par
00498                 upsampled_planes[plane] = PredictedResidualAdjust().process(\par
