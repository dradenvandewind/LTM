00703     {\cf18 int} add_enhancement(ESFile::AccessUnit &au, {\cf18 bool} is_idr, {\cf17 const} Packet &payload){\cf17  override }\{\par
00704         ESFile::NalUnit nal_unit;\par
00705 \par
00706         {\cf19 if} (encapsulation_ == Encapsulation_None || encapsulation_ == Encapsulation_NAL) \{\par
