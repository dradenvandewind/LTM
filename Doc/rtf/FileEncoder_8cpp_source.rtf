00517 {\cf20 // RBSP encapsualtion (0b00000000 0b00000000 0b000000xx -> 0b00000000 0b00000000 0b00000011 0b000000xx)}\par
00518 {\cf20 //}\par
00519 Packet FileEncoderImpl::rbsp_encapsulate({\cf17 const} Packet &src){\cf17  const }\{\par
00520     PacketView in(src);\par
00521 \par
00522     vector<uint8_t> out;\par
00523 \par
00524     {\cf18 unsigned} zeros = 0;\par
00525     {\cf19 for} ({\cf18 unsigned} {\cf18 int} i = 0; i < in.size(); ++i) \{\par
00526         uint8_t b = in.data()[i];\par
00527 \par
00528         {\cf19 if} (zeros == 2 && (b & ~3) == 0) \{\par
00529             out.push_back(0x03);\par
00530             zeros = 0;\par
00531         \}\par
00532 \par
00533         {\cf19 if} (b == 0)\par
00534             ++zeros;\par
00535         {\cf19 else}\par
00536             zeros = 0;\par
00537 \par
00538         out.push_back(b);\par
00539     \}\par
00540 \par
00541     out.push_back(0x80);\par
00542 \par
00543     {\cf19 return} Packet::build().contents(out).finish();\par
00544 \}\par
