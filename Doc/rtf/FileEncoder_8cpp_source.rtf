00546 {\cf20 // Make the SEI encapsulated payload data given enhancement data}\par
00547 {\cf20 //}\par
00548 Packet FileEncoderImpl::RegisteredSEI::sei_payload({\cf17 const} Packet &enhancement_data) \{\par
00549     BitstreamPacker sei;\par
00550 \par
00551     {\cf20 // SEI Type: Registered}\par
00552     sei.u(8, 0x04);\par
00553 \par
00554     {\cf20 // SEI Length}\par
00555     {\cf18 unsigned} l = enhancement_data.size() + 4;\par
00556     {\cf19 while} (l >= 255) \{\par
00557         sei.u(8, 255);\par
00558         l -= 255;\par
00559     \}\par
00560     sei.u(8, l);\par
00561 \par
00562     {\cf20 // SEI code}\par
00563     {\cf17 static} {\cf17 const} uint8_t sei_code[4] = \{0xb4, 0x00, 0x50, 0x00\};\par
00564     sei.bytes(sei_code, 4);\par
00565 \par
00566     {\cf20 // Enhancement part of payload}\par
00567     sei.bytes(enhancement_data);\par
00568 \par
00569     {\cf19 return} sei.finish();\par
00570 \}\par
00571 \par
00572 Packet FileEncoderImpl::UnregisteredSEI::sei_payload({\cf17 const} Packet &enhancement_data) \{\par
00573     BitstreamPacker sei;\par
00574 \par
00575     {\cf20 // SEI Type: Unregistered}\par
00576     sei.u(8, 0x05);\par
00577 \par
00578     {\cf20 // SEI Length}\par
00579     {\cf18 unsigned} l = enhancement_data.size() + 16;\par
00580     {\cf19 while} (l >= 255) \{\par
00581         sei.u(8, 255);\par
00582         l -= 255;\par
00583     \}\par
00584     sei.u(8, l);\par
00585 \par
00586     {\cf20 // UUID}\par
00587     {\cf17 static} {\cf17 const} uint8_t uuid[16] = \{0xa7, 0xc4, 0x6d, 0xed, 0x49, 0xd8, 0x38, 0xeb,\par
00588                                      0x9a, 0xad, 0x6d, 0xa6, 0x84, 0x97, 0xa7, 0x54\};\par
00589     sei.bytes(uuid, 16);\par
00590 \par
00591     {\cf20 // Enhancement part of payload}\par
00592     sei.bytes(enhancement_data);\par
00593 \par
00594     {\cf19 return} sei.finish();\par
00595 \}\par
