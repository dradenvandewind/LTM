00608 {\cf20 // Build  a standard LCEV NALU}\par
00609 {\cf20 //}\par
00610 ESFile::NalUnit FileEncoderImpl::build_nalu({\cf17 const} {\cf18 bool} is_idr, {\cf17 const} Packet &payload){\cf17  const }\{\par
00611     {\cf20 // nal_marker, forbidden_zero_bit, forbidden_one_bit, nal_unit_type=28/29, reserved_flag}\par
00612     {\cf17 const} NalUnitType nal_type = is_idr ? NalUnitType::LCEVC_IDR : NalUnitType::LCEVC_NON_IDR;\par
00613     {\cf17 const} uint8_t nalu_header_lcevc[5] = \{0x00, 0x00, 0x01, (uint8_t)(is_idr ? 0x7b : 0x79), 0xff\};\par
00614     ESFile::NalUnit nal_unit = \{(uint32_t)nal_type, DataBuffer(nalu_header_lcevc, nalu_header_lcevc + {\cf17 sizeof}(nalu_header_lcevc))\};\par
00615 \par
00616     {\cf17 const} Packet rbsp = rbsp_encapsulate(nal_payload(payload));\par
00617     {\cf17 const} PacketView v(rbsp);\par
00618     nal_unit.m_data.insert(nal_unit.m_data.end(), v.data(), v.data() + v.size());\par
00619 \par
00620     {\cf19 return} nal_unit;\par
00621 \}\par
