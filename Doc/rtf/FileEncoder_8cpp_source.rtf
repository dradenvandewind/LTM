00726             nal_unit = \{6, DataBuffer(nalu_header, nalu_header + {\cf17 sizeof}(nalu_header))\};\par
00727 \par
00728             Packet rbsp = rbsp_encapsulate(UnregisteredSEI::sei_payload(payload));\par
00729             {\cf17 const} PacketView v(rbsp);\par
00730             nal_unit.m_data.insert(nal_unit.m_data.end(), v.data(), v.data() + v.size());\par
00731         \} {\cf19 else} \{\par
00732             CHECK(0);\par
00733         \}\par
00734 \par
00735         {\cf20 // Insert after - after AUD and PPS/SPS}\par
00736         {\cf18 unsigned} offset = 0;\par
00737         {\cf19 for} (offset = 0; offset < au.m_nalUnits.size(); ++offset) \{\par
00738             {\cf19 if} (au.m_nalUnits[offset].m_type < 7 || au.m_nalUnits[offset].m_type > 9)\par
00739                 {\cf19 break};\par
00740         \}\par
00741 \par
00742         au.m_nalUnits.insert(au.m_nalUnits.begin() + offset, nal_unit);\par
00743         {\cf19 return} ({\cf18 int})(nal_unit.m_data.size());\par
00744     \}\par
