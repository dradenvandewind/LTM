00185 {\cf18 void} FileEncoderImpl::encode_file({\cf17 const} {\cf18 string} &src_filename, {\cf17 const} {\cf18 string} &dst_filename, {\cf17 const} {\cf18 string} &dst_filename_yuv,\par
00186                                   {\cf18 unsigned} limit) \{\par
00187     {\cf20 // Temp. input file to encode}\par
00188     {\cf20 //}\par
00189     {\cf18 string} base_yuv_filename = make_temporary_filename({\cf22 "_base.yuv"});\par
00190 \par
00191     {\cf20 // Output files}\par
00192     {\cf20 //}\par
00193     {\cf18 string} base_bin_filename;\par
00194     {\cf18 string} base_recon_filename;\par
00195 \par
00196     {\cf19 if} (!parameters_[{\cf22 "keep_base"}].get<bool>({\cf17 false})) \{\par
00197         base_bin_filename = make_temporary_filename({\cf22 "_base.bin"});\par
00198         base_recon_filename = make_temporary_filename({\cf22 "_base_recon.yuv"});\par
00199     \} {\cf19 else} \{\par
00200         base_bin_filename = {\cf22 "base.bin"};\par
00201         base_recon_filename = {\cf22 "base_recon.yuv"};\par
00202     \}\par
00203 \par
00204     INFO({\cf22 "Using temporary file for base YUV: %s"}, base_yuv_filename.c_str());\par
00205     INFO({\cf22 "Using temporary file for base stream: %s"}, base_bin_filename.c_str());\par
00206     INFO({\cf22 "Using temporary file for base recon: %s"}, base_recon_filename.c_str());\par
00207 \par
00208     {\cf20 // Read source and downsample into base}\par
00209     {\cf20 //}\par
00210     unique_ptr<YUVReader> src_file(CHECK(CreateYUVReader(src_filename, encoder_.src_image_description(), fps_)));\par
00211     initialize_encoder(*src_file, limit);\par
00212     {\cf17 auto} base_yuv = CHECK(CreateYUVWriter(base_yuv_filename, encoder_.base_image_description(), {\cf17 true}));\par
00213 \par
00214     int64_t pts = 0;\par
00215     int64_t duration = 90000L / fps_;\par
00216 \par
00217     {\cf17 const} {\cf18 unsigned} frame_count = min(src_file->length(), limit);\par
00218     INFO({\cf22 "input limit %8d - local count %8d"}, limit, frame_count);\par
00219     {\cf17 const} {\cf18 bool} level1_depth_flag = encoder_.level1_depth_flag();\par
00220 \par
00221     {\cf19 for} ({\cf18 unsigned} f = 0; f < frame_count; ++f, pts += duration) \{\par
00222         INFO({\cf22 "Writing base %d"}, f);\par
00223         {\cf17 const} Image src = ExpandImage(src_file->read(f, pts), encoder_.enhancement_image_description());\par
00224         {\cf20 // Downsample and bit shifting depending base and enhancement bit depths}\par
00225         {\cf17 const} Image img = DownsampleImage(DownsampleImage(src, downsample_luma_, downsample_chroma_, scaling_mode_[LOQ_LEVEL_2],\par
00226                                                           level1_depth_flag ? 0 : encoder_.base_image_description().bit_depth()),\par
00227                                           downsample_luma_, downsample_chroma_, scaling_mode_[LOQ_LEVEL_1],\par
00228                                           level1_depth_flag ? encoder_.base_image_description().bit_depth() : 0);\par
00229         base_yuv->write(img);\par
00230     \}\par
00231 \par
00232     {\cf20 // Run the base encoder yuv-file-> es-file and recon}\par
00233     run_base_encoder(base_yuv->filename(), base_bin_filename, base_recon_filename, frame_count);\par
00234 \par
00235     {\cf20 // Open file}\par
00236     unique_ptr<YUVReader> recon_file(CHECK(CreateYUVReader(base_recon_filename, encoder_.base_image_description(), fps_)));\par
00237 \par
00238     UniquePtrFile output_file(CHECK(fopen(format({\cf22 "%s"}, dst_filename.c_str()).c_str(), {\cf22 "wb"})));\par
00239 \par
00240     ESFile es_file;\par
00241     CHECK(es_file.Open(base_bin_filename, es_file_type()));\par
00242 \par
00243     {\cf20 // Encode enhancement given src, base and base_recon}\par
00244     clock_t EnhaClock1 = clock();\par
00245 \par
00246     encode(*src_file, *recon_file, output_file.get(), es_file, dst_filename_yuv, limit);\par
00247 \par
00248     clock_t EnhaClock2 = clock();\par
00249 \par
00250     INFO({\cf22 "**** Encode enhancement. delta. %16d secs"}, (EnhaClock2 - EnhaClock1) / CLOCKS_PER_SEC);\par
00251     {\cf20 // Clear up}\par
00252     {\cf19 if} (!parameters_[{\cf22 "keep_base"}].get<bool>({\cf17 false})) \{\par
00253         ::remove(base_yuv_filename.c_str());\par
00254         ::remove(base_bin_filename.c_str());\par
00255         ::remove(base_recon_filename.c_str());\par
00256     \}\par
00257 \}\par
