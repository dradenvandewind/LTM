00710             {\cf20 // Encapsulate LCEVC Data into a NAL unit}\par
00711             ESFile::NalUnit nal_unit_lcevc = build_nalu(is_idr, payload);\par
00712             Packet payload_lcevc = Packet::build().contents(nal_unit_lcevc.m_data).finish();\par
00713 \par
00714             {\cf20 // Regsitered SEI Encapsulation of LCEVC NAL unit}\par
00715             {\cf20 // nal_marker, forbidden_zero_bit, nal_unit_type=6, reserved_flag}\par
00716             {\cf17 static} {\cf17 const} uint8_t nalu_header[4] = \{0x00, 0x00, 0x01, 0x06\};\par
00717             nal_unit = \{6, DataBuffer(nalu_header, nalu_header + {\cf17 sizeof}(nalu_header))\};\par
00718 \par
00719             Packet rbsp = rbsp_encapsulate(RegisteredSEI::sei_payload(payload_lcevc));\par
00720             {\cf17 const} PacketView v(rbsp);\par
00721             nal_unit.m_data.insert(nal_unit.m_data.end(), v.data(), v.data() + v.size());\par
00722         \} {\cf19 else} {\cf19 if} (encapsulation_ == Encapsulation_SEI_Unregistered) \{\par
00723             {\cf20 // Ungreistered SEI Encapsulation}\par
