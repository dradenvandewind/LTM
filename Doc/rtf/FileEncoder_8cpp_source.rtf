00371 {\cf18 void} FileEncoderImpl::encode({\cf17 const} YUVReader &src_file, {\cf17 const} YUVReader &recon_file, FILE *output_file, ESFile &es_file,\par
00372                              {\cf17 const} {\cf18 string} &dst_filename_yuv, {\cf18 unsigned} limit) \{\par
00373 \par
00374     {\cf20 // Queue of pending AUs, so that enhancment can be encoded in display order}\par
00375     deque<ESFile::AccessUnit> pending;\par
00376 \par
00377     {\cf18 unsigned} display_frame = 0;\par
00378     {\cf18 unsigned} written_count = 0;\par
00379     {\cf18 bool} end_of_es = {\cf17 false};\par
00380     encoder_.set_last_idr_frame_num(0);\par
00381     std::vector<std::unique_ptr<Image>> src;\par
00382 \par
00383     {\cf17 const} {\cf18 unsigned} num_frames = std::min(src_file.length(), limit);\par
00384     {\cf19 if} (num_frames == 0)\par
00385         ERR({\cf22 "Frames cannot be read from source."});\par
00386 \par
00387     {\cf20 // Fill with initial frame}\par
00388     src.push_back(make_unique<Image>(ExpandImage(src_file.read(0, 0), encoder_.enhancement_image_description())));\par
00389 \par
00390     {\cf19 while} (written_count < limit && !end_of_es) \{\par
00391 \par
00392         {\cf20 // Get next AU from base stream}\par
00393         ESFile::AccessUnit au;\par
00394         {\cf19 if} (read_au(es_file, au))\par
00395             pending.push_front(au);\par
00396         {\cf19 else}\par
00397             end_of_es = {\cf17 true};\par
00398 \par
00399         {\cf20 // Advance 'enhancement_poc' past AUs that are present in queue, adding enhancement as needed}\par
00400         {\cf18 bool} keep_looking = {\cf17 false};\par
00401         {\cf19 do} \{\par
00402             keep_looking = {\cf17 false};\par
00403             {\cf19 for} ({\cf17 auto} &a : pending) \{\par
00404 \par
00405                 {\cf20 // AVC POCs are increased by 2 XXX move to virtual fn}\par
00406                 {\cf17 const} {\cf18 unsigned} enhance_poc = (es_file_type() == BaseDecoder::AVC) ? 2 * display_frame : display_frame;\par
00407 \par
00408                 {\cf19 if} (a.m_poc == enhance_poc) \{\par
00409                     {\cf19 if} (display_frame != 0)\par
00410                         src.erase(src.begin());\par
00411                     {\cf19 if} (src.size() < 2 && (display_frame + 1) < src_file.length()) \{\par
00412                         src.push_back(make_unique<Image>(ExpandImage(src_file.read(display_frame + 1, display_frame + 1),\par
00413                                                                      encoder_.enhancement_image_description())));\par
00414                     \}\par
00415 \par
00416                     {\cf17 const} Image recon = recon_file.read(display_frame, display_frame);\par
00417 \par
00418                     {\cf17 const} Image src_intermediate =\par
00419                         DownsampleImage(*src[0], downsample_luma_, downsample_chroma_, scaling_mode_[LOQ_LEVEL_2],\par
00420                                         encoder_.intermediate_image_description().bit_depth());\par
00421 \par
00422                     {\cf20 // Enhancement encoding}\par
00423                     {\cf17 const} {\cf18 bool} is_idr = a.m_pictureType == BaseDecPictType::IDR;\par
00424                     Packet pss = encoder_.encode(src, src_intermediate, recon, frame_type(a.m_pictureType), is_idr, display_frame,\par
00425                                                  dst_filename_yuv);\par
00426 \par
00427                     goReportStructure.miTimeStamp = (int)a.m_poc;\par
00428                     goReportStructure.miPictureType = (int)a.m_pictureType;\par
00429                     goReportStructure.miBaseSize = (int)a.m_size;\par
00430                     {\cf19 if} (!pss.empty())\par
00431                         goReportStructure.miEnhancementSize = add_enhancement(a, is_idr, pss);\par
00432                     goReportQueue.push(goReportStructure);\par
00433                     goPsnr.miBaseBytes += goReportStructure.miBaseSize;\par
00434                     goPsnr.miEnhancementBytes += goReportStructure.miEnhancementSize;\par
00435 \par
00436                     {\cf20 // clang-format off}\par
00437                     fprintf(stdout, {\cf22 "ENC. [pts. %4d] [type %4d] [base %8d] [enha %8d] "},\par
00438                         goReportStructure.miTimeStamp, goReportStructure.miPictureType, goReportStructure.miBaseSize, goReportStructure.miEnhancementSize);\par
00439                     fflush(stdout);\par
00440                     fprintf(stdout, {\cf22 "[psnrY %8.4f] "}, goPsnr.mfCurPsnr[0]);\par
00441                     {\cf19 if} (encoder_.src_image_description().num_planes() > 1)\par
00442                         fprintf(stdout, {\cf22 "[psnrU %8.4f] [psnrV %8.4f] \\n"}, (goPsnr.mfCurPsnr[1]), (goPsnr.mfCurPsnr[2]));\par
00443                     {\cf19 else}\par
00444                         fprintf(stdout, {\cf22 "\\n"});\par
00445                     fflush(stdout);\par
00446                     fprintf(stdout, {\cf22 "[MD5Y %02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X] "}, \par
00447                         gaucMd5Digest[0][0],  gaucMd5Digest[0][1],  gaucMd5Digest[0][2],  gaucMd5Digest[0][3],  \par
00448                         gaucMd5Digest[0][4],  gaucMd5Digest[0][5],  gaucMd5Digest[0][6],  gaucMd5Digest[0][7],  \par
00449                         gaucMd5Digest[0][8],  gaucMd5Digest[0][9],  gaucMd5Digest[0][10], gaucMd5Digest[0][11], \par
00450                         gaucMd5Digest[0][12], gaucMd5Digest[0][13], gaucMd5Digest[0][14], gaucMd5Digest[0][15]);\par
00451                     fflush(stdout);\par
00452                     {\cf19 if} (encoder_.src_image_description().num_planes() > 1) \{\par
00453                         fprintf(stdout, {\cf22 "[MD5U %02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X] "}, \par
00454                             gaucMd5Digest[1][0],  gaucMd5Digest[1][1],  gaucMd5Digest[1][2],  gaucMd5Digest[1][3],  \par
00455                             gaucMd5Digest[1][4],  gaucMd5Digest[1][5],  gaucMd5Digest[1][6],  gaucMd5Digest[1][7],  \par
00456                             gaucMd5Digest[1][8],  gaucMd5Digest[1][9],  gaucMd5Digest[1][10], gaucMd5Digest[1][11], \par
00457                             gaucMd5Digest[1][12], gaucMd5Digest[1][13], gaucMd5Digest[1][14], gaucMd5Digest[1][15]);\par
00458                         fflush(stdout);\par
00459                         fprintf(stdout, {\cf22 "[MD5V %02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X] \\n"}, \par
00460                             gaucMd5Digest[2][0],  gaucMd5Digest[2][1],  gaucMd5Digest[2][2],  gaucMd5Digest[2][3],  \par
00461                             gaucMd5Digest[2][4],  gaucMd5Digest[2][5],  gaucMd5Digest[2][6],  gaucMd5Digest[2][7],  \par
00462                             gaucMd5Digest[2][8],  gaucMd5Digest[2][9],  gaucMd5Digest[2][10], gaucMd5Digest[2][11], \par
00463                             gaucMd5Digest[2][12], gaucMd5Digest[2][13], gaucMd5Digest[2][14], gaucMd5Digest[2][15]);\par
00464                         fflush(stdout);\par
00465                     \} {\cf19 else} \{\par
00466                         fprintf(stdout, {\cf22 "\\n"});\par
00467                         fflush(stdout);\par
00468                     \}\par
00469                     {\cf20 // clang-format on}\par
00470 \par
00471                     display_frame++;\par
00472                     keep_looking = {\cf17 true};\par
00473 \par
00474                     {\cf20 // INFO("base -- %4u %8u %4u", display_frame, pss.size(), a.m_pictureType);}\par
00475                     {\cf19 break};\par
00476                 \}\par
00477             \}\par
00478         \} {\cf19 while} (keep_looking);\par
00479 \par
00480         {\cf20 // Consume AUs that have been enhanced from the back of queue and write to output stream}\par
00481         {\cf17 const} {\cf18 unsigned} write_poc = (es_file_type() == BaseDecoder::AVC) ? 2 * display_frame : display_frame;\par
00482         {\cf19 while} (!pending.empty() && (pending.back().m_poc < write_poc)) \{\par
00483             {\cf19 for} ({\cf17 const} {\cf17 auto} &n : pending.back().m_nalUnits) \{\par
00484                 {\cf18 size_t} sz = n.m_data.size();\par
00485                 {\cf20 // INFO("lvc  -- %4u %8u", written_count, sz);}\par
00486                 CHECK(fwrite(n.m_data.data(), 1, sz, output_file) == sz);\par
00487             \}\par
00488             pending.pop_back();\par
00489             ++written_count;\par
00490         \}\par
00491     \}\par
00492 \par
00493     {\cf19 if} (written_count > 0) \{\par
00494         {\cf18 int} iFrames = written_count;\par
00495 \par
00496         {\cf18 float} fAccMse[MAX_NUM_PLANES];\par
00497         {\cf18 float} fPsnr[MAX_NUM_PLANES];\par
00498         {\cf19 for} ({\cf18 unsigned} plane = 0; plane < encoder_.src_image_description().num_planes(); plane++) \{\par
00499             fAccMse[plane] = goPsnr.mfAccMse[plane] / iFrames;\par
00500             fPsnr[plane] = (float)(10.0f * log10((32767.0f * 32767.0f) / fAccMse[plane]));\par
00501         \}\par
00502 \par
00503         REPORT({\cf22 "========= ========= ========= ========= ========= ========= ========= ========= "});\par
00504         {\cf19 if} (encoder_.src_image_description().num_planes() > 1)\par
00505             REPORT({\cf22 "PSNR -- YUV %8.4f -- Y %8.4f U %8.4f V %8.4f"}, (6 * fPsnr[0] + fPsnr[1] + fPsnr[2]) / 8, fPsnr[0], fPsnr[1],\par
00506                    fPsnr[2]);\par
00507         {\cf19 else}\par
00508             REPORT({\cf22 "PSNR -- Y %8.4f"}, fPsnr[0]);\par
00509         REPORT({\cf22 "========= ========= ========= ========= ========= ========= ========= ========= "});\par
00510         REPORT({\cf22 "BITS -- base %8d bps -- enha %8d bps "}, (goPsnr.miBaseBytes * 8 * this->fps_) / iFrames,\par
00511                (goPsnr.miEnhancementBytes * 8 * this->fps_) / iFrames);\par
00512         REPORT({\cf22 "========= ========= ========= ========= ========= ========= ========= ========= "});\par
