01409 {\cf17 inline} {\cf18 void} LoopFilter::xBilinearFilter(Pel* srcP, Pel* srcQ, {\cf18 int} offset, {\cf18 int} refMiddle, {\cf18 int} refP, {\cf18 int} refQ, {\cf18 int} numberPSide, {\cf18 int} numberQSide, {\cf17 const} {\cf18 int}* dbCoeffsP, {\cf17 const} {\cf18 int}* dbCoeffsQ, {\cf18 int} tc){\cf17  const}\par
01410 {\cf17 }\{\par
01411   {\cf17 const} {\cf18 char} tc7[7] = \{ 6, 5, 4, 3, 2, 1, 1 \};\par
01412   {\cf17 const} {\cf18 char} tc3[3] = \{ 6, 4, 2 \};\par
01413 \par
01414   {\cf17 const} {\cf18 char} *tcP = (numberPSide == 3) ? tc3 : tc7;\par
01415   {\cf17 const} {\cf18 char} *tcQ = (numberQSide == 3) ? tc3 : tc7;\par
01416 \par
01417   {\cf19 for} ({\cf18 int} pos = 0; pos < numberPSide; pos++)\par
01418   \{\par
01419     {\cf18 int} src    = srcP[-offset * pos];\par
01420     {\cf18 int} cvalue = (tc * tcP[pos]) >> 1;\par
01421     srcP[-offset * pos] =\par
01422       Clip3(src - cvalue, src + cvalue, ((refMiddle * dbCoeffsP[pos] + refP * (64 - dbCoeffsP[pos]) + 32) >> 6));\par
01423   \}\par
01424   {\cf19 for} ({\cf18 int} pos = 0; pos < numberQSide; pos++)\par
01425   \{\par
01426     {\cf18 int} src    = srcQ[offset * pos];\par
01427     {\cf18 int} cvalue = (tc * tcQ[pos]) >> 1;\par
01428     srcQ[offset * pos] =\par
01429       Clip3(src - cvalue, src + cvalue, ((refMiddle * dbCoeffsQ[pos] + refQ * (64 - dbCoeffsQ[pos]) + 32) >> 6));\par
01430   \}\par
01431 \}\par
01432 \par
01433 {\cf17 inline} {\cf18 void} LoopFilter::xFilteringPandQ(Pel* src, {\cf18 int} offset, {\cf18 int} numberPSide, {\cf18 int} numberQSide, {\cf18 int} tc){\cf17  const}\par
01434 {\cf17 }\{\par
01435   CHECK(numberPSide <= 3 && numberQSide <= 3, {\cf22 "Short filtering in long filtering function"});\par
01436   Pel* srcP = src-offset;\par
01437   Pel* srcQ = src;\par
01438 \par
01439   {\cf18 int} refP = 0;\par
01440   {\cf18 int} refQ = 0;\par
01441   {\cf18 int} refMiddle = 0;\par
01442 \par
01443   {\cf17 const} {\cf18 int} dbCoeffs7[7] = \{ 59, 50, 41,32,23,14,5 \};\par
01444   {\cf17 const} {\cf18 int} dbCoeffs3[3] = \{ 53, 32, 11 \};\par
01445   {\cf17 const} {\cf18 int} dbCoeffs5[5] = \{ 58, 45, 32,19,6\};\par
01446   {\cf17 const} {\cf18 int}* dbCoeffsP   = numberPSide == 7 ? dbCoeffs7 : (numberPSide==5) ? dbCoeffs5 : dbCoeffs3;\par
01447   {\cf17 const} {\cf18 int}* dbCoeffsQ   = numberQSide == 7 ? dbCoeffs7 : (numberQSide==5) ? dbCoeffs5 : dbCoeffs3;\par
01448 \par
01449   {\cf19 switch} (numberPSide)\par
01450   \{\par
01451     {\cf19 case} 7: refP = (srcP[-6*offset]   + srcP[-7 * offset] + 1) >> 1; {\cf19 break};\par
01452     {\cf19 case} 3: refP = (srcP[-2 * offset] + srcP[-3 * offset] + 1) >> 1; {\cf19 break};\par
01453     {\cf19 case} 5: refP = (srcP[-4 * offset] + srcP[-5 * offset] + 1) >> 1; {\cf19 break};\par
01454   \}\par
01455 \par
01456   {\cf19 switch} (numberQSide)\par
01457   \{\par
01458     {\cf19 case} 7: refQ = (srcQ[6 * offset] + srcQ[7 * offset] + 1) >> 1; {\cf19 break};\par
01459     {\cf19 case} 3: refQ = (srcQ[2 * offset] + srcQ[3 * offset] + 1) >> 1; {\cf19 break};\par
01460     {\cf19 case} 5: refQ = (srcQ[4 * offset] + srcQ[5 * offset] + 1) >> 1; {\cf19 break};\par
01461   \}\par
01462 \par
01463   {\cf19 if} (numberPSide == numberQSide)\par
01464   \{\par
01465     {\cf19 if} (numberPSide == 5)\par
01466     \{\par
01467       refMiddle = (2 * (srcP[0] + srcQ[0] + srcP[-offset] + srcQ[offset] + srcP[-2 * offset] + srcQ[2 * offset]) + srcP[-3 * offset] + srcQ[3 * offset] + srcP[-4 * offset] + srcQ[4 * offset] + 8) >> 4;\par
01468     \}\par
01469     {\cf19 else}\par
01470     \{\par
01471       refMiddle = (2 * (srcP[0] + srcQ[0]) + srcP[-offset] + srcQ[offset] + srcP[-2 * offset] + srcQ[2 * offset] + srcP[-3 * offset] + srcQ[3 * offset] + srcP[-4 * offset] + srcQ[4 * offset] + srcP[-5 * offset] + srcQ[5 * offset] + +srcP[-6 * offset] + srcQ[6 * offset] + 8) >> 4;\par
01472     \}\par
01473   \}\par
01474   {\cf19 else}\par
01475   \{\par
01476     Pel* srcPt = srcP;\par
01477     Pel* srcQt = srcQ;\par
01478     {\cf18 int} offsetP = -offset;\par
01479     {\cf18 int} offsetQ = offset;\par
01480 \par
01481     {\cf18 int} newNumberQSide = numberQSide;\par
01482     {\cf18 int} newNumberPSide = numberPSide;\par
01483     {\cf19 if} (numberQSide > numberPSide)\par
01484     \{\par
01485       std::swap(srcPt, srcQt);\par
01486       std::swap(offsetP, offsetQ);\par
01487       newNumberQSide = numberPSide;\par
01488       newNumberPSide = numberQSide;\par
01489     \}\par
01490 \par
01491     {\cf19 if} (newNumberPSide == 7 && newNumberQSide == 5)\par
01492     \{\par
01493       refMiddle = (2 * (srcP[0] + srcQ[0] + srcP[-offset] + srcQ[offset]) + srcP[-2 * offset] + srcQ[2 * offset] + srcP[-3 * offset] + srcQ[3 * offset] + srcP[-4 * offset] + srcQ[4 * offset] + srcP[-5 * offset] + srcQ[5 * offset] + 8) >> 4;\par
01494     \}\par
01495     {\cf19 else} {\cf19 if} (newNumberPSide == 7 && newNumberQSide == 3)\par
01496     \{\par
01497       refMiddle = (2 * (srcPt[0] + srcQt[0]) + srcQt[0] + 2 * (srcQt[offsetQ] + srcQt[2 * offsetQ]) + srcPt[offsetP] + srcQt[offsetQ] + srcPt[2 * offsetP] + srcPt[3 * offsetP] + srcPt[4 * offsetP] + srcPt[5 * offsetP] + srcPt[6 * offsetP] + 8) >> 4;\par
01498     \}\par
01499     {\cf19 else} {\cf20 //if (newNumberPSide == 5 && newNumberQSide == 3)}\par
01500     \{\par
01501       refMiddle = (srcP[0] + srcQ[0] + srcP[-offset] + srcQ[offset] + srcP[-2 * offset] + srcQ[2 * offset] + srcP[-3 * offset] + srcQ[3 * offset] + 4) >> 3;\par
01502     \}\par
01503   \}\par
01504   xBilinearFilter(srcP,srcQ,offset,refMiddle,refP,refQ,numberPSide,numberQSide,dbCoeffsP,dbCoeffsQ,tc);\par
01505 \}\par
01506 \par
01507 {\cf17 inline} {\cf18 void} LoopFilter::xPelFilterLuma(Pel* piSrc, {\cf17 const} {\cf18 int} iOffset, {\cf17 const} {\cf18 int} tc, {\cf17 const} {\cf18 bool} sw, {\cf17 const} {\cf18 bool} bPartPNoFilter, {\cf17 const} {\cf18 bool} bPartQNoFilter, {\cf17 const} {\cf18 int} iThrCut, {\cf17 const} {\cf18 bool} bFilterSecondP, {\cf17 const} {\cf18 bool} bFilterSecondQ, {\cf17 const} ClpRng& clpRng, {\cf18 bool} sidePisLarge, {\cf18 bool} sideQisLarge, {\cf18 int} maxFilterLengthP, {\cf18 int} maxFilterLengthQ){\cf17  const}\par
01508 {\cf17 }\{\par
01509   {\cf18 int} delta;\par
01510 \par
01511   {\cf17 const} Pel m4  = piSrc[ 0          ];\par
01512   {\cf17 const} Pel m3  = piSrc[-iOffset    ];\par
01513   {\cf17 const} Pel m5  = piSrc[ iOffset    ];\par
01514   {\cf17 const} Pel m2  = piSrc[-iOffset * 2];\par
01515   {\cf17 const} Pel m6  = piSrc[ iOffset * 2];\par
01516   {\cf17 const} Pel m1  = piSrc[-iOffset * 3];\par
01517   {\cf17 const} Pel m7  = piSrc[ iOffset * 3];\par
01518   {\cf17 const} Pel m0  = piSrc[-iOffset * 4];\par
01519 \par
01520   {\cf17 const} Pel mP1 = piSrc[-iOffset * 5];\par
01521   {\cf17 const} Pel mP2 = piSrc[-iOffset * 6];\par
01522   {\cf17 const} Pel mP3 = piSrc[-iOffset * 7];\par
01523   {\cf17 const} Pel m8  = piSrc[ iOffset * 4];\par
01524   {\cf17 const} Pel m9  = piSrc[ iOffset * 5];\par
01525   {\cf17 const} Pel m10 = piSrc[ iOffset * 6];\par
01526   {\cf17 const} {\cf18 char} tc3[3] = \{ 3, 2, 1\};\par
01527   {\cf19 if} (sw)\par
01528   \{\par
01529     {\cf19 if} (sidePisLarge || sideQisLarge)\par
01530     \{\par
01531       xFilteringPandQ(piSrc, iOffset, sidePisLarge ? maxFilterLengthP : 3, sideQisLarge ? maxFilterLengthQ : 3, tc);\par
01532     \}\par
01533     {\cf19 else}\par
01534     \{\par
01535       piSrc[-iOffset]     = Clip3(m3 - tc3[0] * tc, m3 + tc3[0] * tc, ((m1 + 2 * m2 + 2 * m3 + 2 * m4 + m5 + 4) >> 3));\par
01536       piSrc[0]            = Clip3(m4 - tc3[0] * tc, m4 + tc3[0] * tc, ((m2 + 2 * m3 + 2 * m4 + 2 * m5 + m6 + 4) >> 3));\par
01537       piSrc[-iOffset * 2] = Clip3(m2 - tc3[1] * tc, m2 + tc3[1] * tc, ((m1 + m2 + m3 + m4 + 2) >> 2));\par
01538       piSrc[iOffset]      = Clip3(m5 - tc3[1] * tc, m5 + tc3[1] * tc, ((m3 + m4 + m5 + m6 + 2) >> 2));\par
01539       piSrc[-iOffset * 3] = Clip3(m1 - tc3[2] * tc, m1 + tc3[2] * tc, ((2 * m0 + 3 * m1 + m2 + m3 + m4 + 4) >> 3));\par
01540       piSrc[iOffset * 2]  = Clip3(m6 - tc3[2] * tc, m6 + tc3[2] * tc, ((m3 + m4 + m5 + 3 * m6 + 2 * m7 + 4) >> 3));\par
01541     \}\par
01542   \}\par
01543   {\cf19 else}\par
01544   \{\par
01545     {\cf20 /* Weak filter */}\par
01546     delta = ( 9 * ( m4 - m3 ) - 3 * ( m5 - m2 ) + 8 ) >> 4;\par
01547 \par
01548     {\cf19 if} ( abs(delta) < iThrCut )\par
01549     \{\par
01550       delta = Clip3( -tc, tc, delta );\par
01551       piSrc[-iOffset] = ClipPel( m3 + delta, clpRng);\par
01552       piSrc[0]        = ClipPel( m4 - delta, clpRng);\par
01553 \par
01554       {\cf17 const} {\cf18 int} tc2 = tc >> 1;\par
01555       {\cf19 if}( bFilterSecondP )\par
01556       \{\par
01557         {\cf17 const} {\cf18 int} delta1 = Clip3( -tc2, tc2, ( ( ( ( m1 + m3 + 1 ) >> 1 ) - m2 + delta ) >> 1 ) );\par
01558         piSrc[-iOffset * 2] = ClipPel( m2 + delta1, clpRng);\par
01559       \}\par
01560       {\cf19 if}( bFilterSecondQ )\par
01561       \{\par
01562         {\cf17 const} {\cf18 int} delta2 = Clip3( -tc2, tc2, ( ( ( ( m6 + m4 + 1 ) >> 1 ) - m5 - delta ) >> 1 ) );\par
01563         piSrc[iOffset] = ClipPel( m5 + delta2, clpRng);\par
01564       \}\par
01565     \}\par
01566   \}\par
01567 \par
01568   {\cf19 if}(bPartPNoFilter)\par
01569   \{\par
01570     piSrc[-iOffset    ] = m3;\par
01571     piSrc[-iOffset * 2] = m2;\par
01572     piSrc[-iOffset * 3] = m1;\par
01573     {\cf19 if} (sidePisLarge)\par
01574     \{\par
01575       piSrc[-iOffset * 4] = m0;\par
01576       piSrc[-iOffset * 5] = mP1;\par
01577       piSrc[-iOffset * 6] = mP2;\par
01578       piSrc[-iOffset * 7] = mP3;\par
01579     \}\par
01580   \}\par
01581 \par
01582   {\cf19 if}(bPartQNoFilter)\par
01583   \{\par
01584     piSrc[ 0          ] = m4;\par
01585     piSrc[ iOffset    ] = m5;\par
01586     piSrc[ iOffset * 2] = m6;\par
01587     {\cf19 if} (sideQisLarge)\par
01588     \{\par
01589       piSrc[iOffset * 3] = m7;\par
01590       piSrc[iOffset * 4] = m8;\par
01591       piSrc[iOffset * 5] = m9;\par
01592       piSrc[iOffset * 6] = m10;\par
01593     \}\par
01594   \}\par
01595 \}\par
01596 \par
01607 {\cf17 inline} {\cf18 void} LoopFilter::xPelFilterChroma(Pel* piSrc, {\cf17 const} {\cf18 int} iOffset, {\cf17 const} {\cf18 int} tc, {\cf17 const} {\cf18 bool} sw, {\cf17 const} {\cf18 bool} bPartPNoFilter, {\cf17 const} {\cf18 bool} bPartQNoFilter, {\cf17 const} ClpRng& clpRng, {\cf17 const} {\cf18 bool} largeBoundary, {\cf17 const} {\cf18 bool} isChromaHorCTBBoundary){\cf17  const}\par
01608 {\cf17 }\{\par
01609   {\cf18 int} delta;\par
01610 \par
01611   {\cf17 const} Pel m0 = piSrc[-iOffset * 4];\par
01612   {\cf17 const} Pel m1 = piSrc[-iOffset * 3];\par
01613   {\cf17 const} Pel m2 = piSrc[-iOffset * 2];\par
01614   {\cf17 const} Pel m3 = piSrc[-iOffset];\par
01615   {\cf17 const} Pel m4 = piSrc[0];\par
01616   {\cf17 const} Pel m5 = piSrc[iOffset];\par
01617   {\cf17 const} Pel m6 = piSrc[iOffset * 2];\par
01618   {\cf17 const} Pel m7 = piSrc[iOffset * 3];\par
01619 \par
01620   {\cf19 if} (sw)\par
01621   \{\par
01622     {\cf19 if} (isChromaHorCTBBoundary)\par
01623     \{\par
01624       piSrc[-iOffset * 1] = Clip3(m3 - tc, m3 + tc, ((3 * m2 + 2 * m3 + m4 + m5 + m6 + 4) >> 3)); {\cf20 // p0}\par
01625       piSrc[0] = Clip3(m4 - tc, m4 + tc, ((2 * m2 + m3 + 2 * m4 + m5 + m6 + m7 + 4) >> 3)); {\cf20 // q0}\par
01626       piSrc[iOffset * 1] = Clip3(m5 - tc, m5 + tc, ((m2 + m3 + m4 + 2 * m5 + m6 + 2 * m7 + 4) >> 3));  {\cf20 // q1}\par
01627       piSrc[iOffset * 2] = Clip3(m6 - tc, m6 + tc, ((m3 + m4 + m5 + 2 * m6 + 3 * m7 + 4) >> 3));       {\cf20 // q2}\par
01628     \}\par
01629     {\cf19 else}\par
01630     \{\par
01631       piSrc[-iOffset * 3] = Clip3(m1 - tc, m1 + tc, ((3 * m0 + 2 * m1 + m2 + m3 + m4 + 4) >> 3));       {\cf20 // p2}\par
01632       piSrc[-iOffset * 2] = Clip3(m2 - tc, m2 + tc, ((2 * m0 + m1 + 2 * m2 + m3 + m4 + m5 + 4) >> 3));  {\cf20 // p1}\par
01633       piSrc[-iOffset * 1] = Clip3(m3 - tc, m3 + tc, ((m0 + m1 + m2 + 2 * m3 + m4 + m5 + m6 + 4) >> 3)); {\cf20 // p0}\par
01634       piSrc[0] = Clip3(m4 - tc, m4 + tc, ((m1 + m2 + m3 + 2 * m4 + m5 + m6 + m7 + 4) >> 3)); {\cf20 // q0}\par
01635       piSrc[iOffset * 1] = Clip3(m5 - tc, m5 + tc, ((m2 + m3 + m4 + 2 * m5 + m6 + 2 * m7 + 4) >> 3));  {\cf20 // q1}\par
01636       piSrc[iOffset * 2] = Clip3(m6 - tc, m6 + tc, ((m3 + m4 + m5 + 2 * m6 + 3 * m7 + 4) >> 3));       {\cf20 // q2}\par
01637     \}\par
01638   \}\par
01639   {\cf19 else}\par
01640   \{\par
01641     delta           = Clip3(-tc, tc, ((((m4 - m3) << 2) + m2 - m5 + 4) >> 3));\par
01642     piSrc[-iOffset] = ClipPel(m3 + delta, clpRng);\par
01643     piSrc[0]        = ClipPel(m4 - delta, clpRng);\par
01644   \}\par
01645 \par
01646 \par
01647   {\cf19 if}( bPartPNoFilter )\par
01648   \{\par
01649     {\cf19 if} (largeBoundary)\par
01650     \{\par
01651       piSrc[-iOffset * 3] = m1; {\cf20 // p2}\par
01652       piSrc[-iOffset * 2] = m2; {\cf20 // p1}\par
01653     \}\par
01654     piSrc[-iOffset] = m3;\par
01655   \}\par
01656   {\cf19 if}( bPartQNoFilter )\par
01657   \{\par
01658     {\cf19 if} (largeBoundary)\par
01659     \{\par
01660       piSrc[iOffset * 1] = m5; {\cf20 // q1}\par
01661       piSrc[iOffset * 2] = m6; {\cf20 // q2}\par
01662     \}\par
01663     piSrc[ 0      ] = m4;\par
01664   \}\par
01665 \}\par
01666 \par
01676 {\cf17 inline} {\cf18 bool} LoopFilter::xUseStrongFiltering(Pel* piSrc, {\cf17 const} {\cf18 int} iOffset, {\cf17 const} {\cf18 int} d, {\cf17 const} {\cf18 int} beta, {\cf17 const} {\cf18 int} tc, {\cf18 bool} sidePisLarge, {\cf18 bool} sideQisLarge, {\cf18 int} maxFilterLengthP, {\cf18 int} maxFilterLengthQ, {\cf18 bool} isChromaHorCTBBoundary){\cf17  const}\par
01677 {\cf17 }\{\par
01678   {\cf17 const} Pel m4 = piSrc[ 0          ];\par
01679   {\cf17 const} Pel m3 = piSrc[-iOffset    ];\par
01680   {\cf17 const} Pel m7 = piSrc[ iOffset * 3];\par
01681   {\cf17 const} Pel m0 = piSrc[-iOffset * 4];\par
01682   {\cf17 const} Pel m2 = piSrc[-iOffset * 2];\par
01683   {\cf18 int}       sp3 = abs(m0 - m3);\par
01684   {\cf19 if} (isChromaHorCTBBoundary)\par
01685   \{\par
01686     sp3 = abs(m2 - m3);\par
01687   \}\par
01688   {\cf18 int}       sq3      = abs(m7 - m4);\par
01689   {\cf17 const} {\cf18 int} d_strong = sp3 + sq3;\par
01690 \par
01691   {\cf19 if} (sidePisLarge || sideQisLarge)\par
01692   \{\par
01693     Pel mP4;\par
01694     Pel m11;\par
01695     {\cf19 if} (sidePisLarge)\par
01696     \{\par
01697       {\cf19 if} (maxFilterLengthP == 7)\par
01698       \{\par
01699         {\cf17 const} Pel mP5 = piSrc[-iOffset * 5];\par
01700         {\cf17 const} Pel mP6 = piSrc[-iOffset * 6];\par
01701         {\cf17 const} Pel mP7 = piSrc[-iOffset * 7];;\par
01702         mP4 = piSrc[-iOffset * 8];\par
01703         sp3 = sp3 + abs(mP5 - mP6 - mP7 + mP4);\par
01704       \}\par
01705       {\cf19 else}\par
01706       \{\par
01707         mP4 = piSrc[-iOffset * 6];\par
01708       \}\par
01709       sp3 = (sp3 + abs(m0 - mP4) + 1) >> 1;\par
01710     \}\par
01711     {\cf19 if} (sideQisLarge)\par
01712     \{\par
01713       {\cf19 if} (maxFilterLengthQ == 7)\par
01714       \{\par
01715         {\cf17 const} Pel m8 = piSrc[iOffset * 4];\par
01716         {\cf17 const} Pel m9 = piSrc[iOffset * 5];\par
01717         {\cf17 const} Pel m10 = piSrc[iOffset * 6];;\par
01718         m11 = piSrc[iOffset * 7];\par
01719         sq3 = sq3 + abs(m8 - m9 - m10 + m11);\par
01720       \}\par
01721       {\cf19 else}\par
01722       \{\par
01723         m11 = piSrc[iOffset * 5];\par
01724       \}\par
01725       sq3 = (sq3 + abs(m11 - m7) + 1) >> 1;\par
01726     \}\par
01727     {\cf19 return} ((sp3 + sq3) < (beta * 3 >> 5)) && (d < (beta >> 4)) && (abs(m3 - m4) < ((tc * 5 + 1) >> 1));\par
01728   \}\par
01729   {\cf19 else}\par
01730   \{\par
01731     {\cf19 return} ((d_strong < (beta >> 3)) && (d < (beta >> 2)) && (abs(m3 - m4) < ((tc * 5 + 1) >> 1)));\par
01732   \}\par
01733 \}\par
01734 \par
01735 {\cf17 inline} {\cf18 int} LoopFilter::xCalcDP(Pel* piSrc, {\cf17 const} {\cf18 int} iOffset, {\cf17 const} {\cf18 bool} isChromaHorCTBBoundary){\cf17  const}\par
01736 {\cf17 }\{\par
01737   {\cf19 if} (isChromaHorCTBBoundary)\par
01738   \{\par
01739     {\cf19 return} abs(piSrc[-iOffset * 2] - 2 * piSrc[-iOffset * 2] + piSrc[-iOffset]);\par
01740   \}\par
01741   {\cf19 else}\par
01742   \{\par
01743     {\cf19 return} abs(piSrc[-iOffset * 3] - 2 * piSrc[-iOffset * 2] + piSrc[-iOffset]);\par
01744   \}\par
01745 \}\par
01746 \par
01747 {\cf17 inline} {\cf18 int} LoopFilter::xCalcDQ( Pel* piSrc, {\cf17 const} {\cf18 int} iOffset ){\cf17  const}\par
01748 {\cf17 }\{\par
01749   {\cf19 return} abs( piSrc[0] - 2 * piSrc[iOffset] + piSrc[iOffset * 2] );\par
01750 \}\par
