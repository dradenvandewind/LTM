00492 {\cf18 void} LoopFilter::xSetMaxFilterLengthPQFromTransformSizes({\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} CodingUnit &cu,\par
00493                                                          {\cf17 const} TransformUnit &currTU, {\cf17 const} {\cf18 int} firstComponent)\par
00494 \{\par
00495   {\cf17 const} TransformUnit& tuQ = currTU;\par
00496 \par
00497   {\cf19 if} ( edgeDir == EDGE_HOR )\par
00498   \{\par
00499     {\cf19 for} ({\cf18 int} cIdx = firstComponent; cIdx < ::getNumberValidComponents(tuQ.chromaFormat); cIdx++)   {\cf20 // per component}\par
00500     \{\par
00501       {\cf17 const} ComponentID comp = ComponentID(cIdx);\par
00502       {\cf17 const} ChannelType ch   = toChannelType(comp);\par
00503       {\cf17 const} {\cf18 int} shiftHor     = ( ( ch == CH_L ) ? 0 : m_shiftHor );\par
00504       {\cf17 const} {\cf18 int} shiftVer     = ( ( ch == CH_L ) ? 0 : m_shiftVer );\par
00505       {\cf17 const} {\cf18 int} ctuXOff      = currTU.block(comp).x - ( m_ctuXLumaSamples >> shiftHor ); {\cf20 // x offset from left edge of CTU in respective channel sample units}\par
00506       {\cf17 const} {\cf18 int} ctuYOff      = currTU.block(comp).y - ( m_ctuYLumaSamples >> shiftVer ); {\cf20 // y offset from top edge of CTU in respective channel sample units}\par
00507       {\cf17 const} {\cf18 int} minCUWidth   = cu.cs->pcv->minCUWidth >> shiftHor;\par
00508       {\cf19 if} ( currTU.block(comp).valid() && ( ( currTU.block(comp).y == cu.block(comp).y ) ? m_stLFCUParam.topEdge : m_stLFCUParam.internalEdge ) ) {\cf20 // Edge deblocking needs to be recomputed since ISP contains whole CU chroma transforms in last TU of the CU}\par
00509       \{\par
00510         {\cf19 for} ( {\cf18 int} x = 0; x < currTU.blocks[cIdx].width; x += minCUWidth )\par
00511         \{\par
00512           {\cf17 const} Position  posQ     = Position( currTU.blocks[ch].x + x, currTU.blocks[ch].y );\par
00513           {\cf17 const} Position  posP     = posQ.offset( 0, -1 );\par
00514           {\cf17 const} {\cf18 int} sizeQSide      = tuQ.block(comp).height;\par
00515           {\cf17 const} TransformUnit& tuP = *cu.cs->getTU( posP, ch );\par
00516           {\cf17 const} {\cf18 int} sizePSide      = tuP.block(comp).height;\par
00517           m_transformEdge[cIdx][ctuXOff+x][ctuYOff] = {\cf17 true};\par
00518 \par
00519           {\cf19 if} ( comp == COMPONENT_Y )\par
00520           \{\par
00521             {\cf18 bool} smallBlock = (sizePSide <= 4) || (sizeQSide <= 4);\par
00522             {\cf19 if} (smallBlock)\par
00523             \{\par
00524               m_maxFilterLengthQ[cIdx][ctuXOff + x][ctuYOff] = 1;\par
00525               m_maxFilterLengthP[cIdx][ctuXOff + x][ctuYOff] = 1;\par
00526             \}\par
00527             {\cf19 else}\par
00528             \{\par
00529               m_maxFilterLengthQ[cIdx][ctuXOff + x][ctuYOff] = (sizeQSide >= 32) ? 7 : 3;\par
00530               m_maxFilterLengthP[cIdx][ctuXOff + x][ctuYOff] = (sizePSide >= 32) ? 7 : 3;\par
00531             \}\par
00532           \}\par
00533           {\cf19 else}\par
00534           \{\par
00535             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff] = ( sizeQSide >= 8 && sizePSide >= 8 ) ? 3 : 1;\par
00536             m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff] = ( sizeQSide >= 8 && sizePSide >= 8 ) ? 3 : 1;\par
00537           \}\par
00538         \}\par
00539       \}\par
00540     \}\par
00541   \}\par
00542   {\cf19 if} ( edgeDir == EDGE_VER )\par
00543   \{\par
00544     {\cf19 for} ( {\cf18 int} cIdx = firstComponent; cIdx < ::getNumberValidComponents(tuQ.chromaFormat); cIdx++ ) {\cf20 // per component}\par
00545     \{\par
00546       {\cf17 const} ComponentID comp = ComponentID(cIdx);\par
00547       {\cf17 const} ChannelType ch   = toChannelType(comp);\par
00548       {\cf17 const} {\cf18 int} shiftHor     = ( ( ch == CH_L ) ? 0 : m_shiftHor );\par
00549       {\cf17 const} {\cf18 int} shiftVer     = ( ( ch == CH_L ) ? 0 : m_shiftVer );\par
00550       {\cf17 const} {\cf18 int} ctuXOff      = currTU.block(comp).x - ( m_ctuXLumaSamples >> shiftHor ); {\cf20 // x offset from left edge of CTU in respective channel sample units}\par
00551       {\cf17 const} {\cf18 int} ctuYOff      = currTU.block(comp).y - ( m_ctuYLumaSamples >> shiftVer ); {\cf20 // y offset from top edge of CTU in respective channel sample units}\par
00552       {\cf17 const} {\cf18 int} minCUHeight  = cu.cs->pcv->minCUHeight >> shiftVer;\par
00553       {\cf19 if} ( currTU.block(comp).valid() && ( ( currTU.block(comp).x == cu.block(comp).x ) ? m_stLFCUParam.leftEdge : m_stLFCUParam.internalEdge ) ) {\cf20 // Edge deblocking needs to be recomputed since ISP contains whole CU chroma transforms in last TU of the CU}\par
00554       \{\par
00555         {\cf19 for} ( {\cf18 int} y = 0; y < currTU.blocks[cIdx].height; y += minCUHeight )\par
00556         \{\par
00557           {\cf17 const} Position  posQ     = Position( currTU.blocks[ch].x, currTU.blocks[ch].y + y );\par
00558           {\cf17 const} Position  posP     = posQ.offset( -1, 0 );\par
00559           {\cf17 const} {\cf18 int} sizeQSide      = tuQ.block(comp).width;\par
00560           {\cf17 const} TransformUnit& tuP = *cu.cs->getTU( posP, ch );\par
00561           {\cf17 const} {\cf18 int} sizePSide      = tuP.block(comp).width;\par
00562           m_transformEdge[cIdx][ctuXOff][ctuYOff+y] = {\cf17 true};\par
00563 \par
00564           {\cf19 if} ( comp == COMPONENT_Y )\par
00565           \{\par
00566             {\cf18 bool} smallBlock = (sizePSide <= 4) || (sizeQSide <= 4);\par
00567             {\cf19 if} (smallBlock)\par
00568             \{\par
00569               m_maxFilterLengthQ[cIdx][ctuXOff][ctuYOff + y] = 1;\par
00570               m_maxFilterLengthP[cIdx][ctuXOff][ctuYOff + y] = 1;\par
00571             \}\par
00572             {\cf19 else}\par
00573             \{\par
00574               m_maxFilterLengthQ[cIdx][ctuXOff][ctuYOff + y] = (sizeQSide >= 32) ? 7 : 3;\par
00575               m_maxFilterLengthP[cIdx][ctuXOff][ctuYOff + y] = (sizePSide >= 32) ? 7 : 3;\par
00576             \}\par
00577           \}\par
00578           {\cf19 else}\par
00579           \{\par
00580             m_maxFilterLengthQ[cIdx][ctuXOff][ctuYOff+y] = ( sizeQSide >= 8 && sizePSide >= 8 ) ? 3 : 1;\par
00581             m_maxFilterLengthP[cIdx][ctuXOff][ctuYOff+y] = ( sizeQSide >= 8 && sizePSide >= 8 ) ? 3 : 1;\par
00582           \}\par
00583         \}\par
00584       \}\par
00585     \}\par
00586   \}\par
00587 \}\par
