00266 {\cf18 void} LoopFilter::xDeblockCU( CodingUnit& cu, {\cf17 const} DeblockEdgeDir edgeDir )\par
00267 \{\par
00268   {\cf17 const} PreCalcValues& pcv = *cu.cs->pcv;\par
00269   {\cf17 const} Area area          = cu.Y().valid() ? cu.Y() : Area( recalcPosition( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, cu.blocks[cu.chType].pos() ), recalcSize( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, cu.blocks[cu.chType].size() ) );\par
00270 \par
00271   {\cf18 bool} horEdgeFilter = {\cf17 false}, verEdgeFilter = {\cf17 false};\par
00272   {\cf18 int}  numHorVirBndry = 0, numVerVirBndry = 0;\par
00273   {\cf18 int}  horVirBndryPos[] = \{ 0, 0, 0 \};\par
00274   {\cf18 int}  verVirBndryPos[] = \{ 0, 0, 0 \};\par
00275 \par
00276   {\cf18 bool} isCuCrossedByVirtualBoundaries = isCrossedByVirtualBoundaries( area.x, area.y, area.width, area.height, numHorVirBndry, numVerVirBndry, horVirBndryPos, verVirBndryPos, cu.cs->picHeader );\par
00277 \par
00278   xSetLoopfilterParam( cu );\par
00279   static_vector<int, 2*MAX_CU_SIZE> edgeIdx;\par
00280   edgeIdx.clear();\par
00281 \par
00282   {\cf19 if} (m_enc)\par
00283   \{\par
00284     m_shiftHor = ::getComponentScaleX(COMPONENT_Cb, cu.chromaFormat);\par
00285     m_shiftVer = ::getComponentScaleY(COMPONENT_Cb, cu.chromaFormat);\par
00286     {\cf18 int} x, y;\par
00287     {\cf19 if} (cu.Y().valid())\par
00288     \{\par
00289       x = cu.block(COMPONENT_Y).x;\par
00290       y = cu.block(COMPONENT_Y).y;\par
00291     \}\par
00292     {\cf19 else}\par
00293     \{\par
00294       x = cu.block(COMPONENT_Cb).x << m_shiftHor;\par
00295       y = cu.block(COMPONENT_Cb).y << m_shiftVer;\par
00296     \}\par
00297     m_ctuXLumaSamples = x & ~(cu.slice->getSPS()->getMaxCUWidth()  - 1);\par
00298     m_ctuYLumaSamples = y & ~(cu.slice->getSPS()->getMaxCUHeight() - 1);\par
00299   \}\par
00300 \par
00301   {\cf19 for}( {\cf17 auto} &currTU : CU::traverseTUs( cu ) )\par
00302   \{\par
00303     {\cf17 const} Area& areaTu = cu.Y().valid() ? currTU.block( COMPONENT_Y ) : Area( recalcPosition( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, currTU.blocks[cu.chType].pos() ), recalcSize( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, currTU.blocks[cu.chType].size() ) );\par
00304 \par
00305     verEdgeFilter = m_stLFCUParam.internalEdge;\par
00306     horEdgeFilter = m_stLFCUParam.internalEdge;\par
00307 \par
00308     {\cf19 if} ((edgeDir == EDGE_HOR && areaTu.y % 4 != 0) || (edgeDir == EDGE_VER && areaTu.x % 4 != 0))\par
00309     \{\par
00310       {\cf19 if} (cu.chromaFormat != CHROMA_400 && currTU.block(COMPONENT_Cb).valid())\par
00311       \{\par
00312         {\cf19 if} ((edgeDir == EDGE_HOR && currTU.block(COMPONENT_Cb).y % 4 == 0)\par
00313             || (edgeDir == EDGE_VER && currTU.block(COMPONENT_Cb).x % 4 == 0))\par
00314         \{\par
00315           {\cf20 // Set max filter length for chroma in narrow/short CUs that use ISP mode}\par
00316           xSetMaxFilterLengthPQFromTransformSizes(edgeDir, cu, currTU, COMPONENT_Cb);\par
00317         \}\par
00318       \}\par
00319       {\cf19 continue};\par
00320     \}\par
00321 \par
00322     {\cf19 if}( isCuCrossedByVirtualBoundaries )\par
00323     \{\par
00324       xDeriveEdgefilterParam( areaTu.x, areaTu.y, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos, verEdgeFilter, horEdgeFilter );\par
00325     \}\par
00326     xSetEdgefilterMultiple( cu, EDGE_VER, areaTu, verEdgeFilter );\par
00327     xSetEdgefilterMultiple( cu, EDGE_HOR, areaTu, horEdgeFilter );\par
00328     xSetMaxFilterLengthPQFromTransformSizes(edgeDir, cu, currTU, COMPONENT_Y);\par
00329     {\cf19 if}( cu.Y().valid() )\par
00330     \{\par
00331       edgeIdx.push_back( ( edgeDir == EDGE_HOR ) ? ( currTU.blocks[cu.chType].y - cu.blocks[cu.chType].y ) / 4 : ( currTU.blocks[cu.chType].x - cu.blocks[cu.chType].x ) / 4 );\par
00332     \}\par
00333     {\cf19 else}\par
00334     \{\par
00335       edgeIdx.push_back( ( edgeDir == EDGE_HOR ) ? (( currTU.blocks[cu.chType].y - cu.blocks[cu.chType].y ) << ::getComponentScaleY(COMPONENT_Cb, cu.chromaFormat))  / 4 : (( currTU.blocks[cu.chType].x - cu.blocks[cu.chType].x ) << ::getComponentScaleX(COMPONENT_Cb, cu.chromaFormat)) / 4 );\par
00336     \}\par
00337   \}\par
00338 \par
00339   {\cf18 bool} mvSubBlocks = {\cf17 false};\par
00340   {\cf18 int} subBlockSize = 8;\par
00341   {\cf19 for}( {\cf17 auto} &currPU : CU::traversePUs( cu ) )\par
00342   \{\par
00343     {\cf17 const} Area& areaPu = cu.Y().valid() ? currPU.block( COMPONENT_Y ) : area;\par
00344     {\cf17 const} {\cf18 bool} xOff    = currPU.blocks[cu.chType].x != cu.blocks[cu.chType].x;\par
00345     {\cf17 const} {\cf18 bool} yOff    = currPU.blocks[cu.chType].y != cu.blocks[cu.chType].y;\par
00346 \par
00347     verEdgeFilter = (xOff ? m_stLFCUParam.internalEdge : m_stLFCUParam.leftEdge);\par
00348     horEdgeFilter = (yOff ? m_stLFCUParam.internalEdge : m_stLFCUParam.topEdge);\par
00349     {\cf19 if}( isCuCrossedByVirtualBoundaries )\par
00350     \{\par
00351       xDeriveEdgefilterParam( areaPu.x, areaPu.y, numVerVirBndry, numHorVirBndry, verVirBndryPos, horVirBndryPos, verEdgeFilter, horEdgeFilter );\par
00352     \}\par
00353 \par
00354     xSetEdgefilterMultiple( cu, EDGE_VER, areaPu, verEdgeFilter, xOff );\par
00355     xSetEdgefilterMultiple( cu, EDGE_HOR, areaPu, horEdgeFilter, yOff );\par
00356     edgeIdx.push_back( ( edgeDir == EDGE_HOR ) ? ( currPU.blocks[cu.chType].y - cu.blocks[cu.chType].y ) / 4 : ( currPU.blocks[cu.chType].x - cu.blocks[cu.chType].x ) / 4 );\par
00357 \par
00358     {\cf19 if} ((currPU.mergeFlag && (currPU.mergeType == MRG_TYPE_SUBPU_ATMVP)) || cu.affine)\par
00359     \{\par
00360       mvSubBlocks = {\cf17 true};\par
00361       {\cf19 if} (edgeDir == EDGE_HOR)\par
00362       \{\par
00363         {\cf19 for} (uint32_t off = subBlockSize; off < areaPu.height; off += subBlockSize)\par
00364         \{\par
00365           {\cf17 const} Area mvBlockH(cu.Y().x, cu.Y().y + off, cu.Y().width, pcv.minCUHeight);\par
00366           horEdgeFilter = m_stLFCUParam.internalEdge;\par
00367           {\cf19 if}( isCuCrossedByVirtualBoundaries )\par
00368           \{\par
00369             xDeriveEdgefilterParam( mvBlockH.x, mvBlockH.y, 0, numHorVirBndry, verVirBndryPos, horVirBndryPos, verEdgeFilter, horEdgeFilter );\par
00370           \}\par
00371 \par
00372           xSetEdgefilterMultiple(cu, EDGE_HOR, mvBlockH, horEdgeFilter, 1);\par
00373           edgeIdx.push_back( ( currPU.blocks[cu.chType].y + off - cu.blocks[cu.chType].y ) / 4 );\par
00374         \}\par
00375       \}\par
00376       {\cf19 else}\par
00377       \{\par
00378         {\cf19 for} (uint32_t off = subBlockSize; off < areaPu.width; off += subBlockSize)\par
00379         \{\par
00380           {\cf17 const} Area mvBlockV(cu.Y().x + off, cu.Y().y, pcv.minCUWidth, cu.Y().height);\par
00381           verEdgeFilter = m_stLFCUParam.internalEdge;\par
00382           {\cf19 if}( isCuCrossedByVirtualBoundaries )\par
00383           \{\par
00384             xDeriveEdgefilterParam( mvBlockV.x, mvBlockV.y, numVerVirBndry, 0, verVirBndryPos, horVirBndryPos, verEdgeFilter, horEdgeFilter );\par
00385           \}\par
00386 \par
00387           xSetEdgefilterMultiple(cu, EDGE_VER, mvBlockV, verEdgeFilter, 1);\par
00388           edgeIdx.push_back( ( currPU.blocks[cu.chType].x + off - cu.blocks[cu.chType].x ) / 4 );\par
00389         \}\par
00390       \}\par
00391     \}\par
00392 \par
00393     xSetMaxFilterLengthPQForCodingSubBlocks( edgeDir, cu, currPU, mvSubBlocks, subBlockSize, areaPu );\par
00394   \}\par
00395 \par
00396   {\cf17 const} {\cf18 unsigned} uiPelsInPart = pcv.minCUWidth;\par
00397 \par
00398   {\cf19 for}( {\cf18 int} y = 0; y < area.height; y += uiPelsInPart )\par
00399   \{\par
00400     {\cf19 for}( {\cf18 int} x = 0; x < area.width; x += uiPelsInPart )\par
00401     \{\par
00402       {\cf18 unsigned} uiBSCheck = 1;\par
00403       {\cf17 const} Position localPos  \{ area.x + x, area.y + y \};\par
00404       {\cf17 const} {\cf18 unsigned} rasterIdx = getRasterIdx( localPos, pcv );\par
00405 \par
00406       {\cf19 if}( m_aapbEdgeFilter[edgeDir][rasterIdx] && uiBSCheck )\par
00407       \{\par
00408         {\cf18 char} bS = 0;\par
00409         {\cf19 if}(cu.treeType != TREE_C)\par
00410         \{\par
00411           bS |= xGetBoundaryStrengthSingle( cu, edgeDir, localPos, CHANNEL_TYPE_LUMA );\par
00412         \}\par
00413         {\cf19 if}(cu.treeType != TREE_L && cu.chromaFormat != CHROMA_400 && cu.blocks[COMPONENT_Cb].valid())\par
00414         \{\par
00415           bS |= xGetBoundaryStrengthSingle( cu, edgeDir, localPos, CHANNEL_TYPE_CHROMA );\par
00416         \}\par
00417         m_aapucBS[edgeDir][rasterIdx] = bS;\par
00418       \}\par
00419     \}\par
00420   \}\par
00421 \par
00422 \par
00423   std::sort( edgeIdx.begin(), edgeIdx.end() );\par
00424   {\cf18 int} prevEdgeIdx = -1;\par
00425   {\cf19 for} ( {\cf17 const} {\cf18 int}& edge : edgeIdx )\par
00426   \{\par
00427     {\cf19 if} ( edge == prevEdgeIdx ) {\cf20 // skip duplicate edgeIdx marked by both transform and coding subblock processes}\par
00428     \{\par
00429       {\cf19 continue};\par
00430     \}\par
00431     prevEdgeIdx = edge;\par
00432 \par
00433     {\cf19 if} ( cu.blocks[COMPONENT_Y].valid() )\par
00434     \{\par
00435       xEdgeFilterLuma( cu, edgeDir, edge );\par
00436     \}\par
00437 \par
00438     {\cf19 if} ( pcv.chrFormat != CHROMA_400 && cu.blocks[COMPONENT_Cb].valid() )\par
00439     \{\par
00440       {\cf19 if} ( !cu.ispMode || edge == 0 )\par
00441       \{\par
00442         xEdgeFilterChroma( cu, edgeDir, edge );\par
00443       \}\par
00444     \}\par
00445   \}\par
00446 \}\par
