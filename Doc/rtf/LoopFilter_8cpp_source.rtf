00471 {\cf17 inline} {\cf18 void} LoopFilter::xDeriveEdgefilterParam( {\cf17 const} {\cf18 int} xPos, {\cf17 const} {\cf18 int} yPos, {\cf17 const} {\cf18 int} numVerVirBndry, {\cf17 const} {\cf18 int} numHorVirBndry, {\cf17 const} {\cf18 int} verVirBndryPos[], {\cf17 const} {\cf18 int} horVirBndryPos[], {\cf18 bool} &verEdgeFilter, {\cf18 bool} &horEdgeFilter )\par
00472 \{\par
00473   {\cf19 for} ({\cf18 int} i = 0; i < numVerVirBndry; i++)\par
00474   \{\par
00475     {\cf19 if} (verVirBndryPos[i] == xPos)\par
00476     \{\par
00477       verEdgeFilter = {\cf17 false};\par
00478       {\cf19 break};\par
00479     \}\par
00480   \}\par
00481 \par
00482   {\cf19 for} ({\cf18 int} i = 0; i < numHorVirBndry; i++)\par
00483   \{\par
00484     {\cf19 if} (horVirBndryPos[i] == yPos)\par
00485     \{\par
00486       horEdgeFilter = {\cf17 false};\par
00487       {\cf19 break};\par
00488     \}\par
00489   \}\par
00490 \}\par
