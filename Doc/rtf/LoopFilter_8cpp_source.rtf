00589 {\cf18 void} LoopFilter::xSetMaxFilterLengthPQForCodingSubBlocks( {\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} CodingUnit& cu, {\cf17 const} PredictionUnit& currPU, {\cf17 const} {\cf18 bool}& mvSubBlocks, {\cf17 const} {\cf18 int}& subBlockSize, {\cf17 const} Area& areaPu )\par
00590 \{\par
00591   {\cf19 if} ( mvSubBlocks && currPU.Y().valid() )\par
00592   \{\par
00593     {\cf17 const} {\cf18 int} cIdx         = 0;\par
00594     {\cf17 const} ComponentID comp = ComponentID(cIdx);\par
00595     {\cf17 const} {\cf18 int} ctuYOff      = currPU.block(comp).y - m_ctuYLumaSamples; {\cf20 // y offset from top edge of CTU in luma samples}\par
00596     {\cf17 const} {\cf18 int} ctuXOff      = currPU.block(comp).x - m_ctuXLumaSamples; {\cf20 // x offset from left edge of CTU in luma samples}\par
00597     {\cf17 const} {\cf18 int} minCUWidth   = cu.cs->pcv->minCUWidth;\par
00598     {\cf17 const} {\cf18 int} minCUHeight  = cu.cs->pcv->minCUHeight;\par
00599     {\cf19 if} ( edgeDir == EDGE_HOR )\par
00600     \{\par
00601       {\cf19 for} ( {\cf18 int} y = 0; y < areaPu.height; y += subBlockSize )\par
00602       \{\par
00603         {\cf19 for} ( {\cf18 int} x = 0; x < areaPu.width; x += minCUWidth )\par
00604         \{\par
00605           {\cf19 if} ( m_transformEdge[cIdx][ctuXOff+x][ctuYOff+y] )\par
00606           \{\par
00607             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = std::min<int>(m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y], 5);\par
00608             {\cf19 if} ( y > 0 )\par
00609             \{\par
00610               m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = std::min<int>(m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y], 5);\par
00611             \}\par
00612           \}\par
00613           {\cf19 else} {\cf19 if} (y > 0 && (m_transformEdge[cIdx][ctuXOff + x][ctuYOff + y - 4] || ((y + 4) >= areaPu.height) || m_transformEdge[cIdx][ctuXOff + x][ctuYOff + y + 4])) {\cf20 // adjacent to transform edge  +/- 4}\par
00614           \{\par
00615             m_maxFilterLengthQ[cIdx][ctuXOff + x][ctuYOff + y] = 1;\par
00616             m_maxFilterLengthP[cIdx][ctuXOff + x][ctuYOff + y] = 1;\par
00617           \}\par
00618           {\cf19 else} {\cf19 if} (y > 0 && ( ( y == 8 ) || m_transformEdge[cIdx][ctuXOff+x][ctuYOff+y-8] || (( y + 8 ) >= areaPu.height) || m_transformEdge[cIdx][ctuXOff+x][ctuYOff+y+8] )) {\cf20 // adjacent to transform edge on 8x8 grid}\par
00619           \{\par
00620             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = 2;\par
00621             m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = 2;\par
00622           \}\par
00623           {\cf19 else}\par
00624           \{\par
00625             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = 3;\par
00626             m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = 3;\par
00627           \}\par
00628         \}\par
00629       \}\par
00630     \}\par
00631     {\cf19 else} {\cf20 // edgeDir == EDGE_VER}\par
00632     \{\par
00633       {\cf19 for} ( {\cf18 int} x = 0; x < areaPu.width; x += subBlockSize )\par
00634       \{\par
00635         {\cf19 for} ( {\cf18 int} y = 0; y < areaPu.height; y += minCUHeight )\par
00636         \{\par
00637           {\cf19 if} ( m_transformEdge[cIdx][ctuXOff+x][ctuYOff+y] )\par
00638           \{\par
00639             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = std::min<int>(m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y], 5);\par
00640             {\cf19 if} ( x > 0 )\par
00641             \{\par
00642               m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = std::min<int>(m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y], 5);\par
00643             \}\par
00644           \}\par
00645           {\cf19 else} {\cf19 if} (x > 0 && (m_transformEdge[cIdx][ctuXOff + x - 4][ctuYOff + y] || ((x + 4) >= areaPu.width) || m_transformEdge[cIdx][ctuXOff + x + 4][ctuYOff + y])) {\cf20 // adjacent to transform edge +/- 4}\par
00646           \{\par
00647             m_maxFilterLengthQ[cIdx][ctuXOff + x][ctuYOff + y] = 1;\par
00648             m_maxFilterLengthP[cIdx][ctuXOff + x][ctuYOff + y] = 1;\par
00649           \}\par
00650           {\cf19 else} {\cf19 if} ( x > 0 && ( ( x == 8 ) || m_transformEdge[cIdx][ctuXOff+x-8][ctuYOff+y] || ( (x + 8) >= areaPu.width ) || m_transformEdge[cIdx][ctuXOff+x+8][ctuYOff+y] ) ) {\cf20 // adjacent to transform edge on 8x8 grid}\par
00651           \{\par
00652             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = 2;\par
00653             m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = 2;\par
00654           \}\par
00655           {\cf19 else}\par
00656           \{\par
00657             m_maxFilterLengthQ[cIdx][ctuXOff+x][ctuYOff+y] = 3;\par
00658             m_maxFilterLengthP[cIdx][ctuXOff+x][ctuYOff+y] = 3;\par
00659           \}\par
00660         \}\par
00661       \}\par
00662     \}\par
00663   \}\par
00664 \}\par
