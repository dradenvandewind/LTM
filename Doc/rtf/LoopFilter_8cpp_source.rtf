00448 {\cf17 inline} {\cf18 bool} LoopFilter::isCrossedByVirtualBoundaries({\cf17 const} {\cf18 int} xPos, {\cf17 const} {\cf18 int} yPos, {\cf17 const} {\cf18 int} width, {\cf17 const} {\cf18 int} height, {\cf18 int}& numHorVirBndry, {\cf18 int}& numVerVirBndry, {\cf18 int} horVirBndryPos[], {\cf18 int} verVirBndryPos[], {\cf17 const} PicHeader* picHeader )\par
00449 \{\par
00450   numHorVirBndry = 0; numVerVirBndry = 0;\par
00451   {\cf19 if}( picHeader->getVirtualBoundariesPresentFlag() )\par
00452   \{\par
00453     {\cf19 for} ({\cf18 int} i = 0; i < picHeader->getNumHorVirtualBoundaries(); i++)\par
00454     \{\par
00455       {\cf19 if} (yPos <= picHeader->getVirtualBoundariesPosY(i) && picHeader->getVirtualBoundariesPosY(i) < yPos + height)\par
00456       \{\par
00457         horVirBndryPos[numHorVirBndry++] = picHeader->getVirtualBoundariesPosY(i);\par
00458       \}\par
00459     \}\par
00460     {\cf19 for} ({\cf18 int} i = 0; i < picHeader->getNumVerVirtualBoundaries(); i++)\par
00461     \{\par
00462       {\cf19 if} (xPos <= picHeader->getVirtualBoundariesPosX(i) && picHeader->getVirtualBoundariesPosX(i) < xPos + width)\par
00463       \{\par
00464         verVirBndryPos[numVerVirBndry++] = picHeader->getVirtualBoundariesPosX(i);\par
00465       \}\par
00466     \}\par
00467   \}\par
00468   {\cf19 return} numHorVirBndry > 0 || numVerVirBndry > 0;\par
00469 \}\par
