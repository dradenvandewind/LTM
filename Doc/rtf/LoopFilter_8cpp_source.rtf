01752 {\cf17 inline} {\cf18 unsigned} LoopFilter::BsSet({\cf18 unsigned} val, {\cf17 const} ComponentID compIdx){\cf17  const }\{ {\cf19 return} (val << (compIdx << 1)); \}\par
01753 {\cf17 inline} {\cf18 unsigned} LoopFilter::BsGet({\cf18 unsigned} val, {\cf17 const} ComponentID compIdx){\cf17  const }\{ {\cf19 return} ((val >> (compIdx << 1)) & 3); \}\par
