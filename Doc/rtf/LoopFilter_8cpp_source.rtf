00717 {\cf18 unsigned} LoopFilter::xGetBoundaryStrengthSingle ( {\cf17 const} CodingUnit& cu, {\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} Position& localPos, {\cf17 const} ChannelType chType ){\cf17  const}\par
00718 {\cf17 }\{\par
00719   {\cf20 // The boundary strength that is output by the function xGetBoundaryStrengthSingle is a multi component boundary strength that contains boundary strength for luma (bits 0 to 1), cb (bits 2 to 3) and cr (bits 4 to 5).}\par
00720 \par
00721   {\cf17 const} Slice& sliceQ = *cu.slice;\par
00722 \par
00723   {\cf18 int} shiftHor = cu.Y().valid() ? 0 : ::getComponentScaleX(COMPONENT_Cb, cu.firstPU->chromaFormat);\par
00724   {\cf18 int} shiftVer = cu.Y().valid() ? 0 : ::getComponentScaleY(COMPONENT_Cb, cu.firstPU->chromaFormat);\par
00725   {\cf17 const} Position& posQ = Position\{ localPos.x >> shiftHor,  localPos.y >> shiftVer \};\par
00726   {\cf17 const} Position  posP  = ( edgeDir == EDGE_VER ) ? posQ.offset( -1, 0 ) : posQ.offset( 0, -1 );\par
00727 \par
00728   {\cf17 const} CodingUnit& cuQ = cu;\par
00729   {\cf17 const} CodingUnit& cuP = (chType == CHANNEL_TYPE_CHROMA && cuQ.chType == CHANNEL_TYPE_LUMA) ?\par
00730                           *cu.cs->getCU(recalcPosition( cu.chromaFormat, CHANNEL_TYPE_LUMA, CHANNEL_TYPE_CHROMA, posP), CHANNEL_TYPE_CHROMA) :\par
00731                           *cu.cs->getCU( posP, cu.chType );\par
00732 \par
00733   {\cf20 //-- Set BS for Intra MB : BS = 4 or 3}\par
00734   {\cf19 if}( ( MODE_INTRA == cuP.predMode ) || ( MODE_INTRA == cuQ.predMode ) )\par
00735   \{\par
00736     {\cf19 if}( chType == CHANNEL_TYPE_LUMA )\par
00737     \{\par
00738       {\cf18 int} bsY = (MODE_INTRA == cuP.predMode && cuP.bdpcmMode) && (MODE_INTRA == cuQ.predMode && cuQ.bdpcmMode) ? 0 : 2;\par
00739       {\cf19 return} BsSet(bsY, COMPONENT_Y);\par
00740     \}\par
00741     {\cf19 else}\par
00742     \{\par
00743       {\cf18 int} bsC = (MODE_INTRA == cuP.predMode && cuP.bdpcmModeChroma) && (MODE_INTRA == cuQ.predMode && cuQ.bdpcmModeChroma) ? 0 : 2;\par
00744       {\cf19 return} (BsSet(bsC, COMPONENT_Cb) + BsSet(bsC, COMPONENT_Cr));\par
00745     \}\par
00746   \}\par
00747 \par
00748   {\cf17 const} TransformUnit& tuQ = *cuQ.cs->getTU(posQ, cuQ.chType);\par
00749   {\cf17 const} TransformUnit& tuP = (cuP.chType == CHANNEL_TYPE_CHROMA && cuQ.chType == CHANNEL_TYPE_LUMA) ?\par
00750                              *cuP.cs->getTU(recalcPosition( cu.chromaFormat, CHANNEL_TYPE_LUMA, CHANNEL_TYPE_CHROMA, posP), CHANNEL_TYPE_CHROMA) :\par
00751                              *cuP.cs->getTU(posP, cuQ.chType);\par
00752 \par
00753   {\cf17 const} PreCalcValues& pcv = *cu.cs->pcv;\par
00754   {\cf17 const} {\cf18 unsigned} rasterIdx = getRasterIdx( Position\{ localPos.x,  localPos.y \}, pcv );\par
00755   {\cf19 if} (m_aapucBS[edgeDir][rasterIdx] && (cuP.firstPU->ciipFlag || cuQ.firstPU->ciipFlag))\par
00756   \{\par
00757     {\cf19 if}(chType == CHANNEL_TYPE_LUMA)\par
00758     \{\par
00759       {\cf19 return} BsSet(2, COMPONENT_Y);\par
00760     \}\par
00761     {\cf19 else}\par
00762     \{\par
00763       {\cf19 return} BsSet(2, COMPONENT_Cb) + BsSet(2, COMPONENT_Cr);\par
00764     \}\par
00765   \}\par
00766 \par
00767   {\cf18 unsigned} tmpBs = 0;\par
00768   {\cf20 //-- Set BS for not Intra MB : BS = 2 or 1 or 0}\par
00769   {\cf19 if}(chType == CHANNEL_TYPE_LUMA)\par
00770   \{\par
00771     {\cf20 // Y}\par
00772     {\cf19 if} (m_aapucBS[edgeDir][rasterIdx] && (TU::getCbf(tuQ, COMPONENT_Y) || TU::getCbf(tuP, COMPONENT_Y)))\par
00773     \{\par
00774       tmpBs += BsSet(1, COMPONENT_Y);\par
00775     \}\par
00776   \}\par
00777   {\cf19 else}\par
00778   \{\par
00779     {\cf19 if} (pcv.chrFormat != CHROMA_400)\par
00780     \{\par
00781       {\cf20 // U}\par
00782       {\cf19 if} (m_aapucBS[edgeDir][rasterIdx]\par
00783           && (TU::getCbf(tuQ, COMPONENT_Cb) || TU::getCbf(tuP, COMPONENT_Cb) || tuQ.jointCbCr || tuP.jointCbCr))\par
00784       \{\par
00785         tmpBs += BsSet(1, COMPONENT_Cb);\par
00786       \}\par
00787       {\cf20 // V}\par
00788       {\cf19 if} (m_aapucBS[edgeDir][rasterIdx]\par
00789           && (TU::getCbf(tuQ, COMPONENT_Cr) || TU::getCbf(tuP, COMPONENT_Cr) || tuQ.jointCbCr || tuP.jointCbCr))\par
00790       \{\par
00791         tmpBs += BsSet(1, COMPONENT_Cr);\par
00792       \}\par
00793     \}\par
00794   \}\par
00795   {\cf19 if} (BsGet(tmpBs, COMPONENT_Y) == 1)\par
00796   \{\par
00797     {\cf19 return} tmpBs;\par
00798   \}\par
00799 \par
00800   {\cf19 if} ( !cu.Y().valid() )\par
00801   \{\par
00802     {\cf19 return} tmpBs;\par
00803   \}\par
00804 \par
00805   {\cf20 // and now the pred}\par
00806   {\cf19 if} (m_aapucBS[edgeDir][rasterIdx] != 0 && m_aapucBS[edgeDir][rasterIdx] != 3)\par
00807   \{\par
00808     {\cf19 return} tmpBs;\par
00809   \}\par
00810   {\cf19 if}( chType == CHANNEL_TYPE_CHROMA )\par
00811   \{\par
00812     {\cf19 return} tmpBs;\par
00813   \}\par
00814   {\cf19 if}( cuP.predMode != cuQ.predMode && chType == CHANNEL_TYPE_LUMA )\par
00815   \{\par
00816     {\cf19 return} BsSet(1, COMPONENT_Y);\par
00817   \}\par
00818   {\cf17 const} Position& lumaPosQ  = Position\{ localPos.x,  localPos.y \};\par
00819   {\cf17 const} Position  lumaPosP  = ( edgeDir == EDGE_VER ) ? lumaPosQ.offset( -1, 0 ) : lumaPosQ.offset( 0, -1 );\par
00820   {\cf17 const} MotionInfo&     miQ = cuQ.cs->getMotionInfo( lumaPosQ );\par
00821   {\cf17 const} MotionInfo&     miP = cuP.cs->getMotionInfo( lumaPosP );\par
00822   {\cf17 const} Slice&       sliceP = *cuP.slice;\par
00823 \par
00824   {\cf19 if} (sliceQ.isInterB() || sliceP.isInterB())\par
00825   \{\par
00826     {\cf17 const} Picture *piRefP0 = (CU::isIBC(cuP) ? sliceP.getPic() : ((0 > miP.refIdx[0]) ? NULL : sliceP.getRefPic(REF_PIC_LIST_0, miP.refIdx[0])));\par
00827     {\cf17 const} Picture *piRefP1 = (CU::isIBC(cuP) ? NULL            : ((0 > miP.refIdx[1]) ? NULL : sliceP.getRefPic(REF_PIC_LIST_1, miP.refIdx[1])));\par
00828     {\cf17 const} Picture *piRefQ0 = (CU::isIBC(cuQ) ? sliceQ.getPic() : ((0 > miQ.refIdx[0]) ? NULL : sliceQ.getRefPic(REF_PIC_LIST_0, miQ.refIdx[0])));\par
00829     {\cf17 const} Picture *piRefQ1 = (CU::isIBC(cuQ) ? NULL            : ((0 > miQ.refIdx[1]) ? NULL : sliceQ.getRefPic(REF_PIC_LIST_1, miQ.refIdx[1])));\par
00830     Mv mvP0, mvP1, mvQ0, mvQ1;\par
00831 \par
00832     {\cf19 if} (0 <= miP.refIdx[0])\par
00833     \{\par
00834       mvP0 = miP.mv[0];\par
00835     \}\par
00836     {\cf19 if} (0 <= miP.refIdx[1])\par
00837     \{\par
00838       mvP1 = miP.mv[1];\par
00839     \}\par
00840     {\cf19 if} (0 <= miQ.refIdx[0])\par
00841     \{\par
00842       mvQ0 = miQ.mv[0];\par
00843     \}\par
00844     {\cf19 if} (0 <= miQ.refIdx[1])\par
00845     \{\par
00846       mvQ1 = miQ.mv[1];\par
00847     \}\par
00848 \par
00849     {\cf18 int} nThreshold = (1 << MV_FRACTIONAL_BITS_INTERNAL) >> 1;\par
00850     {\cf18 unsigned} uiBs = 0;\par
00851 \par
00852     {\cf20 //th can be optimized}\par
00853     {\cf19 if} ( ((piRefP0==piRefQ0)&&(piRefP1==piRefQ1)) || ((piRefP0==piRefQ1)&&(piRefP1==piRefQ0)) )\par
00854     \{\par
00855       {\cf19 if} ( piRefP0 != piRefP1 )   {\cf20 // Different L0 & L1}\par
00856       \{\par
00857         {\cf19 if} ( piRefP0 == piRefQ0 )\par
00858         \{\par
00859           uiBs  = ((abs(mvQ0.getHor() - mvP0.getHor()) >= nThreshold) || (abs(mvQ0.getVer() - mvP0.getVer()) >= nThreshold) ||\par
00860                    (abs(mvQ1.getHor() - mvP1.getHor()) >= nThreshold) || (abs(mvQ1.getVer() - mvP1.getVer()) >= nThreshold))\par
00861                   ? 1 : 0;\par
00862         \}\par
00863         {\cf19 else}\par
00864         \{\par
00865           uiBs  = ((abs(mvQ1.getHor() - mvP0.getHor()) >= nThreshold) || (abs(mvQ1.getVer() - mvP0.getVer()) >= nThreshold) ||\par
00866                    (abs(mvQ0.getHor() - mvP1.getHor()) >= nThreshold) || (abs(mvQ0.getVer() - mvP1.getVer()) >= nThreshold))\par
00867                   ? 1 : 0;\par
00868         \}\par
00869       \}\par
00870       {\cf19 else}    {\cf20 // Same L0 & L1}\par
00871       \{\par
00872         uiBs  = ((abs(mvQ0.getHor() - mvP0.getHor()) >= nThreshold) || (abs(mvQ0.getVer() - mvP0.getVer()) >= nThreshold) ||\par
00873                  (abs(mvQ1.getHor() - mvP1.getHor()) >= nThreshold) || (abs(mvQ1.getVer() - mvP1.getVer()) >= nThreshold))\par
00874               &&\par
00875                 ((abs(mvQ1.getHor() - mvP0.getHor()) >= nThreshold) || (abs(mvQ1.getVer() - mvP0.getVer()) >= nThreshold) ||\par
00876                  (abs(mvQ0.getHor() - mvP1.getHor()) >= nThreshold) || (abs(mvQ0.getVer() - mvP1.getVer()) >= nThreshold))\par
00877               ? 1 : 0;\par
00878       \}\par
00879     \}\par
00880     {\cf19 else} {\cf20 // for all different Ref_Idx}\par
00881     \{\par
00882       uiBs = 1;\par
00883     \}\par
00884     {\cf19 return} uiBs + tmpBs;\par
00885   \}\par
00886 \par
00887 \par
00888   {\cf20 // pcSlice->isInterP()}\par
00889   CHECK(CU::isInter(cuP) && 0 > miP.refIdx[0], {\cf22 "Invalid reference picture list index"});\par
00890   CHECK(CU::isInter(cuP) && 0 > miQ.refIdx[0], {\cf22 "Invalid reference picture list index"});\par
00891   {\cf17 const} Picture *piRefP0 = (CU::isIBC(cuP) ? sliceP.getPic() : sliceP.getRefPic(REF_PIC_LIST_0, miP.refIdx[0]));\par
00892   {\cf17 const} Picture *piRefQ0 = (CU::isIBC(cuQ) ? sliceQ.getPic() : sliceQ.getRefPic(REF_PIC_LIST_0, miQ.refIdx[0]));\par
00893   {\cf19 if} (piRefP0 != piRefQ0)\par
00894   \{\par
00895     {\cf19 return} tmpBs + 1;\par
00896   \}\par
00897 \par
00898   Mv mvP0 = miP.mv[0];\par
00899   Mv mvQ0 = miQ.mv[0];\par
00900 \par
00901   {\cf18 int} nThreshold = (1 << MV_FRACTIONAL_BITS_INTERNAL) >> 1;\par
00902   {\cf19 return} ( ( abs( mvQ0.getHor() - mvP0.getHor() ) >= nThreshold ) || ( abs( mvQ0.getVer() - mvP0.getVer() ) >= nThreshold ) ) ? (tmpBs + 1) : tmpBs;\par
00903 \}\par
00904 \par
00905 {\cf21 #if LUMA_ADAPTIVE_DEBLOCKING_FILTER_QP_OFFSET}\par
00906 {\cf18 void} LoopFilter::deriveLADFShift( {\cf17 const} Pel* src, {\cf17 const} {\cf18 int} stride, {\cf18 int}& shift, {\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} SPS sps )\par
00907 \{\par
00908   uint32_t lumaLevel = 0;\par
00909   shift = sps.getLadfQpOffset(0);\par
00910 \par
00911   {\cf19 if} (edgeDir == EDGE_VER)\par
00912   \{\par
00913     lumaLevel = (src[0] + src[3*stride] + src[-1] + src[3*stride - 1]) >> 2;\par
00914   \}\par
00915   {\cf19 else} {\cf20 // (edgeDir == EDGE_HOR)}\par
00916   \{\par
00917     lumaLevel = (src[0] + src[3] + src[-stride] + src[-stride + 3]) >> 2;\par
00918   \}\par
00919 \par
00920   {\cf19 for} ( {\cf18 int} k = 1; k < sps.getLadfNumIntervals(); k++ )\par
00921   \{\par
00922     {\cf17 const} {\cf18 int} th = sps.getLadfIntervalLowerBound( k );\par
00923     {\cf19 if} ( lumaLevel > th )\par
00924     \{\par
00925       shift = sps.getLadfQpOffset( k );\par
00926     \}\par
00927     {\cf19 else}\par
00928     \{\par
00929       {\cf19 break};\par
00930     \}\par
00931   \}\par
00932 \}\par
00933 {\cf21 #endif}\par
00934 \par
00935 {\cf18 void} LoopFilter::xEdgeFilterLuma( {\cf17 const} CodingUnit& cu, {\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} {\cf18 int} iEdge )\par
00936 \{\par
00937   {\cf17 const} CompArea&  lumaArea = cu.block(COMPONENT_Y);\par
00938   {\cf17 const} PreCalcValues& pcv = *cu.cs->pcv;\par
00939 \par
00940   PelBuf        picYuvRec = m_enc ? m_encPicYuvBuffer.getBuf( lumaArea ) : cu.cs->getRecoBuf( lumaArea );\par
00941   Pel           *piSrc    = picYuvRec.buf;\par
00942   {\cf17 const} {\cf18 int}     iStride   = picYuvRec.stride;\par
00943   Pel           *piTmpSrc = piSrc;\par
00944   {\cf17 const} PPS     &pps      = *(cu.cs->pps);\par
00945   {\cf17 const} SPS     &sps      = *(cu.cs->sps);\par
00946   {\cf17 const} Slice   &slice    = *(cu.slice);\par
00947   {\cf17 const} {\cf18 bool}    spsPaletteEnabledFlag          = sps.getPLTMode();\par
00948   {\cf17 const} {\cf18 int}     bitDepthLuma                   = sps.getBitDepth(CHANNEL_TYPE_LUMA);\par
00949   {\cf17 const} ClpRng& clpRng( cu.cs->slice->clpRng(COMPONENT_Y) );\par
00950 \par
00951   {\cf18 int}          iQP          = 0;\par
00952   {\cf18 unsigned}     uiNumParts   = ( ( ( edgeDir == EDGE_VER ) ? lumaArea.height / pcv.minCUHeight : lumaArea.width / pcv.minCUWidth ) );\par
00953   {\cf18 int}          pelsInPart   = pcv.minCUWidth;\par
00954   {\cf18 unsigned}     uiBsAbsIdx   = 0, uiBs = 0;\par
00955   {\cf18 int}          iOffset, iSrcStep;\par
00956 \par
00957   {\cf18 bool}  bPartPNoFilter  = {\cf17 false};\par
00958   {\cf18 bool}  bPartQNoFilter  = {\cf17 false};\par
00959   {\cf18 int}   betaOffsetDiv2  = slice.getDeblockingFilterBetaOffsetDiv2();\par
00960   {\cf18 int}   tcOffsetDiv2    = slice.getDeblockingFilterTcOffsetDiv2();\par
00961   {\cf18 int}   xoffset, yoffset;\par
00962 \par
00963   Position pos;\par
00964 \par
00965   {\cf19 if} (edgeDir == EDGE_VER)\par
00966   \{\par
00967     xoffset   = 0;\par
00968     yoffset   = pelsInPart;\par
00969     iOffset   = 1;\par
00970     iSrcStep  = iStride;\par
00971     piTmpSrc += iEdge * pelsInPart;\par
00972     pos       = Position\{ lumaArea.x + iEdge * pelsInPart, lumaArea.y - yoffset \};\par
00973   \}\par
00974   {\cf19 else}  {\cf20 // (edgeDir == EDGE_HOR)}\par
00975   \{\par
00976     xoffset   = pelsInPart;\par
00977     yoffset   = 0;\par
00978     iOffset   = iStride;\par
00979     iSrcStep  = 1;\par
00980     piTmpSrc += iEdge*pelsInPart*iStride;\par
00981     pos       = Position\{ lumaArea.x - xoffset, lumaArea.y + iEdge * pelsInPart \};\par
00982   \}\par
00983 \par
00984   {\cf17 const} {\cf18 int} iBitdepthScale = 1 << (bitDepthLuma - 8);\par
00985 \par
00986   {\cf20 // dec pos since within the loop we first calc the pos}\par
00987   {\cf19 for}( {\cf18 int} iIdx = 0; iIdx < uiNumParts; iIdx++ )\par
00988   \{\par
00989     pos.x += xoffset;\par
00990     pos.y += yoffset;\par
00991 \par
00992     {\cf20 // Deblock luma boundaries on 4x4 grid only}\par
00993     {\cf19 if} (edgeDir == EDGE_HOR && (pos.y % 4) != 0)\par
00994     \{\par
00995       {\cf19 continue};\par
00996     \}\par
00997     {\cf19 if} (edgeDir == EDGE_VER && (pos.x % 4) != 0)\par
00998     \{\par
00999       {\cf19 continue};\par
01000     \}\par
01001     uiBsAbsIdx = getRasterIdx( pos, pcv );\par
01002     uiBs = BsGet(m_aapucBS[edgeDir][uiBsAbsIdx], COMPONENT_Y);\par
01003 \par
01004     {\cf19 if}( uiBs )\par
01005     \{\par
01006       {\cf17 const} CodingUnit& cuQ =  cu;\par
01007       {\cf17 const} CodingUnit& cuP = *cu.cs->getCU(pos.offset(xoffset - pelsInPart, yoffset - pelsInPart), cu.chType);\par
01008       {\cf20 // Derive neighboring PU index}\par
01009       {\cf19 if} (edgeDir == EDGE_VER)\par
01010       \{\par
01011         {\cf19 if} (!isAvailableLeft(cu, cuP, !pps.getLoopFilterAcrossSlicesEnabledFlag(), !pps.getLoopFilterAcrossTilesEnabledFlag(),\par
01012           !( pps.getSubPicFromCU(cu).getloopFilterAcrossEnabledFlag() && pps.getSubPicFromCU(cuP).getloopFilterAcrossEnabledFlag())))\par
01013         \{\par
01014           m_aapucBS[edgeDir][uiBsAbsIdx] = uiBs = 0;\par
01015           {\cf19 continue};\par
01016         \}\par
01017       \}\par
01018       {\cf19 else}  {\cf20 // (iDir == EDGE_HOR)}\par
01019       \{\par
01020         {\cf19 if} (!isAvailableAbove(cu, cuP, !pps.getLoopFilterAcrossSlicesEnabledFlag(), !pps.getLoopFilterAcrossTilesEnabledFlag(),\par
01021           !( pps.getSubPicFromCU(cu).getloopFilterAcrossEnabledFlag() && pps.getSubPicFromCU(cuP).getloopFilterAcrossEnabledFlag())))\par
01022         \{\par
01023           m_aapucBS[edgeDir][uiBsAbsIdx] = uiBs = 0;\par
01024           {\cf19 continue};\par
01025         \}\par
01026       \}\par
01027 \par
01028       iQP = (cuP.qp + cuQ.qp + 1) >> 1;\par
01029 \par
01030 {\cf21 #if LUMA_ADAPTIVE_DEBLOCKING_FILTER_QP_OFFSET}\par
01031       {\cf19 if} ( sps.getLadfEnabled() )\par
01032       \{\par
01033         {\cf18 int} iShift = 0;\par
01034         deriveLADFShift( piTmpSrc + iSrcStep * (iIdx*pelsInPart), iStride, iShift, edgeDir, sps );\par
01035         iQP += iShift;\par
01036       \}\par
01037 {\cf21 #endif}\par
01038 \par
01039       {\cf18 bool} sidePisLarge   = {\cf17 false};\par
01040       {\cf18 bool} sideQisLarge   = {\cf17 false};\par
01041       {\cf18 int} maxFilterLengthP = m_maxFilterLengthP[COMPONENT_Y][pos.x-m_ctuXLumaSamples][pos.y-m_ctuYLumaSamples];\par
01042       {\cf18 int} maxFilterLengthQ = m_maxFilterLengthQ[COMPONENT_Y][pos.x-m_ctuXLumaSamples][pos.y-m_ctuYLumaSamples];\par
01043       {\cf19 if} (maxFilterLengthP > 3)\par
01044       \{\par
01045         sidePisLarge = {\cf17 true};\par
01046         {\cf19 if} ( maxFilterLengthP > 5 )\par
01047         \{\par
01048           {\cf20 // restrict filter length if sub-blocks are used (e.g affine or ATMVP)}\par
01049           {\cf19 if} (cuP.affine)\par
01050           \{\par
01051             maxFilterLengthP = std::min(maxFilterLengthP, 5);\par
01052           \}\par
01053         \}\par
01054       \}\par
01055       {\cf19 if} (maxFilterLengthQ > 3)\par
01056       \{\par
01057         sideQisLarge = {\cf17 true};\par
01058       \}\par
01059 \par
01060       {\cf19 if} (edgeDir == EDGE_HOR && pos.y % slice.getSPS()->getCTUSize() == 0)\par
01061       \{\par
01062         sidePisLarge = {\cf17 false};\par
01063       \}\par
01064       {\cf17 const} {\cf18 int} iIndexTC  = Clip3(0, MAX_QP + DEFAULT_INTRA_TC_OFFSET, {\cf18 int}(iQP + DEFAULT_INTRA_TC_OFFSET*(uiBs - 1) + (tcOffsetDiv2 << 1)));\par
01065       {\cf17 const} {\cf18 int} iIndexB   = Clip3(0, MAX_QP, iQP + (betaOffsetDiv2 << 1));\par
01066 \par
01067       {\cf17 const} {\cf18 int} iTc = bitDepthLuma < 10 ? ((sm_tcTable[iIndexTC] + (1 << (9 - bitDepthLuma))) >> (10 - bitDepthLuma)) : ((sm_tcTable[iIndexTC]) << (bitDepthLuma - 10));\par
01068       {\cf17 const} {\cf18 int} iBeta     = sm_betaTable[iIndexB ] * iBitdepthScale;\par
01069       {\cf17 const} {\cf18 int} iSideThreshold = ( iBeta + ( iBeta >> 1 ) ) >> 3;\par
01070       {\cf17 const} {\cf18 int} iThrCut   = iTc * 10;\par
01071 \par
01072       {\cf17 const} {\cf18 unsigned} uiBlocksInPart = pelsInPart / 4 ? pelsInPart / 4 : 1;\par
01073 \par
01074       {\cf19 for}( {\cf18 int} iBlkIdx = 0; iBlkIdx < uiBlocksInPart; iBlkIdx++ )\par
01075       \{\par
01076         {\cf17 const} {\cf18 int} dp0 = xCalcDP(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 0), iOffset);\par
01077         {\cf17 const} {\cf18 int} dq0 = xCalcDQ(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 0), iOffset);\par
01078         {\cf17 const} {\cf18 int} dp3 = xCalcDP(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 3), iOffset);\par
01079         {\cf17 const} {\cf18 int} dq3 = xCalcDQ(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 3), iOffset);\par
01080         {\cf18 int} dp0L = dp0;\par
01081         {\cf18 int} dq0L = dq0;\par
01082         {\cf18 int} dp3L = dp3;\par
01083         {\cf18 int} dq3L = dq3;\par
01084 \par
01085         {\cf19 if} (sidePisLarge)\par
01086         \{\par
01087           dp0L = (dp0L + xCalcDP(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 0) - 3 * iOffset, iOffset) + 1) >> 1;\par
01088           dp3L = (dp3L + xCalcDP(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 3) - 3 * iOffset, iOffset) + 1) >> 1;\par
01089         \}\par
01090         {\cf19 if} (sideQisLarge)\par
01091         \{\par
01092           dq0L = (dq0L + xCalcDQ(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 0) + 3 * iOffset, iOffset) + 1) >> 1;\par
01093           dq3L = (dq3L + xCalcDQ(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + 3) + 3 * iOffset, iOffset) + 1) >> 1;\par
01094         \}\par
01095         {\cf18 bool} useLongtapFilter = {\cf17 false};\par
01096         {\cf19 if} (sidePisLarge || sideQisLarge)\par
01097         \{\par
01098           {\cf18 int} d0L = dp0L + dq0L;\par
01099           {\cf18 int} d3L = dp3L + dq3L;\par
01100 \par
01101           {\cf18 int} dpL = dp0L + dp3L;\par
01102           {\cf18 int} dqL = dq0L + dq3L;\par
01103 \par
01104           {\cf18 int} dL = d0L + d3L;\par
01105 \par
01106           bPartPNoFilter = bPartQNoFilter = {\cf17 false};\par
01107           {\cf19 if} (spsPaletteEnabledFlag)\par
01108           \{\par
01109             {\cf20 // check if each of PUs is palette coded}\par
01110             bPartPNoFilter = bPartPNoFilter || CU::isPLT(cuP);\par
01111             bPartQNoFilter = bPartQNoFilter || CU::isPLT(cuQ);\par
01112           \}\par
01113 \par
01114           {\cf19 if} (dL < iBeta)\par
01115           \{\par
01116             {\cf17 const} {\cf18 bool} filterP = (dpL < iSideThreshold);\par
01117             {\cf17 const} {\cf18 bool} filterQ = (dqL < iSideThreshold);\par
01118 \par
01119             Pel* src0 = piTmpSrc + iSrcStep * (iIdx*pelsInPart + iBlkIdx * 4 + 0);\par
01120             Pel* src3 = piTmpSrc + iSrcStep * (iIdx*pelsInPart + iBlkIdx * 4 + 3);\par
01121 \par
01122             {\cf20 // adjust decision so that it is not read beyond p5 is maxFilterLengthP is 5 and q5 if maxFilterLengthQ is 5}\par
01123             {\cf17 const} {\cf18 bool} swL = xUseStrongFiltering(src0, iOffset, 2 * d0L, iBeta, iTc, sidePisLarge, sideQisLarge, maxFilterLengthP, maxFilterLengthQ)\par
01124               && xUseStrongFiltering(src3, iOffset, 2 * d3L, iBeta, iTc, sidePisLarge, sideQisLarge, maxFilterLengthP, maxFilterLengthQ);\par
01125             {\cf19 if} (swL)\par
01126             \{\par
01127               useLongtapFilter = {\cf17 true};\par
01128               {\cf19 for} ({\cf18 int} i = 0; i < DEBLOCK_SMALLEST_BLOCK / 2; i++)\par
01129               \{\par
01130                 xPelFilterLuma(piTmpSrc + iSrcStep*(iIdx*pelsInPart + iBlkIdx * 4 + i), iOffset, iTc, swL, bPartPNoFilter, bPartQNoFilter, iThrCut, filterP, filterQ, clpRng, sidePisLarge, sideQisLarge, maxFilterLengthP, maxFilterLengthQ);\par
01131               \}\par
01132             \}\par
01133 \par
01134           \}\par
01135         \}\par
01136         {\cf19 if} (!useLongtapFilter)\par
01137         \{\par
01138           {\cf17 const} {\cf18 int} d0 = dp0 + dq0;\par
01139           {\cf17 const} {\cf18 int} d3 = dp3 + dq3;\par
01140 \par
01141           {\cf17 const} {\cf18 int} dp = dp0 + dp3;\par
01142           {\cf17 const} {\cf18 int} dq = dq0 + dq3;\par
01143           {\cf17 const} {\cf18 int} d  = d0 + d3;\par
01144 \par
01145           bPartPNoFilter = bPartQNoFilter = {\cf17 false};\par
01146           {\cf19 if} (spsPaletteEnabledFlag)\par
01147           \{\par
01148             {\cf20 // check if each of PUs is palette coded}\par
01149             bPartPNoFilter = bPartPNoFilter || CU::isPLT(cuP);\par
01150             bPartQNoFilter = bPartQNoFilter || CU::isPLT(cuQ);\par
01151           \}\par
01152 \par
01153           {\cf19 if} (d < iBeta)\par
01154           \{\par
01155             {\cf18 bool} bFilterP = {\cf17 false};\par
01156             {\cf18 bool} bFilterQ = {\cf17 false};\par
01157             {\cf19 if} (maxFilterLengthP > 1 && maxFilterLengthQ > 1)\par
01158             \{\par
01159               bFilterP = (dp < iSideThreshold);\par
01160               bFilterQ = (dq < iSideThreshold);\par
01161             \}\par
01162             {\cf18 bool} sw = {\cf17 false};\par
01163             {\cf19 if} (maxFilterLengthP > 2 && maxFilterLengthQ > 2)\par
01164             \{\par
01165               sw = xUseStrongFiltering(piTmpSrc + iSrcStep * (iIdx * pelsInPart + iBlkIdx * 4 + 0), iOffset, 2 * d0,\par
01166                                        iBeta, iTc)\par
01167                    && xUseStrongFiltering(piTmpSrc + iSrcStep * (iIdx * pelsInPart + iBlkIdx * 4 + 3), iOffset, 2 * d3,\par
01168                                           iBeta, iTc);\par
01169             \}\par
01170             {\cf19 for} ({\cf18 int} i = 0; i < DEBLOCK_SMALLEST_BLOCK / 2; i++)\par
01171             \{\par
01172               xPelFilterLuma(piTmpSrc + iSrcStep * (iIdx * pelsInPart + iBlkIdx * 4 + i), iOffset, iTc, sw,\par
01173                              bPartPNoFilter, bPartQNoFilter, iThrCut, bFilterP, bFilterQ, clpRng);\par
01174             \}\par
01175           \}\par
01176         \}\par
01177       \}\par
01178     \}\par
01179   \}\par
01180 \}\par
01181 \par
01182 \par
01183 {\cf18 void} LoopFilter::xEdgeFilterChroma({\cf17 const} CodingUnit& cu, {\cf17 const} DeblockEdgeDir edgeDir, {\cf17 const} {\cf18 int} iEdge)\par
01184 \{\par
01185   {\cf17 const} Position lumaPos   = cu.Y().valid() ? cu.Y().pos() : recalcPosition( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, cu.blocks[cu.chType].pos() );\par
01186   {\cf17 const} Size     lumaSize  = cu.Y().valid() ? cu.Y().size() : recalcSize( cu.chromaFormat, cu.chType, CHANNEL_TYPE_LUMA, cu.blocks[cu.chType].size() );\par
01187 \par
01188   {\cf17 const} PreCalcValues& pcv = *cu.cs->pcv;\par
01189   {\cf18 unsigned}  rasterIdx      = getRasterIdx( lumaPos, pcv );\par
01190   PelBuf     picYuvRecCb = m_enc ? m_encPicYuvBuffer.getBuf(cu.block(COMPONENT_Cb)) : cu.cs->getRecoBuf(cu.block(COMPONENT_Cb));\par
01191   PelBuf     picYuvRecCr = m_enc ? m_encPicYuvBuffer.getBuf(cu.block(COMPONENT_Cr)) : cu.cs->getRecoBuf(cu.block(COMPONENT_Cr));\par
01192   Pel       *piSrcCb       = picYuvRecCb.buf;\par
01193   Pel       *piSrcCr       = picYuvRecCr.buf;\par
01194   {\cf17 const} {\cf18 int}  iStride       = picYuvRecCb.stride;\par
01195   {\cf17 const} SPS &sps           = *cu.cs->sps;\par
01196   {\cf17 const} PPS &pps           = *cu.cs->pps;\par
01197   {\cf17 const} Slice  &slice      = *cu.slice;\par
01198   {\cf17 const} ChromaFormat nChromaFormat   = sps.getChromaFormatIdc();\par
01199   {\cf17 const} {\cf18 unsigned} uiPelsInPartChromaH = pcv.minCUWidth  >> ::getComponentScaleX(COMPONENT_Cb, nChromaFormat);\par
01200   {\cf17 const} {\cf18 unsigned} uiPelsInPartChromaV = pcv.minCUHeight >> ::getComponentScaleY(COMPONENT_Cb, nChromaFormat);\par
01201 \par
01202   {\cf18 int}       iOffset, iSrcStep;\par
01203   {\cf18 unsigned}  uiLoopLength;\par
01204 \par
01205   {\cf18 bool}      bPartPNoFilter  = {\cf17 false};\par
01206   {\cf18 bool}      bPartQNoFilter  = {\cf17 false};\par
01207   {\cf17 const} {\cf18 int} tcOffsetDiv2[2]   = \{ slice.getDeblockingFilterCbTcOffsetDiv2(), slice.getDeblockingFilterCrTcOffsetDiv2() \};\par
01208   {\cf17 const} {\cf18 int} betaOffsetDiv2[2] = \{ slice.getDeblockingFilterCbBetaOffsetDiv2(), slice.getDeblockingFilterCrBetaOffsetDiv2() \};\par
01209 \par
01210   {\cf20 // Vertical Position}\par
01211   {\cf18 unsigned} uiEdgeNumInCtuVert = rasterIdx % pcv.partsInCtuWidth + iEdge;\par
01212   {\cf18 unsigned} uiEdgeNumInCtuHor  = rasterIdx / pcv.partsInCtuWidth + iEdge;\par
01213 \par
01214   {\cf19 if}( ( uiPelsInPartChromaH < DEBLOCK_SMALLEST_BLOCK ) && ( uiPelsInPartChromaV < DEBLOCK_SMALLEST_BLOCK ) &&\par
01215       (\par
01216         ( ( uiEdgeNumInCtuVert % ( DEBLOCK_SMALLEST_BLOCK / uiPelsInPartChromaH ) ) && ( edgeDir == EDGE_VER ) ) ||\par
01217         ( ( uiEdgeNumInCtuHor  % ( DEBLOCK_SMALLEST_BLOCK / uiPelsInPartChromaV ) ) && ( edgeDir == EDGE_HOR ) )\par
01218       )\par
01219     )\par
01220   \{\par
01221     {\cf19 return};\par
01222   \}\par
01223 \par
01224   {\cf18 unsigned} uiNumParts =  ( edgeDir == EDGE_VER ) ? lumaSize.height / pcv.minCUHeight : lumaSize.width / pcv.minCUWidth ;\par
01225   {\cf18 int}   uiNumPelsLuma = pcv.minCUWidth;\par
01226   {\cf18 unsigned} uiBsAbsIdx;\par
01227   {\cf18 unsigned} bS[2];\par
01228 \par
01229   Pel* piTmpSrcCb = piSrcCb;\par
01230   Pel* piTmpSrcCr = piSrcCr;\par
01231   {\cf18 int} xoffset, yoffset;\par
01232   Position pos( lumaPos.x, lumaPos.y );\par
01233 \par
01234   {\cf19 if}( edgeDir == EDGE_VER )\par
01235   \{\par
01236     xoffset      = 0;\par
01237     yoffset      = uiNumPelsLuma;\par
01238     iOffset      = 1;\par
01239     iSrcStep     = iStride;\par
01240     piTmpSrcCb  += iEdge*uiPelsInPartChromaH;\par
01241     piTmpSrcCr  += iEdge*uiPelsInPartChromaH;\par
01242     uiLoopLength = uiPelsInPartChromaV;\par
01243     pos          = Position\{ lumaPos.x + iEdge*uiNumPelsLuma, lumaPos.y - yoffset \};\par
01244   \}\par
01245   {\cf19 else}  {\cf20 // (edgeDir == EDGE_HOR)}\par
01246   \{\par
01247     xoffset      = uiNumPelsLuma;\par
01248     yoffset      = 0;\par
01249     iOffset      = iStride;\par
01250     iSrcStep     = 1;\par
01251     piTmpSrcCb  += iEdge*iStride*uiPelsInPartChromaV;\par
01252     piTmpSrcCr  += iEdge*iStride*uiPelsInPartChromaV;\par
01253     uiLoopLength = uiPelsInPartChromaH;\par
01254     pos          = Position\{ lumaPos.x - xoffset, lumaPos.y + iEdge*uiNumPelsLuma \};\par
01255   \}\par
01256 \par
01257   {\cf17 const} {\cf18 int} iBitdepthScale = 1 << (sps.getBitDepth(CHANNEL_TYPE_CHROMA) - 8);\par
01258 \par
01259   {\cf19 for}( {\cf18 int} iIdx = 0; iIdx < uiNumParts; iIdx++ )\par
01260   \{\par
01261     pos.x += xoffset;\par
01262     pos.y += yoffset;\par
01263 \par
01264     uiBsAbsIdx = getRasterIdx( pos, pcv );\par
01265     {\cf18 unsigned} tmpBs = m_aapucBS[edgeDir][uiBsAbsIdx];\par
01266 \par
01267     tmpBs = m_aapucBS[edgeDir][uiBsAbsIdx];\par
01268     bS[0] = BsGet(tmpBs, COMPONENT_Cb);\par
01269     bS[1] = BsGet(tmpBs, COMPONENT_Cr);\par
01270 \par
01271     {\cf19 if} (bS[0] > 0 || bS[1] > 0)\par
01272     \{\par
01273       {\cf17 const} CodingUnit& cuQ =  cu;\par
01274       CodingUnit& cuP1 = *cu.cs->getCU( recalcPosition( cu.chromaFormat, CHANNEL_TYPE_LUMA, cu.chType, pos.offset( xoffset - uiNumPelsLuma, yoffset - uiNumPelsLuma ) ), cu.chType );\par
01275       CodingUnit& cuP  = *cu.cs->getCU( recalcPosition( cu.chromaFormat, CHANNEL_TYPE_LUMA, (cuP1.isSepTree() ? CHANNEL_TYPE_CHROMA : cu.chType), pos.offset( xoffset - uiNumPelsLuma, yoffset - uiNumPelsLuma ) ), (cuP1.isSepTree() ? CHANNEL_TYPE_CHROMA : cu.chType));\par
01276 \par
01277       {\cf19 if} (edgeDir == EDGE_VER)\par
01278       \{\par
01279         CHECK(!isAvailableLeft(cu, cuP, !pps.getLoopFilterAcrossSlicesEnabledFlag(), !pps.getLoopFilterAcrossTilesEnabledFlag(),\par
01280           !( pps.getSubPicFromCU(cu).getloopFilterAcrossEnabledFlag() && pps.getSubPicFromCU(cuP).getloopFilterAcrossEnabledFlag())), {\cf22 "Neighbour not available"});\par
01281       \}\par
01282       {\cf19 else}  {\cf20 // (iDir == EDGE_HOR)}\par
01283       \{\par
01284         CHECK(!isAvailableAbove(cu, cuP, !pps.getLoopFilterAcrossSlicesEnabledFlag(), !pps.getLoopFilterAcrossTilesEnabledFlag(),\par
01285           !( pps.getSubPicFromCU(cu).getloopFilterAcrossEnabledFlag() && pps.getSubPicFromCU(cuP).getloopFilterAcrossEnabledFlag())), {\cf22 "Neighbour not available"});\par
01286       \}\par
01287 \par
01288       bPartPNoFilter = bPartQNoFilter = {\cf17 false};\par
01289       {\cf19 if} ( sps.getPLTMode())\par
01290       \{\par
01291         {\cf20 // check if each of PUs is palette coded}\par
01292         bPartPNoFilter = bPartPNoFilter || CU::isPLT(cuP);\par
01293         bPartQNoFilter = bPartQNoFilter || CU::isPLT(cuQ);\par
01294       \}\par
01295 \par
01296       {\cf17 const} {\cf18 int} maxFilterLengthP = m_maxFilterLengthP[COMPONENT_Cb][(pos.x-m_ctuXLumaSamples)>>m_shiftHor][(pos.y-m_ctuYLumaSamples)>>m_shiftVer];\par
01297       {\cf17 const} {\cf18 int} maxFilterLengthQ = m_maxFilterLengthQ[COMPONENT_Cb][(pos.x-m_ctuXLumaSamples)>>m_shiftHor][(pos.y-m_ctuYLumaSamples)>>m_shiftVer];\par
01298       {\cf18 bool} largeBoundary         = {\cf17 false};\par
01299       {\cf18 bool} isChromaHorCTBBoundary = {\cf17 false};\par
01300       {\cf19 if} ( maxFilterLengthP >= 3 && maxFilterLengthQ >= 3 )\par
01301       \{\par
01302         largeBoundary = {\cf17 true};\par
01303       \}\par
01304 \par
01305       {\cf19 if} (edgeDir == EDGE_HOR && pos.y % cuP.slice->getSPS()->getCTUSize() == 0)\par
01306       \{\par
01307         isChromaHorCTBBoundary = {\cf17 true};\par
01308       \}\par
01309 \par
01310       {\cf19 for}( {\cf18 int} chromaIdx = 0; chromaIdx < 2; chromaIdx++ )\par
01311       \{\par
01312         {\cf19 if} ((bS[chromaIdx] == 2) || (largeBoundary && (bS[chromaIdx] == 1)))\par
01313         \{\par
01314           {\cf17 const} ClpRng &clpRng(cu.cs->slice->clpRng(ComponentID(chromaIdx + 1)));\par
01315           Pel *         piTmpSrcChroma = (chromaIdx == 0) ? piTmpSrcCb : piTmpSrcCr;\par
01316 \par
01317           {\cf17 const} TransformUnit &tuQ = *cuQ.cs->getTU(\par
01318             recalcPosition(cu.chromaFormat, CHANNEL_TYPE_LUMA, CHANNEL_TYPE_CHROMA, pos), CHANNEL_TYPE_CHROMA);\par
01319           {\cf17 const} TransformUnit &tuP =\par
01320             *cuP.cs->getTU(recalcPosition(cu.chromaFormat, CHANNEL_TYPE_LUMA, CHANNEL_TYPE_CHROMA,\par
01321                                           (edgeDir == EDGE_VER) ? pos.offset(-1, 0) : pos.offset(0, -1)),\par
01322                            CHANNEL_TYPE_CHROMA);\par
01323 \par
01324           {\cf17 const} QpParam cQP(tuP, ComponentID(chromaIdx + 1), -MAX_INT, {\cf17 false});\par
01325           {\cf17 const} QpParam cQQ(tuQ, ComponentID(chromaIdx + 1), -MAX_INT, {\cf17 false});\par
01326 \par
01327           {\cf17 const} {\cf18 int} qpBdOffset = tuP.cs->sps->getQpBDOffset(toChannelType(ComponentID(chromaIdx + 1)));\par
01328           {\cf18 int}       baseQp_P   = cQP.Qp(0) - qpBdOffset;\par
01329           {\cf18 int}       baseQp_Q   = cQQ.Qp(0) - qpBdOffset;\par
01330           {\cf18 int}       iQP        = ((baseQp_Q + baseQp_P + 1) >> 1);\par
01331 \par
01332           {\cf17 const} {\cf18 int} iIndexTC =\par
01333             Clip3<int>(0, MAX_QP + DEFAULT_INTRA_TC_OFFSET,\par
01334                        iQP + DEFAULT_INTRA_TC_OFFSET * (bS[chromaIdx] - 1) + (tcOffsetDiv2[chromaIdx] << 1));\par
01335           {\cf17 const} {\cf18 int} bitDepthChroma = sps.getBitDepth(CHANNEL_TYPE_CHROMA);\par
01336           {\cf17 const} {\cf18 int} iTc            = bitDepthChroma < 10\par
01337                             ? ((sm_tcTable[iIndexTC] + (1 << (9 - bitDepthChroma))) >> (10 - bitDepthChroma))\par
01338                             : ((sm_tcTable[iIndexTC]) << (bitDepthChroma - 10));\par
01339           {\cf18 bool} useLongFilter = {\cf17 false};\par
01340           {\cf19 if} (largeBoundary)\par
01341           \{\par
01342             {\cf17 const} {\cf18 int} indexB = Clip3<int>(0, MAX_QP, iQP + (betaOffsetDiv2[chromaIdx] << 1));\par
01343             {\cf17 const} {\cf18 int} beta   = sm_betaTable[indexB] * iBitdepthScale;\par
01344 \par
01345             {\cf17 const} {\cf18 int} dp0 =\par
01346               xCalcDP(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 0), iOffset, isChromaHorCTBBoundary);\par
01347             {\cf17 const} {\cf18 int} dq0 = xCalcDQ(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 0), iOffset);\par
01348 \par
01349             {\cf17 const} {\cf18 int} subSamplingShift = (edgeDir == EDGE_VER) ? m_shiftVer : m_shiftHor;\par
01350 \par
01351             {\cf17 const} {\cf18 int} dp3 =\par
01352               (subSamplingShift == 1)\par
01353                 ? xCalcDP(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 1), iOffset, isChromaHorCTBBoundary)\par
01354                 : xCalcDP(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 3), iOffset, isChromaHorCTBBoundary);\par
01355             {\cf17 const} {\cf18 int} dq3 = (subSamplingShift == 1)\par
01356                               ? xCalcDQ(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 1), iOffset)\par
01357                               : xCalcDQ(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 3), iOffset);\par
01358 \par
01359             {\cf17 const} {\cf18 int} d0 = dp0 + dq0;\par
01360             {\cf17 const} {\cf18 int} d3 = dp3 + dq3;\par
01361             {\cf17 const} {\cf18 int} d  = d0 + d3;\par
01362 \par
01363             {\cf19 if} (d < beta)\par
01364             \{\par
01365               useLongFilter = {\cf17 true};\par
01366               {\cf17 const} {\cf18 bool} sw = xUseStrongFiltering(piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + 0), iOffset,\par
01367                                                   2 * d0, beta, iTc, {\cf17 false}, {\cf17 false}, 7, 7, isChromaHorCTBBoundary)\par
01368                               && xUseStrongFiltering(\par
01369                                 piTmpSrcChroma + iSrcStep * (iIdx * uiLoopLength + ((subSamplingShift == 1) ? 1 : 3)),\par
01370                                 iOffset, 2 * d3, beta, iTc, false, false, 7, 7, isChromaHorCTBBoundary);\par
01371 \par
01372               {\cf19 for} ({\cf18 unsigned} step = 0; step < uiLoopLength; step++)\par
01373               \{\par
01374                 xPelFilterChroma(piTmpSrcChroma + iSrcStep * (step + iIdx * uiLoopLength), iOffset, iTc, sw,\par
01375                                  bPartPNoFilter, bPartQNoFilter, clpRng, largeBoundary, isChromaHorCTBBoundary);\par
01376               \}\par
01377             \}\par
01378           \}\par
01379           {\cf19 if} (!useLongFilter)\par
01380           \{\par
01381             {\cf19 for} ({\cf18 unsigned} step = 0; step < uiLoopLength; step++)\par
01382             \{\par
01383               xPelFilterChroma(piTmpSrcChroma + iSrcStep * (step + iIdx * uiLoopLength), iOffset, iTc, {\cf17 false},\par
01384                                bPartPNoFilter, bPartQNoFilter, clpRng, largeBoundary, isChromaHorCTBBoundary);\par
01385             \}\par
01386           \}\par
01387         \}\par
01388       \}\par
01389     \}\par
01390   \}\par
01391 \}\par
01392 \par
