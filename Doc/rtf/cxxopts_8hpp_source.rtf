01102 {\cf17 inline} {\cf18 void} Options::add_option({\cf17 const} std::string &group, {\cf17 const} std::string &s, {\cf17 const} std::string &l, std::string desc,\par
01103                                 std::shared_ptr<const Value> value, std::string arg_help) \{\par
01104     {\cf17 auto} stringDesc = toLocalString(std::move(desc));\par
01105     {\cf17 auto} option = std::make_shared<OptionDetails>(s, l, stringDesc, value);\par
01106 \par
01107     {\cf19 if} (s.size() > 0) \{\par
01108         add_one_option(s, option);\par
01109     \}\par
01110 \par
01111     {\cf19 if} (l.size() > 0) \{\par
01112         add_one_option(l, option);\par
01113     \}\par
01114 \par
01115     {\cf20 // add the help details}\par
01116     {\cf17 auto} &options = m_help[group];\par
01117 \par
01118     options.options.emplace_back(HelpOptionDetails\{s, l, stringDesc, value->has_default(), value->get_default_value(),\par
01119                                                    value->has_implicit(), value->get_implicit_value(), std::move(arg_help),\par
01120                                                    value->is_container(), value->is_boolean()\});\par
01121 \}\par
01122 \par
01123 {\cf17 inline} {\cf18 void} Options::add_one_option({\cf17 const} std::string &option, std::shared_ptr<OptionDetails> details) \{\par
01124     {\cf17 auto} in = m_options.emplace(option, details);\par
01125 \par
01126     {\cf19 if} (!in.second) \{\par
01127         {\cf19 throw} option_exists_error(option);\par
01128     \}\par
01129 \}\par
01130 \par
01131 {\cf17 inline} String Options::help_one_group({\cf17 const} std::string &g){\cf17  const }\{\par
01132     {\cf17 typedef} std::vector<std::pair<String, String>> OptionHelp;\par
01133 \par
01134     {\cf17 auto} group = m_help.find(g);\par
01135     {\cf19 if} (group == m_help.end()) \{\par
01136         {\cf19 return} {\cf22 ""};\par
01137     \}\par
01138 \par
01139     OptionHelp format;\par
01140 \par
01141     {\cf18 size_t} longest = 0;\par
01142 \par
01143     String result;\par
01144 \par
01145     {\cf19 if} (!g.empty()) \{\par
01146         result += toLocalString({\cf22 " "} + g + {\cf22 " options:\\n"});\par
01147     \}\par
01148 \par
01149     {\cf19 for} ({\cf17 const} {\cf17 auto} &o : group->second.options) \{\par
01150         {\cf19 if} (o.is_container && m_positional_set.find(o.l) != m_positional_set.end() && !m_show_positional) \{\par
01151             {\cf19 continue};\par
01152         \}\par
01153 \par
01154         {\cf17 auto} s = format_option(o);\par
01155         longest = std::max(longest, stringLength(s));\par
01156         format.push_back(std::make_pair(s, String()));\par
01157     \}\par
01158 \par
01159     longest = std::min(longest, {\cf17 static_cast<}{\cf18 size_t}{\cf17 >}(OPTION_LONGEST));\par
01160 \par
01161     {\cf20 // widest allowed description}\par
01162     {\cf17 auto} allowed = {\cf18 size_t}\{999\} - longest - OPTION_DESC_GAP;\par
01163 \par
01164     {\cf17 auto} fiter = format.begin();\par
01165     {\cf19 for} ({\cf17 const} {\cf17 auto} &o : group->second.options) \{\par
01166         {\cf19 if} (o.is_container && m_positional_set.find(o.l) != m_positional_set.end() && !m_show_positional) \{\par
01167             {\cf19 continue};\par
01168         \}\par
01169 \par
01170         {\cf17 auto} d = format_description(o, longest + OPTION_DESC_GAP, allowed);\par
01171 \par
01172         result += fiter->first;\par
01173         {\cf19 if} (stringLength(fiter->first) > longest) \{\par
01174             result += {\cf23 '\\n'};\par
01175             result += toLocalString(std::string(longest + OPTION_DESC_GAP, {\cf23 ' '}));\par
01176         \} {\cf19 else} \{\par
01177             result += toLocalString(std::string(longest + OPTION_DESC_GAP - stringLength(fiter->first), {\cf23 ' '}));\par
01178         \}\par
01179         result += d;\par
01180         result += {\cf23 '\\n'};\par
01181 \par
01182         ++fiter;\par
01183     \}\par
01184 \par
01185     {\cf19 return} result;\par
01186 \}\par
01187 \par
01188 {\cf17 inline} {\cf18 void} Options::generate_group_help(String &result, {\cf17 const} std::vector<std::string> &print_groups){\cf17  const }\{\par
01189     {\cf19 for} ({\cf18 size_t} i = 0; i != print_groups.size(); ++i) \{\par
01190         {\cf17 const} String &group_help_text = help_one_group(print_groups[i]);\par
01191         {\cf19 if} (empty(group_help_text)) \{\par
01192             {\cf19 continue};\par
01193         \}\par
01194         result += group_help_text;\par
01195         {\cf19 if} (i < print_groups.size() - 1) \{\par
01196             result += {\cf23 '\\n'};\par
01197         \}\par
01198     \}\par
01199 \}\par
01200 \par
01201 {\cf17 inline} {\cf18 void} Options::generate_all_groups_help(String &result){\cf17  const }\{\par
01202     std::vector<std::string> all_groups;\par
01203     all_groups.reserve(m_help.size());\par
01204 \par
01205     {\cf19 for} ({\cf17 auto} &group : m_help) \{\par
01206         all_groups.push_back(group.first);\par
01207     \}\par
01208 \par
01209     generate_group_help(result, all_groups);\par
01210 \}\par
01211 \par
01212 {\cf17 inline} std::string Options::help({\cf17 const} std::vector<std::string> &help_groups){\cf17  const }\{\par
01213     String result = m_help_string + {\cf22 "\\nUsage:\\n  "} + toLocalString(m_program) + {\cf22 " "} + toLocalString(m_custom_help) +\par
01214                     {\cf22 "\\n  Use equal sign to set boolean values (example: --dump_surfaces=true)"};\par
01215 \par
01216     {\cf19 if} (m_positional.size() > 0 && m_positional_help.size() > 0) \{\par
01217         result += {\cf22 " "} + toLocalString(m_positional_help);\par
01218     \}\par
01219 \par
01220     result += {\cf22 "\\n\\n"};\par
01221 \par
01222     {\cf19 if} (help_groups.size() == 0) \{\par
01223         generate_all_groups_help(result);\par
01224     \} {\cf19 else} \{\par
01225         generate_group_help(result, help_groups);\par
01226     \}\par
01227 \par
01228     {\cf19 return} toUTF8String(result);\par
01229 \}\par
