00325 \par
00326     {\cf17 constexpr} {\cf17 auto} umax = std::numeric_limits<US>::max();\par
00327     {\cf17 constexpr} {\cf18 bool} is_signed = std::numeric_limits<T>::is_signed;\par
00328     {\cf17 const} {\cf18 bool} negative = match.length(1) > 0;\par
00329     {\cf17 const} uint8_t base = match.length(2) > 0 ? 16 : 10;\par
00330 \par
00331     {\cf17 auto} value_match = match[3];\par
00332 \par
00333     US result = 0;\par
00334 \par
00335     {\cf19 for} ({\cf17 auto} iter = value_match.first; iter != value_match.second; ++iter) \{\par
00336         US digit = 0;\par
00337 \par
00338         {\cf19 if} (*iter >= {\cf23 '0'} && *iter <= {\cf23 '9'}) \{\par
00339             digit = *iter - {\cf23 '0'};\par
00340         \} {\cf19 else} {\cf19 if} (base == 16 && *iter >= {\cf23 'a'} && *iter <= {\cf23 'f'}) \{\par
00341             digit = *iter - {\cf23 'a'} + 10;\par
00342         \} {\cf19 else} {\cf19 if} (base == 16 && *iter >= {\cf23 'A'} && *iter <= {\cf23 'F'}) \{\par
00343             digit = *iter - {\cf23 'A'} + 10;\par
