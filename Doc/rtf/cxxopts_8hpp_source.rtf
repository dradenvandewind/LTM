00782 String format_option({\cf17 const} HelpOptionDetails &o) \{\par
00783     {\cf17 auto} &s = o.s;\par
00784     {\cf17 auto} &l = o.l;\par
00785 \par
00786     String result = {\cf22 "  "};\par
00787 \par
00788     {\cf19 if} (s.size() > 0) \{\par
00789         result += {\cf22 "-"} + toLocalString(s) + {\cf22 ","};\par
00790     \} {\cf19 else} \{\par
00791         result += {\cf22 "   "};\par
00792     \}\par
00793 \par
00794     {\cf19 if} (l.size() > 0) \{\par
00795         result += {\cf22 " --"} + toLocalString(l);\par
00796     \}\par
00797 \par
00798     {\cf17 auto} arg = o.arg_help.size() > 0 ? toLocalString(o.arg_help) : {\cf22 "arg"};\par
00799 \par
00800     {\cf19 if} (!o.is_boolean) \{\par
00801         {\cf19 if} (o.has_implicit) \{\par
00802             result += {\cf22 " [="} + arg + {\cf22 "(="} + toLocalString(o.implicit_value) + {\cf22 ")]"};\par
00803         \} {\cf19 else} \{\par
00804             result += {\cf22 " "} + arg;\par
00805         \}\par
00806     \}\par
00807 \par
00808     {\cf19 return} result;\par
00809 \}\par
00810 \par
00811 String format_description({\cf17 const} HelpOptionDetails &o, {\cf18 size_t} start, {\cf18 size_t} width) \{\par
00812     {\cf17 auto} desc = o.desc;\par
00813 \par
00814     {\cf19 if} (o.has_default && (!o.is_boolean || o.default_value != {\cf22 "false"})) \{\par
00815         desc += toLocalString({\cf22 " (default: "} + o.default_value + {\cf22 ")"});\par
00816     \}\par
00817 \par
00818     String result;\par
00819 \par
00820     {\cf17 auto} current = std::begin(desc);\par
00821     {\cf17 auto} startLine = current;\par
00822     {\cf17 auto} lastSpace = current;\par
00823 \par
00824     {\cf17 auto} size = {\cf18 size_t}\{\};\par
00825 \par
00826     {\cf19 while} (current != std::end(desc)) \{\par
00827         {\cf19 if} (*current == {\cf23 ' '}) \{\par
00828             lastSpace = current;\par
00829         \}\par
00830 \par
00831         {\cf19 if} (size > width) \{\par
00832             {\cf19 if} (lastSpace == startLine) \{\par
00833                 stringAppend(result, startLine, current + 1);\par
00834                 stringAppend(result, {\cf22 "\\n"});\par
00835                 stringAppend(result, start, {\cf23 ' '});\par
00836                 startLine = current + 1;\par
00837                 lastSpace = startLine;\par
00838             \} {\cf19 else} \{\par
00839                 stringAppend(result, startLine, lastSpace);\par
00840                 stringAppend(result, {\cf22 "\\n"});\par
00841                 stringAppend(result, start, {\cf23 ' '});\par
00842                 startLine = lastSpace + 1;\par
00843             \}\par
00844             size = 0;\par
00845         \} {\cf19 else} \{\par
00846             ++size;\par
00847         \}\par
00848 \par
00849         ++current;\par
00850     \}\par
00851 \par
00852     {\cf20 // append whatever is left}\par
00853     stringAppend(result, startLine, current);\par
00854 \par
00855     {\cf19 return} result;\par
00856 \}\par
00857 \} {\cf20 // namespace}\par
