00868 {\cf17 inline} OptionAdder &OptionAdder::operator()({\cf17 const} std::string &opts, {\cf17 const} std::string &desc, std::shared_ptr<const Value> value,\par
00869                                             std::string arg_help) \{\par
00870     std::match_results<const char *> result;\par
00871     std::regex_match(opts.c_str(), result, option_specifier);\par
00872 \par
00873     {\cf19 if} (result.empty()) \{\par
00874         {\cf19 throw} invalid_option_format_error(opts);\par
00875     \}\par
00876 \par
00877     {\cf17 const} {\cf17 auto} &short_match = result[2];\par
00878     {\cf17 const} {\cf17 auto} &long_match = result[3];\par
00879 \par
00880     {\cf19 if} (!short_match.length() && !long_match.length()) \{\par
00881         {\cf19 throw} invalid_option_format_error(opts);\par
00882     \} {\cf19 else} {\cf19 if} (long_match.length() == 1 && short_match.length()) \{\par
00883         {\cf19 throw} invalid_option_format_error(opts);\par
00884     \}\par
00885 \par
