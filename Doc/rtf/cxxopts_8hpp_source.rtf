00887         {\cf19 if} (long_.length() == 1) \{\par
00888             {\cf19 return} std::make_tuple(long_.str(), short_.str());\par
00889         \} {\cf19 else} \{\par
00890             {\cf19 return} std::make_tuple(short_.str(), long_.str());\par
00891         \}\par
00892     \}(short_match, long_match);\par
00893 \par
00894     m_options.add_option(m_group, std::get<0>(option_names), std::get<1>(option_names), desc, value, std::move(arg_help));\par
00895 \par
00896     {\cf19 return} *{\cf17 this};\par
00897 \}\par
