00979 {\cf17 inline} {\cf18 void} ParseResult::parse({\cf18 int} &argc, {\cf18 char} **&argv) \{\par
00980     {\cf18 int} current = 1;\par
00981 \par
00982     {\cf18 int} nextKeep = 1;\par
00983 \par
00984     {\cf18 bool} consume_remaining = {\cf17 false};\par
00985 \par
00986     {\cf19 while} (current != argc) \{\par
00987         {\cf19 if} (strcmp(argv[current], {\cf22 "--"}) == 0) \{\par
00988             consume_remaining = {\cf17 true};\par
00989             ++current;\par
00990             {\cf19 break};\par
00991         \}\par
00992 \par
00993         std::match_results<const char *> result;\par
00994         std::regex_match(argv[current], result, option_matcher);\par
00995 \par
00996         {\cf19 if} (result.empty()) \{\par
00997             {\cf20 // not a flag}\par
00998 \par
00999             {\cf20 // if true is returned here then it was consumed, otherwise it is}\par
01000             {\cf20 // ignored}\par
01001             {\cf19 if} (consume_positional(argv[current])) \{\par
01002             \} {\cf19 else} \{\par
01003                 argv[nextKeep] = argv[current];\par
01004                 ++nextKeep;\par
01005             \}\par
01006             {\cf20 // if we return from here then it was parsed successfully, so continue}\par
01007         \} {\cf19 else} \{\par
01008             {\cf20 // short or long option?}\par
01009             {\cf19 if} (result[4].length() != 0) \{\par
01010                 {\cf17 const} std::string &s = result[4];\par
01011 \par
01012                 {\cf19 for} (std::size_t i = 0; i != s.size(); ++i) \{\par
01013                     std::string name(1, s[i]);\par
01014                     {\cf17 auto} iter = m_options.find(name);\par
01015 \par
01016                     {\cf19 if} (iter == m_options.end()) \{\par
01017                         {\cf19 if} (m_allow_unrecognised) \{\par
01018                             {\cf19 continue};\par
01019                         \} {\cf19 else} \{\par
01020                             {\cf20 // error}\par
01021                             {\cf19 throw} option_not_exists_exception(name);\par
01022                         \}\par
01023                     \}\par
01024 \par
01025                     {\cf17 auto} value = iter->second;\par
01026 \par
01027                     {\cf19 if} (i + 1 == s.size()) \{\par
01028                         {\cf20 // it must be the last argument}\par
01029                         checked_parse_arg(argc, argv, current, value, name);\par
01030                     \} {\cf19 else} {\cf19 if} (value->value().has_implicit()) \{\par
01031                         parse_option(value, name, value->value().get_implicit_value());\par
01032                     \} {\cf19 else} \{\par
01033                         {\cf20 // error}\par
01034                         {\cf19 throw} option_requires_argument_exception(name);\par
01035                     \}\par
01036                 \}\par
01037             \} {\cf19 else} {\cf19 if} (result[1].length() != 0) \{\par
01038                 {\cf17 const} std::string &name = result[1];\par
01039 \par
01040                 {\cf17 auto} iter = m_options.find(name);\par
01041 \par
01042                 {\cf19 if} (iter == m_options.end()) \{\par
01043                     {\cf19 if} (m_allow_unrecognised) \{\par
01044                         {\cf20 // keep unrecognised options in argument list, skip to next argument}\par
01045                         argv[nextKeep] = argv[current];\par
01046                         ++nextKeep;\par
01047                         ++current;\par
01048                         {\cf19 continue};\par
01049                     \} {\cf19 else} \{\par
01050                         {\cf20 // error}\par
01051                         {\cf19 throw} option_not_exists_exception(name);\par
01052                     \}\par
01053                 \}\par
01054 \par
01055                 {\cf17 auto} opt = iter->second;\par
01056 \par
01057                 {\cf20 // equals provided for long option?}\par
01058                 {\cf19 if} (result[2].length() != 0) \{\par
01059                     {\cf20 // parse the option given}\par
01060 \par
01061                     parse_option(opt, name, result[3]);\par
01062                 \} {\cf19 else} \{\par
01063                     {\cf20 // parse the next argument}\par
01064                     checked_parse_arg(argc, argv, current, opt, name);\par
01065                 \}\par
01066             \}\par
01067         \}\par
01068 \par
01069         ++current;\par
01070     \}\par
01071 \par
01072     {\cf19 for} ({\cf17 auto} &opt : m_options) \{\par
01073         {\cf17 auto} &detail = opt.second;\par
01074         {\cf17 auto} &value = detail->value();\par
01075 \par
01076         {\cf17 auto} &store = m_results[detail];\par
01077 \par
01078         {\cf19 if} (!store.count() && value.has_default()) \{\par
01079             parse_default(detail);\par
01080         \}\par
01081     \}\par
01082 \par
01083     {\cf19 if} (consume_remaining) \{\par
01084         {\cf19 while} (current < argc) \{\par
01085             {\cf19 if} (!consume_positional(argv[current])) \{\par
01086                 {\cf19 break};\par
01087             \}\par
01088             ++current;\par
01089         \}\par
01090 \par
01091         {\cf20 // adjust argv for any that couldn't be swallowed}\par
01092         {\cf19 while} (current != argc) \{\par
01093             argv[nextKeep] = argv[current];\par
01094             ++nextKeep;\par
01095             ++current;\par
01096         \}\par
01097     \}\par
01098 \par
01099     argc = nextKeep;\par
01100 \}\par
