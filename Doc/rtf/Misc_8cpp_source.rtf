00063 {\cf20 // Get directory part of current executable path - optionally add a filename}\par
00064 {\cf20 //}\par
00065 {\cf21 #if defined(_WIN32)}\par
00066 std::string get_program() \{\par
00067 \par
00068     {\cf20 // Get execuable name}\par
00069     {\cf20 //}\par
00070     {\cf18 char} tmp[MAX_PATH];\par
00071     {\cf18 int} s = GetModuleFileNameA(NULL, tmp, {\cf17 sizeof}(tmp));\par
00072 \par
00073     {\cf19 return} tmp;\par
00074 \}\par
00075 \par
00076 std::string get_program_directory({\cf17 const} std::string &suffix) \{\par
00077 \par
00078     {\cf20 // Get execuable name}\par
00079     {\cf20 //}\par
00080     {\cf18 char} tmp[MAX_PATH];\par
00081     {\cf18 int} s = GetModuleFileNameA(NULL, tmp, {\cf17 sizeof}(tmp));\par
00082 \par
00083     {\cf20 // Trim away filename}\par
00084     {\cf19 while} (s > 0 && tmp[s - 1] != {\cf23 '\\\\'} && tmp[s - 1] != {\cf23 '/'} && tmp[s - 1] != {\cf23 ':'})\par
00085         s--;\par
00086     tmp[s] = {\cf23 '\\0'};\par
00087 \par
00088     {\cf19 return} tmp + suffix;\par
00089 \}\par
00090 {\cf21 #else}\par
00091 std::string get_program() \{\par
00092     {\cf18 char} tmp[PATH_MAX] = {\cf22 ""};\par
00093 \par
00094     {\cf20 // Use /proc & readlink() to get real executable path}\par
00095     {\cf18 char} link[PATH_MAX];\par
00096     sprintf(link, {\cf22 "/proc/%d/exe"}, getpid());\par
00097     {\cf18 int} s = readlink(link, tmp, {\cf17 sizeof}(tmp));\par
00098 \par
00099     {\cf19 return} tmp;\par
00100 \}\par
00101 \par
00102 std::string get_program_directory({\cf17 const} std::string &suffix) \{\par
00103     {\cf18 char} tmp[PATH_MAX] = {\cf22 ""};\par
00104 \par
00105     {\cf20 // Use /proc & readlink() to get real executable path}\par
00106     {\cf18 char} link[PATH_MAX];\par
00107     sprintf(link, {\cf22 "/proc/%d/exe"}, getpid());\par
00108     {\cf18 int} s = readlink(link, tmp, {\cf17 sizeof}(tmp));\par
00109 \par
00110     {\cf20 // Trim away filename}\par
00111     {\cf19 while} (s > 0 && tmp[s - 1] != {\cf23 '/'})\par
00112         s--;\par
00113     tmp[s] = {\cf23 '\\0'};\par
00114 \par
00115     {\cf19 return} tmp + suffix;\par
00116 \}\par
