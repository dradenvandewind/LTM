00236     {\cf19 if} (p == std::string::npos || filename[p] != {\cf23 '.'})\par
00237         {\cf19 return} {\cf22 ""};\par
00238 \par
00239     {\cf19 return} filename.substr(p + 1);\par
00240 \}\par
