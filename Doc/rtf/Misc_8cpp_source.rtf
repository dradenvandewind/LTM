00135 {\cf18 size_t} file_size({\cf17 const} std::string &name) \{\par
00136     {\cf20 // VS2017 function stat}\par
00137 {\cf21 #if defined _WIN32}\par
00138     {\cf17 struct }_stat64 stat_buf = \{0\};\par
00139     {\cf18 int} ret = _stat64(name.c_str(), &stat_buf);\par
00140     {\cf19 if} (ret < 0)\par
00141         {\cf19 return} -1;\par
00142 {\cf21 #else}\par
00143     {\cf17 struct }stat stat_buf = \{0\};\par
00144     {\cf19 if} (stat(name.c_str(), &stat_buf) < 0)\par
00145         {\cf19 return} -1;\par
00146 {\cf21 #endif}\par
00147 \par
00148     {\cf19 return} stat_buf.st_size;\par
