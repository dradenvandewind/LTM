00357 {\cf20 // Return a system-wide timstamp for debugging packet timing (in uSecs)}\par
00358 {\cf20 //}\par
00359 uint64_t system_timestamp() \{\par
00360     {\cf17 static} {\cf17 auto} start = std::chrono::system_clock().now();\par
00361     {\cf17 auto} d = std::chrono::system_clock().now() - start;\par
00362     {\cf19 return} std::chrono::duration_cast<std::chrono::microseconds>(d).count();\par
00363 \}\par
