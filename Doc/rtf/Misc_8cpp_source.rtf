00191 {\cf18 unsigned} split(std::vector<std::string> &output, {\cf17 const} std::string &src, {\cf17 const} {\cf18 char} *seperators) \{\par
00192     {\cf18 bool} in_token = {\cf17 false};\par
00193 \par
00194     std::string s;\par
00195 \par
00196     {\cf19 for} ({\cf17 const} {\cf17 auto} c : src) \{\par
00197         {\cf19 if} (strchr(seperators, c)) \{\par
00198             {\cf19 if} (in_token) \{\par
00199                 {\cf20 // End of token - push accumulated string to output}\par
00200                 output.push_back(s);\par
00201                 in_token = {\cf17 false};\par
00202             \} {\cf19 else} \{\par
00203                 {\cf20 // In seperators - do nothing}\par
00204             \}\par
00205         \} {\cf19 else} \{\par
00206             {\cf19 if} (in_token) \{\par
00207                 {\cf20 // Still in token - accumulate}\par
00208                 s.push_back(c);\par
00209             \} {\cf19 else} \{\par
00210                 {\cf20 // Start of token - start new string}\par
00211                 s.clear();\par
00212                 s.push_back(c);\par
00213                 in_token = {\cf17 true};\par
00214             \}\par
00215         \}\par
00216     \}\par
00217 \par
00218     {\cf20 // Add any unfinished token}\par
00219     {\cf19 if} (!s.empty())\par
00220         output.push_back(s);\par
00221 \par
00222     {\cf19 return} ({\cf18 unsigned})output.size();\par
00223 \}\par
