00151 std::string read_file({\cf17 const} std::string &name) \{\par
00152     {\cf17 struct }stat stat_buf = \{0\};\par
00153 \par
00154     {\cf19 if} (stat(name.c_str(), &stat_buf) < 0)\par
00155         {\cf19 return} {\cf22 ""};\par
00156 \par
00157     UniquePtrFile f(fopen(name.c_str(), {\cf22 "rb"}));\par
00158 \par
00159     {\cf19 if} (!f)\par
00160         {\cf19 return} {\cf22 ""};\par
00161 \par
00162     std::vector<char> tmp(stat_buf.st_size + 1);\par
00163 \par
00164     {\cf19 if} (fread(tmp.data(), 1, stat_buf.st_size, f.get()) != stat_buf.st_size)\par
00165         {\cf19 return} {\cf22 ""};\par
00166 \par
00167     tmp[stat_buf.st_size] = {\cf23 '\\0'};\par
00168     {\cf19 return} std::string(tmp.begin(), tmp.end());\par
