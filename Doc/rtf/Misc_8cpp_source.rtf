00119 {\cf18 size_t} file_size({\cf18 int} fd) \{\par
00120     {\cf20 // VS2017 function stat}\par
00121 {\cf21 #if defined _WIN32}\par
00122     {\cf17 struct }_stat64 stat_buf = \{0\};\par
00123     {\cf18 int} ret = _fstat64(fd, &stat_buf);\par
00124     {\cf19 if} (ret < 0)\par
00125         {\cf19 return} -1;\par
00126 {\cf21 #else}\par
00127     {\cf17 struct }stat stat_buf = \{0\};\par
00128     {\cf19 if} (fstat(fd, &stat_buf) < 0)\par
00129         {\cf19 return} -1;\par
00130 {\cf21 #endif}\par
00131 \par
00132     {\cf19 return} stat_buf.st_size;\par
00133 \}\par
