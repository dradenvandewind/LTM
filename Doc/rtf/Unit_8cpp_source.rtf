00380 {\cf17 const} {\cf18 bool} CodingUnit::checkCCLMAllowed(){\cf17  const}\par
00381 {\cf17 }\{\par
00382   {\cf18 bool} allowCCLM = {\cf17 false};\par
00383 \par
00384   {\cf19 if}( !CS::isDualITree( *cs ) ) {\cf20 //single tree I slice or non-I slice (Note: judging chType is no longer equivalent to checking dual-tree I slice since the local dual-tree is introduced)}\par
00385   \{\par
00386     allowCCLM = {\cf17 true};\par
00387   \}\par
00388   {\cf19 else} {\cf19 if}( slice->getSPS()->getCTUSize() <= 32 ) {\cf20 //dual tree, CTUsize < 64}\par
00389   \{\par
00390     allowCCLM = {\cf17 true};\par
00391   \}\par
00392   {\cf19 else} {\cf20 //dual tree, CTU size 64 or 128}\par
00393   \{\par
00394     {\cf18 int} depthFor64x64Node = slice->getSPS()->getCTUSize() == 128 ? 1 : 0;\par
00395     {\cf17 const} PartSplit cuSplitTypeDepth1 = CU::getSplitAtDepth( *{\cf17 this}, depthFor64x64Node );\par
00396     {\cf17 const} PartSplit cuSplitTypeDepth2 = CU::getSplitAtDepth( *{\cf17 this}, depthFor64x64Node + 1 );\par
00397 \par
00398     {\cf20 //allow CCLM if 64x64 chroma tree node uses QT split or HBT+VBT split combination}\par
00399     {\cf19 if}( cuSplitTypeDepth1 == CU_QUAD_SPLIT || (cuSplitTypeDepth1 == CU_HORZ_SPLIT && cuSplitTypeDepth2 == CU_VERT_SPLIT) )\par
00400     \{\par
00401       {\cf19 if}( chromaFormat == CHROMA_420 )\par
00402       \{\par
00403         CHECK( !(blocks[COMPONENT_Cb].width <= 16 && blocks[COMPONENT_Cb].height <= 16), {\cf22 "chroma cu size shall be <= 16x16 for YUV420 format"} );\par
00404       \}\par
00405       allowCCLM = {\cf17 true};\par
00406     \}\par
00407     {\cf20 //allow CCLM if 64x64 chroma tree node uses NS (No Split) and becomes a chroma CU containing 32x32 chroma blocks}\par
00408     {\cf19 else} {\cf19 if}( cuSplitTypeDepth1 == CU_DONT_SPLIT )\par
00409     \{\par
00410       {\cf19 if}( chromaFormat == CHROMA_420 )\par
00411       \{\par
00412         CHECK( !(blocks[COMPONENT_Cb].width == 32 && blocks[COMPONENT_Cb].height == 32), {\cf22 "chroma cu size shall be 32x32 for YUV420 format"} );\par
00413       \}\par
00414       allowCCLM = {\cf17 true};\par
00415     \}\par
00416     {\cf20 //allow CCLM if 64x32 chroma tree node uses NS and becomes a chroma CU containing 32x16 chroma blocks}\par
00417     {\cf19 else} {\cf19 if}( cuSplitTypeDepth1 == CU_HORZ_SPLIT && cuSplitTypeDepth2 == CU_DONT_SPLIT )\par
00418     \{\par
00419       {\cf19 if}( chromaFormat == CHROMA_420 )\par
00420       \{\par
00421         CHECK( !(blocks[COMPONENT_Cb].width == 32 && blocks[COMPONENT_Cb].height == 16), {\cf22 "chroma cu size shall be 32x16 for YUV420 format"} );\par
00422       \}\par
00423       allowCCLM = {\cf17 true};\par
00424     \}\par
00425 \par
00426     {\cf20 //further check luma conditions}\par
00427     {\cf19 if}( allowCCLM )\par
00428     \{\par
00429       {\cf20 //disallow CCLM if luma 64x64 block uses BT or TT or NS with ISP}\par
00430       {\cf17 const} Position lumaRefPos( chromaPos().x << getComponentScaleX( COMPONENT_Cb, chromaFormat ), chromaPos().y << getComponentScaleY( COMPONENT_Cb, chromaFormat ) );\par
00431       {\cf17 const} CodingUnit* colLumaCu = cs->picture->cs->getCU( lumaRefPos, CHANNEL_TYPE_LUMA );\par
00432 \par
00433       {\cf19 if}( colLumaCu->lwidth() < 64 || colLumaCu->lheight() < 64 ) {\cf20 //further split at 64x64 luma node}\par
00434       \{\par
00435         {\cf17 const} PartSplit cuSplitTypeDepth1Luma = CU::getSplitAtDepth( *colLumaCu, depthFor64x64Node );\par
00436         CHECK( !(cuSplitTypeDepth1Luma >= CU_QUAD_SPLIT && cuSplitTypeDepth1Luma <= CU_TRIV_SPLIT), {\cf22 "split mode shall be BT, TT or QT"} );\par
00437         {\cf19 if}( cuSplitTypeDepth1Luma != CU_QUAD_SPLIT )\par
00438         \{\par
00439           allowCCLM = {\cf17 false};\par
00440         \}\par
00441       \}\par
00442       {\cf19 else} {\cf19 if}( colLumaCu->lwidth() == 64 && colLumaCu->lheight() == 64 && colLumaCu->ispMode ) {\cf20 //not split at 64x64 luma node and use ISP mode}\par
00443       \{\par
00444         allowCCLM = {\cf17 false};\par
00445       \}\par
00446     \}\par
00447   \}\par
00448 \par
00449   {\cf19 return} allowCCLM;\par
00450 \}\par
00451 \par
00452 {\cf17 const} uint8_t CodingUnit::checkAllowedSbt(){\cf17  const}\par
00453 {\cf17 }\{\par
00454   {\cf19 if}( !slice->getSPS()->getUseSBT() )\par
00455   \{\par
00456     {\cf19 return} 0;\par
00457   \}\par
00458 \par
00459   {\cf20 //check on prediction mode}\par
00460   {\cf19 if} (predMode == MODE_INTRA || predMode == MODE_IBC || predMode == MODE_PLT ) {\cf20 //intra, palette or IBC}\par
00461   \{\par
00462     {\cf19 return} 0;\par
00463   \}\par
00464   {\cf19 if}( firstPU->ciipFlag )\par
00465   \{\par
00466     {\cf19 return} 0;\par
00467   \}\par
00468 \par
00469   uint8_t sbtAllowed = 0;\par
00470   {\cf18 int} cuWidth  = lwidth();\par
00471   {\cf18 int} cuHeight = lheight();\par
00472   {\cf18 bool} allow_type[NUMBER_SBT_IDX];\par
00473   memset( allow_type, {\cf17 false}, NUMBER_SBT_IDX * {\cf17 sizeof}( {\cf18 bool} ) );\par
00474 \par
00475   {\cf20 //parameter}\par
00476   {\cf18 int} maxSbtCUSize = cs->sps->getMaxTbSize();\par
00477   {\cf18 int} minSbtCUSize = 1 << ( MIN_CU_LOG2 + 1 );\par
00478 \par
00479   {\cf20 //check on size}\par
00480   {\cf19 if}( cuWidth > maxSbtCUSize || cuHeight > maxSbtCUSize )\par
00481   \{\par
00482     {\cf19 return} 0;\par
00483   \}\par
00484 \par
00485   allow_type[SBT_VER_HALF] = cuWidth  >= minSbtCUSize;\par
00486   allow_type[SBT_HOR_HALF] = cuHeight >= minSbtCUSize;\par
00487   allow_type[SBT_VER_QUAD] = cuWidth  >= ( minSbtCUSize << 1 );\par
00488   allow_type[SBT_HOR_QUAD] = cuHeight >= ( minSbtCUSize << 1 );\par
00489 \par
00490   {\cf19 for}( {\cf18 int} i = 0; i < NUMBER_SBT_IDX; i++ )\par
00491   \{\par
00492     sbtAllowed += (uint8_t)allow_type[i] << i;\par
00493   \}\par
00494 \par
00495   {\cf19 return} sbtAllowed;\par
00496 \}\par
00497 \par
00498 uint8_t CodingUnit::getSbtTuSplit(){\cf17  const}\par
00499 {\cf17 }\{\par
00500   uint8_t sbtTuSplitType = 0;\par
00501 \par
00502   {\cf19 switch}( getSbtIdx() )\par
00503   \{\par
00504   {\cf19 case} SBT_VER_HALF: sbtTuSplitType = ( getSbtPos() == SBT_POS0 ? 0 : 1 ) + SBT_VER_HALF_POS0_SPLIT; {\cf19 break};\par
00505   {\cf19 case} SBT_HOR_HALF: sbtTuSplitType = ( getSbtPos() == SBT_POS0 ? 0 : 1 ) + SBT_HOR_HALF_POS0_SPLIT; {\cf19 break};\par
00506   {\cf19 case} SBT_VER_QUAD: sbtTuSplitType = ( getSbtPos() == SBT_POS0 ? 0 : 1 ) + SBT_VER_QUAD_POS0_SPLIT; {\cf19 break};\par
00507   {\cf19 case} SBT_HOR_QUAD: sbtTuSplitType = ( getSbtPos() == SBT_POS0 ? 0 : 1 ) + SBT_HOR_QUAD_POS0_SPLIT; {\cf19 break};\par
00508   {\cf19 default}: assert( 0 );  {\cf19 break};\par
00509   \}\par
00510 \par
00511   assert( sbtTuSplitType <= SBT_HOR_QUAD_POS1_SPLIT && sbtTuSplitType >= SBT_VER_HALF_POS0_SPLIT );\par
00512   {\cf19 return} sbtTuSplitType;\par
00513 \}\par
