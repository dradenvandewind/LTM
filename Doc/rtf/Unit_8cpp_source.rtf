00777     {\cf19 if} (m_pcmbuf[i] && other.m_pcmbuf[i] && m_pcmbuf[i] != other.m_pcmbuf[i]) memcpy(m_pcmbuf[i], other.m_pcmbuf[i], {\cf17 sizeof}(Pel   ) * area);\par
