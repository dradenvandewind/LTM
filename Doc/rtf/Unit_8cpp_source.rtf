00142 UnitArea::UnitArea({\cf17 const} ChromaFormat _chromaFormat, {\cf17 const} Area &_area) : chromaFormat(_chromaFormat), blocks(getNumberValidComponents(_chromaFormat))\par
00143 \{\par
00144   {\cf17 const} uint32_t numCh = getNumberValidComponents(chromaFormat);\par
