00160 {\cf18 bool} UnitArea::contains({\cf17 const} UnitArea& other){\cf17  const}\par
00161 {\cf17 }\{\par
00162   {\cf18 bool} ret = {\cf17 true};\par
00163   {\cf18 bool} any = {\cf17 false};\par
00164 \par
00165   {\cf19 for}( {\cf17 const} {\cf17 auto} &blk : other.blocks )\par
00166   \{\par
