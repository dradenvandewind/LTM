00101 {\cf18 bool} BaseDecoderEVC::ParseNalUnit({\cf17 const} uint8_t *nal, uint32_t nalLength) \{\par
00102     {\cf18 bool} bSuccess = {\cf17 true};\par
00103 \par
00104     uint32_t offset = 0;\par
00105 \par
00106     {\cf20 // [forbidden-zero:1, nal_type:6, layer_id_top:1]}\par
00107     m_nal_type = ((nal[offset] >> 1) & 0x3F) - 1;\par
00108     {\cf20 // [layer_id:5, temporal_id_plus1:3]}\par
00109     m_temporal_id = nal[offset + 1] >> 5;\par
00110 \par
00111     offset += 2;\par
00112 \par
00113     BaseDecNalUnitType::Enum nalType = uFromEVC(m_nal_type);\par
00114 \par
00115     nal += offset;\par
00116     nalLength -= offset;\par
00117 \par
00118     m_currentNalPayload.clear();\par
00119     m_currentNalPayload.insert(m_currentNalPayload.end(), nal, nal + nalLength);\par
00120 \par
00121     m_currentBits = *m_currentNalPayload.data();\par
00122     m_remainingBits = 8;\par
00123     m_byteOffset = 0;\par
00124 \par
00125     {\cf19 switch} (nalType) \{\par
00126     {\cf19 case} BaseDecNalUnitType::VPS:\par
00127         bSuccess = ParseVPS();\par
00128         {\cf19 break};\par
00129     {\cf19 case} BaseDecNalUnitType::PPS:\par
00130         bSuccess = ParsePPS();\par
00131         {\cf19 break};\par
00132     {\cf19 case} BaseDecNalUnitType::SPS:\par
00133         bSuccess = ParseSPS();\par
00134         {\cf19 break};\par
00135     {\cf19 case} BaseDecNalUnitType::Slice:\par
00136         {\cf19 if} ((bSuccess = ParseSliceHeader(m_nal_type))) \{\par
00137             HandlePictureOrderCount(m_nal_type, m_temporal_id);\par
00138         \}\par
00139         {\cf19 break};\par
00140     {\cf19 case} BaseDecNalUnitType::EOS:\par
00141         {\cf19 break};\par
00142     {\cf19 default}:\par
00143         {\cf19 break};\par
00144     \}\par
00145 \par
00146     {\cf19 return} bSuccess;\par
00147 \}\par
00148 \par
00149 BaseDecPictType::Enum BaseDecoderEVC::GetBasePictureType(){\cf17  const }\{\par
00150     {\cf19 switch} (m_slice_header.slice_type) \{\par
