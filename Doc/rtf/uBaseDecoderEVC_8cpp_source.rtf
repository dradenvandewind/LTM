00232 {\cf18 void} BaseDecoderEVC::HandlePictureOrderCount(uint32_t nal_unit_type, uint32_t nuh_temporal_id) \{\par
00233 \par
00234     {\cf19 if} (!m_sps->tool_pocs) \{\par
00235         CHECK(0); {\cf20 // XXX Not handled}\par
00236     \} {\cf19 else} \{\par
00237         {\cf19 if} (nal_unit_type == EVCNalType::IDR_NUT) \{\par
00238             m_slice_header.poc_lsb = 0;\par
00239             m_poc_val = 0;\par
00240         \} {\cf19 else} \{\par
00241             {\cf18 int} poc_msb, poc_lsb, max_poc_lsb, prev_poc_lsb, prev_poc_msb;\par
00242 \par
00243             poc_lsb = m_slice_header.poc_lsb;\par
00244             max_poc_lsb = 1 << (m_sps->log2_max_pic_order_cnt_lsb);\par
00245             prev_poc_lsb = m_prev_poc_val & (max_poc_lsb - 1);\par
00246             prev_poc_msb = m_prev_poc_val - prev_poc_lsb;\par
00247             {\cf19 if} ((poc_lsb < prev_poc_lsb) && ((prev_poc_lsb - poc_lsb) >= (max_poc_lsb / 2)))\par
00248                 poc_msb = prev_poc_msb + max_poc_lsb;\par
00249             {\cf19 else} {\cf19 if} ((poc_lsb > prev_poc_lsb) && ((poc_lsb - prev_poc_lsb) > (max_poc_lsb / 2)))\par
00250                 poc_msb = prev_poc_msb - max_poc_lsb;\par
00251             {\cf19 else}\par
00252                 poc_msb = prev_poc_msb;\par
00253 \par
00254             m_poc_val = poc_msb + poc_lsb;\par
00255 \par
00256             {\cf19 if} (nuh_temporal_id == 0)\par
00257                 m_prev_poc_val = m_poc_val;\par
00258         \}\par
00259     \}\par
00260 \}\par
