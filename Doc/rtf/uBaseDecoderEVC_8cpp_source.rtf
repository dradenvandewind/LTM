00417 {\cf18 bool} BaseDecoderEVC::ParseSliceHeader(uint32_t nal_unit_type) \{\par
00418 \par
00419     m_slice_header.pic_parameter_set_id = ReadUE();\par
00420 \par
00421     m_slice_header.pps = &m_pps_set[m_slice_header.pic_parameter_set_id];\par
00422     m_slice_header.sps = &m_sps_set[m_slice_header.pps->seq_parameter_set_id];\par
00423 \par
00424     PPS *pps = m_slice_header.pps;\par
00425     SPS *sps = m_slice_header.sps;\par
00426     SliceHeader *sh = &m_slice_header;\par
00427 \par
00428     uint32_t num_tiles_in_slice = 0;\par
00429 \par
00430     {\cf19 if} (!pps->single_tile_in_pic_flag) \{\par
00431         sh->single_tile_in_slice_flag = ReadFlag();\par
00432         sh->first_tile_id = ReadBits(pps->tile_id_len);\par
00433     \} {\cf19 else} \{\par
00434         sh->single_tile_in_slice_flag = 1;\par
00435     \}\par
00436 \par
00437     {\cf19 if} (!sh->single_tile_in_slice_flag) \{\par
00438         {\cf19 if} (pps->arbitrary_slice_present_flag) \{\par
00439             sh->arbitrary_slice_flag = ReadFlag();\par
00440         \}\par
00441         {\cf19 if} (!sh->arbitrary_slice_flag) \{\par
00442             sh->last_tile_id = ReadBits(pps->tile_id_len);\par
00443         \} {\cf19 else} \{\par
00444             sh->num_remaining_tiles_in_slice = ReadUE() + 1;\par
00445             num_tiles_in_slice = sh->num_remaining_tiles_in_slice + 1;\par
00446             {\cf19 for} ({\cf18 unsigned} i = 0; i < num_tiles_in_slice - 1; ++i) \{\par
00447                 sh->delta_tile_id[i] = ReadUE() + 1;\par
00448             \}\par
00449         \}\par
00450     \}\par
00451 \par
00452     sh->slice_type = ReadUE();\par
00453 \par
00454     {\cf19 if} (!sh->arbitrary_slice_flag) \{\par
00455         {\cf18 int} first_row_slice, w_tile_slice, first_col_slice, h_tile_slice, w_tile;\par
00456         w_tile = pps->num_tile_columns;\par
00457         first_row_slice = sh->first_tile_id / w_tile;\par
00458         first_col_slice = sh->first_tile_id % w_tile;\par
00459         w_tile_slice = (sh->last_tile_id % w_tile) - first_col_slice;\par
00460         h_tile_slice = (sh->last_tile_id / w_tile) - first_row_slice;\par
00461         num_tiles_in_slice = (w_tile_slice + 1) * (h_tile_slice + 1);\par
00462     \} {\cf19 else} \{\par
00463         num_tiles_in_slice = sh->num_remaining_tiles_in_slice + 1;\par
00464     \}\par
00465 \par
00466     {\cf19 if} (nal_unit_type == EVCNalType::IDR_NUT) \{\par
00467         sh->no_output_of_prior_pics_flag = ReadFlag();\par
00468     \}\par
00469 \par
00470     {\cf19 if} (sps->tool_mmvd && ((sh->slice_type == SLICE_B) || (sh->slice_type == SLICE_P))) \{\par
00471         sh->mmvd_group_enable_flag = ReadFlag();\par
00472     \} {\cf19 else} \{\par
00473         sh->mmvd_group_enable_flag = 0;\par
00474     \}\par
00475 \par
00476     {\cf19 if} (sps->tool_alf) \{\par
00477         sh->alfChromaIdc = 0;\par
00478         sh->alf_sh_param_enabledFlag[0] = 0;\par
00479         sh->alf_sh_param_enabledFlag[1] = 0;\par
00480         sh->alf_sh_param_enabledFlag[2] = 0;\par
00481 \par
00482         sh->alf_on = ReadFlag();\par
00483         sh->alf_sh_param_enabledFlag[0] = sh->alf_on;\par
00484         {\cf19 if} (sh->alf_on) \{\par
00485             sh->aps_id_y = ReadBits(5);\par
00486 \par
00487             {\cf18 bool} isCtbAlfOn = ReadFlag();\par
00488 \par
00489             sh->alfChromaIdc = ReadBits(2);\par
00490             sh->alf_sh_param_enabledFlag[1] = sh->alfChromaIdc & 1;\par
00491             sh->alf_sh_param_enabledFlag[2] = (sh->alfChromaIdc >> 1) & 1;\par
00492             {\cf19 if} (sh->alfChromaIdc == 1) \{\par
00493                 sh->ChromaAlfEnabledFlag = 1;\par
00494                 sh->ChromaAlfEnabled2Flag = 0;\par
00495             \} {\cf19 else} {\cf19 if} (sh->alfChromaIdc == 2) \{\par
00496                 sh->ChromaAlfEnabledFlag = 0;\par
00497                 sh->ChromaAlfEnabled2Flag = 1;\par
00498             \} {\cf19 else} {\cf19 if} (sh->alfChromaIdc == 3) \{\par
00499                 sh->ChromaAlfEnabledFlag = 1;\par
00500                 sh->ChromaAlfEnabled2Flag = 1;\par
00501             \} {\cf19 else} \{\par
00502                 sh->ChromaAlfEnabledFlag = 0;\par
00503                 sh->ChromaAlfEnabled2Flag = 0;\par
00504             \}\par
00505             {\cf19 if} (sh->alfChromaIdc && (sps->chroma_format_idc == 1 || sps->chroma_format_idc == 2)) \{\par
00506                 sh->aps_id_ch = ReadBits(5);\par
00507             \}\par
00508         \}\par
00509         {\cf19 if} (sps->chroma_format_idc == 3 && sh->ChromaAlfEnabledFlag) \{\par
00510             sh->aps_id_ch = ReadBits(5);\par
00511             sh->alfChromaMapSignalled = ReadFlag();\par
00512         \}\par
00513         {\cf19 if} (sps->chroma_format_idc == 3 && sh->ChromaAlfEnabled2Flag) \{\par
00514             sh->aps_id_ch2 = ReadBits(5);\par
00515             sh->alfChroma2MapSignalled = ReadFlag();\par
00516         \}\par
00517     \}\par
00518 \par
00519     {\cf19 if} (nal_unit_type != EVCNalType::IDR_NUT) \{\par
00520         {\cf19 if} (sps->tool_pocs) \{\par
00521             sh->poc_lsb = ReadBits(sps->log2_max_pic_order_cnt_lsb);\par
00522         \}\par
00523     \}\par
00524 \par
00525     {\cf19 return} {\cf17 true};\par
00526 \}\par
