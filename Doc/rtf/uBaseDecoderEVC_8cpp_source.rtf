00072 {\cf21 #if defined(EVC_FDIS)}\par
00073     {\cf19 case} EVCNalType::FD_NUT:\par
00074         {\cf19 return} BaseDecNalUnitType::Filler;\par
00075 {\cf21 #endif}\par
00076     {\cf19 case} EVCNalType::SEI_NUT:\par
00077         {\cf19 return} BaseDecNalUnitType::SEI;\par
00078     \}\par
00079 \par
