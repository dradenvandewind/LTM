00152         {\cf19 return} BaseDecPictType::P;\par
00153     {\cf19 case} SLICE_B:\par
00154         {\cf19 return} BaseDecPictType::B;\par
00155     {\cf19 case} SLICE_I:\par
00156         {\cf19 return} BaseDecPictType::I;\par
