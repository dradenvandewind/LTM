00153   uint32_t uiCode = 0;\par
00154   uint32_t uiLength;\par
00155   m_pcBitstream->read( 1, uiCode );\par
00156 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00157   uint32_t totalLen=1;\par
00158 {\cf21 #endif}\par
00159 \par
00160   {\cf19 if}( 0 == uiCode )\par
00161   \{\par
00162     uiLength = 0;\par
00163 \par
00164     {\cf19 while}( ! ( uiCode & 1 ))\par
00165     \{\par
00166       m_pcBitstream->read( 1, uiCode );\par
00167       uiLength++;\par
00168     \}\par
00169 \par
00170     m_pcBitstream->read( uiLength, uiVal );\par
00171 \par
00172     uiVal += (1 << uiLength)-1;\par
00173 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00174     totalLen+=uiLength+uiLength;\par
00175 {\cf21 #endif}\par
00176   \}\par
00177 \par
00178   ruiVal = uiVal;\par
00179 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00180   CodingStatistics::IncrementStatisticEP(pSymbolName, {\cf18 int}(totalLen), ruiVal);\par
00181 {\cf21 #endif}\par
00182 \}\par
00183 \par
00184 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00185 {\cf18 void} VLCReader::xReadSvlc( {\cf18 int}& riVal, {\cf17 const} {\cf18 char} *pSymbolName)\par
00186 {\cf21 #else}\par
00187 {\cf18 void} VLCReader::xReadSvlc( {\cf18 int}& riVal)\par
00188 {\cf21 #endif}\par
00189 \{\par
00190   uint32_t uiBits = 0;\par
