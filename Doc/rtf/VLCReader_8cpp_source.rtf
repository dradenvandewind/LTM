05004 {\cf18 void} HLSyntaxReader::decodeScalingList(ScalingList *scalingList, uint32_t scalingListId, {\cf18 bool} isPredictor)\par
05005 \{\par
05006   {\cf18 int} matrixSize = (scalingListId < SCALING_LIST_1D_START_4x4) ? 2 : (scalingListId < SCALING_LIST_1D_START_8x8) ? 4 : 8;\par
05007   {\cf18 int} i, coefNum = matrixSize * matrixSize;\par
05008   {\cf18 int} data;\par
05009   {\cf18 int} scalingListDcCoefMinus8 = 0;\par
05010   {\cf18 int} nextCoef = (isPredictor) ? 0 : SCALING_LIST_START_VALUE;\par
05011   ScanElement *scan = g_scanOrder[SCAN_UNGROUPED][SCAN_DIAG][gp_sizeIdxInfo->idxFrom(matrixSize)][gp_sizeIdxInfo->idxFrom(matrixSize)];\par
05012   {\cf18 int} *dst = scalingList->getScalingListAddress(scalingListId);\par
05013 \par
05014   {\cf18 int} PredListId = scalingList->getRefMatrixId(scalingListId);\par
05015   CHECK(isPredictor && PredListId > scalingListId, {\cf22 "Scaling List error predictor!"});\par
05016   {\cf17 const} {\cf18 int} *srcPred = (isPredictor) ? ((scalingListId == PredListId) ? scalingList->getScalingListDefaultAddress(scalingListId) : scalingList->getScalingListAddress(PredListId)) : NULL;\par
05017   {\cf19 if}(isPredictor && scalingListId == PredListId)\par
05018     scalingList->setScalingListDC(PredListId, SCALING_LIST_DC);\par
05019   {\cf18 int} predCoef = 0;\par
05020 \par
05021   {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_16x16)\par
05022   \{\par
05023     READ_SVLC(scalingListDcCoefMinus8, {\cf22 "scaling_list_dc_coef_minus8"});\par
05024     nextCoef += scalingListDcCoefMinus8;\par
05025     {\cf19 if} (isPredictor)\par
05026     \{\par
05027       predCoef = (PredListId >= SCALING_LIST_1D_START_16x16) ? scalingList->getScalingListDC(PredListId) : srcPred[0];\par
05028     \}\par
05029     scalingList->setScalingListDC(scalingListId, (nextCoef + predCoef + 256) & 255);\par
05030   \}\par
05031 \par
05032   {\cf19 for}(i = 0; i < coefNum; i++)\par
05033   \{\par
05034     {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_64x64 && scan[i].x >= 4 && scan[i].y >= 4)\par
05035     \{\par
05036       dst[scan[i].idx] = 0;\par
05037       {\cf19 continue};\par
05038     \}\par
05039     READ_SVLC( data, {\cf22 "scaling_list_delta_coef"});\par
05040     nextCoef += data;\par
05041     predCoef = (isPredictor) ? srcPred[scan[i].idx] : 0;\par
05042     dst[scan[i].idx] = (nextCoef + predCoef + 256) & 255;\par
05043   \}\par
05044 \}\par
05045 \par
05046 {\cf18 bool} HLSyntaxReader::xMoreRbspData()\par
05047 \{\par
05048   {\cf18 int} bitsLeft = m_pcBitstream->getNumBitsLeft();\par
05049 \par
05050   {\cf20 // if there are more than 8 bits, it cannot be rbsp_trailing_bits}\par
05051   {\cf19 if} (bitsLeft > 8)\par
05052   \{\par
05053     {\cf19 return} {\cf17 true};\par
05054   \}\par
05055 \par
05056   uint8_t lastByte = m_pcBitstream->peekBits(bitsLeft);\par
05057   {\cf18 int} cnt = bitsLeft;\par
05058 \par
05059   {\cf20 // remove trailing bits equal to zero}\par
05060   {\cf19 while} ((cnt>0) && ((lastByte & 1) == 0))\par
05061   \{\par
05062     lastByte >>= 1;\par
05063     cnt--;\par
05064   \}\par
05065   {\cf20 // remove bit equal to one}\par
05066   cnt--;\par
05067 \par
05068   {\cf20 // we should not have a negative number of bits}\par
05069   CHECK (cnt<0, {\cf22 "Negative number of bits"});\par
05070 \par
05071   {\cf20 // we have more data, if cnt is not zero}\par
05072   {\cf19 return} (cnt>0);\par
05073 \}\par
