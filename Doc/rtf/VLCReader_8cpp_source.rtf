00318 {\cf18 void} HLSyntaxReader::parseRefPicList(SPS* sps, ReferencePictureList* rpl, {\cf18 int} rplIdx)\par
00319 \{\par
00320   uint32_t code;\par
00321   READ_UVLC(code, {\cf22 "num_ref_entries[ listIdx ][ rplsIdx ]"});\par
00322   uint32_t numRefPic = code;\par
00323   uint32_t numStrp = 0;\par
00324   uint32_t numLtrp = 0;\par
00325   uint32_t numIlrp = 0;\par
00326 \par
00327   {\cf19 if} (sps->getLongTermRefsPresent() && numRefPic > 0 && rplIdx != -1)\par
00328   \{\par
00329     READ_FLAG(code, {\cf22 "ltrp_in_slice_header_flag[ listIdx ][ rplsIdx ]"});\par
00330     rpl->setLtrpInSliceHeaderFlag(code);\par
00331   \}\par
00332   {\cf19 else} {\cf19 if}(sps->getLongTermRefsPresent())\par
00333   \{\par
00334     rpl->setLtrpInSliceHeaderFlag( 1 );\par
00335   \}\par
00336 \par
00337   {\cf18 bool} isLongTerm;\par
00338   {\cf18 int} prevDelta = MAX_INT;\par
00339   {\cf18 int} deltaValue = 0;\par
00340   {\cf18 bool} firstSTRP = {\cf17 true};\par
00341 \par
00342   rpl->setInterLayerPresentFlag( sps->getInterLayerPresentFlag() );\par
00343 \par
00344   {\cf19 for} ({\cf18 int} ii = 0; ii < numRefPic; ii++)\par
00345   \{\par
00346     uint32_t isInterLayerRefPic = 0;\par
00347 \par
00348     {\cf19 if}( rpl->getInterLayerPresentFlag() )\par
00349     \{\par
00350       READ_FLAG( isInterLayerRefPic, {\cf22 "inter_layer_ref_pic_flag[ listIdx ][ rplsIdx ][ i ]"} );\par
00351 \par
00352       {\cf19 if}( isInterLayerRefPic )\par
00353       \{\par
00354         READ_UVLC( code, {\cf22 "ilrp_idx[ listIdx ][ rplsIdx ][ i ]"} );\par
00355         rpl->setRefPicIdentifier( ii, 0, {\cf17 true}, {\cf17 true}, code );\par
00356         numIlrp++;\par
00357       \}\par
00358     \}\par
00359 \par
00360     {\cf19 if}( !isInterLayerRefPic )\par
00361     \{\par
00362     isLongTerm = {\cf17 false};\par
00363     {\cf19 if} (sps->getLongTermRefsPresent())\par
00364     \{\par
00365       READ_FLAG(code, {\cf22 "st_ref_pic_flag[ listIdx ][ rplsIdx ][ i ]"});\par
00366       isLongTerm = (code == 1) ? {\cf17 false} : {\cf17 true};\par
00367     \}\par
00368     {\cf19 else}\par
00369       isLongTerm = {\cf17 false};\par
00370 \par
00371     {\cf19 if} (!isLongTerm)\par
00372     \{\par
00373       READ_UVLC(code, {\cf22 "abs_delta_poc_st[ listIdx ][ rplsIdx ][ i ]"});\par
00374       {\cf19 if} ((!sps->getUseWP() && !sps->getUseWPBiPred()) || (ii == 0))\par
00375       \{\par
00376         code++;\par
00377       \}\par
00378       {\cf18 int} readValue = code;\par
00379       {\cf19 if} (readValue > 0)\par
00380       \{\par
00381         READ_FLAG(code, {\cf22 "strp_entry_sign_flag[ listIdx ][ rplsIdx ][ i ]"});\par
00382         {\cf19 if} (code)\par
00383         \{\par
00384           readValue = -readValue;\par
00385         \}\par
00386       \}\par
00387       {\cf19 if} (firstSTRP)\par
00388       \{\par
00389         firstSTRP = {\cf17 false};\par
00390         prevDelta = deltaValue = readValue;\par
00391       \}\par
00392       {\cf19 else}\par
00393       \{\par
00394         deltaValue = prevDelta + readValue;\par
00395         prevDelta = deltaValue;\par
00396       \}\par
00397 \par
00398       rpl->setRefPicIdentifier( ii, deltaValue, isLongTerm, {\cf17 false}, 0 );\par
00399       numStrp++;\par
00400     \}\par
00401     {\cf19 else}\par
00402     \{\par
00403       {\cf19 if} (!rpl->getLtrpInSliceHeaderFlag())\par
00404         READ_CODE(sps->getBitsForPOC(), code, {\cf22 "poc_lsb_lt[listIdx][rplsIdx][j]"});\par
00405       rpl->setRefPicIdentifier( ii, code, isLongTerm, {\cf17 false}, 0 );\par
00406       numLtrp++;\par
00407     \}\par
00408     \}\par
00409   \}\par
00410   rpl->setNumberOfShorttermPictures(numStrp);\par
00411   rpl->setNumberOfLongtermPictures(numLtrp);\par
00412   rpl->setNumberOfInterLayerPictures( numIlrp );\par
00413 \}\par
