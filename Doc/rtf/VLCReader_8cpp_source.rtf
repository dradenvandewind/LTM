04523     READ_FLAG(symbol, {\cf22 "gci_no_mts_constraint_flag"});                     cinfo->setNoMtsConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04524     READ_FLAG(symbol, {\cf22 "gci_no_lfnst_constraint_flag"});                   cinfo->setNoLfnstConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04525     READ_FLAG(symbol, {\cf22 "gci_no_joint_cbcr_constraint_flag"});              cinfo->setNoJointCbCrConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04526     READ_FLAG(symbol, {\cf22 "gci_no_sbt_constraint_flag"});                     cinfo->setNoSbtConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04527     READ_FLAG(symbol, {\cf22 "gci_no_act_constraint_flag"});                     cinfo->setNoActConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04528     READ_FLAG(symbol, {\cf22 "gci_no_explicit_scaling_list_constraint_flag"});   cinfo->setNoExplicitScaleListConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04529     READ_FLAG(symbol, {\cf22 "gci_no_dep_quant_constraint_flag"});               cinfo->setNoDepQuantConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04530     READ_FLAG(symbol, {\cf22 "gci_no_sign_data_hiding_constraint_flag"});        cinfo->setNoSignDataHidingConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04531     READ_FLAG(symbol, {\cf22 "gci_no_cu_qp_delta_constraint_flag"});             cinfo->setNoCuQpDeltaConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04532     READ_FLAG(symbol, {\cf22 "gci_no_chroma_qp_offset_constraint_flag"});        cinfo->setNoChromaQpOffsetConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04533 \par
04534     {\cf20 /* loop filter */}\par
04535     READ_FLAG(symbol, {\cf22 "gci_no_sao_constraint_flag"});                     cinfo->setNoSaoConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04536     READ_FLAG(symbol, {\cf22 "gci_no_alf_constraint_flag"});                     cinfo->setNoAlfConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04537     READ_FLAG(symbol, {\cf22 "gci_no_ccalf_constraint_flag"});                   cinfo->setNoCCAlfConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04538     READ_FLAG(symbol, {\cf22 "gci_no_lmcs_constraint_flag"});                    cinfo->setNoLmcsConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04539     READ_FLAG(symbol, {\cf22 "gci_no_ladf_constraint_flag"});                    cinfo->setNoLadfConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04540     READ_FLAG(symbol, {\cf22 "gci_no_virtual_boundaries_constraint_flag"});      cinfo->setNoVirtualBoundaryConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04541     READ_CODE(8, symbol, {\cf22 "gci_num_reserved_bits"});\par
04542     uint32_t {\cf17 const} numReservedBits = symbol;\par
04543     {\cf19 for} ({\cf18 int} i = 0; i < numReservedBits; i++)\par
04544     \{\par
04545       READ_FLAG(symbol, {\cf22 "gci_reserved_zero_bit"});                    CHECK(symbol != 0, {\cf22 "gci_reserved_zero_bit not equal to zero"});\par
04546     \}\par
04547   \}\par
04548   {\cf19 while} (!isByteAligned())\par
04549   \{\par
04550     READ_FLAG(symbol, {\cf22 "gci_alignment_zero_bit"});                     CHECK(symbol != 0, {\cf22 "gci_alignment_zero_bit not equal to zero"});\par
04551   \}\par
04552 \}\par
