04451 {\cf18 void} HLSyntaxReader::parseConstraintInfo(ConstraintInfo *cinfo)\par
04452 \{\par
04453   uint32_t symbol;\par
04454   READ_FLAG(symbol, {\cf22 "gci_present_flag"}); cinfo->setGciPresentFlag(symbol ? {\cf17 true} : {\cf17 false});\par
04455   {\cf19 if} (cinfo->getGciPresentFlag())\par
04456   \{\par
04457     {\cf20 /* general */}\par
04458     READ_FLAG(symbol, {\cf22 "gci_intra_only_constraint_flag"});                 cinfo->setIntraOnlyConstraintFlag(symbol ? {\cf17 true} : {\cf17 false});\par
04459     READ_FLAG(symbol, {\cf22 "gci_all_layers_independent_constraint_flag"});     cinfo->setAllLayersIndependentConstraintFlag(symbol ? {\cf17 true} : {\cf17 false});\par
04460     READ_FLAG(symbol, {\cf22 "gci_one_au_only_constraint_flag"});                cinfo->setOnePictureOnlyConstraintFlag(symbol ? {\cf17 true} : {\cf17 false}); \par
04461 \par
04462     {\cf20 /* picture format */}\par
04463     READ_CODE(4, symbol, {\cf22 "gci_sixteen_minus_max_bitdepth_constraint_idc"}); cinfo->setMaxBitDepthConstraintIdc(symbol>8 ? 16 : (16 - symbol));\par
04464     CHECK(symbol>8, {\cf22 "gci_sixteen_minus_max_bitdepth_constraint_idc shall be in the range 0 to 8, inclusive"});\par
04465     READ_CODE(2, symbol, {\cf22 "gci_three_minus_max_chroma_format_constraint_idc"}); cinfo->setMaxChromaFormatConstraintIdc((ChromaFormat)(3 - symbol));\par
04466 \par
04467     {\cf20 /* NAL unit type related */}\par
04468     READ_FLAG(symbol, {\cf22 "gci_no_mixed_nalu_types_in_pic_constraint_flag"}); cinfo->setNoMixedNaluTypesInPicConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04469     READ_FLAG(symbol, {\cf22 "gci_no_trail_constraint_flag"});                   cinfo->setNoTrailConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04470     READ_FLAG(symbol, {\cf22 "gci_no_stsa_constraint_flag"});                    cinfo->setNoStsaConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04471     READ_FLAG(symbol, {\cf22 "gci_no_rasl_constraint_flag"});                    cinfo->setNoRaslConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04472     READ_FLAG(symbol, {\cf22 "gci_no_radl_constraint_flag"});                    cinfo->setNoRadlConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04473     READ_FLAG(symbol, {\cf22 "gci_no_idr_constraint_flag"});                     cinfo->setNoIdrConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04474     READ_FLAG(symbol, {\cf22 "gci_no_cra_constraint_flag"});                     cinfo->setNoCraConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
