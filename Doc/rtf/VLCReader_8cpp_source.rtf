05076 {\cf18 void} HLSyntaxReader::alfFilter( AlfParam& alfParam, {\cf17 const} {\cf18 bool} isChroma, {\cf17 const} {\cf18 int} altIdx )\par
05077 \{\par
05078   uint32_t code;\par
05079 \par
05080   {\cf20 // derive maxGolombIdx}\par
05081   AlfFilterShape alfShape( isChroma ? 5 : 7 );\par
05082   {\cf17 const} {\cf18 int} numFilters = isChroma ? 1 : alfParam.numLumaFilters;\par
05083   {\cf18 short}* coeff = isChroma ? alfParam.chromaCoeff[altIdx] : alfParam.lumaCoeff;\par
05084   Pel*   clipp = isChroma ? alfParam.chromaClipp[altIdx] : alfParam.lumaClipp;\par
05085 \par
05086 \par
05087   {\cf20 // Filter coefficients}\par
05088   {\cf19 for}( {\cf18 int} ind = 0; ind < numFilters; ++ind )\par
05089   \{\par
05090 \par
05091     {\cf19 for}( {\cf18 int} i = 0; i < alfShape.numCoeff - 1; i++ )\par
05092     \{\par
05093       READ_UVLC( code, isChroma ? {\cf22 "alf_chroma_coeff_abs"} : {\cf22 "alf_luma_coeff_abs"} );\par
05094       coeff[ ind * MAX_NUM_ALF_LUMA_COEFF + i ] = code;\par
05095       {\cf19 if}( coeff[ ind * MAX_NUM_ALF_LUMA_COEFF + i ] != 0 )\par
05096       \{\par
05097         READ_FLAG( code, isChroma ? {\cf22 "alf_chroma_coeff_sign"} : {\cf22 "alf_luma_coeff_sign"} );\par
05098         coeff[ ind * MAX_NUM_ALF_LUMA_COEFF + i ] = ( code ) ? -coeff[ ind * MAX_NUM_ALF_LUMA_COEFF + i ] : coeff[ ind * MAX_NUM_ALF_LUMA_COEFF + i ];\par
05099        \}\par
05100       CHECK( isChroma &&\par
05101              ( coeff[ind * MAX_NUM_ALF_LUMA_COEFF + i] > 127 || coeff[ind * MAX_NUM_ALF_LUMA_COEFF + i] < -128 )\par
05102              , {\cf22 "AlfCoeffC shall be in the range of -128 to 127, inclusive"} );\par
05103     \}\par
05104   \}\par
05105 \par
05106   {\cf20 // Clipping values coding}\par
05107   {\cf19 if} ( alfParam.nonLinearFlag[isChroma] )\par
05108   \{\par
05109 \par
05110     {\cf20 // Filter coefficients}\par
05111     {\cf19 for}( {\cf18 int} ind = 0; ind < numFilters; ++ind )\par
05112     \{\par
05113 \par
05114       {\cf19 for}( {\cf18 int} i = 0; i < alfShape.numCoeff - 1; i++ )\par
05115       \{\par
05116         READ_CODE(2, code, isChroma ? {\cf22 "alf_chroma_clip_idx"} : {\cf22 "alf_luma_clip_idx"});\par
05117         clipp[ind * MAX_NUM_ALF_LUMA_COEFF + i] = code;\par
05118       \}\par
05119     \}\par
05120   \}\par
05121   {\cf19 else}\par
05122   \{\par
05123     {\cf19 for}( {\cf18 int} ind = 0; ind < numFilters; ++ind )\par
05124     \{\par
05125       std::fill_n( clipp + ind * MAX_NUM_ALF_LUMA_COEFF, alfShape.numCoeff, 0 );\par
05126     \}\par
05127   \}\par
05128 \}\par
05129 \par
05131 \par
05132 \} {\cf20 // namespace vtm}\par
