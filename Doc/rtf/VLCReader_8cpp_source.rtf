04366 {\cf18 void} HLSyntaxReader::getSlicePoc(Slice* pcSlice, PicHeader* picHeader, ParameterSetManager *parameterSetManager, {\cf17 const} {\cf18 int} prevTid0POC)\par
04367 \{\par
04368   uint32_t  uiCode;\par
04369   uint32_t  pocLsb;\par
04370   PPS* pps = NULL;\par
04371   SPS* sps = NULL;\par
04372 \par
04373   CHECK(picHeader==0, {\cf22 "Invalid Picture Header"});\par
04374   CHECK(picHeader->isValid()=={\cf17 false}, {\cf22 "Invalid Picture Header"});\par
04375   pps = parameterSetManager->getPPS( picHeader->getPPSId() );\par
04377   CHECK(pps==0, {\cf22 "Invalid PPS"});\par
04378   sps = parameterSetManager->getSPS(pps->getSPSId());\par
04380   CHECK(sps==0, {\cf22 "Invalid SPS"});\par
04381 \par
04382   DTRACE_UPDATE( g_trace_ctx, std::make_pair( {\cf22 "final"}, 0 ) );\par
04383 \par
04384   READ_FLAG(uiCode, {\cf22 "sh_picture_header_in_slice_header_flag"});\par
04385   {\cf19 if} (uiCode == 0)\par
04386   \{\par
04387     pocLsb = picHeader->getPocLsb();\par
04388   \}\par
04389   {\cf19 else}\par
04390   \{\par
04391     uint32_t phGdrOrIrapPicFlag;\par
04392     READ_FLAG(phGdrOrIrapPicFlag, {\cf22 "ph_gdr_or_irap_pic_flag"});\par
04393     READ_FLAG(uiCode, {\cf22 "ph_non_ref_pic_flag"});\par
04394     {\cf19 if} (phGdrOrIrapPicFlag)\par
04395     \{\par
04396       READ_FLAG(uiCode, {\cf22 "ph_gdr_pic_flag"});\par
04397     \}\par
04398     READ_FLAG(uiCode, {\cf22 "ph_inter_slice_allowed_flag"});\par
04399     {\cf19 if} (uiCode)\par
04400     \{\par
04401       READ_FLAG(uiCode, {\cf22 "ph_intra_slice_allowed_flag"});\par
04402     \}\par
04403     {\cf20 // parameter sets}\par
04404     READ_UVLC(uiCode, {\cf22 "ph_pic_parameter_set_id"});\par
04405     {\cf20 // picture order count}\par
04406     READ_CODE(sps->getBitsForPOC(), pocLsb, {\cf22 "ph_pic_order_cnt_lsb"});\par
04407   \}\par
04408   {\cf18 int} maxPocLsb = 1 << sps->getBitsForPOC();\par
04409   {\cf18 int} pocMsb;\par
04410   {\cf19 if} (pcSlice->getIdrPicFlag())\par
04411   \{\par
04412     {\cf19 if} (picHeader->getPocMsbPresentFlag())\par
04413     \{\par
04414       pocMsb = picHeader->getPocMsbVal()*maxPocLsb;\par
04415     \}\par
04416     {\cf19 else}\par
04417     \{\par
04418       pocMsb = 0;\par
04419     \}\par
04420     pcSlice->setPOC(pocMsb + pocLsb);\par
04421   \}\par
04422   {\cf19 else}\par
04423   \{\par
04424     {\cf18 int} prevPoc = prevTid0POC;\par
04425     {\cf18 int} prevPocLsb = prevPoc & (maxPocLsb - 1);\par
04426     {\cf18 int} prevPocMsb = prevPoc - prevPocLsb;\par
04427     {\cf19 if} (picHeader->getPocMsbPresentFlag())\par
04428     \{\par
04429       pocMsb = picHeader->getPocMsbVal()*maxPocLsb;\par
04430     \}\par
04431     {\cf19 else}\par
04432     \{\par
04433       {\cf19 if} ((pocLsb < prevPocLsb) && ((prevPocLsb - pocLsb) >= (maxPocLsb / 2)))\par
04434       \{\par
04435         pocMsb = prevPocMsb + maxPocLsb;\par
04436       \}\par
04437       {\cf19 else} {\cf19 if} ((pocLsb > prevPocLsb) && ((pocLsb - prevPocLsb) > (maxPocLsb / 2)))\par
04438       \{\par
04439         pocMsb = prevPocMsb - maxPocLsb;\par
04440       \}\par
04441       {\cf19 else}\par
04442       \{\par
04443         pocMsb = prevPocMsb;\par
04444       \}\par
04445     \}\par
04446     pcSlice->setPOC(pocMsb + pocLsb);\par
04447   \}\par
04448   DTRACE_UPDATE( g_trace_ctx, std::make_pair( {\cf22 "final"}, 1 ) );\par
04449 \}\par
