04662 {\cf18 void} HLSyntaxReader::parsePredWeightTable( Slice* pcSlice, {\cf17 const} SPS *sps )\par
04663 \{\par
04664   {\cf17 const} ChromaFormat    chFmt        = sps->getChromaFormatIdc();\par
04665   {\cf17 const} {\cf18 int}             numValidComp = int(getNumberValidComponents(chFmt));\par
04666   {\cf17 const} {\cf18 bool}            bChroma      = (chFmt!=CHROMA_400);\par
04667   {\cf17 const} SliceType       eSliceType   = pcSlice->getSliceType();\par
04668   {\cf17 const} {\cf18 int}             iNbRef       = (eSliceType == B_SLICE ) ? (2) : (1);\par
04669   uint32_t            uiLog2WeightDenomLuma=0, uiLog2WeightDenomChroma=0;\par
04670   uint32_t            uiTotalSignalledWeightFlags = 0;\par
04671 \par
04672   {\cf18 int} iDeltaDenom;\par
04673   {\cf20 // decode delta_luma_log2_weight_denom :}\par
04674   READ_UVLC( uiLog2WeightDenomLuma, {\cf22 "luma_log2_weight_denom"} );\par
04675   CHECK( uiLog2WeightDenomLuma > 7, {\cf22 "The value of luma_log2_weight_denom shall be in the range of 0 to 7"} );\par
04676   {\cf19 if}( bChroma )\par
04677   \{\par
04678     READ_SVLC( iDeltaDenom, {\cf22 "delta_chroma_log2_weight_denom"} );\par
04679     CHECK((iDeltaDenom + ({\cf18 int})uiLog2WeightDenomLuma)<0, {\cf22 "luma_log2_weight_denom + delta_chroma_log2_weight_denom shall be in the range of 0 to 7"});\par
04680     CHECK((iDeltaDenom + ({\cf18 int})uiLog2WeightDenomLuma)>7, {\cf22 "luma_log2_weight_denom + delta_chroma_log2_weight_denom shall be in the range of 0 to 7"});\par
04681     uiLog2WeightDenomChroma = (uint32_t)(iDeltaDenom + uiLog2WeightDenomLuma);\par
04682   \}\par
04683 \par
04684   {\cf19 for} ( {\cf18 int} iNumRef=0 ; iNumRef<iNbRef ; iNumRef++ ) {\cf20 // loop over l0 and l1 syntax elements}\par
04685   \{\par
04686     RefPicList  eRefPicList = ( iNumRef ? REF_PIC_LIST_1 : REF_PIC_LIST_0 );\par
04687     {\cf19 for} ( {\cf18 int} iRefIdx=0 ; iRefIdx<pcSlice->getNumRefIdx(eRefPicList) ; iRefIdx++ )\par
04688     \{\par
04689       WPScalingParam *wp = pcSlice->getWpScaling(eRefPicList, iRefIdx);\par
04690 \par
04691       wp[COMPONENT_Y].log2WeightDenom = uiLog2WeightDenomLuma;\par
04692       {\cf19 for}({\cf18 int} j=1; j<numValidComp; j++)\par
04693       \{\par
04694         wp[j].log2WeightDenom = uiLog2WeightDenomChroma;\par
04695       \}\par
04696 \par
04697       uint32_t  uiCode;\par
04698       READ_FLAG( uiCode, iNumRef==0?{\cf22 "luma_weight_l0_flag[i]"}:{\cf22 "luma_weight_l1_flag[i]"} );\par
04699       wp[COMPONENT_Y].presentFlag = (uiCode == 1);\par
04700       uiTotalSignalledWeightFlags += wp[COMPONENT_Y].presentFlag;\par
04701     \}\par
04702     {\cf19 if} ( bChroma )\par
04703     \{\par
04704       uint32_t  uiCode;\par
04705       {\cf19 for} ( {\cf18 int} iRefIdx=0 ; iRefIdx<pcSlice->getNumRefIdx(eRefPicList) ; iRefIdx++ )\par
04706       \{\par
04707         WPScalingParam *wp = pcSlice->getWpScaling(eRefPicList, iRefIdx);\par
04708         READ_FLAG( uiCode, iNumRef==0?{\cf22 "chroma_weight_l0_flag[i]"}:{\cf22 "chroma_weight_l1_flag[i]"} );\par
04709         {\cf19 for}({\cf18 int} j=1; j<numValidComp; j++)\par
04710         \{\par
04711           wp[j].presentFlag = (uiCode == 1);\par
04712         \}\par
04713         uiTotalSignalledWeightFlags += 2 * wp[COMPONENT_Cb].presentFlag;\par
04714       \}\par
04715     \}\par
04716     {\cf19 else}\par
04717     \{\par
04718       {\cf19 for} ( {\cf18 int} iRefIdx=0; iRefIdx<MAX_NUM_REF; iRefIdx++ )\par
04719       \{\par
04720         WPScalingParam *wp = pcSlice->getWpScaling(eRefPicList, iRefIdx);\par
04721 \par
04722         wp[COMPONENT_Cb].presentFlag = {\cf17 false};\par
04723         wp[COMPONENT_Cr].presentFlag = {\cf17 false};\par
04724       \}\par
04725     \}\par
04726     {\cf19 for} ( {\cf18 int} iRefIdx=0 ; iRefIdx<pcSlice->getNumRefIdx(eRefPicList) ; iRefIdx++ )\par
04727     \{\par
04728       WPScalingParam *wp = pcSlice->getWpScaling(eRefPicList, iRefIdx);\par
04729       {\cf19 if} (wp[COMPONENT_Y].presentFlag)\par
04730       \{\par
04731         {\cf18 int} iDeltaWeight;\par
04732         READ_SVLC( iDeltaWeight, iNumRef==0?{\cf22 "delta_luma_weight_l0[i]"}:{\cf22 "delta_luma_weight_l1[i]"} );\par
04733         CHECK( iDeltaWeight < -128, {\cf22 "delta_luma_weight_lx shall be in the rage of -128 to 127"} );\par
04734         CHECK( iDeltaWeight >  127, {\cf22 "delta_luma_weight_lx shall be in the rage of -128 to 127"} );\par
04735         wp[COMPONENT_Y].codedWeight = (iDeltaWeight + (1 << wp[COMPONENT_Y].log2WeightDenom));\par
04736         READ_SVLC(wp[COMPONENT_Y].codedOffset, iNumRef == 0 ? {\cf22 "luma_offset_l0[i]"} : {\cf22 "luma_offset_l1[i]"});\par
04737         {\cf17 const} {\cf18 int} range=sps->getSpsRangeExtension().getHighPrecisionOffsetsEnabledFlag() ? (1<<sps->getBitDepth(CHANNEL_TYPE_LUMA))/2 : 128;\par
04738         CHECK(wp[0].codedOffset < -range, {\cf22 "luma_offset_lx shall be in the rage of -128 to 127"});\par
04739         CHECK(wp[0].codedOffset >= range, {\cf22 "luma_offset_lx shall be in the rage of -128 to 127"});\par
04740       \}\par
04741       {\cf19 else}\par
04742       \{\par
04743         wp[COMPONENT_Y].codedWeight = (1 << wp[COMPONENT_Y].log2WeightDenom);\par
04744         wp[COMPONENT_Y].codedOffset = 0;\par
04745       \}\par
04746       {\cf19 if} ( bChroma )\par
04747       \{\par
04748         {\cf19 if} (wp[COMPONENT_Cb].presentFlag)\par
04749         \{\par
04750           {\cf18 int} range=sps->getSpsRangeExtension().getHighPrecisionOffsetsEnabledFlag() ? (1<<sps->getBitDepth(CHANNEL_TYPE_CHROMA))/2 : 128;\par
04751           {\cf19 for} ( {\cf18 int} j=1 ; j<numValidComp ; j++ )\par
04752           \{\par
04753             {\cf18 int} iDeltaWeight;\par
04754             READ_SVLC( iDeltaWeight, iNumRef==0?{\cf22 "delta_chroma_weight_l0[i]"}:{\cf22 "delta_chroma_weight_l1[i]"} );\par
04755             CHECK( iDeltaWeight < -128, {\cf22 "delta_chroma_weight_lx shall be in the rage of -128 to 127"} );\par
04756             CHECK( iDeltaWeight >  127, {\cf22 "delta_chroma_weight_lx shall be in the rage of -128 to 127"} );\par
04757             wp[j].codedWeight = (iDeltaWeight + (1 << wp[j].log2WeightDenom));\par
04758 \par
04759             {\cf18 int} iDeltaChroma;\par
04760             READ_SVLC( iDeltaChroma, iNumRef==0?{\cf22 "delta_chroma_offset_l0[i]"}:{\cf22 "delta_chroma_offset_l1[i]"} );\par
04761             CHECK( iDeltaChroma <  -4*range, {\cf22 "delta_chroma_offset_lx shall be in the range of -4 * 128 to 4 * 127"} );\par
04762             CHECK( iDeltaChroma >  4*(range-1), {\cf22 "delta_chroma_offset_lx shall be in the range of -4 * 128 to 4 * 127"} );\par
04763             {\cf18 int} pred          = (range - ((range * wp[j].codedWeight) >> (wp[j].log2WeightDenom)));\par
04764             wp[j].codedOffset = Clip3(-range, range - 1, (iDeltaChroma + pred));\par
04765           \}\par
04766         \}\par
04767         {\cf19 else}\par
04768         \{\par
04769           {\cf19 for} ( {\cf18 int} j=1 ; j<numValidComp ; j++ )\par
04770           \{\par
04771             wp[j].codedWeight = (1 << wp[j].log2WeightDenom);\par
04772             wp[j].codedOffset = 0;\par
04773           \}\par
04774         \}\par
04775       \}\par
04776     \}\par
04777 \par
04778     {\cf19 for} ( {\cf18 int} iRefIdx=pcSlice->getNumRefIdx(eRefPicList) ; iRefIdx<MAX_NUM_REF ; iRefIdx++ )\par
04779     \{\par
04780       WPScalingParam *wp = pcSlice->getWpScaling(eRefPicList, iRefIdx);\par
04781 \par
04782       wp[COMPONENT_Y].presentFlag  = {\cf17 false};\par
04783       wp[COMPONENT_Cb].presentFlag = {\cf17 false};\par
04784       wp[COMPONENT_Cr].presentFlag = {\cf17 false};\par
04785     \}\par
04786   \}\par
04787   CHECK(uiTotalSignalledWeightFlags>24, {\cf22 "Too many weight flag signalled"});\par
04788 \}\par
