00415 {\cf18 void} HLSyntaxReader::parsePPS( PPS* pcPPS )\par
00416 \{\par
00417 {\cf21 #if ENABLE_TRACING}\par
00418   xTracePPSHeader ();\par
00419 {\cf21 #endif}\par
00420   uint32_t  uiCode;\par
00421 \par
00422   {\cf18 int}   iCode;\par
00423   READ_CODE(6, uiCode, {\cf22 "pps_pic_parameter_set_id"});\par
00424   CHECK(uiCode > 63, {\cf22 "PPS id exceeds boundary (63)"});\par
00425   pcPPS->setPPSId (uiCode);\par
00426 \par
00427   READ_CODE(4, uiCode, {\cf22 "pps_seq_parameter_set_id"});\par
00428   pcPPS->setSPSId (uiCode);\par
00429 \par
00430   READ_FLAG( uiCode, {\cf22 "pps_mixed_nalu_types_in_pic_flag"} );       pcPPS->setMixedNaluTypesInPicFlag( uiCode == 1 );\par
00431 \par
00432   READ_UVLC( uiCode, {\cf22 "pps_pic_width_in_luma_samples"} );          pcPPS->setPicWidthInLumaSamples( uiCode );\par
00433   READ_UVLC( uiCode, {\cf22 "pps_pic_height_in_luma_samples"} );         pcPPS->setPicHeightInLumaSamples( uiCode );\par
00434   READ_FLAG( uiCode, {\cf22 "pps_conformance_window_flag"});\par
00435   pcPPS->setConformanceWindowFlag( uiCode );\par
00436   {\cf19 if} (uiCode != 0)\par
00437   \{\par
00438     Window& conf = pcPPS->getConformanceWindow();\par
00439     READ_UVLC(uiCode, {\cf22 "pps_conf_win_left_offset"});               conf.setWindowLeftOffset(uiCode);\par
00440     READ_UVLC(uiCode, {\cf22 "pps_conf_win_right_offset"});              conf.setWindowRightOffset(uiCode);\par
00441     READ_UVLC(uiCode, {\cf22 "pps_conf_win_top_offset"});                conf.setWindowTopOffset(uiCode);\par
00442     READ_UVLC(uiCode, {\cf22 "pps_conf_win_bottom_offset"});             conf.setWindowBottomOffset(uiCode);\par
00443   \}\par
00444   READ_FLAG( uiCode, {\cf22 "pps_scaling_window_explicit_signalling_flag"} );\par
00445   {\cf19 if}( uiCode != 0 )\par
00446   \{\par
00447     Window &scalingWindow = pcPPS->getScalingWindow();\par
00448     READ_SVLC( iCode, {\cf22 "pps_scaling_win_left_offset"} );               scalingWindow.setWindowLeftOffset( iCode );\par
00449     READ_SVLC( iCode, {\cf22 "pps_scaling_win_right_offset"} );              scalingWindow.setWindowRightOffset( iCode );\par
00450     READ_SVLC( iCode, {\cf22 "pps_scaling_win_top_offset"} );                scalingWindow.setWindowTopOffset( iCode );\par
00451     READ_SVLC( iCode, {\cf22 "pps_scaling_win_bottom_offset"} );             scalingWindow.setWindowBottomOffset( iCode );\par
00452   \}\par
00453   {\cf19 else}\par
00454   \{\par
00455     Window &scalingWindow = pcPPS->getScalingWindow();\par
00456     Window& conf = pcPPS->getConformanceWindow();\par
00457     scalingWindow.setWindowLeftOffset( conf.getWindowLeftOffset() );\par
00458     scalingWindow.setWindowRightOffset( conf.getWindowRightOffset() );\par
00459     scalingWindow.setWindowTopOffset( conf.getWindowTopOffset() );\par
00460     scalingWindow.setWindowBottomOffset( conf.getWindowBottomOffset() );\par
00461   \}\par
00462 \par
00463   READ_FLAG( uiCode, {\cf22 "pps_output_flag_present_flag"} );                    pcPPS->setOutputFlagPresentFlag( uiCode==1 );\par
00464 \par
00465   READ_FLAG( uiCode, {\cf22 "pps_no_pic_partition_flag"});                     pcPPS->setNoPicPartitionFlag(uiCode == 1);\par
00466   READ_FLAG( uiCode, {\cf22 "pps_subpic_id_mapping_present_flag"} );           pcPPS->setSubPicIdMappingInPpsFlag( uiCode != 0 );\par
00467   {\cf19 if}( pcPPS->getSubPicIdMappingInPpsFlag() )\par
00468   \{\par
00469     {\cf19 if}( !pcPPS->getNoPicPartitionFlag() )\par
00470     \{\par
00471       READ_UVLC(uiCode, {\cf22 "pps_num_subpics_minus1"});                         pcPPS->setNumSubPics(uiCode + 1);\par
00472     \}\par
00473     {\cf19 else}\par
00474     \{\par
00475       pcPPS->setNumSubPics(1);\par
00476     \}\par
00477     CHECK( uiCode > MAX_NUM_SUB_PICS-1,  {\cf22 "Number of sub-pictures exceeds limit"});\par
00478 \par
00479     READ_UVLC( uiCode, {\cf22 "pps_subpic_id_len_minus1"} );                       pcPPS->setSubPicIdLen( uiCode + 1 );\par
00480     CHECK( uiCode > 15, {\cf22 "Invalid pps_subpic_id_len_minus1 signalled"});\par
00481 \par
00482     CHECK((1 << pcPPS->getSubPicIdLen()) < pcPPS->getNumSubPics(), {\cf22 "pps_subpic_id_len exceeds valid range"});\par
00483     {\cf19 for}( {\cf18 int} picIdx = 0; picIdx < pcPPS->getNumSubPics( ); picIdx++ )\par
00484     \{\par
00485       READ_CODE( pcPPS->getSubPicIdLen( ), uiCode, {\cf22 "pps_subpic_id[i]"} );   pcPPS->setSubPicId( picIdx, uiCode );\par
00486     \}\par
00487   \}\par
00488   {\cf19 if}(!pcPPS->getNoPicPartitionFlag())\par
00489   \{\par
00490     {\cf18 int} colIdx, rowIdx;\par
00491     pcPPS->resetTileSliceInfo();\par
00492 \par
00493     {\cf20 // CTU size - required to match size in SPS}\par
00494     READ_CODE(2, uiCode, {\cf22 "pps_log2_ctu_size_minus5"});                 pcPPS->setLog2CtuSize(uiCode + 5);\par
00495     CHECK(uiCode > 2, {\cf22 "pps_log2_ctu_size_minus5 must be less than or equal to 2"});\par
00496 \par
00497     {\cf20 // number of explicit tile columns/rows}\par
00498     READ_UVLC( uiCode, {\cf22 "pps_num_exp_tile_columns_minus1"} );               pcPPS->setNumExpTileColumns( uiCode + 1 );\par
00499     READ_UVLC( uiCode, {\cf22 "pps_num_exp_tile_rows_minus1"} );                  pcPPS->setNumExpTileRows( uiCode + 1 );\par
00500     CHECK(pcPPS->getNumExpTileColumns() > MAX_TILE_COLS,              {\cf22 "Number of explicit tile columns exceeds valid range"});\par
00501 \par
00502     {\cf20 // tile sizes}\par
00503     {\cf19 for}( colIdx = 0; colIdx < pcPPS->getNumExpTileColumns(); colIdx++ )\par
00504     \{\par
00505       READ_UVLC( uiCode, {\cf22 "pps_tile_column_width_minus1[i]"} );             pcPPS->addTileColumnWidth( uiCode + 1 );\par
00506       CHECK(uiCode  > (pcPPS->getPicWidthInCtu()-1),                 {\cf22 "The value of pps_tile_column_width_minus1[i] shall be in the range of 0 to PicWidthInCtbY-1, inclusive"});\par
00507     \}\par
00508     {\cf19 for}( rowIdx = 0; rowIdx < pcPPS->getNumExpTileRows(); rowIdx++ )\par
00509     \{\par
00510       READ_UVLC( uiCode, {\cf22 "pps_tile_row_height_minus1[i]"} );               pcPPS->addTileRowHeight( uiCode + 1 );\par
00511       CHECK(uiCode > (pcPPS->getPicHeightInCtu() - 1),                {\cf22 "The value of pps_tile_row_height_minus shall be in the range of 0 to PicHeightInCtbY-1, inclusive"});\par
00512     \}\par
00513     pcPPS->initTiles();\par
00514     {\cf20 // rectangular slice signalling}\par
00515     {\cf19 if} (pcPPS->getNumTiles() > 1)\par
00516     \{\par
00517       READ_CODE(1, uiCode, {\cf22 "pps_loop_filter_across_tiles_enabled_flag"});    pcPPS->setLoopFilterAcrossTilesEnabledFlag(uiCode == 1);\par
00518       READ_CODE(1, uiCode, {\cf22 "pps_rect_slice_flag"});\par
00519     \}\par
00520     {\cf19 else}\par
00521     \{\par
00522       pcPPS->setLoopFilterAcrossTilesEnabledFlag({\cf17 false});\par
00523       uiCode = 1;\par
00524     \}\par
00525     pcPPS->setRectSliceFlag(uiCode == 1);\par
00526     {\cf19 if} (pcPPS->getRectSliceFlag())\par
00527     \{\par
00528       READ_FLAG(uiCode, {\cf22 "pps_single_slice_per_subpic_flag"});            pcPPS->setSingleSlicePerSubPicFlag(uiCode == 1);\par
00529     \}\par
00530     {\cf19 else}\par
00531     \{\par
00532       pcPPS->setSingleSlicePerSubPicFlag(0);\par
00533     \}\par
00534     {\cf19 if} (pcPPS->getRectSliceFlag() & !(pcPPS->getSingleSlicePerSubPicFlag()))\par
00535     \{\par
00536       int32_t tileIdx = 0;\par
00537 \par
00538       READ_UVLC( uiCode, {\cf22 "pps_num_slices_in_pic_minus1"} );                pcPPS->setNumSlicesInPic( uiCode + 1 );\par
00539       CHECK(pcPPS->getNumSlicesInPic() > MAX_SLICES,                  {\cf22 "Number of slices in picture exceeds valid range"});\par
00540       {\cf19 if} ((pcPPS->getNumSlicesInPic() - 1) > 1)\par
00541       \{\par
00542         READ_CODE(1, uiCode, {\cf22 "pps_tile_idx_delta_present_flag"});\par
00543         pcPPS->setTileIdxDeltaPresentFlag(uiCode == 1);\par
00544       \}\par
00545       {\cf19 else}\par
00546       \{\par
00547         pcPPS->setTileIdxDeltaPresentFlag(0);\par
00548       \}\par
00549       pcPPS->initRectSlices();\par
00550 \par
00551       {\cf20 // read rectangular slice parameters}\par
00552       {\cf19 for}( {\cf18 int} i = 0; i < pcPPS->getNumSlicesInPic()-1; i++ )\par
00553       \{\par
00554         pcPPS->setSliceTileIdx( i, tileIdx );\par
00555 \par
00556         {\cf20 // complete tiles within a single slice}\par
00557         {\cf19 if}( ( tileIdx % pcPPS->getNumTileColumns() ) != pcPPS->getNumTileColumns() - 1 )\par
00558         \{\par
00559           READ_UVLC( uiCode, {\cf22 "pps_slice_width_in_tiles_minus1[i]"} );\par
00560           pcPPS->setSliceWidthInTiles ( i, uiCode + 1 );\par
00561         \}\par
00562         {\cf19 else}\par
00563         \{\par
00564           pcPPS->setSliceWidthInTiles( i, 1 );\par
00565         \}\par
00566 \par
00567         {\cf19 if}( tileIdx / pcPPS->getNumTileColumns() != pcPPS->getNumTileRows() - 1  &&\par
00568          ( pcPPS->getTileIdxDeltaPresentFlag() || tileIdx % pcPPS->getNumTileColumns() == 0 ) ) \par
00569         \{\par
00570           READ_UVLC( uiCode, {\cf22 "pps_slice_height_in_tiles_minus1[i]"} );\par
00571           pcPPS->setSliceHeightInTiles( i, uiCode + 1 );\par
00572         \}\par
00573         {\cf19 else}\par
00574         \{\par
00575           {\cf19 if}( ( tileIdx / pcPPS->getNumTileColumns() ) == pcPPS->getNumTileRows() - 1 )\par
00576           \{\par
00577             pcPPS->setSliceHeightInTiles( i, 1 );\par
00578           \}\par
00579           {\cf19 else}\par
00580           \{\par
00581             pcPPS->setSliceHeightInTiles( i, pcPPS->getSliceHeightInTiles( i - 1 ) );\par
00582           \}\par
00583       \}\par
00584 \par
00585         {\cf20 // multiple slices within a single tile special case}\par
00586         {\cf19 if}( pcPPS->getSliceWidthInTiles(i) == 1 && pcPPS->getSliceHeightInTiles(i) == 1 )\par
00587         \{\par
00588           {\cf19 if}( pcPPS->getTileRowHeight(tileIdx / pcPPS->getNumTileColumns()) > 1 )\par
00589           \{\par
00590             READ_UVLC(uiCode, {\cf22 "pps_num_exp_slices_in_tile[i]"});\par
00591             {\cf19 if} (uiCode == 0)\par
00592             \{\par
00593               pcPPS->setNumSlicesInTile(i, 1);\par
00594               pcPPS->setSliceHeightInCtu(i, pcPPS->getTileRowHeight(tileIdx / pcPPS->getNumTileColumns()));\par
00595             \}\par
00596             {\cf19 else}\par
00597             \{\par
00598               uint32_t numExpSliceInTile = uiCode;\par
00599               uint32_t remTileRowHeight  = pcPPS->getTileRowHeight(tileIdx / pcPPS->getNumTileColumns());\par
00600               {\cf18 int} j = 0;\par
00601 \par
00602               {\cf19 for}( ; j < numExpSliceInTile; j++ )\par
00603               \{\par
00604                 READ_UVLC(uiCode, {\cf22 "pps_exp_slice_height_in_ctus_minus1[i]"});\par
00605                 pcPPS->setSliceHeightInCtu(i + j, uiCode + 1);\par
