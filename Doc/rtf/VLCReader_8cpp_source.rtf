04634 {\cf18 void} HLSyntaxReader::parseRemainingBytes( {\cf18 bool} noTrailingBytesExpected )\par
04635 \{\par
04636   {\cf19 if} (noTrailingBytesExpected)\par
04637   \{\par
04638     CHECK( 0 != m_pcBitstream->getNumBitsLeft(), {\cf22 "Bits left although no bits expected"} );\par
04639   \}\par
04640   {\cf19 else}\par
04641   \{\par
04642     {\cf19 while} (m_pcBitstream->getNumBitsLeft())\par
04643     \{\par
04644       uint32_t trailingNullByte=m_pcBitstream->readByte();\par
04645       {\cf19 if} (trailingNullByte!=0)\par
04646       \{\par
04647         msg( ERROR, {\cf22 "Trailing byte should be 0, but has value %02x\\n"}, trailingNullByte);\par
04648         THROW({\cf22 "Invalid trailing '0' byte"});\par
04649       \}\par
04650     \}\par
04651   \}\par
04652 \}\par
