04555 {\cf18 void} HLSyntaxReader::parseProfileTierLevel(ProfileTierLevel *ptl, {\cf18 bool} profileTierPresentFlag, {\cf18 int} maxNumSubLayersMinus1)\par
04556 \{\par
04557   uint32_t symbol;\par
04558   {\cf19 if}(profileTierPresentFlag)\par
04559   \{\par
04560     READ_CODE(7 , symbol,   {\cf22 "general_profile_idc"}              ); ptl->setProfileIdc  (Profile::Name(symbol));\par
04561     READ_FLAG(    symbol,   {\cf22 "general_tier_flag"}                ); ptl->setTierFlag    (symbol ? Level::HIGH : Level::MAIN);\par
04562   \}\par
04563 \par
04564   READ_CODE( 8, symbol, {\cf22 "general_level_idc"} ); ptl->setLevelIdc( Level::Name( symbol ) );\par
04565 \par
04566   READ_FLAG(      symbol,   {\cf22 "ptl_frame_only_constraint_flag"}   ); ptl->setFrameOnlyConstraintFlag(symbol);\par
04567   READ_FLAG(      symbol,   {\cf22 "ptl_multilayer_enabled_flag"}      ); ptl->setMultiLayerEnabledFlag(symbol);\par
04568   CHECK((ptl->getProfileIdc() == Profile::MAIN_10 || ptl->getProfileIdc() == Profile::MAIN_10_444\par
04569          || ptl->getProfileIdc() == Profile::MAIN_10_STILL_PICTURE\par
04570          || ptl->getProfileIdc() == Profile::MAIN_10_444_STILL_PICTURE)\par
04571           && symbol,\par
04572         {\cf22 "ptl_multilayer_enabled_flag shall be equal to 0 for non-multilayer profiles"});\par
04573 \par
04574   {\cf19 if}(profileTierPresentFlag)\par
04575   \{\par
04576     parseConstraintInfo(ptl->getConstraintInfo());\par
04577   \}\par
04578 \par
04579   {\cf19 for} ({\cf18 int} i = maxNumSubLayersMinus1 - 1; i >= 0; i--)\par
04580   \{\par
04581     READ_FLAG( symbol, {\cf22 "sub_layer_level_present_flag[i]"}   ); ptl->setSubLayerLevelPresentFlag  (i, symbol);\par
04582   \}\par
04583 \par
04584   {\cf19 while} (!isByteAligned())\par
04585   \{\par
04586     READ_FLAG(    symbol,   {\cf22 "ptl_reserved_zero_bit"}         ); CHECK (symbol != 0, {\cf22 "ptl_reserved_zero_bit not equal to zero"});\par
04587   \}\par
04588 \par
04589   {\cf19 for} ({\cf18 int} i = maxNumSubLayersMinus1 - 1; i >= 0; i--)\par
04590   \{\par
04591     {\cf19 if} (ptl->getSubLayerLevelPresentFlag(i))\par
04592     \{\par
04593       READ_CODE(8 , symbol,   {\cf22 "sub_layer_level_idc"}                ); ptl->setSubLayerLevelIdc    (i, Level::Name(symbol));\par
04594     \}\par
04595   \}\par
04596   ptl->setSubLayerLevelIdc(maxNumSubLayersMinus1, ptl->getLevelIdc());\par
04597   {\cf19 for}( {\cf18 int} i = maxNumSubLayersMinus1 - 1; i >= 0; i-- )\par
04598   \{\par
04599     {\cf19 if}( !ptl->getSubLayerLevelPresentFlag( i ) )\par
04600     \{\par
04601       ptl->setSubLayerLevelIdc( i, ptl->getSubLayerLevelIdc( i + 1 ) );\par
04602     \}\par
04603   \}\par
04604 \par
04605   {\cf19 if} (profileTierPresentFlag)\par
04606   \{\par
04607     READ_CODE(8, symbol, {\cf22 "ptl_num_sub_profiles"});\par
04608     uint8_t numSubProfiles = symbol;\par
04609     ptl->setNumSubProfile(numSubProfiles);\par
04610     {\cf19 for} ({\cf18 int} i = 0; i < numSubProfiles; i++)\par
04611     \{\par
04612       READ_CODE(32, symbol, {\cf22 "general_sub_profile_idc[i]"});\par
04613       ptl->setSubProfileIdc(i, symbol);\par
04614     \}\par
04615   \}\par
04616 \}\par
