04492 \par
04493     {\cf20 /* intra */}\par
04494     READ_FLAG(symbol, {\cf22 "gci_no_palette_constraint_flag"});                 cinfo->setNoPaletteConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04495     READ_FLAG(symbol, {\cf22 "gci_no_ibc_constraint_flag"});                     cinfo->setNoIbcConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04496     READ_FLAG(symbol, {\cf22 "gci_no_isp_constraint_flag"});                     cinfo->setNoIspConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
