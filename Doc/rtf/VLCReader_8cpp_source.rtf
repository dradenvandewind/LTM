04790 {\cf18 void} HLSyntaxReader::parsePredWeightTable(PicHeader *picHeader, {\cf17 const} PPS *pps, {\cf17 const} SPS *sps)\par
04791 \{\par
04792   WPScalingParam *   wp;\par
04793   {\cf17 const} ChromaFormat chFmt                     = sps->getChromaFormatIdc();\par
04794   {\cf17 const} {\cf18 int}          numValidComp              = int(getNumberValidComponents(chFmt));\par
04795   {\cf17 const} {\cf18 bool}         chroma                    = (chFmt != CHROMA_400);\par
04796   uint32_t           log2WeightDenomLuma       = 0;\par
04797   uint32_t           log2WeightDenomChroma     = 0;\par
04798   uint32_t           totalSignalledWeightFlags = 0;\par
04799 \par
04800   {\cf18 int} deltaDenom;\par
04801   READ_UVLC(log2WeightDenomLuma, {\cf22 "luma_log2_weight_denom"});\par
04802   CHECK(log2WeightDenomLuma > 7, {\cf22 "The value of luma_log2_weight_denom shall be in the range of 0 to 7"});\par
04803   {\cf19 if} (chroma)\par
04804   \{\par
04805     READ_SVLC(deltaDenom, {\cf22 "delta_chroma_log2_weight_denom"});\par
04806     CHECK((deltaDenom + ({\cf18 int}) log2WeightDenomLuma) < 0, {\cf22 "luma_log2_weight_denom + delta_chroma_log2_weight_denom shall be in the range of 0 to 7"});\par
04807     CHECK((deltaDenom + ({\cf18 int}) log2WeightDenomLuma) > 7, {\cf22 "luma_log2_weight_denom + delta_chroma_log2_weight_denom shall be in the range of 0 to 7"});\par
04808     log2WeightDenomChroma = (uint32_t)(deltaDenom + log2WeightDenomLuma);\par
04809   \}\par
04810 \par
04811   uint32_t numLxWeights;\par
04812   READ_UVLC(numLxWeights, {\cf22 "num_l0_weights"});\par
04813   picHeader->setNumL0Weights(numLxWeights);\par
04814   picHeader->setNumL1Weights(0);\par
04815 \par
04816   {\cf18 bool} moreSyntaxToBeParsed = {\cf17 true};\par
04817   {\cf19 for} ({\cf18 int} numRef = 0; numRef < NUM_REF_PIC_LIST_01 && moreSyntaxToBeParsed; numRef++)\par
04818   \{\par
04819     RefPicList refPicList = (numRef ? REF_PIC_LIST_1 : REF_PIC_LIST_0);\par
04820     {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < numLxWeights; refIdx++)\par
04821     \{\par
04822       wp = picHeader->getWpScaling(refPicList, refIdx);\par
04823 \par
04824       wp[COMPONENT_Y].log2WeightDenom = log2WeightDenomLuma;\par
04825       {\cf19 for} ({\cf18 int} j = 1; j < numValidComp; j++)\par
04826       \{\par
04827         wp[j].log2WeightDenom = log2WeightDenomChroma;\par
04828       \}\par
04829 \par
04830       uint32_t uiCode;\par
04831       READ_FLAG(uiCode, numRef == 0 ? {\cf22 "luma_weight_l0_flag[i]"} : {\cf22 "luma_weight_l1_flag[i]"});\par
04832       wp[COMPONENT_Y].presentFlag = (uiCode == 1);\par
04833       totalSignalledWeightFlags += wp[COMPONENT_Y].presentFlag;\par
04834     \}\par
04835     {\cf19 if} (chroma)\par
04836     \{\par
04837       uint32_t uiCode;\par
04838       {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < numLxWeights; refIdx++)\par
04839       \{\par
04840         wp = picHeader->getWpScaling(refPicList, refIdx);\par
04841         READ_FLAG(uiCode, numRef == 0 ? {\cf22 "chroma_weight_l0_flag[i]"} : {\cf22 "chroma_weight_l1_flag[i]"});\par
04842         {\cf19 for} ({\cf18 int} j = 1; j < numValidComp; j++)\par
04843         \{\par
04844           wp[j].presentFlag = (uiCode == 1);\par
04845         \}\par
04846         totalSignalledWeightFlags += 2 * wp[COMPONENT_Cb].presentFlag;\par
04847       \}\par
04848     \}\par
04849     {\cf19 else}\par
04850     \{\par
04851       {\cf19 for} ( {\cf18 int} refIdx=0; refIdx<MAX_NUM_REF; refIdx++ )\par
04852       \{\par
04853         wp                = picHeader->getWpScaling(refPicList, refIdx);\par
04854         wp[1].presentFlag = {\cf17 false};\par
04855         wp[2].presentFlag = {\cf17 false};\par
04856       \}\par
04857     \}\par
04858     {\cf19 for} ({\cf18 int} refIdx = 0; refIdx < numLxWeights; refIdx++)\par
04859     \{\par
04860       wp = picHeader->getWpScaling(refPicList, refIdx);\par
04861       {\cf19 if} (wp[COMPONENT_Y].presentFlag)\par
04862       \{\par
04863         {\cf18 int} deltaWeight;\par
04864         READ_SVLC(deltaWeight, numRef == 0 ? {\cf22 "delta_luma_weight_l0[i]"} : {\cf22 "delta_luma_weight_l1[i]"});\par
04865         CHECK(deltaWeight < -128, {\cf22 "delta_luma_weight_lx shall be in the rage of -128 to 127"});\par
04866         CHECK(deltaWeight > 127, {\cf22 "delta_luma_weight_lx shall be in the rage of -128 to 127"});\par
04867         wp[COMPONENT_Y].codedWeight = (deltaWeight + (1 << wp[COMPONENT_Y].log2WeightDenom));\par
04868         READ_SVLC(wp[COMPONENT_Y].codedOffset, numRef == 0 ? {\cf22 "luma_offset_l0[i]"} : {\cf22 "luma_offset_l1[i]"});\par
04869         {\cf17 const} {\cf18 int} range = sps->getSpsRangeExtension().getHighPrecisionOffsetsEnabledFlag() ? (1 << sps->getBitDepth(CHANNEL_TYPE_LUMA)) / 2 : 128;\par
04870         CHECK(wp[0].codedOffset < -range, {\cf22 "luma_offset_lx shall be in the rage of -128 to 127"});\par
04871         CHECK(wp[0].codedOffset >= range, {\cf22 "luma_offset_lx shall be in the rage of -128 to 127"});\par
04872       \}\par
04873       {\cf19 else}\par
04874       \{\par
04875         wp[COMPONENT_Y].codedWeight = (1 << wp[COMPONENT_Y].log2WeightDenom);\par
04876         wp[COMPONENT_Y].codedOffset = 0;\par
04877       \}\par
04878       {\cf19 if} (chroma)\par
04879       \{\par
04880         {\cf19 if} (wp[COMPONENT_Cb].presentFlag)\par
04881         \{\par
04882           {\cf18 int} range = sps->getSpsRangeExtension().getHighPrecisionOffsetsEnabledFlag() ? (1 << sps->getBitDepth(CHANNEL_TYPE_CHROMA)) / 2 : 128;\par
04883           {\cf19 for} ({\cf18 int} j = 1; j < numValidComp; j++)\par
04884           \{\par
04885             {\cf18 int} deltaWeight;\par
04886             READ_SVLC(deltaWeight, numRef == 0 ? {\cf22 "delta_chroma_weight_l0[i]"} : {\cf22 "delta_chroma_weight_l1[i]"});\par
04887             CHECK( deltaWeight < -128, {\cf22 "delta_chroma_weight_lx shall be in the rage of -128 to 127"} );\par
04888             CHECK( deltaWeight >  127, {\cf22 "delta_chroma_weight_lx shall be in the rage of -128 to 127"} );\par
04889             wp[j].codedWeight = (deltaWeight + (1 << wp[j].log2WeightDenom));\par
04890 \par
04891             {\cf18 int} deltaChroma;\par
04892             READ_SVLC(deltaChroma, numRef == 0 ? {\cf22 "delta_chroma_offset_l0[i]"} : {\cf22 "delta_chroma_offset_l1[i]"});\par
04893             CHECK( deltaChroma <  -4*range, {\cf22 "delta_chroma_offset_lx shall be in the range of -4 * 128 to 4 * 127"} );\par
04894             CHECK( deltaChroma >=  4*range, {\cf22 "delta_chroma_offset_lx shall be in the range of -4 * 128 to 4 * 127"} );\par
04895             {\cf18 int} pred          = (range - ((range * wp[j].codedWeight) >> (wp[j].log2WeightDenom)));\par
04896             wp[j].codedOffset = Clip3(-range, range - 1, (deltaChroma + pred));\par
04897           \}\par
04898         \}\par
04899         {\cf19 else}\par
04900         \{\par
04901           {\cf19 for} ({\cf18 int} j = 1; j < numValidComp; j++)\par
04902           \{\par
04903             wp[j].codedWeight = (1 << wp[j].log2WeightDenom);\par
04904             wp[j].codedOffset = 0;\par
04905           \}\par
04906         \}\par
04907       \}\par
04908     \}\par
04909 \par
04910     {\cf19 for} ({\cf18 int} refIdx = numLxWeights; refIdx < MAX_NUM_REF; refIdx++)\par
04911     \{\par
04912       wp = picHeader->getWpScaling(refPicList, refIdx);\par
04913 \par
04914       wp[0].presentFlag = {\cf17 false};\par
04915       wp[1].presentFlag = {\cf17 false};\par
04916       wp[2].presentFlag = {\cf17 false};\par
04917     \}\par
04918 \par
04919     {\cf19 if} (numRef == 0)\par
04920     \{\par
04921       {\cf19 if} (pps->getWPBiPred() && picHeader->getRPL(1)->getNumRefEntries() > 0)\par
04922       \{\par
04923         READ_UVLC(numLxWeights, {\cf22 "num_l1_weights"});\par
04924       \}\par
04925       {\cf19 else}\par
04926       \{\par
04927         numLxWeights = 0;\par
04928       \}\par
04929       moreSyntaxToBeParsed = (numLxWeights == 0) ? {\cf17 false} : {\cf17 true};\par
04930       picHeader->setNumL1Weights(numLxWeights);\par
04931     \}\par
04932   \}\par
04933   CHECK(totalSignalledWeightFlags > 24, {\cf22 "Too many weight flag signalled"});\par
04934 \}\par
