04277   {\cf19 if} (sps->getTransformSkipEnabledFlag() && !pcSlice->getDepQuantEnabledFlag() && !pcSlice->getSignDataHidingEnabledFlag())\par
04278   \{\par
04279     READ_FLAG(uiCode, {\cf22 "sh_ts_residual_coding_disabled_flag"});\par
04280     pcSlice->setTSResidualCodingDisabledFlag( uiCode != 0 );\par
04281   \}\par
04282   {\cf19 else}\par
04283   \{\par
04284     pcSlice->setTSResidualCodingDisabledFlag( {\cf17 false} );\par
04285   \}\par
04286 \par
04287   {\cf19 if}( pcSlice->getFirstCtuRsAddrInSlice() == 0 )\par
04288   \{\par
04289     pcSlice->setDefaultClpRng( *sps );\par
04290 \par
04291   \}\par
04292 \par
04293   {\cf19 if}(pps->getSliceHeaderExtensionPresentFlag())\par
04294   \{\par
04295     READ_UVLC(uiCode,{\cf22 "sh_slice_header_extension_length"});\par
04296     {\cf19 for}({\cf18 int} i=0; i<uiCode; i++)\par
