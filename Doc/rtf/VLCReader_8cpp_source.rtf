00192 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00193   uint32_t totalLen=1;\par
00194 {\cf21 #endif}\par
00195   {\cf19 if}( 0 == uiBits )\par
00196   \{\par
00197     uint32_t uiLength = 0;\par
00198 \par
00199     {\cf19 while}( ! ( uiBits & 1 ))\par
00200     \{\par
00201       m_pcBitstream->read( 1, uiBits );\par
00202       uiLength++;\par
00203     \}\par
00204 \par
00205     m_pcBitstream->read( uiLength, uiBits );\par
00206 \par
00207     uiBits += (1 << uiLength);\par
00208     riVal = ( uiBits & 1) ? -({\cf18 int})(uiBits>>1) : (int)(uiBits>>1);\par
00209 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00210     totalLen+=uiLength+uiLength;\par
00211 {\cf21 #endif}\par
00212   \}\par
00213   {\cf19 else}\par
00214   \{\par
00215     riVal = 0;\par
00216   \}\par
00217 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
00218   CodingStatistics::IncrementStatisticEP(pSymbolName, {\cf18 int}(totalLen), uiBits);\par
00219 {\cf21 #endif}\par
00220 \}\par
