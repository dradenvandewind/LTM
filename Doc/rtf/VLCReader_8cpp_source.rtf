04939 {\cf18 void} HLSyntaxReader::parseScalingList(ScalingList *scalingList, {\cf18 bool} aps_chromaPrsentFlag)\par
04940 \{\par
04941   uint32_t  code;\par
04942   {\cf18 bool} scalingListCopyModeFlag;\par
04943   scalingList->setChromaScalingListPresentFlag(aps_chromaPrsentFlag);\par
04944   {\cf19 for} ({\cf18 int} scalingListId = 0; scalingListId < 28; scalingListId++)\par
04945   \{\par
04946     {\cf19 if} (aps_chromaPrsentFlag || scalingList->isLumaScalingList(scalingListId))\par
04947   \{\par
04948     READ_FLAG(code, {\cf22 "scaling_list_copy_mode_flag"});\par
04949     scalingListCopyModeFlag = (code) ? {\cf17 true} : {\cf17 false};\par
04950     scalingList->setScalingListCopyModeFlag(scalingListId, scalingListCopyModeFlag);\par
04951 \par
04952     scalingList->setScalingListPreditorModeFlag(scalingListId, {\cf17 false});\par
04953     {\cf19 if} (!scalingListCopyModeFlag)\par
04954     \{\par
04955       READ_FLAG(code, {\cf22 "scaling_list_predictor_mode_flag"});\par
04956       scalingList->setScalingListPreditorModeFlag(scalingListId, code);\par
04957     \}\par
04958 \par
04959     {\cf19 if} ((scalingListCopyModeFlag || scalingList->getScalingListPreditorModeFlag(scalingListId)) && scalingListId!= SCALING_LIST_1D_START_2x2 && scalingListId!= SCALING_LIST_1D_START_4x4 && scalingListId!= SCALING_LIST_1D_START_8x8) {\cf20 //Copy Mode}\par
04960     \{\par
04961       READ_UVLC(code, {\cf22 "scaling_list_pred_matrix_id_delta"});\par
04962       scalingList->setRefMatrixId(scalingListId, (uint32_t)(({\cf18 int})(scalingListId)-(code)));\par
04963     \}\par
04964     {\cf19 else} {\cf19 if} (scalingListCopyModeFlag || scalingList->getScalingListPreditorModeFlag(scalingListId))\par
04965     \{\par
04966       scalingList->setRefMatrixId(scalingListId, (uint32_t)(({\cf18 int})(scalingListId)));\par
04967     \}\par
04968     {\cf19 if} (scalingListCopyModeFlag){\cf20 //copy}\par
04969     \{\par
04970       {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_16x16)\par
04971       \{\par
04972         scalingList->setScalingListDC(scalingListId,\par
04973           ((scalingListId == scalingList->getRefMatrixId(scalingListId)) ? 16\par
04974             : (scalingList->getRefMatrixId(scalingListId) < SCALING_LIST_1D_START_16x16) ? scalingList->getScalingListAddress(scalingList->getRefMatrixId(scalingListId))[0] : scalingList->getScalingListDC(scalingList->getRefMatrixId(scalingListId))));\par
04975       \}\par
04976       scalingList->processRefMatrix(scalingListId, scalingList->getRefMatrixId(scalingListId));\par
04977     \}\par
04978     {\cf19 else}\par
04979     \{\par
04980       decodeScalingList(scalingList, scalingListId, scalingList->getScalingListPreditorModeFlag(scalingListId));\par
04981     \}\par
04982   \}\par
04983   {\cf19 else}\par
04984   \{\par
04985     scalingListCopyModeFlag = {\cf17 true};\par
04986     scalingList->setScalingListCopyModeFlag(scalingListId, scalingListCopyModeFlag);\par
04987     scalingList->setRefMatrixId(scalingListId, (uint32_t)(({\cf18 int})(scalingListId)));\par
04988     {\cf19 if} (scalingListId >= SCALING_LIST_1D_START_16x16)\par
04989     \{\par
04990       scalingList->setScalingListDC(scalingListId, 16);\par
04991     \}\par
04992     scalingList->processRefMatrix(scalingListId, scalingList->getRefMatrixId(scalingListId));\par
04993   \}\par
04994   \}\par
04995 \par
04996   {\cf19 return};\par
04997 \}\par
