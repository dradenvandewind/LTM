04502     READ_FLAG(symbol, {\cf22 "gci_no_ref_pic_resampling_constraint_flag"});      cinfo->setNoRprConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
04503     READ_FLAG(symbol, {\cf22 "gci_no_res_change_in_clvs_constraint_flag"});      cinfo->setNoResChangeInClvsConstraintFlag(symbol > 0 ? {\cf17 true} : {\cf17 false});\par
