03403 {\cf18 void}  HLSyntaxReader::checkAlfNaluTidAndPicTid(Slice* pcSlice, PicHeader* picHeader, ParameterSetManager *parameterSetManager)\par
03404 \{\par
03405   SPS* sps = parameterSetManager->getSPS(picHeader->getSPSId());\par
03406   PPS* pps = parameterSetManager->getPPS(picHeader->getPPSId());\par
03407   {\cf18 int} curPicTid = pcSlice->getTLayer();\par
03408   APS* aps;\par
03409   {\cf17 const} std::vector<int>&   apsId = picHeader->getAlfAPSs();\par
03410 \par
03411   {\cf19 if} (sps->getALFEnabledFlag() && pps->getAlfInfoInPhFlag() && picHeader->getAlfEnabledFlag(COMPONENT_Y))\par
03412   \{\par
03413     {\cf20 //luma}\par
03414     {\cf19 for} ({\cf18 int} i = 0; i < picHeader->getNumAlfAps(); i++)\par
03415     \{\par
03416       aps = parameterSetManager->getAPS(apsId[i], ALF_APS);\par
03417       CHECK(aps->getTemporalId() > curPicTid, {\cf22 "The TemporalId of the APS NAL unit having aps_params_type equal to ALF_APS and adaptation_parameter_set_id equal to ph_alf_aps_id_luma[ i ] shall be less than or equal to the TemporalId of the picture associated with the PH."});\par
03418       {\cf19 if}( pcSlice->getNalUnitLayerId() != aps->getLayerId() )\par
03419       \{\par
03420         CHECK( aps->getLayerId() > pcSlice->getNalUnitLayerId(), {\cf22 "Layer Id of APS cannot be greater than layer Id of VCL NAL unit the refer to it"} );\par
03421         CHECK( pcSlice->getSPS()->getVPSId() == 0, {\cf22 "VPSId of the referred SPS cannot be 0 when layer Id of APS and layer Id of current slice are different"} );\par
03422         {\cf19 for} ({\cf18 int} i = 0; i < pcSlice->getVPS()->getNumOutputLayerSets(); i++ )\par
03423         \{\par
03424           {\cf18 bool} isCurrLayerInOls = {\cf17 false};\par
03425           {\cf18 bool} isRefLayerInOls = {\cf17 false};\par
03426           {\cf19 for}( {\cf18 int} j = pcSlice->getVPS()->getNumLayersInOls(i) - 1; j >= 0; j-- )\par
03427           \{\par
03428             {\cf19 if}( pcSlice->getVPS()->getLayerIdInOls(i, j) == pcSlice->getNalUnitLayerId() )\par
03429             \{\par
03430               isCurrLayerInOls = {\cf17 true};\par
03431             \}\par
03432             {\cf19 if}( pcSlice->getVPS()->getLayerIdInOls(i, j) == aps->getLayerId() )\par
03433             \{\par
03434               isRefLayerInOls = {\cf17 true};\par
03435             \}\par
03436           \}\par
03437           CHECK( isCurrLayerInOls && !isRefLayerInOls, {\cf22 "When VCL NAl unit in layer A refers to APS in layer B, all OLS that contains layer A shall also contains layer B"} );\par
03438         \}\par
03439       \}\par
03440     \}\par
03441     {\cf20 //chroma}\par
03442     {\cf19 if} (picHeader->getAlfEnabledFlag(COMPONENT_Cb) || picHeader->getAlfEnabledFlag(COMPONENT_Cr))\par
03443     \{\par
03444       {\cf18 int} chromaAlfApsId = picHeader->getAlfApsIdChroma();\par
03445       aps = parameterSetManager->getAPS(chromaAlfApsId, ALF_APS);\par
03446       CHECK(aps->getTemporalId() > curPicTid, {\cf22 "The TemporalId of the APS NAL unit having aps_params_type equal to ALF_APS and adaptation_parameter_set_id equal to ph_alf_aps_id_chroma shall be less than or equal to the TemporalId of the picture associated with the PH."});\par
03447       {\cf19 if}( pcSlice->getNalUnitLayerId() != aps->getLayerId() )\par
03448       \{\par
03449         CHECK( aps->getLayerId() > pcSlice->getNalUnitLayerId(), {\cf22 "Layer Id of APS cannot be greater than layer Id of VCL NAL unit the refer to it"} );\par
03450         CHECK( pcSlice->getSPS()->getVPSId() == 0, {\cf22 "VPSId of the referred SPS cannot be 0 when layer Id of APS and layer Id of current slice are different"} );\par
03451         {\cf19 for} ({\cf18 int} i = 0; i < pcSlice->getVPS()->getNumOutputLayerSets(); i++ )\par
03452         \{\par
03453           {\cf18 bool} isCurrLayerInOls = {\cf17 false};\par
03454           {\cf18 bool} isRefLayerInOls = {\cf17 false};\par
03455           {\cf19 for}( {\cf18 int} j = pcSlice->getVPS()->getNumLayersInOls(i) - 1; j >= 0; j-- )\par
03456           \{\par
03457             {\cf19 if}( pcSlice->getVPS()->getLayerIdInOls(i, j) == pcSlice->getNalUnitLayerId() )\par
03458             \{\par
03459               isCurrLayerInOls = {\cf17 true};\par
03460             \}\par
03461             {\cf19 if}( pcSlice->getVPS()->getLayerIdInOls(i, j) == aps->getLayerId() )\par
03462             \{\par
03463               isRefLayerInOls = {\cf17 true};\par
03464             \}\par
03465           \}\par
03466           CHECK( isCurrLayerInOls && !isRefLayerInOls, {\cf22 "When VCL NAl unit in layer A refers to APS in layer B, all OLS that contains layer A shall also contains layer B"} );\par
03467         \}\par
03468       \}\par
03469     \}\par
03470   \}\par
03471 \}\par
03472 {\cf18 void} HLSyntaxReader::parseSliceHeader (Slice* pcSlice, PicHeader* picHeader, ParameterSetManager *parameterSetManager, {\cf17 const} {\cf18 int} prevTid0POC, {\cf17 const} {\cf18 int} prevPicPOC)\par
03473 \{\par
03474   uint32_t  uiCode;\par
03475   {\cf18 int}   iCode;\par
03476 \par
03477 {\cf21 #if ENABLE_TRACING}\par
03478   xTraceSliceHeader();\par
03479 {\cf21 #endif}\par
03480   PPS* pps = NULL;\par
03481   SPS* sps = NULL;\par
03482   READ_FLAG(uiCode, {\cf22 "sh_picture_header_in_slice_header_flag"});\par
03483   pcSlice->setPictureHeaderInSliceHeader(uiCode);\par
03484   {\cf19 if} (uiCode)\par
03485   \{\par
03486     parsePictureHeader(picHeader, parameterSetManager, {\cf17 false});\par
03487     picHeader->setValid();\par
03488   \}\par
03489   CHECK(picHeader==0, {\cf22 "Invalid Picture Header"});\par
03490   CHECK(picHeader->isValid()=={\cf17 false}, {\cf22 "Invalid Picture Header"});\par
03491   checkAlfNaluTidAndPicTid(pcSlice, picHeader, parameterSetManager);\par
03492   pps = parameterSetManager->getPPS( picHeader->getPPSId() );\par
03494   CHECK(pps==0, {\cf22 "Invalid PPS"});\par
03495   sps = parameterSetManager->getSPS(pps->getSPSId());\par
03497   CHECK(sps==0, {\cf22 "Invalid SPS"});\par
03498   {\cf19 if} (sps->getProfileTierLevel()->getConstraintInfo()->getPicHeaderInSliceHeaderConstraintFlag())\par
03499   \{\par
03500     CHECK(pcSlice->getPictureHeaderInSliceHeader() == {\cf17 false}, {\cf22 "PH shall be present in SH, when pic_header_in_slice_header_constraint_flag is equal to 1"});\par
03501   \}\par
03502   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getRplInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, rpl_info_in_ph_flag shall be equal to 0"});\par
03503   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getDbfInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, dbf_info_in_ph_flag shall be equal to 0"});\par
03504   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getSaoInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, sao_info_in_ph_flag shall be equal to 0"});\par
03505   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getAlfInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, alf_info_in_ph_flag shall be equal to 0"});\par
03506   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getWpInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, wp_info_in_ph_flag shall be equal to 0"});\par
03507   CHECK(pcSlice->getPictureHeaderInSliceHeader() && pps->getQpDeltaInfoInPhFlag() == 1, {\cf22 "When sh_picture_header_in_slice_header_flag is equal to 1, qp_delta_info_in_ph_flag shall be equal to 0"});\par
03508   CHECK(pcSlice->getPictureHeaderInSliceHeader() && sps->getSubPicInfoPresentFlag() == 1, {\cf22 "When sps_subpic_info_present_flag is equal to 1, the value of sh_picture_header_in_slice_header_flag shall be equal to 0"});\par
03509   CHECK(sps->getSubPicInfoPresentFlag() == 1 && sps->getVirtualBoundariesEnabledFlag() == 1 && sps->getVirtualBoundariesPresentFlag() == 0,\par
03510         {\cf22 "when sps_subpic_info_present_flag is equal to 1 and sps_virtual_boundaries_enabled_flag is equal to 1, sps_virtual_boundaries_present_flag shall be equal 1"});\par
03511 \par
03512   {\cf17 const} ChromaFormat chFmt = sps->getChromaFormatIdc();\par
03513   {\cf17 const} uint32_t numValidComp=getNumberValidComponents(chFmt);\par
03514   {\cf17 const} {\cf18 bool} bChroma=(chFmt!=CHROMA_400);\par
03515 \par
03516   {\cf20 // picture order count}\par
03517   uiCode = picHeader->getPocLsb();\par
03518   {\cf18 int} iPOClsb = uiCode;\par
03519   {\cf18 int} iMaxPOClsb = 1 << sps->getBitsForPOC();\par
03520   {\cf18 int} iPOCmsb;\par
03521   {\cf19 if} (pcSlice->getIdrPicFlag())\par
03522   \{\par
03523     {\cf19 if} (picHeader->getPocMsbPresentFlag())\par
03524     \{\par
03525       iPOCmsb = picHeader->getPocMsbVal()*iMaxPOClsb;\par
03526     \}\par
03527     {\cf19 else}\par
03528     \{\par
03529       iPOCmsb = 0;\par
03530     \}\par
03531     pcSlice->setPOC(iPOCmsb + iPOClsb);\par
03532   \}\par
03533   {\cf19 else}\par
03534   \{\par
03535     {\cf18 int} iPrevPOC = prevTid0POC;\par
03536     {\cf18 int} iPrevPOClsb = iPrevPOC & (iMaxPOClsb - 1);\par
03537     {\cf18 int} iPrevPOCmsb = iPrevPOC - iPrevPOClsb;\par
03538     {\cf19 if} (picHeader->getPocMsbPresentFlag())\par
03539     \{\par
03540       iPOCmsb = picHeader->getPocMsbVal()*iMaxPOClsb;\par
03541     \}\par
03542     {\cf19 else}\par
03543     \{\par
03544       {\cf19 if} ((iPOClsb < iPrevPOClsb) && ((iPrevPOClsb - iPOClsb) >= (iMaxPOClsb / 2)))\par
03545       \{\par
03546         iPOCmsb = iPrevPOCmsb + iMaxPOClsb;\par
03547       \}\par
03548       {\cf19 else} {\cf19 if} ((iPOClsb > iPrevPOClsb) && ((iPOClsb - iPrevPOClsb) > (iMaxPOClsb / 2)))\par
03549       \{\par
03550         iPOCmsb = iPrevPOCmsb - iMaxPOClsb;\par
03551       \}\par
03552       {\cf19 else}\par
03553       \{\par
03554         iPOCmsb = iPrevPOCmsb;\par
03555       \}\par
03556     \}\par
03557     pcSlice->setPOC(iPOCmsb + iPOClsb);\par
03558   \}\par
03559 \par
03560   {\cf19 if} (sps->getSubPicInfoPresentFlag())\par
03561   \{\par
03562     uint32_t bitsSubPicId;\par
03563     bitsSubPicId = sps->getSubPicIdLen();\par
03564     READ_CODE(bitsSubPicId, uiCode, {\cf22 "sh_subpic_id"});    pcSlice->setSliceSubPicId(uiCode);\par
03565   \}\par
03566   {\cf19 else}\par
03567   \{\par
03568     pcSlice->setSliceSubPicId(0);\par
03569   \}\par
03570 \par
03571   {\cf20 // raster scan slices}\par
03572   uint32_t sliceAddr = 0;\par
03573   {\cf19 if}(pps->getRectSliceFlag() == 0)\par
03574   \{\par
03575     {\cf20 // slice address is the raster scan tile index of first tile in slice}\par
03576     {\cf19 if}( pps->getNumTiles() > 1 )\par
03577     \{\par
03578       {\cf18 int} bitsSliceAddress = ceilLog2(pps->getNumTiles());\par
03579       READ_CODE(bitsSliceAddress, uiCode, {\cf22 "sh_slice_address"});  sliceAddr = uiCode;\par
03580     \}\par
03581   \}\par
03582   {\cf20 // rectangular slices}\par
03583   {\cf19 else}\par
03584   \{\par
03585     {\cf20 // slice address is the index of the slice within the current sub-picture}\par
03586     uint32_t currSubPicIdx = pps->getSubPicIdxFromSubPicId( pcSlice->getSliceSubPicId() );\par
03587     SubPic currSubPic = pps->getSubPic(currSubPicIdx);\par
03588     {\cf19 if}( currSubPic.getNumSlicesInSubPic() > 1 )\par
03589     \{\par
03590       {\cf18 int} bitsSliceAddress = ceilLog2(currSubPic.getNumSlicesInSubPic());\par
03591       READ_CODE(bitsSliceAddress, uiCode, {\cf22 "sh_slice_address"});  sliceAddr = uiCode;\par
03592       CHECK(sliceAddr >= currSubPic.getNumSlicesInSubPic(), {\cf22 "Invalid slice address"});\par
03593     \}\par
03594     uint32_t picLevelSliceIdx = sliceAddr;\par
03595     {\cf19 for}({\cf18 int} subpic = 0; subpic < currSubPicIdx; subpic++)\par
03596     \{\par
03597       picLevelSliceIdx += pps->getSubPic(subpic).getNumSlicesInSubPic();\par
03598     \}\par
03599     pcSlice->setSliceMap( pps->getSliceMap(picLevelSliceIdx) );\par
03600     pcSlice->setSliceID(picLevelSliceIdx);\par
03601   \}\par
03602 \par
03603   std::vector<bool> shExtraBitsPresent = sps->getExtraSHBitPresentFlags();\par
03604   {\cf19 for} ({\cf18 int} i=0; i< sps->getNumExtraSHBytes() * 8; i++)\par
03605   \{\par
03606     {\cf20 // extra bits are ignored (when present)}\par
03607     {\cf19 if} (shExtraBitsPresent[i])\par
03608     \{\par
03609       READ_FLAG(uiCode, {\cf22 "sh_extra_bit[ i ]"});\par
03610     \}\par
03611   \}\par
03612 \par
03613   {\cf19 if}(pps->getRectSliceFlag() == 0)\par
03614   \{\par
03615     uint32_t numTilesInSlice = 1;\par
03616     {\cf19 if}( pps->getNumTiles() > 1 )\par
03617     \{\par
03618       {\cf19 if} ((({\cf18 int})pps->getNumTiles() - ({\cf18 int})sliceAddr) > 1)\par
03619       \{\par
03620         READ_UVLC(uiCode, {\cf22 "sh_num_tiles_in_slice_minus1"});        numTilesInSlice = uiCode + 1;\par
03621       \}\par
03622       {\cf19 if} (!pps->getRectSliceFlag() && sps->getProfileTierLevel()->getConstraintInfo()->getOneSlicePerPicConstraintFlag())\par
03623       \{\par
03624         CHECK(pps->getNumTiles() != uiCode + 1, {\cf22 "When pps_rect_slice_flag is equal to 0 and one_slice_per_pic_constraint_flag equal to 1, the value of sh_num_tiles_in_slice_minus1 present in each slice header shall be equal to NumTilesInPic - 1"});\par
