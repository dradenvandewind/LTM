04300     \}\par
04301   \}\par
04302 \par
04303   std::vector<uint32_t> entryPointOffset;\par
04304 \par
04305   pcSlice->resetNumberOfSubstream();\par
04306   pcSlice->setNumSubstream(sps, pps);\par
04307 \par
04308   pcSlice->setNumEntryPoints( sps, pps );\par
04309   {\cf19 if}( pcSlice->getNumEntryPoints() > 0 )\par
04310   \{\par
04311     uint32_t offsetLenMinus1;\par
04312     READ_UVLC( offsetLenMinus1, {\cf22 "sh_entry_offset_len_minus1"} );\par
04313     entryPointOffset.resize( pcSlice->getNumEntryPoints() );\par
04314     {\cf19 for}( uint32_t idx = 0; idx < pcSlice->getNumEntryPoints(); idx++ )\par
04315     \{\par
04316       READ_CODE( offsetLenMinus1 + 1, uiCode, {\cf22 "sh_entry_point_offset_minus1"} );\par
04317       entryPointOffset[idx] = uiCode + 1;\par
04318     \}\par
04319   \}\par
04320 \par
04321 {\cf21 #if RExt__DECODER_DEBUG_BIT_STATISTICS}\par
04322   CodingStatistics::IncrementStatisticEP(STATS__BYTE_ALIGNMENT_BITS,m_pcBitstream->readByteAlignment(),0);\par
04323 {\cf21 #else}\par
04324   m_pcBitstream->readByteAlignment();\par
04325 {\cf21 #endif}\par
04326 \par
04327   pcSlice->clearSubstreamSizes();\par
04328 \par
04329   {\cf19 if}( pcSlice->getNumEntryPoints() > 0 )\par
04330   \{\par
04331     {\cf18 int} endOfSliceHeaderLocation = m_pcBitstream->getByteLocation();\par
04332 \par
04333     {\cf20 // Adjust endOfSliceHeaderLocation to account for emulation prevention bytes in the slice segment header}\par
04334     {\cf19 for} ( uint32_t curByteIdx  = 0; curByteIdx<m_pcBitstream->numEmulationPreventionBytesRead(); curByteIdx++ )\par
04335     \{\par
04336       {\cf19 if} ( m_pcBitstream->getEmulationPreventionByteLocation( curByteIdx ) < endOfSliceHeaderLocation )\par
04337       \{\par
04338         endOfSliceHeaderLocation++;\par
04339       \}\par
04340     \}\par
04341 \par
04342     {\cf18 int}  curEntryPointOffset     = 0;\par
04343     {\cf18 int}  prevEntryPointOffset    = 0;\par
04344     {\cf19 for} (uint32_t idx=0; idx<entryPointOffset.size(); idx++)\par
04345     \{\par
04346       curEntryPointOffset += entryPointOffset[ idx ];\par
04347 \par
04348       {\cf18 int} emulationPreventionByteCount = 0;\par
04349       {\cf19 for} ( uint32_t curByteIdx  = 0; curByteIdx<m_pcBitstream->numEmulationPreventionBytesRead(); curByteIdx++ )\par
04350       \{\par
04351         {\cf19 if} ( m_pcBitstream->getEmulationPreventionByteLocation( curByteIdx ) >= ( prevEntryPointOffset + endOfSliceHeaderLocation ) &&\par
04352              m_pcBitstream->getEmulationPreventionByteLocation( curByteIdx ) <  ( curEntryPointOffset  + endOfSliceHeaderLocation ) )\par
04353         \{\par
04354           emulationPreventionByteCount++;\par
04355         \}\par
04356       \}\par
04357 \par
04358       entryPointOffset[ idx ] -= emulationPreventionByteCount;\par
04359       prevEntryPointOffset = curEntryPointOffset;\par
04360       pcSlice->addSubstreamSize(entryPointOffset [ idx ] );\par
04361     \}\par
04362   \}\par
04363   {\cf19 return};\par
04364 \}\par
