01223 {\cf18 void} HLSyntaxReader::parseOlsHrdParameters(GeneralHrdParams * generalHrd, OlsHrdParams *olsHrd, uint32_t firstSubLayer, uint32_t maxNumSubLayersMinus1)\par
01224 \{\par
01225   uint32_t  symbol;\par
01226 \par
01227   {\cf19 for}( {\cf18 int} i = firstSubLayer; i <= maxNumSubLayersMinus1; i ++ )\par
01228   \{\par
01229     OlsHrdParams *hrd = &(olsHrd[i]);\par
01230     READ_FLAG(symbol, {\cf22 "fixed_pic_rate_general_flag"});                     hrd->setFixedPicRateGeneralFlag(symbol == 1 ? {\cf17 true} : {\cf17 false});\par
01231     {\cf19 if} (!hrd->getFixedPicRateGeneralFlag())\par
01232     \{\par
01233       READ_FLAG(symbol, {\cf22 "fixed_pic_rate_within_cvs_flag"});                hrd->setFixedPicRateWithinCvsFlag(symbol == 1 ? {\cf17 true} : {\cf17 false});\par
01234     \}\par
01235     {\cf19 else}\par
01236     \{\par
01237       hrd->setFixedPicRateWithinCvsFlag({\cf17 true});\par
01238     \}\par
01239 \par
01240     hrd->setLowDelayHrdFlag({\cf17 false}); {\cf20 // Inferred to be 0 when not present}\par
01241 \par
01242     {\cf19 if} (hrd->getFixedPicRateWithinCvsFlag())\par
01243     \{\par
01244       READ_UVLC(symbol, {\cf22 "elemental_duration_in_tc_minus1"});             hrd->setElementDurationInTcMinus1(symbol);\par
01245     \}\par
01246 {\cf21 #if JVET_S0175_ASPECT6}\par
01247     {\cf19 else} {\cf19 if}((generalHrd->getGeneralNalHrdParametersPresentFlag() || generalHrd->getGeneralVclHrdParametersPresentFlag()) && generalHrd->getHrdCpbCntMinus1() == 0)\par
01248 {\cf21 #else}\par
01249     {\cf19 else} {\cf19 if}(generalHrd->getHrdCpbCntMinus1() == 0)\par
01250 {\cf21 #endif}\par
01251     \{\par
01252       READ_FLAG(symbol, {\cf22 "low_delay_hrd_flag"});                      hrd->setLowDelayHrdFlag(symbol == 1 ? {\cf17 true} : {\cf17 false});\par
01253     \}\par
01254 \par
01255     {\cf19 for}( {\cf18 int} nalOrVcl = 0; nalOrVcl < 2; nalOrVcl ++ )\par
01256     \{\par
01257       {\cf19 if} (((nalOrVcl == 0) && (generalHrd->getGeneralNalHrdParametersPresentFlag())) || ((nalOrVcl == 1) && (generalHrd->getGeneralVclHrdParametersPresentFlag())))\par
01258       \{\par
01259         {\cf19 for} ({\cf18 int} j = 0; j <= (generalHrd->getHrdCpbCntMinus1()); j++)\par
01260         \{\par
01261           READ_UVLC(symbol, {\cf22 "bit_rate_value_minus1"});             hrd->setBitRateValueMinus1(j, nalOrVcl, symbol);\par
01262           READ_UVLC(symbol, {\cf22 "cpb_size_value_minus1"});             hrd->setCpbSizeValueMinus1(j, nalOrVcl, symbol);\par
01263           {\cf19 if} (generalHrd->getGeneralDecodingUnitHrdParamsPresentFlag())\par
01264           \{\par
01265             READ_UVLC(symbol, {\cf22 "cpb_size_du_value_minus1"});             hrd->setDuCpbSizeValueMinus1(j, nalOrVcl, symbol);\par
01266             READ_UVLC(symbol, {\cf22 "bit_rate_du_value_minus1"});             hrd->setDuBitRateValueMinus1(j, nalOrVcl, symbol);\par
01267           \}\par
01268           READ_FLAG(symbol, {\cf22 "cbr_flag"});                          hrd->setCbrFlag(j, nalOrVcl, symbol == 1 ? {\cf17 true} : {\cf17 false});\par
01269         \}\par
01270       \}\par
01271     \}\par
01272   \}\par
01273   {\cf19 for} ({\cf18 int} i = 0; i < firstSubLayer; i++)\par
01274   \{\par
01275     OlsHrdParams* hrdHighestTLayer = &(olsHrd[maxNumSubLayersMinus1]);\par
01276     OlsHrdParams* hrdTemp = &(olsHrd[i]);\par
01277     {\cf18 bool} tempFlag = hrdHighestTLayer->getFixedPicRateGeneralFlag();\par
01278     hrdTemp->setFixedPicRateGeneralFlag(tempFlag);\par
01279     tempFlag = hrdHighestTLayer->getFixedPicRateWithinCvsFlag();\par
01280     hrdTemp->setFixedPicRateWithinCvsFlag(tempFlag);\par
01281     uint32_t tempElementDurationInTcMinus1 = hrdHighestTLayer->getElementDurationInTcMinus1();\par
01282     hrdTemp->setElementDurationInTcMinus1(tempElementDurationInTcMinus1);\par
01283     {\cf19 for} ({\cf18 int} nalOrVcl = 0; nalOrVcl < 2; nalOrVcl++)\par
01284     \{\par
01285       {\cf19 if} (((nalOrVcl == 0) && (generalHrd->getGeneralNalHrdParametersPresentFlag())) || ((nalOrVcl == 1) && (generalHrd->getGeneralVclHrdParametersPresentFlag())))\par
01286       \{\par
01287         {\cf19 for} ({\cf18 int} j = 0; j <= (generalHrd->getHrdCpbCntMinus1()); j++)\par
01288         \{\par
01289           uint32_t bitRate = hrdHighestTLayer->getBitRateValueMinus1(j, nalOrVcl);\par
01290           hrdTemp->setBitRateValueMinus1(j, nalOrVcl, bitRate);\par
01291           uint32_t cpbSize = hrdHighestTLayer->getCpbSizeValueMinus1(j, nalOrVcl);\par
01292           hrdTemp->setCpbSizeValueMinus1(j, nalOrVcl, cpbSize);\par
01293           {\cf19 if} (generalHrd->getGeneralDecodingUnitHrdParamsPresentFlag())\par
01294           \{\par
01295             uint32_t bitRateDu = hrdHighestTLayer->getDuBitRateValueMinus1(j, nalOrVcl);\par
01296             hrdTemp->setDuBitRateValueMinus1(j, nalOrVcl, bitRateDu);\par
01297             uint32_t cpbSizeDu = hrdHighestTLayer->getDuCpbSizeValueMinus1(j, nalOrVcl);\par
01298             hrdTemp->setDuCpbSizeValueMinus1(j, nalOrVcl, cpbSizeDu);\par
01299           \}\par
01300           {\cf18 bool} flag = hrdHighestTLayer->getCbrFlag(j, nalOrVcl);\par
01301           hrdTemp->setCbrFlag(j, nalOrVcl, flag);\par
01302         \}\par
01303       \}\par
01304     \}\par
01305   \}\par
01306 \}\par
