01102 {\cf18 void}  HLSyntaxReader::parseVUI(VUI* pcVUI, SPS *pcSPS)\par
01103 \{\par
01104 {\cf21 #if ENABLE_TRACING}\par
01105   DTRACE( g_trace_ctx, D_HEADER, {\cf22 "----------- vui_parameters -----------\\n"});\par
01106 {\cf21 #endif}\par
01107   {\cf18 unsigned} vuiPayloadSize = pcSPS->getVuiPayloadSize();\par
01108   InputBitstream *bs = getBitstream();\par
01109   setBitstream(bs->extractSubstream(vuiPayloadSize * 8));\par
01110 \par
01111   uint32_t  symbol;\par
01112 \par
01113   READ_FLAG(symbol,  {\cf22 "vui_progressive_source_flag"}          ); pcVUI->setProgressiveSourceFlag(symbol ? {\cf17 true} : {\cf17 false});\par
01114   READ_FLAG(symbol,  {\cf22 "vui_interlaced_source_flag"}           ); pcVUI->setInterlacedSourceFlag(symbol ? {\cf17 true} : {\cf17 false});\par
01115   READ_FLAG(symbol, {\cf22 "vui_non_packed_constraint_flag"});         pcVUI->setNonPackedFlag(symbol ? {\cf17 true} : {\cf17 false});\par
01116   READ_FLAG(symbol, {\cf22 "vui_non_projected_constraint_flag"});      pcVUI->setNonProjectedFlag(symbol ? {\cf17 true} : {\cf17 false});\par
01117   READ_FLAG( symbol, {\cf22 "vui_aspect_ratio_info_present_flag"});           pcVUI->setAspectRatioInfoPresentFlag(symbol);\par
01118   {\cf19 if} (pcVUI->getAspectRatioInfoPresentFlag())\par
01119   \{\par
01120     READ_FLAG( symbol, {\cf22 "vui_aspect_ratio_constant_flag"});           pcVUI->setAspectRatioConstantFlag(symbol);\par
01121     READ_CODE(8, symbol, {\cf22 "vui_aspect_ratio_idc"});                         pcVUI->setAspectRatioIdc(symbol);\par
01122     {\cf19 if} (pcVUI->getAspectRatioIdc() == 255)\par
01123     \{\par
01124       READ_CODE(16, symbol, {\cf22 "vui_sar_width"});                             pcVUI->setSarWidth(symbol);\par
01125       READ_CODE(16, symbol, {\cf22 "vui_sar_height"});                            pcVUI->setSarHeight(symbol);\par
01126     \}\par
01127   \}\par
01128 \par
01129   READ_FLAG(     symbol, {\cf22 "vui_overscan_info_present_flag"});               pcVUI->setOverscanInfoPresentFlag(symbol);\par
01130   {\cf19 if} (pcVUI->getOverscanInfoPresentFlag())\par
01131   \{\par
01132     READ_FLAG(   symbol, {\cf22 "vui_overscan_appropriate_flag"});                pcVUI->setOverscanAppropriateFlag(symbol);\par
01133   \}\par
01134 \par
01135   READ_FLAG(   symbol, {\cf22 "vui_colour_description_present_flag"});          pcVUI->setColourDescriptionPresentFlag(symbol);\par
01136   {\cf19 if} (pcVUI->getColourDescriptionPresentFlag())\par
01137   \{\par
01138     READ_CODE(8, symbol, {\cf22 "vui_colour_primaries"});                       pcVUI->setColourPrimaries(symbol);\par
01139     READ_CODE(8, symbol, {\cf22 "vui_transfer_characteristics"});               pcVUI->setTransferCharacteristics(symbol);\par
01140     READ_CODE(8, symbol, {\cf22 "vui_matrix_coeffs"});                          pcVUI->setMatrixCoefficients(symbol);\par
01141     READ_FLAG(   symbol, {\cf22 "vui_full_range_flag"});                    pcVUI->setVideoFullRangeFlag(symbol);\par
01142   \}\par
01143 \par
01144   READ_FLAG(     symbol, {\cf22 "vui_chroma_loc_info_present_flag"});             pcVUI->setChromaLocInfoPresentFlag(symbol);\par
01145   {\cf19 if} (pcVUI->getChromaLocInfoPresentFlag())\par
01146   \{\par
01147     {\cf19 if}(pcVUI->getProgressiveSourceFlag() && !pcVUI->getInterlacedSourceFlag())\par
01148     \{\par
01149       READ_UVLC(   symbol, {\cf22 "vui_chroma_sample_loc_type"} );        pcVUI->setChromaSampleLocType(symbol);\par
01150     \}\par
01151     {\cf19 else}\par
01152     \{\par
01153       READ_UVLC(   symbol, {\cf22 "vui_chroma_sample_loc_type_top_field"} );        pcVUI->setChromaSampleLocTypeTopField(symbol);\par
01154       READ_UVLC(   symbol, {\cf22 "vui_chroma_sample_loc_type_bottom_field"} );     pcVUI->setChromaSampleLocTypeBottomField(symbol);\par
01155     \}\par
01156   \}\par
01157 \par
01158   {\cf18 int} payloadBitsRem = getBitstream()->getNumBitsLeft();\par
01159   {\cf19 if}(payloadBitsRem)      {\cf20 //Corresponds to more_data_in_payload()}\par
01160   \{\par
01161     {\cf19 while}(payloadBitsRem > 9)    {\cf20 //payload_extension_present()}\par
01162     \{\par
01163       READ_CODE(1, symbol, {\cf22 "vui_reserved_payload_extension_data"});\par
01164       payloadBitsRem--;\par
01165     \}\par
01166     {\cf18 int} finalBits = getBitstream()->peekBits(payloadBitsRem);\par
01167     {\cf18 int} numFinalZeroBits = 0;\par
01168     {\cf18 int} mask = 0xff;\par
01169     {\cf19 while}(finalBits & (mask >> numFinalZeroBits))\par
01170     \{\par
01171       numFinalZeroBits++;\par
01172     \}\par
01173     {\cf19 while}(payloadBitsRem > 9-numFinalZeroBits)     {\cf20 //payload_extension_present()}\par
01174     \{\par
01175       READ_CODE(1, symbol, {\cf22 "vui_reserved_payload_extension_data"});\par
01176       payloadBitsRem--;\par
01177     \}\par
01178     READ_FLAG(symbol, {\cf22 "vui_payload_bit_equal_to_one"});\par
01179     CHECK(symbol != 1, {\cf22 "vui_payload_bit_equal_to_one not equal to 1"});\par
01180     payloadBitsRem--;\par
01181     {\cf19 while}(payloadBitsRem)\par
01182     \{\par
01183       READ_FLAG(symbol, {\cf22 "vui_payload_bit_equal_to_zero"});\par
01184       CHECK(symbol != 0, {\cf22 "vui_payload_bit_equal_to_zero not equal to 0"});\par
01185       payloadBitsRem--;\par
01186     \}\par
01187   \}\par
01188   {\cf17 delete} getBitstream();\par
01189   setBitstream(bs);\par
01190 \}\par
