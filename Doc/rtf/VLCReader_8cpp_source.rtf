01021         AlfFilterShape alfShape(size_CC_ALF);\par
01022 \par
01023         {\cf18 short} *coeff = ccAlfParam.ccAlfCoeff[ccIdx][filterIdx];\par
01024         {\cf20 // Filter coefficients}\par
01025         {\cf19 for} ({\cf18 int} i = 0; i < alfShape.numCoeff - 1; i++)\par
01026         \{\par
01027           READ_CODE(CCALF_BITS_PER_COEFF_LEVEL, code,\par
01028                     ccIdx == 0 ? {\cf22 "alf_cc_cb_mapped_coeff_abs"} : {\cf22 "alf_cc_cr_mapped_coeff_abs"});\par
01029           {\cf19 if} (code == 0)\par
01030           \{\par
01031             coeff[i] = 0;\par
01032           \}\par
01033           {\cf19 else}\par
01034           \{\par
01035             coeff[i] = 1 << (code - 1);\par
01036             READ_FLAG(code, ccIdx == 0 ? {\cf22 "alf_cc_cb_coeff_sign"} : {\cf22 "alf_cc_cr_coeff_sign"});\par
01037             coeff[i] *= 1 - 2 * code;\par
01038           \}\par
01039         \}\par
01040 \par
01041         DTRACE(g_trace_ctx, D_SYNTAX, {\cf22 "%s coeff filterIdx %d: "}, ccIdx == 0 ? {\cf22 "Cb"} : {\cf22 "Cr"}, filterIdx);\par
01042         {\cf19 for} ({\cf18 int} i = 0; i < alfShape.numCoeff; i++)\par
01043         \{\par
01044           DTRACE(g_trace_ctx, D_SYNTAX, {\cf22 "%d "}, coeff[i]);\par
01045         \}\par
01046         DTRACE(g_trace_ctx, D_SYNTAX, {\cf22 "\\n"});\par
01047       \}\par
01048 \par
01049       {\cf19 for} ({\cf18 int} filterIdx = ccAlfParam.ccAlfFilterCount[ccIdx]; filterIdx < MAX_NUM_CC_ALF_FILTERS; filterIdx++)\par
01050       \{\par
01051         ccAlfParam.ccAlfFilterIdxEnabled[ccIdx][filterIdx] = {\cf17 false};\par
01052       \}\par
01053     \}\par
01054   \}\par
01055   aps->setCcAlfAPSParam(ccAlfParam);\par
01056 \par
01057   aps->setAlfAPSParam(param);\par
01058 \}\par
