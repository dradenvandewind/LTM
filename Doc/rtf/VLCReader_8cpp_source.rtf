04620 {\cf18 void} HLSyntaxReader::parseTerminatingBit( uint32_t& ruiBit )\par
04621 \{\par
04622   ruiBit = {\cf17 false};\par
04623   {\cf18 int} iBitsLeft = m_pcBitstream->getNumBitsLeft();\par
04624   {\cf19 if}(iBitsLeft <= 8)\par
04625   \{\par
04626     uint32_t uiPeekValue = m_pcBitstream->peekBits(iBitsLeft);\par
04627     {\cf19 if} (uiPeekValue == (1<<(iBitsLeft-1)))\par
04628     \{\par
04629       ruiBit = {\cf17 true};\par
04630     \}\par
04631   \}\par
04632 \}\par
