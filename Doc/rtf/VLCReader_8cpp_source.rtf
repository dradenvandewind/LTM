00296 {\cf18 void} HLSyntaxReader::copyRefPicList(SPS* sps, ReferencePictureList* source_rpl, ReferencePictureList* dest_rp)\par
00297 \{\par
00298   dest_rp->setNumberOfShorttermPictures(source_rpl->getNumberOfShorttermPictures());\par
00299 \par
00300   dest_rp->setNumberOfInterLayerPictures( sps->getInterLayerPresentFlag() ? source_rpl->getNumberOfInterLayerPictures() : 0 );\par
00301 \par
00302   {\cf19 if}( sps->getLongTermRefsPresent() )\par
00303   \{\par
00304     dest_rp->setLtrpInSliceHeaderFlag(source_rpl->getLtrpInSliceHeaderFlag());\par
00305     dest_rp->setNumberOfLongtermPictures( source_rpl->getNumberOfLongtermPictures() );\par
00306   \}\par
00307   {\cf19 else}\par
00308     dest_rp->setNumberOfLongtermPictures(0);\par
00309 \par
00310   uint32_t numRefPic = dest_rp->getNumberOfShorttermPictures() + dest_rp->getNumberOfLongtermPictures();\par
00311 \par
00312   {\cf19 for}( {\cf18 int} ii = 0; ii < numRefPic; ii++ )\par
00313   \{\par
00314     dest_rp->setRefPicIdentifier( ii, source_rpl->getRefPicIdentifier( ii ), source_rpl->isRefPicLongterm( ii ), source_rpl->isInterLayerRefPic( ii ), source_rpl->getInterLayerRefPicIdx( ii ) );\par
00315   \}\par
00316 \}\par
