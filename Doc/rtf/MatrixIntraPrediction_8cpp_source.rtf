00045 MatrixIntraPrediction::MatrixIntraPrediction():\par
00046   m_component(MAX_NUM_COMPONENT),\par
00047   m_reducedBoundary          (MIP_MAX_INPUT_SIZE),\par
00048   m_reducedBoundaryTransposed(MIP_MAX_INPUT_SIZE),\par
00049   m_inputOffset      ( 0 ),\par
00050   m_inputOffsetTransp( 0 ),\par
00051   m_refSamplesTop (MIP_MAX_WIDTH),\par
00052   m_refSamplesLeft(MIP_MAX_HEIGHT),\par
00053   m_blockSize( 0, 0 ),\par
00054   m_sizeId( 0 ),\par
00055   m_reducedBdrySize( 0 ),\par
00056   m_reducedPredSize( 0 ),\par
00057   m_upsmpFactorHor( 0 ),\par
00058   m_upsmpFactorVer( 0 )\par
00059 \{\par
00060 \}\par
00061 \par
00062 {\cf18 void} MatrixIntraPrediction::prepareInputForPred({\cf17 const} CPelBuf &pSrc, {\cf17 const} Area &block, {\cf17 const} {\cf18 int} bitDepth,\par
00063                                                 {\cf17 const} ComponentID compId)\par
00064 \{\par
00065   m_component = compId;\par
00066 \par
00067   {\cf20 // Step 1: Save block size and calculate dependent values}\par
00068   initPredBlockParams(block);\par
00069 \par
00070   {\cf20 // Step 2: Get the input data (left and top reference samples)}\par
00071   m_refSamplesTop.resize(block.width);\par
00072   {\cf19 for} ({\cf18 int} x = 0; x < block.width; x++)\par
00073   \{\par
00074     m_refSamplesTop[x] = pSrc.at(x + 1, 0);\par
00075   \}\par
00076 \par
00077   m_refSamplesLeft.resize(block.height);\par
00078   {\cf19 for} ({\cf18 int} y = 0; y < block.height; y++)\par
00079   \{\par
00080     m_refSamplesLeft[y] = pSrc.at(y + 1, 1);\par
00081   \}\par
00082 \par
00083   {\cf20 // Step 3: Compute the reduced boundary via Haar-downsampling (input for the prediction)}\par
00084   {\cf17 const} {\cf18 int} inputSize = 2 * m_reducedBdrySize;\par
00085   m_reducedBoundary          .resize( inputSize );\par
00086   m_reducedBoundaryTransposed.resize( inputSize );\par
00087 \par
00088   {\cf18 int}* {\cf17 const} topReduced = m_reducedBoundary.data();\par
00089   boundaryDownsampling1D( topReduced, m_refSamplesTop.data(), block.width, m_reducedBdrySize );\par
00090 \par
00091   {\cf18 int}* {\cf17 const} leftReduced = m_reducedBoundary.data() + m_reducedBdrySize;\par
00092   boundaryDownsampling1D( leftReduced, m_refSamplesLeft.data(), block.height, m_reducedBdrySize );\par
00093 \par
00094   {\cf18 int}* {\cf17 const} leftReducedTransposed = m_reducedBoundaryTransposed.data();\par
00095   {\cf18 int}* {\cf17 const} topReducedTransposed  = m_reducedBoundaryTransposed.data() + m_reducedBdrySize;\par
00096   {\cf19 for}( {\cf18 int} x = 0; x < m_reducedBdrySize; x++ )\par
00097   \{\par
00098     topReducedTransposed[x] = topReduced[x];\par
00099   \}\par
00100   {\cf19 for}( {\cf18 int} y = 0; y < m_reducedBdrySize; y++ )\par
00101   \{\par
00102     leftReducedTransposed[y] = leftReduced[y];\par
00103   \}\par
00104 \par
00105   {\cf20 // Step 4: Rebase the reduced boundary}\par
00106 \par
00107   m_inputOffset       = m_reducedBoundary[0];\par
00108   m_inputOffsetTransp = m_reducedBoundaryTransposed[0];\par
00109 \par
00110   {\cf17 const} {\cf18 bool} hasFirstCol = (m_sizeId < 2);\par
00111   m_reducedBoundary          [0] = hasFirstCol ? ((1 << (bitDepth - 1)) - m_inputOffset      ) : 0; {\cf20 // first column of matrix not needed for large blocks}\par
00112   m_reducedBoundaryTransposed[0] = hasFirstCol ? ((1 << (bitDepth - 1)) - m_inputOffsetTransp) : 0;\par
00113   {\cf19 for} ({\cf18 int} i = 1; i < inputSize; i++)\par
00114   \{\par
00115     m_reducedBoundary          [i] -= m_inputOffset;\par
00116     m_reducedBoundaryTransposed[i] -= m_inputOffsetTransp;\par
00117   \}\par
00118 \}\par
00119 \par
00120 {\cf18 void} MatrixIntraPrediction::predBlock({\cf18 int} *{\cf17 const} result, {\cf17 const} {\cf18 int} modeIdx, {\cf17 const} {\cf18 bool} transpose, {\cf17 const} {\cf18 int} bitDepth,\par
00121                                       {\cf17 const} ComponentID compId)\par
00122 \{\par
00123   CHECK(m_component != compId, {\cf22 "Boundary has not been prepared for this component."});\par
00124 \par
00125   {\cf17 const} {\cf18 bool} needUpsampling = ( m_upsmpFactorHor > 1 ) || ( m_upsmpFactorVer > 1 );\par
00126 \par
00127   {\cf17 const} uint8_t* matrix = getMatrixData(modeIdx);\par
00128 \par
00129   static_vector<int, MIP_MAX_REDUCED_OUTPUT_SAMPLES> bufReducedPred( m_reducedPredSize * m_reducedPredSize );\par
00130   {\cf18 int}* {\cf17 const}       reducedPred     = needUpsampling ? bufReducedPred.data() : result;\par
00131   {\cf17 const} {\cf18 int}* {\cf17 const} reducedBoundary = transpose ? m_reducedBoundaryTransposed.data() : m_reducedBoundary.data();\par
00132   computeReducedPred(reducedPred, reducedBoundary, matrix, transpose, bitDepth);\par
00133   {\cf19 if}( needUpsampling )\par
00134   \{\par
00135     predictionUpsampling( result, reducedPred );\par
00136   \}\par
00137 \}\par
00138 \par
00139 \par
00140 {\cf18 void} MatrixIntraPrediction::initPredBlockParams({\cf17 const} Size& block)\par
00141 \{\par
00142   m_blockSize = block;\par
00143   {\cf20 // init size index}\par
00144   m_sizeId = getMipSizeId( m_blockSize );\par
00145 \par
00146   {\cf20 // init reduced boundary size}\par
00147   m_reducedBdrySize = (m_sizeId == 0) ? 2 : 4;\par
00148 \par
00149   {\cf20 // init reduced prediction size}\par
00150   m_reducedPredSize = ( m_sizeId < 2 ) ? 4 : 8;\par
00151 \par
00152 \par
00153   {\cf20 // init upsampling factors}\par
00154   m_upsmpFactorHor = m_blockSize.width  / m_reducedPredSize;\par
00155   m_upsmpFactorVer = m_blockSize.height / m_reducedPredSize;\par
00156 \par
00157   CHECKD( (m_upsmpFactorHor < 1) || ((m_upsmpFactorHor & (m_upsmpFactorHor - 1)) != 0), {\cf22 "Need power of two horizontal upsampling factor."} );\par
00158   CHECKD( (m_upsmpFactorVer < 1) || ((m_upsmpFactorVer & (m_upsmpFactorVer - 1)) != 0), {\cf22 "Need power of two vertical upsampling factor."} );\par
00159 \}\par
00160 \par
00161 \par
00162 \par
00163 {\cf18 void} MatrixIntraPrediction::boundaryDownsampling1D({\cf18 int}* reducedDst, {\cf17 const} {\cf18 int}* {\cf17 const} fullSrc, {\cf17 const} SizeType srcLen, {\cf17 const} SizeType dstLen)\par
00164 \{\par
00165   {\cf19 if} (dstLen < srcLen)\par
00166   \{\par
00167     {\cf20 // Create reduced boundary by downsampling}\par
00168     {\cf17 const} SizeType downsmpFactor = srcLen / dstLen;\par
00169     {\cf17 const} {\cf18 int} log2DownsmpFactor = floorLog2(downsmpFactor);\par
00170     {\cf17 const} {\cf18 int} roundingOffset = (1 << (log2DownsmpFactor - 1));\par
00171 \par
00172     SizeType srcIdx = 0;\par
00173     {\cf19 for}( SizeType dstIdx = 0; dstIdx < dstLen; dstIdx++ )\par
00174     \{\par
00175       {\cf18 int} sum = 0;\par
00176       {\cf19 for}( {\cf18 int} k = 0; k < downsmpFactor; k++ )\par
00177       \{\par
00178         sum += fullSrc[srcIdx++];\par
00179       \}\par
00180       reducedDst[dstIdx] = (sum + roundingOffset) >> log2DownsmpFactor;\par
00181     \}\par
00182   \}\par
00183   {\cf19 else}\par
00184   \{\par
00185     {\cf20 // Copy boundary if no downsampling is needed}\par
00186     {\cf19 for} (SizeType i = 0; i < dstLen; ++i)\par
00187     \{\par
00188       reducedDst[i] = fullSrc[i];\par
00189     \}\par
00190   \}\par
00191 \}\par
00192 \par
00193 \par
00194 {\cf18 void} MatrixIntraPrediction::predictionUpsampling1D({\cf18 int}* {\cf17 const} dst, {\cf17 const} {\cf18 int}* {\cf17 const} src, {\cf17 const} {\cf18 int}* {\cf17 const} bndry,\par
00195                                                    {\cf17 const} SizeType srcSizeUpsmpDim, {\cf17 const} SizeType srcSizeOrthDim,\par
00196                                                    {\cf17 const} SizeType srcStep, {\cf17 const} SizeType srcStride,\par
00197                                                    {\cf17 const} SizeType dstStep, {\cf17 const} SizeType dstStride,\par
00198                                                    {\cf17 const} SizeType bndryStep,\par
00199                                                    {\cf17 const} {\cf18 unsigned} {\cf18 int} upsmpFactor )\par
00200 \{\par
00201   {\cf17 const} {\cf18 int} log2UpsmpFactor = floorLog2( upsmpFactor );\par
00202   CHECKD( upsmpFactor <= 1, {\cf22 "Upsampling factor must be at least 2."} );\par
00203   {\cf17 const} {\cf18 int} roundingOffset = 1 << (log2UpsmpFactor - 1);\par
00204 \par
00205   SizeType idxOrthDim = 0;\par
00206   {\cf17 const} {\cf18 int}* srcLine = src;\par
00207   {\cf18 int}* dstLine = dst;\par
00208   {\cf17 const} {\cf18 int}* bndryLine = bndry + bndryStep - 1;\par
00209   {\cf19 while}( idxOrthDim < srcSizeOrthDim )\par
00210   \{\par
00211     SizeType idxUpsmpDim = 0;\par
00212     {\cf17 const} {\cf18 int}* before = bndryLine;\par
00213     {\cf17 const} {\cf18 int}* behind = srcLine;\par
00214     {\cf18 int}* currDst = dstLine;\par
00215     {\cf19 while}( idxUpsmpDim < srcSizeUpsmpDim )\par
00216     \{\par
00217       SizeType pos = 1;\par
00218       {\cf18 int} scaledBefore = ( *before ) << log2UpsmpFactor;\par
00219       {\cf18 int} scaledBehind = 0;\par
00220       {\cf19 while}( pos <= upsmpFactor )\par
00221       \{\par
00222         scaledBefore -= *before;\par
00223         scaledBehind += *behind;\par
00224         *currDst = (scaledBefore + scaledBehind + roundingOffset) >> log2UpsmpFactor;\par
00225 \par
00226         pos++;\par
00227         currDst += dstStep;\par
00228       \}\par
00229 \par
00230       idxUpsmpDim++;\par
00231       before = behind;\par
00232       behind += srcStep;\par
00233     \}\par
00234 \par
00235     idxOrthDim++;\par
00236     srcLine += srcStride;\par
00237     dstLine += dstStride;\par
00238     bndryLine += bndryStep;\par
00239   \}\par
00240 \}\par
00241 \par
00242 \par
00243 {\cf18 void} MatrixIntraPrediction::predictionUpsampling( {\cf18 int}* {\cf17 const} dst, {\cf17 const} {\cf18 int}* {\cf17 const} src ){\cf17  const}\par
00244 {\cf17 }\{\par
00245   {\cf17 const} {\cf18 int}* verSrc     = src;\par
00246   SizeType   verSrcStep = m_blockSize.width;\par
00247 \par
00248   {\cf19 if}( m_upsmpFactorHor > 1 )\par
00249   \{\par
00250     {\cf18 int}* {\cf17 const} horDst = dst + (m_upsmpFactorVer - 1) * m_blockSize.width;\par
00251     verSrc = horDst;\par
00252     verSrcStep *= m_upsmpFactorVer;\par
00253 \par
00254     predictionUpsampling1D( horDst, src, m_refSamplesLeft.data(),\par
00255                             m_reducedPredSize, m_reducedPredSize,\par
00256                             1, m_reducedPredSize, 1, verSrcStep,\par
00257                             m_upsmpFactorVer, m_upsmpFactorHor );\par
00258   \}\par
00259 \par
00260   {\cf19 if}( m_upsmpFactorVer > 1 )\par
00261   \{\par
00262     predictionUpsampling1D( dst, verSrc, m_refSamplesTop.data(),\par
00263                             m_reducedPredSize, m_blockSize.width,\par
00264                             verSrcStep, 1, m_blockSize.width, 1,\par
00265                             1, m_upsmpFactorVer );\par
00266   \}\par
00267 \}\par
