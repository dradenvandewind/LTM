00283 {\cf18 void} MatrixIntraPrediction::computeReducedPred( {\cf18 int}*{\cf17 const} result, {\cf17 const} {\cf18 int}* {\cf17 const} input,\par
00284                                                 {\cf17 const} uint8_t* matrix,\par
00285                                                 {\cf17 const} {\cf18 bool} transpose, {\cf17 const} {\cf18 int} bitDepth )\par
00286 \{\par
00287   {\cf17 const} {\cf18 int} inputSize = 2 * m_reducedBdrySize;\par
00288 \par
00289   {\cf20 // use local buffer for transposed result}\par
00290   static_vector<int, MIP_MAX_REDUCED_OUTPUT_SAMPLES> resBufTransposed( m_reducedPredSize * m_reducedPredSize );\par
00291   {\cf18 int}*{\cf17 const} resPtr = (transpose) ? resBufTransposed.data() : result;\par
00292 \par
00293   {\cf18 int} sum = 0;\par
00294   {\cf19 for}( {\cf18 int} i = 0; i < inputSize; i++ ) \{ sum += input[i]; \}\par
00295   {\cf17 const} {\cf18 int} offset = (1 << (MIP_SHIFT_MATRIX - 1)) - MIP_OFFSET_MATRIX * sum;\par
00296   CHECK( inputSize != 4 * (inputSize >> 2), {\cf22 "Error, input size not divisible by four"} );\par
00297 \par
00298   {\cf17 const} uint8_t *weight = matrix;\par
00299   {\cf17 const} {\cf18 int}   inputOffset = transpose ? m_inputOffsetTransp : m_inputOffset;\par
00300 \par
00301   {\cf17 const} {\cf18 bool} redSize = (m_sizeId == 2);\par
00302   {\cf18 int} posRes = 0;\par
00303   {\cf19 for}( {\cf18 int} y = 0; y < m_reducedPredSize; y++ )\par
00304   \{\par
00305     {\cf19 for}( {\cf18 int} x = 0; x < m_reducedPredSize; x++ )\par
00306     \{\par
00307       {\cf19 if}( redSize ) weight -= 1;\par
00308       {\cf18 int} tmp0 = redSize ? 0 : (input[0] * weight[0]);\par
00309       {\cf18 int} tmp1 = input[1] * weight[1];\par
00310       {\cf18 int} tmp2 = input[2] * weight[2];\par
00311       {\cf18 int} tmp3 = input[3] * weight[3];\par
00312       {\cf19 for} ({\cf18 int} i = 4; i < inputSize; i += 4)\par
00313       \{\par
00314         tmp0 += input[i]     * weight[i];\par
00315         tmp1 += input[i + 1] * weight[i + 1];\par
00316         tmp2 += input[i + 2] * weight[i + 2];\par
00317         tmp3 += input[i + 3] * weight[i + 3];\par
00318       \}\par
00319       resPtr[posRes++] = ClipBD<int>(((tmp0 + tmp1 + tmp2 + tmp3 + offset) >> MIP_SHIFT_MATRIX) + inputOffset, bitDepth);\par
00320 \par
00321       weight += inputSize;\par
00322     \}\par
00323   \}\par
00324 \par
00325   {\cf19 if}( transpose )\par
00326   \{\par
00327     {\cf19 for}( {\cf18 int} y = 0; y < m_reducedPredSize; y++ )\par
00328     \{\par
00329       {\cf19 for}( {\cf18 int} x = 0; x < m_reducedPredSize; x++ )\par
00330       \{\par
00331         result[ y * m_reducedPredSize + x ] = resPtr[ x * m_reducedPredSize + y ];\par
00332       \}\par
00333     \}\par
00334   \}\par
00335 \}\par
}
