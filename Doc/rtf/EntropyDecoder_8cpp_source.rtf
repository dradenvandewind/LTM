00179 {\cf20 // Decoding full frame raster order}\par
00180 Surface EntropyDecoderResiduals::process({\cf18 unsigned} width, {\cf18 unsigned} height, {\cf18 bool} entropy_enabled, {\cf18 bool} rle_only,\par
00181                                          BitstreamUnpacker &b) \{\par
00182     {\cf20 // Set up source of symbols - empty layers are have a constant value of 0x40}\par
00183     {\cf17 const} {\cf17 auto} symbol_source(create_symbol_source(STATE_COUNT, entropy_enabled, rle_only, b, 0x40));\par
00184 \par
00185     {\cf20 // Make the new surface}\par
00186     {\cf17 auto} dest = Surface::build_from<int16_t>();\par
00187     dest.reserve(width, height);\par
00188 \par
00189     {\cf20 // Current PEL/run value}\par
00190     rle_pel_t current = \{0, 0\};\par
00191 \par
00192     {\cf20 // Read any huffman tables}\par
00193     symbol_source->start();\par
00194 \par
00195     {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
00196         int16_t *__restrict pdst = dest.data(0, y);\par
00197         {\cf19 for} ({\cf18 unsigned} x = 0; x < width; ++x) \{\par
00198             {\cf19 if} (current.zero_runlength > 0) \{\par
00199                 {\cf20 // Extend the run of zeros}\par
00200                 {\cf20 // dest.write(x, y, 0);}\par
00201                 *pdst++ = 0;\par
00202                 --current.zero_runlength;\par
00203             \} {\cf19 else} \{\par
00204                 {\cf20 // Write PEL value}\par
00205                 current = decode_pel(*symbol_source);\par
00206                 {\cf20 // dest.write(x, y, current.pel);}\par
00207                 *pdst++ = current.pel;\par
00208             \}\par
00209         \}\par
00210     \}\par
00211 \par
00212     {\cf19 return} dest.finish();\par
00213 \}\par
