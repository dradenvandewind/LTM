00264 {\cf20 // Run Length coded temporal bits}\par
00265 {\cf20 //}\par
00266 {\cf18 unsigned} EntropyDecoderTemporal::decode_run(SymbolSource &source, {\cf18 bool} symbol){\cf17  const }\{\par
00267     {\cf18 unsigned} count = 0;\par
00268     {\cf18 unsigned} c = 0;\par
00269     {\cf19 do} \{\par
00270         c = source.get(symbol ? STATE_ONE_RUN : STATE_ZERO_RUN);\par
00271         count = (count << 7) | (c & 0x7f);\par
00272     \} {\cf19 while} (c & 0x80);\par
00273 \par
00274     {\cf19 return} count;\par
00275 \}\par
00276 \par
00277 Surface EntropyDecoderTemporal::process({\cf18 unsigned} width, {\cf18 unsigned} height, {\cf18 bool} entropy_enabled, {\cf18 bool} rle_only, BitstreamUnpacker &b,\par
00278                                         {\cf18 unsigned} transform_block_size, {\cf18 bool} use_reduced_signalling) \{\par
00279     {\cf17 const} {\cf17 auto} symbol_source(create_symbol_source(STATE_COUNT, entropy_enabled, rle_only, b, 0));\par
00280 \par
00281     {\cf20 // Make the new surface}\par
00282     {\cf17 auto} dest = Surface::build_from<uint8_t>();\par
00283     dest.reserve(width, height);\par
00284 \par
00285     {\cf19 if} (!entropy_enabled)\par
00286         {\cf19 return} dest.fill(TemporalType::TEMPORAL_PRED, width, height).finish();\par
00287 \par
00288     {\cf20 // Divisor for block->tiles}\par
00289     {\cf17 const} {\cf18 unsigned} d = 32 / transform_block_size;\par
00290 \par
00291     {\cf20 // Read any huffman tables}\par
00292     symbol_source->start();\par
00293 \par
00294     {\cf20 // Get the first symbol & count}\par
00295     {\cf18 bool} symbol = (symbol_source->get_byte() != 0);\par
00296 \par
00297     {\cf18 unsigned} count = decode_run(*symbol_source, symbol);\par
00298 \par
00299     {\cf20 // For each tile ..}\par
00300     {\cf19 for} ({\cf18 unsigned} ty = 0; ty < height; ty += d) \{\par
00301         {\cf19 for} ({\cf18 unsigned} tx = 0; tx < width; tx += d) \{\par
00302 \par
00303             {\cf18 bool} intra_tile = {\cf17 false};\par
00304             {\cf20 // For each transform in tile}\par
00305             {\cf20 // for (unsigned y = ty; y < std::min(ty + d, height); ++y) \{}\par
00306             {\cf19 for} ({\cf18 unsigned} y = ty; y < LCEVC_MIN(ty + d, height); ++y) \{\par
00307                 uint8_t *__restrict pdst = dest.data(tx, y);\par
00308                 {\cf20 // for (unsigned x = tx; x < std::min(tx + d, width); ++x) \{}\par
00309                 {\cf19 for} ({\cf18 unsigned} x = tx; x < LCEVC_MIN(tx + d, width); ++x) \{\par
00310                     {\cf19 if} (use_reduced_signalling && intra_tile) \{\par
00311                         {\cf20 // The whole tile was flagged as intra}\par
00312                         *pdst++ = TemporalType::TEMPORAL_INTR;\par
00313                     \} {\cf19 else} \{\par
00314                         {\cf20 // Get next symbol}\par
00315                         {\cf19 while} (count == 0) \{\par
00316                             {\cf20 // Flip symbol and get next count}\par
00317                             symbol = !symbol;\par
00318                             count = decode_run(*symbol_source, symbol);\par
00319                         \}\par
00320 \par
00321                         {\cf20 // Check for intra tile}\par
00322                         {\cf19 if} (use_reduced_signalling && symbol && tx == x && ty == y)\par
00323                             intra_tile = {\cf17 true};\par
00324 \par
00325                         {\cf20 // Write to dst}\par
00326                         {\cf20 // dest.write(x, y, symbol ? TemporalType::TEMPORAL_INTR : TemporalType::TEMPORAL_PRED);}\par
00327                         *pdst++ = (symbol ? TemporalType::TEMPORAL_INTR : TemporalType::TEMPORAL_PRED);\par
00328 \par
00329                         count--;\par
00330                     \}\par
00331                 \}\par
00332             \}\par
00333         \}\par
00334     \}\par
00335 \par
00336     {\cf19 return} dest.finish();\par
00337 \}\par
