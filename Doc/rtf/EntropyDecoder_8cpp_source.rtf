00050 {\cf20 //}\par
00051 {\cf20 // Abstract interface for reading RLE symbols for surface.}\par
00052 {\cf20 //}\par
00053 {\cf17 class }SymbolSource \{\par
00054 {\cf17 public}:\par
00055     {\cf17 virtual} ~SymbolSource()\{\};\par
00056     {\cf17 virtual} {\cf18 void} start() = 0;\par
00057     {\cf17 virtual} {\cf18 unsigned} get({\cf18 unsigned} state) = 0;\par
00058     {\cf17 virtual} {\cf18 unsigned} get_byte() = 0;\par
00059 \};\par
00060 \par
00061 {\cf20 // SymbolSourceConstant}\par
00062 {\cf20 //}\par
00063 {\cf20 // Always return a constant}\par
00064 {\cf20 //}\par
00065 {\cf17 class }SymbolSourceConstant : {\cf17 public} SymbolSource \{\par
00066 {\cf17 public}:\par
00067     SymbolSourceConstant({\cf18 unsigned} c) : c_(c) \{\}\par
00068 \par
00069     {\cf18 void} start(){\cf17  override }\{\}\par
00070 \par
00071     {\cf18 unsigned} get({\cf18 unsigned} state){\cf17  override }\{ {\cf19 return} c_; \}\par
00072 \par
00073     {\cf18 unsigned} get_byte(){\cf17  override }\{ {\cf19 return} c_; \}\par
00074 \par
00075 {\cf17 private}:\par
00076     {\cf17 const} {\cf18 unsigned} c_;\par
00077 \};\par
00078 \par
00079 {\cf20 // SymbolSourceRaw}\par
00080 {\cf20 //}\par
00081 {\cf20 // Treats source data as raw symbols with no coding}\par
00082 {\cf20 //}\par
00083 {\cf17 class }SymbolSourceRaw : {\cf17 public} SymbolSource \{\par
00084 {\cf17 public}:\par
00085     SymbolSourceRaw(BitstreamUnpacker &b) : b_(b) \{\}\par
00086 \par
00087     {\cf18 void} start(){\cf17  override }\{\}\par
00088 \par
00089     {\cf18 unsigned} get({\cf18 unsigned} state){\cf17  override }\{ {\cf19 return} b_.byte(); \}\par
00090 \par
00091     {\cf18 unsigned} get_byte(){\cf17  override }\{ {\cf19 return} b_.byte(); \}\par
00092 \par
00093 {\cf17 private}:\par
00094     BitstreamUnpacker &b_;\par
00095 \};\par
00096 \par
00097 {\cf20 // SymbolSourceHuffman}\par
00098 {\cf20 //}\par
00099 {\cf20 // Source is huffman coded data, using different trees for each part of the RLE coding.}\par
00100 {\cf20 //}\par
00101 {\cf17 class }SymbolSourceHuffman : {\cf17 public} SymbolSource \{\par
00102 {\cf17 public}:\par
00103     SymbolSourceHuffman({\cf18 unsigned} num_states, BitstreamUnpacker &b) : states_(num_states), b_(b) \{\}\par
00104 \par
00105     {\cf18 void} start(){\cf17  override }\{\par
00106         {\cf19 for} ({\cf18 unsigned} i = 0; i < states_.size(); ++i) \{\par
00107             states_[i].read_codes(b_);\par
00108         \}\par
00109     \}\par
00110 \par
00111     {\cf18 unsigned} get({\cf18 unsigned} state){\cf17  override }\{\par
00112         assert(state < states_.size());\par
00113         {\cf19 return} states_[state].decode_symbol(b_);\par
00114     \}\par
00115 \par
00116     {\cf18 unsigned} get_byte(){\cf17  override }\{ {\cf19 return} b_.u(8, {\cf22 "first_symbol"}); \}\par
00117 \par
00118 {\cf17 private}:\par
00119     std::vector<HuffmanDecoder> states_;\par
00120     BitstreamUnpacker &b_;\par
00121 \};\par
00122 \par
00123 {\cf20 // Create symbol source for given encoded data}\par
00124 {\cf20 //}\par
00125 {\cf17 static} std::unique_ptr<SymbolSource> create_symbol_source({\cf18 unsigned} num_states, {\cf18 bool} entropy_enabled, {\cf18 bool} rle_only,\par
00126                                                           BitstreamUnpacker &b, {\cf18 unsigned} constant) \{\par
00127     {\cf19 if} (entropy_enabled) \{\par
00128         {\cf19 if} (rle_only)\par
00129             {\cf19 return} std::unique_ptr<SymbolSource>({\cf17 new} SymbolSourceRaw(b));\par
00130         {\cf19 else}\par
00131             {\cf19 return} std::unique_ptr<SymbolSource>({\cf17 new} SymbolSourceHuffman(num_states, b));\par
00132     \} {\cf19 else} \{\par
00133         {\cf19 return} std::unique_ptr<SymbolSource>({\cf17 new} SymbolSourceConstant(constant));\par
00134     \}\par
00135 \}\par
