00138 {\cf20 //}\par
00139 {\cf20 // Run Length coded residuals}\par
00140 {\cf20 //}\par
00141 EntropyDecoderResidualsBase::rle_pel_t EntropyDecoderResidualsBase::decode_pel(SymbolSource &source){\cf17  const }\{\par
00142     rle_pel_t r = \{0, 0\};\par
00143 \par
00144     {\cf18 unsigned} symbol = source.get(STATE_LSB);\par
00145 \par
00146     {\cf20 // If bit 0 is set, an MS byte follows}\par
00147     {\cf19 if} (symbol & 0x01) \{\par
00148         {\cf18 unsigned} lsb_symbol = symbol;\par
00149         symbol = source.get(STATE_MSB);\par
00150         r.pel = ((((symbol & 0x7f) << 8) | (lsb_symbol & 0xfe)) >> 1) - 0x2000;\par
00151     \} {\cf19 else} \{\par
00152         r.pel = ((symbol & 0x7e) - 0x40) >> 1;\par
00153     \}\par
00154 \par
00155     {\cf20 // if the bit 7 is set, zero run count follows}\par
00156     {\cf19 if} (symbol & 0x80) \{\par
00157         {\cf20 // LSByte first}\par
00158 {\cf20         /***}\par
00159 {\cf20         unsigned bit_offset = 0;}\par
00160 {\cf20         do \{}\par
00161 {\cf20             symbol = source.get(STATE_ZERO);}\par
00162 {\cf20             r.zero_runlength |= (symbol & 0x7f) << bit_offset;}\par
00163 {\cf20             bit_offset += 7;}\par
00164 {\cf20         \} while (symbol & 0x80);}\par
00165 {\cf20         ***/}\par
00166         {\cf20 // MSByte first}\par
00167         {\cf20 /***/}\par
00168         r.zero_runlength = 0;\par
00169         {\cf19 do} \{\par
00170             symbol = source.get(STATE_ZERO);\par
00171             r.zero_runlength = (r.zero_runlength << 7) | (symbol & 0x7f);\par
00172         \} {\cf19 while} (symbol & 0x80);\par
00173         {\cf20 /***/}\par
00174     \}\par
00175 \par
00176     {\cf19 return} r;\par
00177 \}\par
