00391 {\cf20 //}\par
00392 {\cf20 // Coded sizes}\par
00393 {\cf20 //}\par
00394 uint16_t EntropyDecoderSizes::decode_size(SymbolSource &source){\cf17  const }\{\par
00395 \par
00396     {\cf17 const} {\cf18 unsigned} l = source.get(STATE_LSB);\par
00397 \par
00398     {\cf20 // If bit 0 is set, an MS byte follows}\par
00399     {\cf19 if} (l & 0x01) \{\par
00400         {\cf17 const} {\cf18 unsigned} m = source.get(STATE_MSB);\par
00401         {\cf19 return} (l >> 1) + (m << 7);\par
00402     \} {\cf19 else} \{\par
00403         {\cf19 return} l >> 1;\par
00404     \}\par
00405 \}\par
00406 \par
00407 int16_t EntropyDecoderSizes::decode_size_delta(SymbolSource &source){\cf17  const }\{\par
00408 \par
00409     {\cf17 const} {\cf18 unsigned} l = source.get(STATE_LSB);\par
00410 \par
00411     {\cf20 // If bit 0 is set, an MS byte follows}\par
00412     {\cf20 //}\par
00413     {\cf20 // Sign extend from high bit of decoded value to recover signed delta}\par
00414     {\cf20 //}\par
00415     {\cf19 if} (l & 0x01) \{\par
00416         {\cf17 const} {\cf18 unsigned} m = source.get(STATE_MSB);\par
00417         {\cf17 const} int16_t r = (l >> 1) + (m << 7);\par
00418         {\cf19 return} r | ((r & 0x4000) << 1);\par
00419     \} {\cf19 else} \{\par
00420         {\cf17 const} uint8_t r = l >> 1;\par
00421         {\cf19 return} (int8_t)(r | ((r & 0x40) << 1));\par
00422     \}\par
00423 \}\par
00424 \par
00425 Surface EntropyDecoderSizes::process({\cf18 unsigned} width, {\cf18 unsigned} height, BitstreamUnpacker &b, {\cf17 const} std::vector<bool> entropy_enabled,\par
00426                                      {\cf17 const} {\cf18 unsigned} tile_idx, CompressionType compression_type) \{\par
00427     {\cf20 // Set up source of symbols}\par
00428     {\cf17 const} {\cf17 auto} symbol_source(create_symbol_source(STATE_COUNT, {\cf17 true}, {\cf17 false}, b, 0));\par
00429 \par
00430     {\cf20 // Make the new surface}\par
00431     {\cf17 auto} dest = Surface::build_from<uint16_t>();\par
00432     dest.reserve(width, height);\par
00433 \par
00434     {\cf20 // Read any huffman tables}\par
00435     symbol_source->start();\par
00436 \par
00437     {\cf19 if} (compression_type == CompressionType_Prefix) \{\par
00438         {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
00439             uint16_t *__restrict pdst = dest.data(0, y);\par
00440             {\cf19 for} ({\cf18 unsigned} x = 0; x < width; ++x) \{\par
00441                 {\cf19 if} (entropy_enabled[tile_idx + x])\par
00442                     *pdst++ = decode_size(*symbol_source);\par
00443                 {\cf19 else}\par
00444                     *pdst++ = 0;\par
00445             \}\par
00446         \}\par
00447     \} {\cf19 else} {\cf19 if} (compression_type == CompressionType_Prefix_OnDiff) \{\par
00448         uint16_t p = 0;\par
00449         {\cf19 for} ({\cf18 unsigned} y = 0; y < height; ++y) \{\par
00450             uint16_t *__restrict pdst = dest.data(0, y);\par
00451             {\cf19 for} ({\cf18 unsigned} x = 0; x < width; ++x) \{\par
00452                 {\cf19 if} (entropy_enabled[tile_idx + x]) \{\par
00453                     {\cf17 const} {\cf18 int} diff = decode_size_delta(*symbol_source);\par
00454                     p += diff;\par
00455                     *pdst++ = p;\par
00456                 \} {\cf19 else} \{\par
00457                     *pdst++ = 0;\par
00458                 \}\par
00459             \}\par
00460         \}\par
00461     \}\par
00462 \par
00463     {\cf19 return} dest.finish();\par
00464 \}\par
